
#[derive(Clone,Debug,PartialEq,Eq)]
pub enum OperandValue {Scalar(i64),Registers(Vec<u16>),Range(RegisterRange),Payload(Payload)}
#[derive(Clone,Debug,PartialEq,Eq)]
pub struct OperandSpan {pub start:usize,pub end:usize,pub name:&'static str,pub kind:&'static str,pub value:OperandValue,pub position_dependent:bool}
#[derive(Clone,Debug,PartialEq,Eq)]
pub struct Described {pub text:String,pub operands:Vec<OperandSpan>}
#[derive(Clone,Debug)]
pub struct Hole {pub name:&'static str,pub kind:&'static str,pub field:Option<&'static Field>,pub position_dependent:bool}
fn argument_end(text:&str,start:usize)->usize{let mut depth=0;for(i,c)in text[start..].char_indices(){match c{'{'|'['|'('=>depth+=1,'}'|']'|')'=>depth-=1,',' if depth==0=>return start+i,_=>{}}}text.len()}
impl Instruction {
    pub fn describe(&self)->Result<Described>{
        let d=definition(self.opcode).ok_or(Error::Reserved)?;encode(self,self.offset)?;let text=format(self);let mut out=Described{text,operands:Vec::new()};let mut start=d.mnemonic.len()+1;
        if let Some(p)=&self.payload{out.operands.push(OperandSpan{start,end:out.text.len(),name:"payload",kind:"payload",value:OperandValue::Payload(p.clone()),position_dependent:false});return Ok(out);}
        if matches!(d.format,"35c"|"45cc"){let end=argument_end(&out.text,start);out.operands.push(OperandSpan{start,end,name:"registers",kind:"registers",value:OperandValue::Registers(self.registers.clone()),position_dependent:false});start=end+2;}
        if let Some(r)=&self.range{let end=argument_end(&out.text,start);out.operands.push(OperandSpan{start,end,name:"range",kind:"range",value:OperandValue::Range(r.clone()),position_dependent:false});start=end+2;}
        for f in d.fields{let end=argument_end(&out.text,start);out.operands.push(OperandSpan{start,end,name:f.name,kind:f.kind,value:OperandValue::Scalar(*self.values.get(f.name).ok_or_else(||bad("missing operand"))?),position_dependent:f.kind=="target"});start=end+2;}
        Ok(out)
    }
    pub fn set_operand(&mut self,name:&str,value:i64)->Result<()>{let d=definition(self.opcode).ok_or(Error::Reserved)?;if !d.fields.iter().any(|f|f.name==name){return Err(bad("unknown operand"));}let mut next=self.clone();next.values.insert(name.into(),value);let b=encode(&next,self.offset)?;*self=decode(&b,self.offset)?;Ok(())}
    /// Target fields are code-unit displacements from this instruction. Switch
    /// payload entries retain their referring-switch-relative semantics.
    pub fn relocated(&self,to:u32)->Result<Self>{let d=definition(self.opcode).ok_or(Error::Reserved)?;let mut next=self.clone();let delta=i64::from(self.offset)-i64::from(to);for f in d.fields{if f.kind=="target"{let value=next.values.get_mut(f.name).ok_or_else(||bad("missing operand"))?;*value=value.checked_add(delta).ok_or_else(||bad("relocation range"))?;}}let b=encode(&next,to)?;decode(&b,to)}
    pub fn encode_into(&self,output:&mut[u8])->Result<usize>{let b=encode(self,self.offset)?;if output.len()<b.len(){return Err(bad("output buffer too small"));}output[..b.len()].copy_from_slice(&b);Ok(b.len())}
    pub fn relocate_into(&self,to:u32,output:&mut[u8])->Result<usize>{self.relocated(to)?.encode_into(output)}
}
impl InstructionTemplate {
    pub fn definition(&self)->&'static Definition{self.definition}
    pub fn holes(&self)->Vec<Hole>{let mut out=Vec::new();for f in self.definition.fields{if !self.fixed.contains_key(f.name){out.push(Hole{name:f.name,kind:f.kind,field:Some(f),position_dependent:f.kind=="target"});}}
        if matches!(self.definition.format,"35c"|"45cc")&&self.registers.is_none(){out.push(Hole{name:"registers",kind:"registers",field:None,position_dependent:false});}
        if matches!(self.definition.format,"3rc"|"4rcc")&&self.range.is_none(){out.push(Hole{name:"range",kind:"range",field:None,position_dependent:false});}
        if self.definition.opcode>=256&&self.payload.is_none(){out.push(Hole{name:"payload",kind:"payload",field:None,position_dependent:false});}out}
    pub fn could_match(&self,src:&[u8])->bool{if self.definition.opcode>=256{src.starts_with(&self.definition.opcode.to_le_bytes())}else{src.first()==Some(&(self.definition.opcode as u8))}}
}
#[cfg(test)]mod analysis_tests{use super::*;#[test]fn branch_and_payload_relocation(){let b=assemble("goto 0x10",0).unwrap();let mut i=decode(&b,0).unwrap();let a=i.describe().unwrap();assert!(a.operands[0].position_dependent);assert_eq!(&a.text[a.operands[0].start..a.operands[0].end],"0x10");let m=i.relocated(4).unwrap();assert_eq!(format(&i),format(&m));assert!(i.set_operand("target",1000000).is_err());assert_eq!(encode(&i,0).unwrap(),b);let t=InstructionTemplate::new("goto").unwrap();assert!(t.holes()[0].position_dependent);assert!(t.could_match(&b));let p=assemble("packed-switch-payload -1, {+2, -3}",100).unwrap();let i=decode(&p,100).unwrap();let m=i.relocated(102).unwrap();assert_eq!(m.payload,i.payload);assert_eq!(encode(&m,102).unwrap(),p);assert!(!i.describe().unwrap().operands[0].position_dependent);}}
