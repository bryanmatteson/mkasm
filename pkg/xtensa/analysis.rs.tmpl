
pub fn describe(src:&[u8],address:u64)->Result<Described,Error>{describe_with_features(src,address,None)}
pub fn describe_with_features(src:&[u8],address:u64,active:Option<&[&str]>)->Result<Described,Error>{Ok(decode_with_features(src,active)?.describe(address))}
impl Decoded {
    pub fn describe(&self,address:u64)->Described{
        let bundle=self.format!="scalar";let mut out=Described{text:if bundle{"{ ".into()}else{String::new()},operands:Vec::new()};
        for(index,d)in self.instructions.iter().enumerate(){
            if index>0{out.text.push_str("; ");}let mut part=d.describe_field(address);let offset=out.text.len();
            for span in &mut part.operands{span.start+=offset;span.end+=offset;span.instruction_index=index;}
            out.text.push_str(&part.text);out.operands.extend(part.operands);
        }
        if bundle{out.text.push_str(" }");}out
    }
    pub fn encode_into(&self,output:&mut[u8])->Result<usize,Error>{let b=self.encode()?;if output.len()<b.len(){return Err(Error::BufferTooSmall);}output[..b.len()].copy_from_slice(&b);Ok(b.len())}
    pub fn set_operand(&mut self,instruction:usize,name:&str,value:i128)->Result<(),Error>{let mut next=self.clone();next.instructions.get_mut(instruction).ok_or(Error::Operand)?.set_operand(name,value)?;next.encode()?;*self=next;Ok(())}
    pub fn relocated(&self,from:u64,to:u64)->Result<Self,Error>{let mut next=self.clone();for d in &mut next.instructions{*d=d.relocated(from,to)?;}next.encode()?;Ok(next)}
    pub fn relocate_into(&self,from:u64,to:u64,output:&mut[u8])->Result<usize,Error>{self.relocated(from,to)?.encode_into(output)}
}
impl Template {
    pub fn encodings(&self)->Vec<&'static str>{let mut out=Vec::new();for(_,ts)in &self.patterns{for t in ts{for id in t.encodings(){if !out.contains(&id){out.push(id);}}}}out}
    pub fn holes(&self)->Vec<Hole>{let mut out:Vec<Hole>=Vec::new();for(_,ts)in &self.patterns{for t in ts{for h in t.holes(){if let Some(old)=out.iter_mut().find(|old|old.name==h.name){for d in h.domains{if !old.domains.contains(&d){old.domains.push(d);}}}else{out.push(h);}}}}out}
    pub fn hole_position(&self,index:usize)->Option<Position>{self.holes().get(index)?.position()}
    pub fn could_match(&self,src:&[u8])->bool{
        let Ok(length)=frame(src)else{return false;};
        self.patterns.iter().any(|(f,ts)|if *f==SCALAR_FORMAT{!packet_formats().any(|(_,f)|format_matches(f,src))&&ts[0].could_match(src)}else{
            length==FORMAT_META[*f].length&&format_matches(&FORMAT_META[*f],src)&&ts.iter().all(|t|t.patterns.iter().any(|(i,_)|{
                let e=&ENCODINGS[*i];let m=&SLOT_META[*i];(0..length).all(|j|src[j]&m.mask[j]&e.mask[j]==e.value[j])
            }))
        })
    }
}
#[cfg(test)]mod bundle_analysis_tests{
    use super::*;
    #[test]fn scalar_and_bundle_analysis(){
        let texts=if ARCHITECTURE=="xtensaeb"{vec!["add a2,a3,a4"]}else{vec!["add a2,a3,a4","{ add a2,a3,a4; add a5,a6,a7; nop }"]};
        for text in texts{for b in assemble(text).unwrap(){let mut d=decode(&b).unwrap();let a=d.describe(0x1000);assert_eq!(a.text,d.format(0x1000));assert_eq!(a,describe(&b,0x1000).unwrap());
            for s in &a.operands{assert_eq!(s.value,d.instructions[s.instruction_index].values[s.operand_index]);assert!(s.domain.contains(s.value));assert!(!a.text[s.start..s.end].is_empty());}
            let t=Template::parse(&a.text).unwrap();assert!(t.could_match(&b));assert!(!t.encodings().is_empty());let mut out=vec![0xcc;b.len()];assert_eq!(d.relocate_into(0x1000,0x1010,&mut out).unwrap(),b.len());assert_eq!(&out[..b.len()],b);
            let original=d.encode().unwrap();assert!(d.set_operand(0,"missing",3).is_err());assert_eq!(d.encode().unwrap(),original);
        }}
        let t=Template::parse("add $Dst:register,$Src:register,$Src:register").unwrap();assert_eq!(t.holes().len(),2);assert_eq!(t.holes()[0].name,"Dst");assert_eq!(t.hole_position(0),Some(Position::Fixed));for b in t.encode(&[("Dst",2),("Src",3)]).unwrap(){assert!(t.could_match(&b));assert!(t.matches(&b).unwrap().1.contains(&("Dst".into(),2)));}
        for b in assemble_at("l32r a2,0xffc",0x1000).unwrap(){let d=decode(&b).unwrap();let m=d.relocated(0x1000,0x1004).unwrap();
            assert_eq!(d.instructions[0].branch_target(0x1000),None);assert_eq!(m.instructions[0].branch_target(0x1004),None);
            for(decoded,address)in [(&d,0x1000),(&m,0x1004)]{let described=decoded.describe(address);let span=described.operands.iter().find(|s|s.position_dependent()).unwrap();assert_eq!(span.position.target(address,span.value),Some(0xffc));}
        }
        for b in assemble_at("loop a2,0x1010",0x1000).unwrap(){let d=decode(&b).unwrap();assert_eq!(d.instructions[0].branch_target(0x1000),Some(0x1010));let m=d.relocated(0x1000,0x1004).unwrap();assert_eq!(m.instructions[0].branch_target(0x1004),Some(0x1010));}
    }
}
