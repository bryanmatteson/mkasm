}
// Requirement lists are interned. Large scans repeatedly revisit the same
// lists, often alternating rather than repeating the preceding candidate.
// Entries live only for this call's immutable active set; collisions miss.
type AssemblyFeatureCache=Option<[Option<(&'static[&'static str],bool)>;32]>;
fn assembly_feature_cache(count:usize,active:Option<&[&str]>)->AssemblyFeatureCache{
 if count>64&&active.is_some(){Some([None;32])}else{None}
}
fn assembly_features(e:&Encoding,active:Option<&[&str]>,cache:&mut AssemblyFeatureCache)->bool{
 let Some(cache)=cache else{return features(e,active);};
 let key=e.features.as_ptr() as usize;let slot=((key>>4)^(key>>10))&31;
 if let Some((requirements,admitted))=cache[slot]{if std::ptr::eq(requirements,e.features){return admitted;}}
