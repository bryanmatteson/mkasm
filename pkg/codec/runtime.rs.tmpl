    #[test]
    fn assembly_feature_cache_matches_direct_admission(){
        for active in std::iter::once(None).chain(FEATURE_SETS.iter().map(|(_,set)|Some(*set))){
            assert!(assembly_feature_cache(64,active).is_none());
            let mut cache=assembly_feature_cache(65,active);
            for _ in 0..2{for e in ENCODINGS.iter().step_by((ENCODINGS.len()/257).max(1)){
                assert_eq!(assembly_features(e,active,&mut cache),features(e,active),"{} {active:?}",e.id);
            }}
        }
    }
    #[test]
    fn literal_delimiter_search_matches_character_reference(){
        let Some(o)=ENCODINGS.iter().flat_map(|e|e.operands).next()else{return;};
        for text in ["", "éπ,v0", "[v0,v1],s0", "(a,{b,c}),d", "{π},ä", "a}b{c,d},é", "πäπtail", "a,b,c"]{
            for next in [&b","[..],&b"\x01"[..],&b"\x02"[..],"π".as_bytes(),"é".as_bytes(),&b"tail"[..]]{
                let mut expected=Vec::new();let mut depth=0;
                for(i,c)in text.char_indices(){if depth==0&&literal_prefix(next,&text[i..]){expected.push(i);}match c{'{'|'['|'('=>depth+=1,'}'|']'|')'=>{if depth>0{depth-=1;}},_=>{}}}
                let mut actual=Vec::new();assert!(!syntax_candidate_ends(o,text,next,|end|{actual.push(end);false}));assert_eq!(actual,expected,"{text:?} {next:?}");
            }
        }
    }
    #[test]
    fn named_prefix_ranges_match_linear_endpoint_search(){
        let mut tables=vec![vec![("",0),("a",1),("ab",2),("abc",3),("abcd",4),("abce",5),("b",6),("ä",7),("ä0",8),("π",9),("π1",10)]];
        tables.extend(OPERAND_NAMES.iter().map(|names|names.to_vec()));
        let mut random=17u32;
        for names in tables{
            let step=(names.len()/17).max(1);
            for name in names.iter().step_by(step).map(|(name,_)|*name).chain(["", "unknown", "π4"]){
                let text=format!("{name}suffix");
                for _ in 0..4{
                    random=random.wrapping_mul(1664525).wrapping_add(1013904223);
                    let lower=if random&1==0{0}else{random as usize%(text.len()+1)};
                    let upper=if random&2==0{text.len()}else{(random>>8)as usize%(text.len()+1)};
                    for ascending in [false,true]{
                        let ends=names.iter().filter_map(|(n,_)|(text.starts_with(n)&&n.len()>=lower&&n.len()<=upper).then_some(n.len()));
                        let expected=if ascending{ends.min()}else{ends.max()};
                        assert_eq!(named_prefix_end(&names,&text,lower,upper,ascending),expected,"{text:?} {lower} {upper} {ascending}");
                    }
                }
            }
        }
    }
    #[test]
    fn numeric_prefix_matches_exhaustive_integer_endpoints(){
        let mut texts=vec!["".to_owned(),"π123".to_owned(),format!("{}1suffix","0".repeat(2048))];
        for sign in ["","+","-","++","--","+-","-+"]{for base in ["","0x","0o","0b"]{for digits in ["","0","1","19","abc","-1","+1","170141183460469231731687303715884105727","170141183460469231731687303715884105728"]{
            texts.push(format!("{sign}{base}{digits}clampπ"));
        }}}
        for text in texts{for upper in (0..=text.len()).step_by((text.len()/100).max(1)){
            // The original integer function may overflow when negating MIN;
            // retain that behavior but do not exercise that panic in this oracle.
            if text.starts_with("--170141183460469231731687303715884105728"){continue;}
            let expected=(1..=upper).rev().find(|&end|text.is_char_boundary(end)&&integer(&text[..end]).is_some());
            assert_eq!(integer_prefix_end(&text,upper),expected,"{text:?} {upper}");
        }}
    }
    #[test]
    fn normalized_names_preserve_whitespace_and_unicode(){
        for name in [" X1\t","R\u{b}2","Ä0","İ3","π4"," A\u{85}B ",""," \t\r\n\u{b}\u{c}"]{
            let expected=norm(name);assert!(normalized_eq(name,&expected));assert_eq!(normalized_prefix(name,&format!("{expected},next")),Some(expected.len()));assert!(!normalized_eq(name,&format!("{expected}x")));
        }
        assert_eq!(normalized_prefix("X1","y1"),None);assert_eq!(normalized_prefix("Ä0","ä1"),None);
    }
    #[test]
    fn generated_patterns_and_normalized_input_match_reference(){
        for (i,e) in ENCODINGS.iter().enumerate(){
            let mut program=SYNTAXES[SYNTAX_INDEX[i] as usize].pattern;let mut readable=Vec::new();
            while let Some(at)=program.iter().position(|&b|b==0xff){
                readable.extend_from_slice(&program[..at]);let(index,rest)=match_operand(&program[at+1..]).unwrap();
                readable.push(b'{');readable.extend_from_slice(e.operands[index].name.as_bytes());readable.push(b'}');program=rest;
            }
            readable.extend_from_slice(program);assert_eq!(readable,syntax_pattern(e.syntax).as_bytes(),"{} match program",e.id);
        }
        for input in ["MOV r1, -8","mem (r2-3)","MEM [W2-1]","r1-3","İ Ä\u{85}π", "x ${MyName} (r2-3)","x ${Unclosed", "x ${A}(r1-2) ${B} [w2-3]"]{
            let mut reference=String::new();let mut rest=input;
            while let Some(i)=rest.find("${"){reference.push_str(&assembly_norm(&rest[..i]));rest=&rest[i..];if let Some(end)=rest.find('}'){reference.push_str(&rest[..end+1]);rest=&rest[end+1..];}else{break;}}
            reference.push_str(&assembly_norm(rest));assert_eq!(syntax_input(input),reference);
        }
    }
    #[test]
    fn every_encoding_round_trips_through_bytes_and_text(){
        let mut assembler=Assembler::with_capacity(1024);let mut assembled_into=[0;MAX_INSTRUCTION_BYTES];
        for(i,e)in ENCODINGS.iter().enumerate(){
            // Different processor generations can assign different framing to
            // the same prefix. Exercise each form in a declared CPU context.
            let active=FEATURE_SETS.iter().find(|(_,features)|e.features.iter().all(|f|features.contains(f))).map(|(_,features)|*features);
            let values=representative(i).unwrap_or_else(|err|panic!("{} representative: {:?}",e.id,err));
            let mut bytes=vec![0;e.value.len()];encode_into(i,&values,&mut bytes).unwrap_or_else(|err|panic!("{}: {:?}",e.id,err));
            if !e.assembly_only {
                let decoded=decode_with_features(&bytes,active).unwrap_or_else(|err|panic!("{}: {:?}",e.id,err));assert_eq!(decoded.length,bytes.len(),"{} decoded as {}",e.id,decoded.encoding().id);
                assert_eq!(encode(decoded.encoding().id,&decoded.values[..decoded.encoding().operands.len()]).unwrap(),bytes,"decoded {}",e.id);
                let preferred=decoded.format(0x1000);let assembled=assemble_with_features(&preferred,0x1000,active).unwrap_or_else(|err|panic!("{} decoded as {}: {} {:?}",e.id,decoded.encoding().id,preferred,err));assert!(assembled.contains(&bytes),"preferred {}: {}",e.id,preferred);
            }
            let text=Decoded{encoding_index:i,values:{let mut v=[0;MAX_OPERANDS];v[..values.len()].copy_from_slice(&values);v},length:bytes.len()}.format(0x1000);
            let assembled=assemble_with_features(&text,0x1000,active).unwrap_or_else(|err|panic!("{}: {} {:?}",e.id,text,err));assert!(assembled.contains(&bytes),"{}: {}",e.id,text);
            let n=assembler.assemble_with_features_into(&text,0x1000,active,&mut assembled_into).unwrap();assert_eq!(&assembled_into[..n],assembled[0],"{} shortest form",e.id);
            assert_eq!(encode(e.id,&values).unwrap(),bytes);
        }
    }
    #[test]
    fn empty_input_is_truncated(){assert_eq!(decode(&[]).unwrap_err(),Error::Truncated);}
