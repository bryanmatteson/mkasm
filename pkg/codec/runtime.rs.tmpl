  if bytes[i]==b'$'&&i+1<bytes.len()&&bytes[i+1]!=b'{'{let mut end=i+1;while end<bytes.len()&&(bytes[end].is_ascii_alphanumeric()||matches!(bytes[end],b'_'|b':')){end+=1;}if end>i+1{if e.is_some_and(|e|native_dollar_token(e,&text[i..end],address)){out.push_str(&text[i..end]);}else{out.push_str("${");out.push_str(&text[i+1..end]);out.push('}');}i=end;continue;}}
