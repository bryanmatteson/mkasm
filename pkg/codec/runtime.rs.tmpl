            let mut expected=original.to_vec();expected.sort_by_key(|&i|ENCODINGS[i as usize].value.len());
            assert_eq!(if ordered.is_empty(){original}else{ordered},expected);
        }
    }
    #[test]
    fn iterative_assembly_matches_recursive_reference(){
        fn reference(index:usize,text:&str,address:u64)->Option<[i128;MAX_OPERANDS]>{
            let e=&ENCODINGS[index];let mut parsed=[None;MAX_OPERANDS];
            if !match_syntax(index,text,&mut parsed,&|o,t|parse_operand(o,t,address),&|old,new|(*old==new).then_some(new)){return None;}
            let mut values=[0;MAX_OPERANDS];for(i,o)in e.operands.iter().enumerate(){values[i]=parsed[i].or_else(||(o.implicit||o.optional).then_some(0))?;}
            address_constraints(e,&values,address).then_some(values)
        }
        for index in (0..ENCODINGS.len()).step_by((ENCODINGS.len()/257).max(1)){for seed in [0,17,129]{
            let values=representative_with_seed(index,seed).unwrap();let mut all=[0;MAX_OPERANDS];all[..values.len()].copy_from_slice(&values);
            let d=Decoded{encoding_index:index,values:all,length:ENCODINGS[index].value.len()};
            let text=d.format(0x1234);
            for input in [text.clone(),format!("{text}invalidsuffix"),format!("{text}π"),text[..text.char_indices().last().map_or(0,|(i,_)|i)].to_owned()]{
                let prepared=syntax_input(&input);
                let expected=reference(index,&prepared,0x1234);
                assert_eq!(parse_prepared_syntax(index,&prepared,0x1234),expected,"{} {seed} {input:?}",d.encoding().id);
                assert_eq!(parse_prepared_iterative(index,&prepared,0x1234),expected,"iterative {} {seed} {input:?}",d.encoding().id);
            }
        }}
    }
