    /// Tests an already compiled template without allocating captures.
    pub fn is_match(&self,src:&[u8])->bool{self.matching_pattern(src).is_some()}
    /// Captures borrow names from this template. Returns instruction length and
    /// capture count; a short capture buffer is left unchanged.
    pub fn matches_into<'a>(&'a self,src:&[u8],captures:&mut[(&'a str,i128)])->Result<Option<(usize,usize)>,Error>{
