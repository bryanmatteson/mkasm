    }
    pub fn encode(&self,holes:&[(&str,i128)])->Result<Vec<Vec<u8>>,Error>{
        let mut out=Vec::new();for(i,bindings)in &self.patterns{let values=bindings.iter().map(|b|b.encode_value(holes)).collect::<Option<Vec<_>>>();if let Some(values)=values{let e=&ENCODINGS[*i];let mut b=vec![0;e.value.len()];if address_constraints(e,&values,self.address)&&encode_into(*i,&values,&mut b).is_ok()&&!out.contains(&b){out.push(b);}}}if out.is_empty(){Err(Error::Operand)}else{Ok(out)}
    }
}

/// Finds legal operand values for a catalog entry, including nonzero, tied and
/// relational constraints. Used by corpus ledgers and generated tests.
pub fn representative(index:usize)->Result<Vec<i128>,Error>{
 representative_with_seed(index,0)
}
/// Selects another legal sample without changing the encoding's operand model.
pub fn representative_with_seed(index:usize,seed:usize)->Result<Vec<i128>,Error>{
 let e=ENCODINGS.get(index).ok_or(Error::Unknown)?;
 let tuple_trials=e.constraints.iter().filter(|c|c.kind=="tuple_in").fold(1usize,|n,c|n.saturating_mul(c.allowed.len()).min(65536));
 let trials=136usize.max(tuple_trials);for offset in 0..trials{let trial=(offset+seed%trials)%trials;
  let mut values=e.operands.iter().enumerate().map(|(i,o)|{
   let raw=if o.names.is_empty(){let seed=if trial==0{0}else{trial+i*(1+trial/16)};let bits=width(o);let mut n=0u64;let mut shift=0;for bit in 0..bits{if o.bits.iter().any(|b|bit>=b.value&&bit<b.value+b.width){if shift<7{n|=(((seed>>shift)&1) as u64)<<bit;}shift+=1;}}if trial>=128&&bits>0{let sign=1u64<<(bits-1);let max=if bits==64{u64::MAX}else{(1u64<<bits)-1};n=match trial-128{0=>max,1=>sign,2=>sign-1,3=>sign.saturating_add(1)&max,4=>max.saturating_sub(1),5=>1,6=>max/2,_=>0};}n}
   else{let names=o.names.iter().enumerate().filter(|(_,n)|!n.is_empty()).map(|(i,_)|i).collect::<Vec<_>>();if names.is_empty(){0}else{names[if trial==0{0}else{(trial+i*(1+trial/16))%names.len()}] as u64}};
   let raw=if o.names.is_empty(){raw^o.xor}else{raw};let n=operand_number(o,raw).unwrap_or_else(||o.lookup.first().copied().unwrap_or(0));n*o.scale+o.bias
  }).collect::<Vec<_>>();
  for(i,o)in e.operands.iter().enumerate(){if !o.bias_operand.is_empty(){values[i]+=value_named(e,&values,o.bias_operand)*if o.bias_scale==0{1}else{o.bias_scale};}}
  let mut tuple_trial=trial;for c in e.constraints.iter().filter(|c|c.kind=="tuple_in"){let row=c.allowed.get(tuple_trial%c.allowed.len()).ok_or(Error::Operand)?;tuple_trial/=c.allowed.len();for(&name,&value)in c.operands.iter().zip(*row){let i=e.operands.iter().position(|o|o.name==name).ok_or(Error::Operand)?;values[i]=value;}}
  for(i,o)in e.operands.iter().enumerate(){if o.implicit||o.optional{values[i]=0;}}
  if encode_into(index,&values,&mut vec![0;e.value.len()]).is_ok(){return Ok(values);}
 }Err(Error::Operand)
}

#[cfg(test)]
