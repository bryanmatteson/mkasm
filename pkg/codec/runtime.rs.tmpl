}
/// Reuses normalized input storage for allocation-free instruction assembly once
/// its input capacity is sufficient. The shortest encoding is selected, with
/// catalog order breaking ties, exactly as in assemble_at(text,address)[0].
#[derive(Default,Debug)]
pub struct Assembler {input:String}
impl Assembler {
 pub const fn new()->Self{Self{input:String::new()}}
 pub fn with_capacity(capacity:usize)->Self{Self{input:String::with_capacity(capacity)}}
 pub fn assemble_into(&mut self,text:&str,address:u64,output:&mut[u8])->Result<usize,Error>{self.assemble_with_features_into(text,address,None,output)}
 /// Leaves output unchanged if no form is legal or the buffer is too small.
 pub fn assemble_with_features_into(&mut self,text:&str,address:u64,active:Option<&[&str]>,output:&mut[u8])->Result<usize,Error>{
  syntax_input_into(text,&mut self.input);let mut best=[0;MAX_INSTRUCTION_BYTES];let mut length=None;let literals=assembly_literal_mask(&self.input);let named=mnemonic_candidates(text,true);let mut feature_cache=assembly_feature_cache(named.len()+DYNAMIC_MNEMONICS.len(),active);
  let dynamic=if DYNAMIC_MNEMONICS_SHORTEST.is_empty(){DYNAMIC_MNEMONICS}else{DYNAMIC_MNEMONICS_SHORTEST};
  // Each group is stable by length. The first legal form is its shortest;
  // dynamic mnemonics can replace a named form only with a shorter encoding.
  for candidates in [named,dynamic]{for &i in candidates{let i=i as usize;let e=&ENCODINGS[i];
   if length.is_some_and(|n|e.value.len()>=n){break;}
   if !assembly_literal_matches(i,literals)||!assembly_features(e,active,&mut feature_cache){continue;}
   if let Some(values)=parse_prepared_syntax(i,&self.input,address){
    // encode_into validates before writing, so rejected shorter forms retain best.
    if let Ok(n)=encode_into(i,&values[..e.operands.len()],&mut best){length=Some(n);break;}
   }
  }}
  let n=length.ok_or(Error::Syntax)?;if output.len()<n{return Err(Error::BufferTooSmall);}output[..n].copy_from_slice(&best[..n]);Ok(n)
 }
}

/// A compiled instruction template. $name binds an operand, _ is a wildcard.
#[derive(Clone,Debug)]
pub struct Template { patterns: Vec<(usize,Vec<Binding>)>, address:u64 }
#[derive(Clone,Debug,PartialEq,Eq)]
enum Binding { Fixed(i128), Hole(String), Any, All(Vec<Binding>) }
impl Binding {
 fn atoms(&self)->std::slice::Iter<'_,Self>{match self{Self::All(atoms)=>atoms.iter(),_=>std::slice::from_ref(self).iter()}}
 fn merge(&self,other:Self)->Option<Self>{
  if self==&other{return Some(other);}
  let atoms=self.atoms().chain(other.atoms()).filter(|b|!matches!(b,Self::Any)).cloned().collect::<Vec<_>>();
  let mut fixed=None;
  for atom in &atoms{if let Self::Fixed(value)=atom{if fixed.is_some_and(|old|old!=*value){return None;}fixed=Some(*value);}}
  let mut unique=Vec::with_capacity(atoms.len());for atom in atoms{if !unique.contains(&atom){unique.push(atom);}}Some(Self::All(unique))
 }
 fn encode_value(&self,holes:&[(&str,i128)])->Option<i128>{
  let mut result=None;
  for atom in self.atoms(){let value=match atom{Self::Fixed(value)=>*value,Self::Hole(name)=>holes.iter().find(|(key,_)|*key==name)?.1,Self::Any|Self::All(_)=>return None};
   if result.is_some_and(|old|old!=value){return None;}result=Some(value);
  }result
 }
}
impl Template {
    pub fn parse(text:&str)->Result<Self,Error>{Self::parse_at(text,0)}
    pub fn parse_at(text:&str,address:u64)->Result<Self,Error>{
        Self::parse_with_features(text,address,None)
    }
    pub fn parse_with_features(text:&str,address:u64,active:Option<&[&str]>)->Result<Self,Error>{
        let mut patterns=Vec::new();let native_dollars=text.as_bytes().windows(2).any(|w|w[0]==b'$'&&w[1]!=b'{');let prepared=if native_dollars{String::new()}else{syntax_input(&template_text(None,text,address))};
        let named=mnemonic_candidates(text,false);
        for &i in named.iter().chain(DYNAMIC_MNEMONICS){let i=i as usize;let e=&ENCODINGS[i];if !features(e,active){continue;}let adjusted=native_dollars.then(||syntax_input(&template_text(Some(e),text,address)));let text=adjusted.as_deref().unwrap_or(&prepared);
         let defaults=e.operands.iter().map(|o|(o.implicit||o.optional).then_some(Binding::Fixed(0))).collect();
         if let Some(values)=syntax_values(i,&text,defaults,|o,token|{
          if token=="\x03"{Some(Binding::Any)}else if let Some(hole)=token.strip_prefix("${").and_then(|s|s.strip_suffix('}')){capture_binding(o,hole)}else{parse_operand(o,token,address).map(Binding::Fixed)}
         }){patterns.push((i,values));}
        }if patterns.is_empty(){Err(Error::Syntax)}else{Ok(Self{patterns,address})}
    }
    fn matching_pattern(&self,src:&[u8])->Option<(usize,[i128;MAX_OPERANDS])>{
        for(pattern,(i,bindings))in self.patterns.iter().enumerate(){let e=&ENCODINGS[*i];if src.len()<e.mask.len()||src.iter().zip(e.mask).zip(e.value).any(|((&s,&m),&v)|s&m!=v){continue;}let Some(values)=decode_values(e,src)else{continue;};if !address_constraints(e,&values,self.address){continue;}
            let ok=bindings.iter().zip(&values).enumerate().all(|(index,(binding,&v))|binding.atoms().all(|atom|match atom{
                Binding::Fixed(x)=>*x==v,Binding::Any=>true,
                Binding::Hole(name)=>!bindings[..index].iter().enumerate().any(|(prior,b)|b.atoms().any(|atom|matches!(atom,Binding::Hole(old) if old==name&&values[prior]!=v))),
