}
fn assembly_candidates(text:&str,prepared:&str,address:u64,active:Option<&[&str]>,mut found:impl FnMut(usize,&[i128],&[u8])){
 let mut bytes=[0;MAX_INSTRUCTION_BYTES];let literals=assembly_literal_mask(prepared);let named=mnemonic_candidates(text,false);let mut feature_cache=assembly_feature_cache(named.len()+DYNAMIC_MNEMONICS.len(),active);
 for &i in named.iter().chain(DYNAMIC_MNEMONICS){let i=i as usize;let e=&ENCODINGS[i];if !assembly_literal_matches(i,literals)||!assembly_features(e,active,&mut feature_cache){continue;}
  if let Some(values)=parse_prepared_syntax(i,prepared,address){if let Ok(n)=encode_into(i,&values[..e.operands.len()],&mut bytes){found(i,&values[..e.operands.len()],&bytes[..n]);}}
