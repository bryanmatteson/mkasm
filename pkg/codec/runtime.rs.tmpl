// Numeric assembly does not need Binding's generic merge/clone machinery.
// Keep its backtracking state in a bounded stack instead of recursive closures.
// Equal repeated operands never change an existing value, so a frame need only
// remember whether it introduced that value in order to undo a failed branch.
#[derive(Clone,Copy)]
struct AssemblyMatchFrame{pattern:usize,text:usize,end:usize,operand:usize,assigned:bool}
fn parse_prepared_iterative(index:usize,text:&str,address:u64)->Option<[i128;MAX_OPERANDS]>{
 let e=&ENCODINGS[index];let program=SYNTAXES[SYNTAX_INDEX[index] as usize].pattern;
 let mut parsed=[None;MAX_OPERANDS];let mut frames=[AssemblyMatchFrame{pattern:0,text:0,end:0,operand:0,assigned:false};MAX_SYNTAX_OPERANDS];
 let(mut pattern,mut rest,mut depth,mut retry)=(program,text,0,None);
 loop{
  if let Some(i)=pattern.iter().position(|&b|b==0xff){
   if literal_prefix(&pattern[..i],rest){
    if let Some((operand,next))=match_operand(&pattern[i+1..]){if let Some(o)=e.operands.get(operand){
     let input=&rest[i..];let mut ready=retry.is_none();let previous=parsed[operand];let mut found=None;
     // A final operand has exactly one endpoint and cannot require rollback
     // after it succeeds. Avoid constructing a frame or invoking a callback.
     if next.is_empty(){
      if let Some(value)=parse_operand(o,input,address){if previous.is_none_or(|old|old==value){parsed[operand]=Some(value);break;}}
     }else{
     syntax_candidate_ends(o,input,next,|end|{
      if !ready{if retry==Some(end){ready=true;}return false;}
      let Some(value)=parse_operand(o,&input[..end],address)else{return false;};
      if previous.is_some_and(|old|old!=value){return false;}found=Some((end,value));true
     });
     if let Some((end,value))=found{
      frames[depth]=AssemblyMatchFrame{pattern:program.len()-pattern.len(),text:text.len()-rest.len(),end,operand,assigned:previous.is_none()};
      parsed[operand]=Some(value);depth+=1;pattern=next;rest=&input[end..];retry=None;continue;
     }
     }
    }}
   }
  }else if pattern.len()==rest.len()&&literal_prefix(pattern,rest){break;}
  if depth==0{return None;}depth-=1;let frame=frames[depth];
  if frame.assigned{parsed[frame.operand]=None;}
  pattern=&program[frame.pattern..];rest=&text[frame.text..];retry=Some(frame.end);
 }
 let mut values=[0;MAX_OPERANDS];for(i,o)in e.operands.iter().enumerate(){values[i]=parsed[i].or_else(||(o.implicit||o.optional).then_some(0))?;}
 address_constraints(e,&values,address).then_some(values)
}
fn parse_prepared_syntax(index:usize,text:&str,address:u64)->Option<[i128;MAX_OPERANDS]>{
 let e=&ENCODINGS[index];
 // Short forms have too little recursion to amortize an explicit frame stack.
 // Keep their small matcher, and reserve iterative backtracking for long forms.
 if e.operands.len()>2||SYNTAXES[SYNTAX_INDEX[index] as usize].pattern.len()>32{return parse_prepared_iterative(index,text,address);}
 let mut parsed=[None;MAX_OPERANDS];
 if !match_syntax(index,text,&mut parsed,&|o,token|parse_operand(o,token,address),&|old,new|(*old==new).then_some(new)){return None;}
 let mut values=[0;MAX_OPERANDS];for(i,o)in e.operands.iter().enumerate(){values[i]=parsed[i].or_else(||(o.implicit||o.optional).then_some(0))?;}
 address_constraints(e,&values,address).then_some(values)
}
fn mnemonic_candidates(text:&str,shortest:bool)->&'static[u32]{
 let name=text.split_whitespace().next().unwrap_or("");
 MNEMONICS.binary_search_by(|(n,_,_)|n.bytes().cmp(name.bytes().map(|b|b.to_ascii_lowercase()))).ok().map(|i|{let(_,original,ordered)=MNEMONICS[i];if shortest&&!ordered.is_empty(){ordered}else{original}}).unwrap_or(&[])
}
// Only large candidate sets carry fingerprints; small catalogs compile these
// checks away. Every required trigram belongs to a literal, never an operand.
fn assembly_literal_mask(text:&str)->u64{
 if ASSEMBLY_LITERALS.is_empty(){return 0;}
