        for(i,bindings)in &self.patterns{let e=&ENCODINGS[*i];if src.len()<e.mask.len()||src.iter().zip(e.mask).zip(e.value).any(|((&s,&m),&v)|s&m!=v){continue;}let Some(values)=decode_values(e,src)else{continue;};if !address_constraints(e,&values,self.address){continue;}let mut holes=Vec::new();let mut ok=true;
            for(b,&v)in bindings.iter().zip(&values).flat_map(|(b,v)|b.atoms().map(move |atom|(atom,v))){match b{Binding::Fixed(x)=>{if *x!=v{ok=false;break;}},Binding::Any=>{},Binding::All(_)=>unreachable!(),Binding::Hole(n)=>{if let Some((_,old))=holes.iter().find(|(name,_)|name==n){if *old!=v{ok=false;break;}}else{holes.push((n.clone(),v));}}}}
