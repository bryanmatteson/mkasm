
/// The complete address calculation for an operand. Values retain the exact
/// semantic units accepted by encode_into, including scaled displacements.
#[derive(Clone,Copy,Debug,PartialEq,Eq,Hash)]
pub enum Position {
    Fixed,
    Relative { bias:i128, pre_align_bias:i128, align_bits:u32, region_bits:u32, wrap_bits:u32, low_wrap_bits:u32, bank_bits:u32 },
}
impl Position {
    pub fn is_position_dependent(self)->bool { self!=Self::Fixed }
    fn base(self,address:u64)->Option<(u64,u32,u32)> {
        let Self::Relative{bias,pre_align_bias,align_bits,region_bits,wrap_bits,low_wrap_bits,bank_bits}=self else{return None;};
        if align_bits>63||region_bits>63||wrap_bits>64||low_wrap_bits>63||low_wrap_bits>wrap_bits||bank_bits>63||(bank_bits>0&&(region_bits>0||bank_bits>wrap_bits)){return None;}
        let base=(address.wrapping_add(pre_align_bias as u64)&!mask(align_bits)).wrapping_add(bias as u64);
        let wrap=if low_wrap_bits>0&&base<(1u64<<low_wrap_bits){low_wrap_bits}else{wrap_bits};
        Some((base,region_bits,wrap))
    }
    pub fn target(self,address:u64,value:i128)->Option<u64> {
        let (base,region,wrap)=self.base(address)?;
        let mut target=if region>0{(base&!mask(region))|(value as u64&mask(region))}else{base.wrapping_add(value as u64)};
        if let Self::Relative{bank_bits,..}=self{if bank_bits>0{let m=mask(bank_bits);target=(address&!m)|(target&m);}}
        Some(if wrap>0{target&mask(wrap)}else{target})
    }
    pub fn value_for_target(self,address:u64,target:u64)->Option<i128> {
        let (mut base,region,wrap)=self.base(address)?;
        if wrap>0{if target&!mask(wrap)!=0{return None;}base&=mask(wrap);}
        if region>0{return (target&!mask(region)==base&!mask(region)).then_some((target&mask(region)) as i128);}
        if let Self::Relative{bank_bits,..}=self{if bank_bits>0{let m=mask(bank_bits);let bank=(address&!m)&if wrap>0{mask(wrap)}else{u64::MAX};if target&!m!=bank{return None;}let shift=64-bank_bits;return Some(((target.wrapping_sub(base)<<shift)as i64>>shift)as i128);}}
        let delta=target.wrapping_sub(base);
        Some(if wrap>0&&wrap<64{let shift=64-wrap;((delta<<shift) as i64>>shift) as i128}else{delta as i64 as i128})
    }
}

/// Necessary bounds for an operand, min + k*step through max. exact means the
/// whole progression is admitted by the field itself; relational constraints
/// and dependent biases are reported conservatively by template hole domains.
#[derive(Clone,Copy,Debug,PartialEq,Eq)]
pub struct Domain { pub min:i128, pub max:i128, pub step:i128, pub exact:bool }
impl Domain {
    pub fn new(min:i128,max:i128,step:i128,exact:bool)->Self {
        let step=step.max(1);let max=if max<=min{min}else{max-(max.rem_euclid(step)-min.rem_euclid(step)).rem_euclid(step)};Self{min,max,step:if min==max{1}else{step},exact}
    }
    pub fn contains(&self,value:i128)->bool {
        self.step>0&&(self.min..=self.max).contains(&value)&&(self.step==1||value.rem_euclid(self.step)==self.min.rem_euclid(self.step))
    }
    pub fn covers(&self,other:&Self)->bool {
        self.step>0&&other.step>0&&self.min<=other.min&&other.max<=self.max&&self.contains(other.min)&&(other.min==other.max||other.step%self.step==0)
    }
}
#[cfg(test)]
fn domain_gcd(mut a:i128,mut b:i128)->i128 {while b!=0{let r=a%b;a=b;b=r;}a.abs()}
impl Operand {
    pub fn is_register(&self)->bool {self.kind=="register"}
    pub fn is_integer(&self)->bool {!self.is_register()}
    pub fn position(&self)->Position {
        if !self.relative{Position::Fixed}else{Position::Relative{bias:self.pc_bias,pre_align_bias:self.pc_pre_align_bias,align_bits:self.pc_align_bits,region_bits:self.pc_region_bits,wrap_bits:self.pc_wrap_bits,low_wrap_bits:self.pc_low_wrap_bits,bank_bits:self.pc_bank_bits}}
    }
    pub fn domain(&self)->Domain { OPERAND_DOMAINS[self.domain_index as usize] }
    #[cfg(test)]
    fn reference_domain(&self)->Domain {
        if self.implicit{return Domain{min:0,max:0,step:1,exact:true};}
        if !self.bias_operand.is_empty(){return Domain{min:i128::MIN,max:i128::MAX,step:1,exact:false};}
        let mut represented=0u64;for b in self.bits{represented|=mask(b.width)<<b.value;}
        if !self.names.is_empty()||!self.lookup.is_empty(){
            let count=if !self.names.is_empty(){self.names.len()}else{self.lookup.len()};
            let mut min=i128::MAX;let mut max=i128::MIN;let mut step=0;let mut first=None;let mut admitted=0i128;
            for raw in 0..count{
                if (raw as u64^self.xor)&!represented!=0||(!self.names.is_empty()&&self.names[raw].is_empty()){continue;}
                let Some(value)=operand_number(self,raw as u64).and_then(|v|v.checked_mul(self.scale)).and_then(|v|v.checked_add(self.bias))else{continue;};
                if let Some(base)=first{step=domain_gcd(step,value-base);}else{first=Some(value);}
                min=min.min(value);max=max.max(value);admitted+=1;
            }
            if admitted==0{return Domain{min:1,max:0,step:1,exact:true};}
            let step=step.max(1);return Domain{min,max,step,exact:(max-min)/step+1==admitted};
        }
        let w=width(self);let sign=1u64<<(w-1);
        let fixed=self.xor&!represented;
        let (min,max)=if self.signed&&represented&sign!=0{(fixed as i128-sign as i128,(fixed|(represented&(sign-1))) as i128)}else{(fixed as i128,(fixed|represented) as i128)};
        let step=(1i128<<represented.trailing_zeros().min(63))*self.scale;
        let normalized=represented>>represented.trailing_zeros().min(63);
        Domain{min:min*self.scale+self.bias,max:max*self.scale+self.bias,step:if min==max{1}else{step},exact:normalized==u64::MAX||normalized&(normalized+1)==0}
    }
}

#[derive(Clone,Debug,PartialEq,Eq)]
pub struct OperandSpan {pub start:usize,pub end:usize,pub encoding:&'static str,pub instruction_index:usize,pub operand_index:usize,pub name:&'static str,pub class:&'static str,pub kind:&'static str,pub value:i128,pub position:Position,pub domain:Domain}
impl OperandSpan {pub fn position_dependent(&self)->bool{self.position.is_position_dependent()}}
#[derive(Clone,Debug,PartialEq,Eq)]
pub struct Described {pub text:String,pub operands:Vec<OperandSpan>}

fn write_operand(out:&mut impl fmt::Write,d:&Decoded,o:&Operand,value:i128,address:u64)->fmt::Result {
    if o.identity_names {
        if value>=0&&(value as usize)<o.names.len()&&!o.names[value as usize].is_empty(){return out.write_str(o.names[value as usize]);}
    } else if !o.names.is_empty(){
        let extra=if o.bias_operand.is_empty(){0}else{value_named(d.encoding(),&d.values,o.bias_operand)*if o.bias_scale==0{1}else{o.bias_scale}};
        let raw=operand_index(o,(value-o.bias-extra)/o.scale).unwrap_or(-1);
        if raw>=0&&(raw as usize)<o.names.len()&&!o.names[raw as usize].is_empty(){return out.write_str(o.names[raw as usize]);}
    }
    if o.kind=="register"{out.write_str(o.prefix)?;number_text::integer(out,value)}
    else if o.kind=="address"&&!o.relative{let mask=if d.encoding().target_mask==0{u64::MAX}else{u64::MAX>>d.encoding().target_mask.leading_zeros()};number_text::hex(out,value as u64&mask)}
    else if o.relative{number_text::hex(out,relative_target(o,value,address))}
    else{number_text::integer(out,value)}
}
// Literal escapes are already resolved in the generated display table.
fn write_literal(out:&mut impl fmt::Write,text:&str)->fmt::Result{out.write_str(text)}

impl Decoded {
    /// Appends formatted assembly to a caller-owned writer without allocating
    /// in the codec. A reusable String or fixed buffer avoids per-call storage.
    pub fn write_to(&self,address:u64,out:&mut impl fmt::Write)->fmt::Result{
        let syntax=&SYNTAXES[SYNTAX_INDEX[self.encoding_index] as usize];
        for &(index,end) in syntax.parts{if end>=u32::MAX-1 {
            let i=index as usize;let operand=&self.encoding().operands[i];let value=self.values[i];
            if end==u32::MAX-1 {
                let names=COMMA_NAMES[operand.comma_names as usize];
                if value>=0&&(value as usize)<names.len()&&!names[value as usize].is_empty(){out.write_str(names[value as usize])?;continue;}
            }
            write_operand(out,self,operand,value,address)?;
            if end==u32::MAX-1{out.write_str(", ")?;}
        } else{write_literal(out,&syntax.display[index as usize..end as usize])?;}}Ok(())
    }
}
fn render_decoded(d:&Decoded,address:u64,capture:bool)->Described {
    let syntax=&SYNTAXES[SYNTAX_INDEX[d.encoding_index] as usize];
    let mut out=Described{text:String::with_capacity(d.encoding().syntax.len()+16),operands:if capture{Vec::with_capacity(d.encoding().operands.len())}else{Vec::new()}};
    for &(index,end) in syntax.parts{if end>=u32::MAX-1{
        let i=index as usize;let o=&d.encoding().operands[i];let value=d.values[i];let start=out.text.len();let _=write_operand(&mut out.text,d,o,value,address);
        if capture{let mut domain=o.domain();domain.exact&=d.encoding().constraints.is_empty();out.operands.push(OperandSpan{start,end:out.text.len(),encoding:d.encoding().id,instruction_index:0,operand_index:i,name:o.name,class:o.class,kind:o.kind,value,position:o.position(),domain});}
        if end==u32::MAX-1 {out.text.push_str(", ");}
    }else{let _=write_literal(&mut out.text,&syntax.display[index as usize..end as usize]);}}out
}
pub fn describe(src:&[u8],address:u64)->Result<Described,Error>{describe_with_features(src,address,None)}
pub fn describe_with_features(src:&[u8],address:u64,active:Option<&[&str]>)->Result<Described,Error>{Ok(decode_with_features(src,active)?.describe(address))}
impl Decoded {
    pub fn describe(&self,address:u64)->Described{render_decoded(self,address,true)}
    pub fn encode_into(&self,output:&mut[u8])->Result<usize,Error>{encode_into(self.encoding_index,&self.values[..self.encoding().operands.len()],output)}
    /// Validates the complete form before committing an operand edit.
    pub fn set_operand(&mut self,name:&str,value:i128)->Result<(),Error>{
        let index=self.encoding().operands.iter().position(|o|o.name==name).ok_or(Error::Operand)?;
        let mut next=self.clone();next.values[index]=value;let mut bytes=[0u8;256];next.encode_into(&mut bytes)?;*self=next;Ok(())
    }
    /// Preserves statically encoded PC-relative targets and every other field.
    /// An exact form that cannot reach its old target returns Operand.
    pub fn relocated(&self,from:u64,to:u64)->Result<Self,Error>{
        let mut next=self.clone();
        if from!=to{for(i,o)in self.encoding().operands.iter().enumerate(){if o.relative{let target=relative_target(o,self.values[i],from);next.values[i]=o.position().value_for_target(to,target).ok_or(Error::Operand)?;}}}
        let mut bytes=[0u8;256];next.encode_into(&mut bytes)?;
        if !address_constraints(next.encoding(),&next.values,to){return Err(Error::Operand);}
        Ok(next)
    }
    pub fn relocate_into(&self,from:u64,to:u64,output:&mut[u8])->Result<usize,Error>{self.relocated(from,to)?.encode_into(output)}
}

#[derive(Clone,Debug,PartialEq,Eq)]
pub struct HoleDomain {pub encoding:&'static str,pub operand:&'static str,pub class:&'static str,pub kind:&'static str,pub domain:Domain,pub position:Position}
#[derive(Clone,Debug,PartialEq,Eq)]
pub struct Hole {pub name:String,pub domains:Vec<HoleDomain>}
impl Hole {
    pub fn position(&self)->Option<Position>{let first=self.domains.first()?.position;self.domains.iter().all(|d|d.position==first).then_some(first)}
}
#[derive(Clone,Copy,Debug)]
pub struct ByteFilter {pub encoding:&'static str,pub mask:&'static[u8],pub value:&'static[u8]}
impl ByteFilter {pub fn matches(&self,src:&[u8])->bool{src.len()>=self.mask.len()&&src.iter().zip(self.mask).zip(self.value).all(|((&b,&m),&v)|b&m==v)}}
fn capture_binding(o:&Operand,hole:&str)->Option<Binding>{
    let (name,class)=hole.split_once(':').map_or((hole,None),|(n,c)|(n,Some(c)));
    if name.is_empty()||!name.bytes().all(|b|b.is_ascii_alphanumeric()||b==b'_'){return None;}
    if class.is_some_and(|c|c.is_empty()||!(c.eq_ignore_ascii_case(o.class)||c.eq_ignore_ascii_case(o.kind)||(c.eq_ignore_ascii_case("integer")&&o.is_integer()))){return None;}
    Some(Binding::Hole(name.to_owned()))
}
// Assembly literals are case insensitive; capture names retain their identity.
fn syntax_input(text:&str)->String{let mut out=String::with_capacity(text.len());syntax_input_into(text,&mut out);out}
fn append_assembly_norm(text:&str,out:&mut String){
 let base=out.len();
 if text.is_ascii(){for b in text.bytes(){if !matches!(b,b' '|b'\t'..=b'\r'){out.push(b.to_ascii_lowercase() as char);}}}
 else{out.extend(text.chars().filter(|c|!c.is_whitespace()).flat_map(char::to_lowercase));}
 let mut i=base;
 while i<out.len(){let bytes=out.as_bytes();
  if bytes[i]==b'-'&&i>base&&i+1<bytes.len()&&bytes[i-1].is_ascii_digit()&&bytes[i+1].is_ascii_digit(){
   let mut start=i;while start>base&&bytes[start-1].is_ascii_digit(){start-=1;}
   if start>base+1&&matches!(bytes[start-1],b'r'|b'w')&&matches!(bytes[start-2],b'('|b'['){out.insert(i,'+');i+=1;}
  }else if bytes[i]==b'-'&&i>=base+3&&i+1<bytes.len()&&bytes[i+1].is_ascii_digit()&&bytes[i-3]==b'('&&bytes[i-2]==b'i'&&matches!(bytes[i-1],b'x'|b'y'){out.insert(i,'+');i+=1;}
  i+=1;
 }
}
fn syntax_input_into(text:&str,out:&mut String){
 out.clear();let mut rest=text;
 while let Some(i)=rest.find("${"){
  append_assembly_norm(&rest[..i],out);rest=&rest[i..];
  let Some(end)=rest.find('}')else{append_assembly_norm(rest,out);return;};
  out.push_str(&rest[..end+1]);rest=&rest[end+1..];
 }append_assembly_norm(rest,out);
}
impl Template {
    /// Opens every explicit field of one exact catalog form, including optional
    /// ignored bits. Unlike text normalization this preserves those raw fields.
    pub fn for_encoding(id:&str,address:u64)->Result<Self,Error>{
        let(i,e)=catalog_entry(id).ok_or(Error::Unknown)?;
        Ok(Self{patterns:vec![(i,e.operands.iter().map(|o|if o.implicit{Binding::Fixed(0)}else{Binding::Hole(o.name.to_owned())}).collect())],address})
    }
    pub fn encodings(&self)->Vec<&'static str>{self.patterns.iter().map(|(i,_)|ENCODINGS[*i].id).collect()}
    pub fn holes(&self)->Vec<Hole>{
        let mut holes:Vec<Hole>=Vec::new();
        for(i,bindings)in &self.patterns{let e=&ENCODINGS[*i];for(o,b,fixed)in e.operands.iter().zip(bindings).flat_map(|(o,b)|{let fixed=b.atoms().find_map(|atom|if let Binding::Fixed(value)=atom{Some(*value)}else{None});b.atoms().map(move |atom|(o,atom,fixed))}){if let Binding::Hole(name)=b{
            let index=if let Some(index)=holes.iter().position(|h|h.name==*name){index}else{holes.push(Hole{name:name.clone(),domains:Vec::new()});holes.len()-1};
            let mut domain=fixed.map_or_else(||o.domain(),|value|Domain::new(value,value,1,true));domain.exact&=e.constraints.is_empty();
            let d=HoleDomain{encoding:e.id,operand:o.name,class:o.class,kind:o.kind,domain,position:o.position()};if !holes[index].domains.contains(&d){holes[index].domains.push(d);}
        }}}
        holes
    }
    pub fn hole_position(&self,index:usize)->Option<Position>{self.holes().get(index)?.position()}
    /// Necessary opcode filters; fixed text operands and relational constraints
    /// are checked by matches. Iteration and could_match do not allocate.
    pub fn byte_filters(&self)->impl Iterator<Item=ByteFilter>+'_ {self.patterns.iter().map(|(i,_)|{let e=&ENCODINGS[*i];ByteFilter{encoding:e.id,mask:e.mask,value:e.value}})}
    pub fn could_match(&self,src:&[u8])->bool{self.byte_filters().any(|f|f.matches(src))}
}

#[cfg(test)]
mod parity_tests {
    use super::*;
    #[test]
    fn generated_domains_match_reference(){for e in ENCODINGS{for o in e.operands{assert_eq!(o.domain(),o.reference_domain(),"{} {}",e.id,o.name);}}}
    #[test]
    fn complete_corpus_analysis_templates_and_relocation(){
        use std::io::Write;
        let mut ledger=std::env::var_os("MKASM_CORPUS_LEDGER_DIR").map(|dir|{
            std::fs::create_dir_all(&dir).unwrap();
            std::io::BufWriter::new(std::fs::File::create(std::path::Path::new(&dir).join(format!("{ARCHITECTURE}.tsv"))).unwrap())
        });
        let mut visited=0;
        for (index,e) in ENCODINGS.iter().enumerate(){
            let active=FEATURE_SETS.iter().find(|(_,f)|e.features.iter().all(|r|f.contains(r))).map(|(_,f)|*f);
            let exact=Template::for_encoding(e.id,0x1000).unwrap();
            for seed in [0,1,128]{
                let values=representative_with_seed(index,seed).unwrap_or_else(|err|panic!("{} sample {seed}: {err:?}",e.id));
                let bytes=encode(e.id,&values).unwrap();
                let d=Decoded{encoding_index:index,values:{let mut all=[0;MAX_OPERANDS];all[..values.len()].copy_from_slice(&values);all},length:bytes.len()};
                let description=d.describe(0x1000);
                assert_eq!(description.operands.len(),escaped_syntax(e.syntax).matches('{').count(),"{} spans",e.id);
                for span in &description.operands{
                    assert!(span.start<=span.end&&span.end<=description.text.len(),"{} span bounds",e.id);
                    assert!(span.domain.contains(span.value),"{} {} domain {:?} excludes {}",e.id,span.name,span.domain,span.value);
                    if let Some(target)=span.position.target(0x1000,span.value){assert_eq!(Some(target),span.position.target(0x1000,span.position.value_for_target(0x1000,target).unwrap()),"{} position inverse",e.id);}
                }
                assert!(exact.could_match(&bytes),"{} prefilter",e.id);
                let (length,captures)=exact.matches(&bytes).unwrap_or_else(||panic!("{} exact template",e.id));assert_eq!(length,bytes.len());
                let borrowed=captures.iter().map(|(n,v)|(n.as_str(),*v)).collect::<Vec<_>>();assert!(exact.encode(&borrowed).unwrap().contains(&bytes),"{} template bytes",e.id);
                for hole in exact.holes(){let value=captures.iter().find(|(n,_)|*n==hole.name).unwrap().1;assert!(hole.domains.iter().all(|d|d.domain.contains(value)),"{} hole {}",e.id,hole.name);}
                let mut output=[0xcc;256];assert_eq!(d.relocate_into(0x1000,0x1000,&mut output).unwrap(),bytes.len());assert_eq!(&output[..bytes.len()],bytes);
                if !e.operands.iter().any(|o|o.relative){assert_eq!(d.relocate_into(0x1000,0x1010,&mut output).unwrap(),bytes.len());assert_eq!(&output[..bytes.len()],bytes);}
                if seed==1{
                    let mut pattern=description.text.clone();
                    for span in description.operands.iter().rev(){pattern.replace_range(span.start..span.end,&format!("${{{}}}",span.name));}
                    let t=Template::parse_with_features(&pattern,0x1000,active).unwrap_or_else(|err|panic!("{} template {pattern}: {err:?}",e.id));
                    let (length,captured)=t.matches(&bytes).unwrap_or_else(||panic!("{} template does not match {pattern}",e.id));assert_eq!(length,bytes.len());
                    let holes=captured.iter().map(|(n,v)|(n.as_str(),*v)).collect::<Vec<_>>();assert!(t.encode(&holes).unwrap().contains(&bytes),"{} text template",e.id);
                    if let Some(file)=&mut ledger{write!(file,"{}\t",e.id).unwrap();for b in &bytes{write!(file,"{b:02x}").unwrap();}writeln!(file,"\t{:?}",description.text).unwrap();}
                }
            }
            visited+=1;
        }
        assert_eq!(visited,ENCODINGS.len());if let Some(file)=&mut ledger{file.flush().unwrap();}
    }
}
