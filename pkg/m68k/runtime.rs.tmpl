use std::borrow::Cow;
use std::fmt;
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Value {
    U(u64),
    I(i64),
    Text(String),
    List(Vec<Value>),
}
impl Value {
    fn u(&self, bits: u32) -> Result<u64, String> {
        let n = match self {
            Self::U(n) => *n,
            Self::I(n) if *n >= 0 => *n as u64,
            _ => return Err("expected unsigned integer".into()),
        };
        if bits < 64 && n >= 1u64 << bits {
            return Err("unsigned integer overflow".into());
        };
        Ok(n)
    }
    fn i(&self, bits: u32) -> Result<i64, String> {
        let n = match self {
            Self::I(n) => *n,
            Self::U(n) if *n <= i64::MAX as u64 => *n as i64,
            _ => return Err("expected signed integer".into()),
        };
        if bits < 64 && (n < -(1i64 << (bits - 1)) || n >= 1i64 << (bits - 1)) {
            return Err("signed integer overflow".into());
        };
        Ok(n)
    }
    fn list(&self, n: Option<usize>) -> Result<&[Value], String> {
        match self {
            Self::List(v) if n.map(|n| n == v.len()).unwrap_or(true) => Ok(v),
            _ => Err("invalid operand array".into()),
        }
    }
    fn text(&self) -> Option<&str> {
        if let Self::Text(s) = self {
            Some(s)
        } else {
            None
        }
    }
}
impl fmt::Display for Value {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::U(n) => write!(f, "{n}"),
            Self::I(n) => write!(f, "{n}"),
            Self::Text(s) => write!(f, "\"{}\"", s),
            Self::List(items) => {
                write!(f, "[")?;
                for (i, v) in items.iter().enumerate() {
                    if i != 0 {
                        write!(f, ",")?
                    };
                    write!(f, "{v}")?
                }
                write!(f, "]")
            }
        }
    }
}
struct Text<'a> {
    s: &'a [u8],
    p: usize,
}
impl Text<'_> {
    fn space(&mut self) {
        while self
            .s
            .get(self.p)
            .map(|b| b.is_ascii_whitespace())
            .unwrap_or(false)
        {
            self.p += 1
        }
    }
    fn value(&mut self, depth: usize) -> Result<Value, String> {
        if depth > 32 {
            return Err("operand nesting too deep".into());
        };
        self.space();
        match *self.s.get(self.p).ok_or("missing value")? {
            b'[' => {
                self.p += 1;
                let mut a = Vec::new();
                loop {
                    self.space();
                    if self.s.get(self.p) == Some(&b']') {
                        self.p += 1;
                        return Ok(Value::List(a));
                    };
                    if !a.is_empty() {
                        if self.s.get(self.p) != Some(&b',') {
                            return Err("expected comma".into());
                        };
                        self.p += 1
                    };
                    a.push(self.value(depth + 1)?)
                }
            }
            b'"' => {
                self.p += 1;
                let start = self.p;
                while self.s.get(self.p).map(|b| *b != b'"').unwrap_or(false) {
                    if self.s[self.p] == b'\\' {
                        return Err("escaped type names are unsupported".into());
                    };
                    self.p += 1
                }
                if self.s.get(self.p) != Some(&b'"') {
                    return Err("unterminated type name".into());
                };
                let s = std::str::from_utf8(&self.s[start..self.p])
                    .map_err(|_| "invalid utf8")?
                    .to_string();
                self.p += 1;
                Ok(Value::Text(s))
            }
            _ => {
                let start = self.p;
                while self
                    .s
                    .get(self.p)
                    .map(|b| !b.is_ascii_whitespace() && *b != b',' && *b != b']')
                    .unwrap_or(false)
                {
                    self.p += 1
                }
                let s = std::str::from_utf8(&self.s[start..self.p]).map_err(|_| "invalid utf8")?;
                let digits = s.strip_prefix('-').unwrap_or(s);
                if digits.is_empty()
                    || !digits.bytes().all(|b| b.is_ascii_digit())
                    || (digits.len() > 1 && digits.starts_with('0'))
                {
                    return Err("invalid JSON integer".into());
                }
                if s.starts_with('-') {
                    Ok(Value::I(s.parse().map_err(|_| "invalid signed number")?))
                } else {
                    Ok(Value::U(s.parse().map_err(|_| "invalid unsigned number")?))
                }
            }
        }
    }
}

#[derive(Debug)]
pub struct Opcode {
    pub id: &'static str,
    pub mnemonic: &'static str,
    pub size: usize,
    pub opcode: u32,
    pub mask: u32,
    pub args: &'static str,
    pub features: u32,
}
fn pairs(o: &Opcode) -> std::slice::ChunksExact<'static,u8> {
    o.args
        .trim_start_matches('.')
        .as_bytes()
        .chunks_exact(2)
}
fn fixed(o: &Opcode) -> usize {
    let mut n = 2;
    for a in pairs(o) {
        let (k, p) = (a[0], a[1]);
        if k == b'#' {
            n = n.max(match p {
                b'l' => 6,
                b'B' | b'C' | b'8' => 2,
                _ => 4,
            })
        };
        if (k == b'L' || k == b'l') && p == b'w' {
            n = n.max(4)
        };
        if b"123789i".contains(&p) {
            n = n.max(4)
        };
        if b"456".contains(&p) {
            n = n.max(6)
        }
    }
    if o.mask & 65535 != 0 || o.args.starts_with('.') {
        n = n.max(4)
    };
    if o.mnemonic == "lpstop" {
        n = n.max(6)
    };
    if o.mnemonic.starts_with("ptrap") && !o.args.is_empty() {
        n = n.max(o.size)
    };
    n
}
fn word(b: &[u8], p: usize) -> Result<u16, String> {
    let a = b.get(p..p + 2).ok_or("truncated instruction")?;
    Ok(u16::from_be_bytes([a[0], a[1]]))
}
fn put(b: &mut [u8], p: usize, n: u16) -> Result<(), String> {
    b.get_mut(p..p + 2)
        .ok_or("truncated instruction")?
        .copy_from_slice(&n.to_be_bytes());
    Ok(())
}
fn signed(n: u64, bits: u32) -> i64 {
    ((n << (64 - bits)) as i64) >> (64 - bits)
}
fn byte_immediate(v: &Value) -> Result<Vec<u8>, String> {
    if let Value::List(a) = v {
        v.list(Some(2))?;
        return a.iter().map(|v| v.u(8).map(|n| n as u8)).collect();
    };
    let n = integer(v)?;
    if !(-128..=255).contains(&n) {
        return Err("byte immediate outside -128..255".into());
    };
    Ok(vec![(n >> 8) as u8, n as u8])
}
fn decode_byte(b: &[u8]) -> Value {
    if b[0] == 0 {
        Value::U(u64::from(b[1]))
    } else if b[0] == 255 && b[1] >= 128 {
        Value::I(i64::from(b[1] as i8))
    } else {
        list(vec![Value::U(u64::from(b[0])), Value::U(u64::from(b[1]))])
    }
}
fn integer(v: &Value) -> Result<i64, String> {
    v.i(64)
}
fn list(v: Vec<Value>) -> Value {
    Value::List(v)
}
fn read_int(b: &[u8], p: &mut usize, bits: u32) -> Result<i64, String> {
    let n = if bits == 8 { 2 } else { bits as usize / 8 };
    let a = b.get(*p..*p + n).ok_or("truncated instruction")?;
    let mut value = 0u64;
    for &x in a {
        value = value << 8 | u64::from(x)
    }
    *p += n;
    Ok(signed(value, bits))
}
fn push_int(b: &mut Vec<u8>, n: i64, bits: u32) -> Result<(), String> {
    let bits = bits.max(16);
    if bits < 64 && (n < -(1i64 << (bits - 1)) || n >= 1i64 << bits) {
        return Err("immediate out of range".into());
    };
    for i in (0..bits / 8).rev() {
        b.push(((n as u64) >> (i * 8)) as u8)
    }
    Ok(())
}
// (word, physical shift, value shift, width, invert)
fn segments(p: u8, b: u32) -> Result<Vec<(usize, u32, u32, u32, bool)>, String> {
    let s = |w, shift| Ok(vec![(w, shift, 0, b, false)]);
    match p {
        b's' | b'f' => s(0, 0),
        b'd' => s(0, 9),
        b'x' => s(0, 6),
        b'1' => s(1, 12),
        b'2' => s(1, 6),
        b'3' | b'j' | b'C' => s(1, 0),
        b'4' => s(2, 12),
        b'5' => s(2, 6),
        b'6' => s(2, 0),
        b'7' => s(1, 7),
        b'8' => s(1, 10),
        b'9' | b'/' => s(1, 5),
        b'k' => s(1, 4),
        b'e' => s(0, 6),
        b'E' | b'I' => s(1, 9),
        b']' => s(0, 10),
        b'F' => s(0, 9),
        b':' => s(1, 2),
        b'h' => s(1, 10),
        b'G' | b'H' => Ok(vec![(0, 7, 0, 1, p == b'G'), (1, 4, 1, 1, false)]),
        b'm' | b'n' => {
            let mut a = vec![(0, 9, 0, 3, false), (0, 6, 3, 1, false)];
            if b > 4 && p == b'm' {
                a.push((1, 7, 4, 1, false))
            };
            Ok(a)
        }
        b'o' => Ok(vec![
            (1, 12, 0, b.min(4), false),
            (1, 7, 4, b.saturating_sub(4), false),
        ]),
        b'M' | b'N' => {
            let mut a = vec![(if p == b'M' { 0 } else { 1 }, 0, 0, b.min(4), false)];
            if b > 4 {
                a.push((1, 6, 4, 1, false))
            };
            Ok(a)
        }
        b'D' => Ok(vec![(1, 12, 0, b, false), (1, 0, 0, b, false)]),
        b't' => Ok(vec![(1, 7, 0, b, false), (1, 10, 0, b, false)]),
        _ => Err(format!("unsupported field placement {}", p as char)),
    }
}
fn field_read(b: &[u8], p: u8, bits: u32) -> Result<u64, String> {
    let mut n = 0;
    let mut known = 0;
    for (w, shift, value, width, invert) in segments(p, bits)? {
        if width == 0 {
            continue;
        };
        let mask = (1u64 << width) - 1;
        let mut v = u64::from(word(b, w * 2)? >> shift) & mask;
        if invert {
            v ^= mask
        };
        v <<= value;
        let m = mask << value;
        if known & m != 0 && n & m != v & m {
            return Err("duplicated operand fields differ".into());
        };
        n |= v;
        known |= m
    }
    Ok(n)
}
fn field_write(b: &mut [u8], p: u8, bits: u32, n: u64) -> Result<(), String> {
    if n >= 1u64 << bits {
        return Err("operand out of range".into());
    };
    for (w, shift, value, width, invert) in segments(p, bits)? {
        if width == 0 {
            continue;
        };
        let mask = ((1u32 << width) - 1) as u16;
        let mut v = ((n >> value) as u16) & mask;
        if invert {
            v ^= mask
        };
        let old = word(b, w * 2)?;
        put(b, w * 2, (old & !(mask << shift)) | (v << shift))?
    }
    Ok(())
}
fn ea_mask(k: u8) -> Option<u16> {
    Some(match k {
        b'*' => 0xfff,
        b'~' => 0x1fc,
        b'%' => 0x1ff,
        b';' => 0xffd,
        b'@' => 0x7fd,
        b'!' => 0x7e4,
        b'&' => 0x1e4,
        b'$' => 0x1fd,
        b'?' => 0x1e5,
        b'/' => 0x7e5,
        b'|' => 0x7e4,
        b'>' => 0x1f4,
        b'<' => 0x7ec,
        b'm' => 0x1f,
        b'n' => 0x220,
        b'o' => 0xdc0,
        b'p' => 0x3f,
        b'q' => 0x3d,
        b'v' => 0x1bd,
        b'b' => 0x23d,
        b'w' => 0x23c,
        b'y' => 0x24,
        b'z' => 0x224,
        b'4' => 0x3c,
        _ => return None,
    })
}
fn valid_ea(k: u8, code: u64) -> bool {
    if code > 60 {
        return false;
    };
    let mut mode = code >> 3;
    if mode == 7 {
        mode = 7 + (code & 7)
    };
    ea_mask(k).map(|m| m & (1u16 << mode) != 0).unwrap_or(false)
}
fn imm_bytes(p: u8) -> usize {
    match p {
        b'b' | b'w' => 2,
        b'l' | b'f' | b's' => 4,
        b'F' => 8,
        b'x' | b'p' => 12,
        _ => 0,
    }
}
#[derive(Clone, Debug)]
pub struct Catalog {
    pub cpu: String,
    features: u32,
}
impl Default for Catalog {
    fn default() -> Self {
        Self::new(DEFAULT_CPU).expect("generated CPU profile")
    }
}
impl Catalog {
    pub fn new(cpu: &str) -> Result<Self, String> {
        let features = PROFILES
            .iter()
            .find(|(n, _)| *n == cpu)
            .ok_or("unknown CPU profile")?
            .1;
        if ARCHITECTURE == "m68k" && features & 1023 == 0
            || ARCHITECTURE == "coldfire" && features & 0x7fc00 == 0
        {
            return Err("CPU profile belongs to other architecture".into());
        };
        Ok(Self {
            cpu: cpu.into(),
            features,
        })
    }
    fn full(&self) -> bool {
        ARCHITECTURE == "m68k" && self.features & (4 | 8 | 16 | 32 | 256 | 512) != 0
    }
    fn ea_read(&self, b: &[u8], p: &mut usize, code: u64, place: u8) -> Result<Value, String> {
        let mode = code >> 3;
        let reg = code & 7;
        let mut a = vec![Value::U(code)];
        if mode == 5 || mode == 7 && (reg == 0 || reg == 2) {
            a.push(Value::I(read_int(b, p, 16)?));
            return Ok(list(a));
        };
        if mode == 7 && reg == 1 {
            a.push(Value::U(read_int(b, p, 32)? as u32 as u64));
            return Ok(list(a));
        };
        if mode == 6 || mode == 7 && reg == 3 {
            let w = word(b, *p)?;
            *p += 2;
            let index = u64::from(w >> 12);
            let long = u64::from(w >> 11 & 1);
            let scale = 1u64 << (w >> 9 & 3);
            if w & 0x100 == 0 {
                if !self.full() && ARCHITECTURE == "m68k" && scale != 1 {
                    return Err("scaled index requires 68020".into());
                };
                if ARCHITECTURE == "coldfire" && long == 0 {
                    return Err("ColdFire index must be long".into());
                };
                return Ok(list(vec![
                    Value::U(code),
                    Value::U(index),
                    Value::U(long),
                    Value::U(scale),
                    Value::U(0),
                    Value::I(signed(u64::from(w & 255), 8)),
                ]));
            };
            if !self.full() {
                return Err("full index extension requires 68020".into());
            };
            if w & 8 != 0 || w & 0x30 == 0 || w & 7 == 4 {
                return Err("reserved full extension format".into());
            };
            let size = u32::from(w >> 4 & 3);
            let bd = if size >= 2 {
                read_int(b, p, (size - 1) * 16)?
            } else {
                0
            };
            let ind = u64::from(w & 7);
            let outer = if ind & 3 >= 2 {
                read_int(b, p, ((ind & 3) - 1) as u32 * 16)?
            } else {
                0
            };
            return Ok(list(vec![
                Value::U(code),
                Value::U(index),
                Value::U(long),
                Value::U(scale),
                Value::U(1),
                Value::I(bd),
                Value::U(u64::from((size - 1) * 16)),
                Value::U(u64::from(w >> 7 & 1)),
                Value::U(u64::from(w >> 6 & 1)),
                Value::U(ind),
                Value::I(outer),
            ]));
        };
        if mode == 7 && reg == 4 {
            let n = imm_bytes(place);
            if n == 0 {
                return Err("immediate addressing forbidden for this size".into());
            };
            let bytes = b.get(*p..*p + n).ok_or("truncated instruction")?;
            if place == b'b' {
                let value = decode_byte(bytes);
                *p += 2;
                return Ok(list(vec![Value::U(60), value]));
            };
            if place == b'w' || place == b'l' || place == b's' {
                return Ok(list(vec![
                    Value::U(60),
                    Value::I(read_int(b, p, n as u32 * 8)?),
                ]));
            };
            let data = bytes.iter().map(|x| Value::U(u64::from(*x))).collect();
            *p += n;
            return Ok(list(vec![Value::U(60), list(data)]));
        };
        if mode >= 7 {
            return Err("reserved effective address".into());
        };
        Ok(list(a))
    }
    fn ea_write(&self, b: &mut Vec<u8>, v: &Value, k: u8, place: u8) -> Result<u64, String> {
        let a = v.list(None)?;
        let code = a.first().ok_or("empty effective address")?.u(6)?;
        if !valid_ea(k, code) {
            return Err("addressing mode forbidden for operand".into());
        };
        let (mode, reg) = (code >> 3, code & 7);
        if mode == 5 || mode == 7 && (reg == 0 || reg == 1 || reg == 2) {
            v.list(Some(2))?;
            if mode == 5 || mode == 7 && reg == 2 {
                a[1].i(16)?;
            };
            push_int(
                b,
                integer(&a[1])?,
                if mode == 7 && reg == 1 { 32 } else { 16 },
            )?;
            return Ok(code);
        };
        if mode == 6 || mode == 7 && reg == 3 {
            let x: Vec<i64> = a.iter().map(integer).collect::<Result<_, _>>()?;
            if x.len() < 6 {
                return Err("invalid indexed address".into());
            };
            if !(0..=15).contains(&x[1]) || !(0..=1).contains(&x[2]) {
                return Err("invalid index register".into());
            };
            let scale = match x[3] {
                1 => 0,
                2 => 1,
                4 => 2,
                8 => 3,
                _ => return Err("invalid index scale".into()),
            };
            let mut w = ((x[1] << 12) | (x[2] << 11) | (scale << 9)) as u16;
            if x[4] == 0 {
                if x.len() != 6 || !(-128..=127).contains(&x[5]) {
                    return Err("brief index displacement out of range".into());
                };
                if ARCHITECTURE == "m68k" && !self.full() && scale != 0 {
                    return Err("scaled index requires 68020".into());
                };
                if ARCHITECTURE == "coldfire" && x[2] == 0 {
                    return Err("ColdFire index must be long".into());
                };
                w |= x[5] as u8 as u16;
                b.extend(w.to_be_bytes());
                return Ok(code);
            };
            if !self.full() || x.len() != 11 || x[4] != 1 {
                return Err("invalid full index extension".into());
            };
            if ![0, 16, 32].contains(&x[6])
                || !(0..=1).contains(&x[7])
                || !(0..=1).contains(&x[8])
                || !(0..=7).contains(&x[9])
                || x[9] == 4
            {
                return Err("reserved full index fields".into());
            };
            w |= 0x100 | (((x[6] / 16 + 1) << 4) | (x[7] << 7) | (x[8] << 6) | x[9]) as u16;
            b.extend(w.to_be_bytes());
            if x[6] != 0 {
                Value::I(x[5]).i(x[6] as u32)?;
                push_int(b, x[5], x[6] as u32)?
            } else if x[5] != 0 {
                return Err("null displacement must be zero".into());
            };
            if x[9] & 3 >= 2 {
                Value::I(x[10]).i(((x[9] & 3) - 1) as u32 * 16)?;
                push_int(b, x[10], ((x[9] & 3) - 1) as u32 * 16)?
            } else if x[10] != 0 {
                return Err("unexpected outer displacement".into());
            };
            return Ok(code);
        };
        if mode == 7 && reg == 4 {
            v.list(Some(2))?;
            let n = imm_bytes(place);
            if n == 0 {
                return Err("invalid immediate size".into());
            };
            if place == b'b' {
                b.extend(byte_immediate(&a[1])?);
                return Ok(code);
            };
            if b"bwls".contains(&place) {
                let value = integer(&a[1])?;
                if place == b'b' {
                    if !(-128..=255).contains(&value) {
                        return Err("byte immediate out of range".into());
                    };
                    b.extend([0, value as u8])
                } else {
                    push_int(b, value, n as u32 * 8)?
                }
            } else {
                for x in a[1].list(Some(n))? {
                    b.push(x.u(8)? as u8)
                }
            };
            return Ok(code);
        };
        v.list(Some(1))?;
        Ok(code)
    }
}
struct Stream<'a> {
    b: Cow<'a, [u8]>,
    p: usize,
    encode: bool,
}
impl Stream<'_> {
    fn field(&mut self, v: &Value, p: u8, bits: u32) -> Result<Value, String> {
        if self.encode {
            field_write(self.b.to_mut(), p, bits, v.u(bits)?)?;
            Ok(v.clone())
        } else {
            Ok(Value::U(field_read(&self.b, p, bits)?))
        }
    }
    fn immediate(
        &mut self,
        v: &Value,
        pos: usize,
        bits: u32,
        consume: bool,
    ) -> Result<Value, String> {
        if bits == 8 {
            if self.encode {
                let data = byte_immediate(v)?;
                if self.b.len() < pos + 2 {
                    self.b.to_mut().resize(pos + 2, 0)
                };
                self.b.to_mut()[pos..pos + 2].copy_from_slice(&data);
                if consume {
                    self.p = pos + 2
                };
                return Ok(v.clone());
            };
            let data = self.b.get(pos..pos + 2).ok_or("truncated instruction")?;
            if consume {
                self.p = pos + 2
            };
            return Ok(decode_byte(data));
        };
        let n = if bits == 8 { 2 } else { bits as usize / 8 };
        if self.encode {
            let value = integer(v)?;
            if bits < 64 && (value < -(1i64 << (bits - 1)) || value >= 1i64 << bits) {
                return Err("immediate out of range".into());
            };
            if self.b.len() < pos + n {
                self.b.to_mut().resize(pos + n, 0)
            };
            if bits == 8 {
                self.b.to_mut()[pos] = 0;
                self.b.to_mut()[pos + 1] = value as u8
            } else {
                for i in 0..n {
                    self.b.to_mut()[pos + i] = ((value as u64) >> ((n - 1 - i) * 8)) as u8
                }
            };
            if consume {
                self.p = pos + n
            };
            Ok(v.clone())
        } else {
            let mut p = pos;
            let value = read_int(&self.b, &mut p, bits)?;
            if consume {
                self.p = p
            };
            Ok(Value::I(value))
        }
    }
}
fn constant(k: u8) -> Option<&'static str> {
    Some(match k {
        b'C' => "ccr",
        b'S' => "sr",
        b'U' => "usp",
        b'E' => "acc",
        b'G' => "macsr",
        b'H' => "mask",
        b'V' => "val",
        _ => return None,
    })
}
fn width(k: u8) -> Option<u32> {
    Some(match k {
        b'D' | b'A' | b'a' | b'+' | b'-' | b'F' | b's' | b't' => 3,
        b'R' | b'r' | b'T' => 4,
        b'u' | b'X' | b'Y' | b'Z' | b'W' | b'0' | b'1' | b'2' | b'3' | b'f' => 5,
        b'O' => 6,
        b'J' => 12,
        b'c' | b'e' | b'i' => 2,
        b'g' => 1,
        b'K' => 9,
        _ => return None,
    })
}
impl Catalog {
    fn operand(&self, s: &mut Stream, o: &Opcode, a: &[u8], v: &Value) -> Result<Value, String> {
        let (k, p) = (a[0], a[1]);
        let normalized = if s.encode {
            register_value(k, p, v)
        } else {
            v.clone()
        };
        let v = &normalized;
        if let Some(name) = constant(k) {
            if s.encode && v.text() != Some(name) {
                return Err(format!("expected {name}"));
            };
            return Ok(Value::Text(name.into()));
        };
        if ea_mask(k).is_some() {
            if s.encode {
                let (address, mask) = if p == b'/' {
                    let a = v.list(Some(2))?;
                    (&a[0], Some(&a[1]))
                } else {
                    (v, None)
                };
                let mut code = self.ea_write(s.b.to_mut(), address, k, p)?;
                s.p = s.b.len();
                if p == b'd' {
                    code = (code & 7) << 3 | (code >> 3) & 7;
                    field_write(s.b.to_mut(), b'x', 6, code)?
                } else {
                    if let Some(mask) = mask {
                        s.field(mask, b'/', 1)?;
                    };
                    field_write(s.b.to_mut(), b's', 6, code)?
                };
                return Ok(v.clone());
            };
            let mut code = field_read(&s.b, if p == b'd' { b'x' } else { b's' }, 6)?;
            if p == b'd' {
                code = (code & 7) << 3 | (code >> 3) & 7
            };
            if !valid_ea(k, code) {
                return Err("invalid effective address class".into());
            };
            let value = self.ea_read(&s.b, &mut s.p, code, p)?;
            if p == b'/' {
                let mask = s.field(v, b'/', 1)?;
                return Ok(list(vec![value, mask]));
            };
            return Ok(value);
        };
        if k == b'#' || k == b'^' {
            if p == b'j' {
                return s.field(v, b'j', 12);
            };
            if p == b'B' {
                if s.encode {
                    let n = integer(v)?;
                    if !(-128..=127).contains(&n) {
                        return Err("moveq immediate out of range".into());
                    };
                    field_write(s.b.to_mut(), b's', 8, n as u8 as u64)?;
                    return Ok(v.clone());
                };
                return Ok(Value::I(signed(field_read(&s.b, b's', 8)?, 8)));
            };
            if let Some(bits) = match p {
                b's' => Some(4),
                b'C' => Some(7),
                b'8' => Some(3),
                b'3' => Some(8),
                _ => None,
            } {
                return s.field(v, p, bits);
            };
            let pos = if k == b'^' || o.mask & 65535 == 65535 || o.mnemonic.starts_with("ptrap") {
                4
            } else {
                2
            };
            let bits = match p {
                b'b' => 8,
                b'w' | b'W' => 16,
                b'l' => 32,
                _ => return Err("unknown immediate location".into()),
            };
            let value = s.immediate(v, pos, bits, false)?;
            s.p = s.p.max(pos + (bits as usize / 8).max(2));
