use mkasm_cil::*;
#[test]
fn public_templates_and_method_streams() {
    let mut template = Template::parse("ldc.i4 $value", 0).unwrap();
    let bytes = template.encode(Some(Operand::Integer(42)), 0).unwrap();
    let captured = template.matches(&bytes, 0).unwrap();
    assert_eq!(captured.operand, Operand::Integer(42));
    template.bind(captured.operand).unwrap();
    assert_eq!(template.encode(None, 0).unwrap(), bytes);
    assert!(template.encode(Some(Operand::Integer(43)), 0).is_err());
    let code =
        assemble_method("start: ldc.i4.0\nswitch (start, done)\nbr.s start\ndone: ret").unwrap();
    let instructions = decode_method(&code).unwrap();
    assert_eq!(encode_method(&instructions).unwrap(), code);
    assert_eq!(
        assemble_method(&format_method(&instructions).unwrap()).unwrap(),
        code
    );
    let nan = Instruction::new("ldc.r8", Operand::Float64(0xfff8000000004321)).unwrap();
    let raw = encode(&nan, 0).unwrap();
    assert_eq!(
        assemble(&format(&decode(&raw, 0).unwrap()).unwrap(), 0).unwrap(),
        raw
    );
}
#[test]
fn public_bodies_sections_and_errors() {
    let code =
        assemble_method("nop\nleave.s end\npop\nleave.s end\nnop\nendfinally\nend: ret").unwrap();
    let mut body = MethodBody {
        tiny: false,
        max_stack: 2,
        init_locals: false,
        local_signature_token: 0,
        code,
        sections: vec![
            ExceptionSection {
                fat: false,
                clauses: vec![ExceptionClause {
                    flags: 0,
                    try_offset: 0,
                    try_length: 1,
                    handler_offset: 3,
                    handler_length: 1,
                    class_token_or_filter_offset: 0x01000001,
                }],
            },
            ExceptionSection {
                fat: true,
                clauses: vec![ExceptionClause {
                    flags: 4,
                    try_offset: 6,
                    try_length: 1,
                    handler_offset: 7,
                    handler_length: 1,
                    class_token_or_filter_offset: 0,
                }],
            },
        ],
        padding: vec![0xaa, 0xbb, 0xcc],
        length: 0,
    };
    let bytes = encode_method_body(&body).unwrap();
    let decoded = decode_method_body(&bytes).unwrap();
    assert_eq!(decoded.sections, body.sections);
    assert_eq!(decoded.padding, body.padding);
    assert_eq!(encode_method_body(&decoded).unwrap(), bytes);
    body.sections[0].clauses[0].handler_offset = 0;
    assert!(encode_method_body(&body).is_err());
    assert!(decode(&[], 0).is_err());
    assert!(decode(&[0xfe], 0).is_err());
    assert!(decode(&[0x24], 0).is_err());
    assert!(assemble("br €", 0).is_err());
    assert!(encode(&Instruction::new("ret", Operand::None).unwrap(), u32::MAX).is_err());
}
#[test]
fn public_scalar_boundaries_and_source_metadata() {
    assert_eq!(DEFINITIONS.len(), 218);
    assert_eq!(DEFINITIONS.iter().filter(|d| d.prefix).count(), 5);
    assert_eq!(lookup("call").unwrap().pop_count, -1);
    assert_eq!(lookup("switch").unwrap().flow, "COND_BRANCH");
    for (name, values) in [
        ("ldc.i4.s", vec![-128, 127]),
        ("ldc.i4", vec![i32::MIN as i64, i32::MAX as i64]),
        ("ldc.i8", vec![i64::MIN, i64::MAX]),
        ("unaligned.", vec![1, 2, 4]),
    ] {
        for value in values {
            let i = Instruction::new(name, Operand::Integer(value)).unwrap();
            assert_eq!(
                decode(&encode(&i, 0).unwrap(), 0).unwrap().operand,
                i.operand
            );
        }
    }
    for (name, values) in [("ldarg.s", vec![0, 255]), ("ldarg", vec![0, 65535])] {
        for value in values {
            let i = Instruction::new(name, Operand::Variable(value)).unwrap();
            assert_eq!(
                decode(&encode(&i, 0).unwrap(), 0).unwrap().operand,
                i.operand
            );
        }
    }
}

#[test]
fn public_exact_float_bits() {
    for bits in [
        0, 0x80000000, 0x7f800000, 0xff800000, 0x7fc12345, 0xffffffff,
    ] {
        let x = Instruction::new("ldc.r4", Operand::Float32(bits)).unwrap();
        let b = encode(&x, 0).unwrap();
        let x = decode(&b, 0).unwrap();
        assert_eq!(x.operand, Operand::Float32(bits));
        assert_eq!(assemble(&format(&x).unwrap(), 0).unwrap(), b);
    }
    for bits in [
        0,
        0x8000000000000000,
        0x7ff0000000000000,
        0xfff0000000000000,
        0x7ff0000000000001,
        0xffffffffffffffff,
    ] {
        let x = Instruction::new("ldc.r8", Operand::Float64(bits)).unwrap();
        let b = encode(&x, 0).unwrap();
        let x = decode(&b, 0).unwrap();
        assert_eq!(x.operand, Operand::Float64(bits));
        assert_eq!(assemble(&format(&x).unwrap(), 0).unwrap(), b);
    }
}
