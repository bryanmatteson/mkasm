fn u16at(s: &[u8], at: usize) -> u16 {
    u16::from_le_bytes(s[at..at + 2].try_into().unwrap())
}
fn u32at(s: &[u8], at: usize) -> u32 {
    u32::from_le_bytes(s[at..at + 4].try_into().unwrap())
}
fn u64at(s: &[u8], at: usize) -> u64 {
