    let mut n = operand_bytes(d);
    let operand = if d.operand_kind == "switch" {
        if s.len() < size + 4 {
            return Err(Error::Truncated);
        }
        let count = u32at(s, size) as usize;
        if count > (s.len() - size - 4) / 4 {
            return Err(Error::Truncated);
