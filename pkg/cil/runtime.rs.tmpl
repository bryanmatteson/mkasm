}
static OPCODE_INDEX: [u16; 512] = {
    let mut index = [u16::MAX; 512];
    let mut i = 0;
    while i < DEFINITIONS.len() {
        let op = DEFINITIONS[i].opcode;
        let slot = if op < 256 { op as usize } else { 256 + (op & 255) as usize };
        index[slot] = i as u16; i += 1;
    }
