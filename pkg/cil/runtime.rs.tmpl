                match n {
                    1 => raw as i8 as i64,
                    4 => raw as i32 as i64,
                    _ => raw as i64,
                }
            }),
            "variable" => Operand::Variable(raw as u16),
            "token" => Operand::Token(raw as u32),
            "float32" => Operand::Float32(raw as u32),
            "float64" => Operand::Float64(raw),
            "branch" => Operand::Branch(if n == 1 { raw as i8 as i32 } else { raw as i32 }),
