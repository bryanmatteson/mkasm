        ("variable", Operand::Variable(v)) => {
            if n == 1 && *v > 255 {
                return malformed("variable index range");
            }
        }
        ("token", Operand::Token(v)) => {
            if !token_valid(d.operand, *v) {
                return malformed("invalid token");
            }
        }
        ("float32", Operand::Float32(_)) | ("float64", Operand::Float64(_)) => {}
        ("branch", Operand::Branch(v)) => {
            if n == 1 && i8::try_from(*v).is_err() {
                return malformed("branch range");
            }
        }
        ("switch", Operand::Switch(v)) => {
