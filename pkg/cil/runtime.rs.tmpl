}
fn operand_bytes(d: &Definition) -> usize {
    match d.operand {
        "InlineNone" => 0,
        "ShortInlineI" | "ShortInlineVar" | "ShortInlineBrTarget" => 1,
        "InlineVar" => 2,
        "InlineI8" | "InlineR" => 8,
        _ => 4,
