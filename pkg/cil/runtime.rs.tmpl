    let t = v >> 24;
    match class {
        "InlineMethod" => matches!(t, 6 | 10 | 43),
        "InlineField" => matches!(t, 4 | 10),
        "InlineType" => matches!(t, 1 | 2 | 27),
        "InlineSig" => t == 17,
        "InlineString" => t == 112,
        "InlineTok" => matches!(t, 1 | 2 | 4 | 6 | 10 | 27 | 43),
        _ => false,
    }
}
fn validate_operand(d: &Definition, o: &Operand) -> Result<()> {
