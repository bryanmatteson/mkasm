pub fn encode(x: &Instruction, offset: u32) -> Result<Vec<u8>> {
    let d = definition(x.opcode).ok_or(Error::Reserved(x.opcode))?;
    validate_operand(d, &x.operand)?;
    let mut out = if d.size == 2 {
        vec![0xfe, d.opcode as u8]
    } else {
        vec![d.opcode as u8]
    };
    if let Operand::Switch(v) = &x.operand {
        out.extend_from_slice(&(v.len() as u32).to_le_bytes());
        for x in v {
            out.extend_from_slice(&x.to_le_bytes())
        }
    } else {
        let raw = match x.operand {
            Operand::None => 0,
            Operand::Integer(v) => v as u64,
            Operand::Variable(v) => u64::from(v),
            Operand::Token(v) => u64::from(v),
            Operand::Float32(v) => u64::from(v),
            Operand::Float64(v) => v,
            Operand::Branch(v) => v as u64,
            Operand::Switch(_) => unreachable!(),
        };
        out.extend_from_slice(&raw.to_le_bytes()[..operand_bytes(d)])
    }
    if u64::from(offset) + out.len() as u64 > u64::from(u32::MAX) {
        return malformed("offset overflow");
    }
