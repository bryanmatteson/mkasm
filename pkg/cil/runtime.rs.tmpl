            (0..count)
                .map(|i| u32at(s, size + 4 + 4 * i) as i32)
                .collect(),
        )
    } else {
        if s.len() < size + n {
            return Err(Error::Truncated);
        }
        let raw = match n {
            0 => 0,
            1 => u64::from(s[size]),
            2 => u64::from(u16at(s, size)),
            4 => u64::from(u32at(s, size)),
            8 => u64at(s, size),
            _ => unreachable!(),
        };
