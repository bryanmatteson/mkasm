        "VPCOMPRESSB" | "VPCOMPRESSW" => 0x63,
        "VPCOMPRESSD" | "VPCOMPRESSQ" => 0x8b,
        "VCOMPRESSPS" | "VCOMPRESSPD" => 0x8a,
        "VPEXPANDB" | "VPEXPANDW" => 0x62,
        "VPEXPANDD" | "VPEXPANDQ" => 0x89,
        "VEXPANDPS" | "VEXPANDPD" => 0x88,
        "VPERMB" | "VPERMW" => 0x8d,
        "VPERMD" | "VPERMQ" if e.map == 2 => 0x36,
        "VPERMPS" | "VPERMPD" if e.map == 2 => 0x16,
        "VPERMI2B" | "VPERMI2W" => 0x75,
        "VPERMI2D" | "VPERMI2Q" => 0x76,
        "VPERMI2PS" | "VPERMI2PD" => 0x77,
        "VPERMT2B" | "VPERMT2W" => 0x7d,
        "VPERMT2D" | "VPERMT2Q" => 0x7e,
        "VPERMT2PS" | "VPERMT2PD" => 0x7f,
        "VPERMQ" if e.map == 3 => 0,
        "VPERMPD" if e.map == 3 => 1,
        "VPERMILPS" if e.map == 3 => 4,
        "VPERMILPD" if e.map == 3 => 5,
        "VPERMILPS" if e.map == 2 => 0x0c,
        "VPERMILPD" if e.map == 2 => 0x0d,
        "VPERM2F128" => 6,
        "VPERM2I128" => 0x46,
        "VPTERNLOGD" | "VPTERNLOGQ" => 0x25,
        "VPMULTISHIFTQB" => 0x83,
        "VPSHUFBITQMB" => 0x8f,
        _ => return None,
