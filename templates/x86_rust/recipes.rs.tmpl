        || expand
        || name.starts_with("VPERMI2")
        || name.starts_with("VPERMT2")
        || matches!(
            name,
            "VPERMB" | "VPERMW" | "VPTERNLOGD" | "VPTERNLOGQ" | "VPMULTISHIFTQB" | "VPSHUFBITQMB"
        ))
        && e.kind != 2
    {
        return None;
