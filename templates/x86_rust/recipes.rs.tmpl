                    B::Add,
                    bin(
                        B::Add,
                        bin(B::Add, bin(B::Add, rotate_left(av.clone(), 5), f), ev),
                        b[3 - i].clone(),
                    ),
                    k.clone(),
                ));
                ev = dv;
                dv = cv;
                cv = r.bind(rotate_left(bv, 30));
                bv = av;
                av = next;
            }
            out = vec![dv, cv, bv, av];
        }
