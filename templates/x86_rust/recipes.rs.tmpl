                    0 => sha_choice(bv.clone(), cv.clone(), dv.clone()),
                    2 => sha_majority(bv.clone(), cv.clone(), dv.clone()),
                    _ => bin(B::Xor, bin(B::Xor, bv.clone(), cv.clone()), dv.clone()),
