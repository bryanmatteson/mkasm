                    let row = Expr::extract(matrix.clone(), (7 - bit) * 8, 8);
                    let parity = Expr::cast(
                        bin(
                            B::And,
                            Expr::unary(U::PopulationCount, bin(B::And, row, x.clone())),
                            c(8, 1),
                        ),
                        8,
                        false,
                    );
                    value = bin(B::Or, value, bin(B::Shl, parity, c(8, u64::from(bit))));
                }
