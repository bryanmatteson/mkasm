            }
            out.reverse();
        }
        "SHA256MSG1" => {
            for i in 0..4 {
                out.push(r.bind(bin(
                    B::Add,
                    a[i].clone(),
                    sha_sigma(
                        if i < 3 {
                            a[i + 1].clone()
                        } else {
                            b[0].clone()
                        },
                        0,
                    ),
                )));
            }
        }
        "SHA256MSG2" => {
            for i in 0..4 {
                let value = if i < 2 {
                    b[i + 2].clone()
                } else {
                    out[i - 2].clone()
                };
                out.push(r.bind(bin(B::Add, a[i].clone(), sha_sigma(value, 1))));
            }
        }
