        "SHA1NEXTE" => (2, 0xc8),
        "SHA1MSG1" => (2, 0xc9),
        "SHA1MSG2" => (2, 0xca),
        "SHA1RNDS4" => (3, 0xcc),
        "SHA256RNDS2" => (2, 0xcb),
        "SHA256MSG1" => (2, 0xcc),
        "SHA256MSG2" => (2, 0xcd),
        _ => return None,
    };
