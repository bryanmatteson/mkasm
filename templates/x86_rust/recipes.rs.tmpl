        return Some(r);
    }
    if mask_output {
        if ops.len() != 3 || ops[0].register?.class != RegisterClass::Mask || p.zeroing {
            return None;
        }
        let data = specialized_source(&mut r, d, ops[1], ip, vl)?;
        let controls = specialized_source_access(&mut r, d, ops[2], ip, vl, 8, true)?;
        let mut value = c(64, 0);
        for i in 0..usize::from(vl / 8) {
            let index = bin(B::And, specialized_element(&controls, i, 8), c(8, 63));
            let selected = Expr::extract(
                bin(B::Lsr, data[i / 8].clone(), Expr::cast(index, 64, false)),
                0,
                1,
            );
            let selected = bin(B::And, fp_active(d, i as u16), selected);
            value = r.bind(bin(
                B::Or,
                value,
                bin(B::Shl, Expr::cast(selected, 64, false), c(64, i as u64)),
            ));
        }
        r.write(
            register("x86.mask", u16::from(ops[0].register?.number), 64, 64),
            WritePolicy::ZeroUpper,
            value,
        );
        return Some(r);
    }
    let ternary = name.starts_with("VPTERNLOG");
    let two_tables = name.starts_with("VPERMI2") || name.starts_with("VPERMT2");
    let lanes128 = matches!(name, "VPERM2I128" | "VPERM2F128");
    let local = name.starts_with("VPERMIL");
    let expected = if ternary || lanes128 { 4 } else { 3 };
    if ops.len() != expected {
        return None;
    }
    let imm = if immediate {
        let o = ops[expected - 1];
        if o.kind != OperandKind::Immediate {
            return None;
        }
        o.immediate.value as u8
    } else {
        0
    };
    if lanes128 {
        if e.kind != 1 || vl != 256 || p.mask != 0 {
            return None;
        }
        let a = specialized_source(&mut r, d, ops[1], ip, vl)?;
        let b = specialized_source(&mut r, d, ops[2], ip, vl)?;
        let all: Vec<_> = a.into_iter().chain(b).collect();
        let mut out = Vec::new();
        for half in 0..2 {
            let control = imm >> (half * 4);
            for j in 0..2 {
                out.push(if control & 8 != 0 {
                    c(64, 0)
                } else {
                    all[usize::from(control & 3) * 2 + j].clone()
                });
            }
        }
        specialized_output(&mut r, d, ops[0], ip, 64, out)?;
        return Some(r);
    }
    if ternary {
        let a = specialized_source(&mut r, d, ops[0], ip, vl)?;
        let b = specialized_source(&mut r, d, ops[1], ip, vl)?;
        let cc = specialized_source_access(&mut r, d, ops[2], ip, vl, w, true)?;
        let mut out = Vec::new();
        for i in 0..n {
            let values = [
                specialized_element(&cc, i, w),
                specialized_element(&b, i, w),
                specialized_element(&a, i, w),
            ];
            let mut value = c(w, 0);
            for truth in 0..8 {
                if imm >> truth & 1 != 0 {
                    let mut term = c(w, u64::MAX);
                    for bit in 0..3 {
                        term = bin(
                            B::And,
                            term,
                            if truth >> bit & 1 != 0 {
                                values[bit].clone()
                            } else {
                                inv(values[bit].clone())
                            },
                        );
                    }
                    value = r.bind(bin(B::Or, value, term));
                }
            }
            out.push(value);
        }
        specialized_output(&mut r, d, ops[0], ip, w, out)?;
        return Some(r);
    }
    if name == "VPMULTISHIFTQB" {
        let controls = specialized_source(&mut r, d, ops[1], ip, vl)?;
        let data = specialized_source(&mut r, d, ops[2], ip, vl)?;
        let mut out = Vec::new();
        for i in 0..usize::from(vl / 8) {
            let control = Expr::cast(
                bin(B::And, specialized_element(&controls, i, 8), c(8, 63)),
                64,
                false,
            );
            out.push(Expr::extract(
                bin(B::Ror, data[i / 8].clone(), control),
                0,
                8,
            ));
        }
        specialized_output(&mut r, d, ops[0], ip, 8, out)?;
        return Some(r);
    }
    let index_operand = if name.starts_with("VPERMI2") {
        ops[0]
    } else if local {
        ops[2]
    } else {
        ops[1]
    };
    let data_operand = if immediate || local { ops[1] } else { ops[2] };
    let index = if immediate {
        Vec::new()
    } else {
        specialized_source(&mut r, d, index_operand, ip, vl)?
    };
    let data = specialized_source(&mut r, d, data_operand, ip, vl)?;
    let mut table: Vec<_> = (0..n).map(|i| specialized_element(&data, i, w)).collect();
    if two_tables {
        let first = if name.starts_with("VPERMI2") {
            ops[1]
        } else {
            ops[0]
        };
        let first = specialized_source(&mut r, d, first, ip, vl)?;
        let mut values: Vec<_> = (0..n).map(|i| specialized_element(&first, i, w)).collect();
        values.extend(table);
        table = values;
    }
    if immediate && !local && n < 4 {
        return None;
    }
    let mut out = Vec::new();
    for i in 0..n {
        let (start, count) = if local {
            let count = 128 / usize::from(w);
            (i / count * count, count)
        } else if immediate {
            (i / 4 * 4, 4)
        } else {
            (0, table.len())
        };
        let selected = if immediate {
            let shift = if local && w == 64 { i } else { (i % 4) * 2 };
            c(w, u64::from(imm >> shift) & (count as u64 - 1))
        } else {
            let x = specialized_element(&index, i, w);
            let x = if local && w == 64 {
                bin(B::Lsr, x, c(w, 1))
            } else {
                x
            };
            bin(B::And, x, c(w, count as u64 - 1))
        };
        out.push(select_vector_element(
            &mut r,
            &table[start..start + count],
            selected,
        ));
    }
    specialized_output(&mut r, d, ops[0], ip, w, out)?;
    Some(r)
}
fn mask_storage(o: &DecodedOperand, w: u8) -> Option<Expr> {
    let reg = o.register?;
    if reg.class != RegisterClass::Mask {
        return None;
    }
    Some(Expr::register(register(
        "x86.mask",
        u16::from(reg.number),
        w,
        64,
    )))
}
fn specialized_masks(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if e.kind != 1 || p.lock || p.mask != 0 || p.zeroing || p.broadcast || !hidden_registers(d, &[])
    {
        return None;
    }
    let name = e.mnemonic;
    let (base, w) = if matches!(
        name,
        "KAND" | "KANDN" | "KOR" | "KXOR" | "KXNOR" | "KNOT" | "KORTEST" | "KMOV"
    ) {
        (name, 16)
    } else if let Some(n) = name.strip_suffix('B') {
        (n, 8)
    } else if let Some(n) = name.strip_suffix('W') {
        (n, 16)
    } else if let Some(n) = name.strip_suffix('D') {
        (n, 32)
    } else if let Some(n) = name.strip_suffix('Q') {
        (n, 64)
    } else {
        return None;
    };
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
    let shift = matches!(base, "KSHIFTL" | "KSHIFTR");
    let unpack = name.starts_with("KUNPCK");
    let movement = base == "KMOV";
    let test = matches!(base, "KTEST" | "KORTEST");
    let opcode = match base {
        "KAND" => 0x41,
        "KANDN" => 0x42,
        "KOR" => 0x45,
        "KXOR" => 0x47,
        "KXNOR" => 0x46,
        "KADD" => 0x4a,
        "KNOT" => 0x44,
        "KTEST" => 0x99,
        "KORTEST" => 0x98,
        "KSHIFTL" => {
            if w <= 16 {
                0x32
            } else {
                0x33
            }
        }
        "KSHIFTR" => {
            if w <= 16 {
                0x30
            } else {
                0x31
            }
        }
        "KMOV" if matches!(e.opcode, 0x90..=0x93) => e.opcode,
        _ if unpack => 0x4b,
        _ => return None,
    };
    let prefix = if shift || name == "KUNPCKBW" {
        1
    } else if unpack {
        0
    } else if movement && matches!(e.opcode, 0x92 | 0x93) && w >= 32 {
        3
    } else if matches!(w, 8 | 32) {
        1
    } else {
        0
    };
    if e.map != if shift { 3 } else { 1 }
        || e.opcode != opcode
        || e.mandatory != prefix
        || p.repeat != if prefix == 3 { 4 } else { 0 }
    {
        return None;
    }
    let expected = if test || movement || base == "KNOT" {
        2
    } else {
        3
    };
    if ops.len() != expected {
        return None;
    }
    let mut r = float_recipe(d, ip);
    if movement {
        let source = if ops[1]
            .register
            .is_some_and(|reg| reg.class == RegisterClass::Mask)
        {
            mask_storage(ops[1], w)?
        } else {
            read(d, ops[1], ip, w)?
        };
        if ops[0]
            .register
            .is_some_and(|reg| reg.class == RegisterClass::Mask)
        {
            r.write(
                register("x86.mask", u16::from(ops[0].register?.number), w, 64),
                WritePolicy::ZeroUpper,
                source,
            );
        } else {
            write(
                &mut r,
                d,
                ops[0],
                ip,
                Expr::cast(source, width(ops[0])?, false),
            )?;
        }
        return Some(r);
    }
    let a = mask_storage(ops[if test { 0 } else { 1 }], w)?;
    let value = if test {
        let b = mask_storage(ops[1], w)?;
        let combined = bin(
            if base == "KTEST" { B::And } else { B::Or },
            a.clone(),
            b.clone(),
        );
        setflag(&mut r, 3, bin(B::Eq, combined.clone(), c(w, 0)));
        setflag(
            &mut r,
            0,
            if base == "KTEST" {
                bin(B::Eq, bin(B::And, inv(a), b), c(w, 0))
            } else {
                bin(B::Eq, combined, c(w, u64::MAX))
            },
        );
        for index in [1, 2, 4, 5] {
            setflag(&mut r, index, c(1, 0));
        }
        return Some(r);
    } else if base == "KNOT" {
        inv(a)
    } else if shift {
        if ops[2].kind != OperandKind::Immediate {
            return None;
        }
        bin(
            if base == "KSHIFTL" { B::Shl } else { B::Lsr },
            a,
            c(w, ops[2].immediate.value),
        )
    } else {
        let b = mask_storage(ops[2], w)?;
        match base {
            "KAND" => bin(B::And, a, b),
            "KANDN" => bin(B::And, inv(a), b),
            "KOR" => bin(B::Or, a, b),
            "KXOR" => bin(B::Xor, a, b),
            "KXNOR" => inv(bin(B::Xor, a, b)),
            "KADD" => bin(B::Add, a, b),
            _ if unpack => bin(
                B::Or,
                bin(B::Shl, a, c(w, u64::from(w / 2))),
                bin(B::And, b, c(w, (1u64 << (w / 2)) - 1)),
            ),
            _ => return None,
        }
    };
    r.write(
        register("x86.mask", u16::from(ops[0].register?.number), w, 64),
        WritePolicy::ZeroUpper,
        value,
    );
    Some(r)
}

// x87 payloads are logical ST0..ST7, transported as scalar [low64,high16].
// Environment banks are explicit architectural/target state, never host FP state.
fn x87_env(bank: &'static str, width: u8) -> Expr {
    Expr::register(register(bank, 0, width, width))
}
fn x87_context(value: Expr) -> Expr {
    let width = value.ty.width;
    Expr::select(
        Expr::require_context(
            bin(B::Eq, value.clone(), value.clone()),
            "x87 target execution context is unavailable",
        ),
        value,
        c(width, 0),
    )
}
fn x87_cw() -> Expr {
    x87_env("x86.x87_control", 16)
}
fn x87_sw() -> Expr {
    x87_env("x86.x87_status", 16)
}
fn x87_tw() -> Expr {
    x87_env("x86.x87_tags", 16)
}
fn x87_st(n: u8) -> Vec<Expr> {
    [64, 16]
        .into_iter()
        .enumerate()
        .map(|(chunk, w)| {
            Expr::register(register("x86.x87", u16::from(n) * 2 + chunk as u16, w, w))
        })
        .collect()
}
fn x87_pending(control: Expr, status: Expr) -> Expr {
    inv(bin(
        B::Eq,
        bin(B::And, bin(B::And, status, inv(control)), c(16, 63)),
        c(16, 0),
    ))
}
fn x87_write_env(r: &mut Recipe, bank: &'static str, value: Expr) {
    r.write(
        register(bank, 0, value.ty.width, value.ty.width),
        WritePolicy::ZeroUpper,
        value,
    );
}
fn x87_rotate(stack: &mut Vec<Vec<Expr>>, delta: Expr, condition: Expr) {
    let old = stack.clone();
    for n in 0..8 {
        for chunk in 0..2 {
            let mut value = old[n][chunk].clone();
            for d in 1..8 {
                value = Expr::select(
                    bin(B::Eq, delta.clone(), c(16, d as u64)),
                    old[(n + d) & 7][chunk].clone(),
                    value,
                );
            }
            stack[n][chunk] = Expr::select(condition.clone(), value, old[n][chunk].clone());
        }
    }
}
fn x87_emit_stack(r: &mut Recipe, stack: Vec<Vec<Expr>>) {
    for (n, chunks) in stack.into_iter().enumerate() {
        for (chunk, value) in chunks.into_iter().enumerate() {
            r.write(
                register(
                    "x86.x87",
                    (n * 2 + chunk) as u16,
                    value.ty.width,
                    value.ty.width,
                ),
                WritePolicy::ZeroUpper,
                value,
            );
        }
    }
}
fn x87_capture(
    r: &mut Recipe,
    operation: X87Operation,
    mut inputs: Vec<X87Operand>,
    active: Expr,
) -> Option<(X87Expression, Expr, Expr, Expr)> {
    for input in &mut inputs {
        for chunk in &mut input.chunks {
            *chunk = r.bind(chunk.clone());
        }
    }
    let expression = X87Expression {
        operation,
        inputs,
        control: Box::new(r.bind(x87_cw())),
        status: Box::new(r.bind(x87_sw())),
        tags: Box::new(r.bind(x87_tw())),
        projection: X87Projection::Commit,
    };
    let project = |projection, otherwise| {
        Expr::x87(X87Expression {
            projection,
            ..expression.clone()
        })
        .ok()
        .map(|value| Expr::select(active.clone(), value, otherwise))
    };
    let status = r.bind(project(X87Projection::Status, x87_sw())?);
    let tags = r.bind(project(X87Projection::Tags, x87_tw())?);
    let commit = r.bind(project(X87Projection::Commit, c(1, 0))?);
    Some((expression, status, tags, commit))
}
fn x87_result(
    expression: &X87Expression,
    register: u8,
    condition: Expr,
    otherwise: Vec<Expr>,
) -> Option<Vec<Expr>> {
    otherwise
        .into_iter()
        .enumerate()
        .map(|(chunk, old)| {
            Some(Expr::select(
                condition.clone(),
                Expr::x87(X87Expression {
                    projection: X87Projection::Result {
                        register,
                        chunk: chunk as u8,
                    },
                    ..expression.clone()
                })
                .ok()?,
                old,
            ))
        })
        .collect()
}
fn x87_operand(
    r: &mut Recipe,
    d: &Decoded,
    o: &DecodedOperand,
    ip: u64,
    active: Expr,
) -> Option<X87Operand> {
    if let Some(reg) = o
        .register
        .filter(|reg| reg.class == RegisterClass::X87 && reg.number < 8)
    {
        return Some(X87Operand {
            width: 80,
            chunks: x87_st(reg.number),
        });
    }
    if o.kind != OperandKind::Memory {
        return None;
    }
    let width = o.memory.size;
    let chunks = if width == 80 {
        r.load_wide_conditional(
            active.clone(),
            WideMemory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address(d, o, ip, true)?),
                width,
                endian: Endian::Little,
            },
        )
        .into_iter()
        .map(|chunk| Expr::select(active.clone(), chunk.clone(), c(chunk.ty.width, 0)))
        .collect()
    } else if matches!(width, 16 | 32 | 64) {
        vec![Expr::select(
            active,
            Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address(d, o, ip, true)?),
                width: width as u8,
                endian: Endian::Little,
            }),
            c(width as u8, 0),
        )]
    } else {
        return None;
    };
    Some(X87Operand {
        width: width as u8,
        chunks,
    })
}
// Every signed64 integer is represented exactly by x87's explicit integer bit.
// FI arithmetic must not use LoadInteger: that operation would push the stack.
fn x87_integer_operand(r: &mut Recipe, input: X87Operand) -> Option<X87Operand> {
    if !matches!(input.width, 16 | 32 | 64) || input.chunks.len() != 1 {
        return None;
    }
    let value = r.bind(Expr::cast(input.chunks[0].clone(), 64, true));
    let sign = r.bind(Expr::extract(value.clone(), 63, 1));
    let magnitude = r.bind(Expr::select(
        sign.clone(),
        Expr::unary(U::Neg, value.clone()),
        value,
    ));
    let leading = r.bind(Expr::unary(U::CountLeadingZeros, magnitude.clone()));
    let nonzero = inv(bin(B::Eq, magnitude.clone(), c(64, 0)));
    let low = r.bind(bin(B::Shl, magnitude, leading.clone()));
    let exponent = Expr::cast(bin(B::Sub, c(64, 16446), leading), 16, false);
    let high = r.bind(Expr::select(
        nonzero,
        bin(
            B::Or,
            exponent,
            bin(B::Shl, Expr::cast(sign, 16, false), c(16, 15)),
        ),
        c(16, 0),
    ));
    Some(X87Operand::extended(low, high))
}
fn x87_record(r: &mut Recipe, d: &Decoded, ip: u64, status: Expr, control: Expr) {
    let name = d.encoding().mnemonic;
    let undefined = match name {
        "FCOM" | "FCOMP" | "FCOMPP" | "FUCOM" | "FUCOMP" | "FUCOMPP" | "FICOM" | "FICOMP"
        | "FTST" | "FXAM" | "FPREM" | "FPREM1" | "FCOMI" | "FCOMIP" | "FUCOMI" | "FUCOMIP"
        | "FNOP" => 0,
        "FSIN" | "FCOS" | "FSINCOS" | "FPTAN" => 0x4100,
        "FFREE" | "FFREEP" => 0x4700,
        _ => 0x4500,
    };
    x87_write_env(r, "x86.x87_status", status.clone());
    // Preserve known TOP/exception bits while marking only undefined condition codes.
    for bit in [8, 9, 10, 14] {
        if undefined & (1 << bit) != 0 {
            let mut destination = register("x86.x87_status", 0, 1, 16);
            destination.offset = bit;
            r.write(
                destination,
                WritePolicy::Preserve,
                Expr::undefined(1, "x87 condition code is undefined after this operation"),
            );
        }
    }
    let width = if d.physical.mode == Mode::Mode64 {
        64
    } else {
        32
    };
    x87_write_env(r, "x86.x87_ip", c(width, ip));
    x87_write_env(
        r,
        "x86.x87_cs",
        Expr::register(register("x86.segment", 1, 16, 16)),
    );
    let pending = x87_pending(control, status);
    let update_opcode = Expr::select(
        pending.clone(),
        c(1, 1),
        x87_context(x87_env("x86.x87_fopcode_compat", 1)),
    );
    if let Some(modrm) = d.physical.modrm {
        let opcode = (u64::from(d.encoding().opcode & 7) << 8) | u64::from(modrm);
        x87_write_env(
            r,
            "x86.x87_opcode",
            Expr::select(update_opcode, c(16, opcode), x87_env("x86.x87_opcode", 16)),
        );
    }
    // CPUID.7.0:EBX.FDP_EXCPTN_ONLY controls data-pointer update. This is
    // explicit target CPU context; a consumer must supply its actual value.
    let update_data = Expr::select(
        pending,
        c(1, 1),
        inv(Expr::extract(
            x87_context(x87_env("x86.cpuid_7_ebx", 32)),
            6,
            1,
        )),
    );
    if let Some(o) = d.operands().iter().find(|o| o.kind == OperandKind::Memory) {
        if let Some(offset) = address(d, o, ip, false) {
            x87_write_env(
                r,
                "x86.x87_dp",
                Expr::select(
                    update_data.clone(),
                    Expr::cast(offset, width, false),
                    x87_env("x86.x87_dp", width),
                ),
            );
            let segment = o.memory.segment.map(|s| s.number).unwrap_or_else(|| {
                if o.memory.base.is_some_and(|b| matches!(b.number & 7, 4 | 5)) {
                    2
                } else {
                    3
                }
            });
            x87_write_env(
                r,
                "x86.x87_ds",
                Expr::select(
                    update_data,
                    Expr::register(register("x86.segment", u16::from(segment), 16, 16)),
                    x87_env("x86.x87_ds", 16),
                ),
            );
        }
    } else {
        x87_write_env(
            r,
            "x86.x87_dp",
            Expr::select(
                update_data,
                Expr::undefined(width, "x87 register instruction data pointer is undefined"),
                x87_env("x86.x87_dp", width),
            ),
        );
    }
}
fn x87_initialize(r: &mut Recipe, d: &Decoded, stack: &mut Vec<Vec<Expr>>) {
    let top = bin(B::And, bin(B::Lsr, x87_sw(), c(16, 11)), c(16, 7));
    x87_rotate(
        stack,
        bin(B::And, bin(B::Sub, c(16, 0), top), c(16, 7)),
        c(1, 1),
    );
    for (bank, width, value) in [
        ("x86.x87_control", 16, 0x037f),
        ("x86.x87_status", 16, 0),
        ("x86.x87_tags", 16, 0xffff),
        ("x86.x87_opcode", 16, 0),
        (
            "x86.x87_ip",
            if d.physical.mode == Mode::Mode64 {
                64
            } else {
                32
            },
            0,
        ),
        (
            "x86.x87_dp",
            if d.physical.mode == Mode::Mode64 {
                64
            } else {
                32
            },
            0,
        ),
        ("x86.x87_cs", 16, 0),
        ("x86.x87_ds", 16, 0),
    ] {
        x87_write_env(r, bank, c(width, value));
    }
}
fn x87_recipe(d: &Decoded, ip: u64) -> Option<Recipe> {
    let name = d.encoding().mnemonic;
    let is_x87 = (d.encoding().map == 0 && (0xd8..=0xdf).contains(&d.encoding().opcode))
        || matches!(
            name,
            "FWAIT" | "WAIT" | "EMMS" | "FEMMS" | "FXSAVE" | "FXSAVE64" | "FXRSTOR" | "FXRSTOR64"
        );
    if !is_x87 {
        return None;
    }
    let aw = match d.physical.mode {
        Mode::Mode16 | Mode::Mode32 => 32,
        Mode::Mode64 => 64,
    };
    let next = ip.wrapping_add(u64::from(d.length)) & mask(aw);
    let unsupported = |reason| Recipe::unsupported(reason, next, aw);
    if d.encoding().kind != 0 || d.physical.lock || d.physical.repeat != 0 {
        return Some(unsupported("x87 invalid or unaudited prefix combination"));
    }
    if matches!(name, "FXSAVE" | "FXSAVE64" | "FXRSTOR" | "FXRSTOR64") {
        return x87_fx_environment(d, ip).or_else(|| {
            Some(unsupported(
                "x87 FX image has unsupported dimensions or context",
            ))
        });
    }
    // REX bits do not extend x87 stack registers; memory addresses retain REX.
    let mut normalized = *d;
    for operand in &mut normalized.operands[..usize::from(normalized.operand_count)] {
        if let Some(register) = &mut operand.register {
            if register.class == RegisterClass::X87 {
                register.number &= 7;
            }
        }
    }
    let d = &normalized;
    let mut r = Recipe::new(next, aw);
    let waiting = !matches!(
        name,
        "FNCLEX"
            | "FNINIT"
            | "FNSAVE"
            | "FNSTENV"
            | "FNSTCW"
            | "FNSTSW"
            | "FENI8087_NOP"
            | "FDISI8087_NOP"
            | "FSETPM287_NOP"
    );
    let pending = x87_pending(x87_cw(), x87_sw());
    let active = if waiting {
        inv(pending.clone())
    } else {
        c(1, 1)
    };
    if waiting {
        r.effects.push(Effect::Trap {
            kind: TrapKind::FloatingPoint,
            condition: pending,
        });
    }
    let mut stack: Vec<_> = (0..8).map(x87_st).collect();
    let mut changed = false;
    let ops = d.operands();
    let explicit: Vec<_> = ops.iter().filter(|o| !o.implicit).collect();
    let data_source = || {
        ops.iter().rev().find(|o| {
            o.access.read
                && (o.kind == OperandKind::Memory
                    || o.register.is_some_and(|r| r.class == RegisterClass::X87))
        })
    };
    let mut status = x87_sw();
    let mut tags = x87_tw();
    let mut record = true;
    match name {
        "FWAIT" | "WAIT" => record = false,
        "FNOP" => {}
        "FENI8087_NOP" | "FDISI8087_NOP" | "FSETPM287_NOP" => record = false,
        "FNINIT" => {
            x87_initialize(&mut r, d, &mut stack);
            changed = true;
            record = false;
        }
        "FNCLEX" => {
            status = bin(B::And, status, c(16, 0x7f00));
            x87_write_env(&mut r, "x86.x87_status", status.clone());
            record = false;
        }
        "EMMS" | "FEMMS" => {
            x87_write_env(&mut r, "x86.x87_tags", c(16, 0xffff));
            record = false;
        }
        "FLDCW" | "FNSTCW" | "FNSTSW" => {
            let o = *explicit.first()?;
            if name == "FLDCW" {
                let source = x87_operand(&mut r, d, o, ip, active.clone())?;
                if source.width != 16 {
                    return Some(unsupported("x87 control transfer requires 16-bit memory"));
                }
                x87_write_env(&mut r, "x86.x87_control", source.chunks[0].clone());
            } else {
                write(
                    &mut r,
                    d,
                    o,
                    ip,
                    if name == "FNSTCW" { x87_cw() } else { x87_sw() },
                )?;
            }
            record = false;
        }
        "FFREE" | "FFREEP" | "FINCSTP" | "FDECSTP" => {
            if name.starts_with("FFREE") {
                let n = explicit
                    .first()?
                    .register
                    .filter(|reg| reg.class == RegisterClass::X87 && reg.number < 8)?
                    .number;
                tags = bin(B::Or, tags, c(16, 3 << (n * 2)));
            }
            let delta = match name {
                "FFREEP" | "FINCSTP" => 1,
                "FDECSTP" => 7,
                _ => 0,
            };
            if delta != 0 {
                tags = bin(B::Ror, tags, c(16, delta * 2));
                if name == "FFREEP" {
                    tags = bin(B::Or, tags, c(16, 0xc000));
                }
                let top = bin(
                    B::And,
                    bin(B::Add, status.clone(), c(16, delta << 11)),
                    c(16, 0x3800),
                );
                status = bin(B::Or, bin(B::And, status, c(16, 0xc5ff)), top);
                x87_rotate(&mut stack, c(16, delta), c(1, 1));
                changed = true;
            }
            x87_write_env(&mut r, "x86.x87_tags", tags.clone());
        }
        "FLDENV" | "FNSTENV" | "FNSAVE" | "FRSTOR" => {
            return x87_environment(d, ip, r, stack, active).or_else(|| {
                Some(unsupported(
                    "x87 environment image layout or execution context is unsupported",
                ))
            });
        }
        _ => {
            let math = match name {
                "FSQRT" => Some(X87MathOperation::SquareRoot),
                "FRNDINT" => Some(X87MathOperation::Round),
                "FSCALE" => Some(X87MathOperation::Scale),
                "FPREM" => Some(X87MathOperation::Remainder),
                "FPREM1" => Some(X87MathOperation::RemainderNearest),
                "FXTRACT" => Some(X87MathOperation::Extract),
                "FSIN" => Some(X87MathOperation::Sine),
                "FCOS" => Some(X87MathOperation::Cosine),
                "FSINCOS" => Some(X87MathOperation::SineCosine),
                "FPTAN" => Some(X87MathOperation::Tangent),
                "FPATAN" => Some(X87MathOperation::Arctangent),
                "F2XM1" => Some(X87MathOperation::Exp2MinusOne),
                "FYL2X" => Some(X87MathOperation::YLog2X),
                "FYL2XP1" => Some(X87MathOperation::YLog2XPlusOne),
                "FXAM" => Some(X87MathOperation::Examine),
                _ => None,
            };
            let constant = match name {
                "FLDPI" => Some(X87Constant::Pi),
                "FLDL2E" => Some(X87Constant::Log2E),
                "FLDL2T" => Some(X87Constant::Log2Ten),
                "FLDLG2" => Some(X87Constant::Log10Two),
                "FLDLN2" => Some(X87Constant::LnTwo),
                _ => None,
            };
            let mut inputs = vec![];
            let mut push = false;
            let mut pops = 0;
            let mut destination = 0;
            let mut exchange = None;
            let mut store = None;
            let mut compare_flags = false;
            let operation = if let Some(math) = math {
                inputs = (0..math.arity())
                    .map(|n| X87Operand {
                        width: 80,
                        chunks: stack[n].clone(),
                    })
                    .collect();
                push = math.pushes();
                pops = u8::from(math.pops());
                destination = pops;
                X87Operation::Math { operation: math }
            } else if let Some(constant) = constant {
                push = true;
                X87Operation::LoadConstant { constant }
            } else if matches!(name, "FLD" | "FILD" | "FLDZ" | "FLD1" | "FBLD") {
                push = true;
                let source = if matches!(name, "FLDZ" | "FLD1") {
                    X87Operand::extended(
                        c(64, if name == "FLD1" { 1 << 63 } else { 0 }),
                        c(16, if name == "FLD1" { 0x3fff } else { 0 }),
                    )
                } else {
                    x87_operand(&mut r, d, data_source()?, ip, active.clone())?
                };
                let operation = if name == "FBLD" {
                    X87Operation::LoadBcd
                } else if name == "FILD" {
                    X87Operation::LoadInteger {
                        source_width: source.width,
                    }
                } else if name == "FLD"
                    && data_source()?
                        .register
                        .is_some_and(|reg| reg.class == RegisterClass::X87)
                {
                    X87Operation::LoadRegister {
                        register: data_source()?.register?.number,
                    }
                } else {
                    X87Operation::LoadFloat {
                        source_width: source.width,
                    }
                };
                inputs.push(source);
                operation
            } else if matches!(
                name,
                "FST" | "FSTP" | "FSTPNCE" | "FIST" | "FISTP" | "FISTTP" | "FBSTP"
            ) {
                let target = ops.iter().find(|o| {
                    o.access.write
                        && (o.kind == OperandKind::Memory
                            || o.register
                                .is_some_and(|reg| reg.class == RegisterClass::X87))
                })?;
                pops = u8::from(name.ends_with('P') || matches!(name, "FSTPNCE" | "FISTTP"));
                inputs.push(X87Operand {
                    width: 80,
                    chunks: stack[0].clone(),
                });
                if let Some(reg) = target
                    .register
                    .filter(|reg| reg.class == RegisterClass::X87 && reg.number < 8)
                {
                    destination = reg.number;
                    X87Operation::StoreRegister {
                        register: destination,
                        pop: pops != 0,
                    }
                } else {
                    store = Some(target);
                    if name == "FBSTP" {
                        X87Operation::StoreBcd
                    } else if name == "FISTTP" {
                        X87Operation::StoreTruncatedInteger {
                            destination_width: target.memory.size as u8,
                        }
                    } else if name.starts_with("FIST") {
                        X87Operation::StoreInteger {
                            destination_width: target.memory.size as u8,
                            pop: pops != 0,
                        }
                    } else {
                        X87Operation::StoreFloat {
                            destination_width: target.memory.size as u8,
                            pop: pops != 0,
                        }
                    }
                }
            } else if matches!(name, "FABS" | "FCHS") {
                inputs.push(X87Operand {
                    width: 80,
                    chunks: stack[0].clone(),
                });
                X87Operation::Unary {
                    negate: name == "FCHS",
                    register: 0,
                }
            } else if name == "FXCH" {
                let n = explicit
                    .iter()
                    .filter_map(|o| o.register)
                    .filter(|reg| reg.class == RegisterClass::X87)
                    .map(|reg| reg.number)
                    .find(|&n| n != 0)
                    .unwrap_or(0);
                exchange = Some(n);
                inputs.push(X87Operand {
                    width: 80,
                    chunks: stack[0].clone(),
                });
                inputs.push(X87Operand {
                    width: 80,
                    chunks: stack[usize::from(n)].clone(),
                });
                X87Operation::Exchange { register: n }
            } else if let Some(suffix) = name.strip_prefix("FCMOV") {
                let source = data_source()?
                    .register
                    .filter(|reg| reg.class == RegisterClass::X87 && reg.number < 8)?
                    .number;
                inputs = vec![
                    X87Operand {
                        width: 80,
                        chunks: stack[0].clone(),
                    },
                    X87Operand {
                        width: 80,
                        chunks: stack[usize::from(source)].clone(),
                    },
                    X87Operand::scalar(condition(match suffix {
                        "U" => "P",
                        "NU" => "NP",
                        other => other,
                    })?),
                ];
                X87Operation::ConditionalMove { register: source }
            } else if matches!(name, "FCOMI" | "FCOMIP" | "FUCOMI" | "FUCOMIP") {
                let source = data_source()?
                    .register
                    .filter(|reg| reg.class == RegisterClass::X87 && reg.number < 8)?
                    .number;
                inputs = vec![
                    X87Operand {
                        width: 80,
                        chunks: stack[0].clone(),
                    },
                    X87Operand {
                        width: 80,
                        chunks: stack[usize::from(source)].clone(),
                    },
                ];
                pops = u8::from(name.ends_with('P'));
                compare_flags = true;
                X87Operation::Compare {
                    ordered: !name.starts_with("FU"),
                    pop: pops != 0,
                    left_register: 0,
                    right_register: source,
                }
            } else if matches!(
                name,
                "FCOM"
                    | "FCOMP"
                    | "FCOMPP"
                    | "FUCOM"
                    | "FUCOMP"
                    | "FUCOMPP"
                    | "FICOM"
                    | "FICOMP"
                    | "FTST"
            ) {
                let (mut source, register) = if name == "FTST" {
                    (X87Operand::extended(c(64, 0), c(16, 0)), None)
                } else if name.ends_with("PP") {
                    (
                        X87Operand {
                            width: 80,
                            chunks: stack[1].clone(),
                        },
                        Some(1),
                    )
                } else {
                    let o = data_source()?;
                    (
                        x87_operand(&mut r, d, o, ip, active.clone())?,
                        o.register
                            .filter(|reg| reg.class == RegisterClass::X87)
                            .map(|reg| reg.number),
                    )
                };
                if name.starts_with("FIC") {
                    source = x87_integer_operand(&mut r, source)?;
                }
                pops = if name.ends_with("PP") {
                    2
                } else {
                    u8::from(name.ends_with('P'))
                };
                let w = source.width;
                inputs = vec![
                    X87Operand {
                        width: 80,
                        chunks: stack[0].clone(),
                    },
                    source,
                ];
                X87Operation::CompareStatus {
                    ordered: !name.starts_with("FU"),
                    source_width: w,
                    source_register: register,
                    pops,
                }
            } else {
                let arithmetic = if name.starts_with("FADD") || name == "FIADD" {
                    Some(X87BinaryOperation::Add)
                } else if name.starts_with("FMUL") || name == "FIMUL" {
                    Some(X87BinaryOperation::Multiply)
                } else if name.starts_with("FSUB") || name.starts_with("FISUB") {
                    Some(X87BinaryOperation::Subtract)
                } else if name.starts_with("FDIV") || name.starts_with("FIDIV") {
                    Some(X87BinaryOperation::Divide)
                } else {
                    None
                };
                let Some(arithmetic) = arithmetic else {
                    return Some(unsupported(
                        "decoded x87 operation has no exact typed contract",
                    ));
                };
                let target = ops
                    .iter()
                    .find(|o| {
                        o.access.write
                            && o.register
                                .is_some_and(|reg| reg.class == RegisterClass::X87)
                    })?
                    .register?;
                destination = target.number;
                let o = data_source()?;
                let mut source = x87_operand(&mut r, d, o, ip, active.clone())?;
                if name.starts_with("FI") {
                    source = x87_integer_operand(&mut r, source)?;
                }
                let w = source.width;
                inputs = vec![
                    X87Operand {
                        width: 80,
                        chunks: stack[usize::from(destination)].clone(),
                    },
                    source,
                ];
                pops = u8::from(name.ends_with('P'));
                X87Operation::Binary {
                    operation: arithmetic,
                    source_width: w,
                    reverse: name.contains("SUBR") || name.contains("DIVR"),
                    destination_register: destination,
                    source_register: o
                        .register
                        .filter(|reg| reg.class == RegisterClass::X87)
                        .map(|reg| reg.number),
                    pop: pops != 0,
                }
            };
            let (expression, new_status, new_tags, commit) =
                x87_capture(&mut r, operation, inputs, active)?;
            status = new_status;
            tags = new_tags;
            let available = if matches!(
                math,
                Some(X87MathOperation::SineCosine | X87MathOperation::Tangent)
            ) {
                bin(
                    B::And,
                    commit.clone(),
                    inv(Expr::extract(status.clone(), 10, 1)),
                )
            } else {
                commit.clone()
            };
            if push {
                x87_rotate(&mut stack, c(16, 7), available.clone());
                changed = true;
            }
            if operation.result_registers() != 0 {
                if let Some(n) = exchange {
                    stack[usize::from(n)] = x87_result(
                        &expression,
                        n,
                        commit.clone(),
                        stack[usize::from(n)].clone(),
                    )?;
                }
                if push && math.is_some() {
                    stack[1] = x87_result(&expression, 1, available.clone(), stack[1].clone())?;
                }
                stack[usize::from(destination)] = x87_result(
                    &expression,
                    destination,
                    available,
                    stack[usize::from(destination)].clone(),
                )?;
                changed = true;
            }
            if compare_flags {
                for (index, projection) in [
                    (3, X87CompareFlag::Zero),
                    (1, X87CompareFlag::Parity),
                    (0, X87CompareFlag::Carry),
                ] {
                    let value = Expr::x87(X87Expression {
                        projection: X87Projection::CompareFlag(projection),
                        ..expression.clone()
                    })
                    .ok()?;
                    setflag(
                        &mut r,
                        index,
                        Expr::select(commit.clone(), value, flag(index)),
                    );
                }
                for index in [2, 4, 5] {
                    setflag(
                        &mut r,
                        index,
                        Expr::select(commit.clone(), c(1, 0), flag(index)),
                    );
                }
            }
            if let Some(o) = store {
                let w = operation.store_width()?;
                let chunks = (0..if w == 80 { 2 } else { 1 })
                    .map(|chunk| {
                        Expr::x87(X87Expression {
                            projection: X87Projection::Store { chunk },
                            ..expression.clone()
                        })
                        .ok()
                    })
                    .collect::<Option<Vec<_>>>()?;
                let address = Box::new(address(d, o, ip, true)?);
                if w == 80 {
                    r.store_wide_conditional(
                        commit.clone(),
                        WideMemory {kind: Default::default(), privilege: Default::default(),
                            address,
                            width: 80,
                            endian: Endian::Little,
                        },
                        chunks,
                    );
                } else {
                    r.store_conditional(
                        commit.clone(),
                        Memory {kind: Default::default(), privilege: Default::default(),
                            address,
                            width: w,
                            endian: Endian::Little,
                        },
                        chunks[0].clone(),
                    );
                }
            }
            if pops != 0 {
                x87_rotate(&mut stack, c(16, u64::from(pops)), commit);
                changed = true;
            }
            x87_write_env(&mut r, "x86.x87_tags", tags);
        }
    }
    if changed {
        x87_emit_stack(&mut r, stack);
    }
    if record {
        x87_record(&mut r, d, ip, status, x87_cw());
    }
    Some(r)
}
fn x87_fx_environment(d: &Decoded, ip: u64) -> Option<Recipe> {
    let name = d.encoding().mnemonic;
    let restore = name.starts_with("FXRSTOR");
    let wide = name.ends_with("64");
    if wide && d.physical.mode != Mode::Mode64 {
        return None;
    }
    let aw = match d.physical.mode {
        Mode::Mode16 | Mode::Mode32 => 32,
        Mode::Mode64 => 64,
    };
    let pointer_width = aw.max(32);
    let operand = d
        .operands()
        .iter()
        .find(|o| o.kind == OperandKind::Memory)?;
    let base = address(d, operand, ip, true)?;
    let aligned = bin(B::Eq, bin(B::And, base.clone(), c(64, 15)), c(64, 0));
    let osfxsr = x87_context(Expr::extract(
        Expr::register(register("x86.control", 4, pointer_width, 64)),
        9,
        1,
    ));
    let mut r = Recipe::new(ip.wrapping_add(u64::from(d.length)) & mask(aw), aw);
    r.effects.push(Effect::Trap {
        kind: TrapKind::Protection,
        condition: inv(aligned.clone()),
    });
    let memory = |offset, width| Memory {kind: Default::default(), privilege: Default::default(),
        address: Box::new(bin(B::Add, base.clone(), c(64, offset))),
        width,
        endian: Endian::Little,
    };
    let wide_memory = |offset, width| WideMemory {kind: Default::default(), privilege: Default::default(),
        address: Box::new(bin(B::Add, base.clone(), c(64, offset))),
        width,
        endian: Endian::Little,
    };
    let top = |status: Expr| bin(B::And, bin(B::Lsr, status, c(16, 11)), c(16, 7));
    if !restore {
        for (offset, value) in [
            (0, x87_cw()),
            (2, x87_sw()),
            (6, x87_env("x86.x87_opcode", 16)),
        ] {
            r.effects.push(Effect::Store {
                memory: memory(offset, 16),
                value,
            });
        }
        let physical = bin(
            B::Ror,
            x87_tw(),
            bin(B::Sub, c(16, 16), bin(B::Shl, top(x87_sw()), c(16, 1))),
        );
        let mut abridged = c(8, 0);
        for n in 0..8 {
            let present = inv(bin(
                B::Eq,
                bin(
                    B::And,
                    bin(B::Lsr, physical.clone(), c(16, n * 2)),
                    c(16, 3),
                ),
                c(16, 3),
            ));
            abridged = bin(
                B::Or,
                abridged,
                bin(B::Shl, Expr::cast(present, 8, false), c(8, n)),
            );
        }
        r.effects.push(Effect::Store {
            memory: memory(4, 8),
            value: abridged,
        });
        for (offset, pointer, selector) in [
            (8, "x86.x87_ip", "x86.x87_cs"),
            (16, "x86.x87_dp", "x86.x87_ds"),
        ] {
            let width = if wide { 64 } else { 32 };
            r.effects.push(Effect::Store {
                memory: memory(offset, width),
                value: Expr::cast(x87_env(pointer, pointer_width), width, false),
            });
            if !wide {
                let selector = Expr::select(
                    Expr::extract(x87_context(x87_env("x86.cpuid_7_ebx", 32)), 13, 1),
                    c(16, 0),
                    x87_env(selector, 16),
                );
                r.effects.push(Effect::Store {
                    memory: memory(offset + 4, 16),
                    value: selector,
                });
            }
        }
        for n in 0..8 {
            r.store_wide(wide_memory(32 + u64::from(n) * 16, 80), x87_st(n));
        }
        r.store_conditional(osfxsr.clone(), memory(24, 32), x87_env("x86.mxcsr", 32));
        r.effects.push(Effect::Store {
            memory: memory(28, 32),
            value: x87_context(x87_env("x86.mxcsr_mask", 32)),
        });
        for n in 0..if pointer_width == 64 { 16 } else { 8 } {
            let chunks = (0..2)
                .map(|chunk| Expr::register(register("x86.vector64", n * 8 + chunk, 64, 64)))
                .collect();
            r.store_wide_conditional(
                osfxsr.clone(),
                wide_memory(160 + u64::from(n) * 16, 128),
                chunks,
            );
        }
    } else {
        // All original-width reads share one ordered stream. MXCSR is read
        // once, after x87 payloads; invalid bits suppress every later XMM read
        // and raise #GP before any restored architectural state is published.
        let mask = x87_env("x86.mxcsr_mask", 32);
        let context_valid = Expr::select(
            osfxsr.clone(),
            Expr::require_context(
                bin(B::Eq, mask.clone(), mask),
                "FXRSTOR MXCSR_MASK is unavailable",
            ),
            c(1, 1),
        );
        let reads_active = Expr::select(aligned.clone(), context_valid, c(1, 0));
        let load = |r: &mut Recipe, offset, width| {
            r.load_ordered_conditional(reads_active.clone(), memory(offset, width))
                .ok()
        };
        let control = load(&mut r, 0, 16)?;
        let status = load(&mut r, 2, 16)?;
        let abridged = Expr::cast(load(&mut r, 4, 8)?, 16, false);
        let opcode = load(&mut r, 6, 16)?;
        let mut pointers = vec![];
        for (offset, pointer, selector) in [
            (8, "x86.x87_ip", "x86.x87_cs"),
            (16, "x86.x87_dp", "x86.x87_ds"),
        ] {
            pointers.push((
                pointer,
                Expr::cast(
                    load(&mut r, offset, if wide { 64 } else { 32 })?,
                    pointer_width,
                    false,
                ),
            ));
            pointers.push((
                selector,
                if wide {
                    c(16, 0)
                } else {
                    load(&mut r, offset + 4, 16)?
                },
            ));
        }
        let payloads: Vec<_> = (0..8)
            .map(|n| r.load_wide_conditional(reads_active.clone(), wide_memory(32 + n * 16, 80)))
            .collect();
        let mxcsr_active = Expr::select(reads_active.clone(), osfxsr.clone(), c(1, 0));
        let mxcsr = r
            .load_ordered_conditional(mxcsr_active, memory(24, 32))
            .ok()?;
        let invalid = Expr::select(
            reads_active.clone(),
            Expr::select(
                osfxsr.clone(),
                inv(bin(
                    B::Eq,
                    bin(
                        B::And,
                        mxcsr.clone(),
                        inv(x87_context(x87_env("x86.mxcsr_mask", 32))),
                    ),
                    c(32, 0),
                )),
                c(1, 0),
            ),
            c(1, 0),
        );
        r.effects.push(Effect::Trap {
            kind: TrapKind::Protection,
            condition: invalid.clone(),
        });
        let vector_active = Expr::select(
            reads_active,
            Expr::select(osfxsr.clone(), inv(invalid), c(1, 0)),
            c(1, 0),
        );
        let vectors: Vec<_> = (0..if pointer_width == 64 { 16 } else { 8 })
            .map(|n| r.load_wide_conditional(vector_active.clone(), wide_memory(160 + n * 16, 128)))
            .collect();
        let mut tags = c(16, 0);
        for (n, chunks) in payloads.iter().enumerate() {
            let physical = bin(
                B::And,
                bin(B::Add, top(status.clone()), c(16, n as u64)),
                c(16, 7),
            );
            let present = Expr::extract(bin(B::Lsr, abridged.clone(), physical), 0, 1);
            let tag = Expr::select(present, x87_classify(chunks), c(16, 3));
            tags = bin(B::Or, tags, bin(B::Shl, tag, c(16, n as u64 * 2)));
        }
        x87_write_env(&mut r, "x86.x87_control", control);
        x87_write_env(&mut r, "x86.x87_status", status);
        x87_write_env(&mut r, "x86.x87_tags", tags);
        x87_write_env(&mut r, "x86.x87_opcode", bin(B::And, opcode, c(16, 0x7ff)));
        for (bank, value) in pointers {
            x87_write_env(&mut r, bank, value);
        }
        x87_emit_stack(&mut r, payloads);
        x87_write_env(
            &mut r,
            "x86.mxcsr",
            Expr::select(osfxsr.clone(), mxcsr, x87_env("x86.mxcsr", 32)),
        );
        for (n, chunks) in vectors.into_iter().enumerate() {
            for (chunk, value) in chunks.into_iter().enumerate() {
                let register = register("x86.vector64", (n * 8 + chunk) as u16, 64, 64);
                r.write(
                    register,
                    WritePolicy::ZeroUpper,
                    Expr::select(osfxsr.clone(), value, Expr::register(register)),
                );
            }
        }
    }
    Some(r)
}

fn x87_classify(chunks: &[Expr]) -> Expr {
    let exponent = bin(B::And, chunks[1].clone(), c(16, 0x7fff));
    let zero = bin(
        B::And,
        bin(B::Eq, exponent.clone(), c(16, 0)),
        bin(B::Eq, chunks[0].clone(), c(64, 0)),
    );
    let special = bin(
        B::Or,
        bin(
            B::Or,
            bin(B::Eq, exponent.clone(), c(16, 0)),
            bin(B::Eq, exponent, c(16, 0x7fff)),
        ),
        inv(Expr::extract(chunks[0].clone(), 63, 1)),
    );
    Expr::select(zero, c(16, 1), Expr::select(special, c(16, 2), c(16, 0)))
}
fn x87_environment(
    d: &Decoded,
    ip: u64,
    mut r: Recipe,
    mut stack: Vec<Vec<Expr>>,
    active: Expr,
) -> Option<Recipe> {
    let name = d.encoding().mnemonic;
    let operand = d
        .operands()
        .iter()
        .find(|o| o.kind == OperandKind::Memory)?;
    let registers = matches!(name, "FNSAVE" | "FRSTOR");
    let restore = matches!(name, "FLDENV" | "FRSTOR");
    let short = matches!(operand.memory.size, 112 | 752);
    if !matches!(
        (registers, operand.memory.size),
        (false, 112 | 224) | (true, 752 | 864)
    ) {
        return None;
    }
    let stride = if short { 2 } else { 4 };
    let image_width = if short { 16 } else { 32 };
    let pointer_width = if d.physical.mode == Mode::Mode64 {
        64
    } else {
        32
    };
    let base = Expr::select(active.clone(), address(d, operand, ip, true)?, c(64, 0));
    // CR0.PE and virtual-8086 mode are explicit incoming execution context.
    let protected = if d.physical.mode == Mode::Mode64 {
        c(1, 1)
    } else {
        bin(
            B::And,
            Expr::extract(
                x87_context(Expr::register(register("x86.control", 0, 32, 64))),
                0,
                1,
            ),
            inv(x87_context(x87_env("x86.x87_vm86", 1))),
        )
    };
    let protected = r.bind(Expr::select(active.clone(), protected, c(1, 0)));
    let load = |r: &mut Recipe, offset: u64, width: u8| {
        r.load_ordered_conditional(
            active.clone(),
            Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(bin(B::Add, base.clone(), c(64, offset))),
                width,
                endian: Endian::Little,
            },
        )
        .expect("x87 legacy image fields use scalar byte widths")
    };
    let top = |status: Expr| bin(B::And, bin(B::Lsr, status, c(16, 11)), c(16, 7));
    if !restore {
        let status = x87_sw();
        let count = bin(B::Shl, top(status.clone()), c(16, 1));
        let physical_tags = bin(B::Ror, x87_tw(), bin(B::Sub, c(16, 16), count));
        let store = |r: &mut Recipe, offset: u64, value: Expr| {
            r.effects.push(Effect::Store {
                memory: Memory {kind: Default::default(), privilege: Default::default(),
                    address: Box::new(bin(B::Add, base.clone(), c(64, offset))),
                    width: value.ty.width,
                    endian: Endian::Little,
                },
                value,
            });
        };
        for (slot, value) in [x87_cw(), status, physical_tags].into_iter().enumerate() {
            store(&mut r, slot as u64 * stride, value);
            if !short {
                store(
                    &mut r,
                    slot as u64 * stride + 2,
                    Expr::undefined(16, "x87 environment reserved word"),
                );
            }
        }
        let ip = Expr::cast(x87_env("x86.x87_ip", pointer_width), 32, false);
        let dp = Expr::cast(x87_env("x86.x87_dp", pointer_width), 32, false);
        let opcode = bin(B::And, x87_env("x86.x87_opcode", 16), c(16, 0x7ff));
        let selector = |bank| {
            Expr::select(
                Expr::extract(x87_context(x87_env("x86.cpuid_7_ebx", 32)), 13, 1),
                c(16, 0),
                x87_env(bank, 16),
            )
        };
        let real_high = |pointer: Expr| {
            Expr::cast(
                bin(
                    B::Shl,
                    bin(
                        B::And,
                        bin(B::Lsr, pointer, c(32, 16)),
                        c(32, if short { 15 } else { 0xffff }),
                    ),
                    c(32, 12),
                ),
                image_width,
                false,
            )
        };
        let ip_high = bin(
            B::Or,
            real_high(ip.clone()),
            Expr::cast(opcode.clone(), image_width, false),
        );
        let cs_opcode = if short {
            selector("x86.x87_cs")
        } else {
            bin(
                B::Or,
                Expr::cast(selector("x86.x87_cs"), 32, false),
                bin(B::Shl, Expr::cast(opcode, 32, false), c(32, 16)),
            )
        };
        for (slot, value) in [
            (
                3,
                Expr::select(
                    protected.clone(),
                    Expr::cast(ip.clone(), image_width, false),
                    Expr::cast(bin(B::And, ip, c(32, 0xffff)), image_width, false),
                ),
            ),
            (4, Expr::select(protected.clone(), cs_opcode, ip_high)),
            (
                5,
                Expr::select(
                    protected.clone(),
                    Expr::cast(dp.clone(), image_width, false),
                    Expr::cast(bin(B::And, dp.clone(), c(32, 0xffff)), image_width, false),
                ),
            ),
            (
                6,
                Expr::select(
                    protected.clone(),
                    Expr::cast(selector("x86.x87_ds"), image_width, false),
                    real_high(dp),
                ),
            ),
        ] {
            store(&mut r, slot * stride, value);
        }
        if registers {
            for (n, chunks) in stack.iter().enumerate() {
                r.store_wide(
                    WideMemory {kind: Default::default(), privilege: Default::default(),
                        address: Box::new(bin(
                            B::Add,
                            base.clone(),
                            c(64, 7 * stride + n as u64 * 10),
                        )),
                        width: 80,
                        endian: Endian::Little,
                    },
                    chunks.clone(),
                );
            }
            x87_initialize(&mut r, d, &mut stack);
            x87_emit_stack(&mut r, stack);
        } else {
            x87_write_env(&mut r, "x86.x87_control", bin(B::Or, x87_cw(), c(16, 63)));
        }
    } else {
        let words: Vec<_> = (0..7)
            .map(|n| load(&mut r, n * stride, if n < 3 { 16 } else { image_width }))
            .collect();
        let control = words[0].clone();
        let status = words[1].clone();
        let tags = bin(
            B::Ror,
            words[2].clone(),
            bin(B::Shl, top(status.clone()), c(16, 1)),
        );
        if registers {
            for (n, chunks) in stack.iter_mut().enumerate() {
                *chunks = r
                    .load_wide_conditional(
                        active.clone(),
                        WideMemory {kind: Default::default(), privilege: Default::default(),
                            address: Box::new(bin(
                                B::Add,
                                base.clone(),
                                c(64, 7 * stride + n as u64 * 10),
                            )),
                            width: 80,
                            endian: Endian::Little,
                        },
                    )
                    .into_iter()
                    .map(|chunk| Expr::select(active.clone(), chunk.clone(), c(chunk.ty.width, 0)))
                    .collect();
            }
        } else {
            let delta = bin(
                B::And,
                bin(B::Sub, top(status.clone()), top(x87_sw())),
                c(16, 7),
            );
            x87_rotate(&mut stack, delta, c(1, 1));
        }
        let real_pointer = |low: Expr, high: Expr| {
            bin(
                B::Or,
                Expr::cast(bin(B::And, low, c(image_width, 0xffff)), 32, false),
                bin(
                    B::Shl,
                    bin(
                        B::And,
                        bin(B::Lsr, Expr::cast(high, 32, false), c(32, 12)),
                        c(32, if short { 15 } else { 0xffff }),
                    ),
                    c(32, 16),
                ),
            )
        };
        for (low, high, pointer, selector) in [
            (3, 4, "x86.x87_ip", "x86.x87_cs"),
            (5, 6, "x86.x87_dp", "x86.x87_ds"),
        ] {
            let value = Expr::select(
                protected.clone(),
                Expr::cast(words[low].clone(), 32, false),
                real_pointer(words[low].clone(), words[high].clone()),
            );
            x87_write_env(&mut r, pointer, Expr::cast(value, pointer_width, false));
            x87_write_env(
                &mut r,
                selector,
                Expr::select(
                    protected.clone(),
                    Expr::cast(words[high].clone(), 16, false),
                    c(16, 0),
                ),
            );
        }
        let protected_opcode = if short {
            x87_env("x86.x87_opcode", 16)
        } else {
            bin(
                B::And,
                Expr::cast(bin(B::Lsr, words[4].clone(), c(32, 16)), 16, false),
                c(16, 0x7ff),
            )
        };
        x87_write_env(
            &mut r,
            "x86.x87_opcode",
            Expr::select(
                protected,
                protected_opcode,
                bin(
                    B::And,
                    Expr::cast(words[4].clone(), 16, false),
                    c(16, 0x7ff),
                ),
            ),
        );
        let pending = x87_pending(control.clone(), status.clone());
        x87_write_env(
            &mut r,
            "x86.x87_status",
            bin(
                B::Or,
                bin(B::And, status, c(16, 0x7f7f)),
                Expr::select(pending, c(16, 0x8080), c(16, 0)),
            ),
        );
        x87_write_env(&mut r, "x86.x87_control", control);
        let mut rebuilt = c(16, 0);
        for (n, chunks) in stack.iter().enumerate() {
            let empty = bin(
                B::Eq,
                bin(
                    B::And,
                    bin(B::Lsr, tags.clone(), c(16, n as u64 * 2)),
                    c(16, 3),
                ),
                c(16, 3),
            );
            let tag = Expr::select(empty, c(16, 3), x87_classify(chunks));
            rebuilt = bin(B::Or, rebuilt, bin(B::Shl, tag, c(16, n as u64 * 2)));
        }
        x87_write_env(&mut r, "x86.x87_tags", rebuilt);
        x87_emit_stack(&mut r, stack);
    }
    Some(r)
}

// Intel SDM Vol. 2B, PAUSE and PREFETCHh/PREFETCHW: these hints may
// leave architectural state unchanged. Cache residency and finite delays are
// outside the recipe state; ignored prefetches perform no data-memory access.
fn ignored_hint(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if e.kind != 0 || p.lock {
        return None;
    }
    let operands: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
    let pause = e.mnemonic == "PAUSE" && e.map == 0 && e.opcode == 0x90
        && e.mandatory == 2 && p.repeat == 2 && p.rex & 1 == 0 && operands.is_empty();
    let group = p.reg & 7;
    let prefetch = e.map == 1 && e.mandatory == 0 && p.repeat == 0
        && operands.len() == 1 && operands[0].kind == OperandKind::Memory
        && operands[0].memory.size == 8
        && match (e.mnemonic, e.opcode, group) {
            ("PREFETCHNTA", 0x18, 0) | ("PREFETCHT0", 0x18, 1)
            | ("PREFETCHT1", 0x18, 2) | ("PREFETCHT2", 0x18, 3)
            | ("PREFETCHW", 0x0d, 1) => true,
            _ => false,
        };
    (pause || prefetch).then(|| float_recipe(d, ip))
}
fn build(d: &Decoded, ip: u64) -> Option<Recipe> {
    if let Some(recipe) = vector_movement(d, ip) { return Some(recipe); }
    if let Some(recipe) = packed_integer_extra(d, ip) { return Some(recipe); }
    if let Some(recipe) = ignored_hint(d, ip) { return Some(recipe); }
    if let Some(recipe) = packed_mask_comparison(d, ip) { return Some(recipe); }
    if let Some(recipe) = vector_rearrange(d, ip) { return Some(recipe); }
    if let Some(recipe) = avx512_integer(d, ip) { return Some(recipe); }
    if let Some(recipe) = random_integer(d, ip) { return Some(recipe); }
    if let Some(recipe) = x87_recipe(d, ip) {
        return Some(recipe);
    }
    if let Some(r) = floating_half(d, ip) {
        return Some(r);
    }
    if let Some(r) = specialized_crypto(d, ip) {
        return Some(r);
    }
    if let Some(r) = specialized_sha(d, ip) {
        return Some(r);
    }
    if let Some(r) = specialized_vectors(d, ip) {
        return Some(r);
    }
    if let Some(r) = specialized_masks(d, ip) {
        return Some(r);
    }
    if let Some(fma) = floating_fma(d, ip) {
        return Some(fma);
    }
    if let Some(round) = floating_round(d, ip) {
        return Some(round);
    }
    if let Some(convert) = floating_conversion(d, ip) {
        return Some(convert);
    }
    if let Some(compare) = floating_compare(d, ip) {
        return Some(compare);
    }
    if let Some(transfer) = integer_broadcast(d, ip) {
        return Some(transfer);
    }
    if let Some(float) = floating_point(d, ip) {
        return Some(float);
    }
    if let Some(shifts) = packed_variable_shifts(d, ip) {
        return Some(shifts);
    }
    if let Some(shifts) = packed_shifts(d, ip) {
        return Some(shifts);
    }
    let mode = d.physical.mode;
    let aw = match mode {
        Mode::Mode16 => d.physical.operand_size.max(16),
        Mode::Mode32 => 32,
        Mode::Mode64 => 64,
    };
    let next = ip.wrapping_add(d.length as u64)
        & match mode {
            Mode::Mode16 => 0xffff,
            Mode::Mode32 => 0xffff_ffff,
            Mode::Mode64 => u64::MAX,
        };
    let mut r = if d.encoding().flow_control == crate::FlowControl::Next {
        float_recipe(d, ip)
    } else {
        Recipe::new(next, aw)
    };
    if let Some(vector) = packed_integer(d, ip) {
        return Some(vector);
    }
    if let Some(string) = string_integer(d, ip, r.clone()) {
        return Some(string);
    }
    if let Some(frame) = frame_integer(d, ip, r.clone()) {
        return Some(frame);
    }
    if let Some(atomic) = atomic_integer(d, ip, r.clone()) {
        return Some(atomic);
    }
    if let Some(division) = division_integer(d, ip, r.clone()) {
        return Some(division);
    }
    if let Some(bmi) = bmi_integer(d, ip, r.clone()) {
        return Some(bmi);
    }
    if let Some(integer) = extra_integer(d, ip, r.clone()) {
        return Some(integer);
    }
    if d.physical.lock || d.physical.repeat != 0 || d.encoding().kind != 0 {
        return None;
    }
    let name = d.encoding().mnemonic;
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
    let stack = near_stack(d);
    if matches!(name, "PUSH" | "POP" | "CALL" | "RET") && !stack {
        return None;
    }
    if name.starts_with('J') && !near_branch(d) {
        return None;
    }
    if name == "MOV" && d.encoding().map != 0 {
        return None;
    }
    if !implicit_operands_are_audited(d, stack) {
        return None;
    }
    if name == "NOP" {
        let e = d.encoding();
        if !((e.map == 0 && e.opcode == 0x90 && d.physical.rex & 1 == 0)
            || (e.map == 1 && e.opcode == 0x1f && d.physical.reg & 7 == 0))
        {
            return None;
        }
        return Some(r);
    }
    if matches!(name, "MOV" | "MOVZX" | "MOVSX" | "MOVSXD" | "LEA") && ops.len() == 2 {
        let w = width(ops[0])?;
        let value = if name == "LEA" {
            if ops[1].kind != OperandKind::Memory {
                return None;
            }
            Expr::cast(address(d, ops[1], ip, false)?, w, false)
        } else if name == "MOV" {
            read(d, ops[1], ip, w)?
        } else {
            let sw = width(ops[1])?;
            if sw >= w {
                return None;
            }
            Expr::cast(read(d, ops[1], ip, sw)?, w, name != "MOVZX")
        };
        let value = r.bind(value);
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if name == "XCHG" && ops.len() == 2 && ops.iter().all(|o| o.kind == OperandKind::Register) {
        let w = width(ops[0])?;
        let a = r.bind(read(d, ops[0], ip, w)?);
        let b = r.bind(read(d, ops[1], ip, w)?);
        write(&mut r, d, ops[0], ip, b)?;
        write(&mut r, d, ops[1], ip, a)?;
        return Some(r);
    }
    if matches!(
        name,
        "ADD" | "ADC" | "SUB" | "SBB" | "CMP" | "AND" | "OR" | "XOR" | "TEST"
    ) && ops.len() == 2
    {
        let w = width(ops[0])?;
        // XOR of the same architectural slice defines zero independently of
        // the incoming value. Do not introduce a false input dependency;
        // different views such as AL and AH are separate slices.
        let zero_idiom = name == "XOR"
            && ops[0].kind == OperandKind::Register
            && ops[1].kind == OperandKind::Register
            && slice(ops[0].register?)? == slice(ops[1].register?)?;
        let a = r.bind(if zero_idiom {
            c(w, 0)
        } else {
            read(d, ops[0], ip, w)?
        });
        let b = r.bind(if zero_idiom {
            c(w, 0)
        } else {
            read(d, ops[1], ip, w)?
        });
        let sub = matches!(name, "SUB" | "SBB" | "CMP");
        let logical = matches!(name, "AND" | "OR" | "XOR" | "TEST");
        let carry = r.bind(if matches!(name, "ADC" | "SBB") {
            flag(0)
        } else {
            c(1, 0)
        });
        let value = bin(
            if sub {
                B::Sub
            } else if matches!(name, "AND" | "TEST") {
                B::And
            } else if name == "OR" {
                B::Or
            } else if name == "XOR" {
                B::Xor
            } else {
                B::Add
            },
            a.clone(),
            b.clone(),
        );
        let value = if logical {
            value
        } else {
            bin(
                if sub { B::Sub } else { B::Add },
                value,
                Expr::cast(carry.clone(), w, false),
            )
        };
        let v = r.bind(value);
        nzp(&mut r, v.clone());
        if logical {
            setflag(&mut r, 0, c(1, 0));
            setflag(&mut r, 5, c(1, 0));
            setflag(
                &mut r,
                2,
                Expr::undefined(1, "AF undefined after logical operation"),
            )
        } else {
            setflag(
                &mut r,
                0,
                if sub {
                    Expr::sub_borrow(a.clone(), b.clone(), carry)
                } else {
                    Expr::add_carry(a.clone(), b.clone(), carry)
                },
            );
            setflag(
                &mut r,
                5,
                Expr::overflow(sub, a.clone(), b.clone(), v.clone()),
            );
            setflag(
                &mut r,
                2,
                Expr::extract(bin(B::Xor, bin(B::Xor, a, b), v.clone()), 4, 1),
            )
        }
        if !matches!(name, "CMP" | "TEST") {
            write(&mut r, d, ops[0], ip, v)?
        }
        return Some(r);
    }
    if matches!(name, "INC" | "DEC" | "NEG" | "NOT") && ops.len() == 1 {
        let w = width(ops[0])?;
        let a = r.bind(read(d, ops[0], ip, w)?);
        let sub = matches!(name, "DEC" | "NEG");
        let left = if name == "NEG" { c(w, 0) } else { a.clone() };
        let right = if name == "NEG" { a.clone() } else { c(w, 1) };
        let v = r.bind(if name == "NOT" {
            inv(a.clone())
        } else {
            bin(
                if sub { B::Sub } else { B::Add },
                left.clone(),
                right.clone(),
            )
        });
        if name != "NOT" {
            nzp(&mut r, v.clone());
            setflag(
                &mut r,
                5,
                Expr::overflow(sub, left.clone(), right.clone(), v.clone()),
            );
            setflag(
                &mut r,
                2,
                Expr::extract(bin(B::Xor, bin(B::Xor, left, right), v.clone()), 4, 1),
            );
            if name == "NEG" {
                setflag(&mut r, 0, inv(bin(B::Eq, a, c(w, 0))))
            }
        }
        write(&mut r, d, ops[0], ip, v)?;
        return Some(r);
    }
    if matches!(name, "SHL" | "SAL" | "SHR" | "SAR" | "ROL" | "ROR")
        && (ops.len() == 1 || ops.len() == 2)
    {
        let w = width(ops[0])?;
        let a = r.bind(read(d, ops[0], ip, w)?);
        let raw = if ops.len() == 2 {
            read(d, ops[1], ip, w)?
        } else {
            c(w, 1)
        };
        let count = r.bind(bin(B::And, raw, c(w, if w == 64 { 63 } else { 31 })));
        let rotate = matches!(name, "ROL" | "ROR");
        let n = if rotate {
            r.bind(bin(B::And, count.clone(), c(w, w as u64 - 1)))
        } else {
            count.clone()
        };
        let zero = bin(B::Eq, n.clone(), c(w, 0));
        let one = bin(B::Eq, count.clone(), c(w, 1));
        let left = matches!(name, "SHL" | "SAL" | "ROL");
        let op = if left {
            B::Shl
        } else if name == "SAR" {
            B::Asr
        } else {
            B::Lsr
        };
        let result = if rotate {
            if left {
                bin(B::Ror, a.clone(), bin(B::Sub, c(w, w as u64), n.clone()))
            } else {
                bin(B::Ror, a.clone(), n.clone())
            }
        } else {
            bin(op, a.clone(), n.clone())
        };
        let v = r.bind(result);
        let cf = if rotate {
            Expr::extract(v.clone(), if left { 0 } else { w - 1 }, 1)
        } else if left {
            Expr::extract(
                bin(B::Lsr, a.clone(), bin(B::Sub, c(w, w as u64), n.clone())),
                0,
                1,
            )
        } else {
            Expr::extract(
                bin(B::Lsr, a.clone(), bin(B::Sub, n.clone(), c(w, 1))),
                0,
                1,
            )
        };
        let cf = if name == "SAR" {
            Expr::select(
                bin(B::Ult, n.clone(), c(w, w as u64)),
                cf,
                Expr::extract(a.clone(), w - 1, 1),
            )
        } else if !rotate {
            Expr::select(
                bin(B::Ult, n.clone(), c(w, w as u64)),
                cf,
                Expr::undefined(1, "CF undefined for shift count >= operand width"),
            )
        } else {
            cf
        };
        let cf = r.bind(Expr::select(
            bin(B::Eq, count.clone(), c(w, 0)),
            flag(0),
            cf,
        ));
        let of1 = if left {
            bin(B::Xor, Expr::extract(v.clone(), w - 1, 1), cf.clone())
        } else if name == "SHR" {
            Expr::extract(a.clone(), w - 1, 1)
        } else if name == "SAR" {
            c(1, 0)
        } else {
            bin(
                B::Xor,
                Expr::extract(v.clone(), w - 1, 1),
                Expr::extract(v.clone(), w - 2, 1),
            )
        };
        setflag(&mut r, 0, cf);
        setflag(
            &mut r,
            5,
            Expr::select(
                bin(B::Eq, count.clone(), c(w, 0)),
                flag(5),
                Expr::select(
                    one,
                    of1,
                    Expr::undefined(1, "OF undefined for multi-bit shift/rotate"),
                ),
            ),
        );
        if !rotate {
            for (i, value) in [
                (3, bin(B::Eq, v.clone(), c(w, 0))),
                (4, Expr::extract(v.clone(), w - 1, 1)),
                (1, Expr::unary(U::Parity, v.clone())),
                (2, Expr::undefined(1, "AF undefined after nonzero shift")),
            ] {
                setflag(&mut r, i, Expr::select(zero.clone(), flag(i), value))
            }
        }
        write_shift(&mut r, d, ops[0], ip, v, inv(bin(B::Eq, count, c(w, 0))))?;
        return Some(r);
    }
    if let Some(s) = name.strip_prefix("CMOV") {
        if ops.len() != 2 {
            return None;
        }
        let w = width(ops[0])?;
        let old = r.bind(read(d, ops[0], ip, w)?);
        let source = r.bind(read(d, ops[1], ip, w)?);
        let v = r.bind(Expr::select(condition(s)?, source, old));
        write(&mut r, d, ops[0], ip, v)?;
        return Some(r);
    }
    if let Some(s) = name.strip_prefix("SET") {
        if ops.len() != 1 || width(ops[0])? != 8 {
            return None;
        }
        let v = Expr::cast(condition(s)?, 8, false);
        write(&mut r, d, ops[0], ip, v)?;
        return Some(r);
    }
    if name == "JMP" || name.starts_with('J') {
        if ops.len() != 1 {
            return None;
        }
        let cond = if name == "JMP" {
            c(1, 1)
        } else if matches!(name, "JCXZ" | "JECXZ" | "JRCXZ") {
            let w = if name == "JCXZ" {
                16
            } else if name == "JECXZ" {
                32
            } else {
                64
            };
            bin(
                B::Eq,
                Expr::register(register("x86.gpr", 1, w, 64)),
                c(w, 0),
            )
        } else {
            condition(&name[1..])?
        };
        let target = if ops[0].kind == OperandKind::Relative {
            c(aw, d.branch_target(ip)?)
        } else {
            if name != "JMP" {
                return None;
            }
            Expr::cast(
                read(
                    d,
                    ops[0],
                    ip,
                    if mode == Mode::Mode64 {
                        64
                    } else {
                        d.physical.operand_size
                    },
                )?,
                aw,
                false,
            )
        };
        r.branch(FlowKind::Branch, cond, target);
        return Some(r);
    }
    if mode == Mode::Mode64 && matches!(name, "PUSH" | "POP" | "CALL" | "RET") {
        if d.physical.operand_size == 16 {
            return None;
        }
        let sp = register("x86.gpr", 4, 64, 64);
        let oldsp = r.bind(Expr::register(sp));
        if name == "RET" {
            if ops.len() > 1 {
                return None;
            }
            let target = r.bind(Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(oldsp.clone()),
                width: 64,
                endian: Endian::Little,
            }));
            let extra = if ops.is_empty() {
                0
            } else {
                if ops[0].kind != OperandKind::Immediate {
                    return None;
                }
                ops[0].immediate.value & 65535
            };
            let next = r.bind(bin(B::Add, oldsp, c(64, 8 + extra)));
            r.write(sp, WritePolicy::ZeroUpper, next);
            r.branch(FlowKind::Return, c(1, 1), target);
            return Some(r);
        }
        if ops.len() != 1 {
            return None;
        }
        if name == "POP" {
            if ops[0].kind != OperandKind::Register || width(ops[0])? != 64 {
                return None;
            }
            let value = r.bind(Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(oldsp.clone()),
                width: 64,
                endian: Endian::Little,
            }));
            let next = r.bind(bin(B::Add, oldsp, c(64, 8)));
            r.write(sp, WritePolicy::ZeroUpper, next);
            write(&mut r, d, ops[0], ip, value)?;
            return Some(r);
        }
        let target = if name == "CALL" && ops[0].kind == OperandKind::Relative {
            c(64, d.branch_target(ip)?)
        } else {
            if ops[0].kind != OperandKind::Immediate && width(ops[0])? != 64 {
                return None;
            }
            read(d, ops[0], ip, 64)?
        };
        let target = r.bind(target);
        let next = r.bind(bin(B::Sub, oldsp, c(64, 8)));
        let value = if name == "CALL" {
            c(64, ip.wrapping_add(d.length as u64))
        } else {
            target.clone()
        };
        r.effects.push(Effect::Store {
            memory: Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(next.clone()),
                width: 64,
                endian: Endian::Little,
            },
            value,
        });
        r.write(sp, WritePolicy::ZeroUpper, next);
        if name == "CALL" {
            r.branch(FlowKind::Call, c(1, 1), target)
        }
        return Some(r);
    }
    None
}
impl Decoded {
    pub fn semantic_recipe(&self, address: u64) -> Recipe {
        build(self,address).map(|r| mmx_transition(self,r)).unwrap_or_else(||Recipe::unsupported("x86 family, prefix, operand or execution-mode combination has no audited scalar recipe",address.wrapping_add(self.length as u64),match self.physical.mode{Mode::Mode16|Mode::Mode32=>32,Mode::Mode64=>64}))
    }
}
