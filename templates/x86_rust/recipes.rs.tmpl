fn select_vector_element(r: &mut Recipe, values: &[Expr], index: Expr) -> Expr {
    let w = values[0].ty.width;
    let index = r.bind(index);
    let mut out = c(w, 0);
    for (i, v) in values.iter().enumerate() {
        out = r.bind(Expr::select(
            bin(B::Eq, index.clone(), c(index.ty.width, i as u64)),
            v.clone(),
            out,
        ));
    }
    out
}
fn specialized_vectors(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if !fp_prefix(d) || e.kind == 0 || e.mandatory != 1 {
        return None;
    }
    let name = e.mnemonic;
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    if ops.len() < 2 {
        return None;
    }
    let compress = name.starts_with("VPCOMPRESS") || name.starts_with("VCOMPRESS");
    let expand = name.starts_with("VPEXPAND") || name.starts_with("VEXPAND");
    let w = if name.ends_with('B') {
        8
    } else if name.ends_with('W') {
        16
    } else if name.ends_with('Q') || name.ends_with("PD") {
        64
    } else if name.ends_with('D') || name.ends_with("PS") {
        32
