    if ops.len() != if e.mnemonic == "SHA1RNDS4" { 3 } else { 2 } || vector_width(ops[0])? != 128 {
        return None;
    }
    let mut r = float_recipe(d, ip);
    let ach = specialized_source(&mut r, d, ops[0], ip, 128)?;
    let bch = specialized_source(&mut r, d, ops[1], ip, 128)?;
    let a: Vec<_> = (0..4).map(|i| specialized_element(&ach, i, 32)).collect();
    let b: Vec<_> = (0..4).map(|i| specialized_element(&bch, i, 32)).collect();
    let mut out = Vec::new();
    match e.mnemonic {
        "SHA1NEXTE" => {
            out = b.clone();
            out[3] = r.bind(bin(B::Add, rotate_left(a[3].clone(), 30), b[3].clone()));
        }
        "SHA1MSG1" => {
            out = vec![
