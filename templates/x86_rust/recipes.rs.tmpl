        return None;
    }
    let gf = name.starts_with("GF2");
    if !gf && (p.mask != 0 || p.zeroing) {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    let expected = if unary || e.kind == 0 { 2 } else { 3 } + usize::from(immediate);
    if ops.len() != expected {
        return None;
    }
    let imm = if immediate {
        if ops[expected - 1].kind != OperandKind::Immediate {
            return None;
        }
        ops[expected - 1].immediate.value as u8
    } else {
        0
    };
    let vl = vector_width(ops[0])?;
    if (e.kind == 0 && vl != 128) || (e.kind == 1 && vl > 256) || (unary && vl != 128) {
        return None;
    }
    let first = if unary {
        ops[1]
    } else if e.kind == 0 {
        ops[0]
    } else {
        ops[1]
    };
    let second = ops[expected - 1 - usize::from(immediate)];
    let mut r = float_recipe(d, ip);
    let a = specialized_source(&mut r, d, first, ip, vl)?;
    let b = if unary {
        Vec::new()
    } else {
        specialized_source_access(
            &mut r,
            d,
            second,
            ip,
            vl,
            if gf { 8 } else { 64 },
            name == "GF2P8MULB",
        )?
    };
    if name == "PCLMULQDQ" {
        let mut output = Vec::new();
        for lane in 0..vl / 128 {
            let x = specialized_element(&a, usize::from(lane) * 2 + usize::from(imm & 1), 64);
            let y = specialized_element(&b, usize::from(lane) * 2 + usize::from(imm >> 4 & 1), 64);
            let mut lo = c(64, 0);
            let mut hi = c(64, 0);
            for bit in 0..64 {
                let condition = Expr::extract(y.clone(), bit, 1);
                lo = r.bind(bin(
                    B::Xor,
                    lo,
                    Expr::select(
                        condition.clone(),
                        bin(B::Shl, x.clone(), c(64, u64::from(bit))),
                        c(64, 0),
                    ),
                ));
                if bit != 0 {
                    hi = r.bind(bin(
                        B::Xor,
                        hi,
                        Expr::select(
                            condition,
                            bin(B::Lsr, x.clone(), c(64, u64::from(64 - bit))),
                            c(64, 0),
                        ),
                    ));
                }
            }
            output.extend([lo, hi]);
        }
        specialized_output(&mut r, d, ops[0], ip, 64, output)?;
        return Some(r);
    }
    let mut output = Vec::new();
    if gf {
        for i in 0..usize::from(vl / 8) {
            let x = specialized_element(&a, i, 8);
            let value = if name == "GF2P8MULB" {
                gf_product(&mut r, x, specialized_element(&b, i, 8))
            } else {
                let x = if name == "GF2P8AFFINEINVQB" {
                    gf_inverse(&mut r, x)
                } else {
                    x
                };
