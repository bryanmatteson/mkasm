                    vector_read(d, ops[0], ip, j as u16 * u16::from(w), w)?
                };
                for i in 0..n {
                    let selected = bin(
                        B::And,
                        Expr::extract(mask.clone(), i as u8, 1),
                        bin(B::Eq, ranks[i].clone(), c(64, j as u64)),
                    );
                    value = r.bind(Expr::select(selected, elements[i].clone(), value));
                }
                out.push(value);
            }
        }
        for (i, value) in out.into_iter().enumerate() {
            vector_write(&mut r, d, ops[0], ip, i as u16 * u16::from(w), w, value)?;
        }
