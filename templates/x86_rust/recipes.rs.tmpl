            for i in 0..n {
                let active = Expr::extract(mask.clone(), i as u8, 1);
                let value = if scalar_memory {
                    if ops[1].memory.size != vl {
                        return None;
                    }
                    let offset = bin(B::Mul, rank.clone(), c(64, u64::from(w / 8)));
                    let base = address(d, ops[1], ip, true)?;
                    let address = if let ExprKind::Binary {
                        op: B::Add,
                        left,
                        right,
                    } = &base.kind
                    {
                        if matches!(&right.kind,ExprKind::Register(s)if s.register.bank=="x86.segment_base")
                        {
                            bin(
                                B::Add,
                                bin(B::Add, (**left).clone(), offset),
                                (**right).clone(),
                            )
                        } else {
                            bin(B::Add, base, offset)
                        }
                    } else {
                        bin(B::Add, base, offset)
                    };
                    Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
                        address: Box::new(address),
                        width: w,
                        endian: Endian::Little,
                    })
                } else {
                    select_vector_element(&mut r, &elements, rank.clone())
                };
                let fallback = if p.zeroing {
                    c(w, 0)
                } else {
                    vector_read(d, ops[0], ip, i as u16 * u16::from(w), w)?
                };
                out.push(r.bind(Expr::select(active.clone(), value, fallback)));
                rank = r.bind(bin(B::Add, rank, Expr::cast(active, 64, false)));
            }
        } else {
            let mut ranks = Vec::new();
            for i in 0..n {
                ranks.push(rank.clone());
                rank = r.bind(bin(
                    B::Add,
                    rank,
                    Expr::cast(Expr::extract(mask.clone(), i as u8, 1), 64, false),
                ));
            }
            for j in 0..n {
                let mut value = if p.zeroing {
                    c(w, 0)
