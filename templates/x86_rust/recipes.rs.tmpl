//! Audited x86 scalar, SIMD, floating-point, and atomic recipes. Memory
//! transitions use explicit segment selectors and original access widths.
use crate::semantics::*;
use crate::{Decoded, DecodedOperand, Mode, OperandKind, RegisterClass};
use BinaryOp as B;
use UnaryOp as U;
fn c(w: u8, v: u64) -> Expr {
    Expr::constant(w, v)
}
fn bin(op: B, a: Expr, b: Expr) -> Expr {
    Expr::binary(op, a, b)
}
fn inv(a: Expr) -> Expr {
    Expr::unary(U::Not, a)
}
fn flag(i: u16) -> Expr {
    Expr::register(register("x86.flags", i, 1, 1))
}
fn setflag(r: &mut Recipe, i: u16, v: Expr) {
    r.write(register("x86.flags", i, 1, 1), WritePolicy::ZeroUpper, v)
}
fn slice(reg: crate::Register) -> Option<RegisterSlice> {
    if reg.class != RegisterClass::Gpr || ![8, 16, 32, 64].contains(&reg.width) {
        return None;
    }
    let mut s = register(
        "x86.gpr",
        (if reg.high8 {
            reg.number.checked_sub(4)?
        } else {
            reg.number
        }) as u16,
        reg.width as u8,
        64,
    );
    s.offset = if reg.high8 { 8 } else { 0 };
    Some(s)
}
fn width(o: &DecodedOperand) -> Option<u8> {
    match o.kind {
        OperandKind::Register => slice(o.register?).map(|s| s.width),
        OperandKind::Memory if [8, 16, 32, 64].contains(&o.memory.size) => {
            Some(o.memory.size as u8)
        }
        _ => None,
    }
}
fn address(d: &Decoded, o: &DecodedOperand, ip: u64, segment: bool) -> Option<Expr> {
    let m = o.memory;
    let w = m.address_size;
    if ![16, 32, 64].contains(&w) {
        return None;
    }
    let mut a = c(w, m.displacement as u64);
    if m.rip_relative {
        a = bin(B::Add, a, c(w, ip.wrapping_add(d.length as u64)))
    } else if let Some(base) = m.base {
        a = bin(
            B::Add,
            a,
            Expr::cast(Expr::register(slice(base)?), w, false),
        )
    }
    if let Some(index) = m.index {
        a = bin(
            B::Add,
            a,
            bin(
                B::Mul,
                Expr::cast(Expr::register(slice(index)?), w, false),
                c(w, m.scale as u64),
            ),
        )
    }
    let mut a = Expr::cast(a, 64, false);
    if segment {
        if d.physical.mode != Mode::Mode64 {
            // The consumer supplies segment bases explicitly, including the
            // implicit DS/SS selection. Offset arithmetic wraps before base addition.
            let number = m.segment.map(|s| s.number).unwrap_or_else(|| {
                if m.base.is_some_and(|b| matches!(b.number & 7, 4 | 5)) {
                    2
                } else {
                    3
                }
            });
            a = bin(
                B::Add,
                a,
                Expr::register(register("x86.segment_base", u16::from(number), 64, 64)),
            );
        } else if let Some(s) = m.segment {
            if s.number >= 4 {
                a = bin(
                    B::Add,
                    a,
                    Expr::register(register("x86.segment_base", s.number as u16, 64, 64)),
                )
            }
        }
    }
    Some(a)
}
fn read(d: &Decoded, o: &DecodedOperand, ip: u64, w: u8) -> Option<Expr> {
    Some(match o.kind {
        OperandKind::Register => Expr::cast(Expr::register(slice(o.register?)?), w, false),
        OperandKind::Memory => Expr::cast(
            Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address(d, o, ip, true)?),
                width: width(o)?,
                endian: Endian::Little,
            }),
            w,
            false,
        ),
        OperandKind::Immediate => c(w, o.immediate.value),
        _ => return None,
    })
}
fn write(r: &mut Recipe, d: &Decoded, o: &DecodedOperand, ip: u64, value: Expr) -> Option<()> {
    match o.kind {
        OperandKind::Register => {
            let s = slice(o.register?)?;
            r.write(
                s,
                if s.width == 32 && d.physical.mode == Mode::Mode64 {
                    WritePolicy::ZeroUpper
                } else {
                    WritePolicy::Preserve
                },
                value,
            )
        }
        OperandKind::Memory => {
            let a = address(d, o, ip, true)?;
            r.effects.push(Effect::Store {
                memory: Memory {kind: Default::default(), privilege: Default::default(),
                    address: Box::new(a),
                    width: width(o)?,
                    endian: Endian::Little,
                },
                value,
            })
        }
        _ => return None,
    }
    Some(())
}
// A zero masked shift count still reads memory but does not publish a store.
fn write_shift(r: &mut Recipe, d: &Decoded, o: &DecodedOperand, ip: u64, value: Expr, active: Expr) -> Option<()> {
    if o.kind == OperandKind::Memory {
        r.effects.push(Effect::StoreConditional {
            condition: active,
            memory: Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address(d, o, ip, true)?),
                width: width(o)?,
                endian: Endian::Little,
            },
            value,
        });
        Some(())
    } else {
        write(r, d, o, ip, value)
    }
}
fn nzp(r: &mut Recipe, v: Expr) {
    setflag(r, 3, bin(B::Eq, v.clone(), c(v.ty.width, 0)));
    setflag(r, 4, Expr::extract(v.clone(), v.ty.width - 1, 1));
    setflag(r, 1, Expr::unary(U::Parity, v))
}
fn condition(s: &str) -> Option<Expr> {
    let cf = flag(0);
    let z = flag(3);
    let sf = flag(4);
    let of = flag(5);
    let slt = bin(B::Xor, sf.clone(), of.clone());
    Some(match s {
        "O" => of,
        "NO" => inv(of),
        "B" | "C" | "NAE" => cf,
        "AE" | "NB" | "NC" => inv(cf),
        "E" | "Z" => z,
        "NE" | "NZ" => inv(z),
        "BE" | "NA" => bin(B::Or, cf, z),
        "A" | "NBE" => inv(bin(B::Or, cf, z)),
        "S" => sf,
        "NS" => inv(sf),
        "P" | "PE" => flag(1),
        "NP" | "PO" => inv(flag(1)),
        "L" | "NGE" => slt,
        "GE" | "NL" => inv(slt),
        "LE" | "NG" => bin(B::Or, z, slt),
        "G" | "NLE" => inv(bin(B::Or, z, slt)),
        _ => return None,
    })
}
// The corpus spells both near and far stack transfers CALL/RET. Opcode
// identity, not a mnemonic or incidental hidden operand, bounds this family.
fn near_stack(d: &Decoded) -> bool {
    let e = d.encoding();
    e.map == 0
        && match e.mnemonic {
            "PUSH" => {
                matches!(e.opcode, 0x50..=0x57 | 0x68 | 0x6a)
                    || (e.opcode == 0xff && d.physical.reg & 7 == 6)
            }
            "POP" => {
                matches!(e.opcode, 0x58..=0x5f) || (e.opcode == 0x8f && d.physical.reg & 7 == 0)
            }
            "CALL" => e.opcode == 0xe8 || (e.opcode == 0xff && d.physical.reg & 7 == 2),
            "RET" => matches!(e.opcode, 0xc2 | 0xc3),
            _ => false,
        }
}
fn near_branch(d: &Decoded) -> bool {
    let e = d.encoding();
    if e.mnemonic == "JMP" {
        return e.map == 0
            && (matches!(e.opcode, 0xe9 | 0xeb) || (e.opcode == 0xff && d.physical.reg & 7 == 4));
    }
    if matches!(e.mnemonic, "JCXZ" | "JECXZ" | "JRCXZ") {
        return e.map == 0 && e.opcode == 0xe3;
    }
    (e.map == 0 && (0x70..=0x7f).contains(&e.opcode))
        || (e.map == 1 && (0x80..=0x8f).contains(&e.opcode))
}
fn implicit_operands_are_audited(d: &Decoded, stack: bool) -> bool {
    let e = d.encoding();
    let name = e.mnemonic;
    let mut sp = 0;
    let mut mem = 0;
    let mut pc = 0;
    let mut counter = 0;
    for spec in &crate::OPERANDS
        [e.operand_start as usize..e.operand_start as usize + e.operand_len as usize]
    {
        if spec.flags & 4 == 0 {
            continue;
        }
        // Unknown hidden state and conditional/zeroing writes cannot disappear
        // merely because the structured decoder cannot name their registers.
        if spec.flags & !7 != 0 {
            return false;
        }
        let access = spec.flags & 3;
        if stack
            && spec.kind == "REG"
            && spec.symbol == "SPa"
            && spec.encoded_in == "ASZ"
            && spec.value.is_empty()
            && access == 3
        {
            sp += 1;
            if sp > 1 {
                return false;
            }
            continue;
        }
        if stack
            && spec.kind == "MEM"
            && spec.size == "SZ_V"
            && spec.encoded_in.is_empty()
            && spec.symbol.is_empty()
            && spec.value.is_empty()
            && spec.data_type == "SX"
            && access
                == if matches!(name, "PUSH" | "CALL") {
                    2
                } else {
                    1
                }
        {
            mem += 1;
            if mem > 1 {
                return false;
            }
            continue;
        }
        let count_name = match name {
            "JCXZ" => "CX",
            "JECXZ" => "ECX",
            "JRCXZ" => "RCX",
            _ => "",
        };
        if !count_name.is_empty()
            && near_branch(d)
            && spec.kind == "REG"
            && spec.value == count_name
            && spec.symbol.is_empty()
            && spec.encoded_in.is_empty()
            && access == 1
        {
            counter += 1;
            if counter > 1 {
                return false;
            }
            continue;
        }
        let is_pc = spec.kind == "REG"
            && ((spec.symbol == "IPa" && spec.encoded_in == "ASZ" && spec.value.is_empty())
                || (spec.symbol.is_empty() && matches!(spec.value, "IP" | "EIP" | "RIP")));
        if is_pc
            && access & 2 != 0
            && ((stack && matches!(name, "CALL" | "RET"))
                || (name.starts_with('J') && near_branch(d)))
        {
            pc += 1;
            if pc > 1 {
                return false;
            }
            continue;
        }
        return false;
    }
    true
}
// Packed storage is eight independent 64-bit chunks per architectural vector.
// Legacy SSE preserves upper chunks; VEX/EVEX explicitly clear them.
fn vector_slice(o: &DecodedOperand, bit: u16, w: u8) -> Option<RegisterSlice> {
    let v = o.register?;
    if o.kind != OperandKind::Register || bit + u16::from(w) > v.width
        || bit % 64 + u16::from(w) > 64 { return None; }
    let (bank, index, parent) = match v.class {
        RegisterClass::Vector if [128,256,512].contains(&v.width) =>
            ("x86.vector64", u16::from(v.number)*8 + bit/64, 64),
        RegisterClass::Mmx if v.width == 64 => ("x86.x87", u16::from(v.number)*2, 64),
        _ => return None,
    };
    let mut slice = register(bank,index,w,parent);
    slice.offset=(bit%64) as u8;
    Some(slice)
}
fn memory_broadcast_width(d: &Decoded) -> Option<u8> {
    if !d.physical.broadcast || d.encoding().kind != 2 || d.physical.mod_bits == 3 {
        return None;
    }
    let e = d.encoding();
    let specs = &crate::OPERANDS
        [e.operand_start as usize..e.operand_start as usize + e.operand_len as usize];
    if !specs.iter().any(|s| s.kind == "BCST") {
        return None;
    }
    let w = specs
        .iter()
        .find(|s| s.kind == "MEM")
        .and_then(|s| crate::data_type_bits(s.data_type))?;
    matches!(w, 8 | 16 | 32 | 64).then_some(w as u8)
}
fn supported_memory_prefix(d: &Decoded) -> bool {
    !d.physical.broadcast || (d.physical.mod_bits == 3 && d.encoding().suppress_exceptions) || memory_broadcast_width(d).is_some()
}
fn vector_mask_any(d: &Decoded, lanes: usize) -> Expr {
    if d.physical.mask == 0 {
        return c(1, 1);
    }
    let mask = if lanes >= 64 {
        u64::MAX
    } else {
        (1u64 << lanes) - 1
    };
    inv(bin(
        B::Eq,
        bin(
            B::And,
            Expr::register(register("x86.mask", u16::from(d.physical.mask), 64, 64)),
            c(64, mask),
        ),
        c(64, 0),
    ))
}
fn dynamic_address_offset(base: Expr, offset: Expr) -> Expr {
    if let ExprKind::Binary {
        op: B::Add,
        left,
        right,
    } = &base.kind
    {
        if matches!(&right.kind,ExprKind::Register(s)if s.register.bank=="x86.segment_base") {
            return bin(
                B::Add,
                bin(B::Add, (**left).clone(), offset),
                (**right).clone(),
            );
        }
    }
    bin(B::Add, base, offset)
}
// MOVDQA alignment is an instruction exception, including with an empty
// EVEX mask. Flat long-mode addresses can express it without segment state.
fn aligned_move(d: &Decoded) -> bool {
    let e = d.encoding();
    e.map == 1
        && matches!(e.opcode, 0x6f | 0x7f)
        && e.mandatory == 1
        && matches!(e.mnemonic, "MOVDQA" | "VMOVDQA" | "VMOVDQA32" | "VMOVDQA64")
}
fn memory_alignment(d: &Decoded, o: &DecodedOperand, ip: u64) -> Option<Expr> {
    if !aligned_move(d) {
        return Some(c(1, 1));
    }
    Some(bin(
        B::Eq,
        bin(
            B::And,
            address(d, o, ip, true)?,
            c(64, u64::from(o.memory.size / 8 - 1)),
        ),
        c(64, 0),
    ))
}
fn captured_memory_chunks(
    r: &mut Recipe,
    d: &Decoded,
    o: &DecodedOperand,
    ip: u64,
    bits: u16,
    granularity: u8,
    suppress: bool,
) -> Option<Vec<Expr>> {
    if bits == 0 || bits % 8 != 0 || bits > 512 || granularity == 0 || 64 % granularity != 0 {
        return None;
    }
    let lanes = usize::from(bits) / usize::from(granularity);
    let aligned = memory_alignment(d, o, ip)?;
    if d.physical.broadcast {
        let ew = memory_broadcast_width(d)?;
        let input = Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
            address: Box::new(address(d, o, ip, true)?),
            width: ew,
            endian: Endian::Little,
        });
        let input = r.bind(if suppress {
            Expr::select(vector_mask_any(d, lanes), input, c(ew, 0))
        } else {
            input
        });
        let mut chunk = c(64, 0);
        for offset in (0..64).step_by(usize::from(ew)) {
            chunk = bin(
                B::Or,
                chunk,
                bin(
                    B::Shl,
                    Expr::cast(input.clone(), 64, false),
                    c(64, offset as u64),
                ),
            );
        }
        let chunk = r.bind(chunk);
        return Some(vec![chunk; usize::from(bits).div_ceil(64)]);
    }
    if o.memory.size < bits {
        return None;
    }
    if d.physical.mask == 0 || !suppress {
        let chunks = if bits > 64 {
            let memory = WideMemory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address(d, o, ip, true)?),
                width: bits,
                endian: Endian::Little,
            };
            if aligned_move(d) {
                r.load_wide_conditional(aligned.clone(), memory)
            } else {
                r.load_wide(memory)
            }
        } else {
            vec![Expr::cast(
                Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
                    address: Box::new(address(d, o, ip, true)?),
                    width: bits as u8,
                    endian: Endian::Little,
                }),
                64,
                false,
            )]
        };
        return Some(
            chunks
                .into_iter()
                .map(|v| {
                    r.bind(if aligned_move(d) {
                        Expr::select(aligned.clone(), v, c(64, 0))
                    } else {
                        v
                    })
                })
                .collect(),
        );
    }
    let mut chunks = Vec::new();
    for chunk in 0..usize::from(bits).div_ceil(64) {
        let mut packed = c(64, 0);
        for offset in (0..64).step_by(usize::from(granularity)) {
            let bit = chunk * 64 + offset;
            if bit >= usize::from(bits) {
                break;
            }
            let lane = bit / usize::from(granularity);
            let input = Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(dynamic_address_offset(
                    address(d, o, ip, true)?,
                    c(64, (bit / 8) as u64),
                )),
                width: granularity,
                endian: Endian::Little,
            });
            let value = r.bind(Expr::select(
                bin(B::And, aligned.clone(), fp_active(d, lane as u16)),
                input,
                c(granularity, 0),
            ));
            packed = bin(
                B::Or,
                packed,
                bin(B::Shl, Expr::cast(value, 64, false), c(64, offset as u64)),
            );
        }
        chunks.push(r.bind(packed));
    }
    Some(chunks)
}
type MemorySnapshots<'a> = Vec<(&'a DecodedOperand, Vec<Expr>)>;
fn capture_memory_sources<'a>(
    r: &mut Recipe,
    d: &Decoded,
    sources: &[&'a DecodedOperand],
    ip: u64,
    bits: u16,
    granularity: u8,
    suppress: bool,
) -> Option<MemorySnapshots<'a>> {
    let mut snapshots: MemorySnapshots<'a> = Vec::new();
    for &o in sources {
        if o.kind == OperandKind::Memory
            && !snapshots.iter().any(|(prior, _)| std::ptr::eq(*prior, o))
        {
            snapshots.push((
                o,
                captured_memory_chunks(r, d, o, ip, bits, granularity, suppress)?,
            ));
        }
    }
    Some(snapshots)
}
fn snapshot_vector_read(
    d: &Decoded,
    o: &DecodedOperand,
    ip: u64,
    bit: u16,
    w: u8,
    snapshots: &MemorySnapshots<'_>,
) -> Option<Expr> {
    if let Some((_, chunks)) = snapshots.iter().find(|(prior, _)| std::ptr::eq(*prior, o)) {
        let chunk = chunks.get(usize::from(bit / 64))?;
        if u16::from(w) + bit % 64 > 64 {
            return None;
        }
        Some(Expr::extract(chunk.clone(), (bit % 64) as u8, w))
    } else {
        vector_read(d, o, ip, bit, w)
    }
}

fn add_address_offset(address: Expr, offset: u64) -> Expr {
    dynamic_address_offset(address, c(64, offset))
}

fn vector_read(d: &Decoded, o: &DecodedOperand, ip: u64, bit: u16, w: u8) -> Option<Expr> {
    if let Some(v) = o.register.filter(|v| v.class == RegisterClass::Mmx) {
        if bit + u16::from(w) > 64 { return None; }
        return Some(Expr::extract(mmx_physical(v.number, 0), bit as u8, w));
    }
    match o.kind {
        OperandKind::Register => Some(Expr::register(vector_slice(o, bit, w)?)),
        OperandKind::Memory if bit + u16::from(w) <= o.memory.size => Some(Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
            address: Box::new(add_address_offset(
                address(d, o, ip, true)?,
                u64::from(bit / 8),
            )),
            width: w,
            endian: Endian::Little,
        })),
        _ => None,
    }
}
fn vector_write(
    r: &mut Recipe,
    d: &Decoded,
    o: &DecodedOperand,
    ip: u64,
    bit: u16,
    w: u8,
    value: Expr,
) -> Option<()> {
    match o.kind {
        OperandKind::Register => r.write(vector_slice(o, bit, w)?, WritePolicy::Preserve, value),
        OperandKind::Memory if bit + u16::from(w) <= o.memory.size => {
            r.effects.push(Effect::Store {
                memory: Memory {kind: Default::default(), privilege: Default::default(),
                    address: Box::new(add_address_offset(
                        address(d, o, ip, true)?,
                        u64::from(bit / 8),
                    )),
                    width: w,
                    endian: Endian::Little,
                },
                value,
            })
        }
        _ => return None,
    }
    Some(())
}
fn vector_width(o: &DecodedOperand) -> Option<u16> {
    match o.kind {
        OperandKind::Register => {
            let v = o.register?;
            if (v.class == RegisterClass::Vector && [128, 256, 512].contains(&v.width))
                || (v.class == RegisterClass::Mmx && v.width == 64) {
                Some(v.width)
            } else {
                None
            }
        }
        OperandKind::Memory if [64, 128, 256, 512].contains(&o.memory.size) => Some(o.memory.size),
        _ => None,
    }
}
fn signed_dword_saturate(value: Expr) -> Expr {
    let low=c(64,0xffff_ffff_8000_0000);let high=c(64,0x7fff_ffff);
    Expr::cast(Expr::select(bin(B::Slt,value.clone(),low.clone()),low,
        Expr::select(bin(B::Slt,high.clone(),value.clone()),high,value)),32,false)
}
// These vector forms have distinct access contracts: CONFLICT is E4NF and
// retains a complete memory read even with an empty mask; ordinary dot/count
// operations suppress individual output-sized accesses. 4VNNIW guards one
// original-width128 memory read using the combined destination predicate.
fn avx512_integer(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e=d.encoding();let p=d.physical;
    if !fp_prefix(d)||!matches!(e.kind,1|2)||e.map!=2||(p.broadcast&&p.mod_bits==3){return None;}
    let (w,opcode,prefix,form)=match e.mnemonic {
        "VPMADD52LUQ"=>(64,0xb4,1,0),"VPMADD52HUQ"=>(64,0xb5,1,0),
        "VPDPBUSD"=>(32,0x50,1,1),"VPDPBUSDS"=>(32,0x51,1,1),
        "VPDPWSSD"=>(32,0x52,1,1),"VPDPWSSDS"=>(32,0x53,1,1),
        "VPCONFLICTD"=>(32,0xc4,1,2),"VPCONFLICTQ"=>(64,0xc4,1,2),
        "VPLZCNTD"=>(32,0x44,1,3),"VPLZCNTQ"=>(64,0x44,1,3),
        "VPOPCNTB"=>(8,0x54,1,4),"VPOPCNTW"=>(16,0x54,1,4),
        "VPOPCNTD"=>(32,0x55,1,4),"VPOPCNTQ"=>(64,0x55,1,4),
        "VPBROADCASTMB2Q"=>(64,0x2a,2,5),"VPBROADCASTMW2D"=>(32,0x3a,2,5),
        "VP4DPWSSD"=>(32,0x52,3,6),"VP4DPWSSDS"=>(32,0x53,3,6),
        "VPDPBSSD"=>(32,0x50,3,7),"VPDPBSSDS"=>(32,0x51,3,7),
        "VPDPBSUD"=>(32,0x50,2,7),"VPDPBSUDS"=>(32,0x51,2,7),
        "VPDPBUUD"=>(32,0x50,0,7),"VPDPBUUDS"=>(32,0x51,0,7),
        "VPDPWSUD"=>(32,0xd2,2,7),"VPDPWSUDS"=>(32,0xd3,2,7),
        "VPDPWUSD"=>(32,0xd2,1,7),"VPDPWUSDS"=>(32,0xd3,1,7),
        "VPDPWUUD"=>(32,0xd2,0,7),"VPDPWUUDS"=>(32,0xd3,0,7),
        _=>return None,
    };
    let wb=if w==64||(w==16&&form==4){1}else{0};
    if e.opcode!=opcode||e.mandatory!=prefix||e.w!=wb{return None;}
    if e.kind==1&&(!matches!(form,0|1|7)||p.vector_length>256||p.mask!=0||p.zeroing||p.broadcast){return None;}
    let ops:Vec<_>=d.operands().iter().filter(|o|!o.implicit&&o.kind!=OperandKind::Mask).collect();
    if ops.len()!=if form<=1||form>=6{3}else{2}||ops[0].kind!=OperandKind::Register{return None;}
    let vl=vector_width(ops[0])?;
    if !matches!(vl,128|256|512)||p.vector_length!=vl{return None;}
    let n=vl/u16::from(w);
    let mut r=float_recipe(d,ip);
    if form==5 {
        let source=ops[1].register?;
        if ops[1].kind!=OperandKind::Register||source.class!=RegisterClass::Mask||p.mask!=0||p.zeroing||p.broadcast{return None;}
        let value=r.bind(Expr::cast(Expr::extract(Expr::register(register("x86.mask",u16::from(source.number),64,64)),0,if w==64{8}else{16}),w,false));
        for lane in 0..n{vector_write(&mut r,d,ops[0],ip,lane*u16::from(w),w,value.clone())?;}
        clear_vector_upper(&mut r,ops[0],vl)?;return Some(r);
    }
    let source=ops[ops.len()-1];
    if form<=1||form>=6 {
        if ops[1].kind!=OperandKind::Register||vector_width(ops[1])?!=vl{return None;}
    }
    let quad=if form==6 {
        if vl!=512||source.kind!=OperandKind::Memory||source.memory.size!=128||p.broadcast{return None;}
        let memory=WideMemory{kind: Default::default(), privilege: Default::default(),address:Box::new(address(d,source,ip,true)?),width:128,endian:Endian::Little};
        if p.mask==0{r.load_wide(memory)}else{r.load_wide_conditional(vector_mask_any(d,16),memory)}
    }else{Vec::new()};
    let snapshots=if form==6{Vec::new()}else{capture_memory_sources(&mut r,d,&[source],ip,vl,w,form!=2)?};
    let mut conflict=Vec::new();
    if form==2 {
        for lane in 0..n {
            // Lane0's conflict output is constant zero. A register source is
            // needed only when a later active output actually compares it.
            let mut needed=c(1,0);
            for output in lane.max(1)..n{needed=bin(B::Or,needed,fp_active(d,output));}
            let input=snapshot_vector_read(d,source,ip,lane*u16::from(w),w,&snapshots)?;
            conflict.push(r.bind(Expr::select(needed,input,c(w,0))));
        }
    }
    let mut outputs=Vec::new();
    for lane in 0..n {
        let bit=lane*u16::from(w);let active=fp_active(d,lane);
        let mut value=if form==0 {
            let mask=c(64,0x000f_ffff_ffff_ffff);
            let a=r.bind(Expr::select(active.clone(),bin(B::And,vector_read(d,ops[1],ip,bit,64)?,mask.clone()),c(64,0)));
            let b=r.bind(Expr::select(active.clone(),bin(B::And,snapshot_vector_read(d,source,ip,bit,64,&snapshots)?,mask.clone()),c(64,0)));
            let low=r.bind(bin(B::Mul,a.clone(),b.clone()));
            let product=if opcode==0xb4 {bin(B::And,low,mask)} else {
                let high=bin(B::UnsignedMultiplyHigh,a,b);
                bin(B::Or,bin(B::Lsr,low,c(64,52)),bin(B::Shl,high,c(64,12)))
            };
            bin(B::Add,vector_read(d,ops[0],ip,bit,64)?,product)
        }else if form==1||form>=6 {
            let (dot_width,signed_a,signed_b,unsigned_acc)=match e.mnemonic {
                "VPDPBUSD"|"VPDPBUSDS"=>(8,false,true,false),
                "VPDPBSSD"|"VPDPBSSDS"=>(8,true,true,false),
                "VPDPBSUD"|"VPDPBSUDS"=>(8,true,false,false),
                "VPDPBUUD"|"VPDPBUUDS"=>(8,false,false,true),
                "VPDPWSUD"|"VPDPWSUDS"=>(16,true,false,false),
                "VPDPWUSD"|"VPDPWUSDS"=>(16,false,true,false),
                "VPDPWUUD"|"VPDPWUUDS"=>(16,false,false,true),
                _=>(16,true,true,false),
            };
            let mut accumulator=r.bind(Expr::select(active.clone(),Expr::cast(vector_read(d,ops[0],ip,bit,32)?,64,!unsigned_acc),c(64,0)));
            for group in 0..if form==6{4}else{1} {
                let (a,b)=if form==6 {
                    let mut operand=*ops[1];let mut reg=operand.register?;reg.number=(reg.number&!3)+group;operand.register=Some(reg);
                    (vector_read(d,&operand,ip,bit,32)?,specialized_element(&quad,usize::from(group),32))
                }else{(vector_read(d,ops[1],ip,bit,32)?,snapshot_vector_read(d,source,ip,bit,32,&snapshots)?)};
                let a=r.bind(Expr::select(active.clone(),a,c(32,0)));
                let b=r.bind(Expr::select(active.clone(),b,c(32,0)));
                for offset in (0..32).step_by(usize::from(dot_width)) {
                    let a=Expr::cast(Expr::extract(a.clone(),offset,dot_width),64,signed_a);
                    let b=Expr::cast(Expr::extract(b.clone(),offset,dot_width),64,signed_b);
                    accumulator=r.bind(bin(B::Add,accumulator,bin(B::Mul,a,b)));
                }
                // 4VNNIW saturates after EACH register-block dot product.
                if form==6&&opcode==0x53{accumulator=Expr::cast(signed_dword_saturate(accumulator),64,true);}
                else if form==6{accumulator=Expr::cast(Expr::cast(accumulator,32,false),64,true);}
            }
            if form!=6&&opcode&1!=0 {
                if unsigned_acc{Expr::cast(Expr::select(bin(B::Ult,c(64,0xffff_ffff),accumulator.clone()),c(64,0xffff_ffff),accumulator),32,false)}else{signed_dword_saturate(accumulator)}
            }else{Expr::cast(accumulator,32,false)}
        }else if form==2 {
            let mut mask=c(w,0);
            for prior in 0..lane {
                mask=bin(B::Or,mask,bin(B::Shl,Expr::cast(bin(B::Eq,conflict[usize::from(lane)].clone(),conflict[usize::from(prior)].clone()),w,false),c(w,u64::from(prior))));
            }
            mask
        }else {
            Expr::unary(if form==3{U::CountLeadingZeros}else{U::PopulationCount},snapshot_vector_read(d,source,ip,bit,w,&snapshots)?)
        };
        // Capture all outputs from the incoming register snapshot before any
        // destination write, including destination/source overlap.
        value=r.bind(Expr::select(active,value,c(w,0)));
        outputs.push(value);
    }
    specialized_output(&mut r,d,ops[0],ip,w,outputs)?;
    Some(r)
}

// SSE/AVX shuffles and unpacks are bit rearrangements: they never read
// MXCSR, classify NaNs or raise FP exceptions. Cross-lane E4NF/E4NF.nb forms
// retain one complete memory access even under an empty destination mask.
fn vector_rearrange(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e=d.encoding();let p=d.physical;
    if !fp_prefix(d)||(p.broadcast&&p.mod_bits==3){return None;}
    let name=e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    let (w,map,opcode,prefix,form)=match name {
        "SHUFPS"=>(32,1,0xc6,0,0),"SHUFPD"=>(64,1,0xc6,1,0),
        "UNPCKLPS"=>(32,1,0x14,0,1),"UNPCKHPS"=>(32,1,0x15,0,1),
        "UNPCKLPD"=>(64,1,0x14,1,1),"UNPCKHPD"=>(64,1,0x15,1,1),
        "PSHUFW"=>(16,1,0x70,0,6),"PSHUFD"=>(32,1,0x70,1,2),"PSHUFHW"=>(16,1,0x70,2,3),"PSHUFLW"=>(16,1,0x70,3,3),
        "PSHUFB"=>(8,2,0,1,4),
        "PUNPCKLBW"=>(8,1,0x60,1,1),"PUNPCKHBW"=>(8,1,0x68,1,1),
        "PUNPCKLWD"=>(16,1,0x61,1,1),"PUNPCKHWD"=>(16,1,0x69,1,1),
        "PUNPCKLDQ"=>(32,1,0x62,1,1),"PUNPCKHDQ"=>(32,1,0x6a,1,1),
        "PUNPCKLQDQ"=>(64,1,0x6c,1,1),"PUNPCKHQDQ"=>(64,1,0x6d,1,1),
        "SHUFF32X4"=>(32,3,0x23,1,5),"SHUFF64X2"=>(64,3,0x23,1,5),
        "SHUFI32X4"=>(32,3,0x43,1,5),"SHUFI64X2"=>(64,3,0x43,1,5),
        _=>return None,
    };
    if e.map!=map||e.opcode!=opcode||e.mandatory!=prefix && !(e.kind==0 && e.mandatory==0 && matches!(form,1|4) && name.starts_with('P')){return None;}
    if e.kind==2&&w>=32&&e.w!=(if w==64{1}else{0}){return None;}
    if form==5&&e.kind!=2{return None;}
    let ops:Vec<_>=d.operands().iter().filter(|o|!o.implicit&&o.kind!=OperandKind::Mask).collect();
    let unary=matches!(form,2|3|6);let immediate=matches!(form,0|2|3|5|6);
    let expected=(if unary||e.kind==0{2}else{3})+usize::from(immediate);
    if ops.len()!=expected||ops[0].kind!=OperandKind::Register{return None;}
    let vl=vector_width(ops[0])?;
    if e.kind==0&&!matches!(vl,64|128)||e.kind==1&&vl>256||form==5&&vl<256{return None;}
    if vl==64 && (e.kind!=0 || e.mandatory!=0 || !name.starts_with('P')) { return None; }
    if vl!=64 && name=="PSHUFW" { return None; }
    let a=if unary||e.kind!=0{ops[1]}else{ops[0]};
    let b=if unary{a}else{ops[expected-1-usize::from(immediate)]};
    let short_memory=vl==64&&form==1&&name.starts_with("PUNPCKL")&&b.kind==OperandKind::Memory&&b.memory.size==32;
    if vector_width(a)?!=vl||(!short_memory&&vector_width(b)?!=vl){return None;}
    if a.kind!=OperandKind::Register&&!unary{return None;}
    let control=if immediate{let imm=ops[expected-1];if imm.kind!=OperandKind::Immediate{return None;}imm.immediate.value}else{0};
    let mut r=float_recipe(d,ip);
    // Legacy SSE memory sources require 16-byte alignment. Test this before
    // consuming any memory or vector values, including faulting aliases.
    if e.kind==0 && vl!=64 {
        if let Some(memory)=ops.iter().find(|o|o.kind==OperandKind::Memory){
            r.preflight_traps.push((TrapKind::Protection,inv(bin(B::Eq,bin(B::And,address(d,memory,ip,true)?,c(64,15)),c(64,0)))));
        }
    }
    let snapshots=if short_memory{vec![(b,captured_memory_chunks(&mut r,d,b,ip,32,w,false)?)]}else{capture_memory_sources(&mut r,d,&[a,b],ip,vl,w,false)?};
    let read=|o:&DecodedOperand,bit:u16,width:u8|snapshot_vector_read(d,o,ip,bit,width,&snapshots);
    let rule=vl.min(128);let per=rule/u16::from(w);let mut outputs=Vec::new();
    for lane in 0..vl/u16::from(w) {
        let local=lane%per;let base=(lane/per)*rule;
        let value=match form {
            0=>{
                let source=if local<per/2{a}else{b};
                let selector=if w==32{(control>>(2*local))&3}else{(control>>lane)&1};
                read(source,base+selector as u16*u16::from(w),w)?
            },
            1=>{
                let high=name.starts_with("UNPCKH")||name.starts_with("PUNPCKH");
                let index=(if high{per/2}else{0})+local/2;
                read(if lane%2==0{a}else{b},base+index*u16::from(w),w)?
            },
            2=>read(a,base+((control>>(2*local))&3)as u16*32,32)?,
            3=>{
                let high=name=="PSHUFHW";
                let shuffled=(local>=4)==high;
                let index=if shuffled{(if high{4}else{0})+((control>>(2*(local%4)))&3)as u16}else{local};
                read(a,base+index*16,16)?
            },
            4=>{
                let active=fp_active(d,lane);
                let select=r.bind(Expr::select(active.clone(),read(b,lane*8,8)?,c(8,0)));let index=bin(B::And,select.clone(),c(8,(rule/8-1) as u64));
                let values=(0..rule/8).map(|i|read(a,base+i*8,8).map(|v|Expr::select(active.clone(),v,c(8,0)))).collect::<Option<Vec<_>>>()?;
                let value=select_vector_element(&mut r,&values,index);
                Expr::select(Expr::extract(select,7,1),c(8,0),value)
            },
            6=>read(a,((control>>(2*local))&3)as u16*16,16)?,
            5=>{
                let block=lane/per;let blocks=vl/128;
                let source=if block<blocks/2{a}else{b};
                let selected=if vl==256{(control>>block)&1}else{(control>>(2*block))&3};
                read(source,selected as u16*128+local*u16::from(w),w)?
            },
            _=>return None,
        };
        outputs.push(Expr::select(fp_active(d,lane),value,c(w,0)));
    }
    // Write complete storage chunks, so an all-zero mask does not need an
    // incoming destination merely to fill intermediate partial writes.
    let mut chunks=vec![c(64,0);usize::from(vl/64)];
    for (lane,value) in outputs.into_iter().enumerate(){
        let value=if p.mask!=0{Expr::select(fp_active(d,lane as u16),value,if p.zeroing{c(w,0)}else{read(ops[0],lane as u16*u16::from(w),w)?})}else{value};
        let bit=lane*usize::from(w);let chunk=&mut chunks[bit/64];
        *chunk=bin(B::Or,chunk.clone(),bin(B::Shl,Expr::cast(value,64,false),c(64,(bit%64)as u64)));
    }
    for (chunk,value) in chunks.into_iter().enumerate(){let value=r.bind(value);r.write(vector_slice(ops[0],chunk as u16*64,64)?,WritePolicy::ZeroUpper,value);}
    if e.kind!=0{clear_vector_upper(&mut r,ops[0],vl)?;}
    Some(r)
}

// EVEX integer comparisons have mask destinations: inactive and high bits are
// cleared, even though the encoding has no zeroing decorator. Keep this apart
// from legacy/VEX comparisons that produce all-ones vector elements.
fn packed_mask_comparison(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if e.kind != 2 || !fp_prefix(d) || p.zeroing || (p.broadcast && p.mod_bits == 3) {
        return None;
    }
    // form: signed predicate, unsigned predicate, equal, signed greater,
    // nonzero bit intersection, zero bit intersection.
    let (w, form) = match e.mnemonic {
        "VPCMPB" => (8, 0),
        "VPCMPW" => (16, 0),
        "VPCMPD" => (32, 0),
        "VPCMPQ" => (64, 0),
        "VPCMPUB" => (8, 1),
        "VPCMPUW" => (16, 1),
        "VPCMPUD" => (32, 1),
        "VPCMPUQ" => (64, 1),
        "VPCMPEQB" => (8, 2),
        "VPCMPEQW" => (16, 2),
        "VPCMPEQD" => (32, 2),
        "VPCMPEQQ" => (64, 2),
        "VPCMPGTB" => (8, 3),
        "VPCMPGTW" => (16, 3),
        "VPCMPGTD" => (32, 3),
        "VPCMPGTQ" => (64, 3),
        "VPTESTMB" => (8, 4),
        "VPTESTMW" => (16, 4),
        "VPTESTMD" => (32, 4),
        "VPTESTMQ" => (64, 4),
        "VPTESTNMB" => (8, 5),
        "VPTESTNMW" => (16, 5),
        "VPTESTNMD" => (32, 5),
        "VPTESTNMQ" => (64, 5),
        _ => return None,
    };
    let (map, opcode, prefix) = match form {
        0 | 1 => (3, (if w <= 16 { 0x3f } else { 0x1f }) - form, 1),
        2 => (
            if w == 64 { 2 } else { 1 },
            match w {
                8 => 0x74,
                16 => 0x75,
                32 => 0x76,
                _ => 0x29,
            },
            1,
        ),
        3 => (
            if w == 64 { 2 } else { 1 },
            match w {
                8 => 0x64,
                16 => 0x65,
                32 => 0x66,
                _ => 0x37,
            },
            1,
        ),
        4 | 5 => (
            2,
            if w <= 16 { 0x26 } else { 0x27 },
            if form == 5 { 2 } else { 1 },
        ),
        _ => return None,
    };
    if e.map != map
        || e.opcode != opcode
        || e.mandatory != prefix
        || (!(matches!(form, 2 | 3) && w <= 16) && e.w != if matches!(w, 16 | 64) { 1 } else { 0 })
        || (w <= 16 && p.broadcast)
    {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    let immediate = form <= 1;
    if ops.len() != if immediate { 4 } else { 3 }
        || ops[0].kind != OperandKind::Register
        || ops[0].register?.class != RegisterClass::Mask
        || ops[0].register?.number > 7
        || ops[1].kind != OperandKind::Register
    {
        return None;
    }
    let vl = vector_width(ops[1])?;
    if !matches!(vl, 128 | 256 | 512) || vector_width(ops[2])? != vl {
        return None;
    }
    let predicate = if immediate {
        if ops[3].kind != OperandKind::Immediate {
            return None;
        }
        // The primary specification reserves imm8[7:3]. Do not invent an
        // execution choice for these values through the raw decoder entrypoint.
        if ops[3].immediate.value > 7 {
            return None;
        }
        ops[3].immediate.value as u8
    } else {
        0
    };
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(&mut r, d, &[ops[2]], ip, vl, w, true)?;
    let mut output = c(64, 0);
    for lane in 0..vl / u16::from(w) {
        let bit = lane * u16::from(w);
        let a = snapshot_vector_read(d, ops[1], ip, bit, w, &snapshots)?;
        let b = snapshot_vector_read(d, ops[2], ip, bit, w, &snapshots)?;
        let comparison = match form {
            0 | 1 => {
                let compare = if form == 0 { B::Slt } else { B::Ult };
                match predicate {
                    0 => bin(B::Eq, a, b),
                    1 => bin(compare, a, b),
                    2 => inv(bin(compare, b, a)),
                    3 => c(1, 0),
                    4 => inv(bin(B::Eq, a, b)),
                    5 => inv(bin(compare, a, b)),
                    6 => bin(compare, b, a),
                    _ => c(1, 1),
                }
            }
            2 => bin(B::Eq, a, b),
            3 => bin(B::Slt, b, a),
            4 | 5 => {
                let zero = bin(B::Eq, bin(B::And, a, b), c(w, 0));
                if form == 4 { inv(zero) } else { zero }
            }
            _ => return None,
        };
        let selected = Expr::select(fp_active(d, lane), comparison, c(1, 0));
        output = bin(
            B::Or,
            output,
            bin(
                B::Shl,
                Expr::cast(selected, 64, false),
                c(64, u64::from(lane)),
            ),
        );
    }
    let output = r.bind(output);
    r.write(
        register("x86.mask", u16::from(ops[0].register?.number), 64, 64),
        WritePolicy::ZeroUpper,
        output,
    );
    Some(r)
}

// MMX addresses physical x87 registers while the public payload banks store
// logical ST positions. Capture that permutation from incoming TOP.
fn mmx_physical(number: u8, chunk: usize) -> Expr {
    let index = bin(
        B::And,
        bin(
            B::Sub,
            c(16, u64::from(number) + 8),
            bin(B::And, bin(B::Lsr, x87_sw(), c(16, 11)), c(16, 7)),
        ),
        c(16, 7),
    );
    let mut value = x87_st(0)[chunk].clone();
    for n in 1..8 {
        value = Expr::select(
            bin(B::Eq, index.clone(), c(16, n)),
            x87_st(n as u8)[chunk].clone(),
            value,
        );
    }
    value
}
fn mmx_transition(d: &Decoded, mut r: Recipe) -> Recipe {
    let operands: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| o.register.is_some_and(|v| v.class == RegisterClass::Mmx))
        .collect();
    if operands.is_empty() {
        return r;
    }
    r.preflight_traps
        .push((TrapKind::FloatingPoint, x87_pending(x87_cw(), x87_sw())));
    let mut prefix = Vec::new();
    for n in 0..8 {
        for chunk in 0..2 {
            let value = r.bind(mmx_physical(n, chunk));
            prefix.push(Effect::WriteRegister {
                destination: register(
                    "x86.x87",
                    u16::from(n) * 2 + chunk as u16,
                    if chunk == 0 { 64 } else { 16 },
                    if chunk == 0 { 64 } else { 16 },
                ),
                policy: WritePolicy::ZeroUpper,
                value,
            });
        }
    }
    prefix.push(Effect::WriteRegister {
        destination: register("x86.x87_status", 0, 16, 16),
        policy: WritePolicy::ZeroUpper,
        value: bin(B::And, x87_sw(), c(16, 0xc7ff)),
    });
    prefix.push(Effect::WriteRegister {
        destination: register("x86.x87_tags", 0, 16, 16),
        policy: WritePolicy::ZeroUpper,
        value: c(16, 0),
    });
    prefix.append(&mut r.effects);
    r.effects = prefix;
    for operand in operands {
        if operand.access.write || operand.access.conditional_write {
            r.write(
                register(
                    "x86.x87",
                    u16::from(operand.register.unwrap().number) * 2 + 1,
                    16,
                    16,
                ),
                WritePolicy::ZeroUpper,
                c(16, 0xffff),
            );
        }
    }
    r
}

// Integer operations whose result shape differs from the ordinary two-source
// element rules: widening, reductions, byte shifts, rounded multiply and blend.
fn packed_integer_extra(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let name = e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    if e.kind > 2
        || p.lock
        || !supported_memory_prefix(d)
        || (p.zeroing && p.mask == 0)
        || p.repeat != 0
    {
        return None;
    }
    let widening = name.starts_with("PMOVSX") || name.starts_with("PMOVZX");
    let (map, opcode, form) = if widening {
        let suffix = &name[6..];
        let code = match suffix {
            "BW" => 0,
            "BD" => 1,
            "BQ" => 2,
            "WD" => 3,
            "WQ" => 4,
            "DQ" => 5,
            _ => return None,
        };
        (
            2,
            if name.starts_with("PMOVSX") {
                0x20
            } else {
                0x30
            } + code,
            0,
        )
    } else {
        match name {
            "PMULHRSW" => (2, 0x0b, 1),
            "PHMINPOSUW" => (2, 0x41, 2),
            "MPSADBW" => (3, 0x42, 3),
            "PSLLDQ" => (1, 0x73, 4),
            "PSRLDQ" => (1, 0x73, 4),
            "PBLENDVB" => (
                if e.kind == 0 { 2 } else { 3 },
                if e.kind == 0 { 0x10 } else { 0x4c },
                5,
            ),
            "PTEST" => (2, 0x17, 6),
            _ => return None,
        }
    };
    if e.map != map || e.opcode != opcode {
        return None;
    }
    if name == "PBLENDVB" && e.kind == 0 {
        let hidden: Vec<_> = crate::OPERANDS
            [e.operand_start as usize..e.operand_start as usize + e.operand_len as usize]
            .iter()
            .filter(|s| s.flags & 4 != 0)
            .collect();
        if hidden.len() != 1
            || hidden[0].kind != "VREG"
            || hidden[0].value != "XMM0"
            || hidden[0].flags != 5
        {
            return None;
        }
    } else if !hidden_registers(d, &[]) {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    let vl = vector_width(*ops.first()?)?;
    if (e.kind == 0 && !matches!(vl, 64 | 128))
        || (e.kind == 1 && vl > 256)
        || e.mandatory != if vl == 64 { 0 } else { 1 }
    {
        return None;
    }
    if vl == 64 && form != 1 {
        return None;
    }
    if matches!(form, 2 | 3 | 5 | 6) && e.kind == 2 {
        return None;
    }
    if form == 2 && vl != 128 {
        return None;
    }
    let unary = matches!(form, 0 | 2 | 4);
    let immediate = matches!(form, 3 | 4);
    let expected = if form == 4 {
        if e.kind == 0 { 2 } else { 3 }
    } else if form == 6 {
        2
    } else if form == 5 && e.kind != 0 {
        4
    } else {
        (if unary || e.kind == 0 { 2 } else { 3 }) + usize::from(immediate)
    };
    if ops.len() != expected || ops[0].kind != OperandKind::Register {
        return None;
    }
    let mut r = float_recipe(d, ip);
    let a = if form == 6 || (form == 4 && e.kind == 0) {
        ops[0]
    } else if unary || e.kind != 0 {
        ops[1]
    } else {
        ops[0]
    };
    let b = if unary {
        a
    } else {
        ops[expected - 1 - usize::from(immediate) - usize::from(form == 5 && e.kind != 0)]
    };
    if immediate && ops[expected - 1].kind != OperandKind::Immediate {
        return None;
    }
    let imm = if immediate {
        ops[expected - 1].immediate.value & 255
    } else {
        0
    };
    if form == 0 {
        let (from, to) = match &name[6..] {
            "BW" => (8, 16),
            "BD" => (8, 32),
            "BQ" => (8, 64),
            "WD" => (16, 32),
            "WQ" => (16, 64),
            "DQ" => (32, 64),
            _ => return None,
        };
        let consumed = vl / u16::from(to) * u16::from(from);
        let source = if a.kind == OperandKind::Memory {
            if a.memory.size != consumed {
                return None;
            }
            // Input masking follows output lanes; no inactive address is read.
            if p.mask != 0 {
                let mut out = Vec::new();
                for i in 0..vl / u16::from(to) {
                    let v = Expr::load(Memory {
                        kind: Default::default(),
                        privilege: Default::default(),
                        address: Box::new(add_address_offset(
                            address(d, a, ip, true)?,
                            u64::from(i * u16::from(from) / 8),
                        )),
                        width: from,
                        endian: Endian::Little,
                    });
                    out.push(Expr::select(
                        fp_active(d, i),
                        Expr::cast(v, to, name.starts_with("PMOVSX")),
                        c(to, 0),
                    ));
                }
                specialized_output(&mut r, d, ops[0], ip, to, out)?;
                return Some(r);
            }
            captured_memory_chunks(&mut r, d, a, ip, consumed, from, false)?
        } else {
            Vec::new()
        };
        let out = (0..vl / u16::from(to))
            .map(|i| {
                let value = if a.kind == OperandKind::Register {
                    vector_read(d, a, ip, i * u16::from(from), from)?
                } else {
                    specialized_element(&source, usize::from(i), from)
                };
                Some(Expr::select(
                    fp_active(d, i),
                    Expr::cast(value, to, name.starts_with("PMOVSX")),
                    c(to, 0),
                ))
            })
            .collect::<Option<Vec<_>>>()?;
        specialized_output(&mut r, d, ops[0], ip, to, out)?;
        return Some(r);
    }
    if form == 4 {
        if p.reg & 7 != if name == "PSLLDQ" { 7 } else { 3 } || vl < 128 {
            return None;
        }
        let source = specialized_source(&mut r, d, a, ip, vl)?;
        let out = (0..vl / 8)
            .map(|i| {
                let local = i % 16;
                let selected = if name == "PSLLDQ" {
                    i64::from(local) - imm as i64
                } else {
                    i64::from(local) + imm as i64
                };
                if (0..16).contains(&selected) {
                    specialized_element(&source, usize::from(i / 16 * 16) + selected as usize, 8)
                } else {
                    c(8, 0)
                }
            })
            .collect();
        specialized_output(&mut r, d, ops[0], ip, 8, out)?;
        return Some(r);
    }
    if form == 1 {
        let snapshots = capture_memory_sources(&mut r, d, &[a, b], ip, vl, 16, true)?;
        let mut out = Vec::new();
        for i in 0..vl / 16 {
            let av = snapshot_vector_read(d, a, ip, i * 16, 16, &snapshots)?;
            let bv = snapshot_vector_read(d, b, ip, i * 16, 16, &snapshots)?;
            let product = bin(B::Mul, Expr::cast(av, 32, true), Expr::cast(bv, 32, true));
            out.push(Expr::select(
                fp_active(d, i),
                Expr::cast(
                    bin(B::Asr, bin(B::Add, product, c(32, 0x4000)), c(32, 15)),
                    16,
                    false,
                ),
                c(16, 0),
            ));
        }
        specialized_output(&mut r, d, ops[0], ip, 16, out)?;
        return Some(r);
    }
    let ach = specialized_source(&mut r, d, a, ip, vl)?;
    let bch = if unary {
        ach.clone()
    } else {
        specialized_source(&mut r, d, b, ip, vl)?
    };
    if form == 6 {
        let mut z = c(64, 0);
        let mut carry = c(64, 0);
        for (a, b) in ach.iter().zip(&bch) {
            z = bin(B::Or, z, bin(B::And, a.clone(), b.clone()));
            carry = bin(B::Or, carry, bin(B::And, inv(a.clone()), b.clone()));
        }
        for (f, v) in [
            (3, bin(B::Eq, z, c(64, 0))),
            (0, bin(B::Eq, carry, c(64, 0))),
            (1, c(1, 0)),
            (2, c(1, 0)),
            (4, c(1, 0)),
            (5, c(1, 0)),
        ] {
            setflag(&mut r, f, v);
        }
        return Some(r);
    }
    if form == 2 {
        let mut minimum = specialized_element(&ach, 0, 16);
        let mut index = c(16, 0);
        for i in 1..8 {
            let v = specialized_element(&ach, i, 16);
            let less = r.bind(bin(B::Ult, v.clone(), minimum.clone()));
            minimum = r.bind(Expr::select(less.clone(), v, minimum));
            index = r.bind(Expr::select(less, c(16, i as u64), index));
        }
        specialized_output(
            &mut r,
            d,
            ops[0],
            ip,
            16,
            vec![
                minimum,
                index,
                c(16, 0),
                c(16, 0),
                c(16, 0),
                c(16, 0),
                c(16, 0),
                c(16, 0),
            ],
        )?;
        return Some(r);
    }
    let selectors = if form == 5 {
        let selector = if e.kind == 0 {
            d.operands().iter().find(|o| {
                o.implicit
                    && o.register
                        .is_some_and(|v| v.class == RegisterClass::Vector && v.number == 0)
            })?
        } else {
            ops[3]
        };
        Some(specialized_source(&mut r, d, selector, ip, vl)?)
    } else {
        None
    };
    let ew = if form == 5 { 8 } else { 16 };
    let mut out = Vec::new();
    for i in 0..usize::from(vl / u16::from(ew)) {
        let value = match form {
            3 => {
                let lane = i / 8;
                let selector = imm >> (lane * 3);
                let abase = lane * 16 + ((selector >> 2) & 1) as usize * 4 + i % 8;
                let bbase = lane * 16 + (selector & 3) as usize * 4;
                let mut sum = c(16, 0);
                for j in 0..4 {
                    let a = Expr::cast(specialized_element(&ach, abase + j, 8), 16, false);
                    let b = Expr::cast(specialized_element(&bch, bbase + j, 8), 16, false);
                    sum = bin(
                        B::Add,
                        sum,
                        Expr::select(
                            bin(B::Ult, a.clone(), b.clone()),
                            bin(B::Sub, b.clone(), a.clone()),
                            bin(B::Sub, a, b),
                        ),
                    );
                }
                sum
            }
            5 => Expr::select(
                Expr::extract(specialized_element(selectors.as_ref()?, i, 8), 7, 1),
                specialized_element(&bch, i, 8),
                specialized_element(&ach, i, 8),
            ),
            _ => return None,
        };
        out.push(value);
    }
    specialized_output(&mut r, d, ops[0], ip, ew, out)?;
    Some(r)
}
fn packed_integer(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if e.kind > 2 || p.lock || !supported_memory_prefix(d) || (p.zeroing && p.mask == 0) {
        return None;
    }
    // Mandatory F2/F3 is opcode identity, not a REP execution prefix.
    let repeat = match e.mandatory {
        2 => 2,
        3 => 4,
        _ => 0,
    };
    if p.repeat != repeat {
        return None;
    }
    if d.operands()
        .iter()
        .any(|o| o.implicit && o.kind != OperandKind::Mask)
    {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    if ops.is_empty() {
        return None;
    }
    let vl = vector_width(ops[0])?;
    if (e.kind == 0 && !matches!(vl, 64 | 128)) || (e.kind == 1 && vl > 256) {
        return None;
    }
    if p.mask != 0 && e.kind != 2 {
        return None;
    }
    let name = e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    // Every accepted spelling also checks physical map/opcode/prefix below.
    let mut ew: u8 = match (e.map, e.opcode, name) {
        (1, 0xfc, "PADDB") | (1, 0xf8, "PSUBB") | (1, 0x74, "PCMPEQB") | (1, 0x64, "PCMPGTB") => 8,
        (1, 0xfd, "PADDW")
        | (1, 0xf9, "PSUBW")
        | (1, 0x75, "PCMPEQW")
        | (1, 0x65, "PCMPGTW")
        | (1, 0xd5, "PMULLW") => 16,
        (1, 0xfe, "PADDD")
        | (1, 0xfa, "PSUBD")
        | (1, 0x76, "PCMPEQD")
        | (1, 0x66, "PCMPGTD")
        | (2, 0x40, "PMULLD") => 32,
        (1, 0xd4, "PADDQ")
        | (1, 0xfb, "PSUBQ")
        | (2, 0x29, "PCMPEQQ")
        | (2, 0x37, "PCMPGTQ")
        | (2, 0x40, "PMULLQ") => 64,
        (1, 0xdb, "PAND" | "PANDQ")
        | (1, 0xdf, "PANDN" | "PANDNQ")
        | (1, 0xeb, "POR" | "PORQ")
        | (1, 0xef, "PXOR" | "PXORQ") => 64,
        (1, 0xdb, "PANDD") | (1, 0xdf, "PANDND") | (1, 0xeb, "PORD") | (1, 0xef, "PXORD") => 32,
        (1, 0xdc, "PADDUSB")
        | (1, 0xec, "PADDSB")
        | (1, 0xd8, "PSUBUSB")
        | (1, 0xe8, "PSUBSB")
        | (1, 0xe0, "PAVGB")
        | (1, 0xda, "PMINUB")
        | (1, 0xde, "PMAXUB")
        | (2, 0x38, "PMINSB")
        | (2, 0x3c, "PMAXSB") => 8,
        (1, 0xdd, "PADDUSW")
        | (1, 0xed, "PADDSW")
        | (1, 0xd9, "PSUBUSW")
        | (1, 0xe9, "PSUBSW")
        | (1, 0xe3, "PAVGW")
        | (1, 0xea, "PMINSW")
        | (1, 0xee, "PMAXSW")
        | (2, 0x3a, "PMINUW")
        | (2, 0x3e, "PMAXUW")
        | (1, 0xe4, "PMULHUW")
        | (1, 0xe5, "PMULHW") => 16,
        (2, 0x39, "PMINSD") | (2, 0x3b, "PMINUD") | (2, 0x3d, "PMAXSD") | (2, 0x3f, "PMAXUD") => 32,
        (2, 0x1c, "PABSB") | (2, 0x08, "PSIGNB") => 8,
        (2, 0x1d, "PABSW") | (2, 0x09, "PSIGNW") => 16,
        (2, 0x1e, "PABSD") | (2, 0x0a, "PSIGND") => 32,
        (1, 0xf6, "PSADBW") | (1, 0xf4, "PMULUDQ") | (2, 0x28, "PMULDQ") => 64,
        (1, 0xf5, "PMADDWD") => 32,
        (2, 0x04, "PMADDUBSW") | (3, 0x0e, "PBLENDW") => 16,
        (3, 0x0f, "PALIGNR") => 8,
        (3, 0x02, "PBLENDD") => 32,
        (1, 0x63, "PACKSSWB") | (1, 0x67, "PACKUSWB") => 8,
        (1, 0x6b, "PACKSSDW") | (2, 0x2b, "PACKUSDW") => 16,
        (2, 0x01, "PHADDW") | (2, 0x03, "PHADDSW") | (2, 0x05, "PHSUBW") | (2, 0x07, "PHSUBSW") => {
            16
        }
        (2, 0x02, "PHADDD") | (2, 0x06, "PHSUBD") => 32,
        (
            1,
            0x6f | 0x7f,
            "MOVDQA" | "MOVDQU" | "MOVDQA32" | "MOVDQA64" | "MOVDQU8" | "MOVDQU16" | "MOVDQU32"
            | "MOVDQU64",
        ) => 64,
        _ => return None,
    };
    let movement = name.starts_with("MOVDQ");
    if movement {
        if e.kind < 2 {
            if !((name == "MOVDQA" && e.mandatory == 1) || (name == "MOVDQU" && e.mandatory == 2)) {
                return None;
            }
        } else {
            ew = match name {
                "MOVDQA32" if e.mandatory == 1 => 32,
                "MOVDQA64" if e.mandatory == 1 => 64,
                "MOVDQU8" if e.mandatory == 3 => 8,
                "MOVDQU16" if e.mandatory == 3 => 16,
                "MOVDQU32" if e.mandatory == 2 => 32,
                "MOVDQU64" if e.mandatory == 2 => 64,
                _ => return None,
            };
        }
    } else if e.mandatory != if vl == 64 { 0 } else { 1 } {
        return None;
    }
    if e.kind == 2
        && (name.starts_with("PCMPEQ") || name.starts_with("PCMPGT") || name.starts_with("PSIGN"))
    {
        return None;
    }
    // EVEX W chooses D/Q for these operations. Decode identity must agree.
    if e.kind == 2 && (name.ends_with('Q') || name.ends_with("64")) && e.w != 1 {
        return None;
    }
    let unary = name.starts_with("PABS") || movement;
    let immediate = matches!(name, "PALIGNR" | "PBLENDW" | "PBLENDD");
    let expected = if unary {
        2 + usize::from(immediate)
    } else if e.kind == 0 {
        2 + usize::from(immediate)
    } else {
        3 + usize::from(immediate)
    };
    if ops.len() != expected {
        return None;
    }
    let a = if unary || e.kind != 0 { ops[1] } else { ops[0] };
    let b = if unary {
        a
    } else {
        ops[expected - 1 - usize::from(immediate)]
    };
    if vector_width(a)? != vl || vector_width(b)? != vl {
        return None;
    }
    if !movement && ops[0].kind != OperandKind::Register {
        return None;
    }
    if immediate && ops[expected - 1].kind != OperandKind::Immediate {
        return None;
    }
    let mut r = float_recipe(d, ip);
    if ops[0].kind == OperandKind::Memory && (p.zeroing || !movement) {
        return None;
    }
    if aligned_move(d) {
        if let Some(memory) = ops.iter().find(|o| o.kind == OperandKind::Memory) {
            let aligned = memory_alignment(d, memory, ip)?;
            r.effects.push(Effect::Trap {
                kind: TrapKind::Protection,
                condition: inv(aligned),
            });
        }
    }
    if movement && ops[0].kind == OperandKind::Memory && p.mask == 0 {
        let chunks = specialized_source(&mut r, d, a, ip, vl)?;
        r.store_wide(
            WideMemory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address(d, ops[0], ip, true)?),
                width: vl,
                endian: Endian::Little,
            },
            chunks,
        );
        return Some(r);
    }
    // Cross-lane E4NF forms retain the full read even at an empty writemask.
    let suppress = !(name.starts_with("PACK")
        || name.starts_with("PHADD")
        || name.starts_with("PHSUB")
        || matches!(
            name,
            "PALIGNR" | "PMADDWD" | "PMADDUBSW" | "PSADBW"
        ));
    let snapshots = capture_memory_sources(&mut r, d, &[a, b], ip, vl, ew, suppress)?;
    let vector_read = |d: &Decoded, o: &DecodedOperand, ip: u64, bit: u16, w: u8| {
        snapshot_vector_read(d, o, ip, bit, w, &snapshots)
    };
    let same = a.kind == OperandKind::Register
        && b.kind == OperandKind::Register
        && a.register == b.register;
    let zero_idiom = name.starts_with("PXOR") && same;
    for lane in 0..vl / u16::from(ew) {
        let bit = lane * u16::from(ew);
        let av = if zero_idiom {
            c(ew, 0)
        } else {
            vector_read(d, a, ip, bit, ew)?
        };
        let bv = if zero_idiom {
            c(ew, 0)
        } else {
            vector_read(d, b, ip, bit, ew)?
        };
        let mut value = if movement {
            av.clone()
        } else if name.starts_with("PADD") || name.starts_with("PSUB") {
            let sub = name.starts_with("PSUB");
            if matches!(
                name,
                "PADDB" | "PADDW" | "PADDD" | "PADDQ" | "PSUBB" | "PSUBW" | "PSUBD" | "PSUBQ"
            ) {
                bin(if sub { B::Sub } else { B::Add }, av.clone(), bv.clone())
            } else {
                let signed = name.starts_with("PADDS") || name.starts_with("PSUBS");
                let wide = ew * 2;
                let sum = bin(
                    if sub { B::Sub } else { B::Add },
                    Expr::cast(av.clone(), wide, signed),
                    Expr::cast(bv.clone(), wide, signed),
                );
                let lo = if signed { 1u64 << (ew - 1) } else { 0 };
                let hi = if signed {
                    (1u64 << (ew - 1)) - 1
                } else {
                    (1u64 << ew) - 1
                };
                let low = Expr::cast(c(ew, lo), wide, signed);
                let high = c(wide, hi);
                let clipped = Expr::select(
                    bin(B::Slt, sum.clone(), low.clone()),
                    low,
                    Expr::select(bin(B::Slt, high.clone(), sum.clone()), high, sum),
                );
                Expr::cast(clipped, ew, false)
            }
        } else if name.starts_with("PANDN") {
            bin(B::And, inv(av.clone()), bv.clone())
        } else if name.starts_with("PAND") {
            bin(B::And, av.clone(), bv.clone())
        } else if name.starts_with("POR") {
            bin(B::Or, av.clone(), bv.clone())
        } else if name.starts_with("PXOR") {
            bin(B::Xor, av.clone(), bv.clone())
        } else if name.starts_with("PCMPEQ") || name.starts_with("PCMPGT") {
            let pred = if name.starts_with("PCMPEQ") {
                bin(B::Eq, av.clone(), bv.clone())
            } else {
                bin(B::Slt, bv.clone(), av.clone())
            };
            Expr::cast(pred, ew, true)
        } else if name.starts_with("PMULL") {
            bin(B::Mul, av.clone(), bv.clone())
        } else if name == "PMULHW" || name == "PMULHUW" {
            Expr::extract(
                bin(
                    B::Mul,
                    Expr::cast(av.clone(), 32, name == "PMULHW"),
                    Expr::cast(bv.clone(), 32, name == "PMULHW"),
                ),
                16,
                16,
            )
        } else if name.starts_with("PAVG") {
            Expr::cast(
                bin(
                    B::Lsr,
                    bin(
                        B::Add,
                        bin(
                            B::Add,
                            Expr::cast(av.clone(), ew * 2, false),
                            Expr::cast(bv.clone(), ew * 2, false),
                        ),
                        c(ew * 2, 1),
                    ),
                    c(ew * 2, 1),
                ),
                ew,
                false,
            )
        } else if name.starts_with("PMIN") || name.starts_with("PMAX") {
            let signed = name.as_bytes()[4] == b'S';
            let less = bin(if signed { B::Slt } else { B::Ult }, av.clone(), bv.clone());
            if name.starts_with("PMIN") {
                Expr::select(less, av.clone(), bv.clone())
            } else {
                Expr::select(less, bv.clone(), av.clone())
            }
        } else if name.starts_with("PABS") {
            Expr::select(
                Expr::extract(av.clone(), ew - 1, 1),
                Expr::unary(U::Neg, av.clone()),
                av.clone(),
            )
        } else if name.starts_with("PSIGN") {
            Expr::select(
                bin(B::Eq, bv.clone(), c(ew, 0)),
                c(ew, 0),
                Expr::select(
                    Expr::extract(bv.clone(), ew - 1, 1),
                    Expr::unary(U::Neg, av.clone()),
                    av.clone(),
                ),
            )
        } else if name == "PSADBW" {
            let mut sum = c(64, 0);
            for byte in 0..8 {
                let x = vector_read(d, a, ip, bit + byte * 8, 8)?;
                let y = vector_read(d, b, ip, bit + byte * 8, 8)?;
                let difference = Expr::select(
                    bin(B::Ult, x.clone(), y.clone()),
                    bin(B::Sub, y.clone(), x.clone()),
                    bin(B::Sub, x, y),
                );
                sum = bin(B::Add, sum, Expr::cast(difference, 64, false));
            }
            sum
        } else if name == "PMULUDQ" || name == "PMULDQ" {
            bin(
                B::Mul,
                Expr::cast(vector_read(d, a, ip, bit, 32)?, 64, name == "PMULDQ"),
                Expr::cast(vector_read(d, b, ip, bit, 32)?, 64, name == "PMULDQ"),
            )
        } else if name == "PMADDWD" {
            let mut sum = c(32, 0);
            for k in 0..2 {
                sum = bin(
                    B::Add,
                    sum,
                    bin(
                        B::Mul,
                        Expr::cast(vector_read(d, a, ip, bit + k * 16, 16)?, 32, true),
                        Expr::cast(vector_read(d, b, ip, bit + k * 16, 16)?, 32, true),
                    ),
                );
            }
            sum
        } else if name == "PMADDUBSW" {
            let mut sum = c(32, 0);
            for k in 0..2 {
                sum = bin(
                    B::Add,
                    sum,
                    bin(
                        B::Mul,
                        Expr::cast(vector_read(d, a, ip, bit + k * 8, 8)?, 32, false),
                        Expr::cast(vector_read(d, b, ip, bit + k * 8, 8)?, 32, true),
                    ),
                );
            }
            Expr::cast(
                Expr::select(
                    bin(B::Slt, sum.clone(), c(32, 0xffff8000)),
                    c(32, 0xffff8000),
                    Expr::select(bin(B::Slt, c(32, 0x7fff), sum.clone()), c(32, 0x7fff), sum),
                ),
                16,
                false,
            )
        } else if name == "PALIGNR" {
            let bytes = vl.min(128) / 8;
            let selected = u64::from(lane % bytes) + ops[expected - 1].immediate.value;
            let base = (bit / vl.min(128)) * vl.min(128);
            if selected < u64::from(bytes) {
                vector_read(d, b, ip, base + selected as u16 * 8, 8)?
            } else if selected < u64::from(bytes * 2) {
                vector_read(d, a, ip, base + (selected as u16 - bytes) * 8, 8)?
            } else {
                c(8, 0)
            }
        } else if name == "PBLENDW" || name == "PBLENDD" {
            if e.kind == 2 {
                return None;
            }
            if ops[expected - 1].immediate.value >> (lane % 8) & 1 != 0 {
                bv.clone()
            } else {
                av.clone()
            }
        } else if name.starts_with("PACK") {
            let rule = vl.min(128);
            let per = rule / u16::from(ew);
            let half = per / 2;
            let src = if lane % per < half { a } else { b };
            let offset = (lane / per) * rule + (lane % half) * u16::from(ew) * 2;
            let source = vector_read(d, src, ip, offset, ew * 2)?;
            let unsigned = name.starts_with("PACKUS");
            let low = if unsigned {
                c(ew * 2, 0)
            } else {
                Expr::cast(c(ew, 1u64 << (ew - 1)), ew * 2, true)
            };
            let high = c(
                ew * 2,
                if unsigned {
                    (1u64 << ew) - 1
                } else {
                    (1u64 << (ew - 1)) - 1
                },
            );
            Expr::cast(
                Expr::select(
                    bin(B::Slt, source.clone(), low.clone()),
                    low,
                    Expr::select(bin(B::Slt, high.clone(), source.clone()), high, source),
                ),
                ew,
                false,
            )
        } else if name.starts_with("PHADD") || name.starts_with("PHSUB") {
            if e.kind == 2 {
                return None;
            }
            let rule = vl.min(128);
            let per = rule / u16::from(ew);
            let half = per / 2;
            let src = if lane % per < half { a } else { b };
            let offset = (lane / per) * rule + (lane % half) * u16::from(ew) * 2;
            let x = vector_read(d, src, ip, offset, ew)?;
            let y = vector_read(d, src, ip, offset + u16::from(ew), ew)?;
            let sub = name.starts_with("PHSUB");
            if name.ends_with("SW") {
                let sum = bin(
                    if sub { B::Sub } else { B::Add },
                    Expr::cast(x, 32, true),
                    Expr::cast(y, 32, true),
                );
                let low = c(32, 0xffff8000);
                let high = c(32, 0x7fff);
                Expr::cast(
                    Expr::select(
                        bin(B::Slt, sum.clone(), low.clone()),
                        low,
                        Expr::select(bin(B::Slt, high.clone(), sum.clone()), high, sum),
                    ),
                    16,
                    false,
                )
            } else {
                bin(if sub { B::Sub } else { B::Add }, x, y)
            }
        } else {
            return None;
        };
        if p.mask != 0 && ops[0].kind == OperandKind::Memory {
            let value = r.bind(value);
            r.store_conditional(
                fp_active(d, lane),
                Memory {kind: Default::default(), privilege: Default::default(),
                    address: Box::new(add_address_offset(
                        address(d, ops[0], ip, true)?,
                        u64::from(bit / 8),
                    )),
                    width: ew,
                    endian: Endian::Little,
                },
                value,
            );
            continue;
        }
        if p.mask != 0 {
            let pred = Expr::extract(
                Expr::register(register("x86.mask", u16::from(p.mask), 64, 64)),
                lane as u8,
                1,
            );
            let old = if p.zeroing {
                c(ew, 0)
            } else {
                vector_read(d, ops[0], ip, bit, ew)?
            };
            value = Expr::select(pred, value, old);
        }
        // Snapshot all results before applying output effects.
        let value = r.bind(value);
        vector_write(&mut r, d, ops[0], ip, bit, ew, value)?;
    }
    if e.kind != 0 && ops[0].kind == OperandKind::Register {
        let number = ops[0].register?.number;
        for chunk in vl / 64..8 {
            r.write(
                register("x86.vector64", u16::from(number) * 8 + chunk, 64, 64),
                WritePolicy::ZeroUpper,
                c(64, 0),
            );
        }
    }
    Some(r)
}
fn undefined_flags(r: &mut Recipe, indices: &[u16], reason: &'static str) {
    for &i in indices {
        setflag(r, i, Expr::undefined(1, reason));
    }
}
fn hidden_registers(d: &Decoded, expected: &[(&str, &str, u8)]) -> bool {
    let e = d.encoding();
    let specs = &crate::OPERANDS
        [e.operand_start as usize..e.operand_start as usize + e.operand_len as usize];
    let hidden: Vec<_> = specs.iter().filter(|s| s.flags & 4 != 0).collect();
    hidden.len() == expected.len()
        && hidden
            .iter()
            .zip(expected)
            .all(|(s, (symbol, value, access))| {
                s.kind == "REG"
                    && s.symbol == *symbol
                    && s.value == *value
                    && s.flags == (*access | 4)
            })
}
fn gpr_write(r: &mut Recipe, d: &Decoded, n: u16, w: u8, value: Expr) {
    r.write(
        register("x86.gpr", n, w, 64),
        if w == 32 && d.physical.mode == Mode::Mode64 {
            WritePolicy::ZeroUpper
        } else {
            WritePolicy::Preserve
        },
        value,
    )
}
fn product(r: &mut Recipe, a: Expr, b: Expr, signed: bool) -> (Expr, Expr) {
    let w = a.ty.width;
    if w < 64 {
        let full = r.bind(bin(
            B::Mul,
            Expr::cast(a, w * 2, signed),
            Expr::cast(b, w * 2, signed),
        ));
        return (Expr::extract(full.clone(), 0, w), Expr::extract(full, w, w));
    }
    let a = r.bind(a);
    let b = r.bind(b);
    (
        bin(B::Mul, a.clone(), b.clone()),
        bin(
            if signed {
                B::SignedMultiplyHigh
            } else {
                B::UnsignedMultiplyHigh
            },
            a,
            b,
        ),
    )
}
fn special_integer(d: &Decoded, ip: u64, mut r: Recipe) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let name = e.mnemonic;
    if e.kind != 0 || p.lock || p.repeat != 0 {
        return None;
    }
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
    if matches!(name, "MUL" | "IMUL") {
        let one = e.map == 0
            && matches!(e.opcode, 0xf6 | 0xf7)
            && p.reg & 7 == if name == "MUL" { 4 } else { 5 };
        let two = name == "IMUL" && e.map == 1 && e.opcode == 0xaf;
        let three = name == "IMUL" && e.map == 0 && matches!(e.opcode, 0x69 | 0x6b);
        if !(one || two || three)
            || ops.len()
                != if one {
                    1
                } else if two {
                    2
                } else {
                    3
                }
        {
            return None;
        }
        let w = width(ops[0])?;
        let hidden = if one && w == 8 {
            hidden_registers(d, &[("", "AL", 1), ("", "AX", 2)])
        } else if one {
            hidden_registers(d, &[("AXv", "", 3), ("DXv", "", 2)])
        } else {
            hidden_registers(d, &[])
        };
        if !hidden {
            return None;
        }
        let a = if one {
            Expr::register(register("x86.gpr", 0, w, 64))
        } else {
            read(d, ops[usize::from(three)], ip, w)?
        };
        let b = read(
            d,
            ops[if one {
                0
            } else if two {
                1
            } else {
                2
            }],
            ip,
            w,
        )?;
        let (lo, hi) = product(&mut r, a, b, name == "IMUL");
        let lo = r.bind(lo);
        let hi = r.bind(hi);
        let expected = if name == "IMUL" {
            Expr::cast(Expr::extract(lo.clone(), w - 1, 1), w, true)
        } else {
            c(w, 0)
        };
        let overflow = inv(bin(B::Eq, hi.clone(), expected));
        setflag(&mut r, 0, overflow.clone());
        setflag(&mut r, 5, overflow);
        undefined_flags(&mut r, &[1, 2, 3, 4], "multiply leaves this flag undefined");
        if one {
            if w == 8 {
                gpr_write(
                    &mut r,
                    d,
                    0,
                    16,
                    bin(
                        B::Or,
                        Expr::cast(lo, 16, false),
                        bin(B::Shl, Expr::cast(hi, 16, false), c(16, 8)),
                    ),
                );
            } else {
                gpr_write(&mut r, d, 0, w, lo);
                gpr_write(&mut r, d, 2, w, hi);
            }
        } else {
            write(&mut r, d, ops[0], ip, lo)?;
        }
        return Some(r);
    }
    if e.map == 0 && e.opcode == 0x98 && ops.is_empty() {
        let (w, source, dest) = match name {
            "CBW" => (16, "AL", "AX"),
            "CWDE" => (32, "AX", "EAX"),
            "CDQE" => (64, "EAX", "RAX"),
            _ => return None,
        };
        if !hidden_registers(d, &[("", dest, 2), ("", source, 1)]) {
            return None;
        }
        gpr_write(
            &mut r,
            d,
            0,
            w,
            Expr::cast(Expr::register(register("x86.gpr", 0, w / 2, 64)), w, true),
        );
        return Some(r);
    }
    if e.map == 0 && e.opcode == 0x99 && ops.is_empty() {
        let (w, source, dest) = match name {
            "CWD" => (16, "AX", "DX"),
            "CDQ" => (32, "EAX", "EDX"),
            "CQO" => (64, "RAX", "RDX"),
            _ => return None,
        };
        if !hidden_registers(d, &[("", dest, 2), ("", source, 1)]) {
            return None;
        }
        gpr_write(
            &mut r,
            d,
            2,
            w,
            Expr::cast(
                Expr::extract(Expr::register(register("x86.gpr", 0, w, 64)), w - 1, 1),
                w,
                true,
            ),
        );
        return Some(r);
    }
    if e.map == 0 && ops.is_empty() && hidden_registers(d, &[]) {
        match (name, e.opcode) {
            ("CLC", 0xf8) => setflag(&mut r, 0, c(1, 0)),
            ("STC", 0xf9) => setflag(&mut r, 0, c(1, 1)),
            ("CMC", 0xf5) => setflag(&mut r, 0, inv(flag(0))),
            ("CLD", 0xfc) => setflag(&mut r, 6, c(1, 0)),
            ("STD", 0xfd) => setflag(&mut r, 6, c(1, 1)),
            _ => return None,
        }
        return Some(r);
    }
    if e.map == 0 && matches!(e.opcode, 0x9e | 0x9f) && ops.is_empty() {
        let lahf = name == "LAHF" && e.opcode == 0x9f;
        let sahf = name == "SAHF" && e.opcode == 0x9e;
        if !(lahf || sahf) || !hidden_registers(d, &[("", "AH", if lahf { 2 } else { 1 })]) {
            return None;
        }
        let mut ah = register("x86.gpr", 0, 8, 64);
        ah.offset = 8;
        if lahf {
            let mut v = c(8, 2);
            for (index, bit) in [(0, 0), (1, 2), (2, 4), (3, 6), (4, 7)] {
                v = bin(
                    B::Or,
                    v,
                    bin(B::Shl, Expr::cast(flag(index), 8, false), c(8, bit)),
                );
            }
            r.write(ah, WritePolicy::Preserve, v);
        } else {
            let v = r.bind(Expr::register(ah));
            for (index, bit) in [(0, 0), (1, 2), (2, 4), (3, 6), (4, 7)] {
                setflag(&mut r, index, Expr::extract(v.clone(), bit, 1));
            }
        }
        return Some(r);
    }
    if e.map == 0
        && matches!(
            (name, e.opcode),
            ("LOOP", 0xe2) | ("LOOPE", 0xe1) | ("LOOPNE", 0xe0)
        )
        && ops.len() == 1
        && ops[0].kind == OperandKind::Relative
        && hidden_registers(d, &[("CXa", "", 3), ("IPa", "", 3)])
    {
        let w = p.address_size;
        let count = r.bind(bin(
            B::Sub,
            Expr::register(register("x86.gpr", 1, w, 64)),
            c(w, 1),
        ));
        let mut condition = inv(bin(B::Eq, count.clone(), c(w, 0)));
        if name != "LOOP" {
            condition = bin(
                B::And,
                condition,
                if name == "LOOPE" {
                    flag(3)
                } else {
                    inv(flag(3))
                },
            );
        }
        gpr_write(&mut r, d, 1, w, count);
        let aw = r.flow.fallthrough.ty.width;
        r.branch(FlowKind::Branch, condition, c(aw, d.branch_target(ip)?));
        return Some(r);
    }
    None
}

fn extra_shifts(d: &Decoded, ip: u64, mut r: Recipe) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let name = e.mnemonic;
    if e.kind != 0 || p.lock || p.repeat != 0 || !hidden_registers(d, &[]) {
        return None;
    }
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
    if matches!(name, "SHLD" | "SHRD") && e.map == 1 && ops.len() == 3 {
        let left = name == "SHLD";
        if !(if left {
            matches!(e.opcode, 0xa4 | 0xa5)
        } else {
            matches!(e.opcode, 0xac | 0xad)
        }) {
            return None;
        }
        let w = width(ops[0])?;
        if !matches!(w, 16 | 32 | 64)
            || ops[1].kind != OperandKind::Register
            || width(ops[1])? != w
        {
            return None;
        }
        let a = r.bind(read(d, ops[0], ip, w)?);
        let b = r.bind(read(d, ops[1], ip, w)?);
        let n = r.bind(bin(
            B::And,
            read(d, ops[2], ip, w)?,
            c(w, if w == 64 { 63 } else { 31 }),
        ));
        let zero = bin(B::Eq, n.clone(), c(w, 0));
        let excessive = bin(B::Ult, c(w, u64::from(w)), n.clone());
        let result = bin(
            B::Or,
            bin(if left { B::Shl } else { B::Lsr }, a.clone(), n.clone()),
            bin(
                if left { B::Lsr } else { B::Shl },
                b,
                bin(B::Sub, c(w, u64::from(w)), n.clone()),
            ),
        );
        let v = r.bind(Expr::select(
            excessive.clone(),
            Expr::undefined(w, "double shift count exceeds width"),
            result,
        ));
        let cf = Expr::extract(
            bin(
                B::Lsr,
                a.clone(),
                if left {
                    bin(B::Sub, c(w, u64::from(w)), n.clone())
                } else {
                    bin(B::Sub, n.clone(), c(w, 1))
                },
            ),
            0,
            1,
        );
        for (i, value) in [
            (0, cf),
            (1, Expr::unary(U::Parity, v.clone())),
            (2, Expr::undefined(1, "double shift AF undefined")),
            (3, bin(B::Eq, v.clone(), c(w, 0))),
            (4, Expr::extract(v.clone(), w - 1, 1)),
            (
                5,
                Expr::select(
                    bin(B::Eq, n.clone(), c(w, 1)),
                    bin(
                        B::Xor,
                        Expr::extract(a, w - 1, 1),
                        Expr::extract(v.clone(), w - 1, 1),
                    ),
                    Expr::undefined(1, "double shift OF undefined for count greater than one"),
                ),
            ),
        ] {
            setflag(
                &mut r,
                i,
                Expr::select(
                    zero.clone(),
                    flag(i),
                    Expr::select(
                        excessive.clone(),
                        Expr::undefined(1, "double shift count exceeds width"),
                        value,
                    ),
                ),
            );
        }
        write_shift(&mut r, d, ops[0], ip, v, inv(zero))?;
        return Some(r);
    }
    if matches!(name, "RCL" | "RCR")
        && e.map == 0
        && matches!(e.opcode, 0xc0 | 0xc1 | 0xd0 | 0xd1 | 0xd2 | 0xd3)
        && p.reg & 7 == (if name == "RCL" { 2 } else { 3 })
        && (ops.len() == 1 || ops.len() == 2)
    {
        let w = width(ops[0])?;
        if !matches!(w, 8 | 16 | 32 | 64) {
            return None;
        }
        let a = r.bind(read(d, ops[0], ip, w)?);
        let carry = r.bind(flag(0));
        let raw = if ops.len() == 1 {
            c(w, 1)
        } else {
            read(d, ops[1], ip, w)?
        };
        let masked = r.bind(bin(B::And, raw, c(w, if w == 64 { 63 } else { 31 })));
        let mut n = masked.clone();
        if w < 32 {
            for _ in 0..31 / (w + 1) {
                n = Expr::select(
                    bin(B::Ult, n.clone(), c(w, u64::from(w + 1))),
                    n.clone(),
                    bin(B::Sub, n, c(w, u64::from(w + 1))),
                );
            }
        }
        let n = r.bind(n);
        let zero = bin(B::Eq, n.clone(), c(w, 0));
        let left = name == "RCL";
        let result = if left {
            bin(
                B::Or,
                bin(
                    B::Or,
                    bin(B::Shl, a.clone(), n.clone()),
                    bin(
                        B::Shl,
                        Expr::cast(carry.clone(), w, false),
                        bin(B::Sub, n.clone(), c(w, 1)),
                    ),
                ),
                bin(
                    B::Lsr,
                    a.clone(),
                    bin(B::Sub, c(w, u64::from(w) + 1), n.clone()),
                ),
            )
        } else {
            bin(
                B::Or,
                bin(
                    B::Or,
                    bin(B::Lsr, a.clone(), n.clone()),
                    bin(
                        B::Shl,
                        Expr::cast(carry.clone(), w, false),
                        bin(B::Sub, c(w, u64::from(w)), n.clone()),
                    ),
                ),
                bin(
                    B::Shl,
                    a.clone(),
                    bin(B::Sub, c(w, u64::from(w) + 1), n.clone()),
                ),
            )
        };
        let v = r.bind(Expr::select(zero.clone(), a.clone(), result));
        let cf = r.bind(Expr::select(
            zero.clone(),
            carry,
            Expr::extract(
                bin(
                    B::Lsr,
                    a,
                    if left {
                        bin(B::Sub, c(w, u64::from(w)), n.clone())
                    } else {
                        bin(B::Sub, n.clone(), c(w, 1))
                    },
                ),
                0,
                1,
            ),
        ));
        let of = if left {
            bin(B::Xor, Expr::extract(v.clone(), w - 1, 1), cf.clone())
        } else {
            bin(
                B::Xor,
                Expr::extract(v.clone(), w - 1, 1),
                Expr::extract(v.clone(), w - 2, 1),
            )
        };
        setflag(&mut r, 0, cf);
        setflag(
            &mut r,
            5,
            Expr::select(
                bin(B::Eq, masked.clone(), c(w, 0)),
                flag(5),
                Expr::select(
                    bin(B::Eq, masked.clone(), c(w, 1)),
                    of,
                    Expr::undefined(
                        1,
                        "rotate through carry OF undefined for count greater than one",
                    ),
                ),
            ),
        );
        write_shift(&mut r, d, ops[0], ip, v, inv(bin(B::Eq, masked, c(w, 0))))?;
        return Some(r);
    }
    None
}

fn extra_integer(d: &Decoded, ip: u64, mut r: Recipe) -> Option<Recipe> {
    if let Some(shifts) = extra_shifts(d, ip, r.clone()) {
        return Some(shifts);
    }
    if let Some(special) = special_integer(d, ip, r.clone()) {
        return Some(special);
    }
    let e = d.encoding();
    let p = d.physical;
    let name = e.mnemonic;
    if e.kind != 0 || p.lock || p.broadcast || !implicit_operands_are_audited(d, false) {
        return None;
    }
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
    if e.map == 1 && matches!(e.opcode, 0xbc | 0xbd | 0xb8) && ops.len() == 2 {
        let qualified = match name {
            "BSF" => e.opcode == 0xbc && e.mandatory == 0 && p.repeat == 0,
            "BSR" => e.opcode == 0xbd && e.mandatory == 0 && p.repeat == 0,
            "TZCNT" => e.opcode == 0xbc && e.mandatory == 2 && p.repeat == 2,
            "LZCNT" => e.opcode == 0xbd && e.mandatory == 2 && p.repeat == 2,
            "POPCNT" => e.opcode == 0xb8 && e.mandatory == 2 && p.repeat == 2,
            _ => false,
        };
        if !qualified {
            return None;
        }
        let w = width(ops[0])?;
        if width(ops[1])? != w {
            return None;
        }
        let v = r.bind(read(d, ops[1], ip, w)?);
        let zero = bin(B::Eq, v.clone(), c(w, 0));
        let mut result = c(
            w,
            if matches!(name, "LZCNT" | "TZCNT") {
                u64::from(w)
            } else {
                0
            },
        );
        if name == "POPCNT" {
            result = Expr::unary(U::PopulationCount, v.clone());
        } else {
            for i in 0..w {
                let bit = if matches!(name, "BSF" | "TZCNT") {
                    w - 1 - i
                } else {
                    i
                };
                let answer = if name == "LZCNT" { w - 1 - bit } else { bit };
                result = Expr::select(
                    Expr::extract(v.clone(), bit, 1),
                    c(w, u64::from(answer)),
                    result,
                );
            }
        }
        if matches!(name, "BSF" | "BSR") {
            result = Expr::select(
                zero.clone(),
                Expr::undefined(w, "bit-scan destination undefined for zero input"),
                result,
            );
            setflag(&mut r, 3, zero);
            undefined_flags(
                &mut r,
                &[0, 1, 2, 4, 5],
                "bit scan leaves this flag undefined",
            );
        } else if name == "POPCNT" {
            setflag(&mut r, 3, zero);
            for i in [0, 1, 2, 4, 5] {
                setflag(&mut r, i, c(1, 0));
            }
        } else {
            setflag(&mut r, 0, zero);
            setflag(&mut r, 3, bin(B::Eq, result.clone(), c(w, 0)));
            undefined_flags(
                &mut r,
                &[1, 2, 4, 5],
                "count instruction leaves this flag undefined",
            );
        }
        let result = r.bind(result);
        write(&mut r, d, ops[0], ip, result)?;
        return Some(r);
    }
    if name == "BSWAP"
        && e.map == 1
        && (0xc8..=0xcf).contains(&e.opcode)
        && p.repeat == 0
        && ops.len() == 1
    {
        let w = width(ops[0])?;
        if ![32, 64].contains(&w) {
            return None;
        }
        let a = r.bind(read(d, ops[0], ip, w)?);
        let mut result = c(w, 0);
        for i in 0..w / 8 {
            result = bin(
                B::Or,
                result,
                bin(
                    B::Shl,
                    Expr::cast(Expr::extract(a.clone(), i * 8, 8), w, false),
                    c(w, u64::from(w - 8 - i * 8)),
                ),
            );
        }
        let value = r.bind(result);
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if matches!(name, "BT" | "BTS" | "BTR" | "BTC")
        && e.map == 1
        && p.repeat == 0
        && ops.len() == 2
        && ops[0].kind == OperandKind::Register
    {
        let expected = match name {
            "BT" => 0xa3,
            "BTS" => 0xab,
            "BTR" => 0xb3,
            _ => 0xbb,
        };
        let group = match name {
            "BT" => 4,
            "BTS" => 5,
            "BTR" => 6,
            _ => 7,
        };
        if !(e.opcode == expected || (e.opcode == 0xba && p.reg & 7 == group)) {
            return None;
        }
        let w = width(ops[0])?;
        let a = r.bind(read(d, ops[0], ip, w)?);
        let index = bin(B::And, read(d, ops[1], ip, w)?, c(w, u64::from(w - 1)));
        setflag(
            &mut r,
            0,
            Expr::extract(bin(B::Lsr, a.clone(), index.clone()), 0, 1),
        );
        undefined_flags(&mut r, &[1, 2, 4, 5], "bit test leaves this flag undefined");
        if name != "BT" {
            let bit = bin(B::Shl, c(w, 1), index);
            let result = bin(
                if name == "BTS" {
                    B::Or
                } else if name == "BTR" {
                    B::And
                } else {
                    B::Xor
                },
                a,
                if name == "BTR" { inv(bit) } else { bit },
            );
            let result = r.bind(result);
            write(&mut r, d, ops[0], ip, result)?;
        }
        return Some(r);
    }
    None
}

// VEX/EVEX per-element shift counts and EVEX immediate/variable rotates.
// Counts are unsigned at their full element width; only rotates reduce modulo
// that width. EVEX E4 memory exceptions suppress inactive elements, including
// the entire address computation when no destination element is active.
fn packed_variable_shifts(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if !fp_prefix(d)
        || !matches!(e.kind, 1 | 2)
        || e.mandatory != 1
        || (p.broadcast && p.mod_bits == 3)
    {
        return None;
    }
    // operation: 0 logical left, 1 logical right, 2 arithmetic right,
    // 3 rotate left, 4 rotate right.
    let (w, operation, immediate) = match e.mnemonic {
        "VPSLLVW" => (16, 0, false),
        "VPSLLVD" => (32, 0, false),
        "VPSLLVQ" => (64, 0, false),
        "VPSRLVW" => (16, 1, false),
        "VPSRLVD" => (32, 1, false),
        "VPSRLVQ" => (64, 1, false),
        "VPSRAVW" => (16, 2, false),
        "VPSRAVD" => (32, 2, false),
        "VPSRAVQ" => (64, 2, false),
        "VPROLVD" => (32, 3, false),
        "VPROLVQ" => (64, 3, false),
        "VPRORVD" => (32, 4, false),
        "VPRORVQ" => (64, 4, false),
        "VPROLD" => (32, 3, true),
        "VPROLQ" => (64, 3, true),
        "VPRORD" => (32, 4, true),
        "VPRORQ" => (64, 4, true),
        _ => return None,
    };
    if e.kind == 1 && (w == 16 || operation >= 3 || (operation == 2 && w == 64)) {
        return None;
    }
    let opcode = if immediate {
        0x72
    } else {
        match (operation, w) {
            (0, 16) => 0x12,
            (0, _) => 0x47,
            (1, 16) => 0x10,
            (1, _) => 0x45,
            (2, 16) => 0x11,
            (2, _) => 0x46,
            (3, _) => 0x15,
            (4, _) => 0x14,
            _ => return None,
        }
    };
    if e.map != if immediate { 1 } else { 2 }
        || e.opcode != opcode
        || e.w != if w == 32 { 0 } else { 1 }
        || (immediate && p.reg & 7 != if operation == 3 { 1 } else { 0 })
        || (w == 16 && p.broadcast)
    {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    if ops.len() != 3 || ops[0].kind != OperandKind::Register {
        return None;
    }
    let vl = vector_width(ops[0])?;
    if !matches!(vl, 128 | 256 | 512) || e.kind == 1 && vl > 256 {
        return None;
    }
    let source = ops[1];
    let count = ops[2];
    if vector_width(source)? != vl
        || (!immediate && (source.kind != OperandKind::Register || vector_width(count)? != vl))
        || (immediate && count.kind != OperandKind::Immediate)
    {
        return None;
    }
    let mut r = float_recipe(d, ip);
    let memory_sources = [if immediate { source } else { count }];
    let snapshots = capture_memory_sources(&mut r, d, &memory_sources, ip, vl, w, true)?;
    let mut chunks = vec![c(64, 0); usize::from(vl / 64)];
    for lane in 0..vl / u16::from(w) {
        let bit = lane * u16::from(w);
        let input = snapshot_vector_read(d, source, ip, bit, w, &snapshots)?;
        let n = if immediate {
            c(w, count.immediate.value & 255)
        } else {
            snapshot_vector_read(d, count, ip, bit, w, &snapshots)?
        };
        // Keep register reads inside the active branch. Neither a zeroing
        // destination nor an inactive count needs an available source value.
        let value = match operation {
            0 | 1 => bin(if operation == 0 { B::Shl } else { B::Lsr }, input, n),
            2 => bin(
                B::Asr,
                input,
                Expr::select(
                    bin(B::Ult, n.clone(), c(w, u64::from(w))),
                    n,
                    c(w, u64::from(w - 1)),
                ),
            ),
            3 | 4 => {
                let n = bin(B::And, n, c(w, u64::from(w - 1)));
                bin(
                    B::Ror,
                    input,
                    if operation == 3 {
                        bin(B::Sub, c(w, 0), n)
                    } else {
                        n
                    },
                )
            }
            _ => return None,
        };
        let value = if p.mask != 0 {
            Expr::select(
                fp_active(d, lane),
                value,
                if p.zeroing {
                    c(w, 0)
                } else {
                    vector_read(d, ops[0], ip, bit, w)?
                },
            )
        } else {
            value
        };
        let chunk = &mut chunks[usize::from(bit / 64)];
        *chunk = bin(
            B::Or,
            chunk.clone(),
            bin(
                B::Shl,
                Expr::cast(value, 64, false),
                c(64, u64::from(bit % 64)),
            ),
        );
    }
    for (chunk, value) in chunks.into_iter().enumerate() {
        let value = r.bind(value);
        r.write(
            vector_slice(ops[0], chunk as u16 * 64, 64)?,
            WritePolicy::ZeroUpper,
            value,
        );
    }
    clear_vector_upper(&mut r, ops[0], vl)?;
    Some(r)
}

fn packed_shifts(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let name = e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    if e.kind > 2
        || p.lock
        || p.repeat != 0
        || !supported_memory_prefix(d)
        || (p.zeroing && p.mask == 0)
        || !matches!(e.mandatory, 0 | 1)
        || !hidden_registers(d, &[])
    {
        return None;
    }
    let (ew, left, arithmetic) = match name {
        "PSLLW" => (16, true, false),
        "PSLLD" => (32, true, false),
        "PSLLQ" => (64, true, false),
        "PSRLW" => (16, false, false),
        "PSRLD" => (32, false, false),
        "PSRLQ" => (64, false, false),
        "PSRAW" => (16, false, true),
        "PSRAD" => (32, false, true),
        "PSRAQ" => (64, false, true),
        _ => return None,
    };
    let opcode = match (left, arithmetic, ew) {
        (true, _, 16) => 0xf1,
        (true, _, 32) => 0xf2,
        (true, _, _) => 0xf3,
        (false, true, 16) => 0xe1,
        (false, true, _) => 0xe2,
        (false, false, 16) => 0xd1,
        (false, false, 32) => 0xd2,
        _ => 0xd3,
    };
    let imm_opcode = if arithmetic && ew == 64 {
        0x72
    } else {
        match ew {
            16 => 0x71,
            32 => 0x72,
            _ => 0x73,
        }
    };
    let group = if left {
        6
    } else if arithmetic {
        4
    } else {
        2
    };
    let immediate = e.map == 1 && e.opcode == imm_opcode && p.reg & 7 == group;
    if !(immediate || (e.map == 1 && e.opcode == opcode)) {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    if ops.len() != if e.kind == 0 { 2 } else { 3 } {
        return None;
    }
    let vl = vector_width(ops[0])?;
    if (e.kind == 0 && !matches!(vl, 64 | 128)) || (e.kind == 1 && vl > 256) {
        return None;
    }
    if e.mandatory != if vl == 64 { 0 } else { 1 } { return None; }
    let source = if e.kind == 0 { ops[0] } else { ops[1] };
    if vector_width(source)? != vl {
        return None;
    }
    let count = ops[ops.len() - 1];
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(&mut r, d, &[source], ip, vl, ew, true)?;
    let vector_read = |d: &Decoded, o: &DecodedOperand, ip: u64, bit: u16, w: u8| {
        snapshot_vector_read(d, o, ip, bit, w, &snapshots)
    };
    let n = if immediate {
        if count.kind != OperandKind::Immediate {
            return None;
        }
        c(64, count.immediate.value & 255)
    } else if count.kind == OperandKind::Memory {
        specialized_source(&mut r, d, count, ip, if vl == 64 { 64 } else { 128 })?[0].clone()
    } else {
        vector_read(d, count, ip, 0, 64)?
    };
    let n = r.bind(n);
    for lane in 0..vl / u16::from(ew) {
        let bit = lane * u16::from(ew);
        let a = vector_read(d, source, ip, bit, ew)?;
        let mut value = if arithmetic {
            bin(
                B::Asr,
                a.clone(),
                Expr::select(
                    bin(B::Ult, n.clone(), c(64, u64::from(ew))),
                    n.clone(),
                    c(64, u64::from(ew - 1)),
                ),
            )
        } else {
            bin(if left { B::Shl } else { B::Lsr }, a, n.clone())
        };
        if p.mask != 0 {
            let pred = Expr::extract(
                Expr::register(register("x86.mask", u16::from(p.mask), 64, 64)),
                lane as u8,
                1,
            );
            value = Expr::select(
                pred,
                value,
                if p.zeroing {
                    c(ew, 0)
                } else {
                    vector_read(d, ops[0], ip, bit, ew)?
                },
            );
        }
        let value = r.bind(value);
        vector_write(&mut r, d, ops[0], ip, bit, ew, value)?;
    }
    if e.kind != 0 {
        let number = ops[0].register?.number;
        for chunk in vl / 64..8 {
            r.write(
                register("x86.vector64", u16::from(number) * 8 + chunk, 64, 64),
                WritePolicy::ZeroUpper,
                c(64, 0),
            );
        }
    }
    Some(r)
}

// Both BEXTR encodings share the same bounded source/control transition.
fn bit_extract(r: &mut Recipe, source: Expr, control: Expr) -> Expr {
    let w = source.ty.width;
    let start = bin(B::And, control.clone(), c(w, 255));
    let len = bin(B::And, bin(B::Lsr, control, c(w, 8)), c(w, 255));
    let mask = Expr::select(
        bin(B::Ult, len.clone(), c(w, u64::from(w))),
        bin(B::Sub, bin(B::Shl, c(w, 1), len), c(w, 1)),
        inv(c(w, 0)),
    );
    let value = r.bind(bin(B::And, bin(B::Lsr, source, start), mask));
    setflag(r, 0, c(1, 0));
    setflag(r, 5, c(1, 0));
    setflag(r, 3, bin(B::Eq, value.clone(), c(w, 0)));
    undefined_flags(r, &[1, 2, 4], "BEXTR leaves this flag undefined");
    value
}

fn bmi_integer(d: &Decoded, ip: u64, mut r: Recipe) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let name = e.mnemonic;
    if p.lock || p.broadcast || p.zeroing || p.mask != 0 {
        return None;
    }
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
    // MULX owns its audited implicit EDX/RDX input. Capture both halves
    // before either destination write; when destinations alias, high wins.
    if name == "MULX" && e.kind == 1 && e.map == 2 && e.opcode == 0xf6
        && e.mandatory == 3 && p.repeat == 4 && ops.len() == 3
    {
        let w = width(ops[0])?;
        if !matches!(w, 32 | 64) || width(ops[1])? != w || width(ops[2])? != w
            || ops[0].kind != OperandKind::Register || ops[1].kind != OperandKind::Register
            || !hidden_registers(d, &[("", if w == 64 { "RDX" } else { "EDX" }, 1)])
        {
            return None;
        }
        let multiplicand = Expr::register(register("x86.gpr", 2, w, 64));
        let multiplier = read(d, ops[2], ip, w)?;
        let (lo, hi) = product(&mut r, multiplicand, multiplier, false);
        let lo = r.bind(lo);
        let hi = r.bind(hi);
        write(&mut r, d, ops[1], ip, lo)?;
        write(&mut r, d, ops[0], ip, hi)?;
        return Some(r);
    }
    if !hidden_registers(d, &[]) { return None; }
    // AMD TBM uses XOP map A and an immediate control rather than VEX.vvvv.
    if name == "BEXTR" && e.kind == 4 && e.map == 7 && e.opcode == 0x10
        && e.mandatory == 0 && p.repeat == 0 && ops.len() == 3
        && ops[2].kind == OperandKind::Immediate
    {
        let w = width(ops[0])?;
        if !matches!(w, 32 | 64) || width(ops[1])? != w { return None; }
        let a = r.bind(read(d, ops[1], ip, w)?);
        let b = r.bind(read(d, ops[2], ip, w)?);
        let value = bit_extract(&mut r, a, b);
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if e.kind == 0
        && e.map == 2
        && e.opcode == 0xf6
        && matches!(
            (name, e.mandatory, p.repeat),
            ("ADCX", 1, 0) | ("ADOX", 2, 2)
        )
        && ops.len() == 2
    {
        let w = width(ops[0])?;
        let a = r.bind(read(d, ops[0], ip, w)?);
        let b = r.bind(read(d, ops[1], ip, w)?);
        let index = if name == "ADCX" { 0 } else { 5 };
        let carry = r.bind(flag(index));
        let value = r.bind(bin(
            B::Add,
            bin(B::Add, a.clone(), b.clone()),
            Expr::cast(carry.clone(), w, false),
        ));
        setflag(&mut r, index, Expr::add_carry(a, b, carry));
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if e.kind == 0
        && e.map == 2
        && matches!(e.opcode, 0xf0 | 0xf1)
        && e.mandatory == 0
        && p.repeat == 0
        && name == "MOVBE"
        && ops.len() == 2
        && ops.iter().filter(|o| o.kind == OperandKind::Memory).count() == 1
    {
        let w = width(ops[0])?;
        if width(ops[1])? != w {
            return None;
        }
        let source = r.bind(read(d, ops[1], ip, w)?);
        let mut result = c(w, 0);
        for byte in 0..w / 8 {
            result = bin(
                B::Or,
                result,
                bin(
                    B::Shl,
                    Expr::cast(Expr::extract(source.clone(), byte * 8, 8), w, false),
                    c(w, u64::from(w - 8 - byte * 8)),
                ),
            );
        }
        let result = r.bind(result);
        write(&mut r, d, ops[0], ip, result)?;
        return Some(r);
    }
    if e.kind == 0
        && e.map == 2
        && matches!(e.opcode, 0xf0 | 0xf1)
        && e.mandatory == 3
        && p.repeat == 4
        && name == "CRC32"
        && ops.len() == 2
    {
        let w = width(ops[0])?;
        let sw = width(ops[1])?;
        let source = r.bind(read(d, ops[1], ip, sw)?);
        let mut crc = r.bind(read(d, ops[0], ip, 32)?);
        for bit in 0..sw {
            let mix = bin(
                B::Xor,
                Expr::extract(crc.clone(), 0, 1),
                Expr::extract(source.clone(), bit, 1),
            );
            crc = r.bind(bin(
                B::Xor,
                bin(B::Lsr, crc, c(32, 1)),
                Expr::select(mix, c(32, 0x82f63b78), c(32, 0)),
            ));
        }
        write(&mut r, d, ops[0], ip, Expr::cast(crc, w, false))?;
        return Some(r);
    }
    if e.kind != 1
        || p.repeat
            != match e.mandatory {
                2 => 2,
                3 => 4,
                _ => 0,
            }
    {
        return None;
    }
    if !matches!(e.map, 2 | 3) {
        return None;
    }
    let w = width(*ops.first()?)?;
    if ![32, 64].contains(&w) {
        return None;
    }
    if matches!(name, "BLSR" | "BLSMSK" | "BLSI")
        && e.map == 2
        && e.opcode == 0xf3
        && e.mandatory == 0
        && ops.len() == 2
        && p.reg & 7
            == match name {
                "BLSR" => 1,
                "BLSMSK" => 2,
                _ => 3,
            }
    {
        let a = r.bind(read(d, ops[1], ip, w)?);
        let minus = bin(B::Sub, a.clone(), c(w, 1));
        let value = r.bind(match name {
            "BLSR" => bin(B::And, a.clone(), minus),
            "BLSMSK" => bin(B::Xor, a.clone(), minus),
            _ => bin(B::And, a.clone(), Expr::unary(U::Neg, a.clone())),
        });
        let zero = bin(B::Eq, a, c(w, 0));
        setflag(&mut r, 0, if name == "BLSI" { inv(zero) } else { zero });
        setflag(&mut r, 5, c(1, 0));
        setflag(&mut r, 3, bin(B::Eq, value.clone(), c(w, 0)));
        setflag(&mut r, 4, Expr::extract(value.clone(), w - 1, 1));
        undefined_flags(
            &mut r,
            &[1, 2],
            "BMI instruction leaves this flag undefined",
        );
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if name == "RORX"
        && e.map == 3
        && e.opcode == 0xf0
        && e.mandatory == 3
        && ops.len() == 3
        && ops[2].kind == OperandKind::Immediate
    {
        let value = r.bind(bin(
            B::Ror,
            read(d, ops[1], ip, w)?,
            c(w, ops[2].immediate.value & u64::from(w - 1)),
        ));
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if ops.len() != 3 {
        return None;
    }
    let a = r.bind(read(d, ops[1], ip, w)?);
    let b = r.bind(read(d, ops[2], ip, w)?);
    if e.map == 2
        && e.opcode == 0xf7
        && matches!((name, e.mandatory), ("SHLX", 1) | ("SHRX", 3) | ("SARX", 2))
    {
        let value = r.bind(bin(
            if name == "SHLX" {
                B::Shl
            } else if name == "SHRX" {
                B::Lsr
            } else {
                B::Asr
            },
            a,
            bin(B::And, b, c(w, u64::from(w - 1))),
        ));
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if name == "ANDN" && e.map == 2 && e.opcode == 0xf2 && e.mandatory == 0 {
        let value = r.bind(bin(B::And, inv(a), b));
        setflag(&mut r, 0, c(1, 0));
        setflag(&mut r, 5, c(1, 0));
        setflag(&mut r, 3, bin(B::Eq, value.clone(), c(w, 0)));
        setflag(&mut r, 4, Expr::extract(value.clone(), w - 1, 1));
        undefined_flags(&mut r, &[1, 2], "ANDN leaves this flag undefined");
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if name == "BEXTR" && e.map == 2 && e.opcode == 0xf7 && e.mandatory == 0 {
        let value = bit_extract(&mut r, a, b);
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if name == "BZHI" && e.map == 2 && e.opcode == 0xf5 && e.mandatory == 0 {
        let index = bin(B::And, b, c(w, 255));
        let within = bin(B::Ult, index.clone(), c(w, u64::from(w)));
        let value = r.bind(Expr::select(
            within.clone(),
            bin(
                B::And,
                a.clone(),
                bin(B::Sub, bin(B::Shl, c(w, 1), index), c(w, 1)),
            ),
            a,
        ));
        setflag(&mut r, 0, inv(within));
        setflag(&mut r, 5, c(1, 0));
        setflag(&mut r, 3, bin(B::Eq, value.clone(), c(w, 0)));
        setflag(&mut r, 4, Expr::extract(value.clone(), w - 1, 1));
        undefined_flags(&mut r, &[1, 2], "BZHI leaves this flag undefined");
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if e.map == 2 && e.opcode == 0xf5 && matches!((name, e.mandatory), ("PDEP", 3) | ("PEXT", 2)) {
        let mut index = c(w, 0);
        let mut value = c(w, 0);
        for bit in 0..w {
            let selected = Expr::extract(b.clone(), bit, 1);
            let source = if name == "PDEP" {
                Expr::extract(bin(B::Lsr, a.clone(), index.clone()), 0, 1)
            } else {
                Expr::extract(a.clone(), bit, 1)
            };
            let piece = bin(
                B::Shl,
                Expr::cast(source, w, false),
                if name == "PDEP" {
                    c(w, u64::from(bit))
                } else {
                    index.clone()
                },
            );
            value = r.bind(bin(
                B::Or,
                value,
                Expr::select(selected.clone(), piece, c(w, 0)),
            ));
            index = r.bind(bin(B::Add, index, Expr::cast(selected, w, false)));
        }
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    None
}

fn division_integer(d: &Decoded, ip: u64, mut r: Recipe) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let signed = e.mnemonic == "IDIV";
    if !matches!(e.mnemonic, "DIV" | "IDIV")
        || e.kind != 0
        || e.map != 0
        || !matches!(e.opcode, 0xf6 | 0xf7)
        || p.reg & 7 != (if signed { 7 } else { 6 })
        || p.lock
        || p.repeat != 0
    {
        return None;
    }
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
    if ops.len() != 1 {
        return None;
    }
    let w = width(ops[0])?;
    if !if w == 8 {
        hidden_registers(d, &[("", "AX", 3)])
    } else {
        hidden_registers(d, &[("AXv", "", 3), ("DXv", "", 3)])
    } {
        return None;
    }
    let divisor = r.bind(read(d, ops[0], ip, w)?);
    let zero = bin(B::Eq, divisor.clone(), c(w, 0));
    let (quotient, remainder, overflow) = if w < 64 {
        let numerator = if w == 8 {
            Expr::register(register("x86.gpr", 0, 16, 64))
        } else {
            bin(
                B::Or,
                Expr::cast(Expr::register(register("x86.gpr", 0, w, 64)), w * 2, false),
                bin(
                    B::Shl,
                    Expr::cast(Expr::register(register("x86.gpr", 2, w, 64)), w * 2, false),
                    c(w * 2, u64::from(w)),
                ),
            )
        };
        let numerator = r.bind(numerator);
        let denominator = Expr::cast(divisor.clone(), w * 2, signed);
        let q = r.bind(bin(
            if signed { B::Sdiv } else { B::Udiv },
            numerator.clone(),
            denominator.clone(),
        ));
        let rem = r.bind(bin(
            if signed { B::Srem } else { B::Urem },
            numerator,
            denominator,
        ));
        let truncated = Expr::cast(q.clone(), w, false);
        let overflow = inv(bin(B::Eq, q, Expr::cast(truncated.clone(), w * 2, signed)));
        (truncated, Expr::cast(rem, w, false), overflow)
    } else {
        let lo = r.bind(Expr::register(register("x86.gpr", 0, 64, 64)));
        let hi = r.bind(Expr::register(register("x86.gpr", 2, 64, 64)));
        let negative = if signed {
            Expr::extract(hi.clone(), 63, 1)
        } else {
            c(1, 0)
        };
        let divisor_negative = if signed {
            Expr::extract(divisor.clone(), 63, 1)
        } else {
            c(1, 0)
        };
        let abslo = r.bind(Expr::select(
            negative.clone(),
            Expr::unary(U::Neg, lo.clone()),
            lo.clone(),
        ));
        let abshi = r.bind(Expr::select(
            negative.clone(),
            bin(
                B::Add,
                inv(hi.clone()),
                Expr::cast(bin(B::Eq, lo, c(64, 0)), 64, false),
            ),
            hi,
        ));
        let absdivisor = r.bind(Expr::select(
            divisor_negative.clone(),
            Expr::unary(U::Neg, divisor.clone()),
            divisor.clone(),
        ));
        let excessive = inv(bin(B::Ult, abshi.clone(), absdivisor.clone()));
        let mut rem = abshi;
        let mut q = c(64, 0);
        // Long division of an explicit 128-bit numerator, retaining carry-out
        // separately so no intermediate expression exceeds 64 bits.
        for bit in (0..64).rev() {
            let carry = Expr::extract(rem.clone(), 63, 1);
            let shifted = r.bind(bin(
                B::Or,
                bin(B::Shl, rem, c(64, 1)),
                Expr::cast(Expr::extract(abslo.clone(), bit, 1), 64, false),
            ));
            let subtract = r.bind(bin(
                B::Or,
                carry,
                inv(bin(B::Ult, shifted.clone(), absdivisor.clone())),
            ));
            rem = r.bind(Expr::select(
                subtract.clone(),
                bin(B::Sub, shifted.clone(), absdivisor.clone()),
                shifted,
            ));
            q = r.bind(bin(
                B::Or,
                bin(B::Shl, q, c(64, 1)),
                Expr::cast(subtract, 64, false),
            ));
        }
        let quotient_negative = bin(B::Xor, negative.clone(), divisor_negative);
        let range = if signed {
            bin(
                B::Ult,
                Expr::select(
                    quotient_negative.clone(),
                    c(64, 0x8000000000000000),
                    c(64, 0x7fffffffffffffff),
                ),
                q.clone(),
            )
        } else {
            c(1, 0)
        };
        let quotient = Expr::select(quotient_negative, Expr::unary(U::Neg, q.clone()), q);
        let remainder = Expr::select(negative, Expr::unary(U::Neg, rem.clone()), rem);
        (quotient, remainder, bin(B::Or, excessive, range))
    };
    let quotient = r.bind(quotient);
    let remainder = r.bind(remainder);
    let overflow = r.bind(overflow);
    r.effects.push(Effect::Trap {
        kind: TrapKind::IntegerDivideByZero,
        condition: zero,
    });
    r.effects.push(Effect::Trap {
        kind: TrapKind::IntegerOverflow,
        condition: overflow,
    });
    undefined_flags(
        &mut r,
        &[0, 1, 2, 3, 4, 5],
        "division leaves arithmetic flags undefined",
    );
    if w == 8 {
        gpr_write(
            &mut r,
            d,
            0,
            16,
            bin(
                B::Or,
                Expr::cast(quotient, 16, false),
                bin(B::Shl, Expr::cast(remainder, 16, false), c(16, 8)),
            ),
        );
    } else {
        gpr_write(&mut r, d, 0, w, quotient);
        gpr_write(&mut r, d, 2, w, remainder);
    }
    Some(r)
}

// Capture each active source exactly once before asking the architectural FP
// backend for its pure value/status/trap projections.
fn float_lane(
    r: &mut Recipe,
    control: &Expr,
    status: &mut Expr,
    trapped: &mut Expr,
    operation: FloatOperation,
    width: u8,
    inputs: Vec<Expr>,
    active: Expr,
    fallback: Expr,
) -> Expr {
    let active = r.bind(active);
    let inputs: Vec<_> = inputs
        .into_iter()
        .map(|input| {
            let width = input.ty.width;
            r.bind(Expr::select(active.clone(), input, c(width, 0)))
        })
        .collect();
    let expression = |projection| {
        Expr::float(FloatExpression {
            operation,
            environment: FloatEnvironment::X86Mxcsr,
            width,
            inputs: inputs.clone(),
            control: Box::new(control.clone()),
            status: Box::new(status.clone()),
            projection,
        })
    };
    let value = r.bind(Expr::select(
        active.clone(),
        expression(FloatProjection::Value),
        fallback,
    ));
    let lane_trap = r.bind(Expr::select(
        active.clone(),
        expression(FloatProjection::Trapped),
        c(1, 0),
    ));
    let next_status = r.bind(Expr::select(
        active,
        expression(FloatProjection::Status),
        status.clone(),
    ));
    *status = next_status;
    *trapped = bin(B::Or, trapped.clone(), lane_trap);
    value
}
fn fp_controls(d: &Decoded, r: &mut Recipe) -> Expr {
    let incoming = r.bind(Expr::register(register("x86.mxcsr", 0, 32, 32)));
    if !d.encoding().suppress_exceptions {
        return incoming;
    }
    let control = if d.encoding().embedded_rounding {
        bin(
            B::Or,
            bin(B::And, incoming, c(32, !0x6000u64)),
            c(32, u64::from(d.physical.rounding_control) << 13),
        )
    } else {
        incoming
    };
    r.bind(bin(B::Or, control, c(32, 0x1f80)))
}

fn float_finish_arch(d: &Decoded, r: &mut Recipe, status: Expr, trapped: Expr) {
    if !d.encoding().suppress_exceptions {
        float_finish(r, status, trapped);
    }
}

fn float_finish(r: &mut Recipe, status: Expr, trapped: Expr) {
    r.write(
        register("x86.mxcsr", 0, 32, 32),
        WritePolicy::ZeroUpper,
        status,
    );
    r.effects.push(Effect::Trap {
        kind: TrapKind::FloatingPoint,
        condition: trapped,
    });
}
fn clear_vector_upper(r: &mut Recipe, o: &DecodedOperand, from: u16) -> Option<()> {
    let number = o.register?.number;
    if from % 64 != 0 {
        let offset = (from % 64) as u8;
        let mut upper = register(
            "x86.vector64",
            u16::from(number) * 8 + from / 64,
            64 - offset,
            64,
        );
        upper.offset = offset;
        r.write(upper, WritePolicy::Preserve, c(64 - offset, 0));
    }
    for chunk in from.div_ceil(64)..8 {
        r.write(
            register("x86.vector64", u16::from(number) * 8 + chunk, 64, 64),
            WritePolicy::ZeroUpper,
            c(64, 0),
        );
    }
    Some(())
}

fn fp_active(d: &Decoded, lane: u16) -> Expr {
    if d.physical.mask == 0 {
        c(1, 1)
    } else {
        Expr::extract(
            Expr::register(register("x86.mask", u16::from(d.physical.mask), 64, 64)),
            lane as u8,
            1,
        )
    }
}
fn fp_scalar_input(d: &Decoded, o: &DecodedOperand, ip: u64, w: u8) -> Option<Expr> {
    if o.kind == OperandKind::Register && o.register?.class == RegisterClass::Gpr {
        read(d, o, ip, w)
    } else {
        vector_read(d, o, ip, 0, w)
    }
}

fn floating_point(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if e.kind > 2
        || !matches!(e.map, 1 | 8)
        || p.lock
        || !supported_memory_prefix(d)
        || !hidden_registers(d, &[])
    {
        return None;
    }
    if p.repeat
        != match e.mandatory {
            2 => 2,
            3 => 4,
            _ => 0,
        }
    {
        return None;
    }
    let name = e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    let (stem, ew, scalar, prefix) = if let Some(stem) = name.strip_suffix("SS") {
        (stem, 32, true, 2)
    } else if let Some(stem) = name.strip_suffix("SD") {
        (stem, 64, true, 3)
    } else if let Some(stem) = name.strip_suffix("PS") {
        (stem, 32, false, 0)
    } else if let Some(stem) = name.strip_suffix("PD") {
        (stem, 64, false, 1)
    } else if let Some(stem) = name.strip_suffix("PH") {
        (stem, 16, false, 0)
    } else if let Some(stem) = name.strip_suffix("SH") {
        (stem, 16, true, 2)
    } else {
        return None;
    };
    if e.map != if ew == 16 { 8 } else { 1 } || (ew == 16 && e.kind != 2) { return None; }
    let (opcode, operation) = match stem {
        "ADD" => (0x58, FloatOperation::Add),
        "SUB" => (0x5c, FloatOperation::Subtract),
        "MUL" => (0x59, FloatOperation::Multiply),
        "DIV" => (0x5e, FloatOperation::Divide),
        "SQRT" => (0x51, FloatOperation::SquareRoot),
        "MIN" => (
            0x5d,
            FloatOperation::MinMax {
                minimum: true,
                numeric: false,
            },
        ),
        "MAX" => (
            0x5f,
            FloatOperation::MinMax {
                minimum: false,
                numeric: false,
            },
        ),
        _ => return None,
    };
    if e.opcode != opcode || e.mandatory != prefix {
        return None;
    }
    let unary = stem == "SQRT";
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    let expected = if e.kind == 0 || (unary && !scalar) {
        2
    } else {
        3
    };
    if ops.len() != expected || ops[0].kind != OperandKind::Register {
        return None;
    }
    let vl = vector_width(ops[0])?;
    if (scalar && vl != 128) || (e.kind == 0 && vl != 128) || (e.kind == 1 && vl > 256) {
        return None;
    }
    if p.zeroing && p.mask == 0 {
        return None;
    }
    let last = ops[ops.len() - 1];
    let first = if e.kind == 0 { ops[0] } else { ops[1] };
    if !scalar && vector_width(last)? != vl {
        return None;
    }
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(
        &mut r,
        d,
        &[last],
        ip,
        if scalar { u16::from(ew) } else { vl },
        ew,
        true,
    )?;
    let vector_read = |d: &Decoded, o: &DecodedOperand, ip: u64, bit: u16, w: u8| {
        snapshot_vector_read(d, o, ip, bit, w, &snapshots)
    };
    let control = fp_controls(d, &mut r);
    let mut status = control.clone();
    let mut trapped = c(1, 0);
    let mut values = Vec::new();
    let count = if scalar { 1 } else { vl / u16::from(ew) };
    for lane in 0..count {
        let bit = lane * u16::from(ew);
        let inputs = if unary {
            vec![vector_read(d, last, ip, bit, ew)?]
        } else {
            vec![
                vector_read(d, first, ip, bit, ew)?,
                vector_read(d, last, ip, bit, ew)?,
            ]
        };
        let active = if p.mask == 0 {
            c(1, 1)
        } else {
            Expr::extract(
                Expr::register(register("x86.mask", u16::from(p.mask), 64, 64)),
                lane as u8,
                1,
            )
        };
        let old = if p.zeroing {
            c(ew, 0)
        } else {
            vector_read(d, ops[0], ip, bit, ew)?
        };
        let value = float_lane(
            &mut r,
            &control,
            &mut status,
            &mut trapped,
            operation,
            ew,
            inputs,
            active,
            old,
        );
        values.push((bit, value));
    }
    // MXCSR sticky flags commit even when an unmasked FP exception prevents
    // the destination write. Every lane observes original data operands.
    float_finish_arch(d, &mut r, status, trapped);
    for (bit, value) in values {
        vector_write(&mut r, d, ops[0], ip, bit, ew, value)?;
    }
    if scalar && e.kind != 0 {
        // Scalar VEX/EVEX copy bits 127:element_width from the first source.
        for bit in (u16::from(ew)..128).step_by(ew as usize) {
            let value = r.bind(vector_read(d, first, ip, bit, ew)?);
            vector_write(&mut r, d, ops[0], ip, bit, ew, value)?;
        }
    }
    if e.kind != 0 {
        let number = ops[0].register?.number;
        for chunk in vl / 64..8 {
            r.write(
                register("x86.vector64", u16::from(number) * 8 + chunk, 64, 64),
                WritePolicy::ZeroUpper,
                c(64, 0),
            );
        }
    }
    Some(r)
}

// Data movement has no floating-point environment side effects. Reads are
// captured before writes; restartable gathers explicitly publish read progress.
// SBCST is source annotation, not a hidden architectural input.
fn movement_hidden_registers(d: &Decoded) -> bool {
    let e = d.encoding();
    crate::OPERANDS[e.operand_start as usize..e.operand_start as usize + e.operand_len as usize]
        .iter()
        .all(|s| s.flags & 4 == 0 || (s.kind == "SBCST" && s.flags == 4))
}
fn movement_upper(r: &mut Recipe, d: &Decoded, o: &DecodedOperand, bits: u16) -> Option<()> {
    if d.encoding().kind != 0 && o.register.is_some_and(|v| v.class == RegisterClass::Vector) {
        clear_vector_upper(r, o, bits)?;
    }
    Some(())
}
fn movement_scalar(d: &Decoded, o: &DecodedOperand, ip: u64, w: u8) -> Option<Expr> {
    if o.register
        .is_some_and(|v| matches!(v.class, RegisterClass::Vector | RegisterClass::Mmx))
    {
        vector_read(d, o, ip, 0, w)
    } else {
        read(d, o, ip, w)
    }
}
fn movement_store(
    r: &mut Recipe,
    d: &Decoded,
    o: &DecodedOperand,
    ip: u64,
    w: u8,
    value: Expr,
    condition: Option<Expr>,
) -> Option<()> {
    if o.kind == OperandKind::Memory {
        let memory = Memory {
            kind: Default::default(),
            privilege: Default::default(),
            address: Box::new(address(d, o, ip, true)?),
            width: w,
            endian: Endian::Little,
        };
        r.effects.push(match condition {
            Some(condition) => Effect::StoreConditional {
                condition,
                memory,
                value,
            },
            None => Effect::Store { memory, value },
        });
    } else if o
        .register
        .is_some_and(|v| matches!(v.class, RegisterClass::Vector | RegisterClass::Mmx))
    {
        vector_write(r, d, o, ip, 0, w, value)?;
    } else {
        write(r, d, o, ip, value)?;
    }
    Some(())
}
fn movement_progress(
    r: &mut Recipe,
    stage: usize,
    destination: RegisterSlice,
    value: Expr,
    condition: Option<Expr>,
) {
    r.read_progress.as_mut().unwrap().updates.push(ReadUpdate {
        after_read: stage,
        update: RegisterUpdate {
            destination,
            policy: WritePolicy::Preserve,
            value,
        },
        condition,
    });
}
fn gathered_movement(d: &Decoded, ip: u64, ops: &[&DecodedOperand]) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let (iw, ew) = match (e.mnemonic, e.opcode) {
        ("VGATHERDPS" | "VPGATHERDD", 0x92 | 0x90) => (32, 32),
        ("VGATHERDPD" | "VPGATHERDQ", 0x92 | 0x90) => (32, 64),
        ("VGATHERQPS" | "VPGATHERQD", 0x93 | 0x91) => (64, 32),
        ("VGATHERQPD" | "VPGATHERQQ", 0x93 | 0x91) => (64, 64),
        _ => return None,
    };
    if e.map != 2
        || e.mandatory != 1
        || e.kind == 0
        || p.zeroing
        || p.broadcast
        || ops.len() != if e.kind == 1 { 3 } else { 2 }
    {
        return None;
    }
    let dest = ops[0];
    let mem = ops[1];
    let mut r = float_recipe(d, ip);
    if mem.kind != OperandKind::Memory {
        return None;
    }
    if mem.memory.address_size == 16 || p.sib.is_none() || mem.memory.index.is_none() {
        r.preflight_traps
            .push((TrapKind::InvalidInstruction, c(1, 1)));
        return Some(r);
    }
    let index = mem.memory.index?;
    let vl = vector_width(dest)?;
    if dest.register?.class != RegisterClass::Vector
        || mem.kind != OperandKind::Memory
        || mem.memory.size != u16::from(ew)
        || index.class != RegisterClass::Vector
    {
        return None;
    }
    let mask = if e.kind == 1 { Some(ops[2]) } else { None };
    if let Some(mask) = mask {
        if vector_width(mask)? != vl || mask.register?.class != RegisterClass::Vector {
            return None;
        }
    }
    if dest.register?.number == index.number
        || mask.is_some_and(|m| {
            m.register.unwrap().number == index.number
                || m.register.unwrap().number == dest.register.unwrap().number
        })
        || mem.memory.address_size == 16
        || p.sib.is_none()
        || (e.kind == 2 && p.mask == 0)
    {
        r.preflight_traps
            .push((TrapKind::InvalidInstruction, c(1, 1)));
        return Some(r);
    }
    let aw = mem.memory.address_size;
    if !matches!(aw, 32 | 64)
        || mem.memory.rip_relative
        || !matches!(mem.memory.scale, 1 | 2 | 4 | 8)
    {
        return None;
    }
    let count = (vl / u16::from(ew)).min(index.width / u16::from(iw));
    let active = count * u16::from(ew);
    r.read_progress = Some(ReadProgress {
        restart: c(r.flow.fallthrough.ty.width, ip),
        updates: vec![],
    });
    let mut predicates = Vec::new();
    let mask_input = if e.kind == 2 {
        Some(
            r.bind_before_reads(Expr::register(register(
                "x86.mask",
                u16::from(p.mask),
                64,
                64,
            )))
            .ok()?,
        )
    } else {
        None
    };
    for lane in 0..count {
        let selected = if let Some(mask) = mask {
            vector_read(d, mask, ip, lane * u16::from(ew) + u16::from(ew) - 1, 1)?
        } else {
            Expr::extract(mask_input.as_ref()?.clone(), lane as u8, 1)
        };
        predicates.push(r.bind_before_reads(selected).ok()?);
    }
    let mut addresses = Vec::new();
    for lane in 0..count {
        let chunk = register(
            "x86.vector64",
            u16::from(index.number) * 8 + (lane * u16::from(iw)) / 64,
            64,
            64,
        );
        let value = Expr::extract(
            Expr::register(chunk),
            ((lane * u16::from(iw)) % 64) as u8,
            iw,
        );
        let mut a = bin(
            B::Add,
            c(aw, mem.memory.displacement as u64),
            bin(
                B::Mul,
                Expr::cast(value, aw, true),
                c(aw, u64::from(mem.memory.scale)),
            ),
        );
        if let Some(base) = mem.memory.base {
            if base.width != u16::from(aw) {
                return None;
            }
            a = bin(B::Add, a, Expr::register(slice(base)?));
        }
        let mut a = Expr::cast(a, 64, false);
        let segment = mem.memory.segment.map(|v| v.number).or_else(|| {
            (p.mode != Mode::Mode64).then_some(
                if mem
                    .memory
                    .base
                    .is_some_and(|b| matches!(b.number & 7, 4 | 5))
                {
                    2
                } else {
                    3
                },
            )
        });
        if let Some(segment) = segment.filter(|n| p.mode != Mode::Mode64 || *n >= 4) {
            a = bin(
                B::Add,
                a,
                Expr::register(register("x86.segment_base", u16::from(segment), 64, 64)),
            );
        }
        addresses.push(
            r.bind_before_reads(Expr::select(
                predicates[usize::from(lane)].clone(),
                a,
                c(64, 0),
            ))
            .ok()?,
        );
    }
    if let Some(mask) = mask {
        for lane in 0..count {
            movement_progress(
                &mut r,
                0,
                vector_slice(mask, lane * u16::from(ew), ew)?,
                Expr::select(
                    predicates[usize::from(lane)].clone(),
                    c(ew, u64::MAX),
                    c(ew, 0),
                ),
                None,
            );
        }
        // VEX clears the inactive part of both architectural vector registers.
        for bit in (active..512).step_by(ew as usize) {
            let mut s = register(
                "x86.vector64",
                u16::from(mask.register?.number) * 8 + bit / 64,
                ew,
                64,
            );
            s.offset = (bit % 64) as u8;
            movement_progress(&mut r, 0, s, c(ew, 0), None);
        }
    } else {
        let bits = if count == 64 {
            u64::MAX
        } else {
            (1u64 << count) - 1
        };
        movement_progress(
            &mut r,
            0,
            register("x86.mask", u16::from(p.mask), 64, 64),
            bin(B::And, mask_input.as_ref()?.clone(), c(64, bits)),
            None,
        );
    }
    for lane in 0..count {
        let selected = predicates[usize::from(lane)].clone();
        let value = r
            .load_ordered_conditional(
                selected.clone(),
                Memory {
                    kind: Default::default(),
                    privilege: Default::default(),
                    address: Box::new(addresses[usize::from(lane)].clone()),
                    width: ew,
                    endian: Endian::Little,
                },
            )
            .ok()?;
        movement_progress(
            &mut r,
            usize::from(lane) + 1,
            vector_slice(dest, lane * u16::from(ew), ew)?,
            value,
            Some(selected),
        );
        if let Some(mask) = mask {
            movement_progress(
                &mut r,
                usize::from(lane) + 1,
                vector_slice(mask, lane * u16::from(ew), ew)?,
                c(ew, 0),
                None,
            );
        } else {
            // Reconstruct remaining mask from immutable input, never read a
            // register after a preceding publication changed it.
            let keep = if count == 64 {
                u64::MAX
            } else {
                (1u64 << count) - 1
            };
            let done = (1u64 << (lane + 1)) - 1;
            movement_progress(
                &mut r,
                usize::from(lane) + 1,
                register("x86.mask", u16::from(p.mask), 64, 64),
                bin(B::And, mask_input.as_ref()?.clone(), c(64, keep & !done)),
                None,
            );
        }
    }
    // Upper destination bits are cleared only after every selected load succeeds.
    for bit in (active..512).step_by(ew as usize) {
        let mut s = register(
            "x86.vector64",
            u16::from(dest.register?.number) * 8 + bit / 64,
            ew,
            64,
        );
        s.offset = (bit % 64) as u8;
        r.write(s, WritePolicy::Preserve, c(ew, 0));
    }
    Some(r)
}
fn vector_movement(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if e.kind > 2
        || p.lock
        || p.broadcast
        || (p.zeroing && p.mask == 0)
        || p.repeat
            != match e.mandatory {
                2 => 2,
                3 => 4,
                _ => 0,
            }
    {
        return None;
    }
    let name = e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    if name.starts_with("GATHER") || name.starts_with("PGATHER") {
        return gathered_movement(d, ip, &ops);
    }
    let mut r = float_recipe(d, ip);
    if matches!(name, "ZEROALL" | "ZEROUPPER")
        && e.kind == 1
        && e.map == 1
        && e.opcode == 0x77
        && e.mandatory == 0
    {
        for number in 0..if p.mode == Mode::Mode64 { 16 } else { 8 } {
            for chunk in if name == "ZEROALL" { 0 } else { 2 }..8 {
                r.write(
                    register("x86.vector64", number * 8 + chunk, 64, 64),
                    WritePolicy::ZeroUpper,
                    c(64, 0),
                );
            }
        }
        return Some(r);
    }
    // Implicit byte stores name their address register and segment in the
    // decoded memory operand. No inactive byte evaluates an address.
    if matches!(
        (name, e.map, e.opcode, e.mandatory),
        ("MASKMOVQ", 1, 0xf7, 0) | ("MASKMOVDQU", 1, 0xf7, 1)
    ) && e.kind <= 2
    {
        let explicit: Vec<_> = ops
            .iter()
            .copied()
            .filter(|o| o.kind == OperandKind::Register)
            .collect();
        if explicit.len() != 2 {
            return None;
        }
        let vl = vector_width(explicit[0])?;
        if vl != vector_width(explicit[1])? || !matches!(vl, 64 | 128) {
            return None;
        }
        let memory = d
            .operands()
            .iter()
            .find(|o| o.kind == OperandKind::Memory)?;
        for lane in 0..vl / 8 {
            let selected = r.bind(vector_read(d, explicit[1], ip, lane * 8 + 7, 1)?);
            let value = r.bind(Expr::select(
                selected.clone(), vector_read(d, explicit[0], ip, lane * 8, 8)?, c(8, 0),
            ));
            r.effects.push(Effect::StoreConditional {
                condition: selected,
                memory: Memory {
                    kind: Default::default(),
                    privilege: Default::default(),
                    address: Box::new(add_address_offset(
                        address(d, memory, ip, true)?,
                        u64::from(lane),
                    )),
                    width: 8,
                    endian: Endian::Little,
                },
                value,
            });
        }
        return Some(r);
    }
    // Legacy variable blends expose XMM0 as an audited implicit selector.
    if matches!(name, "BLENDVPS" | "BLENDVPD") && e.kind == 0 {
        let hidden: Vec<_> = crate::OPERANDS
            [e.operand_start as usize..e.operand_start as usize + e.operand_len as usize]
            .iter()
            .filter(|s| s.flags & 4 != 0)
            .collect();
        if hidden.len() != 1
            || hidden[0].kind != "VREG"
            || hidden[0].value != "XMM0"
            || hidden[0].flags != 5
        {
            return None;
        }
    } else if !movement_hidden_registers(d) {
        return None;
    }
    if ops.len() == 2 {
        let (dst, src) = (ops[0], ops[1]);
        let ew: u8 = match (name, e.map, e.opcode) {
            ("PMOVMSKB", 1, 0xd7) => 8,
            ("MOVMSKPS", 1, 0x50) => 32,
            ("MOVMSKPD", 1, 0x50) => 64,
            _ => 0,
        };
        if ew != 0 && p.mask == 0 {
            let vl = vector_width(src)?;
            let w = width(dst)?;
            let mut value = c(w, 0);
            for lane in 0..vl / u16::from(ew) {
                value = bin(
                    B::Or,
                    value,
                    bin(
                        B::Shl,
                        Expr::cast(
                            vector_read(d, src, ip, (lane + 1) * u16::from(ew) - 1, 1)?,
                            w,
                            false,
                        ),
                        c(w, u64::from(lane)),
                    ),
                );
            }
            let value = r.bind(value);
            write(&mut r, d, dst, ip, value)?;
            return Some(r);
        }
        // MOVD/Q also cover MMX, mixed MMX/XMM transfers and scalar stores.
        let ew = match (name, e.map, e.opcode, e.mandatory) {
            ("MOVD", 1, 0x6e | 0x7e, 0 | 1) => 32,
            ("MOVQ", 1, 0x6e | 0x7e, 0 | 1)
            | ("MOVQ", 1, 0x6f | 0x7f, 0)
            | ("MOVQ", 1, 0x7e, 2)
            | ("MOVQ", 1, 0xd6, 1) => 64,
            ("MOVQ2DQ", 1, 0xd6, 2) | ("MOVDQ2Q", 1, 0xd6, 3) | ("MOVNTSD", 1, 0x2b, 3) => 64,
            ("MOVNTSS", 1, 0x2b, 2) => 32,
            _ => 0,
        };
        if ew != 0 && p.mask == 0 {
            let value = r.bind(movement_scalar(d, src, ip, ew)?);
            movement_store(&mut r, d, dst, ip, ew, value, None)?;
            if let Some(v) = dst
                .register
                .filter(|v| matches!(v.class, RegisterClass::Vector | RegisterClass::Mmx))
            {
                for bit in (u16::from(ew)..v.width).step_by(ew as usize) {
                    vector_write(&mut r, d, dst, ip, bit, ew, c(ew, 0))?;
                }
                movement_upper(&mut r, d, dst, v.width)?;
            }
            return Some(r);
        }
        let whole = matches!(
            (name, e.map, e.opcode, e.mandatory),
            ("MOVAPS", 1, 0x28 | 0x29, 0)
                | ("MOVAPD", 1, 0x28 | 0x29, 1)
                | ("MOVUPS", 1, 0x10 | 0x11, 0)
                | ("MOVUPD", 1, 0x10 | 0x11, 1)
                | ("LDDQU", 1, 0xf0, 3)
                | ("MOVNTDQA", 2, 0x2a, 1)
                | ("MOVNTPS", 1, 0x2b, 0)
                | ("MOVNTPD", 1, 0x2b, 1)
                | ("MOVNTDQ", 1, 0xe7, 1)
                | ("MOVNTQ", 1, 0xe7, 0)
                | ("MOVNTI", 1, 0xc3, 0)
        );
        if whole {
            if name == "MOVNTI" {
                let w = width(dst)?;
                let value = r.bind(read(d, src, ip, w)?);
                write(&mut r, d, dst, ip, value)?;
                return Some(r);
            }
            let vl = vector_width(dst)?;
            if vl != vector_width(src)? {
                return None;
            }
            let ew = if name.ends_with("PS") { 32 } else { 64 };
            let aligned = matches!(
                name,
                "MOVAPS" | "MOVAPD" | "MOVNTDQA" | "MOVNTPS" | "MOVNTPD" | "MOVNTDQ"
            );
            let alignment = if aligned {
                if let Some(mem) = ops.iter().find(|o| o.kind == OperandKind::Memory) {
                    let a = bin(
                        B::Eq,
                        bin(
                            B::And,
                            address(d, mem, ip, true)?,
                            c(64, u64::from(vl / 8 - 1)),
                        ),
                        c(64, 0),
                    );
                    r.preflight_traps
                        .push((TrapKind::Protection, inv(a.clone())));
                    a
                } else {
                    c(1, 1)
                }
            } else {
                c(1, 1)
            };
            let input = specialized_source_access(&mut r, d, src, ip, vl, ew, true)?;
            if dst.kind == OperandKind::Memory {
                if p.zeroing {
                    return None;
                }
                if p.mask == 0 && vl == 64 {
                    movement_store(&mut r, d, dst, ip, 64, input[0].clone(), None)?;
                } else if p.mask == 0 {
                    r.store_wide(
                        WideMemory {
                            kind: Default::default(),
                            privilege: Default::default(),
                            address: Box::new(address(d, dst, ip, true)?),
                            width: vl,
                            endian: Endian::Little,
                        },
                        input,
                    );
                } else {
                    for lane in 0..vl / u16::from(ew) {
                        r.effects.push(Effect::StoreConditional {
                            condition: bin(B::And, alignment.clone(), fp_active(d, lane)),
                            memory: Memory {
                                kind: Default::default(),
                                privilege: Default::default(),
                                address: Box::new(add_address_offset(
                                    address(d, dst, ip, true)?,
                                    u64::from(lane) * u64::from(ew) / 8,
                                )),
                                width: ew,
                                endian: Endian::Little,
                            },
                            value: specialized_element(&input, usize::from(lane), ew),
                        });
                    }
                }
            } else {
                specialized_output(
                    &mut r,
                    d,
                    dst,
                    ip,
                    ew,
                    (0..vl / u16::from(ew))
                        .map(|i| specialized_element(&input, usize::from(i), ew))
                        .collect(),
                )?;
            }
            return Some(r);
        }
    }
    // Scalar moves preserve the legacy destination merge, copy the VEX first
    // source, or clear the remainder of the low 128 bits on a memory load.
    if matches!(
        (name, e.map, e.opcode, e.mandatory),
        ("MOVSS", 1, 0x10 | 0x11, 2) | ("MOVSD", 1, 0x10 | 0x11, 3)
    ) && matches!(ops.len(), 2 | 3)
    {
        let ew = if name == "MOVSS" { 32 } else { 64 };
        let dst = ops[0];
        let src = *ops.last()?;
        let value = movement_scalar(d, src, ip, ew)?;
        let active = fp_active(d, 0);
        let value = r.bind(Expr::select(active.clone(), value, c(ew, 0)));
        if dst.kind == OperandKind::Memory {
            movement_store(&mut r, d, dst, ip, ew, value, Some(active))?;
            return Some(r);
        }
        let value = if p.mask != 0 {
            Expr::select(
                active,
                value,
                if p.zeroing {
                    c(ew, 0)
                } else {
                    vector_read(d, dst, ip, 0, ew)?
                },
            )
        } else {
            value
        };
        vector_write(&mut r, d, dst, ip, 0, ew, value)?;
        for bit in (u16::from(ew)..128).step_by(ew as usize) {
            let v = if ops.len() == 3 {
                vector_read(d, ops[1], ip, bit, ew)?
            } else if src.kind == OperandKind::Memory {
                c(ew, 0)
            } else {
                vector_read(d, dst, ip, bit, ew)?
            };
            let v = r.bind(v);
            vector_write(&mut r, d, dst, ip, bit, ew, v)?;
        }
        movement_upper(&mut r, d, dst, 128)?;
        return Some(r);
    }
    if matches!(
        (name, e.map, e.opcode, e.mandatory),
        ("MOVLPS" | "MOVHLPS", 1, 0x12 | 0x13, 0)
            | ("MOVLPD", 1, 0x12 | 0x13, 1)
            | ("MOVHPS" | "MOVLHPS", 1, 0x16 | 0x17, 0)
            | ("MOVHPD", 1, 0x16 | 0x17, 1)
    ) && e.kind <= 2
        && matches!(ops.len(), 2 | 3)
    {
        let dst = ops[0];
        let src = *ops.last()?;
        let high = matches!(name, "MOVHPS" | "MOVHPD" | "MOVLHPS");
        let dest_bit = if high { 64 } else { 0 };
        let src_bit = if name == "MOVHLPS" { 64 } else { 0 };
        if dst.kind == OperandKind::Memory {
            let v = r.bind(vector_read(d, src, ip, dest_bit, 64)?);
            movement_store(&mut r, d, dst, ip, 64, v, None)?;
        } else {
            let v = r.bind(vector_read(d, src, ip, src_bit, 64)?);
            let merge = r.bind(vector_read(
                d,
                if ops.len() == 3 { ops[1] } else { dst },
                ip,
                64 - dest_bit,
                64,
            )?);
            vector_write(&mut r, d, dst, ip, dest_bit, 64, v)?;
            vector_write(&mut r, d, dst, ip, 64 - dest_bit, 64, merge)?;
            movement_upper(&mut r, d, dst, 128)?;
        }
        return Some(r);
    }
    // Duplicates and broadcasts share one load for each selected source
    // element, even when it supplies several masked destination lanes.
    let duplicate = match (name, e.map, e.opcode, e.mandatory) {
        ("MOVDDUP", 1, 0x12, 3) => Some(64),
        ("MOVSHDUP", 1, 0x16, 2) | ("MOVSLDUP", 1, 0x12, 2) => Some(32),
        _ => None,
    };
    let broadcast = match (name, e.map, e.opcode, e.mandatory) {
        ("BROADCASTSS", 2, 0x18, 1) => 32,
        ("BROADCASTSD", 2, 0x19, 1) => 64,
        ("BROADCASTF128", 2, 0x1a, 1) | ("BROADCASTI128", 2, 0x5a, 1) => 128,
        _ => 0,
    };
    if ops.len() == 2 && (duplicate.is_some() || broadcast != 0) {
        let dst = ops[0];
        let src = ops[1];
        let vl = vector_width(dst)?;
        let ew = duplicate.unwrap_or(if broadcast == 128 { 64 } else { broadcast });
        let mut mapping = Vec::new();
        for lane in 0..vl / u16::from(ew) {
            mapping.push(if duplicate.is_some() {
                if name == "MOVSHDUP" {
                    lane / 2 * 2 + 1
                } else {
                    lane / 2 * 2
                }
            } else if broadcast == 128 {
                lane % 2
            } else {
                0
            });
        }
        let bits = if duplicate.is_some() {
            if name == "MOVDDUP" && vl == 128 {
                64
            } else {
                vl
            }
        } else {
            u16::from(broadcast)
        };
        let input = if p.mask != 0 {
            let mut elements = Vec::new();
            for source in 0..bits / u16::from(ew) {
                let mut selected = c(1, 0);
                for (lane, &index) in mapping.iter().enumerate() {
                    if index == source {
                        selected = bin(B::Or, selected, fp_active(d, lane as u16));
                    }
                }
                let v = if src.kind == OperandKind::Memory {
                    r
                    .load_ordered_conditional(
                        selected.clone(),
                        Memory {
                            kind: Default::default(),
                            privilege: Default::default(),
                            address: Box::new(add_address_offset(
                                address(d, src, ip, true)?,
                                u64::from(source) * u64::from(ew) / 8,
                            )),
                            width: ew,
                            endian: Endian::Little,
                        },
                    )
                    .ok()?
                } else {
                    vector_read(d, src, ip, source * u16::from(ew), ew)?
                };
                elements.push(r.bind(Expr::select(selected, v, c(ew, 0))));
            }
            elements
        } else if src.kind == OperandKind::Memory && bits > 64 {
            let input = captured_memory_chunks(&mut r, d, src, ip, bits, ew, false)?;
            (0..bits / u16::from(ew))
                .map(|i| specialized_element(&input, usize::from(i), ew))
                .collect()
        } else {
            (0..bits / u16::from(ew))
                .map(|i| vector_read(d, src, ip, i * u16::from(ew), ew).map(|v| r.bind(v)))
                .collect::<Option<Vec<_>>>()?
        };
        let output = mapping
            .into_iter()
            .map(|i| input[usize::from(i)].clone())
            .collect();
        specialized_output(&mut r, d, dst, ip, ew, output)?;
        return Some(r);
    }
    if matches!(
        (name, e.map, e.opcode, e.mandatory),
        ("MASKMOVPS", 2, 0x2c | 0x2e, 1)
            | ("MASKMOVPD", 2, 0x2d | 0x2f, 1)
            | ("PMASKMOVD" | "PMASKMOVQ", 2, 0x8c | 0x8e, 1)
    ) && e.kind == 1
        && ops.len() == 3
    {
        let ew = if name.ends_with("PD") || name.ends_with('Q') {
            64
        } else {
            32
        };
        let load = ops[0].kind == OperandKind::Register;
        let memory = if load { ops[2] } else { ops[0] };
        let data = if load { ops[0] } else { ops[2] };
        let mask = ops[1];
        let vl = vector_width(data)?;
        let predicates = (0..vl / u16::from(ew))
            .map(|lane| {
                let selected = vector_read(d, mask, ip, (lane + 1) * u16::from(ew) - 1, 1)?;
                r.bind_before_reads(selected).ok()
            })
            .collect::<Option<Vec<_>>>()?;
        for lane in 0..vl / u16::from(ew) {
            let selected = predicates[usize::from(lane)].clone();
            let mem = Memory {
                kind: Default::default(),
                privilege: Default::default(),
                address: Box::new(add_address_offset(
                    address(d, memory, ip, true)?,
                    u64::from(lane) * u64::from(ew) / 8,
                )),
                width: ew,
                endian: Endian::Little,
            };
            if load {
                let v = r.load_ordered_conditional(selected.clone(), mem).ok()?;
                let v = r.bind(Expr::select(selected, v, c(ew, 0)));
                vector_write(&mut r, d, data, ip, lane * u16::from(ew), ew, v)?;
            } else {
                let value = r.bind(vector_read(d, data, ip, lane * u16::from(ew), ew)?);
                r.effects.push(Effect::StoreConditional {
                    condition: selected,
                    memory: mem,
                    value,
                });
            }
        }
        if load {
            movement_upper(&mut r, d, data, vl)?;
        }
        return Some(r);
    }
    if matches!(
        (name, e.map, e.opcode, e.mandatory),
        ("TESTPS", 2, 0x0e, 1) | ("TESTPD", 2, 0x0f, 1)
    ) && e.kind == 1
        && ops.len() == 2
    {
        let ew: u8 = if name == "TESTPS" { 32 } else { 64 };
        let vl = vector_width(ops[0])?;
        let first = specialized_source(&mut r, d, ops[0], ip, vl)?;
        let second = specialized_source(&mut r, d, ops[1], ip, vl)?;
        let mut and = c(1, 0);
        let mut andnot = c(1, 0);
        for lane in 0..vl / u16::from(ew) {
            let a = Expr::extract(
                specialized_element(&first, usize::from(lane), ew),
                ew - 1,
                1,
            );
            let b = Expr::extract(
                specialized_element(&second, usize::from(lane), ew),
                ew - 1,
                1,
            );
            and = bin(B::Or, and, bin(B::And, a.clone(), b.clone()));
            andnot = bin(B::Or, andnot, bin(B::And, inv(a), b));
        }
        setflag(&mut r, 3, inv(and));
        setflag(&mut r, 0, inv(andnot));
        for i in [1, 2, 4, 5] {
            setflag(&mut r, i, c(1, 0));
        }
        return Some(r);
    }
    // Insert/extract scalar lanes, including the original MMX PINSRW/PEXTRW.
    let insert = match (name, e.map, e.opcode) {
        ("PINSRB", 3, 0x20) => 8,
        ("PINSRW", 1, 0xc4) => 16,
        ("PINSRD", 3, 0x22) => 32,
        ("PINSRQ", 3, 0x22) => 64,
        _ => 0,
    };
    let extract = match (name, e.map, e.opcode) {
        ("PEXTRB", 3, 0x14) => 8,
        ("PEXTRW", 1, 0xc5) | ("PEXTRW", 3, 0x15) => 16,
        ("PEXTRD", 3, 0x16) => 32,
        ("PEXTRQ", 3, 0x16) => 64,
        ("EXTRACTPS", 3, 0x17) => 32,
        _ => 0,
    };
    if insert != 0 && e.kind <= 2 && ops.len() == if e.kind == 0 { 3 } else { 4 } {
        let dst = ops[0];
        let src = if e.kind == 0 { dst } else { ops[1] };
        let vl = vector_width(dst)?;
        let imm = *ops.last()?;
        if imm.kind != OperandKind::Immediate {
            return None;
        }
        let selected = imm.immediate.value % u64::from(vl / u16::from(insert));
        let scalar = r.bind(read(d, ops[ops.len() - 2], ip, insert)?);
        for lane in 0..vl / u16::from(insert) {
            let v = if u64::from(lane) == selected {
                scalar.clone()
            } else {
                vector_read(d, src, ip, lane * u16::from(insert), insert)?
            };
            let v = r.bind(v);
            vector_write(&mut r, d, dst, ip, lane * u16::from(insert), insert, v)?;
        }
        movement_upper(&mut r, d, dst, vl)?;
        return Some(r);
    }
    if extract != 0 && e.kind <= 2 && ops.len() == 3 && ops[2].kind == OperandKind::Immediate {
        let vl = vector_width(ops[1])?;
        let lane = ops[2].immediate.value % u64::from(vl / u16::from(extract));
        let w = width(ops[0])?;
        if ops[0].kind == OperandKind::Memory && w != extract {
            return None;
        }
        let v = r.bind(Expr::cast(
            vector_read(d, ops[1], ip, lane as u16 * u16::from(extract), extract)?,
            w,
            false,
        ));
        write(&mut r, d, ops[0], ip, v)?;
        return Some(r);
    }
    if name == "INSERTPS"
        && e.map == 3
        && e.opcode == 0x21
        && e.mandatory == 1
        && e.kind <= 2
        && ops.len() == if e.kind == 0 { 3 } else { 4 }
    {
        let dst = ops[0];
        let first = if e.kind == 0 { dst } else { ops[1] };
        let src = ops[ops.len() - 2];
        let imm = ops.last()?.immediate.value as u8;
        let selected = if src.kind == OperandKind::Memory {
            0
        } else {
            u16::from(imm >> 6)
        };
        let value = r.bind(vector_read(d, src, ip, selected * 32, 32)?);
        for lane in 0..4 {
            let v = if imm & (1 << lane) != 0 {
                c(32, 0)
            } else if lane == (imm >> 4) & 3 {
                value.clone()
            } else {
                vector_read(d, first, ip, u16::from(lane) * 32, 32)?
            };
            let v = r.bind(v);
            vector_write(&mut r, d, dst, ip, u16::from(lane) * 32, 32, v)?;
        }
        movement_upper(&mut r, d, dst, 128)?;
        return Some(r);
    }
    if matches!(
        name,
        "INSERTF128" | "INSERTI128" | "EXTRACTF128" | "EXTRACTI128"
    ) && e.kind == 1
        && e.map == 3
        && e.mandatory == 1
        && e.opcode
            == match name {
                "INSERTF128" => 0x18,
                "INSERTI128" => 0x38,
                "EXTRACTF128" => 0x19,
                _ => 0x39,
            }
    {
        let insert = name.starts_with("INSERT");
        if ops.len() != if insert { 4 } else { 3 } {
            return None;
        }
        let half = (ops.last()?.immediate.value & 1) as u16;
        if insert {
            let first = specialized_source(&mut r, d, ops[1], ip, 256)?;
            let second = specialized_source(&mut r, d, ops[2], ip, 128)?;
            for bit in (0..256).step_by(64) {
                let v = if bit / 128 == half {
                    second[usize::from((bit % 128) / 64)].clone()
                } else {
                    first[usize::from(bit / 64)].clone()
                };
                vector_write(&mut r, d, ops[0], ip, bit, 64, v)?;
            }
            movement_upper(&mut r, d, ops[0], 256)?;
        } else {
            let input = (0..2)
                .map(|i| vector_read(d, ops[1], ip, half * 128 + i * 64, 64).map(|v| r.bind(v)))
                .collect::<Option<Vec<_>>>()?;
            if ops[0].kind == OperandKind::Memory {
                r.store_wide(
                    WideMemory {
                        kind: Default::default(),
                        privilege: Default::default(),
                        address: Box::new(address(d, ops[0], ip, true)?),
                        width: 128,
                        endian: Endian::Little,
                    },
                    input,
                );
            } else {
                specialized_output(&mut r, d, ops[0], ip, 64, input)?;
            }
        }
        return Some(r);
    }
    let blend = match (name, e.map, e.opcode, e.mandatory) {
        ("BLENDPS", 3, 0x0c, 1) => Some((32, false)),
        ("BLENDPD", 3, 0x0d, 1) => Some((64, false)),
        ("BLENDVPS", 2, 0x14, 1) | ("BLENDVPS", 3, 0x4a, 1) => Some((32, true)),
        ("BLENDVPD", 2, 0x15, 1) | ("BLENDVPD", 3, 0x4b, 1) => Some((64, true)),
        _ => None,
    };
    if let Some((ew, variable)) = blend {
        if e.kind > 1 {
            return None;
        }
        let dst = ops[0];
        let first = if e.kind == 0 { dst } else { ops[1] };
        let second = ops[if e.kind == 0 { 1 } else { 2 }];
        let vl = vector_width(dst)?;
        let snapshots = capture_memory_sources(&mut r, d, &[first, second], ip, vl, ew, false)?;
        let mut output = Vec::new();
        for lane in 0..vl / u16::from(ew) {
            let selected = if variable {
                if e.kind == 0 {
                    let mut s = register("x86.vector64", lane * u16::from(ew) / 64, 1, 64);
                    s.offset = ((lane * u16::from(ew) + u16::from(ew) - 1) % 64) as u8;
                    Expr::register(s)
                } else {
                    vector_read(d, ops[3], ip, (lane + 1) * u16::from(ew) - 1, 1)?
                }
            } else {
                c(1, (ops.last()?.immediate.value >> (lane % 8)) & 1)
            };
            output.push(Expr::select(
                selected,
                snapshot_vector_read(d, second, ip, lane * u16::from(ew), ew, &snapshots)?,
                snapshot_vector_read(d, first, ip, lane * u16::from(ew), ew, &snapshots)?,
            ));
        }
        specialized_output(&mut r, d, dst, ip, ew, output)?;
        return Some(r);
    }
    None
}

fn integer_broadcast(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let name = e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    if e.kind > 2
        || p.lock
        || p.broadcast
        || (p.zeroing && p.mask == 0)
        || p.repeat
            != match e.mandatory {
                2 => 2,
                3 => 4,
                _ => 0,
            }
        || !movement_hidden_registers(d)
    {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    let mut r = float_recipe(d, ip);
    let broadcast = match (name, e.map, e.opcode) {
        ("PBROADCASTB", 2, 0x78 | 0x7a) => 8,
        ("PBROADCASTW", 2, 0x79 | 0x7b) => 16,
        ("PBROADCASTD", 2, 0x58 | 0x7c) => 32,
        ("PBROADCASTQ", 2, 0x59 | 0x7c) => 64,
        _ => 0,
    };
    if broadcast != 0 && e.kind != 0 && e.mandatory == 1 && ops.len() == 2 {
        let vl = vector_width(ops[0])?;
        let source = if ops[1].kind == OperandKind::Register
            && ops[1].register?.class == RegisterClass::Vector
        {
            vector_read(d, ops[1], ip, 0, broadcast)?
        } else {
            read(d, ops[1], ip, broadcast)?
        };
        let source = r.bind(Expr::select(
            vector_mask_any(d, usize::from(vl / u16::from(broadcast))),
            source,
            c(broadcast, 0),
        ));
        for lane in 0..vl / u16::from(broadcast) {
            let bit = lane * u16::from(broadcast);
            let mut value = source.clone();
            if p.mask != 0 {
                let active = Expr::extract(
                    Expr::register(register("x86.mask", u16::from(p.mask), 64, 64)),
                    lane as u8,
                    1,
                );
                value = Expr::select(
                    active,
                    value,
                    if p.zeroing {
                        c(broadcast, 0)
                    } else {
                        vector_read(d, ops[0], ip, bit, broadcast)?
                    },
                );
            }
            let value = r.bind(value);
            vector_write(&mut r, d, ops[0], ip, bit, broadcast, value)?;
        }
        let number = ops[0].register?.number;
        for chunk in vl / 64..8 {
            r.write(
                register("x86.vector64", u16::from(number) * 8 + chunk, 64, 64),
                WritePolicy::ZeroUpper,
                c(64, 0),
            );
        }
        return Some(r);
    }
    None
}

fn arithmetic_flags(
    r: &mut Recipe,
    a: Expr,
    b: Expr,
    carry: Expr,
    value: Expr,
    sub: bool,
    preserve_cf: bool,
) {
    nzp(r, value.clone());
    if !preserve_cf {
        setflag(
            r,
            0,
            if sub {
                Expr::sub_borrow(a.clone(), b.clone(), carry)
            } else {
                Expr::add_carry(a.clone(), b.clone(), carry)
            },
        );
    }
    setflag(
        r,
        5,
        Expr::overflow(sub, a.clone(), b.clone(), value.clone()),
    );
    setflag(
        r,
        2,
        Expr::extract(bin(B::Xor, bin(B::Xor, a, b), value), 4, 1),
    );
}
fn atomic_integer(d: &Decoded, ip: u64, mut r: Recipe) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let name = e.mnemonic;
    if e.kind != 0 || p.repeat != 0 {
        return None;
    }
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
    if ops.is_empty() {
        return None;
    }
    if name == "XADD"
        && e.map == 1
        && matches!(e.opcode, 0xc0 | 0xc1)
        && !p.lock
        && ops.len() == 2
        && ops.iter().all(|o| o.kind == OperandKind::Register)
        && hidden_registers(d, &[])
    {
        let w = width(ops[0])?;
        let a = r.bind(read(d, ops[0], ip, w)?);
        let b = r.bind(read(d, ops[1], ip, w)?);
        let value = r.bind(bin(B::Add, a.clone(), b.clone()));
        arithmetic_flags(&mut r, a.clone(), b, c(1, 0), value.clone(), false, false);
        write(&mut r, d, ops[1], ip, a)?;
        write(&mut r, d, ops[0], ip, value)?;
        return Some(r);
    }
    if ops[0].kind != OperandKind::Memory {
        return None;
    }
    if name == "CMPXCHG16B"
        && p.lock
        && p.mode == Mode::Mode64
        && e.map == 1
        && e.opcode == 0xc7
        && p.reg & 7 == 1
        && ops[0].memory.size == 128
        && ops.len() == 1
        && hidden_registers(
            d,
            &[
                ("", "RDX", 35),
                ("", "RAX", 35),
                ("", "RCX", 1),
                ("", "RBX", 1),
            ],
        )
    {
        let gpr = |n| Expr::register(register("x86.gpr", n, 64, 64));
        let result = r.atomic(AtomicOperation {
            memory: Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address(d, ops[0], ip, true)?),
                width: 128,
                endian: Endian::Little,
            },
            ordering: MemoryOrdering::SequentiallyConsistent,
            scope: MemoryScope::System,
            kind: AtomicOperationKind::CompareExchangePair {
                expected_low: gpr(0),
                expected_high: gpr(2),
                replacement_low: gpr(3),
                replacement_high: gpr(1),
                failure_ordering: MemoryOrdering::SequentiallyConsistent,
            },
        });
        let old_low = r.bind(result.value?);
        let old_high = r.bind(result.value_high?);
        let success = r.bind(result.success?);
        setflag(&mut r, 3, success.clone());
        for (number, observed) in [(0, old_low), (2, old_high)] {
            r.write(
                register("x86.gpr", number, 64, 64),
                WritePolicy::ZeroUpper,
                Expr::select(success.clone(), gpr(number), observed),
            );
        }
        return Some(r);
    }
    let w = width(ops[0])?;
    let memory = Memory {kind: Default::default(), privilege: Default::default(),
        address: Box::new(address(d, ops[0], ip, true)?),
        width: w,
        endian: Endian::Little,
    };
    if name == "CMPXCHG8B"
        && p.lock
        && e.map == 1
        && e.opcode == 0xc7
        && p.reg & 7 == 1
        && w == 64
        && ops.len() == 1
        && hidden_registers(
            d,
            &[
                ("", "EDX", 35),
                ("", "EAX", 35),
                ("", "ECX", 1),
                ("", "EBX", 1),
            ],
        )
    {
        let pair = |high, low| {
            bin(
                B::Or,
                bin(
                    B::Shl,
                    Expr::cast(Expr::register(register("x86.gpr", high, 32, 64)), 64, false),
                    c(64, 32),
                ),
                Expr::cast(Expr::register(register("x86.gpr", low, 32, 64)), 64, false),
            )
        };
        let result = r.atomic(AtomicOperation {
            memory,
            ordering: MemoryOrdering::SequentiallyConsistent,
            scope: MemoryScope::System,
            kind: AtomicOperationKind::CompareExchange {
                expected: pair(2, 0),
                replacement: pair(1, 3),
                failure_ordering: MemoryOrdering::SequentiallyConsistent,
            },
        });
        let old = r.bind(result.value?);
        let success = r.bind(result.success?);
        setflag(&mut r, 3, success.clone());
        for (number, offset) in [(0, 0), (2, 32)] {
            let parent = Expr::register(register("x86.gpr", number, 64, 64));
            let failed = Expr::cast(Expr::extract(old.clone(), offset, 32), 64, false);
            r.write(
                register("x86.gpr", number, 64, 64),
                WritePolicy::ZeroUpper,
                Expr::select(
                    success.clone(),
                    parent.clone(),
                    if p.mode == Mode::Mode64 {
                        failed
                    } else {
                        bin(
                            B::Or,
                            bin(B::And, parent, c(64, 0xffff_ffff_0000_0000)),
                            failed,
                        )
                    },
                ),
            );
        }
        return Some(r);
    }
    if name == "CMPXCHG"
        && p.lock
        && e.map == 1
        && matches!(e.opcode, 0xb0 | 0xb1)
        && ops.len() == 2
    {
        if !if w == 8 {
            hidden_registers(d, &[("", "AL", 35)])
        } else {
            hidden_registers(d, &[("AXv", "", 35)])
        } {
            return None;
        }
        let acc = Expr::register(register("x86.gpr", 0, w, 64));
        let source = read(d, ops[1], ip, w)?;
        let result = r.atomic(AtomicOperation {
            memory,
            ordering: MemoryOrdering::SequentiallyConsistent,
            scope: MemoryScope::System,
            kind: AtomicOperationKind::CompareExchange {
                expected: acc.clone(),
                replacement: source,
                failure_ordering: MemoryOrdering::SequentiallyConsistent,
            },
        });
        let old = r.bind(result.value?);
        let success = r.bind(result.success?);
        let a = r.bind(acc);
        let difference = r.bind(bin(B::Sub, a.clone(), old.clone()));
        arithmetic_flags(&mut r, a, old.clone(), c(1, 0), difference, true, false);
        let parent = Expr::register(register("x86.gpr", 0, 64, 64));
        let failed = if w == 32 && p.mode == Mode::Mode64 {
            Expr::cast(old, 64, false)
        } else {
            bin(
                B::Or,
                bin(
                    B::And,
                    parent.clone(),
                    c(64, if w == 64 { 0 } else { !((1u64 << w) - 1) }),
                ),
                Expr::cast(old, 64, false),
            )
        };
        r.write(
            register("x86.gpr", 0, 64, 64),
            WritePolicy::ZeroUpper,
            Expr::select(success, parent, failed),
        );
        return Some(r);
    }
    if !hidden_registers(d, &[]) {
        return None;
    }
    let exchange =
        name == "XCHG" && e.map == 0 && matches!(e.opcode, 0x86 | 0x87) && ops.len() == 2;
    let xadd =
        name == "XADD" && e.map == 1 && matches!(e.opcode, 0xc0 | 0xc1) && ops.len() == 2 && p.lock;
    if exchange || xadd {
        let source = read(d, ops[1], ip, w)?;
        let result = r.atomic(AtomicOperation {
            memory,
            ordering: MemoryOrdering::SequentiallyConsistent,
            scope: MemoryScope::System,
            kind: AtomicOperationKind::ReadModifyWrite {
                operation: if exchange {
                    AtomicRmwOp::Exchange
                } else {
                    AtomicRmwOp::Add
                },
                value: source.clone(),
            },
        });
        let old = r.bind(result.value?);
        if xadd {
            let b = r.bind(source);
            let value = r.bind(bin(B::Add, old.clone(), b.clone()));
            arithmetic_flags(&mut r, old.clone(), b, c(1, 0), value, false, false);
        }
        write(&mut r, d, ops[1], ip, old)?;
        return Some(r);
    }
    if !p.lock || e.map != 0 {
        return None;
    }
    let group = match name {
        "ADD" => 0,
        "OR" => 1,
        "ADC" => 2,
        "SBB" => 3,
        "AND" => 4,
        "SUB" => 5,
        "XOR" => 6,
        _ => 255,
    };
    let base = match name {
        "ADD" => 0x00,
        "OR" => 0x08,
        "ADC" => 0x10,
        "SBB" => 0x18,
        "AND" => 0x20,
        "SUB" => 0x28,
        "XOR" => 0x30,
        _ => 0xff,
    };
    let inc = matches!((name, p.reg & 7), ("INC", 0) | ("DEC", 1))
        && matches!(e.opcode, 0xfe | 0xff)
        && ops.len() == 1;
    let binary = group != 255
        && ops.len() == 2
        && (e.opcode == base
            || e.opcode == base + 1
            || (matches!(e.opcode, 0x80 | 0x81 | 0x83) && p.reg & 7 == group));
    if !(inc || binary) {
        return None;
    }
    let sub = matches!(name, "SUB" | "SBB" | "DEC");
    let logical = matches!(name, "AND" | "OR" | "XOR");
    let b = if inc {
        c(w, 1)
    } else {
        read(d, ops[1], ip, w)?
    };
    let carry = if matches!(name, "ADC" | "SBB") {
        flag(0)
    } else {
        c(1, 0)
    };
    let rmw = match name {
        "AND" => AtomicRmwOp::And,
        "OR" => AtomicRmwOp::Or,
        "XOR" => AtomicRmwOp::Xor,
        _ => {
            if sub {
                AtomicRmwOp::Subtract
            } else {
                AtomicRmwOp::Add
            }
        }
    };
    let result = r.atomic(AtomicOperation {
        memory,
        ordering: MemoryOrdering::SequentiallyConsistent,
        scope: MemoryScope::System,
        kind: AtomicOperationKind::ReadModifyWrite {
            operation: rmw,
            value: if logical {
                b.clone()
            } else {
                bin(B::Add, b.clone(), Expr::cast(carry.clone(), w, false))
            },
        },
    });
    let old = r.bind(result.value?);
    let b = r.bind(b);
    let carry = r.bind(carry);
    let result = bin(
        match name {
            "AND" => B::And,
            "OR" => B::Or,
            "XOR" => B::Xor,
            _ => {
                if sub {
                    B::Sub
                } else {
                    B::Add
                }
            }
        },
        old.clone(),
        b.clone(),
    );
    let value = r.bind(if logical {
        result
    } else {
        bin(
            if sub { B::Sub } else { B::Add },
            result,
            Expr::cast(carry.clone(), w, false),
        )
    });
    if logical {
        nzp(&mut r, value);
        setflag(&mut r, 0, c(1, 0));
        setflag(&mut r, 5, c(1, 0));
        setflag(
            &mut r,
            2,
            Expr::undefined(1, "logical operation AF undefined"),
        );
    } else {
        arithmetic_flags(&mut r, old, b, carry, value, sub, inc);
    }
    Some(r)
}

fn segmented_pointer(d: &Decoded, pointer: Expr, segment: u16) -> Expr {
    let linear = Expr::cast(pointer, 64, false);
    if d.physical.mode != Mode::Mode64 || segment >= 4 {
        bin(
            B::Add,
            linear,
            Expr::register(register("x86.segment_base", segment, 64, 64)),
        )
    } else {
        linear
    }
}
fn string_integer(d: &Decoded, _ip: u64, mut r: Recipe) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let name = e.mnemonic;
    if e.kind != 0 || e.map != 0 || p.lock || p.repeat != 0 {
        return None;
    }
    let ops = d.operands();
    if ops.iter().any(|o| !o.implicit) {
        return None;
    }
    let group = match e.opcode {
        0xa4 | 0xa5 => "MOVS",
        0xa6 | 0xa7 => "CMPS",
        0xaa | 0xab => "STOS",
        0xac | 0xad => "LODS",
        0xae | 0xaf => "SCAS",
        0xd7 => "XLAT",
        _ => return None,
    };
    let w = if e.opcode & 1 == 0 || group == "XLAT" {
        8
    } else {
        p.operand_size
    };
    let suffix = match w {
        8 => "B",
        16 => "W",
        32 => "D",
        64 => "Q",
        _ => return None,
    };
    if name != format!("{group}{suffix}") && !(group == "XLAT" && name == "XLAT") {
        return None;
    }
    // Audit all suppressed storage; memory-base/segment semantics are fixed by
    // the exact string opcode, rather than inferred from its spelling.
    let specs = &crate::OPERANDS
        [e.operand_start as usize..e.operand_start as usize + e.operand_len as usize];
    let mems = if matches!(group, "MOVS" | "CMPS") {
        2
    } else {
        1
    };
    let regs = usize::from(matches!(group, "LODS" | "STOS" | "SCAS" | "XLAT"));
    if specs.len() != mems + regs
        || specs
            .iter()
            .any(|s| s.flags & 4 == 0 || s.flags & !7 != 0 || !matches!(s.kind, "MEM" | "REG"))
    {
        return None;
    }
    if specs.iter().filter(|s| s.kind == "MEM").count() != mems {
        return None;
    }
    let accname = match w {
        8 => "AL",
        16 => "AX",
        32 => "EAX",
        _ => "RAX",
    };
    if specs
        .iter()
        .any(|s| s.kind == "REG" && (s.value != accname || !s.symbol.is_empty()))
    {
        return None;
    }
    let aw = p.address_size;
    let override_segment = ops
        .iter()
        .filter(|o| o.kind == OperandKind::Memory)
        .find_map(|o| o.memory.segment)
        .map(|s| u16::from(s.number));
    let source_segment = override_segment.unwrap_or(3);
    let si = Expr::register(register("x86.gpr", 6, aw, 64));
    let di = Expr::register(register("x86.gpr", 7, aw, 64));
    let source_address = segmented_pointer(
        d,
        if group == "XLAT" {
            bin(
                B::Add,
                Expr::register(register("x86.gpr", 3, aw, 64)),
                Expr::cast(Expr::register(register("x86.gpr", 0, 8, 64)), aw, false),
            )
        } else {
            si.clone()
        },
        source_segment,
    );
    let destination_address = segmented_pointer(d, di.clone(), 0);
    let source = if matches!(group, "MOVS" | "CMPS" | "LODS" | "XLAT") {
        r.bind(Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
            address: Box::new(source_address),
            width: w,
            endian: Endian::Little,
        }))
    } else {
        Expr::register(register("x86.gpr", 0, w, 64))
    };
    if matches!(group, "MOVS" | "STOS") {
        r.effects.push(Effect::Store {
            memory: Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(destination_address.clone()),
                width: w,
                endian: Endian::Little,
            },
            value: source.clone(),
        });
    }
    if matches!(group, "CMPS" | "SCAS") {
        let other = r.bind(Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
            address: Box::new(destination_address),
            width: w,
            endian: Endian::Little,
        }));
        let difference = r.bind(bin(B::Sub, source.clone(), other.clone()));
        arithmetic_flags(
            &mut r,
            source.clone(),
            other,
            c(1, 0),
            difference,
            true,
            false,
        );
    }
    if matches!(group, "LODS" | "XLAT") {
        gpr_write(&mut r, d, 0, w, source);
    }
    if group != "XLAT" {
        let delta = r.bind(Expr::select(
            flag(6),
            c(aw, 0u64.wrapping_sub(u64::from(w / 8))),
            c(aw, u64::from(w / 8)),
        ));
        if matches!(group, "MOVS" | "CMPS" | "LODS") {
            gpr_write(&mut r, d, 6, aw, bin(B::Add, si, delta.clone()));
        }
        if matches!(group, "MOVS" | "CMPS" | "STOS" | "SCAS") {
            gpr_write(&mut r, d, 7, aw, bin(B::Add, di, delta));
        }
    }
    Some(r)
}
fn frame_integer(d: &Decoded, _ip: u64, mut r: Recipe) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if e.kind != 0
        || e.map != 0
        || p.mode != Mode::Mode64
        || p.operand_size == 16
        || p.lock
        || p.repeat != 0
    {
        return None;
    }
    let specs = &crate::OPERANDS
        [e.operand_start as usize..e.operand_start as usize + e.operand_len as usize];
    if specs.iter().filter(|s| s.flags & 4 != 0).any(|s| {
        s.flags & !7 != 0
            || !(s.kind == "MEM" || (s.kind == "REG" && matches!(s.symbol, "BPv" | "SPv" | "SPa")))
    }) {
        return None;
    }
    let bp = r.bind(Expr::register(register("x86.gpr", 5, 64, 64)));
    if e.mnemonic == "LEAVE" && e.opcode == 0xc9 && specs.len() == 3 {
        let value = r.bind(Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
            address: Box::new(bp.clone()),
            width: 64,
            endian: Endian::Little,
        }));
        gpr_write(&mut r, d, 4, 64, bin(B::Add, bp, c(64, 8)));
        gpr_write(&mut r, d, 5, 64, value);
        return Some(r);
    }
    if e.mnemonic == "ENTER" && e.opcode == 0xc8 && specs.len() == 5 {
        let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
        if ops.len() != 2 || ops.iter().any(|o| o.kind != OperandKind::Immediate) {
            return None;
        }
        let level = (ops[1].immediate.value & 31) as usize;
        let size = ops[0].immediate.value & 65535;
        let sp = r.bind(Expr::register(register("x86.gpr", 4, 64, 64)));
        let frame = r.bind(bin(B::Sub, sp.clone(), c(64, 8)));
        let mut writes = vec![(frame.clone(), bp.clone())];
        for i in 1..level {
            let address = r.bind(bin(B::Sub, bp.clone(), c(64, i as u64 * 8)));
            let mut value = Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address.clone()),
                width: 64,
                endian: Endian::Little,
            });
            for (prior_address, prior_value) in &writes {
                value = Expr::select(
                    bin(B::Eq, address.clone(), prior_address.clone()),
                    prior_value.clone(),
                    value,
                );
            }
            let value = r.bind(value);
            writes.push((bin(B::Sub, sp.clone(), c(64, (i as u64 + 1) * 8)), value));
        }
        if level != 0 {
            writes.push((
                bin(B::Sub, sp.clone(), c(64, (level as u64 + 1) * 8)),
                frame.clone(),
            ));
        }
        for (address, value) in writes {
            r.effects.push(Effect::Store {
                memory: Memory {kind: Default::default(), privilege: Default::default(),
                    address: Box::new(address),
                    width: 64,
                    endian: Endian::Little,
                },
                value,
            });
        }
        gpr_write(&mut r, d, 5, 64, frame);
        gpr_write(
            &mut r,
            d,
            4,
            64,
            bin(
                B::Sub,
                sp,
                c(
                    64,
                    (if level == 0 { 1 } else { level as u64 + 1 }) * 8 + size,
                ),
            ),
        );
        return Some(r);
    }
    None
}

// Intel SDM 0F C7 /6 and /7: CF indicates success; a failed draw
// writes zero. The explicit entropy model samples success before data, and
// suppresses the data draw on failure. No incoming arithmetic flag is read.
fn random_integer(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    let group = match e.mnemonic { "RDRAND" => 6, "RDSEED" => 7, _ => return None };
    if e.kind != 0 || e.map != 1 || e.opcode != 0xc7 || p.mod_bits != 3
        || p.modrm? >> 3 & 7 != group || p.lock || p.repeat != 0
        || p.mask != 0 || p.zeroing || p.broadcast || !hidden_registers(d, &[]) {
        return None;
    }
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit).collect();
    if ops.len() != 1 || ops[0].kind != OperandKind::Register { return None; }
    let dest = ops[0].register?;
    let width = u8::try_from(dest.width).ok()?;
    if dest.class != RegisterClass::Gpr || dest.high8 || !matches!(width, 16 | 32 | 64)
        || width != p.operand_size || (width == 64 && p.mode != Mode::Mode64) {
        return None;
    }
    let mut r = float_recipe(d, ip);
    let success = r.choose(1, None);
    let value = r.choose(width, Some(success.clone()));
    write(&mut r, d, ops[0], ip, Expr::select(success.clone(), value, Expr::constant(width, 0)))?;
    setflag(&mut r, 0, success);
    for index in 1..6 { setflag(&mut r, index, Expr::constant(1, 0)); }
    Some(r)
}

// Ordinary instruction advancement uses IA-32 EIP even when the code
// segment's default operand/address sizes are 16 bits. Near transfers retain
// their separately qualified effective target width.
fn float_recipe(d: &Decoded, ip: u64) -> Recipe {
    Recipe::new(
        ip.wrapping_add(d.length as u64),
        match d.physical.mode {
            Mode::Mode16 | Mode::Mode32 => 32,
            Mode::Mode64 => 64,
        },
    )
}
fn fp_prefix(d: &Decoded) -> bool {
    let e = d.encoding();
    let p = d.physical;
    e.kind <= 2
        && !p.lock
        && supported_memory_prefix(d)
        && !(p.zeroing && p.mask == 0)
        && hidden_registers(d, &[])
        && p.repeat
            == match e.mandatory {
                2 => 2,
                3 => 4,
                _ => 0,
            }
}
fn fp_rounding(immediate: u64) -> FloatRounding {
    if immediate & 4 != 0 {
        FloatRounding::Environment
    } else {
        match immediate & 3 {
            0 => FloatRounding::NearestEven,
            1 => FloatRounding::NegativeInfinity,
            2 => FloatRounding::PositiveInfinity,
            _ => FloatRounding::Zero,
        }
    }
}
fn fp_copy_scalar_upper(
    r: &mut Recipe,
    d: &Decoded,
    dest: &DecodedOperand,
    source: &DecodedOperand,
    ip: u64,
    w: u8,
) -> Option<()> {
    if d.encoding().kind != 0 {
        for bit in (u16::from(w)..128).step_by(w as usize) {
            let value = r.bind(vector_read(d, source, ip, bit, w)?);
            vector_write(r, d, dest, ip, bit, w, value)?;
        }
        clear_vector_upper(r, dest, 128)?;
    }
    Some(())
}
fn floating_fma(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    if !fp_prefix(d) || !matches!(e.kind, 1 | 2) || !matches!(e.map, 2 | 9) || e.mandatory != 1 {
        return None;
    }
    let name = e.mnemonic.strip_prefix('V')?;
    let (stem, w, scalar) = if let Some(n) = name.strip_suffix("PS") {
        (n, 32, false)
    } else if let Some(n) = name.strip_suffix("PD") {
        (n, 64, false)
    } else if let Some(n) = name.strip_suffix("SS") {
        (n, 32, true)
    } else if let Some(n) = name.strip_suffix("SD") {
        (n, 64, true)
    } else if let Some(n) = name.strip_suffix("PH") {
        (n, 16, false)
    } else if let Some(n) = name.strip_suffix("SH") {
        (n, 16, true)
    } else {
        return None;
    };
    if e.map != if w == 16 { 9 } else { 2 } || (w == 16 && e.kind != 2) { return None; }
    let (stem, order, base) = if let Some(n) = stem.strip_suffix("132") {
        (n, 132, 0x90)
    } else if let Some(n) = stem.strip_suffix("213") {
        (n, 213, 0xa0)
    } else if let Some(n) = stem.strip_suffix("231") {
        (n, 231, 0xb0)
    } else {
        return None;
    };
    let offset = match stem {
        "FMADD" => 8,
        "FMSUB" => 10,
        "FNMADD" => 12,
        "FNMSUB" => 14,
        "FMADDSUB" if !scalar => 6,
        "FMSUBADD" if !scalar => 7,
        _ => return None,
    };
    if e.opcode != base + offset + u8::from(scalar) {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    if ops.len() != 3 {
        return None;
    }
    let vl = vector_width(ops[0])?;
    if (scalar && vl != 128) || (e.kind == 1 && vl > 256) {
        return None;
    }
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(
        &mut r,
        d,
        &ops,
        ip,
        if scalar { u16::from(w) } else { vl },
        w,
        true,
    )?;
    let vector_read = |d: &Decoded, o: &DecodedOperand, ip: u64, bit: u16, w: u8| {
        snapshot_vector_read(d, o, ip, bit, w, &snapshots)
    };
    let control = fp_controls(d, &mut r);
    let mut status = control.clone();
    let mut trapped = c(1, 0);
    let mut outputs = Vec::new();
    for lane in 0..if scalar { 1 } else { vl / u16::from(w) } {
        let bit = lane * u16::from(w);
        let a = vector_read(d, ops[0], ip, bit, w)?;
        let b = vector_read(d, ops[1], ip, bit, w)?;
        let cvalue = vector_read(d, ops[2], ip, bit, w)?;
        let inputs = match order {
            132 => vec![b, a, cvalue],
            213 => vec![cvalue, b, a],
            _ => vec![a, b, cvalue],
        };
        let negate_product = matches!(stem, "FNMADD" | "FNMSUB");
        let negate_addend = match stem {
            "FMSUB" | "FNMSUB" => true,
            "FMADDSUB" => lane % 2 == 0,
            "FMSUBADD" => lane % 2 != 0,
            _ => false,
        };
        let active = fp_active(d, lane);
        let fallback = if d.physical.zeroing {
            c(w, 0)
        } else {
            vector_read(d, ops[0], ip, bit, w)?
        };
        let value = float_lane(
            &mut r,
            &control,
            &mut status,
            &mut trapped,
            FloatOperation::FusedMultiplyAdd {
                negate_product,
                negate_addend,
            },
            w,
            inputs,
            active,
            fallback,
        );
        outputs.push((bit, value));
    }
    float_finish_arch(d, &mut r, status, trapped);
    for (bit, value) in outputs {
        vector_write(&mut r, d, ops[0], ip, bit, w, value)?;
    }
    // FMA is destructive: scalar bits127:w retain the old destination.
    clear_vector_upper(&mut r, ops[0], if scalar { 128 } else { vl })?;
    Some(r)
}
fn floating_round(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    if !fp_prefix(d) || e.map != 3 || !matches!(e.mandatory, 0 | 1) {
        return None;
    }
    let name = e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    let name = if e.kind == 2 {
        name.strip_prefix("RNDSCALE")?
    } else {
        name.strip_prefix("ROUND")?
    };
    let (w, scalar, opcode) = match name {
        "PS" => (32, false, 8),
        "PD" => (64, false, 9),
        "SS" => (32, true, 10),
        "SD" => (64, true, 11),
        "PH" if e.kind == 2 => (16, false, 8),
        "SH" if e.kind == 2 => (16, true, 10),
        _ => return None,
    };
    if e.opcode != opcode || e.mandatory != if w == 16 {0} else {1} {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    let expected = if scalar && e.kind != 0 { 4 } else { 3 };
    if ops.len() != expected {
        return None;
    }
    let immediate = ops[expected - 1];
    if immediate.kind != OperandKind::Immediate {
        return None;
    }
    let imm = immediate.immediate.value;
    let source = ops[expected - 2];
    let first = if scalar && e.kind != 0 {
        ops[1]
    } else {
        ops[0]
    };
    let vl = vector_width(ops[0])?;
    if (scalar && vl != 128) || (e.kind == 0 && vl != 128) || (e.kind == 1 && vl > 256) {
        return None;
    }
    let operation = if e.kind == 2 {
        FloatOperation::RoundScale { scale: (imm >> 4 & 15) as u8, rounding: fp_rounding(imm), exact: imm & 8 == 0 }
    } else {
        FloatOperation::RoundToIntegral { rounding: fp_rounding(imm), exact: imm & 8 == 0 }
    };
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(
        &mut r,
        d,
        &ops,
        ip,
        if scalar { u16::from(w) } else { vl },
        w,
        true,
    )?;
    let vector_read = |d: &Decoded, o: &DecodedOperand, ip: u64, bit: u16, w: u8| {
        snapshot_vector_read(d, o, ip, bit, w, &snapshots)
    };
    let control = fp_controls(d, &mut r);
    let mut status = control.clone();
    let mut trapped = c(1, 0);
    let mut outputs = Vec::new();
    for lane in 0..if scalar { 1 } else { vl / u16::from(w) } {
        let bit = lane * u16::from(w);
        let input = vector_read(d, source, ip, bit, w)?;
        let fallback = if d.physical.zeroing {
            c(w, 0)
        } else {
            vector_read(d, ops[0], ip, bit, w)?
        };
        let value = float_lane(
            &mut r,
            &control,
            &mut status,
            &mut trapped,
            operation,
            w,
            vec![input],
            fp_active(d, lane),
            fallback,
        );
        outputs.push((bit, value));
    }
    float_finish_arch(d, &mut r, status, trapped);
    for (bit, value) in outputs {
        vector_write(&mut r, d, ops[0], ip, bit, w, value)?;
    }
    if scalar {
        fp_copy_scalar_upper(&mut r, d, ops[0], first, ip, w)?;
    } else if e.kind != 0 {
        clear_vector_upper(&mut r, ops[0], vl)?;
    }
    Some(r)
}
fn pack_scalar_chunks(values: &[Expr], w: u8) -> Vec<Expr> {
    let mut out = Vec::new();
    for group in values.chunks(64 / usize::from(w)) {
        let mut chunk = c(64, 0);
        for (i, v) in group.iter().enumerate() {
            chunk = bin(
                B::Or,
                chunk,
                bin(
                    B::Shl,
                    Expr::cast(v.clone(), 64, false),
                    c(64, (i * usize::from(w)) as u64),
                ),
            );
        }
        out.push(chunk);
    }
    out
}
fn floating_fp16_bits(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if !fp_prefix(d)
        || e.kind != 2
        || p.broadcast
        || p.vector_length != 128 && !matches!(e.mnemonic, "VFPCLASSPH")
    {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    if matches!(e.mnemonic, "VFPCLASSPH" | "VFPCLASSSH") {
        if e.map != 3
            || e.mandatory != 0
            || e.w != 0
            || e.opcode
                != if e.mnemonic == "VFPCLASSPH" {
                    0x66
                } else {
                    0x67
                }
            || p.zeroing
            || ops.len() != 3
            || ops[0].register?.class != RegisterClass::Mask
            || ops[2].kind != OperandKind::Immediate
        {
            return None;
        }
        // Classification is entirely bit based, including overlapping
        // negative-finite/subnormal classes. It never reads or updates MXCSR.
        let mut r = float_recipe(d, ip);
        let count = if e.mnemonic == "VFPCLASSSH" {
            1
        } else {
            p.vector_length / 16
        };
        let snapshots = capture_memory_sources(&mut r, d, &[ops[1]], ip, count * 16, 16, true)?;
        let mut mask = c(64, 0);
        for lane in 0..count {
            let active = fp_active(d, lane);
            let value = r.bind(Expr::select(
                active.clone(),
                snapshot_vector_read(d, ops[1], ip, lane * 16, 16, &snapshots)?,
                c(16, 0),
            ));
            let negative = Expr::extract(value.clone(), 15, 1);
            let exp = r.bind(Expr::extract(value.clone(), 10, 5));
            let fraction = r.bind(Expr::extract(value.clone(), 0, 10));
            let exp_ones = r.bind(bin(B::Eq, exp.clone(), c(5, 31)));
            let exp_zero = r.bind(bin(B::Eq, exp, c(5, 0)));
            let fraction_zero = r.bind(bin(B::Eq, fraction, c(10, 0)));
            let zero = r.bind(bin(B::And, exp_zero.clone(), fraction_zero.clone()));
            let nan = r.bind(bin(B::And, exp_ones.clone(), inv(fraction_zero.clone())));
            let quiet = Expr::extract(value, 9, 1);
            let classes = [
                bin(B::And, nan.clone(), quiet.clone()),
                bin(B::And, inv(negative.clone()), zero.clone()),
                bin(B::And, negative.clone(), zero.clone()),
                bin(
                    B::And,
                    inv(negative.clone()),
                    bin(B::And, exp_ones.clone(), fraction_zero.clone()),
                ),
                bin(
                    B::And,
                    negative.clone(),
                    bin(B::And, exp_ones.clone(), fraction_zero.clone()),
                ),
                bin(B::And, exp_zero, inv(fraction_zero)),
                bin(B::And, negative, bin(B::And, inv(exp_ones), inv(zero))),
                bin(B::And, nan, inv(quiet)),
            ];
            let mut selected = c(1, 0);
            for (n, class) in classes.into_iter().enumerate() {
                if ops[2].immediate.value & (1 << n) != 0 {
                    selected = bin(B::Or, selected, class);
                }
            }
            let selected = r.bind(bin(B::And, active, selected));
            mask = bin(
                B::Or,
                mask,
                bin(
                    B::Shl,
                    Expr::cast(selected, 64, false),
                    c(64, u64::from(lane)),
                ),
            );
        }
        r.write(
            register("x86.mask", u16::from(ops[0].register?.number), 64, 64),
            WritePolicy::ZeroUpper,
            mask,
        );
        return Some(r);
    }
    if e.map != 8 || !matches!(e.mnemonic, "VMOVSH" | "VMOVW") {
        return None;
    }
    let scalar = e.mnemonic == "VMOVSH";
    if e.mandatory != if scalar { 2 } else { 1 }
        || !(if scalar { matches!(e.opcode, 0x10 | 0x11) } else { matches!(e.opcode, 0x6e | 0x7e) })
        || scalar && e.w != 0
        || ops.len() != if scalar && p.mod_bits == 3 { 3 } else { 2 }
    {
        return None;
    }
    let mut r = float_recipe(d, ip);
    let source = ops[ops.len() - 1];
    let active = fp_active(d, 0);
    let value =
        if source.kind == OperandKind::Register && source.register?.class == RegisterClass::Gpr {
            read(d, source, ip, 16)?
        } else {
            vector_read(d, source, ip, 0, 16)?
        };
    if ops[0].kind == OperandKind::Memory {
        if ops[0].memory.size != 16 {
            return None;
        }
        r.store_conditional(
            active,
            Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address(d, ops[0], ip, true)?),
                width: 16,
                endian: Endian::Little,
            },
            value,
        );
        return Some(r);
    }
    if ops[0].register?.class == RegisterClass::Gpr {
        if scalar || ops[0].register?.width != 32 {
            return None;
        }
        write(&mut r, d, ops[0], ip, Expr::cast(value, 32, false))?;
        return Some(r);
    }
    let fallback = if p.zeroing || !scalar {
        c(16, 0)
    } else {
        vector_read(d, ops[0], ip, 0, 16)?
    };
    let value = r.bind(Expr::select(active, value, fallback));
    vector_write(&mut r, d, ops[0], ip, 0, 16, value)?;
    if scalar && ops.len() == 3 {
        fp_copy_scalar_upper(&mut r, d, ops[0], ops[1], ip, 16)?;
    } else {
        clear_vector_upper(&mut r, ops[0], 16)?;
    }
    Some(r)
}

fn floating_fp16_conversion(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    if !fp_prefix(d) || e.kind != 2 || !matches!(e.map, 8 | 9) {
        return None;
    }
    // (physical map, opcode, pp, source width, result width, category).
    // category0=format,1/2=signed/unsigned input,3/4=signed integer output,
    // 5/6=unsigned integer output; even output categories truncate.
    let scalar = e.mnemonic.contains("SH") || e.mnemonic.ends_with("2SH");
    let scalar_integer = matches!(
        e.mnemonic,
        "VCVTSI2SH" | "VCVTUSI2SH" | "VCVTSH2SI" | "VCVTTSH2SI" | "VCVTSH2USI" | "VCVTTSH2USI"
    );
    let (map, opcode, prefix, mut sw, mut w, category) = match e.mnemonic {
        "VCVTPH2PSX" => (9, 0x13, 1, 16, 32, 0),
        "VCVTPS2PHX" => (8, 0x1d, 1, 32, 16, 0),
        "VCVTPH2PD" => (8, 0x5a, 0, 16, 64, 0),
        "VCVTPD2PH" => (8, 0x5a, 1, 64, 16, 0),
        "VCVTDQ2PH" => (8, 0x5b, 0, 32, 16, 1),
        "VCVTQQ2PH" => (8, 0x5b, 0, 64, 16, 1),
        "VCVTUDQ2PH" => (8, 0x7a, 3, 32, 16, 2),
        "VCVTUQQ2PH" => (8, 0x7a, 3, 64, 16, 2),
        "VCVTW2PH" => (8, 0x7d, 2, 16, 16, 1),
        "VCVTUW2PH" => (8, 0x7d, 3, 16, 16, 2),
        "VCVTPH2DQ" => (8, 0x5b, 1, 16, 32, 3),
        "VCVTTPH2DQ" => (8, 0x5b, 2, 16, 32, 4),
        "VCVTPH2QQ" => (8, 0x7b, 1, 16, 64, 3),
        "VCVTTPH2QQ" => (8, 0x7a, 1, 16, 64, 4),
        "VCVTPH2UDQ" => (8, 0x79, 0, 16, 32, 5),
        "VCVTTPH2UDQ" => (8, 0x78, 0, 16, 32, 6),
        "VCVTPH2UQQ" => (8, 0x79, 1, 16, 64, 5),
        "VCVTTPH2UQQ" => (8, 0x78, 1, 16, 64, 6),
        "VCVTPH2W" => (8, 0x7d, 1, 16, 16, 3),
        "VCVTTPH2W" => (8, 0x7c, 1, 16, 16, 4),
        "VCVTPH2UW" => (8, 0x7d, 0, 16, 16, 5),
        "VCVTTPH2UW" => (8, 0x7c, 0, 16, 16, 6),
        "VCVTSD2SH" => (8, 0x5a, 3, 64, 16, 0),
        "VCVTSH2SD" => (8, 0x5a, 2, 16, 64, 0),
        "VCVTSS2SH" => (8, 0x1d, 0, 32, 16, 0),
        "VCVTSH2SS" => (9, 0x13, 0, 16, 32, 0),
        "VCVTSI2SH" => (8, 0x2a, 2, 32, 16, 1),
        "VCVTUSI2SH" => (8, 0x7b, 2, 32, 16, 2),
        "VCVTSH2SI" => (8, 0x2d, 2, 16, 32, 3),
        "VCVTTSH2SI" => (8, 0x2c, 2, 16, 32, 4),
        "VCVTSH2USI" => (8, 0x79, 2, 16, 32, 5),
        "VCVTTSH2USI" => (8, 0x78, 2, 16, 32, 6),
        _ => return None,
    };
    if e.map != map || e.opcode != opcode || e.mandatory != prefix {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    let to_integer = scalar_integer && category >= 3;
    if ops.len() != if scalar && !to_integer { 3 } else { 2 } {
        return None;
    }
    let source = ops[ops.len() - 1];
    if scalar_integer {
        if to_integer {
            w = width(ops[0])?;
        } else {
            sw = width(source)?;
        }
        if !matches!(if to_integer { w } else { sw }, 32 | 64) {
            return None;
        }
    } else if e.w
        != if matches!(
            e.mnemonic,
            "VCVTPD2PH" | "VCVTQQ2PH" | "VCVTUQQ2PH" | "VCVTSD2SH"
        ) {
            1
        } else {
            0
        }
    {
        return None;
    }
    let count = if scalar {
        1
    } else {
        d.physical.vector_length / u16::from(sw.max(w))
    };
    let outbits = count * u16::from(w);
    let inbits = count * u16::from(sw);
    if count == 0
        || (!to_integer
            && (ops[0].kind != OperandKind::Register || vector_width(ops[0])? != outbits.max(128)))
    {
        return None;
    }
    if !scalar
        && (if source.kind == OperandKind::Memory {
            source.memory.size != inbits
        } else {
            vector_width(source)? != inbits.max(128)
        })
    {
        return None;
    }
    let operation = match category {
        0 => FloatOperation::Convert {
            source_width: sw,
            round_to_odd: false,
        },
        1 | 2 => FloatOperation::FromInteger {
            source_width: sw,
            signed: category == 1,
            fractional_bits: 0,
        },
        _ => FloatOperation::ToInteger {
            source_width: sw,
            signed: category <= 4,
            fractional_bits: 0,
            rounding: if matches!(category, 4 | 6) {
                FloatRounding::Zero
            } else {
                FloatRounding::Environment
            },
        },
    };
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(&mut r, d, &[source], ip, inbits, sw, true)?;
    let control = fp_controls(d, &mut r);
    let mut status = control.clone();
    let mut trapped = c(1, 0);
    let mut outputs = Vec::new();
    for lane in 0..count {
        let input = if source.kind == OperandKind::Register
            && source.register?.class == RegisterClass::Gpr
        {
            fp_scalar_input(d, source, ip, sw)?
        } else {
            snapshot_vector_read(d, source, ip, lane * u16::from(sw), sw, &snapshots)?
        };
        let fallback = if to_integer || d.physical.zeroing {
            c(w, 0)
        } else {
            vector_read(d, ops[0], ip, lane * u16::from(w), w)?
        };
        let value = float_lane(
            &mut r,
            &control,
            &mut status,
            &mut trapped,
            operation,
            w,
            vec![input],
            fp_active(d, lane),
            fallback,
        );
        outputs.push(value);
    }
    float_finish_arch(d, &mut r, status, trapped);
    if to_integer {
        write(&mut r, d, ops[0], ip, outputs.pop()?)?;
    } else {
        for (lane, value) in outputs.into_iter().enumerate() {
            vector_write(&mut r, d, ops[0], ip, lane as u16 * u16::from(w), w, value)?;
        }
        if scalar {
            fp_copy_scalar_upper(&mut r, d, ops[0], ops[1], ip, w)?;
        } else {
            clear_vector_upper(&mut r, ops[0], outbits)?;
        }
    }
    Some(r)
}

// Floating-point logical opcodes operate on raw bits, with no FP environment
// effects. Keep EVEX PS/PD mask granularity distinct from storage chunks.
fn vector_float_logical(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if !fp_prefix(d) || e.map != 1 || (p.broadcast && p.mod_bits == 3) {
        return None;
    }
    let (element_width, opcode, operation) = match e.mnemonic {
        "ANDPS" | "VANDPS" => (32, 0x54, 0),
        "ANDPD" | "VANDPD" => (64, 0x54, 0),
        "ANDNPS" | "VANDNPS" => (32, 0x55, 1),
        "ANDNPD" | "VANDNPD" => (64, 0x55, 1),
        "ORPS" | "VORPS" => (32, 0x56, 2),
        "ORPD" | "VORPD" => (64, 0x56, 2),
        "XORPS" | "VXORPS" => (32, 0x57, 3),
        "XORPD" | "VXORPD" => (64, 0x57, 3),
        _ => return None,
    };
    let legacy = e.kind == 0;
    if legacy == e.mnemonic.starts_with('V')
        || e.opcode != opcode
        || e.mandatory != u8::from(element_width == 64)
        || (e.kind == 2 && e.w != if element_width == 64 { 1 } else { 0 })
    {
        return None;
    }
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit && o.kind != OperandKind::Mask).collect();
    if ops.len() != if legacy { 2 } else { 3 } || ops[0].kind != OperandKind::Register {
        return None;
    }
    let a = if legacy { ops[0] } else { ops[1] };
    let b = ops[ops.len() - 1];
    let vl = vector_width(ops[0])?;
    if a.kind != OperandKind::Register || vector_width(a)? != vl || vector_width(b)? != vl
        || (legacy && (vl != 128 || p.vector_length != 0 || p.mask != 0 || p.zeroing || p.broadcast))
        || (!legacy && (p.vector_length != vl || (e.kind == 1 && vl > 256)))
    {
        return None;
    }
    let mut r = float_recipe(d, ip);
    let mut access_active = c(1, 1);
    let snapshots = if legacy && b.kind == OperandKind::Memory {
        // Legacy SSE arithmetic/logical m128 operands require 16-byte alignment.
        // Suppress the original-width read on #GP; wide reads precede effects.
        let address = address(d, b, ip, true)?;
        let aligned = bin(B::Eq, bin(B::And, address.clone(), c(64, 15)), c(64, 0));
        access_active = aligned.clone();
        let chunks = r.load_wide_conditional(aligned.clone(), WideMemory {kind: Default::default(), privilege: Default::default(),
            address: Box::new(address), width: 128, endian: Endian::Little,
        });
        r.effects.push(Effect::Trap { kind: TrapKind::Protection, condition: inv(aligned.clone()) });
        vec![(b, chunks.into_iter().map(|chunk| {
            r.bind(Expr::select(aligned.clone(), chunk, c(64, 0)))
        }).collect())]
    } else {
        capture_memory_sources(&mut r, d, &[b], ip, vl, element_width, true)?
    };
    let same = a.kind == OperandKind::Register && b.kind == OperandKind::Register && a.register == b.register;
    // Legacy has no lane masks. Write complete chunks so zero idioms require
    // neither an unavailable source nor an incoming partial-write parent.
    let w = if legacy { 64 } else { element_width };
    let mut outputs = Vec::new();
    for lane in 0..vl / u16::from(w) {
        let bit = lane * u16::from(w);
        let value = if same && matches!(operation, 1 | 3) {
            c(w, 0)
        } else {
            let av = vector_read(d, a, ip, bit, w)?;
            let bv = snapshot_vector_read(d, b, ip, bit, w, &snapshots)?;
            match operation {
                0 => bin(B::And, av, bv),
                1 => bin(B::And, inv(av), bv),
                2 => bin(B::Or, av, bv),
                _ => bin(B::Xor, av, bv),
            }
        };
        outputs.push(r.bind(Expr::select(bin(B::And, access_active.clone(), fp_active(d, lane)), value, c(w, 0))));
    }
    specialized_output(&mut r, d, ops[0], ip, w, outputs)?;
    Some(r)
}

fn floating_bfloat(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    if !fp_prefix(d) || e.kind != 2 || e.map != 2 || e.w != 0 {
        return None;
    }
    let (dual, dot, mandatory, opcode) = match e.mnemonic {
        "VCVTNEPS2BF16" => (false, false, 2, 0x72),
        "VCVTNE2PS2BF16" => (true, false, 3, 0x72),
        "VDPBF16PS" => (false, true, 2, 0x52),
        _ => return None,
    };
    if e.mandatory != mandatory || e.opcode != opcode {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    if ops.len() != if dual || dot { 3 } else { 2 } || ops[0].kind != OperandKind::Register {
        return None;
    }
    let vl = d.physical.vector_length;
    if !matches!(vl, 128 | 256 | 512) {
        return None;
    }
    let outbits = if dual || dot { vl } else { vl / 2 };
    if vector_width(ops[0])? != outbits.max(128) {
        return None;
    }
    if (dual || dot) && (ops[1].kind != OperandKind::Register || vector_width(ops[1])? != vl) {
        return None;
    }
    let source = ops[ops.len() - 1];
    if vector_width(source)? != vl {
        return None;
    }
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(&mut r, d, &[source], ip, vl, 32, true)?;
    let mut outputs = Vec::new();
    let n = vl / 32;
    for lane in 0..if dual { n * 2 } else { n } {
        let w = if dot { 32 } else { 16 };
        let bit = lane * u16::from(w);
        let fallback = if d.physical.zeroing {
            c(w, 0)
        } else {
            vector_read(d, ops[0], ip, bit, w)?
        };
        let active = fp_active(d, lane);
        let value = if dot {
            let accumulator = vector_read(d, ops[0], ip, lane * 32, 32)?;
            let a = vector_read(d, ops[1], ip, lane * 32, 32)?;
            let z = snapshot_vector_read(d, source, ip, lane * 32, 32, &snapshots)?;
            crate::semantics::x86_float::bf16_dot_add(&mut r, accumulator, a, z, active, fallback)?
        } else {
            // The memory/rm source occupies the low half of a two-source
            // narrowing; the vvvv source occupies the high half.
            let input = if dual && lane >= n {
                vector_read(d, ops[1], ip, (lane - n) * 32, 32)?
            } else {
                snapshot_vector_read(d, source, ip, lane * 32, 32, &snapshots)?
            };
            let input = r.bind(Expr::select(active.clone(), input, c(32, 0)));
            let converted = crate::semantics::x86_float::bf16_from_f32(&mut r, input)?;
            r.bind(Expr::select(active, converted, fallback))
        };
        outputs.push((bit, w, value));
    }
    for (bit, w, value) in outputs {
        vector_write(&mut r, d, ops[0], ip, bit, w, value)?;
    }
    clear_vector_upper(&mut r, ops[0], outbits)?;
    Some(r)
}

fn floating_transform(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    if !fp_prefix(d) || e.kind != 2 || (d.physical.broadcast && d.physical.mod_bits == 3 && !e.suppress_exceptions) {
        return None;
    }
    let name = e.mnemonic.strip_prefix('V')?;
    let (stem, w, scalar) = if let Some(n) = name.strip_suffix("PH") { (n, 16, false) }
        else if let Some(n) = name.strip_suffix("SH") { (n, 16, true) }
        else if let Some(n) = name.strip_suffix("PS") { (n, 32, false) }
        else if let Some(n) = name.strip_suffix("SS") { (n, 32, true) }
        else if let Some(n) = name.strip_suffix("PD") { (n, 64, false) }
        else if let Some(n) = name.strip_suffix("SD") { (n, 64, true) }
        else { return None; };
    let (immediate, binary, map, prefix, opcode) = match stem {
        "GETEXP" => (false, false, if w == 16 {9} else {2}, 1, 0x42),
        "GETMANT" => (true, false, 3, if w == 16 {0} else {1}, 0x26),
        "SCALEF" => (false, true, if w == 16 {9} else {2}, 1, 0x2c),
        "REDUCE" => (true, false, 3, if w == 16 {0} else {1}, 0x56),
        "RCP" if w == 16 => (false, false, 9, 1, 0x4c),
        "RSQRT" if w == 16 => (false, false, 9, 1, 0x4e),
        _ => return None,
    };
    if e.map != map || e.mandatory != prefix || e.w != if w == 64 {1} else {0}
        || e.opcode != opcode + u8::from(scalar) { return None; }
    let ops: Vec<_> = d.operands().iter().filter(|o| !o.implicit && o.kind != OperandKind::Mask).collect();
    if ops.len() != 2 + usize::from(scalar || binary) + usize::from(immediate) || ops[0].kind != OperandKind::Register {
        return None;
    }
    let source = ops[1 + usize::from(scalar || binary)];
    let vl = vector_width(ops[0])?;
    if !matches!(vl, 128 | 256 | 512) || (scalar && (vl != 128 || ops[1].kind != OperandKind::Register)) { return None; }
    let imm = if immediate {
        let imm = ops[ops.len()-1];
        if imm.kind != OperandKind::Immediate { return None; }
        imm.immediate.value
    } else {0};
    let operation = match stem {
        "GETEXP" => FloatOperation::GetExponent,
        "GETMANT" => FloatOperation::GetMantissa { interval: (imm & 3) as u8, sign_control: (imm >> 2 & 3) as u8 },
        "SCALEF" => FloatOperation::Scale,
        "REDUCE" => FloatOperation::Reduce {scale: (imm >> 4 & 15) as u8, rounding: fp_rounding(imm), exact: imm & 8 == 0},
        "RCP" => FloatOperation::X86ReciprocalEstimate,
        "RSQRT" => FloatOperation::X86ReciprocalSquareRootEstimate,
        _ => return None,
    };
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(&mut r, d, &[source], ip, if scalar { u16::from(w) } else { vl }, w, true)?;
    let estimate = matches!(stem,"RCP"|"RSQRT");
    let control = if estimate {c(32,0)} else {fp_controls(d, &mut r)};
    let mut status = control.clone();
    let mut trapped = c(1, 0);
    let mut outputs = Vec::new();
    for lane in 0..if scalar { 1 } else { vl / u16::from(w) } {
        let bit = lane * u16::from(w);
        let value = snapshot_vector_read(d, source, ip, bit, w, &snapshots)?;
        let fallback = if d.physical.zeroing { c(w, 0) } else { vector_read(d, ops[0], ip, bit, w)? };
        let inputs = if binary {vec![vector_read(d,ops[1],ip,bit,w)?,value]} else {vec![value]};
        let active = fp_active(d,lane);
        let value = if estimate {
            // FP16 estimates have fixed behavior: no MXCSR read, sticky update
            // or trap, including SNaN/zero/negative inputs.
            let input=r.bind(Expr::select(active.clone(),inputs[0].clone(),c(w,0)));
            r.bind(Expr::select(active,Expr::float(FloatExpression {
                operation,environment:FloatEnvironment::X86Mxcsr,width:w,inputs:vec![input],
                control:Box::new(c(32,0)),status:Box::new(c(32,0)),projection:FloatProjection::Value,
            }),fallback))
        } else {float_lane(&mut r, &control, &mut status, &mut trapped, operation, w, inputs, active, fallback)};
        outputs.push((bit,value));
    }
    if !estimate {float_finish_arch(d, &mut r, status, trapped);}
    for (bit, value) in outputs { vector_write(&mut r, d, ops[0], ip, bit, w, value)?; }
    if scalar { fp_copy_scalar_upper(&mut r,d,ops[0],ops[1],ip,w)?; }
    else { clear_vector_upper(&mut r,ops[0],vl)?; }
    Some(r)
}

// Intel complex half arithmetic rounds the real-source stage before the
// imaginary-source stage. Masks apply to complex pairs, not individual halves.
fn floating_complex_half(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    if !fp_prefix(d) || e.kind != 2 || e.map != 9 || e.w != 0 || !e.no_source_dest_match {
        return None;
    }
    let (accumulate, conjugate, scalar, opcode) = match e.mnemonic {
        "VFMADDCPH" => (true, false, false, 0x56),
        "VFCMADDCPH" => (true, true, false, 0x56),
        "VFMADDCSH" => (true, false, true, 0x57),
        "VFCMADDCSH" => (true, true, true, 0x57),
        "VFMULCPH" => (false, false, false, 0xd6),
        "VFCMULCPH" => (false, true, false, 0xd6),
        "VFMULCSH" => (false, false, true, 0xd7),
        "VFCMULCSH" => (false, true, true, 0xd7),
        _ => return None,
    };
    if e.opcode != opcode || e.mandatory != if conjugate { 3 } else { 2 } {
        return None;
    }
    let ops: Vec<_> = d.operands().iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask).collect();
    if ops.len() != 3 || ops[0].kind != OperandKind::Register || ops[1].kind != OperandKind::Register {
        return None;
    }
    let vl = d.physical.vector_length;
    if !matches!(vl, 128 | 256 | 512) || (scalar && vl != 128)
        || vector_width(ops[0])? != vl || vector_width(ops[1])? != vl {
        return None;
    }
    let bits = if scalar { 32 } else { vl };
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(&mut r, d, &[ops[2]], ip, bits, 32, true)?;
    let incoming = fp_controls(d, &mut r);
    // These instructions mask all FP exceptions irrespective of MXCSR masks,
    // while sticky flags retain the incoming architectural control bits.
    let control = r.bind(bin(B::Or, incoming.clone(), c(32, 0x1f80)));
    let mut status = incoming;
    let mut trapped = c(1, 0);
    let mut stages = Vec::new();
    for pair in 0..bits / 32 {
        let bit = pair * 32;
        let active = r.bind(fp_active(d, pair));
        let mut source = |o: &DecodedOperand, offset: u16| -> Option<Expr> {
            let input = snapshot_vector_read(d, o, ip, bit + offset, 16, &snapshots)?;
            Some(r.bind(Expr::select(active.clone(), input, c(16, 0))))
        };
        let ar = source(ops[1], 0)?;
        let ai = source(ops[1], 16)?;
        let br = source(ops[2], 0)?;
        let bi = source(ops[2], 16)?;
        let mut first = Vec::new();
        for (offset, a) in [(0, ar.clone()), (16, ai.clone())] {
            let inputs = if accumulate {
                vec![vector_read(d, ops[0], ip, bit + offset, 16)?, a, br.clone()]
            } else { vec![a, br.clone()] };
            first.push(float_lane(&mut r, &control, &mut status, &mut trapped,
                if accumulate { FloatOperation::FusedMultiplyAdd { negate_product: false, negate_addend: false } }
                else { FloatOperation::Multiply },
                16, inputs, active.clone(), c(16, 0)));
        }
        stages.push((bit, active, ar, ai, bi, first));
    }
    let mut outputs = Vec::new();
    for (bit, active, ar, ai, bi, first) in stages {
        for (offset, prior, a, negative) in [(0, first[0].clone(), ai, !conjugate), (16, first[1].clone(), ar, conjugate)] {
            let fallback = if d.physical.zeroing { c(16, 0) }
                else { vector_read(d, ops[0], ip, bit + offset, 16)? };
            let value = float_lane(&mut r, &control, &mut status, &mut trapped,
                FloatOperation::FusedMultiplyAdd { negate_product: negative, negate_addend: false },
                16, vec![prior, a, bi.clone()], active.clone(), fallback);
            outputs.push((bit + offset, value));
        }
    }
    float_finish_arch(d, &mut r, status, trapped);
    for (bit, value) in outputs { vector_write(&mut r, d, ops[0], ip, bit, 16, value)?; }
    if scalar { fp_copy_scalar_upper(&mut r, d, ops[0], ops[1], ip, 32)?; }
    else { clear_vector_upper(&mut r, ops[0], vl)?; }
    Some(r)
}

fn floating_half(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if !fp_prefix(d) || !matches!(e.kind, 1 | 2) || p.broadcast || e.mandatory != 1 {
        return None;
    }
    let to_half = match (e.mnemonic, e.map, e.opcode) {
        ("VCVTPH2PS", 2, 0x13) => false,
        ("VCVTPS2PH", 3, 0x1d) => true,
        _ => return None,
    };
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    if ops.len() != if to_half { 3 } else { 2 } {
        return None;
    }
    let source = ops[1];
    let vl = vector_width(if to_half { source } else { ops[0] })?;
    if (e.kind == 1 && vl > 256) || !matches!(vl, 128 | 256 | 512) {
        return None;
    }
    let outbits = if to_half { vl / 2 } else { vl };
    let sourcebits = if to_half { vl } else { vl / 2 };
    let (sw, w) = if to_half { (32, 16) } else { (16, 32) };
    if to_half {
        if source.kind != OperandKind::Register || ops[2].kind != OperandKind::Immediate {
            return None;
        }
        if ops[0].kind == OperandKind::Memory {
            if ops[0].memory.size != outbits || p.zeroing {
                return None;
            }
        } else if vector_width(ops[0])? != outbits.max(128) {
            return None;
        }
    } else if ops[0].kind != OperandKind::Register
        || (source.kind == OperandKind::Memory && source.memory.size != sourcebits)
    {
        return None;
    }
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(&mut r, d, &[source], ip, sourcebits, sw, true)?;
    let incoming = fp_controls(d, &mut r);
    let control = if to_half && ops[2].immediate.value & 4 == 0 {
        r.bind(bin(
            B::Or,
            bin(B::And, incoming.clone(), c(32, !0x6000u64)),
            c(32, (ops[2].immediate.value & 3) << 13),
        ))
    } else {
        incoming.clone()
    };
    // The native X86 Convert contract handles half input normalization and the
    // F16C FTZ exception; status always carries the original architectural RC.
    let mut status = incoming;
    let mut trapped = c(1, 0);
    let mut outputs = Vec::new();
    for lane in 0..vl / 32 {
        let input = snapshot_vector_read(d, source, ip, lane * u16::from(sw), sw, &snapshots)?;
        let active = fp_active(d, lane);
        let fallback = if ops[0].kind == OperandKind::Memory || p.zeroing {
            c(w, 0)
        } else {
            vector_read(d, ops[0], ip, lane * u16::from(w), w)?
        };
        let value = float_lane(
            &mut r,
            &control,
            &mut status,
            &mut trapped,
            FloatOperation::Convert {
                source_width: sw,
                round_to_odd: false,
            },
            w,
            vec![input],
            active,
            fallback,
        );
        outputs.push(value);
    }
    float_finish_arch(d, &mut r, status, trapped);
    if ops[0].kind == OperandKind::Memory {
        if p.mask == 0 {
            let chunks = pack_scalar_chunks(&outputs, w);
            if outbits > 64 {
                r.store_wide(
                    WideMemory {kind: Default::default(), privilege: Default::default(),
                        address: Box::new(address(d, ops[0], ip, true)?),
                        width: outbits,
                        endian: Endian::Little,
                    },
                    chunks,
                );
            } else {
                r.effects.push(Effect::Store {
                    memory: Memory {kind: Default::default(), privilege: Default::default(),
                        address: Box::new(address(d, ops[0], ip, true)?),
                        width: outbits as u8,
                        endian: Endian::Little,
                    },
                    value: chunks[0].clone(),
                });
            }
        } else {
            for (i, value) in outputs.into_iter().enumerate() {
                r.store_conditional(
                    fp_active(d, i as u16),
                    Memory {kind: Default::default(), privilege: Default::default(),
                        address: Box::new(add_address_offset(
                            address(d, ops[0], ip, true)?,
                            (i * 2) as u64,
                        )),
                        width: 16,
                        endian: Endian::Little,
                    },
                    value,
                );
            }
        }
    } else {
        for (i, value) in outputs.into_iter().enumerate() {
            vector_write(&mut r, d, ops[0], ip, i as u16 * u16::from(w), w, value)?;
        }
        clear_vector_upper(&mut r, ops[0], outbits)?;
    }
    Some(r)
}

fn floating_conversion(d: &Decoded, ip: u64) -> Option<Recipe> {
    if let Some(r) = vector_float_logical(d, ip) { return Some(r); }
    if let Some(r) = floating_transform(d, ip) { return Some(r); }
    if let Some(r) = floating_complex_half(d, ip) { return Some(r); }
    if let Some(r) = floating_fp16_bits(d, ip) { return Some(r); }
    if let Some(r) = floating_fp16_conversion(d, ip) { return Some(r); }
    if let Some(r) = floating_bfloat(d, ip) {
        return Some(r);
    }
    let e = d.encoding();
    if !fp_prefix(d) || e.map != 1 {
        return None;
    }
    let name = e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    if ops.len() < 2 {
        return None;
    }
    let from_integer = matches!(name, "CVTSI2SS" | "CVTSI2SD" | "CVTUSI2SS" | "CVTUSI2SD");
    let to_integer = matches!(
        name,
        "CVTSS2SI"
            | "CVTSD2SI"
            | "CVTTSS2SI"
            | "CVTTSD2SI"
            | "CVTSS2USI"
            | "CVTSD2USI"
            | "CVTTSS2USI"
            | "CVTTSD2USI"
    );
    let scalar_format = matches!(name, "CVTSS2SD" | "CVTSD2SS");
    if from_integer || to_integer || scalar_format {
        let expected = if to_integer || e.kind == 0 { 2 } else { 3 };
        if ops.len() != expected {
            return None;
        }
        let source = ops[expected - 1];
        let unsigned = name.contains("USI");
        if unsigned && e.kind != 2 {
            return None;
        }
        let (source_width, result_width, prefix, opcode, operation) = if from_integer {
            let sw = width(source)?;
            let w = if name.ends_with("SS") { 32 } else { 64 };
            (
                sw,
                w,
                if w == 32 { 2 } else { 3 },
                if unsigned { 0x7b } else { 0x2a },
                FloatOperation::FromInteger {
                    source_width: sw,
                    signed: !unsigned,
                    fractional_bits: 0,
                },
            )
        } else if to_integer {
            let sw = if name.contains("SS2") { 32 } else { 64 };
            let w = width(ops[0])?;
            let truncate = name.starts_with("CVTT");
            (
                sw,
                w,
                if sw == 32 { 2 } else { 3 },
                if unsigned {
                    if truncate {
                        0x78
                    } else {
                        0x79
                    }
                } else if truncate {
                    0x2c
                } else {
                    0x2d
                },
                FloatOperation::ToInteger {
                    source_width: sw,
                    signed: !unsigned,
                    fractional_bits: 0,
                    rounding: if truncate {
                        FloatRounding::Zero
                    } else {
                        FloatRounding::Environment
                    },
                },
            )
        } else {
            let sw = if name == "CVTSS2SD" { 32 } else { 64 };
            let w = if sw == 32 { 64 } else { 32 };
            (
                sw,
                w,
                if sw == 32 { 2 } else { 3 },
                0x5a,
                FloatOperation::Convert {
                    source_width: sw,
                    round_to_odd: false,
                },
            )
        };
        if e.opcode != opcode
            || e.mandatory != prefix
            || !matches!(source_width, 32 | 64)
            || !matches!(result_width, 32 | 64)
        {
            return None;
        }
        let mut r = float_recipe(d, ip);
        let snapshots = capture_memory_sources(
            &mut r,
            d,
            &[source],
            ip,
            u16::from(source_width),
            source_width,
            true,
        )?;
        let vector_read = |d: &Decoded, o: &DecodedOperand, ip: u64, bit: u16, w: u8| {
            snapshot_vector_read(d, o, ip, bit, w, &snapshots)
        };
        let control = fp_controls(d, &mut r);
        let mut status = control.clone();
        let mut trapped = c(1, 0);
        let input = if source.kind == OperandKind::Register
            && source.register?.class == RegisterClass::Gpr
        {
            fp_scalar_input(d, source, ip, source_width)?
        } else {
            vector_read(d, source, ip, 0, source_width)?
        };
        let fallback = if to_integer || d.physical.zeroing {
            c(result_width, 0)
        } else {
            vector_read(d, ops[0], ip, 0, result_width)?
        };
        let value = float_lane(
            &mut r,
            &control,
            &mut status,
            &mut trapped,
            operation,
            result_width,
            vec![input],
            fp_active(d, 0),
            fallback,
        );
        float_finish_arch(d, &mut r, status, trapped);
        if to_integer {
            write(&mut r, d, ops[0], ip, value)?;
        } else {
            vector_write(&mut r, d, ops[0], ip, 0, result_width, value)?;
            let first = if e.kind == 0 { ops[0] } else { ops[1] };
            fp_copy_scalar_upper(&mut r, d, ops[0], first, ip, result_width)?;
        }
        return Some(r);
    }
    // (opcode,mandatory prefix,source width,result width,operation category)
    let (opcode, prefix, sw, w, category) = match name {
        "CVTPS2PD" => (0x5a, 0, 32, 64, 0),
        "CVTPD2PS" => (0x5a, 1, 64, 32, 0),
        "CVTDQ2PS" => (0x5b, 0, 32, 32, 1),
        "CVTQQ2PS" => (0x5b, 0, 64, 32, 1),
        "CVTDQ2PD" => (0xe6, 2, 32, 64, 1),
        "CVTQQ2PD" => (0xe6, 2, 64, 64, 1),
        "CVTUDQ2PS" => (0x7a, 3, 32, 32, 2),
        "CVTUQQ2PS" => (0x7a, 3, 64, 32, 2),
        "CVTUDQ2PD" => (0x7a, 2, 32, 64, 2),
        "CVTUQQ2PD" => (0x7a, 2, 64, 64, 2),
        "CVTPS2DQ" => (0x5b, 1, 32, 32, 3),
        "CVTTPS2DQ" => (0x5b, 2, 32, 32, 4),
        "CVTPD2DQ" => (0xe6, 3, 64, 32, 3),
        "CVTTPD2DQ" => (0xe6, 1, 64, 32, 4),
        "CVTPS2UDQ" => (0x79, 0, 32, 32, 5),
        "CVTTPS2UDQ" => (0x78, 0, 32, 32, 6),
        "CVTPD2UDQ" => (0x79, 0, 64, 32, 5),
        "CVTTPD2UDQ" => (0x78, 0, 64, 32, 6),
        "CVTPS2QQ" => (0x7b, 1, 32, 64, 3),
        "CVTTPS2QQ" => (0x7a, 1, 32, 64, 4),
        "CVTPD2QQ" => (0x7b, 1, 64, 64, 3),
        "CVTTPD2QQ" => (0x7a, 1, 64, 64, 4),
        "CVTPS2UQQ" => (0x79, 1, 32, 64, 5),
        "CVTTPS2UQQ" => (0x78, 1, 32, 64, 6),
        "CVTPD2UQQ" => (0x79, 1, 64, 64, 5),
        "CVTTPD2UQQ" => (0x78, 1, 64, 64, 6),
        _ => return None,
    };
    if e.opcode != opcode
        || e.mandatory != prefix
        || ops.len() != 2
        || ((name.contains("QQ") || name.contains("UDQ")) && e.kind != 2)
    {
        return None;
    }
    let source = ops[1];
    let vl = vector_width(ops[0])?;
    let source_bits = if source.kind == OperandKind::Memory {
        source.memory.size
    } else {
        vector_width(source)?
    };
    let count = if w < sw {
        source_bits / u16::from(sw)
    } else {
        vl / u16::from(w)
    };
    if count == 0 || count * u16::from(w) > vl || count * u16::from(sw) > source_bits {
        return None;
    }
    let operation = match category {
        0 => FloatOperation::Convert {
            source_width: sw,
            round_to_odd: false,
        },
        1 | 2 => FloatOperation::FromInteger {
            source_width: sw,
            signed: category == 1,
            fractional_bits: 0,
        },
        _ => FloatOperation::ToInteger {
            source_width: sw,
            signed: category <= 4,
            fractional_bits: 0,
            rounding: if matches!(category, 4 | 6) {
                FloatRounding::Zero
            } else {
                FloatRounding::Environment
            },
        },
    };
    let mut r = float_recipe(d, ip);
    let snapshots =
        capture_memory_sources(&mut r, d, &[source], ip, count * u16::from(sw), sw, true)?;
    let vector_read = |d: &Decoded, o: &DecodedOperand, ip: u64, bit: u16, w: u8| {
        snapshot_vector_read(d, o, ip, bit, w, &snapshots)
    };
    let control = fp_controls(d, &mut r);
    let mut status = control.clone();
    let mut trapped = c(1, 0);
    let mut outputs = Vec::new();
    for lane in 0..count {
        let bit = lane * u16::from(w);
        let input = vector_read(d, source, ip, lane * u16::from(sw), sw)?;
        let fallback = if d.physical.zeroing {
            c(w, 0)
        } else {
            vector_read(d, ops[0], ip, bit, w)?
        };
        let value = float_lane(
            &mut r,
            &control,
            &mut status,
            &mut trapped,
            operation,
            w,
            vec![input],
            fp_active(d, lane),
            fallback,
        );
        outputs.push((bit, value));
    }
    float_finish_arch(d, &mut r, status, trapped);
    for (bit, value) in outputs {
        vector_write(&mut r, d, ops[0], ip, bit, w, value)?;
    }
    for bit in (count * u16::from(w)..vl).step_by(w as usize) {
        vector_write(&mut r, d, ops[0], ip, bit, w, c(w, 0))?;
    }
    if e.kind != 0 {
        clear_vector_upper(&mut r, ops[0], vl)?;
    }
    Some(r)
}
fn float_predicate(relation: Expr, predicate: u8) -> Expr {
    let less = Expr::extract(relation.clone(), 3, 1);
    let equal = Expr::extract(relation.clone(), 2, 1);
    let unordered = Expr::extract(relation.clone(), 0, 1);
    let greater = bin(B::Eq, relation, c(4, 2));
    match predicate & 15 {
        0 => equal,
        1 => less,
        2 => bin(B::Or, less, equal),
        3 => unordered,
        4 => inv(equal),
        5 => inv(less),
        6 => inv(bin(B::Or, less, equal)),
        7 => inv(unordered),
        8 => bin(B::Or, equal, unordered),
        9 => bin(B::Or, less, unordered),
        10 => bin(B::Or, bin(B::Or, less, equal), unordered),
        11 => c(1, 0),
        12 => bin(B::And, inv(equal), inv(unordered)),
        13 => bin(B::Or, greater, equal),
        14 => greater,
        _ => c(1, 1),
    }
}
fn floating_compare(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    if !fp_prefix(d) || !matches!(e.map, 1 | 3 | 8) {
        return None;
    }
    let name = e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    let (w, scalar, prefix, comi) = match name {
        "COMISH" | "UCOMISH" if e.kind == 2 => (16, true, 0, true),
        "CMPPH" if e.kind == 2 => (16, false, 0, false),
        "CMPSH" if e.kind == 2 => (16, true, 2, false),
        "COMISS" | "UCOMISS" => (32, true, 0, true),
        "COMISD" | "UCOMISD" => (64, true, 1, true),
        "CMPPS" => (32, false, 0, false),
        "CMPPD" => (64, false, 1, false),
        "CMPSS" => (32, true, 2, false),
        "CMPSD" => (64, true, 3, false),
        _ => return None,
    };
    if e.map != if w == 16 { if comi {8} else {3} } else { 1 } { return None; }
    if e.mandatory != prefix
        || e.opcode
            != if comi {
                if name.starts_with('U') {
                    0x2e
                } else {
                    0x2f
                }
            } else {
                0xc2
            }
    {
        return None;
    }
    let ops: Vec<_> = d
        .operands()
        .iter()
        .filter(|o| !o.implicit && o.kind != OperandKind::Mask)
        .collect();
    let expected = if comi {
        2
    } else if e.kind == 0 {
        3
    } else {
        4
    };
    if ops.len() != expected {
        return None;
    }
    let predicate = if comi {
        0
    } else {
        let imm = ops[expected - 1];
        if imm.kind != OperandKind::Immediate {
            return None;
        }
        (imm.immediate.value & if e.kind == 0 { 7 } else { 31 }) as u8
    };
    let mask_destination = !comi && e.kind == 2;
    let first = if e.kind == 0 || comi { ops[0] } else { ops[1] };
    let second = ops[if comi { 1 } else { expected - 2 }];
    let vl = if scalar {
        128
    } else if mask_destination {
        vector_width(first)?
    } else {
        vector_width(ops[0])?
    };
    if mask_destination && (ops[0].register?.class != RegisterClass::Mask || d.physical.zeroing) {
        return None;
    }
    let signal_all_nans = if comi {
        !name.starts_with('U')
    } else {
        matches!(predicate & 15, 1 | 2 | 5 | 6 | 9 | 10 | 13 | 14) ^ (predicate & 16 != 0)
    };
    let mut r = float_recipe(d, ip);
    let snapshots = capture_memory_sources(
        &mut r,
        d,
        &[first, second],
        ip,
        if scalar { u16::from(w) } else { vl },
        w,
        true,
    )?;
    let vector_read = |d: &Decoded, o: &DecodedOperand, ip: u64, bit: u16, w: u8| {
        snapshot_vector_read(d, o, ip, bit, w, &snapshots)
    };
    let control = fp_controls(d, &mut r);
    let mut status = control.clone();
    let mut trapped = c(1, 0);
    let mut outputs = Vec::new();
    let mut mask = c(64, 0);
    for lane in 0..if scalar { 1 } else { vl / u16::from(w) } {
        let bit = lane * u16::from(w);
        let active = if comi { c(1, 1) } else { fp_active(d, lane) };
        let inputs = vec![
            vector_read(d, first, ip, bit, w)?,
            vector_read(d, second, ip, bit, w)?,
        ];
        let relation = float_lane(
            &mut r,
            &control,
            &mut status,
            &mut trapped,
            FloatOperation::Compare {
                source_width: w,
                signal_all_nans,
            },
            4,
            inputs,
            active.clone(),
            c(4, 0),
        );
        if comi {
            outputs.push((0, relation));
        } else {
            let predicate = float_predicate(relation, predicate);
            if mask_destination {
                let predicate = bin(B::And, active, predicate);
                mask = bin(
                    B::Or,
                    mask,
                    bin(
                        B::Shl,
                        Expr::cast(predicate, 64, false),
                        c(64, u64::from(lane)),
                    ),
                );
            } else {
                outputs.push((bit, Expr::cast(predicate, w, true)));
            }
        }
    }
    float_finish_arch(d, &mut r, status, trapped);
    if comi {
        let relation = outputs.pop()?.1;
        let unordered = Expr::extract(relation.clone(), 0, 1);
        setflag(
            &mut r,
            0,
            bin(
                B::Or,
                Expr::extract(relation.clone(), 3, 1),
                unordered.clone(),
            ),
        );
        setflag(&mut r, 1, unordered.clone());
        setflag(
            &mut r,
            3,
            bin(B::Or, Expr::extract(relation, 2, 1), unordered),
        );
        for index in [2, 4, 5] {
            setflag(&mut r, index, c(1, 0));
        }
    } else if mask_destination {
        r.write(
            register("x86.mask", u16::from(ops[0].register?.number), 64, 64),
            WritePolicy::ZeroUpper,
            mask,
        );
    } else {
        for (bit, value) in outputs {
            vector_write(&mut r, d, ops[0], ip, bit, w, value)?;
        }
        if scalar {
            fp_copy_scalar_upper(&mut r, d, ops[0], first, ip, w)?;
        } else if e.kind != 0 {
            clear_vector_upper(&mut r, ops[0], vl)?;
        }
    }
    Some(r)
}

// Capture a complete ordinary vector access once. Keeping the original width
// lets a consumer preserve alignment/fault behavior instead of splitting loads.
fn specialized_source(
    r: &mut Recipe,
    d: &Decoded,
    o: &DecodedOperand,
    ip: u64,
    vl: u16,
) -> Option<Vec<Expr>> {
    specialized_source_access(r, d, o, ip, vl, 64, false)
}
fn specialized_source_access(
    r: &mut Recipe,
    d: &Decoded,
    o: &DecodedOperand,
    ip: u64,
    vl: u16,
    granularity: u8,
    suppress: bool,
) -> Option<Vec<Expr>> {
    if o.kind == OperandKind::Memory {
        return captured_memory_chunks(r, d, o, ip, vl, granularity, suppress);
    }
    if vector_width(o)? != vl {
        return None;
    }
    if suppress && d.physical.mask != 0 {
        let mut chunks = Vec::new();
        for bit in (0..vl).step_by(64) {
            let mut chunk = c(64, 0);
            for offset in (0..64).step_by(usize::from(granularity)) {
                let lane = (bit + offset) / u16::from(granularity);
                let value = r.bind(Expr::select(
                    fp_active(d, lane),
                    vector_read(d, o, ip, bit + offset, granularity)?,
                    c(granularity, 0),
                ));
                chunk = bin(B::Or, chunk, bin(B::Shl,
                    Expr::cast(value, 64, false), c(64, u64::from(offset))));
            }
            chunks.push(r.bind(chunk));
        }
        return Some(chunks);
    }
    Some(
        (0..vl)
            .step_by(64)
            .map(|bit| vector_read(d, o, ip, bit, 64).map(|v| r.bind(v)))
            .collect::<Option<Vec<_>>>()?,
    )
}
fn specialized_element(chunks: &[Expr], index: usize, w: u8) -> Expr {
    let bit = index * usize::from(w);
    Expr::extract(chunks[bit / 64].clone(), (bit % 64) as u8, w)
}
fn specialized_output(
    r: &mut Recipe,
    d: &Decoded,
    o: &DecodedOperand,
    ip: u64,
    w: u8,
    outputs: Vec<Expr>,
) -> Option<()> {
    for (i, value) in outputs.into_iter().enumerate() {
        let value = r.bind(value);
        let value = if d.physical.mask != 0 {
            Expr::select(
                fp_active(d, i as u16),
                value,
                if d.physical.zeroing {
                    c(w, 0)
                } else {
                    vector_read(d, o, ip, i as u16 * u16::from(w), w)?
                },
            )
        } else {
            value
        };
        vector_write(r, d, o, ip, i as u16 * u16::from(w), w, value)?;
    }
    if d.encoding().kind != 0 {
        clear_vector_upper(r, o, vector_width(o)?)?;
    }
    Some(())
}
fn gf_product(r: &mut Recipe, a: Expr, b: Expr) -> Expr {
    let mut a = r.bind(a);
    let b = r.bind(b);
    let mut value = c(8, 0);
    for bit in 0..8 {
        value = r.bind(bin(
            B::Xor,
            value,
            Expr::select(Expr::extract(b.clone(), bit, 1), a.clone(), c(8, 0)),
        ));
        if bit != 7 {
            a = r.bind(bin(
                B::Xor,
                bin(B::Shl, a.clone(), c(8, 1)),
                Expr::select(Expr::extract(a, 7, 1), c(8, 0x1b), c(8, 0)),
            ));
        }
    }
    value
}
fn gf_square(r: &mut Recipe, a: Expr) -> Expr {
    let a = r.bind(a);
    let mut value = c(8, 0);
    for (bit, basis) in [1, 4, 16, 64, 0x1b, 0x6c, 0xab, 0x9a]
        .into_iter()
        .enumerate()
    {
        value = r.bind(bin(
            B::Xor,
            value,
            Expr::select(Expr::extract(a.clone(), bit as u8, 1), c(8, basis), c(8, 0)),
        ));
    }
    value
}
fn gf_inverse(r: &mut Recipe, x: Expr) -> Expr {
    // Addition chain for x^254 in GF(256), including inverse(0)=0.
    let x2 = gf_square(r, x.clone());
    let x3 = gf_product(r, x2.clone(), x);
    let x6 = gf_square(r, x3.clone());
    let x12 = gf_square(r, x6);
    let x15 = gf_product(r, x12.clone(), x3);
    let x30 = gf_square(r, x15);
    let x60 = gf_square(r, x30);
    let x120 = gf_square(r, x60);
    let x240 = gf_square(r, x120);
    let x252 = gf_product(r, x240, x12);
    gf_product(r, x252, x2)
}
fn rotate_left(x: Expr, n: u8) -> Expr {
    let w = x.ty.width;
    bin(B::Ror, x, c(w, u64::from(w - n)))
}
fn aes_substitute(r: &mut Recipe, x: Expr, inverse: bool) -> Expr {
    if inverse {
        let x = r.bind(x);
        let affine = bin(
            B::Xor,
            bin(B::Xor, rotate_left(x.clone(), 1), rotate_left(x.clone(), 3)),
            bin(B::Xor, rotate_left(x, 6), c(8, 5)),
        );
        gf_inverse(r, affine)
    } else {
        let x = gf_inverse(r, x);
        let mut value = x.clone();
        for n in 1..=4 {
            value = bin(B::Xor, value, rotate_left(x.clone(), n));
        }
        r.bind(bin(B::Xor, value, c(8, 0x63)))
    }
}
fn aes_mix(r: &mut Recipe, bytes: &[Expr], inverse: bool) -> Vec<Expr> {
    let coefficients = if inverse {
        [14, 11, 13, 9]
    } else {
        [2, 3, 1, 1]
    };
    let mut output = Vec::new();
    for column in 0..4 {
        for row in 0..4 {
            let mut value = c(8, 0);
            for n in 0..4 {
                let a = bytes[column * 4 + (row + n) % 4].clone();
                let term = if coefficients[n] == 1 {
                    a
                } else {
                    gf_product(r, a, c(8, coefficients[n]))
                };
                value = bin(B::Xor, value, term);
            }
            output.push(r.bind(value));
        }
    }
    output
}
fn specialized_crypto(d: &Decoded, ip: u64) -> Option<Recipe> {
    let e = d.encoding();
    let p = d.physical;
    if !fp_prefix(d) || e.mandatory != 1 {
        return None;
    }
    let name = e.mnemonic.strip_prefix('V').unwrap_or(e.mnemonic);
    let (map, opcode, immediate, unary) = match name {
        "AESENC" => (2, 0xdc, false, false),
        "AESENCLAST" => (2, 0xdd, false, false),
        "AESDEC" => (2, 0xde, false, false),
        "AESDECLAST" => (2, 0xdf, false, false),
        "AESIMC" => (2, 0xdb, false, true),
        "AESKEYGENASSIST" => (3, 0xdf, true, true),
        "PCLMULQDQ" => (3, 0x44, true, false),
        "GF2P8MULB" => (2, 0xcf, false, false),
        "GF2P8AFFINEQB" => (3, 0xce, true, false),
        "GF2P8AFFINEINVQB" => (3, 0xcf, true, false),
        _ => return None,
    };
