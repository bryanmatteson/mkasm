        for word in [1, 3] {
            let bytes: Vec<_> = (0..4)
                .map(|j| specialized_element(&a, word * 4 + j, 8))
                .collect();
            let substituted: Vec<_> = bytes
                .into_iter()
                .map(|x| aes_substitute(&mut r, x, false))
                .collect();
            output.extend(substituted.iter().cloned());
            for j in 0..4 {
                output.push(if j == 0 {
                    bin(B::Xor, substituted[1].clone(), c(8, u64::from(imm)))
                } else {
                    substituted[(j + 1) % 4].clone()
                });
            }
        }
    } else {
        for lane in 0..usize::from(vl / 128) {
            let input: Vec<_> = (0..16)
                .map(|j| specialized_element(&a, lane * 16 + j, 8))
                .collect();
            let inverse = name.starts_with("AESDEC") || name == "AESIMC";
            let bytes = if name == "AESIMC" {
                aes_mix(&mut r, &input, true)
            } else {
                let mut shifted = Vec::new();
                for col in 0..4 {
                    for row in 0..4 {
                        let column = if inverse {
                            (col + 4 - row) % 4
                        } else {
                            (col + row) % 4
                        };
                        shifted.push(aes_substitute(
                            &mut r,
                            input[column * 4 + row].clone(),
                            inverse,
                        ));
                    }
                }
                let mixed = if name.ends_with("LAST") {
                    shifted
                } else {
                    aes_mix(&mut r, &shifted, inverse)
                };
                mixed
                    .into_iter()
                    .enumerate()
                    .map(|(j, x)| r.bind(bin(B::Xor, x, specialized_element(&b, lane * 16 + j, 8))))
                    .collect()
            };
            output.extend(bytes);
        }
    }
    specialized_output(&mut r, d, ops[0], ip, 8, output)?;
    Some(r)
}
fn sha_sigma(x: Expr, kind: u8) -> Expr {
    let (a, b, c, shift) = match kind {
        0 => (7, 18, 3, true),
        1 => (17, 19, 10, true),
        2 => (2, 13, 22, false),
        _ => (6, 11, 25, false),
    };
    bin(
        B::Xor,
        bin(
            B::Xor,
            bin(B::Ror, x.clone(), c32(a)),
            bin(B::Ror, x.clone(), c32(b)),
        ),
        bin(if shift { B::Lsr } else { B::Ror }, x, c32(c)),
    )
}
fn c32(v: u64) -> Expr {
    c(32, v)
}
fn sha_choice(a: Expr, b: Expr, c: Expr) -> Expr {
    bin(B::Xor, bin(B::And, a.clone(), b), bin(B::And, inv(a), c))
}
fn sha_majority(a: Expr, b: Expr, c: Expr) -> Expr {
    bin(
        B::Xor,
        bin(B::And, a.clone(), b.clone()),
        bin(B::And, c, bin(B::Xor, a, b)),
    )
}
fn specialized_sha(d: &Decoded, ip: u64) -> Option<Recipe> {
