        let source = if scalar_memory {
            Vec::new()
        } else {
            specialized_source(&mut r, d, ops[1], ip, vl)?
        };
        if compress && ops[0].kind == OperandKind::Memory {
            if p.mask == 0 {
                r.store_wide(
                    WideMemory {kind: Default::default(), privilege: Default::default(),
                        address: Box::new(address(d, ops[0], ip, true)?),
                        width: vl,
                        endian: Endian::Little,
                    },
                    source,
                );
                return Some(r);
            }
            let mut rank = c(64, 0);
            for i in 0..n {
                let active = Expr::extract(mask.clone(), i as u8, 1);
                let offset = bin(B::Mul, rank.clone(), c(64, u64::from(w / 8)));
                let target = dynamic_address_offset(address(d, ops[0], ip, true)?, offset);
                r.store_conditional(
                    active.clone(),
                    Memory {kind: Default::default(), privilege: Default::default(),
                        address: Box::new(target),
                        width: w,
                        endian: Endian::Little,
                    },
                    specialized_element(&source, i, w),
                );
                rank = r.bind(bin(B::Add, rank, Expr::cast(active, 64, false)));
            }
            return Some(r);
        }
        let elements: Vec<_> = (0..if scalar_memory { 0 } else { n })
            .map(|i| specialized_element(&source, i, w))
            .collect();
