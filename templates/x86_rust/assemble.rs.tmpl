//! Generated Intel-syntax assembler and instruction templates.
//!
//! Everything here is derived from the same generated form table that drives
//! [`decode`], [`format_intel`] and [`encode`]: a template is resolved to the
//! candidate forms whose formatted mnemonic and operand shapes accept it, each
//! candidate is encoded through [`encode`], and every encoding is verified by
//! decoding it again and comparing the decoded operands structurally. Matching
//! decodes once and compares the same structure, so the assembler, the matcher
//! and the formatter cannot drift apart.
//!
//! Two encodings are the same instruction when their *views* are equal. A view
//! holds exactly what [`format_intel`] prints (prefix keywords, displayed
//! mnemonic, explicit operands, masking decorations), plus EVEX embedded
//! broadcast/rounding (EVEX.b), plus the effective address size whenever the
//! instruction has an explicit memory operand or an address-size-dependent
//! implicit register (rAX, rBX, rCX, rDX, rSI, rDI). Matching ignores prefixes
//! that change none of these. Non-long modes retain alternate operand-size and
//! repeat-prefix orderings used by independent assemblers. The default APIs
//! select [`DEFAULT_MODE`]; the `_in_mode` APIs select 16-, 32- or 64-bit execution.

use super::*;
use std::fmt;
use std::sync::OnceLock;

const VIEW_OPERANDS: usize = 8;
const MAX_HOLES: usize = 16;

// ---------------------------------------------------------------------------
// Operand classes and values
// ---------------------------------------------------------------------------

/// The class of one operand value bound by a template hole.
#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd, Hash)]
pub enum OperandClass {
    Gpr64,
    Gpr32,
    Gpr16,
    /// `al`..`r15b`; numbers 4..7 are `spl`, `bpl`, `sil`, `dil`.
    Gpr8,
    /// `ah`, `ch`, `dh`, `bh` as numbers 0..3.
    Gpr8High,
    Xmm,
    Ymm,
    Zmm,
    Mask,
    Mmx,
    Bound,
    Segment,
    Control,
    Debug,
    X87,
    Immediate,
    /// A branch displacement measured from the instruction's first byte.
    Relative,
    /// A memory displacement as printed by the formatter (after EVEX disp8*N scaling).
    Displacement,
    /// A SIB scale: 1, 2, 4 or 8.
    Scale,
    /// A condition-code number 0..15 (`o` .. `nle`), as in `j$cc`.
    Condition,
}

const CONDITION_NAMES: [&str; 16] = [
    "o", "no", "b", "nb", "z", "nz", "be", "nbe", "s", "ns", "p", "np", "l", "nl", "le", "nle",
];
const CONDITION_ALIASES: [(&str, u8); 14] = [
    ("c", 2), ("nae", 2), ("nc", 3), ("ae", 3), ("e", 4), ("ne", 5), ("na", 6), ("a", 7),
    ("pe", 10), ("po", 11), ("nge", 12), ("ge", 13), ("ng", 14), ("g", 15),
];
const LOW8_NAMES: [&str; 16] = ["al","cl","dl","bl","spl","bpl","sil","dil","r8b","r9b","r10b","r11b","r12b","r13b","r14b","r15b"];
const HIGH8_NAMES: [&str; 4] = ["ah","ch","dh","bh"];
const R16_NAMES: [&str; 16] = ["ax","cx","dx","bx","sp","bp","si","di","r8w","r9w","r10w","r11w","r12w","r13w","r14w","r15w"];
const R32_NAMES: [&str; 16] = ["eax","ecx","edx","ebx","esp","ebp","esi","edi","r8d","r9d","r10d","r11d","r12d","r13d","r14d","r15d"];
const R64_NAMES: [&str; 16] = ["rax","rcx","rdx","rbx","rsp","rbp","rsi","rdi","r8","r9","r10","r11","r12","r13","r14","r15"];
const SEGMENT_NAMES: [&str; 6] = ["es", "cs", "ss", "ds", "fs", "gs"];

impl OperandClass {
    pub const ALL: [OperandClass; 20] = [
        OperandClass::Gpr64, OperandClass::Gpr32, OperandClass::Gpr16, OperandClass::Gpr8,
        OperandClass::Gpr8High, OperandClass::Xmm, OperandClass::Ymm, OperandClass::Zmm,
        OperandClass::Mask, OperandClass::Mmx, OperandClass::Bound, OperandClass::Segment,
        OperandClass::Control, OperandClass::Debug, OperandClass::X87, OperandClass::Immediate,
        OperandClass::Relative, OperandClass::Displacement, OperandClass::Scale, OperandClass::Condition,
    ];

    /// The stable lower-case class name used in `$name:class`.
    pub fn name(self) -> &'static str {
        match self {
            OperandClass::Gpr64 => "gpr64",
            OperandClass::Gpr32 => "gpr32",
            OperandClass::Gpr16 => "gpr16",
            OperandClass::Gpr8 => "gpr8",
            OperandClass::Gpr8High => "gpr8_high",
            OperandClass::Xmm => "xmm",
            OperandClass::Ymm => "ymm",
            OperandClass::Zmm => "zmm",
            OperandClass::Mask => "mask",
            OperandClass::Mmx => "mmx",
            OperandClass::Bound => "bound",
            OperandClass::Segment => "segment",
            OperandClass::Control => "control",
            OperandClass::Debug => "debug",
            OperandClass::X87 => "x87",
            OperandClass::Immediate => "immediate",
            OperandClass::Relative => "relative",
            OperandClass::Displacement => "displacement",
            OperandClass::Scale => "scale",
            OperandClass::Condition => "condition",
        }
    }

    pub fn from_name(name: &str) -> Option<Self> {
        let name = name.trim();
        Self::ALL.into_iter().find(|class| class.name().eq_ignore_ascii_case(name))
    }

    /// Every stable class name, in declaration order.
    pub fn names() -> impl Iterator<Item = &'static str> {
        Self::ALL.into_iter().map(OperandClass::name)
    }

    pub fn is_register(self) -> bool {
        !matches!(self, OperandClass::Immediate | OperandClass::Relative
            | OperandClass::Displacement | OperandClass::Scale | OperandClass::Condition)
    }

    /// Whether a value of this class is a plain integer the user reads as a
    /// number: an immediate, a memory displacement, a branch displacement or a
    /// SIB scale. Registers and the condition code (a named set) are not.
    pub fn is_integer(self) -> bool {
        matches!(self, OperandClass::Immediate | OperandClass::Relative
            | OperandClass::Displacement | OperandClass::Scale)
    }

    /// The class's own value range in the model `matches` yields: register
    /// numbers, the condition codes, and for the numeric classes the widest
    /// values any form holds (a bound, `exact` false). A scale is one of 1, 2,
    /// 4, 8. `exact` here means every value in range has a spelling.
    pub fn domain(self) -> Domain {
        match self {
            OperandClass::Immediate | OperandClass::Displacement => WIDE_SIGNED,
            OperandClass::Relative => Domain::new(i128::from(i64::MIN), i128::from(i64::MAX), 1, false),
            OperandClass::Scale => Domain::new(1, 8, 1, false),
            OperandClass::Condition => Domain::new(0, 15, 1, true),
            class => { let mut domain = register_range(class, true); domain.exact = true; domain }
        }
    }

    /// One line saying what the class is and how its value is numbered.
    pub fn summary(self) -> &'static str {
        match self {
            OperandClass::Gpr64 => "64-bit general register rax..r15; the value is the register number 0..15 (rax=0, rcx=1, rdx=2, rbx=3, rsp=4, rbp=5, rsi=6, rdi=7, r8..r15).",
            OperandClass::Gpr32 => "32-bit general register eax..r15d; the value is the register number 0..15.",
            OperandClass::Gpr16 => "16-bit general register ax..r15w; the value is the register number 0..15.",
            OperandClass::Gpr8 => "8-bit general register al..r15b; the value is the register number 0..15 (4..7 are spl, bpl, sil, dil).",
            OperandClass::Gpr8High => "High-byte general register ah, ch, dh, bh; the value is 0..3.",
            OperandClass::Xmm => "128-bit vector register xmm0..xmm31; the value is the register number.",
            OperandClass::Ymm => "256-bit vector register ymm0..ymm31; the value is the register number.",
            OperandClass::Zmm => "512-bit vector register zmm0..zmm31; the value is the register number.",
            OperandClass::Mask => "AVX-512 opmask register k0..k7; the value is the register number.",
            OperandClass::Mmx => "MMX register mm0..mm7; the value is the register number.",
            OperandClass::Bound => "MPX bound register bnd0..bnd3; the value is the register number.",
            OperandClass::Segment => "Segment register es, cs, ss, ds, fs, gs; the value is 0..5 in that order.",
            OperandClass::Control => "Control register cr0..cr15; the value is the register number.",
            OperandClass::Debug => "Debug register dr0..dr15; the value is the register number.",
            OperandClass::X87 => "x87 stack register st0..st7; the value is the stack index.",
            OperandClass::Immediate => "An immediate integer, printed as signed hexadecimal; the value is the number as the instruction holds it.",
            OperandClass::Relative => "A branch displacement in bytes from the instruction's first byte (`.+0x10`, `.-0x4`); the value is the signed byte count.",
            OperandClass::Displacement => "A memory displacement in bytes as the formatter prints it (after EVEX disp8*N scaling); the value is the signed byte count.",
            OperandClass::Scale => "A SIB index scale; the value is the multiplier 1, 2, 4 or 8.",
            OperandClass::Condition => "A condition code as in `j$cc`; the value is the 4-bit condition number 0..15 (o=0, no=1, b=2, nb=3, z=4, nz=5, be=6, nbe=7, s=8, ns=9, p=10, np=11, l=12, nl=13, le=14, nle=15).",
        }
    }

    /// The register a register-class value names, if the value is in range.
    pub fn register(self, value: i128) -> Option<Register> {
        let number = u8::try_from(value).ok()?;
        let vector = |width| Register { class: RegisterClass::Vector, number, width, high8: false };
        let other = |class, width| Register { class, number, width, high8: false };
        let (limit, register) = match self {
            OperandClass::Gpr64 => (16, gpr(number, 64, false)),
            OperandClass::Gpr32 => (16, gpr(number, 32, false)),
            OperandClass::Gpr16 => (16, gpr(number, 16, false)),
            OperandClass::Gpr8 => (16, gpr(number, 8, false)),
            OperandClass::Gpr8High => {
                if number >= 4 { return None; }
                return Some(gpr(number + 4, 8, true));
            }
            OperandClass::Xmm => (32, vector(128)),
            OperandClass::Ymm => (32, vector(256)),
            OperandClass::Zmm => (32, vector(512)),
            OperandClass::Mask => (8, other(RegisterClass::Mask, 64)),
            OperandClass::Mmx => (8, other(RegisterClass::Mmx, 64)),
            OperandClass::Bound => (4, other(RegisterClass::Bound, 128)),
            OperandClass::Segment => (6, other(RegisterClass::Segment, 16)),
            OperandClass::Control => (16, other(RegisterClass::Control, 64)),
            OperandClass::Debug => (16, other(RegisterClass::Debug, 64)),
            OperandClass::X87 => (8, other(RegisterClass::X87, 80)),
            _ => return None,
        };
        (number < limit).then_some(register)
    }

    /// Parse one value of this class from its text spelling.
    pub fn parse_value(self, text: &str) -> Option<i128> {
        let text = text.trim();
        let lower = text.to_ascii_lowercase();
        if self.is_register() {
            let register = parse_register_name(&lower)?;
            let value = OperandValue::from_register(register)?;
            return (value.class == self).then_some(value.value);
        }
        match self {
            OperandClass::Immediate | OperandClass::Displacement => parse_signed_text(&lower),
            OperandClass::Relative => match lower.strip_prefix('.') {
                Some(rest) => parse_signed_text(rest.trim()),
                None => parse_signed_text(&lower),
            },
            OperandClass::Scale => match parse_signed_text(&lower)? {
                value @ (1 | 2 | 4 | 8) => Some(value),
                _ => None,
            },
            OperandClass::Condition => condition_from_name(&lower).map(i128::from),
            _ => None,
        }
    }

    /// The canonical spelling of one value of this class.
    pub fn format_value(self, value: i128) -> Option<String> {
        if self.is_register() {
            let mut text = String::new();
            write_register(&mut text, self.register(value)?);
            return Some(text);
        }
        let signed_hex = |value: i128| if value < 0 { format!("-0x{:x}", value.unsigned_abs()) } else { format!("0x{value:x}") };
        match self {
            OperandClass::Immediate | OperandClass::Displacement => Some(signed_hex(value)),
            OperandClass::Relative => Some(if value < 0 { format!(".-0x{:x}", value.unsigned_abs()) } else { format!(".+0x{value:x}") }),
            OperandClass::Scale => matches!(value, 1 | 2 | 4 | 8).then(|| value.to_string()),
            OperandClass::Condition => usize::try_from(value).ok()
                .and_then(|index| CONDITION_NAMES.get(index)).map(|name| (*name).to_string()),
            _ => None,
        }
    }

    fn of_register(register: Register) -> OperandClass {
        match register.class {
            RegisterClass::Gpr if register.high8 => OperandClass::Gpr8High,
            RegisterClass::Gpr => match register.width { 8 => OperandClass::Gpr8, 16 => OperandClass::Gpr16, 32 => OperandClass::Gpr32, _ => OperandClass::Gpr64 },
            RegisterClass::Vector => if register.width >= 512 { OperandClass::Zmm } else if register.width >= 256 { OperandClass::Ymm } else { OperandClass::Xmm },
            RegisterClass::Mask => OperandClass::Mask,
            RegisterClass::Mmx => OperandClass::Mmx,
            RegisterClass::Bound => OperandClass::Bound,
            RegisterClass::Segment => OperandClass::Segment,
            RegisterClass::Control => OperandClass::Control,
            RegisterClass::Debug => OperandClass::Debug,
            RegisterClass::X87 => OperandClass::X87,
            RegisterClass::Other => OperandClass::Gpr64,
        }
    }
}

impl fmt::Display for OperandClass {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { f.write_str(self.name()) }
}

/// How an operand value relates to where its instruction sits.
#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd, Hash)]
pub enum Position {
    /// The value does not depend on the instruction's address.
    Fixed,
    /// The target is the address of the instruction's first byte plus the value.
    InstructionRelative,
    /// Instruction-relative arithmetic truncated to the architectural IP width.
    WrappingInstructionRelative { bits: u8 },
    /// The target is the instruction's address with the low `shift` bits
    /// cleared, plus the value (A64 `ADRP`: `shift` is 12).
    PageRelative { shift: u8 },
}

impl Position {
    /// Whether the value is an offset from the instruction's address.
    pub fn is_position_dependent(self) -> bool { self != Position::Fixed }

    /// The address a value of this position denotes for an instruction at
    /// `address`; `None` for [`Position::Fixed`] and when the result leaves
    /// the 64-bit address space.
    pub fn target(self, address: u64, value: i128) -> Option<u64> { target(self, address, value) }

    /// The value that makes an instruction at `address` reach `target`.
    pub fn value_for_target(self, address: u64, target: u64) -> Option<i128> { value_for_target(self, address, target) }
}

/// The address `value` denotes under `position` for an instruction at
/// `address`: `address + value` (instruction-relative) or
/// `(address & !(2^shift - 1)) + value` (page-relative). `None` for
/// [`Position::Fixed`], for a shift of 64 or more, and when the result is
/// outside `0..=u64::MAX`.
pub fn target(position: Position, address: u64, value: i128) -> Option<u64> {
    let base = match position {
        Position::Fixed => return None,
        Position::WrappingInstructionRelative { bits } => return (1..=64).contains(&bits).then(|| address.wrapping_add(value as u64) & ip_mask(u32::from(bits))),
        Position::InstructionRelative => i128::from(address),
        Position::PageRelative { shift } => i128::from(address & !page_mask(shift)?),
    };
    u64::try_from(base.checked_add(value)?).ok()
}

/// The value that makes an instruction at `address` reach `target`: the
/// inverse of [`target`]. `None` for [`Position::Fixed`] and for a page-relative
/// target that is not aligned to the page (a page-relative operand reaches only
/// page starts). Whether the form can encode the value (range, a branch
/// target's 4-byte alignment) is the encoder's decision.
pub fn value_for_target(position: Position, address: u64, target: u64) -> Option<i128> {
    match position {
        Position::Fixed => None,
        Position::WrappingInstructionRelative { bits } => {
            if !(1..=64).contains(&bits) || target & !ip_mask(u32::from(bits)) != 0 { return None; }
            Some(modular_displacement(target.wrapping_sub(address), u32::from(bits)) as i128)
        }
        Position::InstructionRelative => Some(i128::from(target) - i128::from(address)),
        Position::PageRelative { shift } => {
            let mask = page_mask(shift)?;
            (target & mask == 0).then(|| i128::from(target) - i128::from(address & !mask))
        }
    }
}

fn page_mask(shift: u8) -> Option<u64> { (shift < 64).then(|| (1u64 << shift) - 1) }

// ---------------------------------------------------------------------------
// Value domains
// ---------------------------------------------------------------------------

/// The values an operand can hold, in the model `matches` yields and `encode`
/// takes: `min + k * step` for `k >= 0`, up to `max`. `exact` means every
/// value described encodes (with the template's other operands as written or
/// as in the instruction the hole came from); `false` means only that a value
/// outside the domain cannot encode (a necessary bound).
#[derive(Clone, Copy, Debug, Eq, PartialEq, Hash)]
pub struct Domain {
    pub min: i128,
    pub max: i128,
    pub step: i128,
    pub exact: bool,
}

impl Domain {
    /// A domain of `min..=max` by `step`; `max` is lowered to the last
    /// reachable value and a single value gets step 1.
    pub fn new(min: i128, max: i128, step: i128, exact: bool) -> Domain {
        let step = step.max(1);
        let max = if max > min { min + (max - min) / step * step } else { min };
        Domain { min, max, step: if max == min { 1 } else { step }, exact }
    }

    /// Whether `value` is one of the domain's values.
    pub fn contains(&self, value: i128) -> bool {
        (self.min..=self.max).contains(&value) && (value - self.min) % self.step == 0
    }

    /// Whether every value of `other` is a value of `self`.
    pub fn covers(&self, other: &Domain) -> bool {
        if other.min == other.max { return self.contains(other.min); }
        self.min <= other.min && other.max <= self.max && other.step % self.step == 0 && (other.min - self.min) % self.step == 0
    }
}

/// A [`Domain`] for one class of a hole.
#[derive(Clone, Copy, Debug, Eq, PartialEq, Hash)]
pub struct ClassDomain {
    pub class: OperandClass,
    pub domain: Domain,
}

/// Add `domain` to the entries for `class`: dropped when an entry already
/// covers it, replacing entries it covers, and joined with an entry of the same
/// step and exactness that it overlaps or touches.
fn add_domain(list: &mut Vec<ClassDomain>, class: OperandClass, mut domain: Domain) {
    loop {
        let mut changed = false;
        let mut index = 0;
        while index < list.len() {
            let entry = list[index];
            if entry.class != class { index += 1; continue; }
            let old = entry.domain;
            if old.covers(&domain) && (old.exact || !domain.exact) { return; }
            if domain.covers(&old) && (domain.exact || !old.exact) { list.remove(index); changed = true; continue; }
            if old.exact == domain.exact && old.step == domain.step && old.min != old.max && domain.min != domain.max
                && (old.min - domain.min) % old.step == 0
                && domain.min <= old.max + old.step && old.min <= domain.max + old.step {
                list.remove(index);
                domain = Domain::new(old.min.min(domain.min), old.max.max(domain.max), old.step, old.exact);
                changed = true;
                continue;
            }
            index += 1;
        }
        if !changed { break; }
    }
    list.push(ClassDomain { class, domain });
}

/// The range of one signed or unsigned reading of a `bits`-wide immediate:
/// `bits`-wide values as `encode` accepts them.
fn immediate_domains(width: u32, target: u32, signed: bool, exact: bool) -> Vec<Domain> {
    let (width, target) = (width.clamp(1, 64), target.clamp(1, 64));
    let half = |bits: u32| 1i128 << (bits - 1);
    if width >= target {
        // A full-width immediate reads signed or unsigned.
        return vec![Domain::new(-half(target), (1i128 << target) - 1, 1, exact)];
    }
    // A narrower unsigned one is its raw value.
    if !signed { return vec![Domain::new(0, (1i128 << width) - 1, 1, exact)]; }
    // A narrower signed one is sign-extended to the operand size: either reading of
    // the small value, or the sign-extended bit pattern `matches` yields.
    vec![
        Domain::new(-half(width), half(width) - 1, 1, exact),
        Domain::new((1i128 << target) - half(width), (1i128 << target) - 1, 1, exact),
    ]
}

/// The widest model value of an operand class, for the classes that are not registers.
const WIDE_SIGNED: Domain = Domain { min: -(1i128 << 63), max: (1i128 << 64) - 1, step: 1, exact: false };

/// Encode a variant's representative fields and decode them back: the length,
/// the immediate widths and the printed operand sizes.
fn probe(variant: &Variant) -> Option<(Decoded, View)> {
    let mut out = [0u8; 15];
    let length = encode(variant.form as usize, variant.fields, &mut out).ok()?;
    let decoded = decode(&out[..length], variant.fields.mode).ok()?;
    if decoded.length as usize != length { return None; }
    let view = view(&decoded);
    Some((decoded, view))
}

/// Whether an immediate narrower than its operand size is read signed
/// (sign-extended to the operand size) or unsigned, found by encoding a value
/// with its top bit set and reading it back. `None` when it reads as neither.
fn immediate_signed(variant: &Variant, position: usize, slot: usize, width: u32, target: u32) -> Option<bool> {
    if width == 0 || width >= 64 || width >= target { return Some(true); }
    let raw = 1u64 << (width - 1);
    let mut fields = variant.fields;
    fields.immediate[slot] = raw;
    let mut out = [0u8; 15];
    let length = encode(variant.form as usize, fields, &mut out).ok()?;
    let decoded = decode(&out[..length], fields.mode).ok()?;
    let ViewOperand::Immediate { value, .. } = *view(&decoded).operands().get(position)? else { return None };
    let extended = (raw as i64 | (-1i64 << width)) as u64 & if target >= 64 { u64::MAX } else { (1u64 << target) - 1 };
    if value == raw { Some(false) } else if value == extended { Some(true) } else { None }
}

/// The length of the variant encoded with a RIP-relative operand.
fn rip_length(variant: &Variant) -> Option<i128> {
    let mut fields = variant.fields;
    fields.mod_bits = 0; fields.rm = 5; fields.use_sib = false; fields.displacement = 0;
    let mut out = [0u8; 15];
    encode(variant.form as usize, fields, &mut out).ok().map(|length| length as i128)
}

fn register_available(register:Register,mode:Mode)->bool {
    if mode==Mode::Mode64 {return true}
    match register.class {
        RegisterClass::Gpr => register.width!=64 && register.number<8 && (register.width!=8 || register.high8 || register.number<4),
        RegisterClass::Vector | RegisterClass::Control | RegisterClass::Debug => register.number<8,
        _=>true,
    }
}

fn register_range_in_mode(class:OperandClass,evex:bool,mode:Mode)->Domain {
    let mut domain=register_range(class,evex);
    if mode!=Mode::Mode64 {match class {
        OperandClass::Gpr8 => domain.max=3,
        OperandClass::Gpr16 | OperandClass::Gpr32 | OperandClass::Control | OperandClass::Debug | OperandClass::Xmm | OperandClass::Ymm | OperandClass::Zmm => domain.max=7,
        _=>{},
    }}
    domain
}

fn register_range(class: OperandClass, evex: bool) -> Domain {
    let limit = match class {
        OperandClass::Gpr64 | OperandClass::Gpr32 | OperandClass::Gpr16 | OperandClass::Gpr8 | OperandClass::Control | OperandClass::Debug => 16,
        OperandClass::Gpr8High => 4,
        OperandClass::Xmm | OperandClass::Ymm | OperandClass::Zmm => if evex { 32 } else { 16 },
        OperandClass::Mask => return Domain::new(0, 7, 1, false),
        OperandClass::Mmx | OperandClass::X87 => 8,
        OperandClass::Bound => 4,
        OperandClass::Segment => 6,
        _ => 1,
    };
    Domain::new(0, limit - 1, 1, !matches!(class, OperandClass::Gpr8 | OperandClass::Gpr8High))
}

/// One value bound to a template hole. Registers carry their number within
/// the class, so a class and value have exactly one spelling. `position` says
/// how the value relates to where its instruction sits: a branch displacement
/// (`Relative`) and a hole-bound RIP-relative displacement are measured from
/// the instruction's first byte ([`Position::InstructionRelative`]); every
/// other value is [`Position::Fixed`]. Encoding ignores `position`.
#[derive(Clone, Copy, Debug, Eq, PartialEq, Hash)]
pub struct OperandValue {
    pub class: OperandClass,
    pub value: i128,
    pub position: Position,
}

impl OperandValue {
    /// A value with its class's usual position: `Relative` is
    /// instruction-relative, everything else fixed. Use
    /// [`OperandValue::with_position`] for a RIP-relative displacement.
    pub fn new(class: OperandClass, value: i128) -> Self {
        let position = if class == OperandClass::Relative { Position::InstructionRelative } else { Position::Fixed };
        Self { class, value, position }
    }

    /// The same value with another position.
    pub fn with_position(self, position: Position) -> Self { Self { position, ..self } }

    /// The value naming one decoded register, if its class has a stable spelling.
    pub fn from_register(register: Register) -> Option<Self> {
        if register.class == RegisterClass::Other { return None; }
        let class = OperandClass::of_register(register);
        let number = if register.high8 { register.number.checked_sub(4)? } else { register.number };
        class.register(i128::from(number))?;
        Some(Self::new(class, i128::from(number)))
    }

    /// Parse `text` as a value of `class`.
    pub fn parse(class: OperandClass, text: &str) -> Option<Self> {
        class.parse_value(text).map(|value| Self::new(class, value))
    }

    pub fn register(&self) -> Option<Register> { self.class.register(self.value) }
}

impl fmt::Display for OperandValue {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self.class.format_value(self.value) {
            Some(text) => f.write_str(&text),
            None => write!(f, "{}:{}", self.class, self.value),
        }
    }
}

// ---------------------------------------------------------------------------
// Errors and results
// ---------------------------------------------------------------------------

/// Why a line of text or a template could not be assembled.
#[derive(Clone, Debug, Eq, PartialEq)]
pub enum AssembleError {
    /// Malformed text at a byte offset.
    Syntax { offset: usize, message: String },
    /// No form prints this mnemonic; `nearest` lists the closest known mnemonics.
    UnknownMnemonic { mnemonic: String, nearest: Vec<String> },
    /// `$name:class` named a class that does not exist; `classes` lists every class.
    UnknownClass { offset: usize, name: String, classes: Vec<&'static str> },
    /// No form of the mnemonic takes this many operands.
    OperandCount { mnemonic: String, found: usize, expected: Vec<usize> },
    /// Forms take this many operands, but none accepts them. `form` is the form
    /// that accepted the most leading operands and `operand` the first it rejected.
    NoMatchingForm { mnemonic: String, form: &'static str, operand: usize, reason: &'static str },
    /// The operand shapes match `form`, but no encoding represents this value.
    OperandOutOfRange { operand: usize, form: &'static str },
    /// The memory operand at `offset` cannot be encoded in 64-bit mode.
    InvalidAddress { offset: usize, reason: &'static str },
    /// A memory operand needs a size keyword; `candidates` are the sizes forms accept.
    AmbiguousSize { operand: usize, candidates: Vec<&'static str> },
    /// An absolute branch target needs an address: use `assemble_at`/`Template::parse_at` or `.+N`.
    RelativeNeedsAddress { operand: usize },
    /// `encode` was called without a value for this hole (or the template uses `_`).
    UnboundHole { name: String },
    /// A hole was given (or restricted to) a class it cannot take here.
    HoleClassMismatch { name: String, class: OperandClass, allowed: Vec<OperandClass> },
    /// `encode` was given more values than the template has holes.
    ValueCount { expected: usize, found: usize },
    /// A hole value outside its class's domain (for example scale 3).
    InvalidValue { name: String, value: OperandValue },
    /// More than the supported number of distinct holes.
    TooManyHoles { limit: usize },
}

impl fmt::Display for AssembleError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            AssembleError::Syntax { offset, message } => write!(f, "syntax error at byte {offset}: {message}"),
            AssembleError::UnknownMnemonic { mnemonic, nearest } => {
                write!(f, "unknown mnemonic `{mnemonic}`")?;
                if !nearest.is_empty() { write!(f, " (nearest: {})", nearest.join(", "))?; }
                Ok(())
            }
            AssembleError::UnknownClass { name, classes, .. } => write!(f, "unknown operand class `{name}` (classes: {})", classes.join(", ")),
            AssembleError::OperandCount { mnemonic, found, expected } => {
                let expected: Vec<String> = expected.iter().map(usize::to_string).collect();
                write!(f, "`{mnemonic}` takes {} operands, not {found}", expected.join(" or "))
            }
            AssembleError::NoMatchingForm { mnemonic, form, operand, reason } =>
                write!(f, "no `{mnemonic}` form accepts these operands: closest form {form} rejects operand {} ({reason})", operand + 1),
            AssembleError::OperandOutOfRange { operand, form } => write!(f, "operand {} is out of range for {form}", operand + 1),
            AssembleError::InvalidAddress { offset, reason } => write!(f, "invalid memory operand at byte {offset}: {reason}"),
            AssembleError::AmbiguousSize { operand, candidates } =>
                write!(f, "operand {} needs a size keyword ({})", operand + 1, candidates.join(", ")),
            AssembleError::RelativeNeedsAddress { operand } =>
                write!(f, "operand {} is an absolute branch target: assemble at an address or write `.+N`", operand + 1),
            AssembleError::UnboundHole { name } => write!(f, "no value for hole `{name}`"),
            AssembleError::HoleClassMismatch { name, class, allowed } => {
                let allowed: Vec<&str> = allowed.iter().map(|class| class.name()).collect();
                write!(f, "hole `{name}` cannot take class {class} (allowed: {})", allowed.join(", "))
            }
            AssembleError::ValueCount { expected, found } => write!(f, "expected {expected} hole values, got {found}"),
            AssembleError::InvalidValue { name, value } => write!(f, "value {value} is invalid for hole `{name}`"),
            AssembleError::TooManyHoles { limit } => write!(f, "templates support at most {limit} holes"),
        }
    }
}

impl std::error::Error for AssembleError {}

/// One verified encoding of an assembled instruction.
#[derive(Clone, Copy, Debug)]
pub struct Encoded {
    bytes: [u8; 15],
    length: u8,
    form_index: u32,
    fields: EncodeFields,
}

impl Encoded {
    pub fn bytes(&self) -> &[u8] { &self.bytes[..self.length as usize] }
    pub fn len(&self) -> usize { self.length as usize }
    pub const fn is_empty(&self) -> bool { false }
    /// The form the bytes decode as.
    pub fn form_index(&self) -> u32 { self.form_index }
    pub fn encoding(&self) -> &'static Encoding { &ENCODINGS[self.form_index as usize] }
    /// The encoder fields that produced these bytes.
    pub fn fields(&self) -> EncodeFields { self.fields }
}

impl PartialEq for Encoded {
    fn eq(&self, other: &Self) -> bool { self.bytes() == other.bytes() }
}
impl Eq for Encoded {}

/// Assemble one line of Intel-syntax text in [`DEFAULT_MODE`] into every encoding,
/// shortest first. Branch targets are written `.+N` (from the first byte).
pub fn assemble(text: &str) -> Result<Vec<Encoded>, AssembleError> {
    Template::parse(text)?.encode(&[])
}

/// Assemble text for an instruction at `address`; absolute branch targets
/// (as [`format_intel`] prints them) are accepted.
pub fn assemble_at(text: &str, address: u64) -> Result<Vec<Encoded>, AssembleError> {
    Template::parse_at(text, address)?.encode(&[])
}

/// Assemble Intel-syntax text in the selected execution mode.
pub fn assemble_in_mode(text: &str, mode: Mode) -> Result<Vec<Encoded>, AssembleError> {
    Template::parse_in_mode(text, mode)?.encode(&[])
}

/// Assemble text at an address in the selected execution mode.
pub fn assemble_at_in_mode(text: &str, address: u64, mode: Mode) -> Result<Vec<Encoded>, AssembleError> {
    Template::parse_at_in_mode(text, address, mode)?.encode(&[])
}

// ---------------------------------------------------------------------------
// Views: the structured form of what format_intel prints
// ---------------------------------------------------------------------------

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub(crate) enum MemoryPrefix { None, Far, FpuEnv14, FpuState94 }

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub(crate) struct ViewMemory {
    prefix: MemoryPrefix,
    size: u16,
    segment: Option<Register>,
    base: Option<Register>,
    rip: bool,
    index: Option<Register>,
    scale: u8,
    displacement: i64,
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub(crate) enum ViewOperand {
    Register(Register),
    Memory(ViewMemory),
    Immediate { value: u64, width: u16 },
    Relative { displacement:i64, bits:u32 },
    Pointer(u64),
    FarPointer { offset: u64, selector: u64 },
    Text(&'static str),
}

#[derive(Clone, Copy, Debug)]
pub(crate) struct View {
    form_index: u32,
    length: u8,
    mnemonic: &'static str,
    lock: bool,
    repeat: u8,
    repeat_text: &'static str,
    broadcast: bool,
    rounding: Option<u8>,
    address_size: u8,
    mask: u8,
    zeroing: bool,
    mask_after: u8,
    operands: [ViewOperand; VIEW_OPERANDS],
    count: u8,
    overflow: bool,
}

impl View {
    fn operands(&self) -> &[ViewOperand] { &self.operands[..self.count as usize] }

    fn push(&mut self, operand: ViewOperand) {
        if (self.count as usize) < VIEW_OPERANDS {
            self.operands[self.count as usize] = operand;
            self.count += 1;
        } else {
            self.overflow = true;
        }
    }
}

// 90 is the accumulator self-XCHG spelling as well as NOP. In long mode
// the 32-bit XCHG still clears the upper half, so only AX and RAX alias NOP.
fn self_xchg_view(decoded: &Decoded) -> Option<View> {
    let e=decoded.encoding();
    if e.kind!=0 || e.map!=0 || e.opcode!=0x90 || e.mnemonic!="NOP" {return None}
    let width=if decoded.physical.operand_size==16 {16}else if decoded.physical.mode==Mode::Mode64 {64}else{decoded.physical.operand_size as u16};
    let mut alias=view(decoded);
    alias.mnemonic="XCHG";
    alias.count=0;
    alias.push(ViewOperand::Register(gpr(0,width,false)));
    alias.push(ViewOperand::Register(gpr(0,width,false)));
    Some(alias)
}

fn is_repeatable(encoding: &Encoding) -> bool {
    encoding.map == 0 && matches!(encoding.mnemonic,
        "CMPSB" | "CMPSW" | "CMPSD" | "CMPSQ" | "SCASB" | "SCASW" | "SCASD" | "SCASQ" |
        "MOVSB" | "MOVSW" | "MOVSD" | "MOVSQ" | "LODSB" | "LODSW" | "LODSD" | "LODSQ" |
        "STOSB" | "STOSW" | "STOSD" | "STOSQ" | "INSB" | "INSW" | "INSD" | "OUTSB" | "OUTSW" | "OUTSD")
}

/// Whether the view reports an `f2`/`f3` prefix of this form as `rep`/`repnz`:
/// the legacy forms that do not use it as a mandatory prefix.
fn repeat_prefix_visible(encoding: &Encoding) -> bool {
    let rep_named = encoding.mnemonic.starts_with("XCRYPT") || matches!(encoding.mnemonic, "XSHA1" | "XSHA256" | "XSTORE");
    encoding.kind == 0 && (encoding.mandatory == 0 || is_repeatable(encoding) || rep_named)
}

fn printed_size(size: u16) -> u16 {
    match size { 8 | 16 | 32 | 48 | 64 | 80 | 128 | 256 | 512 => size, _ => 0 }
}

fn size_keyword(size: u16) -> &'static str {
    match size {
        8 => "byte", 16 => "word", 32 => "dword", 48 => "fword", 64 => "qword", 80 => "tbyte",
        128 => "xmmword", 256 => "ymmword", 512 => "zmmword", _ => "(none)",
    }
}

fn address_size_visible(decoded: &Decoded) -> bool {
    let encoding = decoded.encoding();
    if is_repeatable(encoding) { return true; }
    if decoded.operands().iter().any(|operand| !operand.implicit && operand.kind == OperandKind::Memory) {
        return true;
    }
    (0..encoding.operand_len as usize).any(|i| {
        let spec = &OPERANDS[encoding.operand_start as usize + i];
        matches!(spec.symbol, "AXa" | "BXa" | "CXa" | "DXa" | "SIa" | "DIa")
            || matches!(spec.value, "AXa" | "BXa" | "CXa" | "DXa" | "SIa" | "DIa")
    })
}

/// Build the structured view of one decoded instruction without allocating.
/// It mirrors [`format_intel`] case for case; `write_view` prints it back and
/// the generated tests require the two texts to be identical.
pub(crate) fn view(decoded: &Decoded) -> View {
    let encoding = decoded.encoding();
    let physical = &decoded.physical;
    let mut view = View {
        form_index: decoded.form_index,
        length: decoded.length,
        mnemonic: display_mnemonic(decoded),
        lock: physical.lock,
        repeat: 0,
        repeat_text: "",
        broadcast: physical.broadcast && !encoding.suppress_exceptions,
        rounding: encoding.suppress_exceptions.then_some(if encoding.embedded_rounding { physical.rounding_control } else { 4 }),
        address_size: 0,
        mask: 0,
        zeroing: false,
        mask_after: 0,
        operands: [ViewOperand::Text(""); VIEW_OPERANDS],
        count: 0,
        overflow: false,
    };
    if address_size_visible(decoded) { view.address_size = physical.address_size; }
    let repeatable = is_repeatable(encoding);
    if repeat_prefix_visible(encoding) {
        if physical.repeat & 2 != 0 {
            view.repeat = 2;
            view.repeat_text = if matches!(encoding.mnemonic, "CMPSB" | "CMPSW" | "CMPSD" | "CMPSQ" | "SCASB" | "SCASW" | "SCASD" | "SCASQ") { "repz" } else { "rep" };
        } else if physical.repeat & 4 != 0 {
            view.repeat = 4;
            view.repeat_text = "repnz";
        }
    }
    if repeatable {
        let mnemonic = encoding.mnemonic;
        let width = if mnemonic.ends_with('B') { 8 } else if mnemonic.ends_with('W') { 16 }
            else if mnemonic.ends_with('Q') { 64 } else { 32 };
        let address = physical.address_size as u16;
        let string = |register: u8| ViewOperand::Memory(ViewMemory {
            prefix: MemoryPrefix::None, size: width, segment: None, base: Some(gpr(register, address, false)),
            rip: false, index: None, scale: 1, displacement: 0,
        });
        if mnemonic.starts_with("CMPS") { view.push(string(6)); view.push(string(7)); }
        else if mnemonic.starts_with("MOVS") { view.push(string(7)); view.push(string(6)); }
        else if mnemonic.starts_with("LODS") { view.push(string(6)); }
        else if mnemonic.starts_with("STOS") || mnemonic.starts_with("SCAS") { view.push(string(7)); }
        else if mnemonic.starts_with("INS") { view.push(string(7)); view.push(ViewOperand::Register(gpr(2, 16, false))); }
        else if mnemonic.starts_with("OUTS") { view.push(ViewOperand::Register(gpr(2, 16, false))); view.push(string(6)); }
        return view;
    }
    if matches!(encoding.mnemonic, "CALL" | "JMP") && encoding.map == 0 && matches!(encoding.opcode, 0x9a | 0xea) {
        if let Some(pointer) = decoded.operands().iter().find(|operand| operand.kind == OperandKind::FarPointer) {
            let offset_bits = if pointer.immediate.width == 32 { 16 } else { 32 };
            let offset_mask = if offset_bits == 16 { 0xffff } else { 0xffff_ffff };
            view.push(ViewOperand::FarPointer {
                offset: pointer.immediate.value & offset_mask,
                selector: pointer.immediate.value >> offset_bits,
            });
            return view;
        }
    }
    let shown = view.mnemonic;
    if shown.len() >= 5 && shown[..5].eq_ignore_ascii_case("rdssp") {
        if let Some(operand) = decoded.operands().iter().find(|operand| !operand.implicit && operand.kind == OperandKind::Register) {
            if let Some(operand) = view_operand(decoded, operand) { view.push(operand); }
        }
        return view;
    }
    if shown.eq_ignore_ascii_case("xlat") {
        view.push(ViewOperand::Memory(ViewMemory {
            prefix: MemoryPrefix::None, size: 8, segment: None,
            base: Some(gpr(3, physical.address_size as u16, false)), rip: false, index: None, scale: 1, displacement: 0,
        }));
        return view;
    }
    let gather = encoding.mnemonic.contains("GATHER") || encoding.mnemonic.contains("SCATTER");
    for operand in decoded.operands().iter().filter(|operand| !operand.implicit) {
        if operand.kind == OperandKind::Mask {
            if let Some(register) = operand.register {
                if register.number != 0 {
                    if gather {
                        view.push(ViewOperand::Register(register));
                    } else {
                        view.mask = register.number;
                        view.zeroing = physical.zeroing;
                        view.mask_after = view.count;
                    }
                }
            }
            continue;
        }
        if let Some(operand) = view_operand(decoded, operand) { view.push(operand); }
    }
    if shown.eq_ignore_ascii_case("nop") && encoding.kind == 0 && encoding.map == 1 && encoding.opcode == 0x18 {
        view.push(ViewOperand::Register(gpr(physical.reg, 32, false)));
    }
    if shown.eq_ignore_ascii_case("vmsave") && view.count == 0 {
        view.push(ViewOperand::Register(gpr(0, 64, false)));
    }
    view
}

fn view_operand(decoded: &Decoded, operand: &DecodedOperand) -> Option<ViewOperand> {
    let encoding = decoded.encoding();
    let physical = &decoded.physical;
    Some(match operand.kind {
        OperandKind::Register => match operand.register {
            Some(mut register) => {
                if physical.mode == Mode::Mode64 && register.class == RegisterClass::Gpr && register.width == 32 &&
                    matches!(encoding.mnemonic, "CALL" | "JMP" | "PUSH" | "POP") { register.width = 64; }
                if register.class == RegisterClass::Gpr && matches!(encoding.mnemonic, "TPAUSE" | "UMWAIT") { register.width = 32; }
                if register.class == RegisterClass::Gpr && matches!(encoding.mnemonic, "CLZERO" | "INVLPGA" | "VMLOAD" | "VMRUN" | "VMSAVE") && register.number == 0 { register.width = 64; }
                ViewOperand::Register(register)
            }
            None => ViewOperand::Text(operand.text),
        },
        OperandKind::Memory => {
            let mut memory = operand.memory;
            if physical.mode!=Mode::Mode64 && memory.base.is_none() && memory.index.is_none() && !memory.rip_relative {
                memory.displacement=if physical.address_size==16 {i64::from(memory.displacement as u16 as i16)}else{i64::from(memory.displacement as u32 as i32)};
            }
            let mut prefix = MemoryPrefix::None;
            if matches!(encoding.mnemonic, "LEA" | "BNDCL" | "BNDCN" | "BNDCU" | "BNDMK") { memory.segment = None; }
            if physical.mode == Mode::Mode64 && memory.size == 32 && matches!(encoding.mnemonic, "CALL" | "JMP" | "PUSH" | "POP") { memory.size = 64; }
            if matches!(encoding.mnemonic, "INVLPG" | "CLDEMOTE") { memory.size = 0; }
            if matches!(encoding.mnemonic, "LGDT" | "LIDT" | "SGDT" | "SIDT" | "LDS" | "LES" | "LFS" | "LGS" | "LSS") { memory.size = 48; }
            if matches!(encoding.mnemonic, "CLFLUSH" | "CLFLUSHOPT" | "CLWB") { memory.size = 8; }
            if encoding.map == 1 && encoding.opcode == 0x18 && physical.mod_bits != 3 && matches!(physical.reg & 7, 6 | 7) { memory.size = 8; }
            if encoding.map == 0 && encoding.opcode == 0xff && matches!(encoding.reg_value, 3 | 5) { prefix = MemoryPrefix::Far; memory.size = 48; }
            if matches!(encoding.mnemonic, "FLDENV" | "FNSTENV") && physical.operand_size == 16 {
                prefix = MemoryPrefix::FpuEnv14;
                memory.size = 0;
            } else if matches!(encoding.mnemonic, "FRSTOR" | "FNSAVE") && physical.operand_size == 16 {
                prefix = MemoryPrefix::FpuState94;
                memory.size = 0;
            }
            // `[index*1 + disp]` without a base computes the same address as
            // `[base + disp]` and prints identically, so the view folds it.
            let (base, index) = match (memory.base, memory.index) {
                (None, Some(index)) if !memory.rip_relative && memory.scale == 1 && index.class == RegisterClass::Gpr => (Some(index), None),
                other => other,
            };
            ViewOperand::Memory(ViewMemory {
                prefix,
                size: printed_size(memory.size),
                segment: memory.segment,
                base: if memory.rip_relative { None } else { base },
                rip: memory.rip_relative,
                index,
                scale: if index.is_some() { memory.scale } else { 1 },
                displacement: memory.displacement,
            })
        }
        OperandKind::Relative => ViewOperand::Relative { displacement:(decoded.length as i64).wrapping_add(operand.immediate.signed),bits:relative_address_bits(physical,encoding.mnemonic) },
        OperandKind::Immediate => {
            if !operand.text.is_empty() && operand.text.parse::<u64>().is_err() {
                ViewOperand::Text(operand.text)
            } else {
                let target_width = immediate_target_width(decoded.operands(), encoding.mnemonic, physical);
                let value = if operand.immediate.signed < 0 && target_width < 64 {
                    operand.immediate.value & ((1u64 << target_width) - 1)
                } else {
                    operand.immediate.value
                };
                ViewOperand::Immediate { value, width: target_width }
            }
        }
        OperandKind::FarPointer => ViewOperand::Pointer(operand.immediate.value),
        OperandKind::Other => ViewOperand::Text(operand.text),
        OperandKind::Mask | OperandKind::None => return None,
    })
}

/// Print a view exactly as [`format_intel`] prints the decoded instruction.
#[cfg_attr(not(test), allow(dead_code))]
pub(crate) fn write_view(output: &mut String, view: &View, ip: u64) {
    write_view_with(output, view, ip, None)
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
#[cfg_attr(not(test), allow(dead_code))]
pub(crate) enum Component { Whole, Base, Index, Scale, Displacement }

fn write_view_with(output: &mut String, view: &View, ip: u64, hole: Option<(usize, Component, &str)>) {
    if view.lock { output.push_str("lock "); }
    if !view.repeat_text.is_empty() { output.push_str(view.repeat_text); output.push(' '); }
    output.push_str(&view.mnemonic.to_ascii_lowercase());
    let decoration = |output: &mut String| {
        if view.mask != 0 {
            output.push('{');
            let _ = write!(output, "k{}", view.mask);
            output.push('}');
            if view.zeroing { output.push_str("{z}"); }
        }
    };
    for (index, operand) in view.operands().iter().enumerate() {
        if index == view.mask_after as usize { decoration(output); }
        output.push_str(if index == 0 { " " } else { ", " });
        let component = hole.filter(|(at, _, _)| *at == index).map(|(_, component, name)| (component, name));
        write_view_operand(output, operand, ip, view.address_size, component);
    }
    if view.mask_after as usize >= view.operands().len() { decoration(output); }
    write_rounding(output, view.rounding);
}

fn write_rounding(output: &mut String, rounding: Option<u8>) {
    if let Some(rounding) = rounding {
        output.push_str(match rounding { 0 => ", {rn-sae}", 1 => ", {rd-sae}", 2 => ", {ru-sae}", 3 => ", {rz-sae}", _ => ", {sae}" });
    }
}

fn write_view_operand(output: &mut String, operand: &ViewOperand, ip: u64, address_size: u8, hole: Option<(Component, &str)>) {
    if let Some((Component::Whole, name)) = hole {
        output.push_str(name);
        return;
    }
    match operand {
        ViewOperand::Register(register) => write_register(output, *register),
        ViewOperand::Memory(memory) => {
            match memory.prefix {
                MemoryPrefix::None => {}
                MemoryPrefix::Far => output.push_str("far "),
                MemoryPrefix::FpuEnv14 => output.push_str("fpuenv14 ptr "),
                MemoryPrefix::FpuState94 => output.push_str("fpustate94 ptr "),
            }
            if printed_size(memory.size) != 0 { output.push_str(size_keyword(memory.size)); output.push_str(" ptr "); }
            if let Some(segment) = memory.segment { write_register(output, segment); output.push(':'); }
            output.push('[');
            let mut term = false;
            if memory.rip {
                output.push_str(if address_size == 32 { "eip" } else { "rip" }); term = true;
            } else if let Some(base) = memory.base {
                match hole { Some((Component::Base, name)) => output.push_str(name), _ => write_register(output, base) }
                term = true;
            }
            if let Some(index) = memory.index {
                if term { output.push('+'); }
                match hole { Some((Component::Index, name)) => output.push_str(name), _ => write_register(output, index) }
                match hole {
                    Some((Component::Scale, name)) => { output.push('*'); output.push_str(name); }
                    _ => if memory.scale != 1 { let _ = write!(output, "*{}", memory.scale); },
                }
                term = true;
            }
            if let Some((Component::Displacement, name)) = hole {
                if term { output.push('+'); }
                output.push_str(name);
            } else if memory.displacement != 0 || !term {
                if memory.displacement < 0 {
                    let _ = write!(output, "-0x{:x}", memory.displacement.unsigned_abs());
                } else {
                    if term { output.push('+'); }
                    let _ = write!(output, "0x{:x}", memory.displacement);
                }
            }
            output.push(']');
        }
        ViewOperand::Immediate { value, .. } => { let _ = write!(output, "0x{value:x}"); }
        ViewOperand::Relative{displacement,bits} => { let _ = write!(output, "0x{:x}", ip.wrapping_add_signed(*displacement)&ip_mask(*bits)); }
        ViewOperand::Pointer(value) => { let _ = write!(output, "0x{value:x}"); }
        ViewOperand::FarPointer { offset, selector } => { let _ = write!(output, "far 0x{offset:x}, 0x{selector:x}"); }
        ViewOperand::Text(text) => output.push_str(&text.to_ascii_lowercase()),
    }
}

/// Key under which two registers print identically.
fn register_key(register: Register) -> (u8, u8, u16, bool) {
    let class = register.class as u8;
    match register.class {
        RegisterClass::Gpr if register.high8 => (class, register.number, 8, true),
        RegisterClass::Gpr => (class, register.number, match register.width { 8 => 8, 16 => 16, 32 => 32, _ => 64 }, false),
        RegisterClass::Vector => (class, register.number, if register.width >= 512 { 512 } else if register.width >= 256 { 256 } else { 128 }, false),
        _ => (class, register.number, 0, false),
    }
}

fn same_register(a: Register, b: Register) -> bool { register_key(a) == register_key(b) }

// ---------------------------------------------------------------------------
// Form catalog: operand shapes and encoder fields for every 64-bit form
// ---------------------------------------------------------------------------

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
enum Field { Fixed, Reg, Rm, Vvvv, OpcodeReg, Mask, Is4(u8), Immediate(u8), Relative(u8), Moffs(u8), Memory, Pointer }

#[derive(Clone, Copy, Debug)]
enum ShapeKind {
    Register { register: Register, fixed: bool },
    Memory { memory: ViewMemory, fixed: bool, vsib: u16, moffs: bool },
    Immediate { value: u64, fixed: bool },
    Relative,
    Pointer,
    Text(&'static str),
}

#[derive(Clone, Copy, Debug)]
struct ShapeOperand { kind: ShapeKind, field: Field }

#[derive(Clone, Copy, Debug)]
struct Variant {
    form: u32,
    fields: EncodeFields,
    mnemonic: &'static str,
    operands: [Option<ShapeOperand>; VIEW_OPERANDS],
    count: u8,
    /// Position of the `{k}{z}` decoration when the form takes an EVEX mask.
    decoration: Option<u8>,
}

impl Variant {
    fn operand(&self, index: usize) -> ShapeOperand { self.operands[index].expect("shape operand") }
    fn encoding(&self) -> &'static Encoding { &ENCODINGS[self.form as usize] }
}

struct Catalog {
    variants: Vec<Variant>,
    by_form: Vec<(u32, u8)>,
    names: Vec<(String, Vec<u32>)>,
    skipped: Vec<(u32, &'static str)>,
}

fn catalog_in_mode(mode: Mode) -> &'static Catalog {
    static MODE16: OnceLock<Catalog> = OnceLock::new();
    static MODE32: OnceLock<Catalog> = OnceLock::new();
    static MODE64: OnceLock<Catalog> = OnceLock::new();
    match mode {
        Mode::Mode16 => MODE16.get_or_init(|| build_catalog(mode)),
        Mode::Mode32 => MODE32.get_or_init(|| build_catalog(mode)),
        Mode::Mode64 => MODE64.get_or_init(|| build_catalog(mode)),
    }
}

impl Catalog {
    fn forms_named(&self, name: &str) -> Option<&[u32]> {
        self.names.binary_search_by(|(known, _)| known.as_str().cmp(name)).ok().map(|index| self.names[index].1.as_slice())
    }

    #[cfg_attr(not(test), allow(dead_code))]
    fn variants_of(&self, form: u32) -> &[Variant] {
        let (start, count) = self.by_form[form as usize];
        &self.variants[start as usize..start as usize + count as usize]
    }

    fn nearest(&self, name: &str) -> Vec<String> {
        let mut scored: Vec<(usize, &str)> = self.names.iter()
            .map(|(known, _)| (edit_distance(name, known), known.as_str())).collect();
        scored.sort();
        scored.into_iter().take(3).map(|(_, known)| known.to_string()).collect()
    }
}

fn edit_distance(a: &str, b: &str) -> usize {
    let a = a.as_bytes();
    let b = b.as_bytes();
    let mut previous: Vec<usize> = (0..=b.len()).collect();
    let mut current = vec![0; b.len() + 1];
    for (i, &x) in a.iter().enumerate() {
        current[0] = i + 1;
        for (j, &y) in b.iter().enumerate() {
            current[j + 1] = (previous[j] + usize::from(x != y)).min(previous[j + 1] + 1).min(current[j] + 1);
        }
        std::mem::swap(&mut previous, &mut current);
    }
    previous[b.len()]
}

/// Every lower-case mnemonic `format_intel` can print for a form.
fn form_display_names(e: &Encoding, out: &mut Vec<String>) {
    out.push(e.mnemonic.to_ascii_lowercase());
    if e.kind==0 && e.map==0 && e.opcode==0x90 && e.mnemonic=="NOP" {out.push("xchg".to_string());}
    let mut add = |name: &str| out.push(name.to_string());
    if e.kind == 0 && e.map == 1 {
        if e.opcode == 0x18 { add("prefetchit1"); add("prefetchit0"); }
        if e.opcode == 0x1e { add("rdsspd"); add("rdsspq"); }
        if e.opcode == 0x0d { add("nop"); add("prefetch_exclusive"); add("prefetchw"); add("prefetchwt1"); add("prefetch_reserved"); }
        if e.opcode == 0x07 { add("sysretq"); }
    }
    match e.mnemonic {
        "PCMPESTRI" => add("pcmpestri64"), "PCMPESTRM" => add("pcmpestrm64"),
        "VPCMPESTRI" => add("vpcmpestri64"), "VPCMPESTRM" => add("vpcmpestrm64"),
        "KMOVW" => add("kmov"),
        "FDISI8087_NOP" => add("fndisi"), "FENI8087_NOP" => add("fneni"), "FSETPM287_NOP" => add("fnsetpm"),
        "XCRYPT_CBC" => add("xcryptcbc"), "XCRYPT_CFB" => add("xcryptcfb"), "XCRYPT_CTR" => add("xcryptctr"),
        "XCRYPT_ECB" => add("xcryptecb"), "XCRYPT_OFB" => add("xcryptofb"),
        _ => {}
    }
    if e.kind == 0 && e.map == 0 {
        match e.opcode {
            0x60 => {add("pushaw");add("pushad");add("pushal");}
            0x61 => {add("popaw");add("popad");add("popal");}
            0x98 => { add("cbw"); add("cwde"); add("cdqe"); }
            0x99 => { add("cwd"); add("cdq"); add("cqo"); }
            0xcf => { add("iret"); add("iretd"); add("iretq"); }
            0xe3 => { add("jcxz"); add("jecxz"); add("jrcxz"); }
            0xe1 => add("loopz"),
            0xe0 => add("loopnz"),
            0xcb | 0xca => add("ret far"),
            _ => {}
        }
    }
}

/// The explicit operands of a form in decode order, with the encoder field
/// each one lives in. Returns whether the form takes an EVEX `{k}` decoration.
fn explicit_fields(e: &Encoding, out: &mut Vec<(Field, &'static OperandSpec)>) -> bool {
    let specs = &OPERANDS[e.operand_start as usize..e.operand_start as usize + e.operand_len as usize];
    let gather = e.mnemonic.contains("GATHER") || e.mnemonic.contains("SCATTER");
    let mut decorated = false;
    let mut tail = 0u8;
    for spec in specs {
        let field = if !spec.value.is_empty() { Some(Field::Fixed) }
            else if matches!(spec.kind, "MEM" | "MIB" | "AGEN") { Some(Field::Memory) }
            else if spec.kind == "MOFFS" { tail += 1; Some(Field::Moffs(tail - 1)) }
            else if spec.kind == "PTR" { tail += 1; Some(Field::Pointer) }
            else if spec.kind == "REL" { tail += 1; Some(Field::Relative(tail - 1)) }
            else if spec.kind == "IMM" || is_tail_encoding(spec.encoded_in) { tail += 1; Some(Field::Immediate(tail - 1)) }
            else {
                match spec.encoded_in {
                    "REG" => Some(Field::Reg),
                    "RM" => Some(Field::Rm),
                    "VVVV" => Some(Field::Vvvv),
                    "OPCODE" => Some(Field::OpcodeReg),
                    "AAA" => Some(Field::Mask),
                    "IS4" => Some(Field::Is4(tail)),
                    "OSZ" | "ASZ" => Some(Field::Fixed),
                    _ => None,
                }
            };
        let Some(field) = field else { continue };
        if spec.flags & 4 != 0 { continue; }
        if spec.kind == "PREG" && spec.encoded_in == "AAA" && !gather {
            decorated = true;
            continue;
        }
        out.push((field, spec));
    }
    decorated
}

fn build_catalog(mode: Mode) -> Catalog {
    let mut variants = Vec::new();
    let mut by_form = Vec::with_capacity(ENCODINGS.len());
    let mut skipped = Vec::new();
    let mut names: std::collections::BTreeMap<String, Vec<u32>> = std::collections::BTreeMap::new();
    let mut fields_list = Vec::new();
    let mut display = Vec::new();
    for (form, e) in ENCODINGS.iter().enumerate() {
        let start = variants.len() as u32;
        let form = form as u32;
        if !encoding_is_available_in_mode(e, mode) {
            by_form.push((start, 0));
            skipped.push((form, "not available in selected mode"));
            continue;
        }
        display.clear();
        form_display_names(e, &mut display);
        display.sort();
        display.dedup();
        for name in display.drain(..) { names.entry(name).or_default().push(form); }
        if e.kind == 3 {
            by_form.push((start, 0));
            skipped.push((form, "MVEX (Knights Corner) has no encoder or decoder"));
            continue;
        }
        fields_list.clear();
        let decorated = explicit_fields(e, &mut fields_list);
        let vsib = fields_list.iter().find_map(|(_, spec)| match spec.symbol { "VMX" => Some(128u16), "VMY" => Some(256), "VMZ" => Some(512), _ => None }).unwrap_or(0);
        let has_mask_field = (0..e.operand_len as usize).any(|i| OPERANDS[e.operand_start as usize + i].encoded_in == "AAA");
        let mut options = vec![(false, false, false)];
        // 0x66 on a near branch, call or return means a 16-bit operation to
        // AMD and is ignored by Intel in 64-bit mode, so the assembler never
        // chooses it (matching still follows the decoder).
        let flow = e.flow_control != FlowControl::Next;
        if e.kind == 0 && e.operand_size == 0 && e.mandatory != 1 && (mode != Mode::Mode64 || !flow) { options.push((true, false, false)); }
        if mode == Mode::Mode64 && e.kind == 0 && e.operand_size == 0 && e.w == -1 { options.push((false, true, false)); }
        // Explicit address-size registers (GPRa) print 32-bit under 0x67.
        if fields_list.iter().any(|(_, spec)| spec.symbol == "GPRa" || matches!(spec.value, "AXa" | "BXa" | "CXa" | "DXa" | "SIa" | "DIa")) {
            options.push((false, false, true));
        }
        let mut reason = "no representative encoding decodes as this form";
        for (operand_override, rex_w, address_override) in options {
            let mut found = None;
            for choice in 0..3 {
                let mut fields = representative_fields(e, &fields_list, choice, operand_override, rex_w, vsib, has_mask_field, mode);
                fields.address_override = address_override;
                let mut out = [0u8; 15];
                let Ok(length) = encode(form as usize, fields, &mut out) else { continue };
                let Ok(decoded) = decode(&out[..length], mode) else { continue };
                if decoded.form_index == form && decoded.length as usize == length {
                    found = Some((fields, decoded));
                    break;
                }
            }
            let Some((fields, decoded)) = found else { continue };
            let representative = view(&decoded);
            match build_variant(e, form, fields, &representative, &fields_list, decorated) {
                Ok(variant) => {
                    let duplicate = variants[start as usize..].iter().any(|known: &Variant| same_shape(known, &variant) && (mode==Mode::Mode64 || known.fields.operand_override==variant.fields.operand_override));
                    if !duplicate { variants.push(variant); }
                }
                Err(why) => reason = why,
            }
            if let Some(alias)=self_xchg_view(&decoded) {
                if let Ok(variant)=build_variant(e,form,fields,&alias,&[],false) {
                    if !variants[start as usize..].iter().any(|known|same_shape(known,&variant)) {variants.push(variant);}
                }
            }
        }
        let count = variants.len() as u32 - start;
        by_form.push((start, count as u8));
        if count == 0 { skipped.push((form, reason)); }
    }
    drop_redundant_prefix_variants(&mut variants, &mut by_form, &mut skipped);
    Catalog { variants, by_form, names: names.into_iter().collect(), skipped }
}

/// A variant that adds 0x66, REX.W or 0x67 to a form is redundant when another
/// form with the same opcode bytes already prints the same shape without it
/// (for example a W1 form shadowing the default-size form): drop it so
/// encoding never emits the redundant prefix.
fn drop_redundant_prefix_variants(variants: &mut Vec<Variant>, by_form: &mut [(u32, u8)], skipped: &mut Vec<(u32, &'static str)>) {
    let prefixed = |variant: &Variant| variant.fields.operand_override || variant.fields.rex_w || variant.fields.address_override;
    let key = |variant: &Variant| {
        let e = variant.encoding();
        (variant.mnemonic.to_ascii_lowercase(), e.kind, e.map, e.opcode, e.mandatory)
    };
    let mut by_name: std::collections::BTreeMap<(String, u8, u8, u8, u8), Vec<usize>> = std::collections::BTreeMap::new();
    for (index, variant) in variants.iter().enumerate() {
        if !prefixed(variant) { by_name.entry(key(variant)).or_default().push(index); }
    }
    let keep: Vec<bool> = variants.iter().map(|variant| {
        variant.fields.mode!=Mode::Mode64 || !prefixed(variant) || !by_name.get(&key(variant)).is_some_and(|plain| {
            plain.iter().any(|index| same_shape(&variants[*index], variant))
        })
    }).collect();
    let mut kept = Vec::with_capacity(variants.len());
    for (form, entry) in by_form.iter_mut().enumerate() {
        let (start, count) = *entry;
        let first = kept.len() as u32;
        for index in start as usize..start as usize + count as usize {
            if keep[index] { kept.push(variants[index]); }
        }
        let remaining = kept.len() as u32 - first;
        *entry = (first, remaining as u8);
        if count > 0 && remaining == 0 { skipped.push((form as u32, "only redundant-prefix encodings of another form's shape")); }
    }
    skipped.sort_by_key(|(form, _)| *form);
    *variants = kept;
}

fn representative_fields(
    e: &Encoding, fields_list: &[(Field, &'static OperandSpec)], choice: usize,
    operand_override: bool, rex_w: bool, vsib: u16, has_mask_field: bool, mode: Mode,
) -> EncodeFields {
    let register = if mode == Mode::Mode64 { [0u8, 1, 9][choice] } else { [0u8, 1, 3][choice] };
    let memory = e.has_modrm && e.mod_kind == 1;
    let mut fields = EncodeFields {
        mode,
        mod_bits: if memory { 0 } else { 3 },
        reg: e.reg_value,
        rm: e.rm_value,
        operand_override,
        rex_w,
        mask: if has_mask_field && e.kind == 2 { 1 } else { 0 },
        broadcast: e.evex_value & 16 != 0,
        ..EncodeFields::default()
    };
    let uses = |wanted: Field| fields_list.iter().any(|(field, _)| *field == wanted);
    if e.reg_mask == 0 && uses(Field::Reg) { fields.reg = register; }
    if !memory && e.rm_mask == 0 && uses(Field::Rm) { fields.rm = register; }
    if memory {
        if e.rm_mask == 0 { fields.rm = 0; }
        if vsib != 0 { fields.rm = 4; fields.index = 1; fields.base = 0; }
        if fields.rm & 7 == 4 { fields.use_sib = true; if vsib == 0 { fields.index = 4; fields.base = 0; } }
    }
    for (field, _) in fields_list {
        match field {
            Field::Vvvv => fields.vvvv = register,
            Field::OpcodeReg => { fields.opcode_reg = register; if !e.has_modrm { fields.rm = register; } }
            _ => {}
        }
    }
    if e.no_source_dest_match {
        fields.vvvv = (fields.reg + 1) % if mode == Mode::Mode64 { 32 } else { 8 };
        if !memory { fields.rm = (fields.reg + 2) % if mode == Mode::Mode64 { 32 } else { 8 }; }
    }
    fields
}

fn build_variant(
    e: &Encoding, form: u32, fields: EncodeFields, representative: &View,
    fields_list: &[(Field, &'static OperandSpec)], decorated: bool,
) -> Result<Variant, &'static str> {
    if representative.overflow { return Err("more operands than the template view holds"); }
    let mut variant = Variant {
        form, fields, mnemonic: representative.mnemonic, operands: [None; VIEW_OPERANDS],
        count: representative.count, decoration: None,
    };
    let operands = representative.operands();
    let nop_hint = e.kind == 0 && e.map == 1 && e.opcode == 0x18 && representative.mnemonic.eq_ignore_ascii_case("nop");
    let field_at = |index: usize| -> Result<Field, &'static str> {
        if fields_list.is_empty() { return Ok(Field::Fixed); }
        if operands.len() == fields_list.len() { return Ok(fields_list[index].0); }
        if nop_hint && operands.len() == fields_list.len() + 1 {
            return Ok(if index == fields_list.len() { Field::Reg } else { fields_list[index].0 });
        }
        if operands.len() == 1 && representative.mnemonic.len() >= 5 && representative.mnemonic[..5].eq_ignore_ascii_case("rdssp") {
            return fields_list.iter().find(|(field, _)| matches!(field, Field::Reg | Field::Rm)).map(|(field, _)| *field)
                .ok_or("formatted operands differ from the form's operands");
        }
        Err("formatted operands differ from the form's operands")
    };
    for (index, operand) in operands.iter().enumerate() {
        let field = field_at(index)?;
        let fixed = field == Field::Fixed;
        let kind = match *operand {
            ViewOperand::Register(register) => ShapeKind::Register { register, fixed },
            ViewOperand::Memory(memory) => {
                let vsib = memory.index.filter(|index| index.class == RegisterClass::Vector).map_or(0, |index| register_key(index).2);
                ShapeKind::Memory { memory, fixed, vsib, moffs: matches!(field, Field::Moffs(_)) }
            }
            ViewOperand::Immediate { value, .. } => ShapeKind::Immediate { value, fixed },
            ViewOperand::Relative{..} => ShapeKind::Relative,
            ViewOperand::Pointer(_) | ViewOperand::FarPointer { .. } => ShapeKind::Pointer,
            ViewOperand::Text(text) => ShapeKind::Text(text),
        };
        let field = match (field, kind) {
            (Field::Memory | Field::Moffs(_), ShapeKind::Memory { .. }) | (Field::Fixed, _) => field,
            (Field::Reg | Field::Rm | Field::Vvvv | Field::OpcodeReg | Field::Mask | Field::Is4(_), ShapeKind::Register { .. }) => field,
            (Field::Immediate(_), ShapeKind::Immediate { .. }) | (Field::Relative(_), ShapeKind::Relative) => field,
            (Field::Pointer, ShapeKind::Pointer) => field,
            _ => return Err("formatted operand kind differs from its encoder field"),
        };
        variant.operands[index] = Some(ShapeOperand { kind, field });
    }
    if decorated && e.kind == 2 {
        variant.decoration = Some(if representative.mask != 0 { representative.mask_after } else { 1.min(variant.count) });
    }
    Ok(variant)
}

fn same_shape(a: &Variant, b: &Variant) -> bool {
    if !a.mnemonic.eq_ignore_ascii_case(b.mnemonic) || a.count != b.count || a.decoration != b.decoration { return false; }
    (0..a.count as usize).all(|i| match (a.operand(i).kind, b.operand(i).kind) {
        (ShapeKind::Register { register: x, fixed: fx }, ShapeKind::Register { register: y, fixed: fy }) => {
            fx == fy && { let (kx, ky) = (register_key(x), register_key(y)); kx.0 == ky.0 && kx.2 == ky.2 && kx.3 == ky.3 && (!fx || kx.1 == ky.1) }
        }
        (ShapeKind::Memory { memory: x, fixed: fx, vsib: vx, moffs: mx }, ShapeKind::Memory { memory: y, fixed: fy, vsib: vy, moffs: my }) =>
            fx == fy && vx == vy && mx == my && x.size == y.size && x.prefix == y.prefix && (!fx || x == y),
        (ShapeKind::Immediate { value: x, fixed: fx }, ShapeKind::Immediate { value: y, fixed: fy }) => fx == fy && (!fx || x == y),
        (ShapeKind::Relative, ShapeKind::Relative) | (ShapeKind::Pointer, ShapeKind::Pointer) => true,
        (ShapeKind::Text(x), ShapeKind::Text(y)) => x.eq_ignore_ascii_case(y),
        _ => false,
    })
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
enum ConditionFamily { Jump, Move, Set }

impl ConditionFamily {
    fn from_prefix(prefix: &str) -> Option<Self> {
        match prefix { "j" => Some(Self::Jump), "cmov" => Some(Self::Move), "set" => Some(Self::Set), _ => None }
    }
}

fn condition_code(e: &Encoding, family: ConditionFamily) -> Option<u8> {
    if e.kind != 0 { return None; }
    let base = match (family, e.map) {
        (ConditionFamily::Jump, 0) => 0x70,
        (ConditionFamily::Jump, 1) => 0x80,
        (ConditionFamily::Move, 1) => 0x40,
        (ConditionFamily::Set, 1) => 0x90,
        _ => return None,
    };
    (e.opcode & 0xf0 == base).then_some(e.opcode & 0x0f)
}

fn condition_from_name(name: &str) -> Option<u8> {
    CONDITION_NAMES.iter().position(|known| *known == name).map(|index| index as u8)
        .or_else(|| CONDITION_ALIASES.iter().find(|(alias, _)| *alias == name).map(|(_, value)| *value))
}

// ---------------------------------------------------------------------------
// Template patterns
// ---------------------------------------------------------------------------

/// One open operand component of a template.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct Hole {
    name: String,
    restriction: Option<OperandClass>,
    classes: Vec<OperandClass>,
    position: Option<Position>,
    domains: Vec<ClassDomain>,
}

impl Hole {
    pub fn name(&self) -> &str { &self.name }
    /// How the values this hole binds relate to the instruction's position,
    /// known from the text alone; `None` when the candidate forms disagree.
    /// Every value a match binds carries the same [`OperandValue::position`].
    pub fn position(&self) -> Option<Position> { self.position }
    /// The values the hole can hold, per accepted class: the union over the
    /// candidate forms the text fits, computed when the template is compiled.
    /// One class has several entries when its forms differ in a way one
    /// progression cannot express. Every value `matches` binds lies in one, an
    /// `exact` entry's values all encode, and a value in no entry of its class is
    /// refused by `encode`.
    pub fn domains(&self) -> &[ClassDomain] { &self.domains }
    /// The class written as `$name:class`, if any.
    pub fn restriction(&self) -> Option<OperandClass> { self.restriction }
    /// Every class this hole can take across the template's candidate forms.
    pub fn classes(&self) -> &[OperandClass] { &self.classes }
    pub fn accepts(&self, class: OperandClass) -> bool {
        self.restriction.map_or_else(|| self.classes.contains(&class), |restriction| restriction == class)
    }
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
enum PatRegister { Absent, Rip, Eip, Fixed(Register), Hole(u8) }

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
enum PatScale { Fixed(u8), Hole(u8) }

#[derive(Clone, Debug, Eq, PartialEq)]
struct PatMemory {
    prefix: MemoryPrefix,
    size: Option<u16>,
    segment: Option<Register>,
    base: PatRegister,
    index: PatRegister,
    scale: PatScale,
    displacement: i64,
    displacement_hole: Option<(u8, bool)>,
    /// A RIP-relative displacement given as a hole value: measured from the
    /// instruction's first byte, so the encoder subtracts the length.
    start_relative: bool,
    offset: usize,
}

#[derive(Clone, Debug, Eq, PartialEq)]
enum PatOperand {
    Any,
    Hole(u8),
    Register(Register),
    /// A bare number: an immediate, or an absolute branch target when the template has an address.
    Number(i128),
    Immediate(i128),
    FarPointer { offset: u64, selector: u16 },
    /// `.+N`: a branch displacement from the instruction's first byte.
    Relative(i128),
    Memory(PatMemory),
    Text(String),
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
enum PatCondition { Hole(u8), Fixed(u8) }

#[derive(Clone, Debug, Eq, PartialEq)]
enum PatMnemonic {
    Exact(String),
    Condition { prefix: String, family: ConditionFamily, code: PatCondition },
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
struct Decoration { after: u8, mask: u8, zeroing: bool }

/// One instruction's text with zero or more open operands, resolved to the
/// candidate forms that accept it (64-bit mode).
#[derive(Clone, Debug)]
pub struct Template {
    mode: Mode,
    text: String,
    address: Option<u64>,
    mnemonic: PatMnemonic,
    lock: bool,
    repeat: u8,
    operands: Vec<PatOperand>,
    decoration: Option<Decoration>,
    rounding: Option<u8>,
    /// 0 when open (the memory registers are unrestricted holes), else 32 or 64.
    address_size: u8,
    holes: Vec<Hole>,
    forms: Vec<u64>,
    variants: Vec<u32>,
    first_bytes: [u64; 4],
    /// Bytes that may follow the prefixes (the opcode or an escape byte).
    opcode_bytes: [u64; 4],
    /// Some candidate form does not show `f2`/`f3` as `rep`/`repnz`.
    repeat_open: bool,
}

// ---------------------------------------------------------------------------
// Lexer and parser
// ---------------------------------------------------------------------------

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
enum TokenKind { Ident, Number, Hole, Punct(u8), End }

#[derive(Clone, Copy, Debug)]
struct Token<'a> { kind: TokenKind, text: &'a str, start: usize, end: usize, value: u128 }

fn syntax(offset: usize, message: impl Into<String>) -> AssembleError {
    AssembleError::Syntax { offset, message: message.into() }
}

fn lex(text: &str) -> Result<Vec<Token<'_>>, AssembleError> {
    let bytes = text.as_bytes();
    let mut tokens = Vec::new();
    let mut pos = 0;
    let ident = |byte: u8| byte.is_ascii_alphanumeric() || byte == b'_';
    while pos < bytes.len() {
        let byte = bytes[pos];
        let start = pos;
        if byte.is_ascii_whitespace() { pos += 1; continue; }
        if byte.is_ascii_alphabetic() || byte == b'_' {
            while pos < bytes.len() && ident(bytes[pos]) { pos += 1; }
            tokens.push(Token { kind: TokenKind::Ident, text: &text[start..pos], start, end: pos, value: 0 });
        } else if byte.is_ascii_digit() {
            let hex = byte == b'0' && pos + 1 < bytes.len() && matches!(bytes[pos + 1], b'x' | b'X');
            if hex { pos += 2; }
            let digits = pos;
            while pos < bytes.len() && ident(bytes[pos]) { pos += 1; }
            let digits_text = &text[digits..pos];
            let value = if hex { u128::from_str_radix(digits_text, 16) } else { digits_text.parse::<u128>() };
            let value = value.ok().filter(|value| *value <= u128::from(u64::MAX))
                .ok_or_else(|| syntax(start, format!("bad number `{}`", &text[start..pos])))?;
            tokens.push(Token { kind: TokenKind::Number, text: &text[start..pos], start, end: pos, value });
        } else if byte == b'$' {
            pos += 1;
            while pos < bytes.len() && ident(bytes[pos]) { pos += 1; }
            if pos == start + 1 { return Err(syntax(start, "`$` must be followed by a hole name")); }
            tokens.push(Token { kind: TokenKind::Hole, text: &text[start + 1..pos], start, end: pos, value: 0 });
        } else if b",[]+-*:{}().".contains(&byte) {
            pos += 1;
            tokens.push(Token { kind: TokenKind::Punct(byte), text: &text[start..pos], start, end: pos, value: 0 });
        } else {
            return Err(syntax(start, format!("unexpected character `{}`", text[start..].chars().next().unwrap_or('?'))));
        }
    }
    tokens.push(Token { kind: TokenKind::End, text: "", start: text.len(), end: text.len(), value: 0 });
    Ok(tokens)
}

struct HoleDef { name: String, restriction: Option<OperandClass> }

struct Parser<'a> {
    mode: Mode,
    tokens: Vec<Token<'a>>,
    pos: usize,
    holes: Vec<HoleDef>,
}

struct ParsedLine {
    lock: bool,
    repeat: u8,
    mnemonic: PatMnemonic,
    operands: Vec<PatOperand>,
    decoration: Option<Decoration>,
    rounding: Option<u8>,
}

fn parse_register_name(name: &str) -> Option<Register> {
    let position = |names: &[&str]| names.iter().position(|known| *known == name).map(|index| index as u8);
    if let Some(number) = position(&LOW8_NAMES) { return Some(gpr(number, 8, false)); }
    if let Some(number) = position(&HIGH8_NAMES) { return Some(gpr(number + 4, 8, true)); }
    if let Some(number) = position(&R16_NAMES) { return Some(gpr(number, 16, false)); }
    if let Some(number) = position(&R32_NAMES) { return Some(gpr(number, 32, false)); }
    if let Some(number) = position(&R64_NAMES) { return Some(gpr(number, 64, false)); }
    if let Some(number) = position(&SEGMENT_NAMES) { return Some(Register { class: RegisterClass::Segment, number, width: 16, high8: false }); }
    if name == "st" { return Some(Register { class: RegisterClass::X87, number: 0, width: 80, high8: false }); }
    if let Some(inner) = name.strip_prefix("st(").and_then(|rest| rest.strip_suffix(')')) {
        let number: u8 = inner.trim().parse().ok().filter(|number| *number < 8)?;
        return Some(Register { class: RegisterClass::X87, number, width: 80, high8: false });
    }
    let numbered = |prefix: &str, limit: u8| -> Option<u8> {
        let digits = name.strip_prefix(prefix)?;
        if digits.is_empty() || !digits.bytes().all(|byte| byte.is_ascii_digit()) || (digits.len() > 1 && digits.starts_with('0')) { return None; }
        digits.parse::<u8>().ok().filter(|number| *number < limit)
    };
    for (prefix, class, width, limit) in [
        ("xmm", RegisterClass::Vector, 128, 32), ("ymm", RegisterClass::Vector, 256, 32), ("zmm", RegisterClass::Vector, 512, 32),
        ("bnd", RegisterClass::Bound, 128, 4), ("cr", RegisterClass::Control, 64, 16), ("dr", RegisterClass::Debug, 64, 16),
        ("mm", RegisterClass::Mmx, 64, 8), ("k", RegisterClass::Mask, 64, 8),
    ] {
        if let Some(number) = numbered(prefix, limit) { return Some(Register { class, number, width, high8: false }); }
    }
    None
}

fn parse_signed_text(text: &str) -> Option<i128> {
    let (negative, digits) = match text.strip_prefix('-') {
        Some(rest) => (true, rest.trim_start()),
        None => (false, text.strip_prefix('+').unwrap_or(text).trim_start()),
    };
    let magnitude = match digits.strip_prefix("0x").or_else(|| digits.strip_prefix("0X")) {
        Some(hex) => u64::from_str_radix(hex, 16).ok()?,
        None => digits.parse::<u64>().ok()?,
    };
    Some(if negative { -i128::from(magnitude) } else { i128::from(magnitude) })
}

fn segment_override_byte(segment: Register) -> u8 {
    match segment.number { 0 => 0x26, 1 => 0x2e, 2 => 0x36, 3 => 0x3e, 4 => 0x64, _ => 0x65 }
}

fn size_from_keyword(word: &str) -> Option<u16> {
    Some(match word {
        "byte" => 8, "word" => 16, "dword" => 32, "fword" => 48, "qword" => 64, "tbyte" => 80,
        "xmmword" => 128, "ymmword" => 256, "zmmword" => 512, _ => return None,
    })
}

impl<'a> Parser<'a> {
    fn peek(&self) -> Token<'a> { self.tokens[self.pos] }
    fn peek_at(&self, ahead: usize) -> Token<'a> { self.tokens[(self.pos + ahead).min(self.tokens.len() - 1)] }
    fn bump(&mut self) -> Token<'a> {
        let token = self.tokens[self.pos];
        if self.pos + 1 < self.tokens.len() { self.pos += 1; }
        token
    }
    fn is_punct(&self, byte: u8) -> bool { self.peek().kind == TokenKind::Punct(byte) }
    fn expect_punct(&mut self, byte: u8, what: &str) -> Result<Token<'a>, AssembleError> {
        if self.is_punct(byte) { Ok(self.bump()) } else { Err(syntax(self.peek().start, format!("expected {what}"))) }
    }
    fn word(&self) -> Option<String> {
        let token = self.peek();
        (token.kind == TokenKind::Ident).then(|| token.text.to_ascii_lowercase())
    }

    fn hole(&mut self) -> Result<u8, AssembleError> {
        let token = self.bump();
        let mut restriction = None;
        if self.is_punct(b':') && self.peek_at(1).kind == TokenKind::Ident {
            self.bump();
            let class = self.bump();
            restriction = Some(OperandClass::from_name(class.text).ok_or_else(|| AssembleError::UnknownClass {
                offset: class.start, name: class.text.to_string(), classes: OperandClass::names().collect(),
            })?);
        }
        let name = token.text.to_string();
        if let Some(index) = self.holes.iter().position(|hole| hole.name == name) {
            let hole = &mut self.holes[index];
            match (hole.restriction, restriction) {
                (Some(known), Some(new)) if known != new => return Err(syntax(token.start, format!("hole `{name}` is restricted to both {known} and {new}"))),
                (None, Some(new)) => hole.restriction = Some(new),
                _ => {}
            }
            return Ok(index as u8);
        }
        if self.holes.len() >= MAX_HOLES { return Err(AssembleError::TooManyHoles { limit: MAX_HOLES }); }
        self.holes.push(HoleDef { name, restriction });
        Ok((self.holes.len() - 1) as u8)
    }

    fn number(&mut self, what: &str) -> Result<i128, AssembleError> {
        let token = self.peek();
        if token.kind != TokenKind::Number { return Err(syntax(token.start, format!("expected {what}"))); }
        self.bump();
        Ok(token.value as i128)
    }

    fn line(&mut self) -> Result<ParsedLine, AssembleError> {
        let mut lock = false;
        let mut repeat = 0u8;
        loop {
            let Some(word) = self.word() else { break };
            if self.peek_at(1).kind != TokenKind::Ident { break; }
            match word.as_str() {
                "lock" => lock = true,
                "rep" | "repe" | "repz" => repeat = 2,
                "repne" | "repnz" => repeat = 4,
                _ => break,
            }
            self.bump();
        }
        let token = self.peek();
        if token.kind != TokenKind::Ident { return Err(syntax(token.start, "expected a mnemonic")); }
        self.bump();
        let mut name = token.text.to_ascii_lowercase();
        let mnemonic = if self.peek().kind == TokenKind::Hole && self.peek().start == token.end {
            let family = ConditionFamily::from_prefix(&name).ok_or_else(|| syntax(self.peek().start,
                "condition-code holes are supported in `j$cc`, `cmov$cc` and `set$cc`"))?;
            let slot = self.hole()?;
            PatMnemonic::Condition { prefix: name, family, code: PatCondition::Hole(slot) }
        } else {
            if name == "ret" && self.word().as_deref() == Some("far") { self.bump(); name = "ret far".to_string(); }
            if self.mode!=Mode::Mode64 {name=match name.as_str() {
                "pusha"=>if self.mode==Mode::Mode16 {"pushaw"}else{"pushad"}.to_string(),
                "popa"=>if self.mode==Mode::Mode16 {"popaw"}else{"popad"}.to_string(),
                "pushal"=>"pushad".to_string(),"popal"=>"popad".to_string(),_=>name};}
            PatMnemonic::Exact(name)
        };
        let mut operands = Vec::new();
        let mut decoration = None;
        let mut rounding = None;
        if self.peek().kind != TokenKind::End {
            loop {
                if self.is_punct(b'{') {
                    let open = self.bump();
                    let word = self.word().unwrap_or_default();
                    self.bump();
                    rounding = Some(match word.as_str() {
                        "sae" => 4,
                        "rn" | "rd" | "ru" | "rz" => {
                            self.expect_punct(b'-', "`-sae`")?;
                            if self.word().as_deref() != Some("sae") { return Err(syntax(self.peek().start, "expected `sae`")); }
                            self.bump();
                            match word.as_str() { "rn" => 0, "rd" => 1, "ru" => 2, _ => 3 }
                        }
                        _ => return Err(syntax(open.start, "expected `{sae}` or an embedded rounding decoration")),
                    });
                    self.expect_punct(b'}', "`}`")?;
                    if self.peek().kind != TokenKind::End { return Err(syntax(self.peek().start, "rounding decoration must end the instruction")); }
                    break;
                }
                operands.push(self.operand()?);
                while self.is_punct(b'{') {
                    let open = self.bump();
                    let word = self.word().unwrap_or_default();
                    let current = decoration.get_or_insert(Decoration { after: operands.len() as u8, mask: 0, zeroing: false });
                    if current.after != operands.len() as u8 { return Err(syntax(open.start, "only one operand can carry a mask decoration")); }
                    if word == "z" {
                        current.zeroing = true;
                    } else if let Some(register) = parse_register_name(&word).filter(|register| register.class == RegisterClass::Mask) {
                        current.mask = register.number;
                    } else {
                        let mut message = String::from("unsupported decoration `{");
                        message.push_str(&word);
                        message.push_str("}`: only `{k1}`..`{k7}` and `{z}` are supported");
                        return Err(syntax(open.start, message));
                    }
                    self.bump();
                    self.expect_punct(b'}', "`}`")?;
                }
                if self.is_punct(b',') { self.bump(); continue; }
                if self.peek().kind == TokenKind::End { break; }
                return Err(syntax(self.peek().start, "expected `,` or the end of the instruction"));
            }
        }
        if let Some(decoration) = decoration {
            if decoration.mask == 0 {
                return Err(syntax(0, "`{z}` needs a mask register decoration such as `{k1}`"));
            }
        }
        Ok(ParsedLine { lock, repeat, mnemonic, operands, decoration, rounding })
    }

    fn operand(&mut self) -> Result<PatOperand, AssembleError> {
        let token = self.peek();
        match token.kind {
            TokenKind::Ident if token.text == "_" => { self.bump(); Ok(PatOperand::Any) }
            TokenKind::Hole => Ok(PatOperand::Hole(self.hole()?)),
            TokenKind::Punct(b'.') => {
                self.bump();
                let negative = match self.peek().kind {
                    TokenKind::Punct(b'+') => false,
                    TokenKind::Punct(b'-') => true,
                    _ => return Err(syntax(self.peek().start, "expected `.+N` or `.-N`")),
                };
                self.bump();
                let value = self.number("a branch displacement")?;
                Ok(PatOperand::Relative(if negative { -value } else { value }))
            }
            TokenKind::Punct(sign @ (b'+' | b'-')) => {
                self.bump();
                let value = self.number("a number")?;
                Ok(PatOperand::Number(if sign == b'-' { -value } else { value }))
            }
            TokenKind::Number => Ok(PatOperand::Number(self.number("a number")?)),
            TokenKind::Punct(b'[') => Ok(PatOperand::Memory(self.memory()?)),
            TokenKind::Ident => {
                let word = token.text.to_ascii_lowercase();
                if word == "far" && self.peek_at(1).kind == TokenKind::Number {
                    self.bump();
                    let offset = self.number("a far pointer offset")?;
                    self.expect_punct(b',', "`,` before the selector")?;
                    let selector = self.number("a far pointer selector")?;
                    return Ok(PatOperand::FarPointer { offset: u64::try_from(offset).map_err(|_| syntax(token.start,"far pointer offset is out of range"))?, selector: u16::try_from(selector).map_err(|_| syntax(token.start,"far pointer selector is out of range"))? });
                }
                if matches!(word.as_str(), "far" | "fpuenv14" | "fpustate94" | "ptr") || size_from_keyword(&word).is_some() {
                    return Ok(PatOperand::Memory(self.memory()?));
                }
                if word == "st" && self.peek_at(1).kind == TokenKind::Punct(b'(') {
                    self.bump(); self.bump();
                    let number = self.number("an x87 register number")?;
                    self.expect_punct(b')', "`)`")?;
                    return parse_register_name(&format!("st({number})")).map(PatOperand::Register)
                        .ok_or_else(|| syntax(token.start, "x87 registers are st(0)..st(7)"));
                }
                if let Some(register) = parse_register_name(&word) {
                    if register.class == RegisterClass::Segment && self.peek_at(1).kind == TokenKind::Punct(b':') {
                        return Ok(PatOperand::Memory(self.memory()?));
                    }
                    self.bump();
                    return Ok(PatOperand::Register(register));
                }
                self.bump();
                Ok(PatOperand::Text(word))
            }
            _ => Err(syntax(token.start, "expected an operand")),
        }
    }

    fn memory(&mut self) -> Result<PatMemory, AssembleError> {
        let offset = self.peek().start;
        let mut prefix = MemoryPrefix::None;
        let mut size = None;
        let mut segment = None;
        match self.word().as_deref() {
            Some("far") => { self.bump(); prefix = MemoryPrefix::Far; }
            Some("fpuenv14") => { self.bump(); prefix = MemoryPrefix::FpuEnv14; if self.word().as_deref() == Some("ptr") { self.bump(); } }
            Some("fpustate94") => { self.bump(); prefix = MemoryPrefix::FpuState94; if self.word().as_deref() == Some("ptr") { self.bump(); } }
            _ => {}
        }
        if let Some(bits) = self.word().as_deref().and_then(size_from_keyword) {
            self.bump();
            size = Some(bits);
        }
        if self.word().as_deref() == Some("ptr") { self.bump(); }
        if let Some(register) = self.word().as_deref().and_then(parse_register_name).filter(|register| register.class == RegisterClass::Segment) {
            if self.peek_at(1).kind == TokenKind::Punct(b':') {
                self.bump(); self.bump();
                segment = Some(register);
            }
        }
        self.expect_punct(b'[', "`[`")?;
        let mut memory = PatMemory {
            prefix, size, segment, base: PatRegister::Absent, index: PatRegister::Absent,
            scale: PatScale::Fixed(1), displacement: 0, displacement_hole: None, start_relative: false, offset,
        };
        let mut displacement: i128 = 0;
        let mut negative = false;
        let mut terms = 0usize;
        let invalid = |reason| AssembleError::InvalidAddress { offset, reason };
        loop {
            while let TokenKind::Punct(sign @ (b'+' | b'-')) = self.peek().kind {
                self.bump();
                if sign == b'-' { negative = !negative; }
            }
            let token = self.peek();
            let sign: i128 = if negative { -1 } else { 1 };
            match token.kind {
                TokenKind::Number => {
                    self.bump();
                    let value = token.value as i128;
                    if self.is_punct(b'*') {
                        self.bump();
                        if negative { return Err(invalid("a scaled index cannot be subtracted")); }
                        let index = self.memory_register()?;
                        self.set_index(&mut memory, index, PatScale::Fixed(u8::try_from(value).unwrap_or(0)), offset)?;
                    } else {
                        displacement += sign * value;
                    }
                }
                TokenKind::Ident => {
                    let word = token.text.to_ascii_lowercase();
                    if word == "rip" || word == "eip" {
                        self.bump();
                        if negative || memory.base != PatRegister::Absent { return Err(invalid("rip must be the first, added term")); }
                        memory.base = if word == "eip" { PatRegister::Eip } else { PatRegister::Rip };
                    } else if let Some(register) = parse_register_name(&word) {
                        self.bump();
                        if negative { return Err(invalid("registers cannot be subtracted")); }
                        if self.is_punct(b'*') {
                            self.bump();
                            let scale = self.memory_scale()?;
                            self.set_index(&mut memory, PatRegister::Fixed(register), scale, offset)?;
                        } else if memory.base == PatRegister::Absent {
                            memory.base = PatRegister::Fixed(register);
                        } else {
                            self.set_index(&mut memory, PatRegister::Fixed(register), PatScale::Fixed(1), offset)?;
                        }
                    } else {
                        return Err(syntax(token.start, format!("`{word}` is not a register")));
                    }
                }
                TokenKind::Hole => {
                    let slot = self.hole()?;
                    let restriction = self.holes[slot as usize].restriction;
                    if self.is_punct(b'*') {
                        self.bump();
                        if negative { return Err(invalid("a scaled index cannot be subtracted")); }
                        let scale = self.memory_scale()?;
                        self.set_index(&mut memory, PatRegister::Hole(slot), scale, offset)?;
                    } else {
                        let register = restriction.is_some_and(OperandClass::is_register);
                        if restriction.is_some_and(|class| !class.is_register() && class != OperandClass::Displacement) {
                            return Err(invalid("a memory hole is a register or a displacement"));
                        }
                        if register || (restriction.is_none() && terms == 0 && memory.base == PatRegister::Absent) {
                            if negative { return Err(invalid("registers cannot be subtracted")); }
                            if memory.base == PatRegister::Absent { memory.base = PatRegister::Hole(slot); }
                            else { self.set_index(&mut memory, PatRegister::Hole(slot), PatScale::Fixed(1), offset)?; }
                        } else {
                            if memory.displacement_hole.is_some() { return Err(invalid("only one displacement hole is supported")); }
                            memory.displacement_hole = Some((slot, negative));
                        }
                    }
                }
                _ => return Err(syntax(token.start, "expected a register, number or hole in a memory operand")),
            }
            terms += 1;
            match self.peek().kind {
                TokenKind::Punct(b'+') => { self.bump(); negative = false; }
                TokenKind::Punct(b'-') => { self.bump(); negative = true; }
                TokenKind::Punct(b']') => { self.bump(); break; }
                _ => return Err(syntax(self.peek().start, "expected `+`, `-` or `]`")),
            }
        }
        if !(-(1i128 << 63)..(1i128 << 64)).contains(&displacement) {
            return Err(invalid("the displacement does not fit in 64 bits"));
        }
        memory.displacement = displacement as u64 as i64;
        // A vector register without a base is a VSIB index.
        let vector_hole = |slot: u8| matches!(self.holes[slot as usize].restriction, Some(OperandClass::Xmm | OperandClass::Ymm | OperandClass::Zmm));
        let vector_base = match memory.base {
            PatRegister::Fixed(register) => register.class == RegisterClass::Vector,
            PatRegister::Hole(slot) => vector_hole(slot),
            _ => false,
        };
        if vector_base && memory.index == PatRegister::Absent {
            memory.index = memory.base;
            memory.base = PatRegister::Absent;
        }
        // An unscaled rsp in the index position is the base.
        if let (PatRegister::Fixed(base), PatRegister::Fixed(index), PatScale::Fixed(1)) = (memory.base, memory.index, memory.scale) {
            if index.class == RegisterClass::Gpr && index.number == 4 && !(base.class == RegisterClass::Gpr && base.number == 4) {
                memory.base = PatRegister::Fixed(index);
                memory.index = PatRegister::Fixed(base);
            }
        }
        validate_memory(&memory, self.mode).map_err(invalid)?;
        // A literal absolute address is a bit pattern in the selected address
        // width; displacement holes retain the decoder's signed field value.
        if self.mode!=Mode::Mode64 && memory.base==PatRegister::Absent && memory.index==PatRegister::Absent && memory.displacement_hole.is_none() {
            let bits=effective_address_bits(self.mode,false);
            if bits==32 && (0..=i64::from(u32::MAX)).contains(&memory.displacement) {memory.displacement=i64::from(memory.displacement as u32 as i32);}
            if bits==16 && (0..=i64::from(u16::MAX)).contains(&memory.displacement) {memory.displacement=i64::from(memory.displacement as u16 as i16);}
        }
        Ok(memory)
    }

    fn memory_register(&mut self) -> Result<PatRegister, AssembleError> {
        let token = self.peek();
        match token.kind {
            TokenKind::Hole => Ok(PatRegister::Hole(self.hole()?)),
            TokenKind::Ident => {
                let register = parse_register_name(&token.text.to_ascii_lowercase())
                    .ok_or_else(|| syntax(token.start, "expected an index register"))?;
                self.bump();
                Ok(PatRegister::Fixed(register))
            }
            _ => Err(syntax(token.start, "expected an index register")),
        }
    }

    fn memory_scale(&mut self) -> Result<PatScale, AssembleError> {
        let token = self.peek();
        match token.kind {
            TokenKind::Number => { self.bump(); Ok(PatScale::Fixed(u8::try_from(token.value).unwrap_or(0))) }
            TokenKind::Hole => Ok(PatScale::Hole(self.hole()?)),
            _ => Err(syntax(token.start, "expected a scale")),
        }
    }

    fn set_index(&mut self, memory: &mut PatMemory, index: PatRegister, scale: PatScale, offset: usize) -> Result<(), AssembleError> {
        if memory.index != PatRegister::Absent {
            return Err(AssembleError::InvalidAddress { offset, reason: "a memory operand has at most one index register" });
        }
        memory.index = index;
        memory.scale = scale;
        Ok(())
    }
}

fn validate_memory(memory: &PatMemory, mode: Mode) -> Result<(), &'static str> {
    if let PatScale::Fixed(scale) = memory.scale {
        if !matches!(scale, 1 | 2 | 4 | 8) { return Err("the scale must be 1, 2, 4 or 8"); }
    }
    if matches!(memory.base, PatRegister::Rip | PatRegister::Eip) && mode != Mode::Mode64 {return Err("rip-relative addressing requires 64-bit mode");}
    if matches!(memory.base, PatRegister::Rip | PatRegister::Eip) && memory.index != PatRegister::Absent {
        return Err("rip-relative addressing cannot use an index register");
    }
    let mut width = None;
    if let PatRegister::Fixed(base) = memory.base {
        if !register_available(base, mode) {return Err("base register is unavailable in selected mode");}
        if base.class != RegisterClass::Gpr { return Err("the base must be a general-purpose register"); }
        match base.width {
            64 | 32 if !base.high8 => width = Some(base.width),
            16 if mode != Mode::Mode64 => width = Some(16),
            _ => return Err("byte registers cannot address memory"),
        }
    }
    if let PatRegister::Fixed(index) = memory.index {
        if !register_available(index, mode) {return Err("index register is unavailable in selected mode");}
        match index.class {
            RegisterClass::Vector => {}
            RegisterClass::Gpr => {
                match index.width {
                    64 | 32 if !index.high8 => {}
                    16 if mode != Mode::Mode64 => {},
                    _ => return Err("byte registers cannot address memory"),
                }
                if index.number == 4 { return Err("rsp cannot be an index register"); }
                if width.is_some_and(|width| width != index.width) { return Err("the base and index must have the same width"); }
            }
            _ => return Err("the index must be a general-purpose or vector register"),
        }
    }
    Ok(())
}

// ---------------------------------------------------------------------------
// Compilation, matching and encoding
// ---------------------------------------------------------------------------

fn bit(bits: &[u64], index: u32) -> bool {
    bits.get(index as usize / 64).is_some_and(|word| word >> (index % 64) & 1 != 0)
}

fn fits_i32(value: i64) -> bool { i32::try_from(value).is_ok() }
fn fits_i8(value: i64) -> bool { i8::try_from(value).is_ok() }

fn immediate_equal(pattern: i128, value: u64, width: u16) -> bool {
    if pattern >= 0 {
        return pattern <= i128::from(u64::MAX) && pattern as u64 == value;
    }
    let width = if width == 0 || width > 64 { 64 } else { u32::from(width) };
    let minimum = -(1i128 << (width - 1));
    let mask = if width == 64 { u64::MAX } else { (1u64 << width) - 1 };
    pattern >= minimum && (pattern as i64 as u64) & mask == value
}

fn class_compatible(pattern: Register, shape: Register, kind: u8, mode: Mode) -> Result<(), &'static str> {
    if !register_available(pattern,mode) {return Err("register is unavailable in selected mode");}
    let (pc, pn, pw, _) = register_key(pattern);
    let (sc, _, sw, _) = register_key(shape);
    if pc != sc { return Err("register class differs"); }
    match pattern.class {
        RegisterClass::Gpr => {
            if pw != sw { return Err("register width differs"); }
            if pn >= 16 { return Err("register number out of range"); }
        }
        RegisterClass::Vector => {
            if pw != sw { return Err("vector width differs"); }
            if pn >= 16 && kind != 2 { return Err("registers 16..31 need an EVEX form"); }
        }
        _ => {}
    }
    Ok(())
}

enum Bind<'a> { Check(&'a [Hole]), Ignore }

impl Bind<'_> {
    fn bind(&self, slots: &mut [Option<OperandValue>; MAX_HOLES], slot: u8, value: OperandValue) -> bool {
        if let Bind::Check(holes) = self {
            if holes.get(slot as usize).and_then(Hole::restriction).is_some_and(|class| class != value.class) { return false; }
        }
        let entry = &mut slots[slot as usize];
        match entry {
            Some(known) => *known == value,
            None => { *entry = Some(value); true }
        }
    }
}

impl Template {
    /// Compile a template for 64-bit mode. Branch targets must be written `.+N`.
    pub fn parse(text: &str) -> Result<Template, AssembleError> { Self::parse_in_mode(text, DEFAULT_MODE) }

    /// Compile a template for an instruction at `address`, so absolute branch
    /// targets as printed by [`format_intel`] are accepted.
    pub fn parse_at(text: &str, address: u64) -> Result<Template, AssembleError> { Self::parse_at_in_mode(text, address, DEFAULT_MODE) }

    /// Compile text for an explicit execution mode.
    pub fn parse_in_mode(text: &str, mode: Mode) -> Result<Template, AssembleError> {Self::compile(text, None, mode)}

    /// Compile text at an address for an explicit execution mode.
    pub fn parse_at_in_mode(text: &str, address: u64, mode: Mode) -> Result<Template, AssembleError> {Self::compile(text, Some(address), mode)}

    pub fn mode(&self) -> Mode {self.mode}

    /// The holes in first-appearance order; `matches` and `encode` use this order.
    pub fn holes(&self) -> &[Hole] { &self.holes }

    /// The domains of hole `index` ([`Hole::domains`]); empty when out of range.
    pub fn hole_domains(&self, index: usize) -> &[ClassDomain] { self.holes.get(index).map_or(&[], |hole| &hole.domains) }

    /// Per candidate variant, the values each hole's operand holds: an
    /// immediate by the encoded and operand widths (probing the variant's
    /// representative encoding), a branch or RIP-relative displacement from the
    /// instruction's first byte, a register by its class. A hole used twice, or
    /// whose variants differ while the template has other holes, is a bound.
    fn compute_hole_domains(&mut self, catalog: &Catalog) {
        let count = self.holes.len();
        let mut lists: Vec<Vec<Vec<ClassDomain>>> = vec![Vec::new(); count];
        for &index in &self.variants {
            let variant = &catalog.variants[index as usize];
            let probed = probe(variant);
            let evex = variant.encoding().kind == 2;
            let mut local: Vec<Vec<ClassDomain>> = vec![Vec::new(); count];
            // How many places of the text each hole stands in.
            let mut uses = vec![0usize; count];
            if let PatMnemonic::Condition { code: PatCondition::Hole(slot), .. } = self.mnemonic { uses[slot as usize] += 1; }
            for operand in &self.operands {
                match operand {
                    PatOperand::Hole(slot) => uses[*slot as usize] += 1,
                    PatOperand::Memory(memory) => {
                        if let PatRegister::Hole(slot) = memory.base { uses[slot as usize] += 1; }
                        if let PatRegister::Hole(slot) = memory.index { uses[slot as usize] += 1; }
                        if let PatScale::Hole(slot) = memory.scale { uses[slot as usize] += 1; }
                        if let Some((slot, _)) = memory.displacement_hole { uses[slot as usize] += 1; }
                    }
                    _ => {}
                }
            }
            let mut add = |slot: u8, class: OperandClass, domain: Domain| add_domain(&mut local[slot as usize], class, domain);
            if let PatMnemonic::Condition { code: PatCondition::Hole(slot), .. } = self.mnemonic {
                add(slot, OperandClass::Condition, Domain::new(0, 15, 1, true));
            }
            let address: &[OperandClass] = match self.address_size {
                16 => &[OperandClass::Gpr16], 32 => &[OperandClass::Gpr32], 64 => &[OperandClass::Gpr64], _ if self.mode==Mode::Mode64 => &[OperandClass::Gpr64, OperandClass::Gpr32], _=> &[OperandClass::Gpr32,OperandClass::Gpr16],
            };
            for (position, pattern) in self.operands.iter().enumerate() {
                let shape = variant.operand(position);
                match (pattern, shape.kind) {
                    (PatOperand::Hole(slot), ShapeKind::Register { register, fixed }) => {
                        let class = OperandClass::of_register(register);
                        if fixed {
                            if let Some(value) = OperandValue::from_register(register) { add(*slot, value.class, Domain::new(value.value, value.value, 1, true)); }
                        } else if matches!(class, OperandClass::Gpr8 | OperandClass::Gpr8High) {
                            add(*slot, OperandClass::Gpr8, register_range_in_mode(OperandClass::Gpr8, evex,self.mode));
                            add(*slot, OperandClass::Gpr8High, register_range_in_mode(OperandClass::Gpr8High, evex,self.mode));
                        } else if let Some(value) = OperandValue::from_register(register) {
                            add(*slot, value.class, register_range_in_mode(value.class, evex,self.mode));
                        }
                    }
                    (PatOperand::Hole(slot), ShapeKind::Immediate { value, fixed }) => {
                        if fixed { add(*slot, OperandClass::Immediate, Domain::new(i128::from(value), i128::from(value), 1, true)); continue; }
                        let widths = probed.as_ref().and_then(|(decoded, view)| {
                            let target = match view.operands().get(position) { Some(ViewOperand::Immediate { width, .. }) => u32::from(*width), _ => 0 };
                            let slot_index = if let Field::Immediate(slot) = shape.field { slot as usize & 3 } else { 0 };
                            let encoded = u32::from(decoded.physical.immediates[slot_index].width);
                            (target != 0 && encoded != 0).then_some((encoded, target))
                        });
                        match widths {
                            Some((encoded, target)) => {
                                let slot_index = if let Field::Immediate(slot) = shape.field { slot as usize & 3 } else { 0 };
                                match immediate_signed(variant, position, slot_index, encoded, target) {
                                    Some(signed) => for domain in immediate_domains(encoded, target, signed, true) { add(*slot, OperandClass::Immediate, domain); },
                                    None => for domain in immediate_domains(encoded, target, false, false) { add(*slot, OperandClass::Immediate, domain); },
                                }
                            }
                            None => add(*slot, OperandClass::Immediate, WIDE_SIGNED),
                        }
                    }
                    (PatOperand::Hole(slot), ShapeKind::Relative) => {
                        let domain = probed.as_ref().and_then(|(decoded, _)| {
                            let slot_index = if let Field::Relative(slot) = shape.field { slot as usize & 3 } else { 0 };
                            let bits = u32::from(decoded.physical.immediates[slot_index].width);
                            (bits != 0).then(|| {
                                let half = 1i128 << (bits - 1);
                                Domain::new(-half + decoded.length as i128, half - 1 + decoded.length as i128, 1, true)
                            })
                        });
                        add(*slot, OperandClass::Relative, domain.unwrap_or(Domain::new(i128::from(i64::MIN), i128::from(i64::MAX), 1, false)));
                    }
                    (PatOperand::Memory(memory), ShapeKind::Memory { memory: shape_memory, fixed, vsib, moffs }) => {
                        for class in address {
                            if let PatRegister::Hole(slot) = memory.base {
                                // A form that fixes the base (string operations) takes only that register.
                                match (fixed, shape_memory.base.and_then(OperandValue::from_register)) {
                                    (true, Some(base)) => add(slot, *class, Domain::new(base.value, base.value, 1, true)),
                                    _ => add(slot, *class, Domain::new(0, if self.mode==Mode::Mode64 {15}else{7}, 1, false)),
                                }
                            }
                            if vsib == 0 { if let PatRegister::Hole(slot) = memory.index { add(slot, *class, Domain::new(0, if self.mode==Mode::Mode64 {15}else{7}, 1, false)); } }
                        }
                        if let PatRegister::Hole(slot) = memory.index {
                            match vsib {
                                0 => {}
                                128 => add(slot, OperandClass::Xmm, Domain::new(0, if self.mode==Mode::Mode64 {31}else{7}, 1, false)),
                                256 => add(slot, OperandClass::Ymm, Domain::new(0, if self.mode==Mode::Mode64 {31}else{7}, 1, false)),
                                _ => add(slot, OperandClass::Zmm, Domain::new(0, if self.mode==Mode::Mode64 {31}else{7}, 1, false)),
                            }
                        }
                        if let PatScale::Hole(slot) = memory.scale { add(slot, OperandClass::Scale, Domain::new(1, 8, 1, false)); }
                        if let Some((slot, negated)) = memory.displacement_hole {
                            // The hole plus the text's constant is the displacement; RIP-relative
                            // counts from the instruction's first byte.
                            let total = if moffs { Some(WIDE_SIGNED) } else if matches!(memory.base, PatRegister::Rip | PatRegister::Eip) {
                                rip_length(variant).map(|length| Domain::new(-(1i128 << 31) + length, (1i128 << 31) - 1 + length, 1, true))
                            } else { Some(Domain::new(-(1i128 << 31), (1i128 << 31) - 1, 1, true)) };
                            let constant = i128::from(memory.displacement);
                            let domain = total.map(|total| {
                                let (min, max) = if negated { (constant - total.max, constant - total.min) } else { (total.min - constant, total.max - constant) };
                                Domain::new(min, max, 1, total.exact)
                            });
                            add(slot, OperandClass::Displacement, domain.unwrap_or(WIDE_SIGNED));
                        }
                    }
                    _ => {}
                }
            }
            for (slot, mut entries) in local.into_iter().enumerate() {
                // With a single hole, a variant whose other operands the text fixes
                // may not be able to encode at all (an imm8 form beside a fixed imm32):
                // keep an entry exact only when the variant encodes at an end of it.
                if count == 1 {
                    for entry in &mut entries {
                        if entry.domain.exact && (!self.variant_encodes(variant, entry.class, entry.domain.min) || !self.variant_encodes(variant, entry.class, entry.domain.max)) {
                            entry.domain.exact = false;
                        }
                    }
                }
                // A REX prefix (registers 8..15, spl..dil) cannot stand beside ah, ch, dh, bh.
                if self.operands.iter().any(|operand| matches!(operand, PatOperand::Register(register) if register.high8)) {
                    for entry in &mut entries { entry.domain.exact = false; }
                }
                // Some FP16 complex forms forbid a source equal to the
                // destination. A numeric interval cannot express that interior
                // exclusion, even when both endpoints encode successfully.
                if uses[slot] > 1 || variant.encoding().no_source_dest_match {
                    for entry in &mut entries { entry.domain.exact = false; }
                }
                entries.sort_by_key(|entry| (entry.class, entry.domain.min, entry.domain.max));
                if !lists[slot].contains(&entries) { lists[slot].push(entries); }
            }
        }
        for (slot, per_variant) in lists.into_iter().enumerate() {
            let differ = per_variant.len() > 1;
            let mut merged: Vec<ClassDomain> = Vec::new();
            for list in per_variant {
                for mut entry in list {
                    if differ && count > 1 { entry.domain.exact = false; }
                    add_domain(&mut merged, entry.class, entry.domain);
                }
            }
            let classes = &self.holes[slot].classes;
            merged.retain(|entry| classes.contains(&entry.class));
            self.holes[slot].domains = merged;
        }
    }

    /// Whether `variant` encodes the template with its one hole bound to `value`.
    fn variant_encodes(&self, variant: &Variant, class: OperandClass, value: i128) -> bool {
        let Ok(concrete) = self.substitute(&[OperandValue::new(class, value)]) else { return false };
        let mut results = Vec::new();
        concrete.encode_variant(variant, &mut results);
        !results.is_empty()
    }

    /// How hole `index` relates to the instruction's position
    /// ([`Hole::position`]); `None` when out of range or the forms disagree.
    pub fn hole_position(&self, index: usize) -> Option<Position> { self.holes.get(index)?.position }

    /// A hole is instruction-relative when it stands for a branch displacement
    /// or a RIP-relative displacement, fixed when it stands for anything else,
    /// and undetermined when its uses or candidate forms disagree.
    fn compute_hole_positions(&mut self) {
        let mut found: Vec<Option<Position>> = vec![None; self.holes.len()];
        let mut mixed = vec![false; self.holes.len()];
        let mut note = |slot: u8, position: Position| {
            let slot = slot as usize;
            match found[slot] { None => found[slot] = Some(position), Some(old) => mixed[slot] |= old != position }
        };
        for operand in &self.operands {
            match operand {
                PatOperand::Hole(slot) => {
                    let classes = &self.holes[*slot as usize].classes;
                    let relative = classes.iter().filter(|class| **class == OperandClass::Relative).count();
                    if relative == 0 { note(*slot, Position::Fixed); }
                    else if relative == classes.len() { note(*slot, Position::InstructionRelative); }
                    else { note(*slot, Position::Fixed); note(*slot, Position::InstructionRelative); }
                }
                PatOperand::Memory(memory) => {
                    if let Some((slot, _)) = memory.displacement_hole {
                        note(slot, match memory.base { PatRegister::Rip => Position::InstructionRelative, PatRegister::Eip => Position::WrappingInstructionRelative { bits: 32 }, _ => Position::Fixed });
                    }
                    if let PatRegister::Hole(slot) = memory.base { note(slot, Position::Fixed); }
                    if let PatRegister::Hole(slot) = memory.index { note(slot, Position::Fixed); }
                    if let PatScale::Hole(slot) = memory.scale { note(slot, Position::Fixed); }
                }
                _ => {}
            }
        }
        if let PatMnemonic::Condition { code: PatCondition::Hole(slot), .. } = self.mnemonic { note(slot, Position::Fixed); }
        for (index, hole) in self.holes.iter_mut().enumerate() {
            hole.position = if mixed[index] { None } else { found[index] };
        }
    }

    pub fn text(&self) -> &str { &self.text }

    pub fn address(&self) -> Option<u64> { self.address }

    /// Every form that can encode an instruction this template denotes.
    pub fn candidate_forms(&self) -> Vec<u32> {
        let catalog = catalog_in_mode(self.mode);
        let mut forms: Vec<u32> = self.variants.iter().map(|index| catalog.variants[*index as usize].form).collect();
        forms.dedup();
        forms
    }

    fn compile(text: &str, address: Option<u64>, mode: Mode) -> Result<Template, AssembleError> {
        let mut parser = Parser { mode, tokens: lex(text)?, pos: 0, holes: Vec::new() };
        let line = parser.line()?;
        let catalog = catalog_in_mode(mode);
        let mut forms = vec![0u64; ENCODINGS.len().div_ceil(64)];
        let mut candidates: Vec<u32> = Vec::new();
        let mut mnemonic = line.mnemonic;
        match &mut mnemonic {
            PatMnemonic::Exact(name) => {
                if catalog.forms_named(name).is_none() {
                    if let Some(canonical) = condition_alias(name) { *name = canonical; }
                }
                let found = catalog.forms_named(name).ok_or_else(|| AssembleError::UnknownMnemonic {
                    mnemonic: name.clone(), nearest: catalog.nearest(name),
                })?;
                candidates.extend_from_slice(found);
            }
            PatMnemonic::Condition { family, .. } => {
                candidates.extend((0..ENCODINGS.len() as u32).filter(|form| {
                    condition_code(&ENCODINGS[*form as usize], *family).is_some() && encoding_supports_mode(*form as usize, mode)
                }));
            }
        }
        for form in &candidates { forms[*form as usize / 64] |= 1 << (form % 64); }
        let holes = parser.holes.into_iter().map(|hole| Hole { name: hole.name, restriction: hole.restriction, classes: Vec::new(), position: None, domains: Vec::new() }).collect();
        let mut template = Template {
            mode, text: text.to_string(), address, mnemonic, lock: line.lock, repeat: line.repeat,
            operands: line.operands, decoration: line.decoration, rounding: line.rounding, address_size: effective_address_bits(mode, false) as u8, holes, forms, variants: Vec::new(),
            first_bytes: [0; 4], opcode_bytes: [0; 4], repeat_open: false,
        };
        let all: Vec<u32> = candidates.iter().flat_map(|form| {
            let (start, count) = catalog.by_form[*form as usize];
            start..start + u32::from(count)
        }).collect();
        template.expand_string_operands(catalog, &all);
        template.address_size = template.pattern_address_size();
        // Pass one ignores hole restrictions so a restriction that no form
        // accepts reports the classes the hole could take instead.
        let open = template.select(catalog, &all, false)?;
        template.variants = open;
        template.compute_hole_classes(catalog)?;
        template.variants = template.select(catalog, &template.variants.clone(), true)?;
        template.compute_hole_classes(catalog)?;
        template.check_sizes(catalog)?;
        template.compute_first_bytes();
        template.compute_hole_positions();
        template.compute_hole_domains(catalog);
        Ok(template)
    }

    /// The bytes an instruction this template matches can start with, as a
    /// 256-bit set (bit `b` of word `b / 64`). A necessary condition for
    /// [`Template::matches`], computed once when the template is compiled:
    /// `matches(bytes, ..)` is `Some` only if the bit for `bytes[0]` is set.
    /// The set holds the first opcode byte of every form the mnemonic names
    /// (`0f` for the two-byte maps, `c4`/`c5`, `62` and `8f` for VEX, EVEX and
    /// XOP), the legacy prefixes the decoder skips before it, and the REX
    /// range. `lock` and the `rep`/`repnz` prefixes narrow it as the template
    /// text fixes them. Testing it allocates nothing.
    pub fn first_bytes(&self) -> [u64; 4] { self.first_bytes }

    /// A tight necessary condition for [`Template::matches`] that decodes
    /// nothing: `matches(bytes, ..)` is `Some` only if this is true. It skips
    /// exactly what the decoder skips (any number of legacy prefixes, then one
    /// REX byte), requires the `f0`, `f2` and `f3` prefixes to agree with the
    /// template's `lock` and `rep`/`repnz`, and tests the next byte against the
    /// opcode and escape bytes of the candidate forms. It does not look at a
    /// second opcode byte. Allocation-free.
    pub fn could_match(&self, bytes: &[u8]) -> bool {
        let (mut pos, mut lock, mut f2, mut f3) = (0usize, false, false, false);
        while pos < bytes.len() && pos < 15 && is_legacy_prefix(bytes[pos]) {
            match bytes[pos] { 0xf0 => lock = true, 0xf2 => f2 = true, 0xf3 => f3 = true, _ => {} }
            pos += 1;
        }
        if pos >= 15 || lock != self.lock { return false; }
        let repeat_ok = match self.repeat {
            0 => self.repeat_open || !(f2 || f3),
            2 => f3,
            _ => f2 && !f3,
        };
        if !repeat_ok { return false; }
        if self.mode == Mode::Mode64 && bytes.get(pos).is_some_and(|byte| is_rex(*byte)) { pos += 1; }
        bytes.get(pos).is_some_and(|byte| self.opcode_bytes[*byte as usize / 64] >> (byte % 64) & 1 == 1)
    }

    fn compute_first_bytes(&mut self) {
        let mut set = [0u64; 4];
        let mut opcodes = [0u64; 4];
        let mut add = |byte: u8| opcodes[byte as usize / 64] |= 1 << (byte % 64);
        let mut any = false;
        let mut repeat_invisible = false;
        for form in 0..ENCODINGS.len() {
            if !bit(&self.forms, form as u32) || !encoding_supports_mode(form, self.mode) { continue; }
            let e = &ENCODINGS[form];
            let visible = repeat_prefix_visible(e);
            // `view.repeat` is nonzero only for these forms, and must equal the text's.
            if self.repeat != 0 && !visible { continue; }
            any = true;
            repeat_invisible |= !visible;
            match e.kind {
                0 if e.map == 0 => for offset in 0..if e.opcode_plus_reg { 8 } else { 1 } { add(e.opcode.wrapping_add(offset)) },
                0 | 5 => add(0x0f),
                1 => { add(0xc4); if e.map == 1 { add(0xc5); } }
                2 => add(0x62),
                4 => add(0x8f),
                _ => {}
            }
        }
        self.opcode_bytes = opcodes;
        self.repeat_open = repeat_invisible;
        for (word, bits) in set.iter_mut().zip(opcodes) { *word = bits; }
        if !any { self.first_bytes = [0; 4]; return; }
        let mut add = |byte: u8| set[byte as usize / 64] |= 1 << (byte % 64);
        // Legacy prefixes the decoder skips ahead of any opcode. `f0` sets
        // `lock`, which the view must equal; a REX byte must directly precede
        // the opcode, so a text that needs `lock` cannot start with one.
        for prefix in [0x66, 0x67, 0x26, 0x2e, 0x36, 0x3e, 0x64, 0x65] { add(prefix); }
        // `f2`/`f3` show as `rep`/`repnz` only on forms that print them.
        if self.repeat != 0 || repeat_invisible { add(0xf2); add(0xf3); }
        if self.lock { add(0xf0); } else if self.mode == Mode::Mode64 { for rex in 0x40..=0x4f { add(rex); } }
        self.first_bytes = set;
    }

    fn pattern_address_size(&self) -> u8 {
        let mut size = None;
        let mut open = false;
        for operand in &self.operands {
            let PatOperand::Memory(memory) = operand else { continue };
            for register in [memory.base, memory.index] {
                match register {
                    PatRegister::Rip => size = Some(64),
                    PatRegister::Eip => size = Some(32),
                    PatRegister::Fixed(register) if register.class == RegisterClass::Gpr => size = Some(register.width as u8),
                    PatRegister::Hole(slot) => match self.holes[slot as usize].restriction {
                        Some(OperandClass::Gpr16) => size = Some(16),
                        Some(OperandClass::Gpr32) => size = Some(32),
                        Some(OperandClass::Gpr64) => size = Some(64),
                        _ => open = true,
                    },
                    _ => {}
                }
            }
        }
        match size { Some(size) => size, None if open => 0, None => effective_address_bits(self.mode, false) as u8 }
    }

    fn expand_string_operands(&mut self, catalog: &Catalog, variants: &[u32]) {
        if !self.operands.is_empty() { return; }
        let PatMnemonic::Exact(name) = &self.mnemonic else { return };
        let named = || variants.iter().map(|index| &catalog.variants[*index as usize]).filter(|variant| variant.mnemonic.eq_ignore_ascii_case(name));
        if named().any(|variant| variant.count == 0) { return; }
        let Some(string) = named().find(|variant| is_repeatable(variant.encoding()) && variant.count > 0) else { return };
        self.operands = (0..string.count as usize).filter_map(|index| match string.operand(index).kind {
            ShapeKind::Memory { memory, .. } => Some(PatOperand::Memory(PatMemory {
                prefix: memory.prefix, size: Some(memory.size), segment: None,
                base: memory.base.map_or(PatRegister::Absent, PatRegister::Fixed), index: PatRegister::Absent,
                scale: PatScale::Fixed(1), displacement: 0, displacement_hole: None, start_relative: false, offset: 0,
            })),
            ShapeKind::Register { register, .. } => Some(PatOperand::Register(register)),
            _ => None,
        }).collect();
    }

    fn mnemonic_accepts(&self, variant: &Variant) -> bool {
        match &self.mnemonic {
            PatMnemonic::Exact(name) => variant.mnemonic.eq_ignore_ascii_case(name),
            PatMnemonic::Condition { prefix, family, code } => {
                let Some(value) = condition_code(variant.encoding(), *family) else { return false };
                variant.mnemonic.len() > prefix.len() && variant.mnemonic[..prefix.len()].eq_ignore_ascii_case(prefix)
                    && match code { PatCondition::Fixed(code) => *code == value, PatCondition::Hole(_) => true }
            }
        }
    }

    fn mnemonic_text(&self) -> String {
        match &self.mnemonic {
            PatMnemonic::Exact(name) => name.clone(),
            PatMnemonic::Condition { prefix, code: PatCondition::Fixed(code), .. } => format!("{prefix}{}", CONDITION_NAMES[*code as usize]),
            PatMnemonic::Condition { prefix, code: PatCondition::Hole(slot), .. } => format!("{prefix}${}", self.holes[*slot as usize].name),
        }
    }

    /// Keep the variants whose operand shapes accept the pattern; report the
    /// closest form when none does.
    fn select(&self, catalog: &Catalog, variants: &[u32], restrictions: bool) -> Result<Vec<u32>, AssembleError> {
        let mut selected = Vec::new();
        let mut counts: Vec<usize> = Vec::new();
        let mut best: Option<(usize, u32, &'static str)> = None;
        let mut needs_address: Option<usize> = None;
        let mut any_named = false;
        for &index in variants {
            let variant = &catalog.variants[index as usize];
            if !self.mnemonic_accepts(variant) { continue; }
            any_named = true;
            if variant.count as usize != self.operands.len() {
                counts.push(variant.count as usize);
                continue;
            }
            match self.shape_accepts(variant, restrictions) {
                Ok(()) => selected.push(index),
                Err((operand, reason)) => {
                    if best.is_none_or(|(known, _, _)| operand > known) { best = Some((operand, variant.form, reason)); }
                    if reason == "expected a relative target" && self.address.is_none()
                        && matches!(self.operands.get(operand), Some(PatOperand::Number(_)))
                    {
                        needs_address = Some(needs_address.map_or(operand, |known| known.max(operand)));
                    }
                }
            }
        }
        if !selected.is_empty() { return Ok(selected); }
        let mnemonic = self.mnemonic_text();
        if let Some((operand, form, reason)) = best {
            if needs_address == Some(operand) {
                return Err(AssembleError::RelativeNeedsAddress { operand });
            }
            return Err(AssembleError::NoMatchingForm { mnemonic, form: ENCODINGS[form as usize].form_id, operand, reason });
        }
        if any_named {
            counts.sort();
            counts.dedup();
            return Err(AssembleError::OperandCount { mnemonic, found: self.operands.len(), expected: counts });
        }
        let form = variants.first().map(|index| catalog.variants[*index as usize].form)
            .or_else(|| (0..ENCODINGS.len() as u32).find(|form| bit(&self.forms, *form)));
        let reason = form.and_then(|form| catalog.skipped.iter().find(|(skipped, _)| *skipped == form).map(|(_, reason)| *reason))
            .unwrap_or("no form of this mnemonic is encodable in 64-bit mode");
        Err(AssembleError::NoMatchingForm { mnemonic, form: form.map_or("", |form| ENCODINGS[form as usize].form_id), operand: 0, reason })
    }

    fn shape_accepts(&self, variant: &Variant, restrictions: bool) -> Result<(), (usize, &'static str)> {
        let encoding = variant.encoding();
        if encoding.suppress_exceptions != self.rounding.is_some()
            || self.rounding.is_some_and(|rounding| encoding.embedded_rounding != (rounding < 4)) {
            return Err((0, "the form takes a different SAE or rounding decoration"));
        }
        if let Some(decoration) = self.decoration {
            if variant.decoration != Some(decoration.after) {
                return Err((decoration.after.saturating_sub(1) as usize, "the form takes no mask decoration here"));
            }
        }
        let kind = variant.encoding().kind;
        for (index, pattern) in self.operands.iter().enumerate() {
            self.operand_accepts(pattern, variant.operand(index).kind, kind, restrictions).map_err(|reason| (index, reason))?;
        }
        Ok(())
    }

    fn restriction(&self, slot: u8, restrictions: bool) -> Option<OperandClass> {
        if restrictions { self.holes[slot as usize].restriction } else { None }
    }

    fn operand_accepts(&self, pattern: &PatOperand, shape: ShapeKind, kind: u8, restrictions: bool) -> Result<(), &'static str> {
        let restricted = |slot: u8, allowed: &dyn Fn(OperandClass) -> bool| -> Result<(), &'static str> {
            match self.restriction(slot, restrictions) {
                Some(class) if !allowed(class) => Err("hole class differs"),
                _ => Ok(()),
            }
        };
        match (pattern, shape) {
            (PatOperand::Any, _) => Ok(()),
            (PatOperand::FarPointer { .. }, ShapeKind::Pointer) => Ok(()),
            (PatOperand::FarPointer { .. }, _) => Err("expected a far pointer"),
            (PatOperand::Hole(slot), ShapeKind::Register { register, fixed }) => restricted(*slot, &|class| {
                if fixed { return OperandValue::from_register(register).is_some_and(|value| value.class == class); }
                let shape_class = OperandClass::of_register(register);
                class == shape_class || (matches!(shape_class, OperandClass::Gpr8 | OperandClass::Gpr8High) && matches!(class, OperandClass::Gpr8 | OperandClass::Gpr8High))
            }),
            (PatOperand::Hole(slot), ShapeKind::Immediate { .. }) => restricted(*slot, &|class| class == OperandClass::Immediate),
            (PatOperand::Hole(slot), ShapeKind::Relative) => restricted(*slot, &|class| class == OperandClass::Relative),
            (PatOperand::Hole(_), ShapeKind::Memory { .. }) => Err("a hole cannot stand for a whole memory operand: use `_` or holes inside `[...]`"),
            (PatOperand::Hole(_), _) => Err("this operand cannot be a hole"),
            (PatOperand::Register(register), ShapeKind::Register { register: shape, fixed }) => {
                if fixed { if same_register(*register, shape) { Ok(()) } else { Err("the form has a different fixed register here") } }
                else { class_compatible(*register, shape, kind, self.mode) }
            }
            (PatOperand::Register(_), _) => Err("expected a register"),
            (PatOperand::Number(value) | PatOperand::Immediate(value), ShapeKind::Immediate { value: fixed_value, fixed }) => {
                if fixed && !immediate_equal(*value, fixed_value, 64) { Err("the form has a different fixed immediate") } else { Ok(()) }
            }
            (PatOperand::Number(_), ShapeKind::Relative) => if self.address.is_some() { Ok(()) } else { Err("expected a relative target") },
            (PatOperand::Relative(_), ShapeKind::Relative) => Ok(()),
            (PatOperand::Number(_) | PatOperand::Immediate(_), _) => Err("expected an immediate"),
            (PatOperand::Relative(_), _) => Err("expected a relative target"),
            (PatOperand::Memory(memory), ShapeKind::Memory { memory: shape, fixed, vsib, moffs }) => self.memory_accepts(memory, shape, fixed, vsib, moffs, restrictions),
            (PatOperand::Memory(_), _) => Err("expected a memory operand"),
            (PatOperand::Text(text), ShapeKind::Text(shape)) => if text.eq_ignore_ascii_case(shape) { Ok(()) } else { Err("operand text differs") },
            (PatOperand::Text(_), _) => Err("unknown operand"),
        }
    }

    fn memory_accepts(&self, pattern: &PatMemory, shape: ViewMemory, fixed: bool, vsib: u16, moffs: bool, restrictions: bool) -> Result<(), &'static str> {
        if pattern.prefix != shape.prefix { return Err("memory prefix keyword differs"); }
        if pattern.size.is_some_and(|size| size != shape.size) { return Err("memory operand size differs"); }
        if fixed {
            let mut slots = [None; MAX_HOLES];
            return if self.memory_matches(pattern, &shape, 0, &mut slots, &Bind::Ignore) { Ok(()) } else { Err("the form has a fixed memory operand") };
        }
        let register_hole = |slot: u8, allowed: &[OperandClass]| match self.restriction(slot, restrictions) {
            Some(class) if !allowed.contains(&class) => Err("hole class differs"),
            _ => Ok(()),
        };
        if moffs {
            if pattern.base != PatRegister::Absent || pattern.index != PatRegister::Absent {
                return Err("the form takes an absolute address");
            }
            return Ok(());
        }
        match pattern.base {
            PatRegister::Rip | PatRegister::Eip if vsib != 0 => return Err("vector-index addressing cannot be rip-relative"),
            PatRegister::Hole(slot) => register_hole(slot, if self.mode==Mode::Mode64 {&[OperandClass::Gpr64, OperandClass::Gpr32]}else{&[OperandClass::Gpr32,OperandClass::Gpr16]})?,
            _ => {}
        }
        let vector_class = match vsib { 128 => OperandClass::Xmm, 256 => OperandClass::Ymm, _ => OperandClass::Zmm };
        match pattern.index {
            PatRegister::Absent if vsib != 0 => Err("the form needs a vector index register"),
            PatRegister::Fixed(index) if vsib != 0 => {
                if index.class == RegisterClass::Vector && register_key(index).2 == vsib { Ok(()) } else { Err("the form needs a vector index of another width") }
            }
            PatRegister::Fixed(index) if index.class != RegisterClass::Gpr => Err("the form needs a general-purpose index register"),
            PatRegister::Hole(slot) if vsib != 0 => register_hole(slot, &[vector_class]),
            PatRegister::Hole(slot) => register_hole(slot, if self.mode==Mode::Mode64 {&[OperandClass::Gpr64, OperandClass::Gpr32]}else{&[OperandClass::Gpr32,OperandClass::Gpr16]}),
            _ => Ok(()),
        }
    }

    /// Each hole's classes: within one form a repeated hole takes the classes
    /// every occurrence accepts; across forms the union. Forms where a
    /// repeated hole has no common class cannot match and are dropped.
    fn compute_hole_classes(&mut self, catalog: &Catalog) -> Result<(), AssembleError> {
        let mut classes: Vec<Vec<OperandClass>> = vec![Vec::new(); self.holes.len()];
        let mut kept = Vec::with_capacity(self.variants.len());
        for &index in &self.variants {
            let variant = &catalog.variants[index as usize];
            let mut local: Vec<Option<Vec<OperandClass>>> = vec![None; self.holes.len()];
            let mut add = |slot: u8, found: &[OperandClass]| {
                let entry = &mut local[slot as usize];
                match entry {
                    None => *entry = Some(found.to_vec()),
                    Some(known) => known.retain(|class| found.contains(class)),
                }
            };
            if let PatMnemonic::Condition { code: PatCondition::Hole(slot), .. } = self.mnemonic {
                add(slot, &[OperandClass::Condition]);
            }
            for (position, pattern) in self.operands.iter().enumerate() {
                match (pattern, variant.operand(position).kind) {
                    (PatOperand::Hole(slot), ShapeKind::Register { register, fixed }) => {
                        let class = OperandClass::of_register(register);
                        if !fixed && matches!(class, OperandClass::Gpr8 | OperandClass::Gpr8High) {
                            add(*slot, &[OperandClass::Gpr8, OperandClass::Gpr8High]);
                        } else if let Some(value) = OperandValue::from_register(register) {
                            add(*slot, &[value.class]);
                        }
                    }
                    (PatOperand::Hole(slot), ShapeKind::Immediate { .. }) => add(*slot, &[OperandClass::Immediate]),
                    (PatOperand::Hole(slot), ShapeKind::Relative) => add(*slot, &[OperandClass::Relative]),
                    (PatOperand::Memory(memory), ShapeKind::Memory { vsib, .. }) => {
                        let address: &[OperandClass] = match self.address_size {
                            16 => &[OperandClass::Gpr16], 32 => &[OperandClass::Gpr32], 64 => &[OperandClass::Gpr64], _ if self.mode==Mode::Mode64 => &[OperandClass::Gpr64, OperandClass::Gpr32], _=> &[OperandClass::Gpr32,OperandClass::Gpr16],
                        };
                        if let PatRegister::Hole(slot) = memory.base { add(slot, address); }
                        if let PatRegister::Hole(slot) = memory.index {
                            match vsib {
                                0 => add(slot, address),
                                128 => add(slot, &[OperandClass::Xmm]),
                                256 => add(slot, &[OperandClass::Ymm]),
                                _ => add(slot, &[OperandClass::Zmm]),
                            }
                        }
                        if let PatScale::Hole(slot) = memory.scale { add(slot, &[OperandClass::Scale]); }
                        if let Some((slot, _)) = memory.displacement_hole { add(slot, &[OperandClass::Displacement]); }
                    }
                    _ => {}
                }
            }
            if local.iter().any(|entry| entry.as_ref().is_some_and(Vec::is_empty)) { continue; }
            for (total, entry) in classes.iter_mut().zip(local) {
                if let Some(entry) = entry { total.extend(entry); }
            }
            kept.push(index);
        }
        if kept.is_empty() {
            let form = self.variants.first().map_or("", |index| catalog.variants[*index as usize].encoding().form_id);
            return Err(AssembleError::NoMatchingForm {
                mnemonic: self.mnemonic_text(), form, operand: 0,
                reason: "a repeated hole stands for operands of different classes",
            });
        }
        self.variants = kept;
        for (hole, mut list) in self.holes.iter_mut().zip(classes) {
            list.sort();
            list.dedup();
            if let Some(restriction) = hole.restriction {
                if !list.contains(&restriction) {
                    return Err(AssembleError::HoleClassMismatch { name: hole.name.clone(), class: restriction, allowed: list });
                }
            }
            hole.classes = list;
        }
        Ok(())
    }

    fn check_sizes(&self, catalog: &Catalog) -> Result<(), AssembleError> {
        for (position, pattern) in self.operands.iter().enumerate() {
            let PatOperand::Memory(memory) = pattern else { continue };
            if memory.size.is_some() { continue; }
            let mut sizes: Vec<u16> = self.variants.iter().filter_map(|index| match catalog.variants[*index as usize].operand(position).kind {
                ShapeKind::Memory { memory, .. } => Some(memory.size),
                _ => None,
            }).collect();
            sizes.sort();
            sizes.dedup();
            if sizes.len() > 1 {
                return Err(AssembleError::AmbiguousSize { operand: position, candidates: sizes.into_iter().map(size_keyword).collect() });
            }
        }
        Ok(())
    }

    /// Match the instruction at the start of `bytes`; on success push one value
    /// per hole (in [`Template::holes`] order) and return the encoded length.
    /// Decodes once and compares structurally; allocates only for the pushes.
    pub fn matches(&self, bytes: &[u8], values: &mut Vec<OperandValue>) -> Option<usize> {
        values.clear();
        let decoded = decode(bytes, self.mode).ok()?;
        if !bit(&self.forms, decoded.form_index) { return None; }
        let view = self.matching_view(&decoded);
        let mut slots = [None; MAX_HOLES];
        if !self.view_matches(&view, &mut slots, &Bind::Check(&self.holes)) { return None; }
        for slot in &slots[..self.holes.len()] { values.push((*slot)?); }
        debug_assert!(self.first_bytes[bytes[0] as usize / 64] >> (bytes[0] % 64) & 1 == 1,
            "first_bytes rejects a match: {:?} {bytes:02x?}", self.text);
        debug_assert!(self.could_match(bytes), "could_match rejects a match: {:?} {bytes:02x?}", self.text);
        Some(view.length as usize)
    }

    fn matching_view(&self, decoded:&Decoded)->View {
        if matches!(&self.mnemonic,PatMnemonic::Exact(name) if name.eq_ignore_ascii_case("xchg")) {
            if let Some(alias)=self_xchg_view(decoded) {return alias}
        }
        view(decoded)
    }

    fn view_matches(&self, view: &View, slots: &mut [Option<OperandValue>; MAX_HOLES], bind: &Bind<'_>) -> bool {
        if view.overflow || view.broadcast || view.lock != self.lock || view.repeat != self.repeat || view.rounding != self.rounding { return false; }
        match &self.mnemonic {
            PatMnemonic::Exact(name) => if !view.mnemonic.eq_ignore_ascii_case(name) { return false; },
            PatMnemonic::Condition { prefix, family, code } => {
                let Some(value) = condition_code(&ENCODINGS[view.form_index as usize], *family) else { return false };
                if view.mnemonic.len() <= prefix.len() || !view.mnemonic[..prefix.len()].eq_ignore_ascii_case(prefix) { return false; }
                match code {
                    PatCondition::Fixed(code) => if *code != value { return false; },
                    PatCondition::Hole(slot) => if !bind.bind(slots, *slot, OperandValue::new(OperandClass::Condition, i128::from(value))) { return false; },
                }
            }
        }
        match self.decoration {
            Some(decoration) => if view.mask != decoration.mask || view.zeroing != decoration.zeroing || view.mask_after != decoration.after { return false; },
            None => if view.mask != 0 { return false; },
        }
        if view.address_size != 0 && self.address_size != 0 && view.address_size != self.address_size { return false; }
        let operands = view.operands();
        if operands.len() != self.operands.len() { return false; }
        self.operands.iter().zip(operands).all(|(pattern, operand)| self.operand_matches(pattern, operand, view.length, slots, bind))
    }

    fn operand_matches(&self, pattern: &PatOperand, operand: &ViewOperand, length: u8, slots: &mut [Option<OperandValue>; MAX_HOLES], bind: &Bind<'_>) -> bool {
        match (pattern, operand) {
            (PatOperand::Any, _) => true,
            (PatOperand::FarPointer {offset,selector}, ViewOperand::FarPointer {offset:actual_offset,selector:actual_selector}) => offset==actual_offset && u64::from(*selector)==*actual_selector,
            (PatOperand::Hole(slot), ViewOperand::Register(register)) =>
                OperandValue::from_register(*register).is_some_and(|value| bind.bind(slots, *slot, value)),
            (PatOperand::Hole(slot), ViewOperand::Immediate { value, .. }) =>
                bind.bind(slots, *slot, OperandValue::new(OperandClass::Immediate, i128::from(*value))),
            (PatOperand::Hole(slot), ViewOperand::Relative{displacement,..}) =>
                bind.bind(slots, *slot, OperandValue::new(OperandClass::Relative, i128::from(*displacement))),
            (PatOperand::Register(register), ViewOperand::Register(actual)) => same_register(*register, *actual),
            (PatOperand::Number(value) | PatOperand::Immediate(value), ViewOperand::Immediate { value: actual, width }) => immediate_equal(*value, *actual, *width),
            (PatOperand::Number(value), ViewOperand::Relative{displacement,bits}) => self.address.is_some_and(|address| {
                (0..=i128::from(ip_mask(*bits))).contains(value) && (address.wrapping_add_signed(*displacement)&ip_mask(*bits)) == *value as u64
            }),
            (PatOperand::Relative(value), ViewOperand::Relative{displacement,..}) => *value == i128::from(*displacement),
            (PatOperand::Memory(memory), ViewOperand::Memory(actual)) => self.memory_matches(memory, actual, length, slots, bind),
            (PatOperand::Text(text), ViewOperand::Text(actual)) => text.eq_ignore_ascii_case(actual),
            _ => false,
        }
    }

    fn memory_matches(&self, pattern: &PatMemory, actual: &ViewMemory, length: u8, slots: &mut [Option<OperandValue>; MAX_HOLES], bind: &Bind<'_>) -> bool {
        if pattern.prefix != actual.prefix || pattern.size.is_some_and(|size| size != actual.size) || pattern.segment.map(register_key) != actual.segment.map(register_key) {
            return false;
        }
        let register = |pattern: PatRegister, actual: Option<Register>, slots: &mut [Option<OperandValue>; MAX_HOLES]| match (pattern, actual) {
            (PatRegister::Absent, None) => true,
            (PatRegister::Fixed(register), Some(actual)) => same_register(register, actual),
            (PatRegister::Hole(slot), Some(actual)) => OperandValue::from_register(actual).is_some_and(|value| bind.bind(slots, slot, value)),
            _ => false,
        };
        let base_matches = match pattern.base {
            PatRegister::Rip | PatRegister::Eip => actual.rip,
            other => !actual.rip && register(other, actual.base, slots),
        };
        if !base_matches || !register(pattern.index, actual.index, slots) { return false; }
        match pattern.scale {
            PatScale::Fixed(scale) => if actual.index.is_some() && scale != actual.scale { return false; },
            PatScale::Hole(slot) => if !bind.bind(slots, slot, OperandValue::new(OperandClass::Scale, i128::from(actual.scale))) { return false; },
        }
        match pattern.displacement_hole {
            None if pattern.start_relative => pattern.displacement == actual.displacement.wrapping_add(i64::from(length)),
            None => pattern.displacement == actual.displacement,
            Some((slot, negated)) => {
                // A RIP-relative displacement is measured from the instruction's first byte.
                let (shift, position) = if actual.rip { (i128::from(length), if self.address_size == 32 { Position::WrappingInstructionRelative { bits:32 } } else { Position::InstructionRelative }) } else { (0, Position::Fixed) };
                let value = i128::from(actual.displacement) + shift - i128::from(pattern.displacement);
                bind.bind(slots, slot, OperandValue::new(OperandClass::Displacement, if negated { -value } else { value }).with_position(position))
            }
        }
    }

    /// Every encoding of the instruction with the holes bound to `values`
    /// (one per hole, in [`Template::holes`] order): shortest first, then
    /// lowest bytes, deduplicated. Includes each form's other displacement and
    /// immediate widths, so fixed-width patching can pick a length.
    pub fn encode(&self, values: &[OperandValue]) -> Result<Vec<Encoded>, AssembleError> {
        if values.len() < self.holes.len() {
            return Err(AssembleError::UnboundHole { name: self.holes[values.len()].name.clone() });
        }
        if values.len() > self.holes.len() {
            return Err(AssembleError::ValueCount { expected: self.holes.len(), found: values.len() });
        }
        if self.operands.iter().any(|operand| *operand == PatOperand::Any) {
            return Err(AssembleError::UnboundHole { name: "_".to_string() });
        }
        for (hole, value) in self.holes.iter().zip(values) {
            if !hole.accepts(value.class) {
                return Err(AssembleError::HoleClassMismatch { name: hole.name.clone(), class: value.class, allowed: hole.classes.clone() });
            }
        }
        let concrete = if self.holes.is_empty() { self.clone() } else { self.substitute(values)? };
        concrete.encode_concrete()
    }

    fn substitute(&self, values: &[OperandValue]) -> Result<Template, AssembleError> {
        let invalid = |slot: u8| AssembleError::InvalidValue { name: self.holes[slot as usize].name.clone(), value: values[slot as usize] };
        let register = |slot: u8| values[slot as usize].register().ok_or_else(|| invalid(slot));
        let mut concrete = self.clone();
        concrete.holes.clear();
        if let PatMnemonic::Condition { code, .. } = &mut concrete.mnemonic {
            if let PatCondition::Hole(slot) = *code {
                let value = values[slot as usize].value;
                if !(0..16).contains(&value) { return Err(invalid(slot)); }
                *code = PatCondition::Fixed(value as u8);
            }
        }
        for operand in &mut concrete.operands {
            match operand {
                PatOperand::Hole(slot) => {
                    let value = values[*slot as usize];
                    *operand = match value.class {
                        class if class.is_register() => PatOperand::Register(register(*slot)?),
                        OperandClass::Immediate => PatOperand::Immediate(value.value),
                        OperandClass::Relative => PatOperand::Relative(value.value),
                        _ => return Err(invalid(*slot)),
                    };
                }
                PatOperand::Memory(memory) => {
                    if let PatRegister::Hole(slot) = memory.base { memory.base = PatRegister::Fixed(register(slot)?); }
                    if let PatRegister::Hole(slot) = memory.index { memory.index = PatRegister::Fixed(register(slot)?); }
                    if let PatScale::Hole(slot) = memory.scale {
                        let value = values[slot as usize].value;
                        if !matches!(value, 1 | 2 | 4 | 8) { return Err(invalid(slot)); }
                        memory.scale = PatScale::Fixed(value as u8);
                    }
                    if let Some((slot, negated)) = memory.displacement_hole.take() {
                        let value = values[slot as usize].value;
                        let total = i128::from(memory.displacement) + if negated { -value } else { value };
                        if !(-(1i128 << 63)..(1i128 << 64)).contains(&total) { return Err(invalid(slot)); }
                        memory.displacement = total as u64 as i64;
                        memory.start_relative = matches!(memory.base, PatRegister::Rip | PatRegister::Eip);
                    }
                    validate_memory(memory, self.mode).map_err(|reason| AssembleError::InvalidAddress { offset: memory.offset, reason })?;
                }
                _ => {}
            }
        }
        concrete.address_size = concrete.pattern_address_size();
        concrete.variants = concrete.select(catalog_in_mode(self.mode), &self.variants, false)?;
        Ok(concrete)
    }

    fn encode_concrete(&self) -> Result<Vec<Encoded>, AssembleError> {
        let catalog = catalog_in_mode(self.mode);
        let mut results = Vec::new();
        for &index in &self.variants {
            self.encode_variant(&catalog.variants[index as usize], &mut results);
        }
        results.sort_by(|a: &Encoded, b: &Encoded| a.len().cmp(&b.len()).then_with(|| a.bytes().cmp(b.bytes())));
        results.dedup_by(|a, b| a.bytes() == b.bytes());
        if !results.is_empty() { return Ok(results); }
        let form = self.variants.first().map_or("", |index| catalog.variants[*index as usize].encoding().form_id);
        let mnemonic = self.mnemonic_text();
        let registers: Vec<Register> = self.operands.iter().flat_map(|operand| match operand {
            PatOperand::Register(register) => vec![*register],
            PatOperand::Memory(memory) => [memory.base, memory.index].into_iter().filter_map(|register| match register {
                PatRegister::Fixed(register) => Some(register), _ => None,
            }).collect(),
            _ => Vec::new(),
        }).collect();
        if registers.iter().any(|register| register.high8) && registers.iter().any(|register| {
            register.class == RegisterClass::Gpr && !register.high8 && (register.number >= 8 || (register.width == 8 && register.number >= 4) || register.width == 64)
        }) {
            let operand = self.operands.iter().position(|operand| matches!(operand, PatOperand::Register(register) if register.high8)).unwrap_or(0);
            return Err(AssembleError::NoMatchingForm { mnemonic, form, operand, reason: "ah, ch, dh and bh cannot be encoded with a REX prefix" });
        }
        let numeric = self.operands.iter().position(|operand| match operand {
            PatOperand::Number(_) | PatOperand::Immediate(_) | PatOperand::Relative(_) => true,
            PatOperand::Memory(memory) => memory.displacement != 0,
            _ => false,
        });
        match numeric {
            Some(operand) => Err(AssembleError::OperandOutOfRange { operand, form }),
            None => Err(AssembleError::NoMatchingForm { mnemonic, form, operand: 0, reason: "no encoding of the form represents these operands" }),
        }
    }

    fn encode_variant(&self, variant: &Variant, results: &mut Vec<Encoded>) {
        let e = variant.encoding();
        let form = variant.form as usize;
        let mut fields = variant.fields;
        fields.lock = self.lock;
        fields.repeat = self.repeat;
        fields.mask = 0;
        fields.zeroing = false;
        fields.force_rex = false;
        if let Some(rounding) = self.rounding { fields.rounding_control = rounding.min(3); }
        // A variant built under 0x67 has 32-bit address-size registers in its
        // shape, which the shape check already matched against the pattern.
        fields.address_override = (self.address_size != 0 && self.address_size != effective_address_bits(self.mode, false) as u8) || variant.fields.address_override;
        if let Some(decoration) = self.decoration { fields.mask = decoration.mask; fields.zeroing = decoration.zeroing; }
        let mut immediates: [Option<u64>; 4] = [None; 4];
        let mut is4: [Option<u8>; 4] = [None; 4];
        let mut relative = None;
        let mut memory = None;
        for (index, pattern) in self.operands.iter().enumerate() {
            let shape = variant.operand(index);
            if let PatOperand::Register(register) = pattern {
                if register.class == RegisterClass::Gpr && register.width == 8 && !register.high8 && (4..8).contains(&register.number) {
                    fields.force_rex = true;
                }
            }
            match (shape.field, pattern) {
                (Field::Fixed, PatOperand::Memory(memory)) => {
                    if let Some(segment) = memory.segment { fields.segment_override = segment_override_byte(segment); }
                }
                (Field::Fixed, _) => {}
                (Field::Pointer, PatOperand::FarPointer {offset,selector}) => {
                    let bits=if tail_bytes(TAILS[e.tail_start as usize],self.mode,e.mandatory==1 || operand_size_override(self.mode,e.operand_size) || fields.operand_override,false,fields.address_override)==4 {16}else{32};
                    if u128::from(*offset)>=(1u128<<bits) {return}
                    fields.immediate[0]=*offset | (u64::from(*selector)<<bits);
                }
                (Field::Reg, PatOperand::Register(register)) => fields.reg = register.number,
                (Field::Rm, PatOperand::Register(register)) => { fields.mod_bits = 3; fields.rm = register.number; fields.use_sib = false; }
                (Field::Vvvv, PatOperand::Register(register)) => fields.vvvv = register.number,
                (Field::OpcodeReg, PatOperand::Register(register)) => {
                    fields.opcode_reg = register.number;
                    if !e.has_modrm { fields.rm = register.number; }
                }
                (Field::Mask, PatOperand::Register(register)) => fields.mask = register.number,
                (Field::Is4(slot), PatOperand::Register(register)) => is4[slot as usize & 3] = Some(register.number),
                (Field::Immediate(slot), PatOperand::Number(value) | PatOperand::Immediate(value)) => {
                    if !(-(1i128 << 63)..=i128::from(u64::MAX)).contains(value) { return; }
                    immediates[slot as usize & 3] = Some(if *value < 0 { *value as i64 as u64 } else { *value as u64 });
                }
                (Field::Relative(slot), PatOperand::Relative(value)) => relative = Some((slot, *value)),
                (Field::Relative(slot), PatOperand::Number(value)) => {
                    let Some(address) = self.address else { return };
                    if !(0..=i128::from(u64::MAX)).contains(value) { return; }
                    relative = Some((slot, i128::from((*value as u64).wrapping_sub(address) as i64)));
                }
                (Field::Memory, PatOperand::Memory(pattern)) => memory = Some(pattern),
                (Field::Moffs(slot), PatOperand::Memory(pattern)) => {
                    immediates[slot as usize & 3] = Some(pattern.displacement as u64);
                    if let Some(segment) = pattern.segment { fields.segment_override = segment_override_byte(segment); }
                }
                _ => return,
            }
        }
        for slot in 0..4 {
            match (immediates[slot], is4[slot]) {
                (Some(value), Some(register)) => fields.immediate[slot] = u64::from(register) << 4 | (value & 0x0f),
                (None, Some(register)) => fields.immediate[slot] = u64::from(register) << 4,
                (Some(value), None) => fields.immediate[slot] = value,
                (None, None) => {}
            }
        }
        let Some(memory) = memory else {
            self.finish(form, fields, relative, None, results);
            return;
        };
        if let Some(segment) = memory.segment { fields.segment_override = segment_override_byte(segment); }
        let displacement = memory.displacement;
        let rip_target = memory.start_relative.then_some(displacement);
        let (base, index) = match (memory.base, memory.index) {
            (PatRegister::Rip | PatRegister::Eip, PatRegister::Absent) => {
                if rip_target.is_some() || fits_i32(displacement) {
                    let mut f = fields;
                    f.mod_bits = 0; f.rm = 5; f.use_sib = false;
                    f.displacement = if rip_target.is_some() { 0 } else { displacement };
                    self.finish(form, f, relative, rip_target, results);
                }
                return;
            }
            (PatRegister::Fixed(base), PatRegister::Fixed(index)) => (Some(base), Some(index)),
            (PatRegister::Fixed(base), PatRegister::Absent) => (Some(base), None),
            (PatRegister::Absent, PatRegister::Fixed(index)) => (None, Some(index)),
            (PatRegister::Absent, PatRegister::Absent) => (None, None),
            _ => return,
        };
        if effective_address_bits(self.mode, fields.address_override)==16 {
            if !matches!(memory.scale,PatScale::Fixed(1)) {return}
            let mut registers:Vec<u8>=[base,index].into_iter().flatten().map(|r|r.number).collect();registers.sort();
            let rm=match registers.as_slice() {[]=>6,[3,6]=>0,[3,7]=>1,[5,6]=>2,[5,7]=>3,[6]=>4,[7]=>5,[5]=>6,[3]=>7,_=>return};
            let mut layout=fields;layout.rm=rm;layout.use_sib=false;
            if registers.is_empty() {
                if (-32768..=65535).contains(&displacement) {layout.mod_bits=0;layout.displacement=displacement;self.finish(form,layout,relative,None,results)}
                return
            }
            if displacement==0 && rm!=6 {let mut f=layout;f.mod_bits=0;f.displacement=0;self.finish(form,f,relative,None,results)}
            if fits_i8(displacement) {let mut f=layout;f.mod_bits=1;f.displacement=displacement;self.finish(form,f,relative,None,results)}
            if i16::try_from(displacement).is_ok() {layout.mod_bits=2;layout.displacement=displacement;self.finish(form,layout,relative,None,results)}
            return
        }
        let scale_bits = match memory.scale { PatScale::Fixed(1) => 0, PatScale::Fixed(2) => 1, PatScale::Fixed(4) => 2, PatScale::Fixed(8) => 3, _ => return };
        let mut sib = fields;
        sib.rm = 4;
        sib.use_sib = true;
        sib.scale = scale_bits;
        if let Some(index) = index {
            sib.index = index.number;
            if index.class == RegisterClass::Vector && index.number >= 16 { sib.vvvv |= 0x10; }
        } else {
            sib.index = 4;
        }
        let Some(base) = base else {
            if index.is_none() && self.mode!=Mode::Mode64 && (-2147483648..=4294967295).contains(&displacement) {
                let mut f=fields;f.mod_bits=0;f.rm=5;f.use_sib=false;f.displacement=displacement;
                self.finish(form,f,relative,None,results);
            }
            // No base: SIB with base 101 and mod 00 takes a 32-bit displacement.
            if fits_i32(displacement) {
                let mut f = sib;
                f.mod_bits = 0; f.base = 5; f.displacement = displacement;
                self.finish(form, f, relative, None, results);
            }
            return;
        };
        let mut layout = if index.is_some() || base.number & 7 == 4 { sib } else {
            let mut f = fields;
            f.rm = base.number;
            f.use_sib = false;
            f
        };
        layout.base = base.number;
        if !layout.use_sib { layout.rm = base.number; }
        if displacement == 0 && base.number & 7 != 5 {
            let mut f = layout;
            f.mod_bits = 0; f.displacement = 0;
            self.finish(form, f, relative, None, results);
        }
        let mut short = layout;
        short.mod_bits = 1;
        if e.kind == 2 {
            // EVEX compresses disp8 by the operand's N; measure it by decoding
            // a trial encoding with disp8 = 1.
            let mut trial = short;
            trial.displacement = 1;
            trial.immediate = [0; 4];
            let mut out = [0u8; 15];
            if let Some(scale) = encode(form, trial, &mut out).ok()
                .and_then(|length| decode(&out[..length], self.mode).ok())
                .and_then(|decoded| decoded.operands().iter().find(|operand| operand.kind == OperandKind::Memory).map(|operand| operand.memory.displacement))
                .filter(|scale| *scale > 0)
            {
                if displacement % scale == 0 && fits_i8(displacement / scale) {
                    short.displacement = displacement / scale;
                    self.finish(form, short, relative, None, results);
                }
            }
        } else if fits_i8(displacement) {
            short.displacement = displacement;
            self.finish(form, short, relative, None, results);
        }
        if fits_i32(displacement) {
            let mut f = layout;
            f.mod_bits = 2; f.displacement = displacement;
            self.finish(form, f, relative, None, results);
        }
    }

    fn finish(&self, form: usize, mut fields: EncodeFields, relative: Option<(u8, i128)>, rip_target: Option<i64>, results: &mut Vec<Encoded>) {
        let mut out = [0u8; 15];
        let Ok(mut length) = encode(form, fields, &mut out) else { return };
        if relative.is_some() || rip_target.is_some() {
            if let Some((slot, target)) = relative {
                let Ok(decoded)=decode(&out[..length],self.mode) else{return};
                let bits=relative_address_bits(&decoded.physical,decoded.encoding().mnemonic);
                let displacement=modular_displacement((target-length as i128) as u64,bits);
                fields.immediate[slot as usize & 3] = displacement as u64;
            }
            if let Some(target) = rip_target {
                // The displacement field is 32 bits and counts from the end of the instruction.
                let Some(displacement) = target.checked_sub(length as i64).filter(|displacement| fits_i32(*displacement)) else { return };
                fields.displacement = displacement;
            }
            out = [0u8; 15];
            length = match encode(form, fields, &mut out) { Ok(length) => length, Err(_) => return };
        }
        let Ok(decoded) = decode(&out[..length], self.mode) else { return };
        if decoded.length as usize != length { return; }
        let view = self.matching_view(&decoded);
        let mut slots = [None; MAX_HOLES];
        if self.view_matches(&view, &mut slots, &Bind::Ignore) {
            results.push(Encoded { bytes: out, length: length as u8, form_index: decoded.form_index, fields });
            if self.mode!=Mode::Mode64 {
                if let Some(position)=out[..length].windows(2).position(|pair|pair[0]==0x66 && matches!(pair[1],0xf2|0xf3)) {
                    let mut reordered=out;reordered.swap(position,position+1);
                    results.push(Encoded {bytes:reordered,length:length as u8,form_index:decoded.form_index,fields});
                }
            }
        }
    }

    /// A concrete template denoting exactly the decoded instruction.
    fn from_view(view: &View, catalog: &Catalog, mode: Mode) -> Option<Template> {
        let operands = view.operands().iter().map(|operand| Some(match *operand {
            ViewOperand::Register(register) => PatOperand::Register(register),
            ViewOperand::Memory(memory) => PatOperand::Memory(PatMemory {
                prefix: memory.prefix,
                size: Some(memory.size),
                segment: memory.segment,
                base: if memory.rip { if view.address_size == 32 { PatRegister::Eip } else { PatRegister::Rip } } else { memory.base.map_or(PatRegister::Absent, PatRegister::Fixed) },
                index: memory.index.map_or(PatRegister::Absent, PatRegister::Fixed),
                scale: PatScale::Fixed(memory.scale),
                displacement: memory.displacement,
                displacement_hole: None,
                start_relative: false,
                offset: 0,
            }),
            ViewOperand::Immediate { value, .. } => PatOperand::Immediate(i128::from(value)),
            ViewOperand::Relative{displacement,..} => PatOperand::Relative(i128::from(displacement)),
            ViewOperand::Text(text) => PatOperand::Text(text.to_ascii_lowercase()),
            ViewOperand::FarPointer {offset,selector} => PatOperand::FarPointer {offset,selector:u16::try_from(selector).ok()?},
            ViewOperand::Pointer(_) => return None,
        })).collect::<Option<Vec<_>>>()?;
        let mut forms = vec![0u64; ENCODINGS.len().div_ceil(64)];
        forms[view.form_index as usize / 64] |= 1 << (view.form_index % 64);
        let (start, count) = catalog.by_form[view.form_index as usize];
        let mut template = Template {
            mode, text: String::new(), address: None, mnemonic: PatMnemonic::Exact(view.mnemonic.to_ascii_lowercase()),
            lock: view.lock, repeat: view.repeat, operands,
            decoration: (view.mask != 0).then_some(Decoration { after: view.mask_after, mask: view.mask, zeroing: view.zeroing }),
            rounding: view.rounding,
            address_size: effective_address_bits(mode, false) as u8, holes: Vec::new(), forms, variants: (start..start + u32::from(count)).collect(),
            first_bytes: [0; 4], opcode_bytes: [0; 4], repeat_open: false,
        };
        template.address_size = if view.address_size != 0 { view.address_size } else { template.pattern_address_size() };
        template.compute_first_bytes();
        Some(template)
    }
}

fn condition_alias(name: &str) -> Option<String> {
    for prefix in ["cmov", "set", "j"] {
        if let Some(suffix) = name.strip_prefix(prefix) {
            if let Some((_, code)) = CONDITION_ALIASES.iter().find(|(alias, _)| *alias == suffix) {
                return Some(format!("{prefix}{}", CONDITION_NAMES[*code as usize]));
            }
        }
    }
    None
}

// ---------------------------------------------------------------------------
// Describing decoded instructions as template text with operand spans
// ---------------------------------------------------------------------------

/// One operand component of a described instruction that a hole may replace.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct OperandSpan {
    /// Byte range in [`Described::text`] that `$name` (or `$name:class`) may replace.
    pub start: usize,
    pub end: usize,
    pub class: OperandClass,
    pub value: i128,
    /// How the value relates to the instruction's position: relative branch
    /// targets and RIP-relative displacements are measured from the
    /// instruction's first byte. For a RIP-relative displacement the text
    /// shows the displacement field as the formatter does (from the end of
    /// the instruction); `value` is the hole's value, field plus length.
    pub position: Position,
}

impl OperandSpan {
    /// Whether the value is an offset from the instruction's address.
    pub fn position_dependent(&self) -> bool { self.position.is_position_dependent() }
}

/// A decoded instruction as position-independent template text plus spans.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct Described {
    pub len: usize,
    pub text: String,
    pub operands: Vec<OperandSpan>,
}

impl Described {
    /// The text with one span replaced by `replacement` (for example `$h` or `$h:gpr64`).
    pub fn with_hole(&self, span: usize, replacement: &str) -> Option<String> {
        let span = self.operands.get(span)?;
        let mut text = String::with_capacity(self.text.len() + replacement.len());
        text.push_str(&self.text[..span.start]);
        text.push_str(replacement);
        text.push_str(&self.text[span.end..]);
        Some(text)
    }
}

/// Describe the instruction at the start of `bytes` (64-bit mode) as text that
/// [`Template::parse`] accepts and that matches `bytes`, with a span for every
/// component a hole can stand for. Branch targets print as `.+N` from the
/// first byte, so the text does not depend on the instruction's address.
/// Unlike [`format_intel`] it always prints `*1` for an index and `+0x0` for a
/// zero displacement beside a base, so those components have spans too.
pub fn describe(bytes: &[u8]) -> Option<Described> {describe_in_mode(bytes,DEFAULT_MODE)}

/// Describe an instruction using its explicit execution mode.
pub fn describe_in_mode(bytes: &[u8], mode: Mode) -> Option<Described> {
    let decoded = decode(bytes, mode).ok()?;
    let view = view(&decoded);
    if view.overflow || view.broadcast { return None; }
    let mut text = String::new();
    let mut operands = Vec::new();
    let mut span = |text: &mut String, written: &str, value: OperandValue| {
        let start = text.len();
        text.push_str(written);
        operands.push(OperandSpan { start, end: text.len(), class: value.class, value: value.value, position: value.position });
    };
    if view.lock { text.push_str("lock "); }
    if !view.repeat_text.is_empty() { text.push_str(view.repeat_text); text.push(' '); }
    let mnemonic = view.mnemonic.to_ascii_lowercase();
    let encoding = &ENCODINGS[view.form_index as usize];
    let condition = [("j", ConditionFamily::Jump), ("cmov", ConditionFamily::Move), ("set", ConditionFamily::Set)].into_iter()
        .find_map(|(prefix, family)| {
            let code = condition_code(encoding, family)?;
            let suffix = mnemonic.strip_prefix(prefix)?;
            (suffix == CONDITION_NAMES[code as usize]).then_some((prefix, code))
        });
    match condition {
        Some((prefix, code)) => {
            text.push_str(prefix);
            span(&mut text, CONDITION_NAMES[code as usize], OperandValue::new(OperandClass::Condition, i128::from(code)));
        }
        None => text.push_str(&mnemonic),
    }
    let decoration = |text: &mut String| {
        if view.mask != 0 {
            text.push('{');
            let _ = write!(text, "k{}", view.mask);
            text.push('}');
            if view.zeroing { text.push_str("{z}"); }
        }
    };
    for (index, operand) in view.operands().iter().enumerate() {
        if index == view.mask_after as usize { decoration(&mut text); }
        text.push_str(if index == 0 { " " } else { ", " });
        match *operand {
            ViewOperand::Register(register) => {
                let mut name = String::new();
                write_register(&mut name, register);
                match OperandValue::from_register(register) {
                    Some(value) => span(&mut text, &name, value),
                    None => text.push_str(&name),
                }
            }
            ViewOperand::Immediate { value, .. } => {
                span(&mut text, &format!("0x{value:x}"), OperandValue::new(OperandClass::Immediate, i128::from(value)));
            }
            ViewOperand::Relative{displacement,..} => {
                let written = OperandClass::Relative.format_value(i128::from(displacement))?;
                span(&mut text, &written, OperandValue::new(OperandClass::Relative, i128::from(displacement)));
            }
            ViewOperand::Memory(memory) => {
                match memory.prefix {
                    MemoryPrefix::None => {}
                    MemoryPrefix::Far => text.push_str("far "),
                    MemoryPrefix::FpuEnv14 => text.push_str("fpuenv14 ptr "),
                    MemoryPrefix::FpuState94 => text.push_str("fpustate94 ptr "),
                }
                if memory.size != 0 { text.push_str(size_keyword(memory.size)); text.push_str(" ptr "); }
                if let Some(segment) = memory.segment { write_register(&mut text, segment); text.push(':'); }
                text.push('[');
                let mut term = false;
                if memory.rip {
                    text.push_str(if view.address_size == 32 { "eip" } else { "rip" });
                    term = true;
                } else if let Some(base) = memory.base {
                    let mut name = String::new();
                    write_register(&mut name, base);
                    span(&mut text, &name, OperandValue::from_register(base)?);
                    term = true;
                }
                if let Some(index) = memory.index {
                    if term { text.push('+'); }
                    let mut name = String::new();
                    write_register(&mut name, index);
                    span(&mut text, &name, OperandValue::from_register(index)?);
                    text.push('*');
                    span(&mut text, &memory.scale.to_string(), OperandValue::new(OperandClass::Scale, i128::from(memory.scale)));
                    term = true;
                }
                if term { text.push('+'); }
                let displacement = i128::from(memory.displacement);
                let written = OperandClass::Displacement.format_value(displacement)?;
                let value = OperandValue::new(OperandClass::Displacement, displacement);
                span(&mut text, &written, if memory.rip {
                    OperandValue::new(OperandClass::Displacement, displacement + i128::from(view.length)).with_position(if view.address_size == 32 { Position::WrappingInstructionRelative { bits:32 } } else { Position::InstructionRelative })
                } else { value });
                text.push(']');
            }
            ViewOperand::FarPointer {offset,selector} => {let _=write!(text,"far 0x{offset:x}, 0x{selector:x}");}
            ViewOperand::Pointer(_) | ViewOperand::Text(_) => return None,
        }
    }
    if view.mask_after as usize >= view.operands().len() { decoration(&mut text); }
    write_rounding(&mut text, view.rounding);
    Some(Described { len: view.length as usize, text, operands })
}

// ---------------------------------------------------------------------------
// Editable forms: full register and memory operands
// ---------------------------------------------------------------------------

impl FormInstruction {
    /// Replace one explicit register operand with any register the form takes
    /// in that position (any class, including EVEX registers 16..31).
    pub fn set_register(&mut self, index: usize, register: FormRegister) -> Result<(), EncodeError> {
        self.replace_view_operand(index, |operand| match operand {
            PatOperand::Register(_) => Some(PatOperand::Register(register)),
            _ => None,
        })
    }

    /// Replace one explicit memory operand's segment, base, index, scale,
    /// displacement and RIP-relative flag. The form fixes the access size, so
    /// `memory.size` and `displacement_width` are ignored. For IP-relative
    /// addresses, `address_size == 32` selects EIP; otherwise RIP is selected.
    /// 32-bit base/index registers select 32-bit addressing.
    pub fn set_memory(&mut self, index: usize, memory: FormMemory) -> Result<(), EncodeError> {
        self.replace_view_operand(index, |operand| match operand {
            PatOperand::Memory(current) => Some(PatOperand::Memory(PatMemory {
                segment: memory.segment,
                base: if memory.rip_relative { if memory.address_size == 32 { PatRegister::Eip } else { PatRegister::Rip } } else { memory.base.map_or(PatRegister::Absent, PatRegister::Fixed) },
                index: memory.index.map_or(PatRegister::Absent, PatRegister::Fixed),
                scale: PatScale::Fixed(if memory.index.is_some() { memory.scale } else { 1 }),
                displacement: memory.displacement,
                ..current.clone()
            })),
            _ => None,
        })
    }

    fn replace_view_operand(&mut self, index: usize, replace: impl FnOnce(&PatOperand) -> Option<PatOperand>) -> Result<(), EncodeError> {
        let catalog = catalog_in_mode(self.fields.mode);
        let view = view(&self.decoded);
        let position = explicit_view_position(&self.decoded, index).ok_or(EncodeError::BadField)?;
        let mut template = Template::from_view(&view, catalog, self.fields.mode).ok_or(EncodeError::Unsupported)?;
        let current = template.operands.get(position).ok_or(EncodeError::BadField)?;
        let replacement = replace(current).ok_or(EncodeError::BadField)?;
        if let PatOperand::Memory(memory) = &replacement {
            validate_memory(memory, self.fields.mode).map_err(|_| EncodeError::BadField)?;
        }
        template.operands[position] = replacement;
        template.address_size = template.pattern_address_size();
        template.variants = template.select(catalog, &template.variants.clone(), false).map_err(|_| EncodeError::BadField)?;
        let encodings = template.encode_concrete().map_err(|error| match error {
            AssembleError::OperandOutOfRange { .. } => EncodeError::OutOfRange,
            _ => EncodeError::BadField,
        })?;
        let chosen = encodings.iter().find(|encoded| encoded.form_index == self.form_index()).ok_or(EncodeError::BadField)?;
        self.decoded = decode(chosen.bytes(), self.fields.mode).map_err(|_| EncodeError::BadField)?;
        self.fields = chosen.fields;
        Ok(())
    }
}

/// The view position of the `index`-th explicit decoded operand, when the
/// formatter prints it as an operand of its own.
fn explicit_view_position(decoded: &Decoded, index: usize) -> Option<usize> {
    let gather = decoded.encoding().mnemonic.contains("GATHER") || decoded.encoding().mnemonic.contains("SCATTER");
    let mut position = 0;
    for (explicit, operand) in decoded.operands().iter().filter(|operand| !operand.implicit).enumerate() {
        let shown = match operand.kind {
            OperandKind::Mask => gather && operand.register.is_some_and(|register| register.number != 0),
            OperandKind::None => false,
            _ => true,
        };
        if explicit == index { return shown.then_some(position); }
        if shown { position += 1; }
    }
    None
}

#[cfg(test)]
mod tests {
    use super::*;

    // These regressions specify long-mode instruction semantics explicitly.
    // The selected default is exercised separately through the public crate API.
    fn parse64(text: &str) -> Result<Template, AssembleError> { Template::parse_in_mode(text, Mode::Mode64) }
    fn assemble(text: &str) -> Result<Vec<Encoded>, AssembleError> { assemble_in_mode(text, Mode::Mode64) }
    fn assemble_at(text: &str, address: u64) -> Result<Vec<Encoded>, AssembleError> { assemble_at_in_mode(text, address, Mode::Mode64) }
    fn describe(bytes: &[u8]) -> Option<Described> { describe_in_mode(bytes, Mode::Mode64) }

    fn has(mnemonic: &str) -> bool { ENCODINGS.iter().any(|encoding| encoding.mnemonic == mnemonic) }

    fn bytes_of(results: &[Encoded]) -> Vec<Vec<u8>> { results.iter().map(|encoded| encoded.bytes().to_vec()).collect() }

    #[test]
    fn constrained_register_domains_remain_conservative() {
        if !has("VFCMADDCPH") { return; }
        let template = parse64("vfcmaddcph xmm1, $source:xmm, xmm3").unwrap();
        assert!(template.holes[0].domains.iter().all(|entry| !entry.domain.exact));
        assert!(template.encode(&[OperandValue::new(OperandClass::Xmm, 1)]).is_err());
        assert!(!template.encode(&[OperandValue::new(OperandClass::Xmm, 2)]).unwrap().is_empty());
    }

    #[test]
    fn sae_and_embedded_rounding_survive_text_templates_and_description() {
        for (mnemonic, operands, decorations) in [
            ("VADDPH", "zmm1, zmm2, zmm3", &["rn-sae", "rd-sae", "ru-sae", "rz-sae"][..]),
            ("VGETEXPPH", "zmm1, zmm3", &["sae"][..]),
        ] {
            if !ENCODINGS.iter().any(|e| e.mnemonic == mnemonic && e.suppress_exceptions) { continue; }
            for decoration in decorations {
                let text = format!("{} {operands}, {}{decoration}{}", mnemonic.to_ascii_lowercase(), '{', '}');
                let template = parse64(&text).unwrap();
                let encodings = assemble(&text).unwrap();
                assert!(!encodings.is_empty(), "{text}");
                for encoding in encodings {
                    let decoded = decode(encoding.bytes(), Mode::Mode64).unwrap();
                    assert_eq!(decoded.format_intel(0), text);
                    let mut printed = String::new();
                    write_view(&mut printed, &view(&decoded), 0);
                    assert_eq!(printed, text);
                    assert!(template.matches(encoding.bytes(), &mut Vec::new()).is_some());
                    let described = describe(encoding.bytes()).unwrap();
                    assert!(parse64(&described.text).unwrap().matches(encoding.bytes(), &mut Vec::new()).is_some());
                }
            }
        }
        for text in ["nop, {sae}", "vaddph zmm1, zmm2, zmm3, {sae}",
            "vgetexpph zmm1, zmm3, {rn-sae}", "vaddph zmm1, zmm2, zmm3, {rn-sae}, {rd-sae}"] {
            assert!(parse64(text).is_err(), "{text}");
        }
    }

    #[test]
    fn assembles_documented_examples() {
        if has("XOR") {
            let xor = bytes_of(&assemble("xor eax, eax").unwrap());
            assert!(xor.contains(&vec![0x31, 0xc0]), "{xor:02x?}");
            if ENCODINGS.iter().any(|encoding| encoding.mnemonic == "XOR" && encoding.opcode == 0x33) {
                assert!(xor.contains(&vec![0x33, 0xc0]), "{xor:02x?}");
            }
            assert_eq!(bytes_of(&assemble("  XOR   EAX ,EAX ").unwrap()), xor);
        }
        if has("LEA") {
            let lea = bytes_of(&assemble("lea rdi, [rip + 0x10]").unwrap());
            assert!(lea.contains(&vec![0x48, 0x8d, 0x3d, 0x10, 0, 0, 0]), "{lea:02x?}");
        }
        if has("CALL") {
            let call = bytes_of(&assemble("call .+5").unwrap());
            assert!(call.contains(&vec![0xe8, 0, 0, 0, 0]), "{call:02x?}");
            let at = bytes_of(&assemble_at("call 0x1105", 0x1000).unwrap());
            assert!(at.contains(&vec![0xe8, 0x00, 0x01, 0x00, 0x00]), "{at:02x?}");
            assert!(matches!(assemble("call 0x1105"), Err(AssembleError::RelativeNeedsAddress { operand: 0 })));
        }
        if has("TZCNT") {
            // A VEX form printing the same text must not hide the legacy REX.W encoding.
            let tzcnt = bytes_of(&assemble("tzcnt rax, rax").unwrap());
            assert!(tzcnt.contains(&vec![0xf3, 0x48, 0x0f, 0xbc, 0xc0]), "{tzcnt:02x?}");
        }
        if has("JMP") {
            // 0x66 on a near branch is vendor-dependent; it is never chosen.
            let jmp = bytes_of(&assemble("jmp .+2").unwrap());
            assert!(jmp.contains(&vec![0xeb, 0x00]), "{jmp:02x?}");
            assert!(jmp.iter().all(|bytes| bytes[0] != 0x66), "{jmp:02x?}");
        }
        if ENCODINGS.iter().any(|encoding| encoding.mnemonic == "ADD" && encoding.opcode == 0x83) {
            let add = bytes_of(&assemble("add eax, 1").unwrap());
            assert_eq!(add[0], vec![0x83, 0xc0, 0x01], "shortest first: {add:02x?}");
            assert!(add.contains(&vec![0x05, 1, 0, 0, 0]) && add.contains(&vec![0x81, 0xc0, 1, 0, 0, 0]), "{add:02x?}");
        }
        if ENCODINGS.iter().any(|encoding| encoding.mnemonic == "MOV" && encoding.opcode == 0x8b) {
            let mov = bytes_of(&assemble("mov eax, dword ptr [rbp - 4]").unwrap());
            assert!(mov.contains(&vec![0x8b, 0x45, 0xfc]), "{mov:02x?}");
            assert_eq!(bytes_of(&assemble("mov eax, dword ptr [rbp + -4]").unwrap()), mov);
            assert_eq!(bytes_of(&assemble("mov eax, [rbp-0x4]").unwrap()), mov);
            assert!(mov.contains(&vec![0x8b, 0x85, 0xfc, 0xff, 0xff, 0xff]), "disp32 alternative: {mov:02x?}");
        }
    }

    #[test]
    fn templates_match_and_encode() {
        let mut values = Vec::new();
        if has("CALL") {
            let call = parse64("call $target").unwrap();
            assert_eq!(call.holes().len(), 1);
            assert_eq!(call.holes()[0].name(), "target");
            assert!(call.holes()[0].classes().contains(&OperandClass::Relative));
            assert_eq!(call.matches(&[0xe8, 0x10, 0, 0, 0], &mut values), Some(5));
            assert_eq!(values, vec![OperandValue::new(OperandClass::Relative, 0x15)]);
            let encoded = call.encode(&values).unwrap();
            assert!(bytes_of(&encoded).contains(&vec![0xe8, 0x10, 0, 0, 0]));
        }
        if ENCODINGS.iter().any(|encoding| encoding.mnemonic == "MOV" && encoding.opcode == 0x8b) {
            let mov = parse64("mov $r, dword ptr [rbp + $off]").unwrap();
            assert_eq!(mov.matches(&[0x8b, 0x45, 0xfc], &mut values), Some(3));
            assert_eq!(values, vec![OperandValue::new(OperandClass::Gpr32, 0), OperandValue::new(OperandClass::Displacement, -4)]);
            assert_eq!(mov.matches(&[0x8b, 0x85, 0xfc, 0xff, 0xff, 0xff], &mut values), Some(6));
            assert_eq!(mov.matches(&[0x8b, 0x44, 0x24, 0x08], &mut values), None, "rsp base is not rbp");
            let encoded = bytes_of(&mov.encode(&[OperandValue::new(OperandClass::Gpr32, 9), OperandValue::new(OperandClass::Displacement, 0x80)]).unwrap());
            assert_eq!(encoded, vec![vec![0x44, 0x8b, 0x8d, 0x80, 0, 0, 0]]);
            let wide = parse64("mov $r:gpr64, qword ptr [$base + $index*$scale + $disp]").unwrap();
            assert_eq!(wide.holes().iter().map(Hole::name).collect::<Vec<_>>(), ["r", "base", "index", "scale", "disp"]);
            assert_eq!(wide.matches(&[0x4a, 0x8b, 0x44, 0xa2, 0x10], &mut values), Some(5));
            assert_eq!(values[2], OperandValue::new(OperandClass::Gpr64, 12));
            assert_eq!(values[3], OperandValue::new(OperandClass::Scale, 4));
            assert!(matches!(parse64("mov $r, [rax]"), Err(AssembleError::AmbiguousSize { operand: 1, .. })));
            assert!(matches!(
                parse64("mov $r:xmm, dword ptr [rax]"),
                Err(AssembleError::HoleClassMismatch { .. })
            ));
        }
        if has("XOR") {
            let same = parse64("xor $r, $r").unwrap();
            assert_eq!(same.holes().len(), 1);
            assert_eq!(same.matches(&[0x31, 0xc0], &mut values), Some(2));
            assert_eq!(same.matches(&[0x31, 0xc8], &mut values), None);
            let any = parse64("xor _, eax").unwrap();
            assert_eq!(any.matches(&[0x31, 0xc1], &mut values), Some(2));
            assert!(values.is_empty());
            assert!(matches!(any.encode(&[]), Err(AssembleError::UnboundHole { .. })));
        }
        if has("CMP") {
            let cmp = parse64("cmp $r, $imm").unwrap();
            assert!(cmp.holes()[1].classes().contains(&OperandClass::Immediate));
            assert_eq!(cmp.matches(&[0x48, 0x83, 0xf8, 0x05], &mut values), Some(4));
            assert_eq!(values, vec![OperandValue::new(OperandClass::Gpr64, 0), OperandValue::new(OperandClass::Immediate, 5)]);
        }
        if has("JZ") {
            let jcc = parse64("j$cc $target").unwrap();
            assert_eq!(jcc.matches(&[0x74, 0x05], &mut values), Some(2));
            assert_eq!(values, vec![OperandValue::new(OperandClass::Condition, 4), OperandValue::new(OperandClass::Relative, 7)]);
            let encoded = bytes_of(&jcc.encode(&[OperandValue::new(OperandClass::Condition, 5), OperandValue::new(OperandClass::Relative, 2)]).unwrap());
            assert!(encoded.contains(&vec![0x75, 0x00]), "{encoded:02x?}");
            assert!(bytes_of(&assemble("je .+2").unwrap()).contains(&vec![0x74, 0x00]));
        }
    }

    /// Bits set in a first-byte set.
    fn population(set: [u64; 4]) -> u32 { set.iter().map(|word| word.count_ones()).sum() }

    #[test]
    fn first_bytes_follow_the_text() {
        let set = |text: &str| parse64(text).unwrap_or_else(|error| panic!("{text}: {error}")).first_bytes();
        let allows = |set: [u64; 4], byte: u8| set[byte as usize / 64] >> (byte % 64) & 1 == 1;
        let mut report = String::new();
        for text in ["call $t", "mov $d, $s", "ret", "test $r, $r"] {
            if let Ok(template) = parse64(text) {
                let _ = writeln!(report, "selectivity {text:?}: {} of 256 first bytes", population(template.first_bytes()));
            }
        }
        eprint!("{report}");
        if has("RET") {
            let ret = set("ret");
            assert!(allows(ret, 0xc3) && allows(ret, 0x66) && allows(ret, 0x48), "prefixes and REX may lead");
            assert!(!allows(ret, 0xf0) && !allows(ret, 0xf3), "`lock` and `rep` are not in the text");
            assert!(!allows(ret, 0xe8) && !allows(ret, 0x90));
            assert!(allows(set("lock ret"), 0xf0) && !allows(set("lock ret"), 0x48));
            assert!(allows(set("rep ret"), 0xf3));
            let plain = parse64("ret").unwrap();
            assert!(plain.could_match(&[0xc3]) && plain.could_match(&[0x66, 0xc3]) && plain.could_match(&[0x2e, 0x48, 0xc3]));
            assert!(!plain.could_match(&[0xf3, 0xc3]) && !plain.could_match(&[0xf0, 0xc3]) && !plain.could_match(&[0x90]));
            assert!(!plain.could_match(&[0x48]) && !plain.could_match(&[]) && !plain.could_match(&[0x66; 15]));
            let rep = parse64("rep ret").unwrap();
            assert!(rep.could_match(&[0xf3, 0xc3]) && !rep.could_match(&[0xc3]) && !rep.could_match(&[0xf2, 0xc3]));
        }
        if has("CALL") {
            let call = set("call $t");
            assert!(allows(call, 0xe8));
            if has("MOV") { assert!(population(call) < population(set("mov $d, $s"))); }
        }
        if has("VPXOR") {
            let vpxor = set("vpxor $a, $b, $c");
            assert!(allows(vpxor, 0xc5) && allows(vpxor, 0xc4) && !allows(vpxor, 0x62), "VEX only");
            if has("VPXORD") { assert!(allows(set("vpxord $a, $b, $c"), 0x62)); }
        }
        // Every instruction's first byte is allowed by the text that decodes from it.
        let mut values = Vec::new();
        for form in 0..ENCODINGS.len().min(4096) {
            let e = &ENCODINGS[form];
            if !encoding_supports_mode(form, Mode::Mode64) || e.kind != 0 || e.map != 0 || e.has_modrm { continue; }
            let bytes = [e.opcode, 0, 0, 0, 0, 0, 0, 0, 0];
            let Ok(decoded) = decode(&bytes, Mode::Mode64) else { continue };
            let Some(template) = parse64(&decoded.format_intel(0x1000)).ok() else { continue };
            if template.matches(&bytes, &mut values).is_some() { assert!(allows(template.first_bytes(), e.opcode)); }
        }
    }

    #[test]
    fn positions_follow_the_text() {
        use Position::*;
        assert_eq!(target(InstructionRelative, 0x1000, 8), Some(0x1008));
        assert_eq!(target(InstructionRelative, 0x1000, -0x1001), None);
        assert_eq!(target(InstructionRelative, u64::MAX, 1), None);
        assert_eq!(target(Fixed, 0x1000, 8), None);
        assert_eq!(value_for_target(InstructionRelative, 0x1000, 0xff8), Some(-8));
        assert_eq!(value_for_target(PageRelative { shift: 12 }, 0x1234, 0x3004), None);
        assert_eq!(value_for_target(PageRelative { shift: 12 }, 0x1234, 0x3000), Some(0x2000));
        let mut values = Vec::new();
        if has("CALL") {
            let call = parse64("call $t").unwrap();
            // `call rax` also fits the bare hole when the table has it, so only the match decides.
            assert!(matches!(call.hole_position(0), None | Some(InstructionRelative)));
            assert_eq!(parse64("call $t:relative").unwrap().hole_position(0), Some(InstructionRelative));
            assert_eq!(call.matches(&[0xe8, 0x10, 0, 0, 0], &mut values), Some(5));
            assert_eq!(values[0].position, InstructionRelative);
            // The value counts from the first byte: the target is address + 0x15.
            assert_eq!(target(values[0].position, 0x2000, values[0].value), Some(0x2015));
            assert_eq!(value_for_target(InstructionRelative, 0x3000, 0x2015), Some(-0xfeb));
            let encoded = call.encode(&[OperandValue::new(OperandClass::Relative, -0xfeb)]).unwrap();
            assert_eq!(encoded[0].bytes(), [0xe8, 0x10, 0xf0, 0xff, 0xff]);
        }
        if has("LEA") {
            let lea = parse64("lea rdi, [rip + $d]").unwrap();
            assert_eq!(lea.hole_position(0), Some(InstructionRelative));
            assert_eq!(lea.matches(&[0x48, 0x8d, 0x3d, 0x10, 0, 0, 0], &mut values), Some(7));
            // Field 0x10 counts from the end of the 7-byte instruction: 0x17 from its start.
            assert_eq!(values, vec![OperandValue::new(OperandClass::Displacement, 0x17).with_position(InstructionRelative)]);
            assert_eq!(target(values[0].position, 0x1000, values[0].value), Some(0x1017));
            let encoded = lea.encode(&values).unwrap();
            assert_eq!(encoded[0].bytes(), [0x48, 0x8d, 0x3d, 0x10, 0, 0, 0]);
            // The literal form keeps the formatter's meaning: the field itself.
            assert_eq!(bytes_of(&assemble("lea rdi, [rip + 0x10]").unwrap())[0], vec![0x48, 0x8d, 0x3d, 0x10, 0, 0, 0]);
            let based = parse64("lea rdi, [rbx + $d]").unwrap();
            assert_eq!(based.hole_position(0), Some(Fixed));
        }
        if has("MOV") {
            let mov = parse64("mov $r, $s").unwrap();
            assert_eq!(mov.hole_position(0), Some(Fixed));
        }
        assert_eq!(OperandValue::new(OperandClass::Immediate, 1).position, Fixed);
    }

    #[test]
    fn domains_follow_the_form() {
        let domains = |text: &str, class: OperandClass| parse64(text).unwrap_or_else(|error| panic!("{text}: {error}"))
            .hole_domains(0).iter().filter(|entry| entry.class == class).map(|entry| entry.domain).collect::<Vec<_>>();
        use OperandClass::*;
        assert_eq!(OperandClass::Gpr64.domain(), Domain::new(0, 15, 1, true));
        assert_eq!(OperandClass::Zmm.domain(), Domain::new(0, 31, 1, true));
        assert_eq!(OperandClass::Condition.domain(), Domain::new(0, 15, 1, true));
        assert!(!OperandClass::Immediate.domain().exact && OperandClass::Scale.domain().max == 8);
        if has("ADD") {
            // imm8 sign-extended inside imm32 collapses to the imm32 entries: either
            // reading of -2^31..2^31, or the 64-bit pattern `matches` yields.
            eprintln!("add rsp, $n: {:?}", domains("add rsp, $n", Immediate));
            let wide = (1i128 << 64) - 1;
            assert_eq!(domains("add rsp, $n", Immediate), [
                Domain::new(-(1 << 31), (1 << 31) - 1, 1, true),
                Domain::new(wide - (1 << 31) + 1, wide, 1, true),
            ]);
            // A 32-bit operand reads signed or unsigned: `mov eax, 0xffffffff` and `-1`.
            if has("MOV") { assert_eq!(domains("mov eax, $n", Immediate), [Domain::new(-(1 << 31), (1 << 32) - 1, 1, true)]); }
        }
        if has("RET") { eprintln!("ret $n: {:?}", domains("ret $n", Immediate)); }
        if has("MOV") { eprintln!("mov al, $n: {:?}", domains("mov al, $n", Immediate)); }
        if has("CALL") { eprintln!("call $t: {:?}", domains("call $t:relative", Relative)); }
        if has("LEA") { eprintln!("lea rdi, [rip + $d]: {:?}", domains("lea rdi, [rip + $d]", Displacement)); }
        if has("JZ") {
            // rel8 sits inside rel32; both count from the first byte (length included).
            assert_eq!(domains("jz $t", Relative), [Domain::new(-(1 << 31) + 6, (1 << 31) - 1 + 6, 1, true)]);
        }
    }

    #[test]
    fn errors_name_the_problem() {
        match assemble("xorr eax, eax") {
            Err(AssembleError::UnknownMnemonic { nearest, .. }) => if has("XOR") { assert!(nearest.contains(&"xor".to_string()), "{nearest:?}") },
            other => panic!("{other:?}"),
        }
        if has("XOR") {
            assert!(matches!(assemble("xor eax"), Err(AssembleError::OperandCount { found: 1, .. })), "{:?}", assemble("xor eax"));
            assert!(matches!(assemble("xor eax, xmm0"), Err(AssembleError::NoMatchingForm { operand: 1, .. })), "{:?}", assemble("xor eax, xmm0"));
        }
        if ENCODINGS.iter().any(|encoding| encoding.mnemonic == "ADD" && encoding.opcode == 0x80) {
            assert!(matches!(assemble("add al, 0x100"), Err(AssembleError::OperandOutOfRange { operand: 1, .. })), "{:?}", assemble("add al, 0x100"));
            assert!(matches!(assemble("add al, -0x81"), Err(AssembleError::OperandOutOfRange { operand: 1, .. })));
            assert!(assemble("add al, -0x80").is_ok());
        }
        assert!(matches!(parse64("lea rax, [rsp*2]"), Err(AssembleError::InvalidAddress { reason: "rsp cannot be an index register", .. })));
        assert!(matches!(parse64("lea rax, [rax*3]"), Err(AssembleError::InvalidAddress { .. })));
        assert!(matches!(parse64("lea rax, [ax]"), Err(AssembleError::InvalidAddress { .. })));
        assert!(matches!(parse64("mov eax, ["), Err(AssembleError::Syntax { offset: 10, .. })));
        assert!(matches!(parse64("mov $r:gpr65, eax"), Err(AssembleError::UnknownClass { .. })));
        if has("XOR") {
            let template = parse64("xor $a, $b").unwrap();
            assert!(matches!(template.encode(&[OperandValue::new(OperandClass::Gpr32, 0)]), Err(AssembleError::UnboundHole { .. })));
            assert!(matches!(template.encode(&[OperandValue::new(OperandClass::Gpr32, 0), OperandValue::new(OperandClass::Scale, 2)]), Err(AssembleError::HoleClassMismatch { .. })));
            if ENCODINGS.iter().any(|encoding| encoding.mnemonic == "INC") {
                assert!(matches!(assemble("inc [rax]"), Err(AssembleError::AmbiguousSize { .. })));
            }
        }
        if ENCODINGS.iter().any(|encoding| encoding.mnemonic == "MOV" && encoding.opcode == 0x88) {
            assert!(matches!(assemble("mov ah, r8b"), Err(AssembleError::NoMatchingForm { .. })), "{:?}", assemble("mov ah, r8b"));
        }
    }

    #[test]
    fn operand_classes_round_trip_their_values() {
        for class in OperandClass::ALL {
            assert_eq!(OperandClass::from_name(class.name()), Some(class));
            assert!(!class.summary().is_empty() && !class.summary().contains('\n'), "{class} summary");
            assert!(!(class.is_integer() && class.is_register()), "{class}");
            let integer = matches!(class, OperandClass::Immediate | OperandClass::Relative | OperandClass::Displacement | OperandClass::Scale);
            assert_eq!(class.is_integer(), integer, "{class}");
            for value in [0i128, 1, 3, 4, 8, 15, 31, -4, 0x40] {
                if let Some(text) = class.format_value(value) {
                    assert_eq!(class.parse_value(&text), Some(value), "{class} {value} {text}");
                }
            }
        }
        assert_eq!(OperandClass::Gpr8High.format_value(0).as_deref(), Some("ah"));
        assert_eq!(OperandClass::Gpr8.format_value(4).as_deref(), Some("spl"));
        assert_eq!(OperandClass::Gpr8.parse_value("ah"), None);
        assert_eq!(OperandClass::Condition.parse_value("e"), Some(4));
    }

    #[test]
    fn form_instructions_edit_memory_and_registers() {
        if !(ENCODINGS.iter().any(|encoding| encoding.mnemonic == "MOV" && encoding.opcode == 0x8b)) { return; }
        let mut instruction = FormInstruction::decode(&[0x8b, 0x45, 0xfc], Mode::Mode64).unwrap();
        let FormOperand::Memory(mut memory) = instruction.operand(1).unwrap() else { panic!() };
        memory.base = Some(gpr(4, 64, false));
        memory.index = Some(gpr(13, 64, false));
        memory.scale = 8;
        memory.displacement = 0x1234;
        instruction.set_memory(1, memory).unwrap();
        let mut out = [0u8; 15];
        let length = instruction.encode(&mut out).unwrap();
        assert_eq!(&out[..length], &[0x42, 0x8b, 0x84, 0xec, 0x34, 0x12, 0, 0]);
        instruction.set_register(0, gpr(10, 32, false)).unwrap();
        let length = instruction.encode(&mut out).unwrap();
        assert_eq!(decode(&out[..length], Mode::Mode64).unwrap().format_intel(0), "mov r10d, dword ptr [rsp+r13*8+0x1234]");
        memory.rip_relative = true;
        memory.index = None;
        assert!(instruction.set_memory(1, memory).is_ok());
        let mut wide = FormInstruction::decode(&[0x48, 0x8b, 0x00], Mode::Mode64).unwrap();
        let length = wide.encode(&mut out).unwrap();
        assert_eq!(&out[..length], &[0x48, 0x8b, 0x00], "REX.W survives a re-encode");
        wide.set_register(0, gpr(1, 64, false)).unwrap();
        let length = wide.encode(&mut out).unwrap();
        assert_eq!(&out[..length], &[0x48, 0x8b, 0x08]);
    }

    // ---- exhaustive form round trip ----

    fn register_pool(kind: ShapeKind, field: Field, evex: bool) -> &'static [u8] {
        let class = match kind { ShapeKind::Register { register, .. } => register.class, _ => RegisterClass::Gpr };
        let evex = evex && class == RegisterClass::Vector;
        match class {
            RegisterClass::Segment => &[1, 4, 5],
            RegisterClass::Mask => &[1, 2, 7],
            RegisterClass::Mmx | RegisterClass::X87 => &[1, 6, 7],
            RegisterClass::Bound => &[1, 2, 3],
            RegisterClass::Control => &[0, 2, 3, 4, 8],
            RegisterClass::Debug => &[0, 1, 7],
            _ => match (field, evex) {
                (Field::Reg, true) => &[1, 10, 17, 30],
                (Field::Reg, false) => &[1, 10, 5, 14],
                (Field::Rm, true) => &[3, 12, 19, 26],
                (Field::Rm, false) => &[3, 12, 7, 9],
                (Field::Vvvv, true) => &[2, 11, 20, 29],
                (Field::Vvvv, false) => &[2, 11, 6, 15],
                (Field::Mask, _) => &[1, 2, 7],
                (Field::Is4(_), _) => &[4, 13, 7],
                _ => &[1, 9, 6, 15],
            },
        }
    }

    /// Memory layouts: (mod, rm, use_sib, base, index, scale, displacement, address_override, segment).
    const MEMORY_MODES: &[(u8, u8, bool, u8, u8, u8, i64, bool, u8)] = &[
        (0, 0, false, 0, 4, 0, 0, false, 0),            // [rax]
        (1, 1, false, 0, 4, 0, 0x12, false, 0),         // [rcx+0x12]
        (2, 2, false, 0, 4, 0, -0x1234, false, 0),      // [rdx-0x1234]
        (0, 4, true, 3, 6, 2, 0, false, 0),             // [rbx+rsi*4]
        (0, 5, false, 0, 4, 0, 0x100, false, 0),        // [rip+0x100]
        (0, 4, true, 5, 4, 0, 0x1234, false, 0),        // [0x1234]
        (1, 4, true, 4, 4, 0, 8, false, 0),             // [rsp+0x8]
        (0, 4, true, 12, 4, 0, 0, false, 0),            // [r12]
        (1, 5, false, 0, 4, 0, 0, false, 0),            // [rbp]
        (1, 13, false, 0, 4, 0, -0x10, false, 0),       // [r13-0x10]
        (2, 4, true, 8, 9, 3, 0x7fff_ffff, false, 0),   // [r8+r9*8+0x7fffffff]
        (0, 4, true, 0, 1, 1, 0, true, 0),              // [eax+ecx*2]
        (0, 0, false, 0, 4, 0, 0, false, 0x64),         // fs:[rax]
        (1, 4, true, 5, 12, 0, 0x40, false, 0),         // [rbp+r12+0x40]
    ];
    const VSIB_MODES: &[(u8, u8, bool, u8, u8, u8, i64, bool, u8)] = &[
        (1, 4, true, 0, 1, 2, 0x20, false, 0),
        (0, 4, true, 9, 18, 3, 0, false, 0),
        (0, 4, true, 5, 5, 0, 0x100, false, 0),
        (2, 4, true, 4, 2, 1, 0x1000, false, 0),
    ];

    fn samples(variant: &Variant) -> Vec<Vec<u8>> {
        let e = variant.encoding();
        let evex = e.kind == 2;
        let operands: Vec<ShapeOperand> = (0..variant.count as usize).map(|index| variant.operand(index)).collect();
        let memory = operands.iter().find_map(|operand| match (operand.field, operand.kind) {
            (Field::Memory, ShapeKind::Memory { vsib, .. }) => Some(vsib),
            _ => None,
        });
        let modes = match memory { Some(0) => MEMORY_MODES, Some(_) => VSIB_MODES, None => &[] as &[_] };
        let count = modes.len().max(4);
        let mut out = Vec::new();
        for sample in 0..count {
            let mut fields = variant.fields;
            for operand in &operands {
                let pool = register_pool(operand.kind, operand.field, evex);
                let register = pool[sample % pool.len()];
                let register=if fields.mode!=Mode::Mode64 {register&7}else{register};
                match operand.field {
                    Field::Reg => fields.reg = (register & !e.reg_mask) | e.reg_value,
                    Field::Rm => fields.rm = (register & !e.rm_mask) | e.rm_value,
                    Field::Vvvv => fields.vvvv = register,
                    Field::OpcodeReg => { fields.opcode_reg = register; if !e.has_modrm { fields.rm = register; } }
                    Field::Mask => fields.mask = register,
                    Field::Is4(slot) => fields.immediate[slot as usize & 3] |= u64::from(register) << 4,
                    Field::Immediate(slot) => {
                        const VALUES: [u64; 6] = [0x12, 0x5a, 0xff, 0x1234, 0x1234_5678, 0xffff_ffff_ffff_fff0];
                        let shared=operands.iter().any(|operand|operand.field==Field::Is4(slot));
                        fields.immediate[slot as usize & 3] |= if shared { VALUES[sample % VALUES.len()]&15 }else{VALUES[sample % VALUES.len()]};
                    }
                    Field::Relative(slot) => {
                        const VALUES: [u64; 3] = [0x10, 0xffff_ffff_ffff_ffe0, 0x1000];
                        fields.immediate[slot as usize & 3] = VALUES[sample % VALUES.len()];
                    }
                    Field::Moffs(slot) => {
                        const VALUES: [u64; 2] = [0x1234, 0x7fff_0000_1000];
                        fields.immediate[slot as usize & 3] = VALUES[sample % VALUES.len()];
                    }
                    _ => {}
                }
            }
            if !modes.is_empty() {
                let (mod_bits, rm, use_sib, base, index, scale, displacement, address_override, segment) = modes[sample % modes.len()];
                fields.mod_bits = mod_bits;
                if e.rm_mask == 0 { fields.rm = rm; }
                fields.use_sib = use_sib;
                fields.base = base;
                fields.index = index;
                fields.scale = scale;
                fields.displacement = displacement;
                fields.address_override = address_override;
                fields.segment_override = segment;
                if index >= 16 { fields.vvvv |= 0x10; }
            }
            if variant.decoration.is_some() {
                fields.mask = [0u8, 1, 3][sample % 3];
                fields.zeroing = sample % 2 == 1 && fields.mask != 0;
            }
            let mut bytes = [0u8; 15];
            let Ok(length) = encode(variant.form as usize, fields, &mut bytes) else { continue };
            out.push(bytes[..length].to_vec());
        }
        out
    }

    fn hole_cases(view: &View) -> Vec<(usize, Component, OperandValue)> {
        let mut cases = Vec::new();
        for (index, operand) in view.operands().iter().enumerate() {
            match *operand {
                ViewOperand::Register(register) => if let Some(value) = OperandValue::from_register(register) { cases.push((index, Component::Whole, value)); },
                ViewOperand::Immediate { value, .. } => cases.push((index, Component::Whole, OperandValue::new(OperandClass::Immediate, i128::from(value)))),
                ViewOperand::Relative{displacement,..} => cases.push((index, Component::Whole, OperandValue::new(OperandClass::Relative, i128::from(displacement)))),
                ViewOperand::Memory(memory) => {
                    if let Some(value) = memory.base.and_then(OperandValue::from_register) { cases.push((index, Component::Base, value)); }
                    if let Some(index_register) = memory.index {
                        if let Some(value) = OperandValue::from_register(index_register) { cases.push((index, Component::Index, value)); }
                        cases.push((index, Component::Scale, OperandValue::new(OperandClass::Scale, i128::from(memory.scale))));
                    }
                    cases.push((index, Component::Displacement, if memory.rip {
                        // A RIP-relative hole counts from the instruction's first byte.
                        OperandValue::new(OperandClass::Displacement, i128::from(memory.displacement) + i128::from(view.length))
                            .with_position(Position::InstructionRelative)
                    } else {
                        OperandValue::new(OperandClass::Displacement, i128::from(memory.displacement))
                    }));
                }
                _ => {}
            }
        }
        cases
    }

    fn allows(template: &Template, byte: u8) -> bool {
        template.first_bytes()[byte as usize / 64] >> (byte % 64) & 1 == 1
    }

    /// Bytes tried ahead of an instruction: legacy prefixes, REX, and the VEX,
    /// EVEX and XOP escapes.
    const LEADERS: [u8; 18] = [
        0x66, 0x67, 0x26, 0x2e, 0x36, 0x3e, 0x64, 0x65, 0xf0, 0xf2, 0xf3,
        0x40, 0x41, 0x48, 0x4f, 0xc4, 0xc5, 0x62,
    ];

    /// The prefilter contract for one template: every match starts with an
    /// allowed byte. With `deep`, also behind one or two leading prefixes.
    fn check_first_bytes(template: &Template, bytes: &[u8], deep: bool) -> Result<(), String> {
        let mut values = Vec::new();
        if template.matches(bytes, &mut values).is_none() { return Ok(()); }
        if !template.could_match(bytes) { return Err(format!("`{}`: could_match rejects {bytes:02x?}", template.text())); }
        if !allows(template, bytes[0]) {
            return Err(format!("`{}`: first_bytes reject {:02x}", template.text(), bytes[0]));
        }
        if !deep { return Ok(()); }
        let mut probe = Vec::with_capacity(bytes.len() + 2);
        for first in LEADERS {
            probe.clear();
            probe.push(first);
            probe.extend_from_slice(bytes);
            if template.matches(&probe, &mut values).is_some() && (!allows(template, first) || !template.could_match(&probe)) {
                return Err(format!("`{}`: filters reject {first:02x} before {bytes:02x?}", template.text()));
            }
        }
        for first in [0x66, 0xf0, 0xf3, 0x2e, 0x48] {
            for second in [0x66, 0xf3, 0x40] {
                probe.clear();
                probe.extend_from_slice(&[first, second]);
                probe.extend_from_slice(bytes);
                if template.matches(&probe, &mut values).is_some() && (!allows(template, first) || !template.could_match(&probe)) {
                    return Err(format!("`{}`: filters reject {first:02x} {second:02x} before {bytes:02x?}", template.text()));
                }
            }
        }
        Ok(())
    }

    #[derive(Default)]
    struct DomainTally {
        holes: usize,
        checks: usize,
        by_count: std::collections::BTreeMap<usize, usize>,
        multi: std::collections::BTreeMap<&'static str, usize>,
        exact: std::collections::BTreeMap<&'static str, (usize, usize)>,
        seen: std::collections::BTreeSet<String>,
    }

    /// The domain gate for one hole bound to `expected`: the matched value is in
    /// one of the hole's domains of its class; the ends and next value of every
    /// exact domain encode and match back; values just outside, or off the step,
    /// are refused unless another domain of the class holds them.
    fn check_domains(hole: &Template, hole_text: &str, expected: OperandValue, tally: &mut DomainTally) -> Result<(), String> {
        tally.holes += 1;
        let domains = hole.hole_domains(0);
        let of_class: Vec<&ClassDomain> = domains.iter().filter(|entry| entry.class == expected.class).collect();
        if of_class.is_empty() { return Err(format!("`{hole_text}`: no domain for {}", expected.class)); }
        if !of_class.iter().any(|entry| entry.domain.contains(expected.value)) {
            return Err(format!("`{hole_text}`: {expected:?} outside {of_class:?}"));
        }
        if !tally.seen.insert(format!("{hole_text}|{}", expected.class)) { return Ok(()); }
        *tally.by_count.entry(of_class.len()).or_default() += 1;
        if of_class.len() > 1 { *tally.multi.entry(expected.class.name()).or_default() += 1; }
        let entry = tally.exact.entry(expected.class.name()).or_default();
        if of_class.iter().all(|entry| entry.domain.exact) { entry.0 += 1; } else { entry.1 += 1; }
        for entry in domains.iter().filter(|entry| entry.domain.exact) {
            let (class, d) = (entry.class, entry.domain);
            let held = |v: i128| domains.iter().any(|other| other.class == class && other.domain.contains(v));
            let mut present = vec![d.min, d.max];
            if d.min != d.max { present.push(d.min + d.step); }
            for v in present {
                tally.checks += 1;
                let Ok(encoded) = hole.encode(&[OperandValue::new(class, v)]) else {
                    return Err(format!("`{hole_text}`: {class} {v} inside {d:?} was refused"));
                };
                // A negative reading of an unsigned pattern, and a word that reads as another class, are aliases.
                let same = |e: &Encoded| {
                    let mut back = Vec::new();
                    hole.matches(e.bytes(), &mut back).is_some() && (back[0].class != class || back[0].value == v
                        || hole.encode(&[OperandValue::new(class, back[0].value)]).is_ok_and(|again| again.iter().any(|a| a.bytes() == e.bytes())))
                };
                if !encoded.iter().any(same) {
                    return Err(format!("`{hole_text}`: {class} {v} encodes but does not match back"));
                }
            }
            let mut absent = vec![d.min - d.step, d.max + d.step];
            if d.step > 1 { absent.push(d.min + 1); }
            for v in absent {
                if held(v) { continue; }
                tally.checks += 1;
                if let Ok(encoded) = hole.encode(&[OperandValue::new(class, v)]) {
                    return Err(format!("`{hole_text}`: {class} {v} outside {d:?} encoded as {:02x?}", encoded.first().map(Encoded::bytes)));
                }
            }
        }
        Ok(())
    }

    #[derive(Default)]
    struct PositionTally { fixed: usize, relative: usize, rip: usize, moved: usize, refused: usize, undetermined: usize }

    /// The position model for one hole bound to one position-dependent value:
    /// `target` agrees with the formatter (branches) or with the displacement
    /// field plus the instruction length (RIP-relative; nothing prints it
    /// resolved) at two addresses, `value_for_target` inverts it, and moving
    /// the instruction by 0x40 or 5 bytes keeps the target or is refused.
    fn check_position(hole: &Template, bytes: &[u8], bound: OperandValue, ip: u64, tally: &mut PositionTally) -> Result<(), String> {
        let length = bytes.len();
        let position = bound.position;
        let decoded = decode(bytes, hole.mode) .map_err(|error| format!("decode {error:?}"))?;
        // Position's generic arithmetic is u64. For legacy relative branches,
        // exercise it at addresses inside the effective instruction-pointer
        // domain; separate boundary cases verify the architecture's wrapping.
        let address_mask=if bound.class==OperandClass::Relative {ip_mask(relative_address_bits(&decoded.physical,decoded.encoding().mnemonic))}else{u64::MAX};
        for address in [ip&address_mask, 0x7fff_0000_2000u64&address_mask] {
            let goal = target(position, address, bound.value).ok_or_else(|| format!("{bytes:02x?}: no target at 0x{address:x}"))?;
            match bound.class {
                OperandClass::Relative => {
                    let text = decoded.format_intel(address);
                    if !text.contains(&format!("0x{goal:x}")) { return Err(format!("{bytes:02x?}: target 0x{goal:x} at 0x{address:x} but the formatter prints `{text}`")); }
                }
                _ => {
                    let field = i64::try_from(bound.value - length as i128).map_err(|_| "displacement overflow".to_string())?;
                    if address.wrapping_add(length as u64).wrapping_add_signed(field) != goal {
                        return Err(format!("{bytes:02x?}: target 0x{goal:x} is not next-instruction + field at 0x{address:x}"));
                    }
                }
            }
            if value_for_target(position, address, goal) != Some(bound.value) { return Err(format!("{bytes:02x?}: value_for_target does not invert target")); }
            for delta in [0x40u64, 5] {
                let there = address + delta;
                let Some(value) = value_for_target(position, there, goal) else { continue };
                match hole.encode(&[OperandValue { value, ..bound }]) {
                    Ok(encoded) => {
                        tally.moved += 1;
                        for encoding in &encoded {
                            let mut back = Vec::new();
                            if hole.matches(encoding.bytes(), &mut back).is_none() || target(position, there, back[0].value) != Some(goal) {
                                return Err(format!("{bytes:02x?}: relocated {:02x?} reaches {:?}, not 0x{goal:x}", encoding.bytes(), back.first()));
                            }
                        }
                    }
                    Err(_) => tally.refused += 1,
                }
            }
            for far in [bound.value + (1i128 << 40), bound.value - (1i128 << 40)] {
                if let Ok(encoded) = hole.encode(&[OperandValue { value: far, ..bound }]) {
                    for encoding in &encoded {
                        let mut back = Vec::new();
                        if hole.matches(encoding.bytes(), &mut back).is_none() || back[0].value != far {
                            return Err(format!("{bytes:02x?}: {far} wrapped to {:?} in {:02x?}", back.first(), encoding.bytes()));
                        }
                    }
                }
            }
        }
        Ok(())
    }

    /// Check one decodable byte sequence; returns an error description.
    fn check_instruction(bytes: &[u8], ip: u64, mode:Mode, equivalent: &mut Vec<String>, tally: &mut PositionTally, domains: &mut DomainTally) -> Result<(), String> {
        let decoded = decode(bytes, mode).map_err(|error| format!("decode {error:?}"))?;
        let length = decoded.length as usize;
        let bytes = &bytes[..length];
        let text = decoded.format_intel(ip);
        let view = view(&decoded);
        let mut printed = String::new();
        write_view(&mut printed, &view, ip);
        if printed != text { return Err(format!("view prints `{printed}`, formatter `{text}`")); }
        let template = Template::parse_at_in_mode(&text, ip,mode).map_err(|error| format!("`{text}`: parse: {error}"))?;
        let encoded = template.encode(&[]).map_err(|error| format!("`{text}`: encode: {error}"))?;
        if !encoded.iter().any(|encoded| encoded.bytes() == bytes) {
            let same = encoded.iter().any(|encoded| decode(encoded.bytes(), mode).is_ok_and(|other| other.format_intel(ip) == text));
            if !same { return Err(format!("`{text}`: {bytes:02x?} not among {:02x?}", bytes_of(&encoded))); }
            equivalent.push(format!("{bytes:02x?} `{text}` assembles as {:02x?}", bytes_of(&encoded)));
        }
        let mut values = Vec::new();
        if template.matches(bytes, &mut values) != Some(length) {
            return Err(format!("`{text}`: template does not match {bytes:02x?}"));
        }
        check_first_bytes(&template, bytes, true)?;
        for (position, component, expected) in hole_cases(&view) {
            let name = match component {
                Component::Index => format!("$h:{}", expected.class),
                Component::Displacement => "$h:displacement".to_string(),
                _ => "$h".to_string(),
            };
            let mut hole_text = String::new();
            write_view_with(&mut hole_text, &view, ip, Some((position, component, &name)));
            let hole = Template::parse_at_in_mode(&hole_text, ip,mode).map_err(|error| format!("`{hole_text}`: parse: {error}"))?;
            if hole.matches(bytes, &mut values) != Some(length) {
                return Err(format!("`{hole_text}`: does not match {bytes:02x?}"));
            }
            check_first_bytes(&hole, bytes, false)?;
            let mut wild_text = String::new();
            write_view_with(&mut wild_text, &view, ip, Some((position, component, "_")));
            if let Ok(wild) = Template::parse_at_in_mode(&wild_text, ip,mode) { check_first_bytes(&wild, bytes, false)?; }
            if values != [expected] { return Err(format!("`{hole_text}`: bound {values:?}, expected {expected:?}")); }
            check_domains(&hole, &hole_text, expected, domains)?;
            match hole.hole_position(0) {
                Some(position) if position != expected.position => return Err(format!("`{hole_text}`: hole position {position:?}, value {:?}", expected.position)),
                None => tally.undetermined += 1,
                _ => {}
            }
            if expected.position.is_position_dependent() {
                if expected.class == OperandClass::Relative { tally.relative += 1; } else { tally.rip += 1; }
                check_position(&hole, bytes, expected, ip, tally)?;
            } else {
                tally.fixed += 1;
            }
            let encoded = hole.encode(&values).map_err(|error| format!("`{hole_text}` with {expected}: encode: {error}"))?;
            if !encoded.iter().any(|encoded| encoded.bytes() == bytes)
                && !encoded.iter().any(|encoded| decode(encoded.bytes(), mode).is_ok_and(|other| other.format_intel(ip) == text))
            {
                return Err(format!("`{hole_text}` with {expected}: {bytes:02x?} not among {:02x?}", bytes_of(&encoded)));
            }
        }
        Ok(())
    }

    #[derive(Default)]
    struct DescribeTally { instructions: usize, spans: usize, bare: usize }

    /// `describe` contract: the text matches; every span replaced by
    /// `$h:class` matches and binds the span's value; count spans where a bare
    /// `$h` also works.
    fn check_described(bytes: &[u8], mode:Mode,tally: &mut DescribeTally) -> Result<(), String> {
        let described = describe_in_mode(bytes,mode).ok_or_else(|| format!("describe {bytes:02x?} failed"))?;
        let mut values = Vec::new();
        let template = Template::parse_in_mode(&described.text,mode).map_err(|error| format!("describe `{}`: {error}", described.text))?;
        if template.matches(bytes, &mut values) != Some(described.len) {
            return Err(format!("describe `{}` does not match {bytes:02x?}", described.text));
        }
        tally.instructions += 1;
        for (index, span) in described.operands.iter().enumerate() {
            let expected = OperandValue::new(span.class, span.value).with_position(span.position);
            let classed = described.with_hole(index, &format!("$h:{}", span.class)).unwrap();
            let hole = Template::parse_in_mode(&classed,mode).map_err(|error| format!("describe hole `{classed}`: {error}"))?;
            if hole.matches(bytes, &mut values) != Some(described.len) || values != [expected] {
                return Err(format!("describe hole `{classed}` on {bytes:02x?}: bound {values:?}, expected {expected:?}"));
            }
            tally.spans += 1;
            let bare = described.with_hole(index, "$h").unwrap();
            if Template::parse_in_mode(&bare,mode).is_ok_and(|hole| hole.matches(bytes, &mut values) == Some(described.len) && values == [expected]) {
                tally.bare += 1;
            }
        }
        Ok(())
    }

    #[test]
    fn describe_spans_cover_operands() {
        if !has("MOV") || !has("JZ") { return; }
        let described = describe(&[0x48, 0x8b, 0x44, 0x24, 0x08]).unwrap();
        assert_eq!(described.text, "mov rax, qword ptr [rsp+0x8]");
        let described = describe(&[0x8b, 0x04, 0x8b]).unwrap();
        assert_eq!(described.text, "mov eax, dword ptr [rbx+rcx*4+0x0]");
        assert_eq!(described.operands.len(), 5);
        let jump = describe(&[0x74, 0x05]).unwrap();
        assert_eq!(jump.text, "jz .+0x7");
        assert_eq!(jump.operands[0], OperandSpan { start: 1, end: 2, class: OperandClass::Condition, value: 4, position: Position::Fixed });
        assert!(jump.operands[1].position_dependent());
        let rip = describe(&[0x48, 0x8d, 0x3d, 0x10, 0, 0, 0]).unwrap();
        assert_eq!(rip.text, "lea rdi, [rip+0x10]");
        assert!(rip.operands.last().unwrap().position_dependent());
        assert_eq!(rip.operands.last().unwrap().value, 0x10 + 7, "a hole counts from the first byte");
    }

    #[test]
    fn every_form_round_trips_through_text_and_templates() { check_every_form(Mode::Mode64) }

    #[test]
    fn explicit_execution_modes_registers_addresses_and_rex_bytes() {
        if !has("MOV") || !has("INC") || !has("JMP") {return}
        let cases:&[(Mode,&str,&[u8])]=&[
            (Mode::Mode32,"mov eax, dword ptr [ebx+ecx*4+0x10]", &[0x8b,0x44,0x8b,0x10]),
            (Mode::Mode32,"mov ax, word ptr [eax]", &[0x66,0x8b,0x00]),
            (Mode::Mode32,"mov eax, dword ptr [bx+si]", &[0x67,0x8b,0x00]),
            (Mode::Mode32,"mov eax, dword ptr [bp]", &[0x67,0x8b,0x46,0]),
            (Mode::Mode16,"mov ax, word ptr [bx+si]", &[0x8b,0x00]),
            (Mode::Mode16,"mov eax, dword ptr [ebx]", &[0x67,0x66,0x8b,0x03]),
            (Mode::Mode32,"inc eax", &[0x40]),
            (Mode::Mode32,"dec eax", &[0x48]),
        ];
        for &(mode,text,bytes) in cases {
            let encoded=assemble_in_mode(text,mode).unwrap_or_else(|error|panic!("{mode:?} {text}: {error}"));
            assert!(encoded.iter().any(|e|e.bytes()==bytes),"{mode:?} {text}: {:?}",bytes_of(&encoded));
            let template=Template::parse_in_mode(text,mode).unwrap();assert_eq!(template.mode(),mode);
            assert!(template.could_match(bytes));assert_eq!(template.matches(bytes,&mut Vec::new()),Some(bytes.len()));
            let described=describe_in_mode(bytes,mode).unwrap();assert!(Template::parse_in_mode(&described.text,mode).unwrap().matches(bytes,&mut Vec::new()).is_some());
        }
        for text in ["mov rax, rbx","mov r8d, eax","mov spl, al","mov eax, [rax]","mov eax, [rip+4]"] {
            assert!(assemble_in_mode(text,Mode::Mode32).is_err(),"accepted {text} in32 mode");
        }
        let jump=assemble_at_in_mode("jmp 0x1010",0x1000,Mode::Mode32).unwrap();
        assert!(jump.iter().any(|e|e.bytes()==[0xeb,0x0e]));
        let pattern=Template::parse_in_mode("mov $dst:gpr32, dword ptr [$base:gpr32+$index:gpr32*4+$disp:displacement]",Mode::Mode32).unwrap();
        let mut values=Vec::new();assert_eq!(pattern.matches(&[0x8b,0x44,0x8b,0x10],&mut values),Some(4));
        assert!(pattern.encode(&values).unwrap().iter().any(|e|e.bytes()==[0x8b,0x44,0x8b,0x10]));
        assert!(!Template::parse_in_mode("inc eax",Mode::Mode32).unwrap().could_match(&[0x48]));
        assert!(assemble("mov rax, rbx").is_ok());
    }

    #[test]
    fn every_32bit_form_round_trips_through_text_and_templates() {check_every_form(Mode::Mode32)}

    #[test]
    fn every_16bit_form_round_trips_through_text_and_templates() {check_every_form(Mode::Mode16)}

    fn check_every_form(mode:Mode) {
        let catalog = catalog_in_mode(mode);
        let ip = 0x40_1000u64;
        let mut covered = 0usize;
        let mut failed: Vec<(u32, String)> = Vec::new();
        let mut no_samples: Vec<u32> = Vec::new();
        let mut checked = 0usize;
        let mut equivalent = Vec::new();
        let mut described = DescribeTally::default();
        let mut positions = PositionTally::default();
        let mut domains = DomainTally::default();
        for form in 0..ENCODINGS.len() as u32 {
            let variants = catalog.variants_of(form);
            if variants.is_empty() { continue; }
            let mut passed = 0usize;
            let mut failure = None;
            for variant in variants {
                for sample in samples(variant) {
                    let Ok(decoded) = decode(&sample, mode) else { continue };
                    if decoded.length as usize != sample.len() { continue; }
                    checked += 1;
                    match check_instruction(&sample, ip,mode, &mut equivalent, &mut positions, &mut domains).and_then(|()| check_described(&sample, mode,&mut described)) {
                        Ok(()) => passed += 1,
                        Err(error) => { failure.get_or_insert(error); }
                    }
                }
            }
            match failure {
                Some(error) => failed.push((form, error)),
                None if passed > 0 => covered += 1,
                None => no_samples.push(form),
            }
        }
        let total = ENCODINGS.len();
        let mut report = format!(
            "forms: {total}; covered {covered}; failed {}; skipped {} (no selected-mode variant) + {} (no decodable sample); instances {checked}; equivalent-only {}\n",
            failed.len(), catalog.skipped.len(), no_samples.len(), equivalent.len(),
        );
        let _ = writeln!(report, "positions: {} fixed holes, {} branch displacements, {} rip-relative displacements; {} relocations encoded, {} refused; {} holes with undetermined position",
            positions.fixed, positions.relative, positions.rip, positions.moved, positions.refused, positions.undetermined);
        let _ = writeln!(report, "domains: {} holes, {} distinct, {} encode checks; domains per (hole, class) {:?}; classes with several {:?}",
            domains.holes, domains.seen.len(), domains.checks, domains.by_count, domains.multi);
        for (class, (exact, inexact)) in &domains.exact { let _ = writeln!(report, "  domains {class}: {exact} exact, {inexact} inexact"); }
        let _ = writeln!(report, "describe: {} instructions, {} spans (each matched and bound as $h:class), {} also work as a bare $h",
            described.instructions, described.spans, described.bare);
        for line in &equivalent { let _ = writeln!(report, "  equivalent: {line}"); }
        let mut reasons: std::collections::BTreeMap<&str, usize> = std::collections::BTreeMap::new();
        for (_, reason) in &catalog.skipped { *reasons.entry(reason).or_default() += 1; }
        for (reason, count) in &reasons { let _ = writeln!(report, "  skipped {count}: {reason}"); }
        for (form, reason) in &catalog.skipped {
            if !reason.starts_with("MVEX") && !reason.starts_with("not available") {
                let _ = writeln!(report, "  skipped {}: {reason}", ENCODINGS[*form as usize].form_id);
            }
        }
        for form in &no_samples { let _ = writeln!(report, "  no sample: {}", ENCODINGS[*form as usize].form_id); }
        for (form, error) in &failed { let _ = writeln!(report, "  FAIL {}: {error}", ENCODINGS[*form as usize].form_id); }
        if std::env::var_os("MKASM_X86_ASSEMBLER_REPORT").is_some() { println!("{report}"); }
        assert!(failed.is_empty(), "{report}");
    }
