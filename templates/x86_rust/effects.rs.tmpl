fn register_effect(r:Register,read:bool,write:bool,conditional:bool,implicit:bool,address:bool,d:&Decoded)->RegisterEffect {
    let bank=match r.class {RegisterClass::Gpr=>"gpr",RegisterClass::Vector=>"vector",RegisterClass::Mask=>"mask",RegisterClass::Mmx=>"mmx",RegisterClass::Bound=>"bound",RegisterClass::Control=>"control",RegisterClass::Debug=>"debug",RegisterClass::Segment=>"segment",RegisterClass::X87=>"x87",RegisterClass::Other=>"other"};
    let native=if d.physical.mode==Mode::Mode64{64}else{32};
    let behavior=if r.width==0 {WriteBehavior::Unknown} else if !write {WriteBehavior::Unknown} else if r.class==RegisterClass::Gpr {
        if r.width==32&&native==64{WriteBehavior::ZeroUpper}else if r.width==native&&!r.high8{WriteBehavior::Replace}else{WriteBehavior::PreserveUpper}
    }else if r.class==RegisterClass::Vector&&d.encoding().kind!=0&&r.width>=128 {WriteBehavior::ZeroUpper}
    else if r.class==RegisterClass::Vector&&r.width>=128 {WriteBehavior::PreserveUpper}
    else {WriteBehavior::Unknown};
    RegisterEffect{register:RegisterSlice{bank,number:Some((if r.high8{r.number&3}else{r.number}) as u16),name:"",offset:if r.high8{8}else{0},width:(r.width!=0).then_some(r.width)},read,write,conditional,implicit,address,write_behavior:behavior}
}

