fn thumb_immediate(imm: u32) -> Option<(Expr, Expr)> {
    if imm >> 10 == 0 {
        let byte = imm & 255;
        let v = match (imm >> 8) & 3 {
            0 => byte,
            1 => byte | (byte << 16),
            2 => (byte << 8) | (byte << 24),
            _ => byte * 0x01010101,
        };
        if imm & 0x300 != 0 && byte == 0 {
            return None;
        }
        Some((c(32, v as u64), flag(2)))
    } else {
        let v = (0x80 | (imm & 127)).rotate_right((imm >> 7) & 31);
        Some((c(32, v as u64), c(1, (v >> 31) as u64)))
    }
}
