fn neon_lane(values: &[Expr], index: u8, width: u8) -> Expr {
    let bit = u16::from(index) * u16::from(width);
    Expr::extract(
        values[usize::from(bit / 64)].clone(),
        (bit % 64) as u8,
        width,
    )
}
fn neon_pack(result: Expr, value: Expr, offset: u8) -> Expr {
    bin(
        B::Or,
        result,
        bin(
            B::Shl,
            Expr::cast(value, 64, false),
            c(64, u64::from(offset)),
        ),
    )
}
fn neon_outputs(r: &mut Recipe, first: u32, values: Vec<Expr>) {
    let values = values.into_iter().map(|v| r.bind(v)).collect::<Vec<_>>();
    for (i, value) in values.into_iter().enumerate() {
        r.write(
            vector_slice(first + i as u32, 64),
            WritePolicy::Preserve,
            value,
        );
    }
}
