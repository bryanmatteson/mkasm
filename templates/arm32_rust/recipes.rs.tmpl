    if word & 0x0f200e00 == 0x0d000a00 || word & 0x0f200f00 == 0x0d000900 {
        let rn = (word >> 16) & 15;
        let load = word & (1 << 20) != 0;
        if rn == 15 && !load && (thumb || !half) {
            return false;
        }
        let addr = bin(
            if word & (1 << 23) != 0 {
                B::Add
            } else {
                B::Sub
            },
            if rn == 15 {
                c(32, pc & !3)
            } else {
                reg(rn, pc)
            },
            c(32, ((word & 255) * if half { 2 } else { 4 }) as u64),
        );
        let m = Memory {kind: Default::default(), privilege: Default::default(),
            address: Box::new(addr),
            width,
            endian,
        };
        if half {
            vfp_half_context(r, word, thumb);
