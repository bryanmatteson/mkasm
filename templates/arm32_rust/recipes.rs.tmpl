fn reverse(value: Expr, half: bool) -> Expr {
    let mut result = c(32, 0);
    for i in 0..4 {
        let dst = if half { i ^ 1 } else { 3 - i };
        result = bin(
            B::Or,
            result,
            bin(
                B::Shl,
                Expr::cast(Expr::extract(value.clone(), i * 8, 8), 32, false),
                c(32, (dst * 8) as u64),
            ),
        );
    }
    result
}
