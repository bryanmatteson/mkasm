            _ => return unsupported(next),
        };
        if rd == 15 && !matches!(code, 8..=11) {
            return unsupported(next);
        }
        if rn == 15 && !matches!(op, 2 | 3) {
            return unsupported(next);
        }
        // ORN is OR with complemented operand; MVN is its Rn==PC alias.
        if op == 3 && rn != 15 {
            let value = r.bind(bin(B::Or, reg(rn, pc), inv(operand)));
            write(&mut r, rd, value.clone());
            if s {
                nz(&mut r, &value, &c(1, 1));
                setflag(&mut r, 2, carry, &c(1, 1))
            }
        } else {
            alu(
                &mut r,
                code,
                rd,
                reg(rn, pc),
                operand,
                carry,
                c(1, s as u64),
                true,
            )
        }
        return r;
    }
    // ADDW/SUBW, MOVW/MOVT and scalar bitfields.
    if word & 0xfa008000 == 0xf2000000 {
        let op = (word >> 20) & 31;
        let imm = (((word >> 26) & 1) << 11) | (((word >> 12) & 7) << 8) | (word & 255);
        if rd == 15 {
            return unsupported(next);
        }
        match op {
            0 | 10 => {
                let base = if rn == 15 {
                    c(32, pc & !3)
                } else {
                    reg(rn, pc)
                };
                write(
                    &mut r,
                    rd,
                    bin(
                        if op == 0 { B::Add } else { B::Sub },
                        base,
                        c(32, imm as u64),
                    ),
                )
            }
            4 | 12 => {
                let imm = (rn << 12) | imm;
                let v = if op == 4 {
                    c(32, imm as u64)
                } else {
                    bin(
                        B::Or,
                        bin(B::And, reg(rd, pc), c(32, 0xffff)),
                        c(32, (imm << 16) as u64),
                    )
                };
                write(&mut r, rd, v)
            }
            20 | 22 | 28 => {
                let lsb = (((word >> 12) & 7) << 2) | ((word >> 6) & 3);
                let size = word & 31;
                let insert = op == 22;
                if !bitfield(
                    &mut r,
                    rd,
                    rn,
                    lsb,
                    if insert {
                        size.wrapping_sub(lsb).wrapping_add(1)
                    } else {
                        size + 1
                    },
                    op == 20,
                    insert,
                    pc,
                ) {
                    return unsupported(next);
                }
            }
            _ => return unsupported(next),
        }
        return r;
    }
    // Scalar transfers, both positive imm12 and register/imm8 indexed forms.
    if word & 0xfe000000 == 0xf8000000 {
        let op = (word >> 20) & 31;
        let rt = (word >> 12) & 15;
        let load = op & 1 != 0;
        let signed = op & 16 != 0;
        let size = (op >> 1) & 3;
        if size == 3 || (!load && signed) {
            return unsupported(next);
        }
        let width = 8u8 << size;
        if rt == 15 && (width != 32 || !load) {
            return unsupported(next);
        }
        let positive = op & 8 != 0;
        let mut wb = false;
        let base = if rn == 15 {
            c(32, pc & !3)
        } else {
            reg(rn, pc)
        };
        let base = r.bind(base);
        let (addr, adjusted) = if rn == 15 {
            if !load {
                return unsupported(next);
            }
            let a = bin(
                if positive { B::Add } else { B::Sub },
                base,
                c(32, (word & 0xfff) as u64),
            );
            (a.clone(), a)
        } else if positive {
            let a = bin(B::Add, base, c(32, (word & 0xfff) as u64));
            (a.clone(), a)
        } else if word & 0x800 != 0 {
            let pre = word & 0x400 != 0;
            let up = word & 0x200 != 0;
            wb = word & 0x100 != 0;
            if !pre && !wb {
                return unsupported(next);
            }
            let a = r.bind(bin(
                if up { B::Add } else { B::Sub },
                base.clone(),
                c(32, (word & 255) as u64),
            ));
            (if pre { a.clone() } else { base }, a)
        } else {
            if word & 0xfc0 != 0 || rm == 15 {
                return unsupported(next);
            }
            let a = bin(
                B::Add,
                base,
                bin(B::Shl, reg(rm, pc), c(32, ((word >> 4) & 3) as u64)),
            );
            (a.clone(), a)
        };
        if wb && rn == rt {
            return unsupported(next);
        }
        if rt == 15 {
            last_it(&mut r)
        }
        memory(&mut r, load, rt, addr, width, signed, endian, pc, true);
        if wb {
            write(&mut r, rn, adjusted)
        }
        return r;
    }
    if word & 0xfe400000 == 0xe8400000 {
        let load = word & (1 << 20) != 0;
        let pre = word & (1 << 24) != 0;
        let wb = word & (1 << 21) != 0;
        let rt = (word >> 12) & 15;
        let rt2 = (word >> 8) & 15;
        if (!pre && !wb)
            || rt >= 13
            || rt2 >= 13
            || rt == rt2
            || (wb && (rn == 15 || rn == rt || rn == rt2))
            || (!load && rn == 15)
        {
            return unsupported(next);
        }
        let base = r.bind(if rn == 15 {
            c(32, pc & !3)
        } else {
            reg(rn, pc)
        });
        let adjusted = r.bind(bin(
            if word & (1 << 23) != 0 {
                B::Add
            } else {
                B::Sub
            },
            base.clone(),
            c(32, ((word & 255) * 4) as u64),
        ));
        let addr = if pre { adjusted.clone() } else { base };
        memory(&mut r, load, rt, addr.clone(), 32, false, endian, pc, true);
        memory(
            &mut r,
            load,
            rt2,
            bin(B::Add, addr, c(32, 4)),
            32,
            false,
            endian,
            pc,
            true,
        );
        if wb {
            write(&mut r, rn, adjusted)
        }
        return r;
    }
    // LDM/STM and PUSH/POP wide aliases (ordinary register lists only).
    if word & 0xfe400000 == 0xe8000000 && word & 0x00400000 == 0 {
        let load = word & (1 << 20) != 0;
        let wb = word & (1 << 21) != 0;
        let before = word & (1 << 24) != 0;
        let up = word & (1 << 23) != 0;
        let list = word & 0xffff;
        if list.count_ones() < 2
            || list & 0x2000 != 0
            || (!load && list & 0x8000 != 0)
            || (load && list & 0xc000 == 0xc000)
            || up == before
        {
            return unsupported(next);
        }
        if load && list & 0x8000 != 0 {
            last_it(&mut r)
        }
        if !multiple(&mut r, rn, list, load, wb, up, before, pc, endian, true) {
            return unsupported(next);
        }
        return r;
    }
    if word & 0xffd0f0f0 == 0xfb90f0f0 {
        if rd == 15 || rn == 15 || rm == 15 {
            return unsupported(next);
        }
        write(
            &mut r,
            rd,
            bin(
                if word & (1 << 21) != 0 {
                    B::Udiv
                } else {
                    B::Sdiv
                },
                reg(rn, pc),
                reg(rm, pc),
            ),
        );
        return r;
    }
    // MUL/MLA/MLS, and signed/unsigned long multiply and accumulate.
    if word & 0xfff000c0 == 0xfb000000 {
        let ra = (word >> 12) & 15;
        if rn == 15 || rm == 15 || rd == 15 {
            return unsupported(next);
        }
        if word & 0x30 == 0 {
            multiply(
                &mut r,
                rd,
                rn,
                rm,
                if ra == 15 { None } else { Some(ra) },
                c(1, 0),
                pc,
            )
        } else if word & 0x30 == 0x10 && ra != 15 {
            write(
                &mut r,
                rd,
                bin(B::Sub, reg(ra, pc), bin(B::Mul, reg(rn, pc), reg(rm, pc))),
            )
        } else {
            return unsupported(next);
        }
        return r;
    }
    if word & 0xff8000f0 == 0xfb800000 {
        let op = (word >> 20) & 7;
        let lo = (word >> 12) & 15;
        let hi = rd;
        if !matches!(op, 0 | 2 | 4 | 6) || rn == 15 || rm == 15 || lo == 15 || hi == 15 || lo == hi
        {
            return unsupported(next);
        }
        let p = bin(
            B::Mul,
            Expr::cast(reg(rn, pc), 64, op & 2 == 0),
            Expr::cast(reg(rm, pc), 64, op & 2 == 0),
        );
        let p = if op & 4 != 0 {
            bin(
                B::Add,
                p,
                bin(
                    B::Or,
                    Expr::cast(reg(lo, pc), 64, false),
                    bin(B::Shl, Expr::cast(reg(hi, pc), 64, false), c(64, 32)),
                ),
            )
        } else {
            p
        };
        let p = r.bind(p);
        write(&mut r, lo, Expr::extract(p.clone(), 0, 32));
        write(&mut r, hi, Expr::extract(p, 32, 32));
        return r;
    }
    if word & 0xfff0f0c0 == 0xfa90f080 || word & 0xfff0f0f0 == 0xfab0f080 {
        if rn != rm || rn == 15 || rd == 15 {
            return unsupported(next);
        }
        let v = if word & 0x00200000 != 0 {
            Expr::unary(U::CountLeadingZeros, reg(rm, pc))
        } else {
            match (word >> 4) & 3 {
                0 => Expr::unary(U::ReverseBytes, reg(rm, pc)),
                1 => reverse(reg(rm, pc), true),
                2 => Expr::unary(U::ReverseBits, reg(rm, pc)),
                _ => Expr::cast(Expr::extract(reverse(reg(rm, pc), true), 0, 16), 32, true),
            }
        };
        write(&mut r, rd, v);
        return r;
    }
    if word & 0xff80f0c0 == 0xfa00f080 {
        let op = (word >> 20) & 7;
        if !matches!(op, 0 | 1 | 4 | 5) || rm == 15 || rd == 15 {
            return unsupported(next);
        }
        let v = Expr::cast(
            Expr::extract(
                bin(B::Ror, reg(rm, pc), c(32, (((word >> 4) & 3) * 8) as u64)),
                0,
                if op & 4 == 0 { 16 } else { 8 },
            ),
            32,
            op & 1 == 0,
        );
        write(
            &mut r,
            rd,
            if rn == 15 {
                v
            } else {
                bin(B::Add, reg(rn, pc), v)
            },
        );
        return r;
    }
    // Register-controlled shifts (FA00..FA70), without the extend aliases.
    if word & 0xff80f0f0 == 0xfa00f000 {
        if rn == 15 || rm == 15 || rd == 15 {
            return unsupported(next);
        }
        let (v, carry) = shift(
            reg(rn, pc),
            (word >> 21) & 3,
            Expr::extract(reg(rm, pc), 0, 8),
            false,
        );
        alu(
            &mut r,
            13,
            rd,
            c(32, 0),
            v,
            carry,
            c(1, ((word >> 20) & 1) as u64),
            true,
        );
        return r;
    }
    unsupported(next)
}
pub fn for_thumb(word: u32, length: usize, address: u64, endian: Endian) -> Recipe {
    match length {
        2 => thumb16(word & 0xffff, address, endian),
        4 => thumb32(word, address, endian),
        _ => unsupported(address.wrapping_add(length as u64)),
    }
}
impl super::Decoded {
    /// Target-qualified pre-Armv8 VFP short-vector execution. The caller must
    /// select a target that implements Armv7 Appendix D11 and its exception
    /// protocol. None means an unaffected instruction; use the scalar recipe.
    pub fn legacy_vfp_recipe(&self, address: u64, context: LegacyVfpContext) -> Option<Recipe> {
        for_legacy_vfp(
            self.raw(),
            self.length as usize,
            address,
            self.mode == super::Mode::Thumb,
            context,
        )
    }
    /// Successful scalar execution with little-endian data memory by default.
    /// Thumb recipes read a32.itstate and explicitly update pipeline ITSTATE.
    pub fn semantic_recipe(&self, address: u64) -> Recipe {
        self.semantic_recipe_with_endian(address, Endian::Little)
    }
    /// Data endianness is independent of instruction-byte decoding endianness.
    pub fn semantic_recipe_with_endian(&self, address: u64, endian: Endian) -> Recipe {
        if self.mode == super::Mode::Arm {
            for_word_with_endian(self.raw(), address, endian)
        } else {
            for_thumb(self.raw(), self.length as usize, address, endian)
        }
    }
}
