            }
            8..=11 => {
                let v = u64::from(imm) << (((cmode >> 1) & 1) * 8);
                v | (v << 16) | (v << 32) | (v << 48)
            }
            12 => {
                let v = (u64::from(imm) << 8) | 0xff;
                v | (v << 32)
            }
            13 => {
                let v = (u64::from(imm) << 16) | 0xffff;
                v | (v << 32)
            }
            14 => {
                if op {
                    let mut v = 0;
                    for i in 0..8 {
                        if imm & (1 << i) != 0 {
                            v |= 0xffu64 << (i * 8)
                        }
                    }
                    v
                } else {
                    u64::from(imm) * 0x0101010101010101
                }
            }
            _ => {
                let b = (imm >> 6) & 1;
                let exp = ((b ^ 1) << 7) | (if b != 0 { 0x7c } else { 0 }) | ((imm >> 4) & 3);
                let v = u64::from(((imm >> 7) << 31) | (exp << 23) | ((imm & 15) << 19));
                v | (v << 32)
            }
        };
        let logic = cmode < 12 && cmode & 1 != 0;
        let old = if logic {
            neon_inputs(r, dd, chunks)
        } else {
            vec![]
        };
        let mut out = vec![];
        for i in 0..chunks {
            out.push(if logic {
                bin(
                    if op { B::And } else { B::Or },
                    old[i as usize].clone(),
                    c(64, if op { !value } else { value }),
                )
            } else {
                c(64, if op && cmode != 14 { !value } else { value })
            });
        }
        neon_outputs(r, dd, out);
        return true;
    }

    if word & 0xffb00f90 == 0xf3b00c00 {
        let imm = ((word >> 16) & 15) as u8;
        if imm & 7 == 0 || q && dd & 1 != 0 {
            return neon_invalid(r);
        }
        let log = imm.trailing_zeros() as u8;
        let w = 8 << log;
        let index = imm >> (log + 1);
        let source = neon_inputs(r, dm, 1);
        let scalar = r.bind(neon_lane(&source, index, w));
        let mut v = c(64, 0);
        for i in 0..64 / w {
            v = neon_pack(v, scalar.clone(), i * w);
        }
        neon_outputs(r, dd, vec![v; chunks as usize]);
        return true;
    }
    if word & 0xffbf0f90 == 0xf3b20000 {
        if q && (dd | dm) & 1 != 0 {
            return neon_invalid(r);
        }
        let a = neon_inputs(r, dd, chunks);
        let b = neon_inputs(r, dm, chunks);
        neon_outputs(r, dd, b);
        neon_outputs(r, dm, a);
        return true;
    }
    let op = word & 0xfe800f10;
    let pair = matches!(op, 0xf2000a00 | 0xf2000a10) || word & 0xff800f10 == 0xf2000b10;
    let same = matches!(
        op,
        0xf2000000 | 0xf2000100 | 0xf2000200 | 0xf2000600 | 0xf2000610 | 0xf2000700 | 0xf2000710
    ) || word & 0xff800f10 == 0xf2000810;
    if pair || same {
        if bits == 64 || (q && ((dd | dn | dm) & 1 != 0 || pair)) {
            return neon_invalid(r);
        }
        let a = neon_inputs(r, dn, chunks);
        let b = neon_inputs(r, dm, chunks);
        let accum = op == 0xf2000710;
        let old = if accum {
            neon_inputs(r, dd, chunks)
        } else {
            vec![]
        };
        let mut out = vec![];
        for chunk in 0..chunks {
            let mut result = c(64, 0);
            for i in 0..64 / bits {
                let (x, y) = if pair {
                    let half = 32 / bits;
                    let src = if i < half { &a } else { &b };
                    let index = (i % half) * 2;
                    (neon_lane(src, index, bits), neon_lane(src, index + 1, bits))
                } else {
                    (
                        neon_lane(&a, chunk as u8 * (64 / bits) + i, bits),
                        neon_lane(&b, chunk as u8 * (64 / bits) + i, bits),
                    )
                };
                let v = if word & 0xff800f10 == 0xf2000810 {
                    select(
                        inv(eq(bin(B::And, x, y), c(bits, 0))),
                        c(bits, mask(bits)),
                        c(bits, 0),
                    )
                } else if pair && op == 0xf2000b10 {
                    bin(B::Add, x, y)
                } else if matches!(op, 0xf2000600 | 0xf2000610 | 0xf2000a00 | 0xf2000a10) {
                    let less = bin(if unsigned { B::Ult } else { B::Slt }, x.clone(), y.clone());
                    if op & 0x10 == 0 {
                        select(less, y, x)
                    } else {
                        select(less, x, y)
                    }
                } else {
                    let x = Expr::cast(x, bits * 2, !unsigned);
                    let y = Expr::cast(y, bits * 2, !unsigned);
                    let sub = matches!(op, 0xf2000200 | 0xf2000700 | 0xf2000710);
                    let diff = bin(if sub { B::Sub } else { B::Add }, x, y);
                    if matches!(op, 0xf2000700 | 0xf2000710) {
                        let abs = select(
                            Expr::extract(diff.clone(), bits * 2 - 1, 1),
                            bin(B::Sub, c(bits * 2, 0), diff.clone()),
                            diff,
                        );
                        let v = Expr::cast(abs, bits, false);
                        if accum {
                            bin(
                                B::Add,
                                neon_lane(&old, chunk as u8 * (64 / bits) + i, bits),
                                v,
                            )
                        } else {
                            v
                        }
                    } else {
                        let diff = if op == 0xf2000100 {
                            bin(B::Add, diff, c(bits * 2, 1))
                        } else {
                            diff
                        };
                        Expr::extract(diff, 1, bits)
                    }
                };
                result = neon_pack(result, v, i * bits);
            }
            out.push(result);
        }
        neon_outputs(r, dd, out);
        return true;
    }
    // Pairwise long add/accumulate; each D half reduces independently.
    let misc = word & 0xffb30f10;
    if matches!(misc, 0xf3b00200 | 0xf3b00600) {
        let w = 8u8 << ((word >> 18) & 3);
        if w == 64 || q && (dd | dm) & 1 != 0 {
            return neon_invalid(r);
        }
        let src = neon_inputs(r, dm, chunks);
        let old = if misc == 0xf3b00600 {
            neon_inputs(r, dd, chunks)
        } else {
            vec![]
        };
        let signed = word & 0x80 == 0;
        let mut out = vec![];
        for chunk in 0..chunks {
            let mut v = c(64, 0);
            for i in 0..32 / w {
                let index = chunk as u8 * (64 / w) + i * 2;
                let mut sum = bin(
                    B::Add,
                    Expr::cast(neon_lane(&src, index, w), w * 2, signed),
                    Expr::cast(neon_lane(&src, index + 1, w), w * 2, signed),
                );
                if !old.is_empty() {
                    sum = bin(
                        B::Add,
                        sum,
                        neon_lane(&old, chunk as u8 * (32 / w) + i, w * 2),
                    );
                }
                v = neon_pack(v, sum, i * w * 2);
            }
            out.push(v);
        }
        neon_outputs(r, dd, out);
        return true;
    }
    let long = word & 0xfe800f50;
    if bits != 64 && matches!(long, 0xf2800400 | 0xf2800600 | 0xf2800500 | 0xf2800700) {
        let narrow = matches!(long, 0xf2800400 | 0xf2800600);
        if (narrow && (dn | dm) & 1 != 0) || (!narrow && dd & 1 != 0) {
            return neon_invalid(r);
        }
        let a = neon_inputs(r, dn, if narrow { 2 } else { 1 });
        let b = neon_inputs(r, dm, if narrow { 2 } else { 1 });
        let old = if long == 0xf2800500 {
            neon_inputs(r, dd, 2)
        } else {
            vec![]
        };
        let mut out = vec![];
        for chunk in 0..if narrow { 1 } else { 2 } {
            let output_width = if narrow { bits } else { bits * 2 };
            let mut v = c(64, 0);
            for i in 0..64 / output_width {
                let at = chunk as u8 * (64 / output_width) + i;
                let value = if narrow {
                    let mut value = bin(
                        if long == 0xf2800600 { B::Sub } else { B::Add },
                        neon_lane(&a, at, bits * 2),
                        neon_lane(&b, at, bits * 2),
                    );
                    if unsigned {
                        value = bin(B::Add, value, c(bits * 2, 1u64 << (bits - 1)));
                    }
                    Expr::extract(value, bits, bits)
                } else {
                    let diff = bin(
                        B::Sub,
                        Expr::cast(neon_lane(&a, at, bits), bits * 2, !unsigned),
                        Expr::cast(neon_lane(&b, at, bits), bits * 2, !unsigned),
                    );
                    let value = select(
                        Expr::extract(diff.clone(), bits * 2 - 1, 1),
                        bin(B::Sub, c(bits * 2, 0), diff.clone()),
                        diff,
                    );
                    if old.is_empty() {
                        value
                    } else {
                        bin(B::Add, value, neon_lane(&old, at, bits * 2))
                    }
                };
                v = neon_pack(v, value, i * output_width);
            }
            out.push(v);
        }
        neon_outputs(r, dd, out);
        return true;
    }
    let unary = word & 0xffb30f90;
    if matches!(
        unary,
        0xf3b00700
            | 0xf3b00780
            | 0xf3b10000
            | 0xf3b10080
            | 0xf3b10100
            | 0xf3b10180
            | 0xf3b10200
            | 0xf3b10300
            | 0xf3b10380
    ) {
        let w = 8u8 << ((word >> 18) & 3);
        if w == 64 || (unary == 0xf3b00500 && w != 8) || q && (dd | dm) & 1 != 0 {
            return neon_invalid(r);
        }
        let src = neon_inputs(r, dm, chunks);
        let mut out = vec![];
        let mut saturated = c(1, 0);
        for chunk in 0..chunks {
            let mut v = c(64, 0);
            for i in 0..64 / w {
                let x = neon_lane(&src, chunk as u8 * (64 / w) + i, w);
                let value = match unary {
                    0xf3b00700 | 0xf3b00780 | 0xf3b10300 | 0xf3b10380 => {
                        let sat = eq(x.clone(), c(w, 1u64 << (w - 1)));
                        let neg = bin(B::Sub, c(w, 0), x.clone());
                        let value = if unary & 0x80 != 0 {
                            neg
                        } else {
                            select(Expr::extract(x.clone(), w - 1, 1), neg, x.clone())
                        };
                        if unary & 0x00010000 == 0 {
                            saturated = bin(B::Or, saturated, sat.clone());
                            select(sat, c(w, mask(w - 1)), value)
                        } else {
                            value
                        }
                    }
                    _ => {
                        let negative = bin(B::Slt, x.clone(), c(w, 0));
                        let zero = eq(x, c(w, 0));
                        let pred = match unary {
                            0xf3b10000 => inv(bin(B::Or, negative, zero)),
                            0xf3b10080 => inv(negative),
                            0xf3b10100 => zero,
                            0xf3b10180 => bin(B::Or, negative, zero),
                            _ => negative,
                        };
                        select(pred, c(w, mask(w)), c(w, 0))
                    }
                };
                v = neon_pack(v, value, i * w);
            }
            out.push(v);
        }
        neon_outputs(r, dd, out);
        if matches!(unary, 0xf3b00700 | 0xf3b00780) {
            neon_qc(r, saturated);
        }
        return true;
    }
    // Shift right and accumulate. Quotient plus discarded rounding bit avoids
    // a lost carry when an unsigned 64-bit lane rounds past its original width.
    if matches!(op, 0xf2800110 | 0xf2800310) {
        let imm = ((word >> 16) & 63) | ((word >> 1) & 64);
        if imm < 8 {
            return false;
        }
        let w = 1u8 << (31 - imm.leading_zeros());
        if q && (dd | dm) & 1 != 0 {
            return neon_invalid(r);
        }
        let shift = u32::from(w) * 2 - imm;
        let src = neon_inputs(r, dm, chunks);
        let old = neon_inputs(r, dd, chunks);
        let mut out = vec![];
        for chunk in 0..chunks {
            let mut v = c(64, 0);
            for i in 0..64 / w {
                let at = chunk as u8 * (64 / w) + i;
                let x = neon_lane(&src, at, w);
                let mut shifted = bin(
                    if unsigned { B::Lsr } else { B::Asr },
                    x.clone(),
                    c(w, u64::from(shift)),
                );
                if op == 0xf2800310 {
                    shifted = bin(
                        B::Add,
                        shifted,
                        Expr::cast(Expr::extract(x, shift as u8 - 1, 1), w, false),
                    );
                }
                v = neon_pack(v, bin(B::Add, neon_lane(&old, at, w), shifted), i * w);
            }
            out.push(v);
        }
        neon_outputs(r, dd, out);
        return true;
    }
    neon_multiply_extra(r, word, dd, dn, dm, thumb)
}
fn neon_multiply_extra(r: &mut Recipe, word: u32, dd: u32, dn: u32, dm: u32, thumb: bool) -> bool {
    let bits = 8u8 << ((word >> 20) & 3);
    let key = word & 0xfe800f50;
    let vector = word & 0xff800f10;
    let scalar_same = matches!(
        key,
        0xf2800040 | 0xf2800440 | 0xf2800840 | 0xf2800c40 | 0xf2800d40 | 0xf2800e40 | 0xf2800f40
    );
    let scalar_long = matches!(
        key,
        0xf2800240 | 0xf2800640 | 0xf2800a40 | 0xf2800340 | 0xf2800740 | 0xf2800b40
    );
    let vector_long = matches!(word & 0xff800f50, 0xf2800900 | 0xf2800b00 | 0xf2800d00);
    let rdm_vector = matches!(vector, 0xf3000b10 | 0xf3000c10);
    if !scalar_same && !scalar_long && !vector_long && !rdm_vector {
        return false;
    }
    // size=11 leaves this class for two-register miscellaneous encodings.
    if bits == 64 {
        return false;
    }
    let scalar = scalar_same || scalar_long;
    let long = scalar_long || vector_long;
    let q = if scalar_same {
        word & 0x01000000 != 0
    } else {
        rdm_vector && word & 0x40 != 0
    };
    let chunks = if q || long { 2 } else { 1 };
    let doubling = vector_long
        || matches!(
            key,
            0xf2800340
                | 0xf2800740
                | 0xf2800b40
                | 0xf2800c40
                | 0xf2800d40
                | 0xf2800e40
                | 0xf2800f40
        )
        || rdm_vector;
    let rdm = rdm_vector || matches!(key, 0xf2800e40 | 0xf2800f40);
    if rdm {
        neon_integer_no_it(r, thumb);
    }
    if !matches!(bits, 16 | 32)
        || (long && dd & 1 != 0)
        || (q && (dd | dn) & 1 != 0)
        || (rdm_vector && q && dm & 1 != 0)
        || (scalar_long && doubling && word & 0x01000000 != 0)
    {
        return neon_invalid(r);
    }
    let scalar_register = if bits == 16 { word & 7 } else { word & 15 };
    let scalar_index = if bits == 16 {
        ((word >> 4) & 2) | ((word >> 3) & 1)
    } else {
        (word >> 5) & 1
    };
    let a = neon_inputs(r, dn, if long { 1 } else { chunks });
    let b = neon_inputs(
        r,
        if scalar { scalar_register } else { dm },
        if scalar || long { 1 } else { chunks },
    );
    let product_only = matches!(
        key,
        0xf2800840 | 0xf2800a40 | 0xf2800b40 | 0xf2800c40 | 0xf2800d40
    ) || vector_long && word & 0xf00 == 0xd00;
    let accumulate = rdm || !product_only;
    let old = if accumulate {
        neon_inputs(r, dd, chunks)
    } else {
        vec![]
    };
    let sub = matches!(key, 0xf2800440 | 0xf2800640 | 0xf2800740 | 0xf2800f40)
        || vector_long && word & 0xf00 == 0xb00
        || vector == 0xf3000c10;
    let signed = doubling || !long || word & 0x01000000 == 0;
    let mut out = vec![];
    let mut saturated = c(1, 0);
    let result_width = if long { bits * 2 } else { bits };
    for chunk in 0..chunks {
        let mut result = c(64, 0);
        for i in 0..64 / result_width {
            let at = chunk as u8 * (64 / result_width) + i;
            let x = neon_lane(&a, at, bits);
            let y = neon_lane(&b, if scalar { scalar_index as u8 } else { at }, bits);
            let mut product = bin(
                B::Mul,
                Expr::cast(x.clone(), 64, signed),
                Expr::cast(y.clone(), 64, signed),
            );
            let value = if rdm {
                if sub {
                    product = bin(B::Sub, c(64, 0), product);
                }
                let rounded = bin(
                    B::Asr,
                    bin(B::Add, product, c(64, 1u64 << (bits - 2))),
                    c(64, u64::from(bits - 1)),
                );
                let value = bin(
                    B::Add,
                    Expr::cast(neon_lane(&old, at, bits), 64, true),
                    rounded,
                );
                let (value, sat) = neon_signed_sat(value, bits);
                saturated = bin(B::Or, saturated, sat);
                value
            } else if doubling && long {
                let min = c(bits, 1u64 << (bits - 1));
                let sat = bin(B::And, eq(x, min.clone()), eq(y, min));
                let doubled = select(
                    sat.clone(),
                    c(result_width, mask(result_width - 1)),
                    Expr::cast(bin(B::Shl, product, c(64, 1)), result_width, false),
                );
                saturated = bin(B::Or, saturated, sat);
                if accumulate {
                    let (value, sat) =
                        neon_signed_add(neon_lane(&old, at, result_width), doubled, sub);
                    saturated = bin(B::Or, saturated, sat);
                    value
                } else {
                    doubled
                }
            } else if doubling {
                if key == 0xf2800d40 {
                    product = bin(B::Add, product, c(64, 1u64 << (bits - 2)));
                }
                let shifted = bin(B::Asr, product, c(64, u64::from(bits - 1)));
                let (value, sat) = neon_signed_sat(shifted, bits);
                saturated = bin(B::Or, saturated, sat);
                value
            } else {
                let value = Expr::cast(product, result_width, false);
                if accumulate {
                    bin(
                        if sub { B::Sub } else { B::Add },
                        neon_lane(&old, at, result_width),
                        value,
                    )
                } else {
                    value
                }
            };
            result = neon_pack(result, value, i * result_width);
        }
        out.push(result);
    }
    neon_outputs(r, dd, out);
    if doubling {
        neon_qc(r, saturated);
    }
    true
}
// FEAT_DotProd and FEAT_AA32I8MM integer instructions retain their identical
// A32/T32 physical layout. Feature admission remains the decoder/profile's job.
fn neon_integer_no_it(r: &mut Recipe, thumb: bool) {
    if thumb {
        // Decode legality is unconditional, before ConditionPassed. These new
        // instruction classes have no legal predicated execution in an IT block.
        r.guard = select(
            Expr::require_context(
                eq(itstate(), c(8, 0)),
                "RDM/dot-product/I8MM instruction in Thumb IT block",
            ),
            r.guard.clone(),
            c(1, 0),
        );
    }
}
fn neon_dot(r: &mut Recipe, word: u32, thumb: bool) -> bool {
    let key = word & 0xffb00f10;
    let scalar = matches!(key, 0xfe200d00 | 0xfe200d10 | 0xfe800d00 | 0xfe800d10);
    let dot = scalar || matches!(key, 0xfc200d00 | 0xfc200d10 | 0xfca00d00);
    let matrix = matches!(word & 0xffb00f50, 0xfc200c40 | 0xfc200c50 | 0xfca00c40);
    if !dot && !matrix {
        return false;
    }
    neon_integer_no_it(r, thumb);
    let dd = ((word >> 12) & 15) | ((word >> 18) & 16);
    let dn = ((word >> 16) & 15) | ((word >> 3) & 16);
    let dm = if scalar {
        word & 15
    } else {
        (word & 15) | ((word >> 1) & 16)
    };
    let q = word & 0x40 != 0;
    let chunks = if q { 2 } else { 1 };
    if q && ((dd | dn) & 1 != 0 || !scalar && dm & 1 != 0) {
        return neon_invalid(r);
    }
    let mixed = key == 0xfca00d00
        || matches!(key, 0xfe800d00 | 0xfe800d10)
        || matrix && word & 0x00800000 != 0;
    let signed1 = if mixed {
        scalar && word & 0x10 != 0
    } else {
        word & 0x10 == 0
    };
    let signed2 = if mixed { !signed1 } else { signed1 };
    let a = neon_inputs(r, dn, chunks);
    let b = neon_inputs(r, dm, if scalar { 1 } else { chunks });
    let old = neon_inputs(r, dd, chunks);
    let index = ((word >> 5) & 1) as u8;
    let mut out = vec![];
    for chunk in 0..chunks {
        let mut v = c(64, 0);
        for e in 0..2u8 {
            let at = chunk as u8 * 2 + e;
            let mut value = neon_lane(&old, at, 32);
            for i in 0..if matrix { 8 } else { 4 } {
                let ai = if matrix { (at / 2) * 8 + i } else { at * 4 + i };
                let bi = if matrix {
                    (at % 2) * 8 + i
                } else if scalar {
                    index * 4 + i
                } else {
                    at * 4 + i
                };
                value = bin(
                    B::Add,
                    value,
                    bin(
                        B::Mul,
                        Expr::cast(neon_lane(&a, ai, 8), 32, signed1),
                        Expr::cast(neon_lane(&b, bi, 8), 32, signed2),
                    ),
                );
            }
            v = neon_pack(v, value, e * 32);
        }
        out.push(v);
    }
    neon_outputs(r, dd, out);
    true
}
fn neon_core(r: &mut Recipe, word: u32, pc: u64) -> bool {
    if word & 0x0f900f5f == 0x0e800b10 {
        let d = ((word >> 16) & 15) | ((word >> 3) & 16);
        let q = word & (1 << 21) != 0;
        let rt = (word >> 12) & 15;
        let be = (((word >> 22) & 1) << 1) | ((word >> 5) & 1);
        if rt == 15 || be == 3 || q && d & 1 != 0 {
            return neon_invalid(r);
        }
        let w = 32u8 >> be;
        let scalar = r.bind(Expr::extract(reg(rt, pc), 0, w));
        let mut value = c(64, 0);
        for i in 0..64 / w {
            value = neon_pack(value, scalar.clone(), i * w);
        }
        neon_outputs(r, d, vec![value; if q { 2 } else { 1 }]);
        return true;
    }
    // VMOV (scalar element). opc[3] selects bytes, opc[0] halfwords;
    // opc[2:1] supplies the lane index. Scalar S transfers use a different CP.
    if word & 0x0f000f1f != 0x0e000b10 {
        return false;
    }
    let to_arm = word & (1 << 20) != 0;
    let unsigned = word & (1 << 23) != 0;
    let opc = (((word >> 21) & 3) << 2) | ((word >> 5) & 3);
    if !to_arm && unsigned {
        return false;
    }
    if opc & 0b1011 == 0b0010 || to_arm && unsigned && opc & 0b1011 == 0 {
        return neon_invalid(r);
    }
    let (w, index) = if opc & 8 != 0 {
        (8, opc & 7)
    } else if opc & 1 != 0 {
        (16, (opc >> 1) & 3)
    } else {
        (32, (opc >> 2) & 1)
    };
    let rt = (word >> 12) & 15;
    if rt == 15 {
        return neon_invalid(r);
    }
    let d = ((word >> 16) & 15) | ((word >> 3) & 16);
    let mut slice = vector_slice(d, w);
    slice.register.index = d as u16;
    slice.offset = (index * w as u32) as u8;
    if to_arm {
        write(r, rt, Expr::cast(Expr::register(slice), 32, !unsigned));
    } else {
        r.write(
            slice,
            WritePolicy::Preserve,
            Expr::extract(reg(rt, pc), 0, w),
        );
    }
    true
}

fn vector_slice(n: u32, width: u8) -> RegisterSlice {
    let mut slice = register(
        "a32.vector64",
        if width <= 32 {
            (n / 2) as u16
        } else {
            n as u16
        },
        width,
        64,
    );
    if width <= 32 {
        slice.offset = ((n & 1) * 32) as u8
    }
    slice
}
// H(n) setter zero-extends into S(n); it preserves the adjacent S alias.
// Legacy VCVTB/VCVTT writes a selected half of S and does not use this setter.
fn vfp_ieee_write(r: &mut Recipe, mut destination: RegisterSlice, value: Expr) {
    let value = if destination.width == 16 {
        destination.width = 32;
        Expr::cast(value, 32, false)
    } else { value };
    r.write(destination, WritePolicy::Preserve, value);
}
fn vfp_scalar_key(word: u32, width: u8) -> u32 {
    if width == 16 { (word & !0x300) | 0x200 } else { word }
}
fn vfp_register(word: u32, field: u32, extra: u32, width: u8) -> u32 {
    let low = (word >> field) & 15;
    let high = (word >> extra) & 1;
    if width <= 32 {
        (low << 1) | high
    } else {
        low | (high << 4)
    }
}
fn vfp_scalar_context(r: &mut Recipe) {
    let fpscr = Expr::register(register("a32.fpscr", 0, 32, 32));
    r.guard = select(
        r.guard.clone(),
        select(
            bin(
                B::And,
                eq(Expr::extract(fpscr.clone(), 16, 3), c(3, 0)),
                eq(Expr::extract(fpscr, 20, 2), c(2, 0)),
            ),
            c(1, 1),
            Expr::require_context(c(1, 0), "legacy VFP vector mode"),
        ),
        c(1, 0),
    );
}
/// Legacy Armv7 Appendix D11 execution is separate from the June Armv8
/// scalar entry point, whose affected operations reject LEN/STRIDE != 0.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum LegacyVfpExceptions {
    /// The target has admitted an enabled VFP instruction and no pending bounce.
    /// Floating-point trap enables must be clear. No FPEXC state is consumed.
    Untrapped,
    /// Common VFP subarchitecture v3 synchronous bounce, with TFV=0 and no
    /// pending EX/DEX/FP2V. a32.fpexc[0] is a complete 32-bit register image.
    /// DEX/VV/VECITR are committed before an Undefined Instruction bounce.
    SynchronousV3,
}
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct LegacyVfpContext {
    /// Implemented D-register count, exactly 16 or 32.
    pub d_registers: u8,
    pub exceptions: LegacyVfpExceptions,
}
#[derive(Clone, Copy)]
enum LegacyVfpOp {
    Bits(u8),
    Immediate(u64),
    Float(FloatOperation),
    Nonfused(u32),
}
fn legacy_scalar_bank(n: u32, width: u8) -> bool {
    if width == 32 {
        n < 8
    } else {
        n % 16 < 4
    }
}
fn legacy_index(first: u32, bank: u32, lane: u64, stride: Expr) -> Expr {
    bin(
        B::Or,
        c(32, u64::from(first & !(bank - 1))),
        bin(
            B::And,
            bin(
                B::Add,
                c(32, u64::from(first & (bank - 1))),
                bin(B::Mul, stride, c(32, lane)),
            ),
            c(32, u64::from(bank - 1)),
        ),
    )
}
fn legacy_operand(values: &[Expr], first: u32, bank: u32, index: Expr) -> Expr {
    let start = first & !(bank - 1);
    let mut value = values[first as usize].clone();
    for n in start..start + bank {
        value = select(
            eq(index.clone(), c(32, u64::from(n))),
            values[n as usize].clone(),
            value,
        );
    }
    value
}
fn legacy_fp(
    r: &mut Recipe,
    operation: FloatOperation,
    width: u8,
    inputs: Vec<Expr>,
    control: Expr,
    status: Expr,
    enabled: Expr,
) -> (Expr, Expr, Expr) {
    // Inactive iterations, including iterations after a bounce, consume no
    // operand registers and issue no typed FP projection callbacks.
    let inputs = inputs
        .into_iter()
        .map(|input| {
            let w = input.ty.width;
            r.bind(select(enabled.clone(), input, c(w, 0)))
        })
        .collect::<Vec<_>>();
    let projection = |projection, fallback| {
        select(
            enabled.clone(),
            Expr::float(FloatExpression {
                operation,
                environment: FloatEnvironment::A32Vfp,
                width,
                inputs: inputs.clone(),
                control: Box::new(control.clone()),
                status: Box::new(status.clone()),
                projection,
            }),
            fallback,
        )
    };
    let value = r.bind(projection(FloatProjection::Value, c(width, 0)));
    let next_status = r.bind(projection(FloatProjection::Status, status.clone()));
    let trapped = r.bind(projection(FloatProjection::Trapped, c(1, 0)));
    (value, next_status, trapped)
}
/// Execute one of Armv7 D11's fourteen affected VFP instructions under an
/// explicitly selected legacy target. Other instructions return None so the
/// caller can use the ordinary scalar recipe. No FPSCR write-mask meaning is
/// inferred from LEN/STRIDE, and the a32.fpscr_write_mask bank is unchanged.
///
/// Unpredictable LEN/STRIDE combinations and unrepresented exception models
/// remain checked contexts. SynchronousV3 exposes an architectural Undefined
/// Instruction bounce. Its TFV=0 implementation-defined fault metadata is
/// preserved. Asynchronous FPINST/FPINST2 machinery is not fabricated.
pub fn for_legacy_vfp(
    word: u32,
    length: usize,
    address: u64,
    thumb: bool,
    context: LegacyVfpContext,
) -> Option<Recipe> {
    if length != 4
        || if thumb {
            word >> 28 != 14
        } else {
            word >> 28 == 15
        }
    {
        return None;
    }
    let width = match (word >> 8) & 15 {
        10 => 32,
        11 => 64,
        _ => return None,
    };
    let key = word & 0x0fb00e50;
    let unary = word & 0x0fbf0ed0;
    let operation = if word & 0x0fb00ef0 == 0x0eb00a00 {
        let imm = (((word >> 16) & 15) << 4) | (word & 15);
        let exponent_bits = if width == 32 { 8 } else { 11 };
        let fraction_bits = width - exponent_bits - 1;
        let repeated = if imm & 64 != 0 {
            (1u64 << (exponent_bits - 3)) - 1
        } else {
            0
        };
        let exponent = (((!imm >> 6) & 1) as u64) << (exponent_bits - 1)
            | (repeated << 2)
            | ((imm >> 4) & 3) as u64;
        LegacyVfpOp::Immediate(
            ((imm >> 7) as u64) << (width - 1)
                | (exponent << fraction_bits)
                | ((imm & 15) as u64) << (fraction_bits - 4),
        )
    } else if matches!(unary, 0x0eb00a40 | 0x0eb00ac0 | 0x0eb10a40) {
        LegacyVfpOp::Bits(match unary {
            0x0eb00ac0 => 1,
            0x0eb10a40 => 2,
            _ => 0,
        })
    } else if unary == 0x0eb10ac0 {
        LegacyVfpOp::Float(FloatOperation::SquareRoot)
    } else {
        match key {
            0x0e300a00 => LegacyVfpOp::Float(FloatOperation::Add),
            0x0e300a40 => LegacyVfpOp::Float(FloatOperation::Subtract),
            0x0e200a00 => LegacyVfpOp::Float(FloatOperation::Multiply),
            0x0e800a00 => LegacyVfpOp::Float(FloatOperation::Divide),
            0x0e000a00 | 0x0e000a40 | 0x0e100a00 | 0x0e100a40 | 0x0e200a40 => {
                LegacyVfpOp::Nonfused(key)
            }
            _ => return None,
        }
    };
    let next = (address as u32).wrapping_add(4) as u64;
    let mut r = if thumb {
        thumb_recipe(next)
    } else {
        let mut r = Recipe::new(next, 32);
        r.guard = condition(word >> 28);
        r
    };
    let d = vfp_register(word, 12, 22, width);
    let n = vfp_register(word, 16, 7, width);
    let m = vfp_register(word, 0, 5, width);
    let immediate = matches!(operation, LegacyVfpOp::Immediate(_));
    let unary = matches!(
        operation,
        LegacyVfpOp::Bits(_) | LegacyVfpOp::Float(FloatOperation::SquareRoot)
    );
    let arithmetic = matches!(operation, LegacyVfpOp::Float(_) | LegacyVfpOp::Nonfused(_));
    if !matches!(context.d_registers, 16 | 32)
        || (width == 64
            && (d >= u32::from(context.d_registers)
                || !immediate && m >= u32::from(context.d_registers)
                || !immediate && !unary && n >= u32::from(context.d_registers)))
    {
        r.support = Support::Unsupported(
            "legacy VFP instruction references an unimplemented register bank",
        );
        return Some(r);
    }
    let incoming_fpscr = Expr::register(register("a32.fpscr", 0, 32, 32));
    let len = Expr::cast(Expr::extract(incoming_fpscr.clone(), 16, 3), 32, false);
    let stride_bits = Expr::extract(incoming_fpscr.clone(), 20, 2);
    let stride = select(eq(stride_bits.clone(), c(2, 0)), c(32, 1), c(32, 2));
    let scalar = legacy_scalar_bank(d, width);
    let vector = if scalar {
        c(1, 0)
    } else {
        inv(eq(len.clone(), c(32, 0)))
    };
    let count = select(vector.clone(), bin(B::Add, len.clone(), c(32, 1)), c(32, 1));
    // Table D11-1 constrains all scalar uses to the permitted SP combinations;
    // DP vector operands have the additional four-register bank restriction.
    let legal = bin(
        B::Or,
        eq(stride_bits.clone(), c(2, 0)),
        bin(
            B::And,
            eq(stride_bits, c(2, 3)),
            bin(
                B::And,
                bin(B::Ult, c(32, 0), len.clone()),
                bin(B::Ult, len.clone(), c(32, 4)),
            ),
        ),
    );
    let legal = if width == 64 && !scalar {
        bin(
            B::And,
            legal,
            bin(B::Ult, bin(B::Mul, count.clone(), stride.clone()), c(32, 5)),
        )
    } else {
        legal
    };
    r.guard = select(
        r.guard.clone(),
        Expr::require_context(legal, "unpredictable legacy VFP LEN/STRIDE combination"),
        c(1, 0),
    );
    if arithmetic && context.exceptions == LegacyVfpExceptions::Untrapped {
        r.guard = select(
            r.guard.clone(),
            Expr::require_context(
                eq(bin(B::And, incoming_fpscr.clone(), c(32, 0x9f00)), c(32, 0)),
                "legacy VFP trap enables need an explicit exception protocol",
            ),
            c(1, 0),
        );
    }
    let fpexc = Expr::register(register("a32.fpexc", 0, 32, 32));
    if context.exceptions == LegacyVfpExceptions::SynchronousV3 {
        r.guard = select(
            r.guard.clone(),
            Expr::require_context(
                eq(
                    bin(B::And, fpexc.clone(), c(32, 0xf4000000)),
                    c(32, 0x40000000),
                ),
                "legacy VFP synchronous-v3 requires enabled FPEXC, TFV=0 and no pending bounce",
            ),
            c(1, 0),
        );
    }
    let control = r.bind(incoming_fpscr);
    let mut status = control.clone();
    let mut stopped = c(1, 0);
    let bank = if width == 32 { 8 } else { 4 };
    let mut values = (0..32)
        .map(|n| Expr::register(vector_slice(n, width)))
        .collect::<Vec<_>>();
    for lane in 0..8u64 {
        let enabled = r.bind(bin(
            B::And,
            bin(B::Ult, c(32, lane), count.clone()),
            inv(stopped.clone()),
        ));
        let effective_stride = select(vector.clone(), stride.clone(), c(32, 0));
        let di = legacy_index(d, bank, lane, effective_stride.clone());
        let ni = legacy_index(n, bank, lane, effective_stride.clone());
        let mi = legacy_index(
            m,
            bank,
            lane,
            if legacy_scalar_bank(m, width) {
                c(32, 0)
            } else {
                effective_stride
            },
        );
        let left = if unary || immediate {
            c(width, 0)
        } else {
            legacy_operand(&values, n, bank, ni)
        };
        let right = if immediate {
            c(width, 0)
        } else {
            legacy_operand(&values, m, bank, mi)
        };
        let old = legacy_operand(&values, d, bank, di.clone());
        let (value, next_status, trapped) = match operation {
            LegacyVfpOp::Immediate(value) => (c(width, value), status.clone(), c(1, 0)),
            LegacyVfpOp::Bits(op) => {
                let sign = 1u64 << (width - 1);
                (
                    match op {
                        1 => bin(B::And, right, c(width, !sign)),
                        2 => bin(B::Xor, right, c(width, sign)),
                        _ => right,
                    },
                    status.clone(),
                    c(1, 0),
                )
            }
            LegacyVfpOp::Float(operation) => legacy_fp(
                &mut r,
                operation,
                width,
                if unary {
                    vec![right]
                } else {
                    vec![left, right]
                },
                control.clone(),
                status.clone(),
                enabled.clone(),
            ),
            LegacyVfpOp::Nonfused(key) => {
                let addend = if key == 0x0e200a40 {
                    None
                } else {
                    Some(r.bind(select(enabled.clone(), old, c(width, 0))))
                };
                let (product, mul_status, mul_trap) = legacy_fp(
                    &mut r,
                    FloatOperation::Multiply,
                    width,
                    vec![left, right],
                    control.clone(),
                    status.clone(),
                    enabled.clone(),
                );
                let negate = |v| bin(B::Xor, v, c(width, 1u64 << (width - 1)));
                let product = if matches!(key, 0x0e000a40 | 0x0e100a40 | 0x0e200a40) {
                    negate(product)
                } else {
                    product
                };
                if let Some(addend) = addend {
                    let addend = if matches!(key, 0x0e100a00 | 0x0e100a40) {
                        negate(addend)
                    } else {
                        addend
                    };
                    let (value, status, add_trap) = legacy_fp(
                        &mut r,
                        FloatOperation::Add,
                        width,
                        vec![addend, product],
                        control.clone(),
                        mul_status,
                        bin(B::And, enabled.clone(), inv(mul_trap.clone())),
                    );
                    (value, status, bin(B::Or, mul_trap, add_trap))
                } else {
                    (product, mul_status, mul_trap)
                }
            }
        };
        status = next_status;
        stopped = r.bind(bin(B::Or, stopped, trapped.clone()));
        if arithmetic {
            r.write(
                register("a32.fpscr", 0, 32, 32),
                WritePolicy::ZeroUpper,
                status.clone(),
            );
            if context.exceptions == LegacyVfpExceptions::SynchronousV3 {
                let remaining = bin(
                    B::And,
                    bin(
                        B::Sub,
                        bin(B::Sub, count.clone(), c(32, lane + 1)),
                        c(32, 1),
                    ),
                    c(32, 7),
                );
                let bounce = bin(
                    B::Or,
                    bin(B::And, fpexc.clone(), c(32, !0x28000700u32 as u64)),
                    bin(B::Or, c(32, 0x28000000), bin(B::Shl, remaining, c(32, 8))),
                );
                r.write(
                    register("a32.fpexc", 0, 32, 32),
                    WritePolicy::ZeroUpper,
                    select(trapped.clone(), bounce, fpexc.clone()),
                );
                r.effects.push(Effect::Trap {
                    kind: TrapKind::InvalidInstruction,
                    condition: trapped.clone(),
                });
            } else {
                r.effects.push(Effect::Trap {
                    kind: TrapKind::FloatingPoint,
                    condition: trapped.clone(),
                });
            }
        }
        let commit = bin(B::And, enabled, inv(trapped));
        let value = r.bind(select(commit.clone(), value, c(width, 0)));
        let destinations = if scalar {
            d..d + 1
        } else {
            (d & !(bank - 1))..(d & !(bank - 1)) + bank
        };
        for register_index in destinations {
            let selected = bin(
                B::And,
                commit.clone(),
                eq(di.clone(), c(32, u64::from(register_index))),
            );
            // Keep forwarding lazy: an inactive output is not an input.
            // Later aliased source operands select this lane's result only
            // when it committed; otherwise they read the prior source value.
            values[register_index as usize] = select(
                selected.clone(),
                value.clone(),
                values[register_index as usize].clone(),
            );
            r.write_conditional(
                selected,
                vector_slice(register_index, width),
                WritePolicy::Preserve,
                value.clone(),
            );
        }
    }
    Some(r)
}
// Inputs and controls are captured once before any projection. Status chains
// make sticky FPSCR changes from earlier lanes visible to later lanes without
// exposing partially written destination registers as inputs.
fn fp_outputs(
    r: &mut Recipe,
    operation: FloatOperation,
    environment: FloatEnvironment,
    width: u8,
    inputs: Vec<Expr>,
    control: Expr,
    status: Expr,
) -> (Expr, Expr, Expr) {
    let inputs = inputs.into_iter().map(|v| r.bind(v)).collect::<Vec<_>>();
    let projection = |projection| {
        Expr::float(FloatExpression {
            operation,
            environment,
            width,
            inputs: inputs.clone(),
            control: Box::new(control.clone()),
            status: Box::new(status.clone()),
            projection,
        })
    };
    let value = r.bind(projection(FloatProjection::Value));
    let status = r.bind(projection(FloatProjection::Status));
    let trapped = r.bind(projection(FloatProjection::Trapped));
    (value, status, trapped)
}
// A trapped multiply must not evaluate the following addition. In particular,
// no second FP callback may fabricate an additional exception after that trap.
fn fp_outputs_if(
    r: &mut Recipe,
    operation: FloatOperation,
    environment: FloatEnvironment,
    width: u8,
    inputs: Vec<Expr>,
    control: Expr,
    status: Expr,
    enabled: Expr,
) -> (Expr, Expr, Expr) {
    let inputs = inputs.into_iter().map(|v| r.bind(v)).collect::<Vec<_>>();
    let projection = |projection, fallback| {
        select(
            enabled.clone(),
            Expr::float(FloatExpression {
                operation,
                environment,
                width,
                inputs: inputs.clone(),
                control: Box::new(control.clone()),
                status: Box::new(status.clone()),
                projection,
            }),
            fallback,
        )
    };
    let value = r.bind(projection(FloatProjection::Value, c(width, 0)));
    let next_status = r.bind(projection(FloatProjection::Status, status.clone()));
    let trapped = r.bind(projection(FloatProjection::Trapped, c(1, 0)));
    (value, next_status, trapped)
}
fn fp_nonfused(
    r: &mut Recipe,
    environment: FloatEnvironment,
    width: u8,
    addend: Option<Expr>,
    left: Expr,
    right: Expr,
    negate_addend: bool,
    negate_product: bool,
    control: Expr,
    status: Expr,
) -> (Expr, Expr, Expr) {
    // AArch32 FPNeg is an exact sign-bit toggle, including for NaN data.
    let negate = |v| bin(B::Xor, v, c(width, 1u64 << (width - 1)));
    let addend = addend.map(|v| r.bind(v));
    let (product, status, first_trap) = fp_outputs(
        r,
        FloatOperation::Multiply,
        environment,
        width,
        vec![left, right],
        control.clone(),
        status,
    );
    let product = if negate_product {
        negate(product)
    } else {
        product
    };
    if let Some(addend) = addend {
        let addend = if negate_addend {
            negate(addend)
        } else {
            addend
        };
        let (value, status, second_trap) = fp_outputs_if(
            r,
            FloatOperation::Add,
            environment,
            width,
            vec![addend, product],
            control,
            status,
            inv(first_trap.clone()),
        );
        (value, status, bin(B::Or, first_trap, second_trap))
    } else {
        (product, status, first_trap)
    }
}
fn vfp_nonfused(r: &mut Recipe, word: u32, width: u8) -> bool {
    let key = vfp_scalar_key(word, width) & 0x0fb00e50;
    if !matches!(
        key,
        0x0e000a00 | 0x0e000a40 | 0x0e100a00 | 0x0e100a40 | 0x0e200a40
    ) {
        return false;
    }
    vfp_scalar_context(r);
    let vd = vector_slice(vfp_register(word, 12, 22, width), width);
    let vn = vector_slice(vfp_register(word, 16, 7, width), width);
    let vm = vector_slice(vfp_register(word, 0, 5, width), width);
    let fpscr = r.bind(Expr::register(register("a32.fpscr", 0, 32, 32)));
    let (value, status, trapped) = fp_nonfused(
        r,
        FloatEnvironment::A32Vfp,
        width,
        if key == 0x0e200a40 {
            None
        } else {
            Some(Expr::register(vd))
        },
        Expr::register(vn),
        Expr::register(vm),
        matches!(key, 0x0e100a00 | 0x0e100a40),
        matches!(key, 0x0e000a40 | 0x0e100a40 | 0x0e200a40),
        fpscr.clone(),
        fpscr,
    );
    r.write(
        register("a32.fpscr", 0, 32, 32),
        WritePolicy::ZeroUpper,
        status,
    );
    r.effects.push(Effect::Trap {
        kind: TrapKind::FloatingPoint,
        condition: trapped,
    });
    vfp_ieee_write(r, vd, value);
    true
}
fn fp_scalar(
    r: &mut Recipe,
    operation: FloatOperation,
    width: u8,
    destination: RegisterSlice,
    inputs: Vec<Expr>,
) {
    fp_scalar_control(r, operation, width, destination, inputs, false, false)
}
fn fp_scalar_control(
    r: &mut Recipe, operation: FloatOperation, width: u8,
    destination: RegisterSlice, inputs: Vec<Expr>, nearest_even: bool, signed_result: bool,
) {
    let fpscr = r.bind(Expr::register(register("a32.fpscr", 0, 32, 32)));
    let (value, status, trapped) = fp_outputs(
        r,
        operation,
        FloatEnvironment::A32Vfp,
        width,
        inputs,
        if nearest_even { bin(B::And, fpscr.clone(), c(32, !(3 << 22) & 0xffffffff)) } else { fpscr.clone() },
        fpscr,
    );
    r.write(
        register("a32.fpscr", 0, 32, 32),
        WritePolicy::ZeroUpper,
        status,
    );
    r.effects.push(Effect::Trap {
        kind: TrapKind::FloatingPoint,
        condition: trapped,
    });
    if destination.width != width {
        r.write(destination, WritePolicy::Preserve, Expr::cast(value, destination.width, signed_result));
    } else if width == 16 && !matches!(operation, FloatOperation::Convert { .. }) {
        vfp_ieee_write(r, destination, value)
    } else { r.write(destination, WritePolicy::Preserve, value) }
}
fn vfp_extended(r: &mut Recipe, word: u32, format: u8) -> bool {
    let key_word = vfp_scalar_key(word, format);
    let convert = format != 16 && key_word & 0x0fbf0ed0 == 0x0eb70ac0;
    let from_integer = key_word & 0x0fbf0e50 == 0x0eb80a40;
    let to_integer = key_word & 0x0fbe0e50 == 0x0ebc0a40;
    let fused_key = key_word & 0x0fb00e50;
    let fused = matches!(fused_key, 0x0ea00a00 | 0x0ea00a40 | 0x0e900a00 | 0x0e900a40);
    if !convert && !from_integer && !to_integer && !fused {
        return false;
    }
    let source_width = if from_integer { 32 } else { format };
    let result_width = if convert {
        96 - format
    } else if to_integer {
        32
    } else {
        format
    };
    let vd = vfp_register(word, 12, 22, result_width);
    let vm = vfp_register(word, 0, 5, source_width);
    let input = Expr::register(vector_slice(vm, source_width));
    let (operation, inputs) = if fused {
        // Fused operations use one rounding; typed sign changes preserve the
        // architecture engine's addend-first NaN priority and A32 FPNeg rules.
        vfp_scalar_context(r);
        let vn = vfp_register(word, 16, 7, format);
        (
            FloatOperation::FusedMultiplyAdd {
                negate_product: matches!(fused_key, 0x0ea00a40 | 0x0e900a40),
                negate_addend: matches!(fused_key, 0x0e900a00 | 0x0e900a40),
            },
            vec![
                Expr::register(vector_slice(vd, result_width)),
                Expr::register(vector_slice(vn, format)),
                input,
            ],
        )
    } else if convert {
        (
            FloatOperation::Convert {
                source_width,
                round_to_odd: false,
            },
            vec![input],
        )
    } else if from_integer {
        (
            FloatOperation::FromInteger {
                source_width: 32,
                signed: word & 0x80 != 0,
                fractional_bits: 0,
            },
            vec![input],
        )
    } else {
        (
            FloatOperation::ToInteger {
                source_width,
                signed: word & (1 << 16) != 0,
                fractional_bits: 0,
                rounding: if word & 0x80 != 0 {
                    FloatRounding::Zero
                } else {
                    FloatRounding::Environment
                },
            },
            vec![input],
        )
    };
    fp_scalar(
        r,
        operation,
        result_width,
        vector_slice(vd, result_width),
        inputs,
    );
    true
}
// AArch32 vector FPAbs/FPNeg only change the sign bit, including NaNs.
fn neon_bits(r: &mut Recipe, word: u32, thumb: bool) -> bool {
    let key = word & 0xffbf0f10;
    if !matches!(key, 0xf3b90700 | 0xf3b50700) {
        return false;
    }
    let half = key == 0xf3b50700;
    let dd = ((word >> 12) & 15) | ((word >> 18) & 16);
    let dm = (word & 15) | ((word >> 1) & 16);
    let q = word & 0x40 != 0;
    if q && (dd & 1 != 0 || dm & 1 != 0) {
        return false;
    }
    if half && thumb {
        r.guard = Expr::require_context(eq(itstate(), c(8, 0)),
            "FP16 vector instruction cannot execute in IT");
    }
    let sign = if half {
        0x8000800080008000
    } else {
        0x8000000080000000
    };
    for chunk in 0..if q { 2 } else { 1 } {
        let input = Expr::register(vector_slice(dm + chunk, 64));
        let value = if word & 0x80 != 0 {
            bin(B::Xor, input, c(64, sign))
        } else {
            bin(B::And, input, c(64, !sign))
        };
        r.write(vector_slice(dd + chunk, 64), WritePolicy::Preserve, value);
    }
    true
}
// NEON integer/fixed conversion and integral rounding use StandardFPCR;
// integer lanes have the same width as their FP16 or FP32 counterpart.
fn neon_fp_conversion(r: &mut Recipe, word: u32, thumb: bool) -> bool {
    let integer_round = word & 0xffb30c10 == 0xf3b30000;
    let integral_round = word & 0xffb30c10 == 0xf3b20400;
    let unscaled = word & 0xffb30e10 == 0xf3b30600;
    let fixed = word & 0xfe800c90 == 0xf2800c10;
    if !integer_round && !integral_round && !unscaled && !fixed { return false; }
    let width = if fixed { 16 << ((word >> 9) & 1) } else {
        match (word >> 18) & 3 { 1 => 16, 2 => 32, _ => return false }
    };
    let width = width as u8;
    let rounding = |mode| match mode {
        0 => FloatRounding::NearestAway, 1 => FloatRounding::NearestEven,
        2 => FloatRounding::PositiveInfinity, _ => FloatRounding::NegativeInfinity,
    };
    let operation = if integral_round {
        let op = (word >> 7) & 7;
        let mode = match op {
            0 => FloatRounding::NearestEven, 1 => FloatRounding::Environment,
            2 => FloatRounding::NearestAway, 3 => FloatRounding::Zero,
            5 => FloatRounding::NegativeInfinity, 7 => FloatRounding::PositiveInfinity,
            _ => return false,
        };
        FloatOperation::RoundToIntegral { rounding: mode, exact: op == 1 }
    } else {
        let fractional_bits = if fixed {
            let immediate = ((word >> 16) & 63) as u8;
            if immediate < 64 - width { return false; }
            64 - immediate
        } else { 0 };
        let to_integer = integer_round || word & 0x100 != 0;
        let signed = if fixed { word & (1 << 24) == 0 } else { word & 0x80 == 0 };
        if to_integer {
            FloatOperation::ToInteger { source_width: width, signed, fractional_bits,
                rounding: if integer_round {rounding((word >> 8) & 3)} else {FloatRounding::Zero} }
        } else { FloatOperation::FromInteger { source_width: width, signed, fractional_bits } }
    };
    let dd = ((word >> 12) & 15) | ((word >> 18) & 16);
    let dm = (word & 15) | ((word >> 1) & 16);
    let q = word & 0x40 != 0;
    if q && (dd | dm) & 1 != 0 { return false; }
    if width == 16 && thumb {
        r.guard = Expr::require_context(eq(itstate(), c(8, 0)), "FP16 vector instruction cannot execute in IT");
    }
    let fpscr = r.bind(Expr::register(register("a32.fpscr", 0, 32, 32)));
    let mut status = fpscr.clone();
    let mut trapped = c(1, 0);
    let mut outputs = Vec::new();
    for chunk in 0..if q {2} else {1} {
        let source = r.bind(Expr::register(vector_slice(dm + chunk, 64)));
        let mut output = c(64, 0);
        for lane in 0..64 / width {
            let (value, next_status, next_trapped) = fp_outputs(r, operation,
                FloatEnvironment::A32Neon, width,
                vec![Expr::extract(source.clone(), lane * width, width)], fpscr.clone(), status);
            status = next_status;
            trapped = bin(B::Or, trapped, next_trapped);
            output = bin(B::Or, output, bin(B::Shl, Expr::cast(value, 64, false), c(64, u64::from(lane * width))));
        }
        outputs.push((dd + chunk, output));
    }
    r.write(register("a32.fpscr", 0, 32, 32), WritePolicy::ZeroUpper, status);
    r.effects.push(Effect::Trap {kind: TrapKind::FloatingPoint, condition: trapped});
    for (d, value) in outputs {r.write(vector_slice(d, 64), WritePolicy::Preserve, value);}
    true
}
// FP16/FP32 lane arithmetic, comparisons, extrema and D-register pairwise
// reductions. All source chunks are captured before any destination output.
fn neon_float(r: &mut Recipe, word: u32, thumb: bool) -> bool {
    let zero_key = word & 0xffb30f90;
    let zero_compare = matches!(zero_key,
        0xf3b10400 | 0xf3b10480 | 0xf3b10500 | 0xf3b10580 | 0xf3b10600);
    let width = if zero_compare {
        match (word >> 18) & 3 { 1 => 16, 2 => 32, _ => return false }
    } else if word & (1 << 20) != 0 { 16 } else { 32 };
    let arithmetic = word & 0xffa00f10;
    let nonfused = matches!(arithmetic, 0xf2000d10 | 0xf2200d10);
    let pair = matches!(arithmetic, 0xf3000d00 | 0xf3000f00 | 0xf3200f00) && !zero_compare;
    let compare = zero_compare || matches!(arithmetic,
        0xf2000e00 | 0xf3000e00 | 0xf3200e00 | 0xf3000e10 | 0xf3200e10);
    let compare_kind = if zero_compare {
        match zero_key { 0xf3b10500 => 0, 0xf3b10480 => 1, 0xf3b10400 => 2,
            0xf3b10580 => 3, _ => 4 }
    } else if arithmetic == 0xf2000e00 { 0 }
        else if arithmetic & (1 << 21) == 0 { 1 } else { 2 };
    let absolute_compare = compare && !zero_compare && word & 0x10 != 0;
    let absolute_difference = arithmetic == 0xf3200d00;
    let operation = if compare {
        FloatOperation::Compare { source_width: width, signal_all_nans: compare_kind != 0 }
    } else {
        match arithmetic {
            0xf2000c10 | 0xf2200c10 => FloatOperation::FusedMultiplyAdd {
                negate_product: arithmetic == 0xf2200c10, negate_addend: false },
            0xf2000d10 | 0xf2200d10 | 0xf3000d10 => FloatOperation::Multiply,
            0xf2000d00 | 0xf3000d00 => FloatOperation::Add,
            0xf2200d00 | 0xf3200d00 => FloatOperation::Subtract,
            0xf2000f00 | 0xf2200f00 | 0xf3000f00 | 0xf3200f00
                | 0xf3000f10 | 0xf3200f10 => FloatOperation::MinMax {
                    minimum: word & (1 << 21) != 0, numeric: word & 0x10 != 0 },
            _ => return false,
        }
    };
    let dd = ((word >> 12) & 15) | ((word >> 18) & 16);
    let dn = ((word >> 16) & 15) | ((word >> 3) & 16);
    let dm = (word & 15) | ((word >> 1) & 16);
    let q = word & 0x40 != 0;
    if pair && q || q && (dd & 1 != 0 || dm & 1 != 0 || (!zero_compare && dn & 1 != 0)) {
        return false;
    }
    if width == 16 && thumb {
        r.guard = Expr::require_context(eq(itstate(), c(8, 0)),
            "FP16 vector instruction cannot execute in IT");
    }
    let fpscr = r.bind(Expr::register(register("a32.fpscr", 0, 32, 32)));
    let mut status = fpscr.clone();
    let mut trapped = c(1, 0);
    let mut outputs = vec![];
    let lanes = 64 / width;
    for chunk in 0..if q { 2 } else { 1 } {
        let a = if zero_compare { c(64, 0) }
            else { r.bind(Expr::register(vector_slice(dn + chunk, 64))) };
        let b = r.bind(Expr::register(vector_slice(dm + chunk, 64)));
        let old = if nonfused || matches!(operation, FloatOperation::FusedMultiplyAdd { .. }) {
            r.bind(Expr::register(vector_slice(dd + chunk, 64)))
        } else { c(64, 0) };
        let mut combined = c(64, 0);
        for lane in 0..lanes {
            let extract = |v: Expr, index| Expr::extract(v, index * width, width);
            let (mut left, mut right) = if zero_compare { (extract(b.clone(), lane), c(width, 0)) }
                else if pair {
                    let source = if lane < lanes / 2 { a.clone() } else { b.clone() };
                    let index = (lane % (lanes / 2)) * 2;
                    (extract(source.clone(), index), extract(source, index + 1))
                } else { (extract(a.clone(), lane), extract(b.clone(), lane)) };
            if absolute_compare {
                let magnitude = c(width, (1u64 << (width - 1)) - 1);
                left = bin(B::And, left, magnitude.clone());
                right = bin(B::And, right, magnitude);
            }
            let inputs = if matches!(operation, FloatOperation::FusedMultiplyAdd { .. }) {
                    vec![extract(old.clone(), lane), left.clone(), right.clone()]
                } else { vec![left.clone(), right.clone()] };
            let (mut value, next_status, next_trapped) = if nonfused {
                fp_nonfused(r, FloatEnvironment::A32Neon, width,
                    Some(extract(old.clone(), lane)), left, right,
                    false, arithmetic == 0xf2200d10, fpscr.clone(), status)
            } else {
                fp_outputs(r, operation, FloatEnvironment::A32Neon,
                    if compare { 4 } else { width }, inputs, fpscr.clone(), status)
            };
            status = next_status;
            trapped = bin(B::Or, trapped, next_trapped);
            if compare {
                let n = Expr::extract(value.clone(), 3, 1);
                let z = Expr::extract(value.clone(), 2, 1);
                let ge = bin(B::And, Expr::extract(value.clone(), 1, 1), inv(Expr::extract(value.clone(), 0, 1)));
                let passed = match compare_kind { 0 => z, 1 => ge, 2 => bin(B::And, ge, inv(z)),
                    3 => bin(B::Or, n, z), _ => n };
                value = select(passed, c(width, if width == 32 {u64::from(u32::MAX)} else {u64::from(u16::MAX)}), c(width, 0));
            } else if absolute_difference {
                value = bin(B::And, value, c(width, (1u64 << (width - 1)) - 1));
            }
            combined = bin(B::Or, combined, bin(B::Shl, Expr::cast(value, 64, false), c(64, u64::from(lane * width))));
        }
        outputs.push((dd + chunk, combined));
    }
    r.write(register("a32.fpscr", 0, 32, 32), WritePolicy::ZeroUpper, status);
    r.effects.push(Effect::Trap { kind: TrapKind::FloatingPoint, condition: trapped });
    for (d, value) in outputs { r.write(vector_slice(d, 64), WritePolicy::Preserve, value); }
    true
}
// Legacy VCVTB/VCVTT select either half of an S register; they do not
// inherit the AL/no-IT or LEN/STRIDE restrictions of FP16 arithmetic.
fn vfp_half_convert(r: &mut Recipe, word: u32) -> bool {
    if word & 0x0fbe0e50 != 0x0eb20a40 {
        return false;
    }
    let from_half = word & (1 << 16) == 0;
    let wide = if word & 0x100 == 0 { 32 } else { 64 };
    let source_width = if from_half { 16 } else { wide };
    let result_width = if from_half { wide } else { 16 };
    let vd = vfp_register(word, 12, 22, if from_half { wide } else { 32 });
    let vm = vfp_register(word, 0, 5, if from_half { 32 } else { wide });
    let mut source = vector_slice(vm, source_width);
    let mut destination = vector_slice(vd, result_width);
    let half_offset = if word & 0x80 != 0 { 16 } else { 0 };
    if from_half {
        source.offset += half_offset;
    } else {
        destination.offset += half_offset;
    }
    let fpscr = Expr::register(register("a32.fpscr", 0, 32, 32));
    r.guard = select(
        r.guard.clone(),
        Expr::require_context(
            eq(Expr::extract(fpscr, 26, 1), c(1, 0)),
            "legacy FP16 conversion requires IEEE half format (AHP=0)",
        ),
        c(1, 0),
    );
    fp_scalar(
        r,
        FloatOperation::Convert {
            source_width,
            round_to_odd: false,
        },
        result_width,
        destination,
        vec![Expr::register(source)],
    );
    true
}
fn vfp_compare(r: &mut Recipe, word: u32, width: u8) -> bool {
    let key = vfp_scalar_key(word, width) & 0x0fbf0e50;
    if !matches!(key, 0x0eb40a40 | 0x0eb50a40) {
        return false;
    }
    let zero = key == 0x0eb50a40;
    if zero && word & 0x2f != 0 {
        return false;
    }
    let d = vfp_register(word, 12, 22, width);
    let m = vfp_register(word, 0, 5, width);
    let fpscr = r.bind(Expr::register(register("a32.fpscr", 0, 32, 32)));
    let (nzcv, status, trapped) = fp_outputs(
        r,
        FloatOperation::Compare {
            source_width: width,
            signal_all_nans: word & 0x80 != 0,
        },
        FloatEnvironment::A32Vfp,
        4,
        vec![
            Expr::register(vector_slice(d, width)),
            if zero {
                c(width, 0)
            } else {
                Expr::register(vector_slice(m, width))
            },
        ],
        fpscr.clone(),
        fpscr,
    );
    // An enabled exception updates status before taking the trap, but leaves
    // the comparison's FPSCR.NZCV assignment and integer NZCV untouched.
    r.write(
        register("a32.fpscr", 0, 32, 32),
        WritePolicy::ZeroUpper,
        status.clone(),
    );
    r.effects.push(Effect::Trap {
        kind: TrapKind::FloatingPoint,
        condition: trapped,
    });
    r.write(
        register("a32.fpscr", 0, 32, 32),
        WritePolicy::ZeroUpper,
        bin(
            B::Or,
            bin(B::And, status, c(32, 0x0fffffff)),
            bin(B::Shl, Expr::cast(nzcv, 32, false), c(32, 28)),
        ),
    );
    true
}
fn vfp_half_context(r: &mut Recipe, word: u32, thumb: bool) {
    let valid = if thumb {
        eq(itstate(), c(8, 0))
    } else {
        c(1, (word >> 28 == 14) as u64)
    };
    r.guard = select(
        r.guard.clone(),
        Expr::require_context(
            valid,
            "FP16 scalar instruction requires AL and no Thumb IT block",
        ),
        c(1, 0),
    );
}
// Scalar rounding, numeric extrema, flag selection and fixed-point conversion.
// Unconditional encodings are dispatched before A32's cond=1111 rejection.
fn vfp_scalar_misc(r: &mut Recipe, word: u32, thumb: bool) -> bool {
    let fixed_round = word & 0xffbc0cd0 == 0xfeb80840;
    let fixed_integer = word & 0xffbc0c50 == 0xfebc0840;
    let selection = word & 0xff800c50 == 0xfe000800;
    let numeric = word & 0xffb00c10 == 0xfe800800;
    let current_key = word & 0x0fbf0cd0;
    let current_round = matches!(current_key, 0x0eb60840 | 0x0eb608c0 | 0x0eb70840);
    let fixed_point = word >> 28 != 15 && word & 0x0fba0c50 == 0x0eba0840;
    if !fixed_round && !fixed_integer && !selection && !numeric && !current_round && !fixed_point {
        return false;
    }
    let size = ((word >> 8) & 3) as u8;
    if size == 0 { return false; }
    let width = 8 << size;
    let d = vfp_register(word, 12, 22, width);
    let m = vfp_register(word, 0, 5, width);
    let unconditional = fixed_round || fixed_integer || selection || numeric;
    if unconditional {
        r.guard = if thumb {
            Expr::require_context(eq(itstate(), c(8, 0)), "unconditional scalar VFP forbids Thumb IT")
        } else { c(1, 1) };
    } else if width == 16 { vfp_half_context(r, word, thumb); }
    if selection {
        let n = vfp_register(word, 16, 7, width);
        let cc = (word >> 20) & 3;
        let code = (cc << 2) | ((((cc >> 1) ^ cc) & 1) << 1);
        vfp_ieee_write(r, vector_slice(d, width), select(condition(code),
            Expr::register(vector_slice(n, width)), Expr::register(vector_slice(m, width))));
        return true;
    }
    if fixed_point {
        let integer_width = if word & 0x80 == 0 { 16 } else { 32 };
        let encoded = (((word & 15) << 1) | ((word >> 5) & 1)) as u8;
        if encoded > integer_width { return false; }
        let fractional_bits = integer_width - encoded;
        let signed = word & (1 << 16) == 0;
        if word & (1 << 18) != 0 {
            fp_scalar_control(r, FloatOperation::ToInteger { source_width: width, signed,
                fractional_bits, rounding: FloatRounding::Zero }, integer_width,
                vector_slice(d, if width == 64 {64} else {32}),
                vec![Expr::register(vector_slice(d, width))], false, signed);
        } else {
            let mut source = vector_slice(d, if width == 64 {64} else {32});
            source.width = integer_width;
            fp_scalar_control(r, FloatOperation::FromInteger { source_width: integer_width, signed, fractional_bits },
                width, vector_slice(d, width), vec![Expr::register(source)], true, false);
        }
        return true;
    }
    let rounding = || match (word >> 16) & 3 {
        0 => FloatRounding::NearestAway, 1 => FloatRounding::NearestEven,
        2 => FloatRounding::PositiveInfinity, _ => FloatRounding::NegativeInfinity,
    };
    if fixed_integer {
        let dest = vfp_register(word, 12, 22, 32);
        fp_scalar(r, FloatOperation::ToInteger { source_width: width, signed: word & 0x80 != 0,
            fractional_bits: 0, rounding: rounding() }, 32, vector_slice(dest,32),
            vec![Expr::register(vector_slice(m, width))]);
    } else if numeric {
        let n = vfp_register(word, 16, 7, width);
        fp_scalar(r, FloatOperation::MinMax { minimum: word & 0x40 != 0, numeric: true }, width,
            vector_slice(d,width),vec![Expr::register(vector_slice(n,width)),Expr::register(vector_slice(m,width))]);
    } else {
        fp_scalar(r, FloatOperation::RoundToIntegral {
            rounding: if fixed_round { rounding() } else if word & 0x80 != 0 {FloatRounding::Zero} else {FloatRounding::Environment},
            exact: current_round && current_key == 0x0eb70840,
        }, width,vector_slice(d,width),vec![Expr::register(vector_slice(m,width))]);
    }
    true
}
// VLDM/VSTM (including VPUSH/VPOP aliases and legacy FLDMX/FSTMX).
// The primary operation performs word-aligned 32-bit accesses even for D
// registers. The odd legacy count contributes a spare word to writeback but
// does not transfer that word. Never replace these with 64-bit accesses.
fn vfp_multiple(r: &mut Recipe, word: u32, pc: u64, endian: Endian, thumb: bool) -> bool {
    let increment = word & (1 << 23) != 0;
    let writeback = word & (1 << 21) != 0;
    let double = word & 0x100 != 0;
    let width = if double { 64 } else { 32 };
    let first = vfp_register(word, 12, 22, width);
    let words = word & 255;
    let count = if double { words / 2 } else { words };
    let rn = (word >> 16) & 15;
    if count == 0 || first + count > 32 || (double && count > 16)
        || (double && words & 1 != 0 && first + count > 16)
        || (rn == 15 && (writeback || thumb)) {
        return false;
    }
    let incoming_base = reg(rn, pc);
    // MemA{32} requires four-byte alignment regardless of SCTLR.A. This
    // preflight runs after predication and before any vector or memory input.
    r.preflight_traps.push((TrapKind::Protection, inv(eq(
        bin(B::And, incoming_base.clone(), c(32, 3)), c(32, 0)))));
    let base = r.bind(incoming_base);
    let updated = r.bind(bin(if increment { B::Add } else { B::Sub },
        base.clone(), c(32, u64::from(words * 4))));
    let start = if increment { base } else { updated.clone() };
    let load = word & (1 << 20) != 0;
    for index in 0..count {
        let source = if load { None } else {
            Some(r.bind(Expr::register(vector_slice(first + index, width))))
        };
        let mut loaded = Vec::new();
        for part in 0..if double { 2 } else { 1 } {
            let memory = Memory { kind: Default::default(), privilege: Default::default(),
                address: Box::new(bin(B::Add, start.clone(),
                    c(32, u64::from(index * u32::from(width / 8) + part * 4)))),
                width: 32, endian };
            if load {
                // Keep each register load at its write effect so native list
                // faults can publish earlier completed registers.
                loaded.push(Expr::load(memory));
            } else {
                let offset = if double && endian == Endian::Big { (1 - part) * 32 } else { part * 32 };
                r.effects.push(Effect::Store { memory,
                    value: Expr::extract(source.as_ref().unwrap().clone(), offset as u8, 32) });
            }
        }
        if load {
            // Preserve ascending access order in both endian modes.
            let value = if double {
                let first_word = Expr::cast(loaded[0].clone(), 64, false);
                let second_word = Expr::cast(loaded[1].clone(), 64, false);
                if endian == Endian::Big {
                    bin(B::Or, bin(B::Shl, first_word, c(64, 32)), second_word)
                } else {
                    bin(B::Or, first_word, bin(B::Shl, second_word, c(64, 32)))
                }
            } else { loaded.remove(0) };
            r.write(vector_slice(first + index, width), WritePolicy::Preserve, value);
        }
    }
    if writeback { write(r, rn, updated); }
    true
}
fn vfp(r: &mut Recipe, word: u32, pc: u64, endian: Endian, thumb: bool) -> bool {
    if word & 0x0e000e00 == 0x0c000a00 {
        let puw = ((word >> 22) & 6) | ((word >> 21) & 1);
        if matches!(puw, 2 | 3 | 5) {
            return vfp_multiple(r, word, pc, endian, thumb);
        }
    }
    let half = (word >> 8) & 15 == 9;
    let width = if half {
        16
    } else if word & 0x100 == 0 {
        32
    } else {
        64
    };
    let vd = vfp_register(word, 12, 22, width);
    let vn = vfp_register(word, 16, 7, width);
    let vm = vfp_register(word, 0, 5, width);
    // VMRS FPSCR and APSR_nzcv. Other system register numbers are not inferred.
    if word & 0x0fff0fff == 0x0ef10a10 {
        let rt = (word >> 12) & 15;
        let fpscr = r.bind(Expr::register(register("a32.fpscr", 0, 32, 32)));
        if rt == 15 {
