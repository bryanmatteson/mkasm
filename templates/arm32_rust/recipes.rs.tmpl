        Expr::float(FloatExpression {
            operation,
            environment: FloatEnvironment::A32Vfp,
            width,
            inputs: inputs.clone(),
            control: Box::new(fpscr.clone()),
            status: Box::new(fpscr.clone()),
            projection,
