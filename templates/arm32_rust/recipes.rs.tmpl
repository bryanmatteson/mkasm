        0x0e300a00 => FloatOperation::Add,
        0x0e300a40 => FloatOperation::Subtract,
        0x0e200a00 => FloatOperation::Multiply,
        0x0e800a00 => FloatOperation::Divide,
        _ => {
            if unary == 0x0eb10ac0 {
                FloatOperation::SquareRoot
