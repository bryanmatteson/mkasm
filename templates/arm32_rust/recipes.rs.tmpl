// Integer Advanced SIMD extensions. Encodings and snapshot operands follow the
// June 2026 A32 corpus. Q registers always alias two adjacent D chunks.
fn neon_invalid(r: &mut Recipe) -> bool {
    r.support = Support::Unsupported("reserved or constrained Advanced SIMD integer operands");
