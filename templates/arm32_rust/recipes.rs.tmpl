    }
    if word & 0xf800 == 0xe000 {
        last_it(&mut r);
        r.branch(
            FlowKind::Branch,
            c(1, 1),
            c(32, pc.wrapping_add(sign(((word & 0x7ff) << 1) as u64, 12))),
        );
        return r;
    }
