    let mut qc = register("a32.fpscr", 0, 1, 32);
    qc.offset = 27;
    r.write(
        qc,
        WritePolicy::Preserve,
        select(saturated, c(1, 1), Expr::register(qc)),
    );
}
fn neon_signed_sat(value: Expr, width: u8) -> (Expr, Expr) {
    let w = value.ty.width;
    let low = c(w, (!mask(width - 1)) & mask(w));
    let high = c(w, mask(width - 1));
    let below = bin(B::Slt, value.clone(), low.clone());
    let above = bin(B::Slt, high.clone(), value.clone());
    (
        Expr::cast(
            select(below.clone(), low, select(above.clone(), high, value)),
            width,
            false,
        ),
        bin(B::Or, below, above),
    )
}
fn neon_signed_add(a: Expr, b: Expr, sub: bool) -> (Expr, Expr) {
    let w = a.ty.width;
    let value = bin(if sub { B::Sub } else { B::Add }, a.clone(), b.clone());
    let sat = Expr::overflow(sub, a.clone(), b, value.clone());
    (
        select(
            sat.clone(),
            select(
                Expr::extract(a, w - 1, 1),
                c(w, 1u64 << (w - 1)),
                c(w, mask(w - 1)),
            ),
            value,
        ),
        sat,
    )
