        logical,
        0xf2000110
            | 0xf2100110
            | 0xf2200110
            | 0xf2300110
            | 0xf3000110
            | 0xf3100110
            | 0xf3200110
            | 0xf3300110
    );
    let laneop = matches!(
        arithmetic,
        0xf2000800
            | 0xf3000800
            | 0xf2000910
            | 0xf3000810
            | 0xf2000300
            | 0xf2000310
            | 0xf3000300
            | 0xf3000310
    );
    if !unary && !bitwise && !laneop {
        return false;
    }
    if q && (dd & 1 != 0 || dm & 1 != 0 || (!unary && dn & 1 != 0)) {
        return false;
    }
    if laneop && bits == 64 && !matches!(arithmetic, 0xf2000800 | 0xf3000800) {
        return false;
    }
    for chunk in 0..if q { 2 } else { 1 } {
        let a = if unary {
            c(64, 0)
        } else {
            r.bind(Expr::register(vector_slice(dn + chunk, 64)))
        };
        let b = r.bind(Expr::register(vector_slice(dm + chunk, 64)));
        let old = Expr::register(vector_slice(dd + chunk, 64));
        let value = if unary {
            inv(b)
        } else if bitwise {
            match logical {
                0xf2000110 => bin(B::And, a, b),
                0xf2100110 => bin(B::And, a, inv(b)),
                0xf2200110 => bin(B::Or, a, b),
                0xf2300110 => bin(B::Or, a, inv(b)),
                0xf3000110 => bin(B::Xor, a, b),
                0xf3100110 => bin(B::Or, bin(B::And, old.clone(), a), bin(B::And, inv(old), b)),
                0xf3200110 => bin(B::Or, bin(B::And, old, inv(b.clone())), bin(B::And, a, b)),
                _ => bin(B::Or, bin(B::And, old, b.clone()), bin(B::And, a, inv(b))),
            }
        } else {
            let mut value = c(64, 0);
            for lane in 0..64 / bits {
                let x = Expr::extract(a.clone(), lane * bits, bits);
                let y = Expr::extract(b.clone(), lane * bits, bits);
                let lane_value = match arithmetic {
                    0xf2000800 => bin(B::Add, x, y),
                    0xf3000800 => bin(B::Sub, x, y),
                    0xf2000910 => bin(B::Mul, x, y),
                    _ => {
                        let pred = if arithmetic == 0xf3000810 {
                            eq(x, y)
                        } else {
                            let cmp = if arithmetic & 0x01000000 == 0 {
                                B::Slt
                            } else {
                                B::Ult
                            };
                            if arithmetic & 0x10 == 0 {
                                bin(cmp, y, x)
                            } else {
                                inv(bin(cmp, x, y))
                            }
                        };
                        select(pred, c(bits, mask(bits)), c(bits, 0))
                    }
                };
                value = bin(
                    B::Or,
                    value,
                    bin(
                        B::Shl,
                        Expr::cast(lane_value, 64, false),
                        c(64, (lane * bits) as u64),
                    ),
                );
            }
            value
        };
        r.write(vector_slice(dd + chunk, 64), WritePolicy::Preserve, value)
    }
