//! Audited A32/Thumb scalar execution, D/Q vector chunks and typed VFP
//! operations, including explicit IT, instruction state and data endianness.
use super::semantics::*;
use BinaryOp as B;
use UnaryOp as U;
fn c(w: u8, v: u64) -> Expr {
    Expr::constant(w, v)
}
fn bin(op: B, a: Expr, b: Expr) -> Expr {
    Expr::binary(op, a, b)
}
fn inv(a: Expr) -> Expr {
    Expr::unary(U::Not, a)
}
fn select(p: Expr, a: Expr, b: Expr) -> Expr {
    Expr::select(p, a, b)
}
fn eq(a: Expr, b: Expr) -> Expr {
    bin(B::Eq, a, b)
}
fn flag(i: u16) -> Expr {
    Expr::register(register("a32.nzcv", i, 1, 1))
}
fn reg(n: u32, pc: u64) -> Expr {
    if n == 15 {
        c(32, pc)
    } else {
        Expr::register(register("a32.gpr", n as u16, 32, 32))
    }
}
fn write(r: &mut Recipe, n: u32, v: Expr) {
    r.write(
        register("a32.gpr", n as u16, 32, 32),
        WritePolicy::ZeroUpper,
        v,
    )
}
fn setflag(r: &mut Recipe, i: u16, v: Expr, enabled: &Expr) {
    r.write(
        register("a32.nzcv", i, 1, 1),
        WritePolicy::ZeroUpper,
        select(enabled.clone(), v, flag(i)),
    )
}
fn condition(code: u32) -> Expr {
    let eqnv = eq(flag(0), flag(3));
    let base = match code >> 1 {
        0 => flag(1),
        1 => flag(2),
        2 => flag(0),
        3 => flag(3),
        4 => bin(B::And, flag(2), inv(flag(1))),
        5 => eqnv,
        6 => bin(B::And, eqnv, inv(flag(1))),
        _ => c(1, 1),
    };
    if code & 1 != 0 && code != 15 {
        inv(base)
    } else {
        base
    }
}
fn dynamic_condition(code: Expr) -> Expr {
    let mut out = select(
        eq(code.clone(), c(4, 15)),
        Expr::require_context(c(1, 0), "invalid incoming IT condition"),
        c(1, 1),
    );
    for n in (0..14).rev() {
        out = select(eq(code.clone(), c(4, n)), condition(n as u32), out);
    }
    out
}
fn sign(v: u64, b: u32) -> u64 {
    (((v << (64 - b)) as i64) >> (64 - b)) as u64
}
fn unsupported(next: u64) -> Recipe {
    Recipe::unsupported(
        "A32/Thumb family or constrained operand requires a native transition",
        next,
        32,
    )
}
fn itstate() -> Expr {
    Expr::register(register("a32.itstate", 0, 8, 8))
}
fn in_it() -> Expr {
    inv(eq(bin(B::And, itstate(), c(8, 15)), c(8, 0)))
}
fn thumb_recipe(next: u64) -> Recipe {
    let mut r = Recipe::new(next, 32);
    r.guard = select(
        in_it(),
        dynamic_condition(Expr::extract(itstate(), 4, 4)),
        Expr::require_context(eq(itstate(), c(8, 0)), "malformed incoming ITSTATE"),
    );
    let advanced = select(
        eq(bin(B::And, itstate(), c(8, 7)), c(8, 0)),
        c(8, 0),
        bin(
            B::Or,
            bin(B::And, itstate(), c(8, 0xe0)),
            bin(B::And, bin(B::Shl, itstate(), c(8, 1)), c(8, 31)),
        ),
    );
    r.write_always(
        register("a32.itstate", 0, 8, 8),
        WritePolicy::ZeroUpper,
        advanced,
    );
    r
}
// Control transfers are only legal in the final IT slot. A checked context
// rejects invalid execution rather than inventing architectural behavior.
fn last_it(r: &mut Recipe) {
    let legal = bin(
        B::Or,
        inv(in_it()),
        eq(bin(B::And, itstate(), c(8, 7)), c(8, 0)),
    );
    r.guard = select(
        legal,
        r.guard.clone(),
        Expr::require_context(c(1, 0), "branch before final IT slot"),
    );
}
fn thumb_state(r: &mut Recipe, v: Expr) {
    r.write(
        register("a32.thumb_state", 0, 1, 1),
        WritePolicy::ZeroUpper,
        v,
    )
}
fn branch_pc(r: &mut Recipe, target: Expr, exchange: bool, kind: FlowKind, thumb: bool) {
    let target = r.bind(target);
    let aligned = if exchange {
        let t = Expr::extract(target.clone(), 0, 1);
        // An ARM-state target with bit[1] set depends on A32FORCEALIGNPC:
        // either clear bit 1 or preserve it and take a PC-alignment fault.
        // This recipe has no implementation-policy input for that choice.
        let legal = bin(
            B::Or,
            t.clone(),
            eq(Expr::extract(target.clone(), 1, 1), c(1, 0)),
        );
        let target = select(
            Expr::require_context(legal, "misaligned ARM interworking target"),
            target.clone(),
            c(32, 0),
        );
        thumb_state(r, t.clone());
        select(
            t,
            bin(B::And, target.clone(), c(32, 0xfffffffe)),
            bin(B::And, target, c(32, 0xfffffffc)),
        )
    } else {
        bin(
            B::And,
            target,
            c(32, if thumb { 0xfffffffe } else { 0xfffffffc }),
        )
    };
    r.branch(kind, c(1, 1), aligned)
}
// Shift_C uses the full low byte of a register shift amount. The zero, 32,
// greater-than-32, rotate-multiple-of-32, and RRX cases are architectural cases.
fn shift(value: Expr, kind: u32, amount: Expr, immediate: bool) -> (Expr, Expr) {
    let amount = Expr::cast(amount, 32, false);
    let zero = eq(amount.clone(), c(32, 0));
    let a = if immediate && (kind == 1 || kind == 2) {
        select(zero.clone(), c(32, 32), amount.clone())
    } else {
        amount.clone()
    };
    let v = match kind {
        0 => bin(B::Shl, value.clone(), a.clone()),
        1 => bin(B::Lsr, value.clone(), a.clone()),
        2 => bin(B::Asr, value.clone(), a.clone()),
        _ => bin(B::Ror, value.clone(), a.clone()),
    };
    let carry = match kind {
        0 => Expr::extract(
            bin(B::Lsr, value.clone(), bin(B::Sub, c(32, 32), a.clone())),
            0,
            1,
        ),
        1 | 2 => Expr::extract(
            bin(B::Lsr, value.clone(), bin(B::Sub, a.clone(), c(32, 1))),
            0,
            1,
        ),
        _ => Expr::extract(v.clone(), 31, 1),
    };
    let carry = if kind == 2 {
        select(
            bin(B::Ult, c(32, 32), a.clone()),
            Expr::extract(value.clone(), 31, 1),
            carry,
        )
    } else {
        carry
    };
    if immediate && kind == 3 {
        let rrx = bin(
            B::Or,
            bin(B::Lsr, value.clone(), c(32, 1)),
            bin(B::Shl, Expr::cast(flag(2), 32, false), c(32, 31)),
        );
        return (
            select(zero.clone(), rrx, v),
            select(zero, Expr::extract(value, 0, 1), carry),
        );
    }
    if immediate && kind != 0 {
        (v, carry)
    } else {
        (select(zero.clone(), value, v), select(zero, flag(2), carry))
    }
}
fn nz(r: &mut Recipe, value: &Expr, enabled: &Expr) {
    setflag(r, 0, Expr::extract(value.clone(), 31, 1), enabled);
    setflag(r, 1, eq(value.clone(), c(32, 0)), enabled);
}
// ARM's sixteen data-processing operations; operands and incoming carry are
// captured before any flag write, including ADC/SBC and predicated aliases.
fn alu(
    r: &mut Recipe,
    op: u32,
    rd: u32,
    a: Expr,
    b: Expr,
    carry: Expr,
    enabled: Expr,
    thumb: bool,
) {
    // MOV/MVN do not consume Rn. Capturing an unused presentation operand
    // would turn an unavailable register into an execution prerequisite.
    let a = r.bind(if matches!(op, 13 | 15) { c(32, 0) } else { a });
    let b = r.bind(b);
    let logical = matches!(op, 0 | 1 | 8 | 9 | 12 | 13 | 14 | 15);
    let carry = r.bind(if logical && enabled != c(1, 0) {
        carry
    } else {
        c(1, 0)
    });
    let (sub, left, right, ci) = match op {
        2 | 10 => (true, a.clone(), b.clone(), c(1, 0)),
        3 => (true, b.clone(), a.clone(), c(1, 0)),
        5 => (false, a.clone(), b.clone(), flag(2)),
        6 => (true, a.clone(), b.clone(), inv(flag(2))),
        7 => (true, b.clone(), a.clone(), inv(flag(2))),
        _ => (false, a.clone(), b.clone(), c(1, 0)),
    };
    let ci = r.bind(ci);
    let value = if logical {
        match op {
            0 | 8 => bin(B::And, a, b.clone()),
            1 | 9 => bin(B::Xor, a, b.clone()),
            12 => bin(B::Or, a, b.clone()),
            13 => b.clone(),
            14 => bin(B::And, a, inv(b.clone())),
            _ => inv(b.clone()),
        }
    } else {
        let bop = if sub { B::Sub } else { B::Add };
        bin(
            bop,
            bin(bop, left.clone(), right.clone()),
            Expr::cast(ci.clone(), 32, false),
        )
    };
    let value = r.bind(value);
    // PC+S is exception return, not an ordinary ALU transition.
    if rd == 15 && !matches!(op, 8..=11) {
        branch_pc(r, value, !thumb, FlowKind::Branch, thumb);
        return;
    }
    if enabled != c(1, 0) {
        nz(r, &value, &enabled);
        if logical {
            setflag(r, 2, carry, &enabled)
        } else {
            setflag(
                r,
                2,
                if sub {
                    inv(Expr::sub_borrow(left.clone(), right.clone(), ci))
                } else {
                    Expr::add_carry(left.clone(), right.clone(), ci)
                },
                &enabled,
            );
            setflag(
                r,
                3,
                Expr::overflow(sub, left, right, value.clone()),
                &enabled,
            );
        }
    }
    if !matches!(op, 8..=11) {
        write(r, rd, value)
    }
}
fn memory(
    r: &mut Recipe,
    load: bool,
    rt: u32,
    address: Expr,
    width: u8,
    signed: bool,
    endian: Endian,
    pc: u64,
    thumb: bool,
) {
    let m = Memory {kind: Default::default(), privilege: Default::default(),
        address: Box::new(address),
        width,
        endian,
    };
    if load {
        let v = r.bind(Expr::cast(Expr::load(m), 32, signed));
        if rt == 15 {
            branch_pc(r, v, true, FlowKind::Branch, thumb)
        } else {
            write(r, rt, v)
        }
    } else {
        r.effects.push(Effect::Store {
            memory: m,
            value: Expr::cast(reg(rt, pc), width, false),
        })
    }
}
fn multiple(
    r: &mut Recipe,
    rn: u32,
    list: u32,
    load: bool,
    wb: bool,
    increment: bool,
    before: bool,
    pc: u64,
    endian: Endian,
    thumb: bool,
) -> bool {
    if list == 0 || rn == 15 || (wb && list & (1 << rn) != 0) {
        return false;
    }
    let count = list.count_ones();
    let base = r.bind(reg(rn, pc));
    let start = if increment {
        bin(B::Add, base.clone(), c(32, if before { 4 } else { 0 }))
    } else {
        bin(
            B::Sub,
            base.clone(),
            c(32, 4 * (count - if before { 0 } else { 1 }) as u64),
        )
    };
    let mut index = 0;
    for n in 0..16 {
        if list & (1 << n) != 0 {
            let addr = r.bind(bin(B::Add, start.clone(), c(32, index * 4)));
            memory(r, load, n, addr, 32, false, endian, pc, thumb);
            index += 1;
        }
    }
    if wb {
        write(
            r,
            rn,
            bin(
                if increment { B::Add } else { B::Sub },
                base,
                c(32, 4 * count as u64),
            ),
        )
    }
    if load && rn == 13 && wb && list & 0x8000 != 0 {
        r.flow.kind = FlowKind::Return
    }
    true
}
fn bitfield(
    r: &mut Recipe,
    rd: u32,
    rn: u32,
    lsb: u32,
    width: u32,
    signed: bool,
    insert: bool,
    pc: u64,
) -> bool {
    if rd == 15 || lsb >= 32 || width == 0 || width > 32 - lsb {
        return false;
    }
    let value = if insert {
        let mask = (mask(width as u8) as u32) << lsb;
        bin(
            B::Or,
            bin(B::And, reg(rd, pc), c(32, (!mask) as u64)),
            bin(
                B::And,
                bin(
                    B::Shl,
                    if rn == 15 { c(32, 0) } else { reg(rn, pc) },
                    c(32, lsb as u64),
                ),
                c(32, mask as u64),
            ),
        )
    } else {
        if rn == 15 {
            return false;
        }
        Expr::cast(
            Expr::extract(reg(rn, pc), lsb as u8, width as u8),
            32,
            signed,
        )
    };
    write(r, rd, value);
    true
}
fn multiply(r: &mut Recipe, rd: u32, rn: u32, rm: u32, ra: Option<u32>, flags: Expr, pc: u64) {
    let product = bin(B::Mul, reg(rn, pc), reg(rm, pc));
    let value = r.bind(if let Some(ra) = ra {
        bin(B::Add, product, reg(ra, pc))
    } else {
        product
    });
    if flags != c(1, 0) {
        nz(r, &value, &flags)
    }
    write(r, rd, value)
}
fn atomic_context(r: &mut Recipe, address: Expr, width: u8) {
    if width > 8 {
        let aligned = eq(
            bin(B::And, address, c(32, (width / 8 - 1) as u64)),
            c(32, 0),
        );
        r.guard = select(
            r.guard.clone(),
            Expr::require_context(
                aligned,
                "unaligned A32 atomic access requires fault context",
            ),
            c(1, 0),
        );
    }
}
fn atomic_transfer(
    r: &mut Recipe,
    load: bool,
    exclusive: bool,
    ordered: bool,
    rt: u32,
    rt2: Option<u32>,
    status: Option<u32>,
    address: Expr,
    width: u8,
    pc: u64,
    endian: Endian,
) {
    atomic_context(r, address.clone(), width);
    let value = if width == 64 {
        let first = Expr::cast(reg(rt, pc), 64, false);
        let second = Expr::cast(reg(rt2.unwrap(), pc), 64, false);
        let (low, high) = if endian == Endian::Little {
            (first, second)
        } else {
            (second, first)
        };
        bin(B::Or, low, bin(B::Shl, high, c(64, 32)))
    } else {
        Expr::cast(reg(rt, pc), width, false)
    };
    let kind = if load {
        if exclusive {
            AtomicOperationKind::LoadLinked
        } else {
            AtomicOperationKind::Load
        }
    } else if exclusive {
        AtomicOperationKind::StoreConditional { value }
    } else {
        AtomicOperationKind::Store { value }
    };
    let results = r.atomic(AtomicOperation {
        memory: Memory {kind: Default::default(), privilege: Default::default(),
            address: Box::new(address),
            width,
            endian,
        },
        ordering: if ordered {
            if load {
                MemoryOrdering::Acquire
            } else {
                MemoryOrdering::Release
            }
        } else {
            MemoryOrdering::Monotonic
        },
        scope: MemoryScope::System,
        kind,
    });
    if load {
        let value = results.value.unwrap();
        if width == 64 {
            let value = r.bind(value);
            let first = if endian == Endian::Little { 0 } else { 32 };
            write(r, rt, Expr::extract(value.clone(), first, 32));
            write(r, rt2.unwrap(), Expr::extract(value, 32 - first, 32));
        } else {
            write(r, rt, Expr::cast(value, 32, false))
        }
    } else if exclusive {
        // ARM returns zero for success and one for failure; the schema exposes
        // the architecture-independent one-bit success outcome.
        write(
            r,
            status.unwrap(),
            Expr::cast(inv(results.success.unwrap()), 32, false),
        )
    }
}
fn a32_atomic(word: u32, mut r: Recipe, pc: u64, next: u64, endian: Endian) -> Option<Recipe> {
    let rn = (word >> 16) & 15;
    // The historical SWP/SWPB encodings have no Thumb equivalent. Rd==Rm is
    // defined, but the address register cannot alias either data register.
    if word & 0x0fb00ff0 == 0x01000090 {
        let rd = (word >> 12) & 15;
        let rm = word & 15;
        if rn == 15 || rd == 15 || rm == 15 || rn == rd || rn == rm {
            return Some(unsupported(next));
        }
        let width = if word & (1 << 22) != 0 { 8 } else { 32 };
        let address = reg(rn, pc);
        atomic_context(&mut r, address.clone(), width);
        let results = r.atomic(AtomicOperation {
            memory: Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address),
                width,
                endian,
            },
            ordering: MemoryOrdering::Monotonic,
            scope: MemoryScope::System,
            kind: AtomicOperationKind::ReadModifyWrite {
                operation: AtomicRmwOp::Exchange,
                value: Expr::cast(reg(rm, pc), width, false),
            },
        });
        write(&mut r, rd, Expr::cast(results.value.unwrap(), 32, false));
        return Some(r);
    }
    if word & 0x0f800cf0 != 0x01800c90 {
        return None;
    }
    let mode = (word >> 8) & 3;
    let load = word & (1 << 20) != 0;
    let exclusive = mode & 2 != 0;
    // ex=0,ord=1 and nonexclusive doubleword forms are unallocated.
    let width = match (word >> 21) & 3 {
        0 => 32,
        1 => 64,
        2 => 8,
        _ => 16,
    };
    if mode == 1 || (!exclusive && width == 64) {
        return Some(unsupported(next));
    }
    let ordered = mode & 1 == 0;
    let field = (word >> 12) & 15;
    let rt = if load { field } else { word & 15 };
    let rt2 = if width == 64 { Some(rt + 1) } else { None };
    let status = if !load && exclusive {
        Some(field)
    } else {
        None
    };
    if rn == 15
        || rt == 15
        || (load && word & 15 != 15)
        || (!load && !exclusive && field != 15)
        || (width == 64 && (rt & 1 != 0 || rt >= 14))
        || status.is_some_and(|rd| rd == 15 || rd == rn || rd == rt || Some(rd) == rt2)
    {
        return Some(unsupported(next));
    }
    atomic_transfer(
        &mut r,
        load,
        exclusive,
        ordered,
        rt,
        rt2,
        status,
        reg(rn, pc),
        width,
        pc,
        endian,
    );
    Some(r)
}
fn thumb_atomic(word: u32, mut r: Recipe, pc: u64, next: u64, endian: Endian) -> Option<Recipe> {
    let rn = (word >> 16) & 15;
    let rt = (word >> 12) & 15;
    if word & 0xffe00000 == 0xe8400000 {
        let load = word & (1 << 20) != 0;
        let rd = (word >> 8) & 15;
        if rn == 15
            || rt == 15
            || (load && rd != 15)
            || (!load && (rd == 15 || rd == rn || rd == rt))
        {
            return Some(unsupported(next));
        }
        let address = bin(B::Add, reg(rn, pc), c(32, ((word & 255) * 4) as u64));
        atomic_transfer(
            &mut r,
            load,
            true,
            false,
            rt,
            None,
            if load { None } else { Some(rd) },
            address,
            32,
            pc,
            endian,
        );
        return Some(r);
    }
    if word & 0xffe00000 != 0xe8c00000 {
        return None;
    }
    let op = (word >> 4) & 15;
    let width = match op {
        4 | 8 | 12 => 8,
        5 | 9 | 13 => 16,
        10 | 14 => 32,
        7 | 15 => 64,
        _ => return None,
    };
    let load = word & (1 << 20) != 0;
    let exclusive = op < 8 || op >= 12;
    let ordered = op >= 8;
    let field = (word >> 8) & 15;
    let rd = word & 15;
    let rt2 = if width == 64 { Some(field) } else { None };
    if rn == 15
        || rt == 15
        || (width != 64 && field != 15)
        || (width == 64 && (field == 15 || (load && field == rt)))
        || (load && rd != 15)
        || (!load && !exclusive && rd != 15)
        || (!load && exclusive && (rd == 15 || rd == rn || rd == rt || Some(rd) == rt2))
    {
        return Some(unsupported(next));
    }
    atomic_transfer(
        &mut r,
        load,
        exclusive,
        ordered,
        rt,
        rt2,
        if !load && exclusive { Some(rd) } else { None },
        reg(rn, pc),
        width,
        pc,
        endian,
    );
    Some(r)
}
// The target ignores these IMPLEMENTATION DEFINED prefetch hints. Match the
// physical allocations, including their should-be bits, before ordinary loads.
// No address, shift/carry or memory input is needed for an ignored hint. None
// leaves neighboring instructions to their own builder; false retains the
// constrained/unpredictable operand exclusions even for raw-word callers.
fn preload_hint(word: u32, thumb: bool) -> Option<bool> {
    let rn = (word >> 16) & 15;
    let rm = word & 15;
    if !thumb {
        // PLD/PLDW immediate (A1), with PLD literal (A1) at Rn == PC.
        if word & 0xff30f000 == 0xf510f000 {
            return Some(rn != 15 || word & (1 << 22) != 0);
        }
        // PLI immediate (A1), including the aligned-PC literal address.
        if word & 0xff70f000 == 0xf450f000 {
            return Some(true);
        }
        // PLD/PLDW register (A1), including the distinct RRX aliases. PLD
        // permits a PC base; PLDW does not. Neither permits a PC offset.
        if word & 0xff30f010 == 0xf710f000 {
            return Some(rm != 15 && (rn != 15 || word & (1 << 22) != 0));
        }
        if word & 0xff70f010 == 0xf650f000 {
            return Some(rm != 15);
        }
    } else {
        // Resolve literal aliases first: their imm12 can look like a register
        // offset (including low bits == 15), but is not subject to Rm rules.
        if word & 0xff7ff000 == 0xf81ff000 // PLD literal (T1)
            || word & 0xff7ff000 == 0xf91ff000 // PLI immediate (T3)
        {
            return Some(true);
        }
        if word & 0xffd0f000 == 0xf890f000 // PLD/PLDW immediate (T1)
            || word & 0xffd0ff00 == 0xf810fc00 // PLD/PLDW immediate (T2)
            || word & 0xfff0f000 == 0xf990f000 // PLI immediate (T1)
            || word & 0xfff0ff00 == 0xf910fc00 // PLI immediate (T2)
        {
            return Some(rn != 15);
        }
        if word & 0xffd0ffc0 == 0xf810f000 // PLD/PLDW register (T1)
            || word & 0xfff0ffc0 == 0xf910f000 // PLI register (T1)
        {
            return Some(rn != 15 && rm != 15);
        }
    }
    None
}
pub fn for_word(word: u32, address: u64) -> Recipe {
    for_word_with_endian(word, address, Endian::Little)
}
pub fn for_word_with_endian(word: u32, address: u64, endian: Endian) -> Recipe {
    let next = (address as u32).wrapping_add(4) as u64;
    let pc = (address as u32).wrapping_add(8) as u64;
    let cc = word >> 28;
    let mut r = Recipe::new(next, 32);
    r.guard = condition(cc);
    if let Some(legal) = preload_hint(word, false) {
        return if legal { r } else { unsupported(next) };
    }
