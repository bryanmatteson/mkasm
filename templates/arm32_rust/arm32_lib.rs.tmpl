#[derive(Clone, Copy)]
struct Bits { lo: u8, width: u8 }
struct Check { bits: &'static [Bits], mask: u32, value: u32 }
struct Value { checks: &'static [Check], text: &'static str }
enum Transform { Plain, ArmImmediate, ThumbImmediate, PlusOne, BitfieldWidth, ShiftAmount, RightShift, NarrowShift, LeftShift, FractionBits, Successor, FloatImmediate, SimdImmediate }
struct Part { prefix: &'static str, symbol: &'static str, bits: &'static [Bits], values: &'static [Value], scale: u32, transform: Transform }
struct Form { id: &'static str, parts: &'static [Part], suffix: &'static str, width: usize, thumb: bool, wide: bool, mask: u32, value: u32 }
#[derive(Debug, Clone, Copy)]
pub struct EncodingInfo { pub id: &'static str, pub mode: Mode, pub length: usize, pub mask: u32, pub value: u32 }
pub fn encoding_count() -> usize { FORMS.len() }
pub fn encoding_info(index: usize) -> Option<EncodingInfo> {
    FORMS.get(index).map(|f| EncodingInfo { id:f.id, mode:if f.thumb {Mode::Thumb}else{Mode::Arm},length:f.width/8,mask:f.mask,value:f.value })
}
{{.FormIndices}}
static FORMS: &[Form] = &[
{{.Forms}}
];

fn extract(word: u32, parts: &[Bits]) -> u32 {
    let mut out = 0_u32;
    for p in parts { out = out.checked_shl(u32::from(p.width)).unwrap_or(0) | ((word >> p.lo) & (u32::MAX >> (32-p.width))); }
    out
}
fn condition_name(condition: u8) -> &'static str { ["eq","ne","hs","lo","mi","pl","vs","vc","hi","ls","ge","lt","gt","le","","nv"][usize::from(condition & 15)] }
fn thumb_immediate(value: u32) -> u32 {
    if value>>10 == 0 {
        let b = value & 255;
        match (value>>8)&3 { 0 => b, 1 => b<<16 | b, 2 => b<<24 | b<<8, _ => b*0x01010101 }
    } else { ((value&127)|128).rotate_right((value>>7)&31) }
}
fn simd_immediate(cmode: u32, op: u32, imm: u32) -> u64 {
    match cmode {
        0..=7 => u64::from(imm << (8*(cmode>>1))),
        8..=11 => u64::from(imm << (8*((cmode>>1)&1))),
        12 => u64::from(imm<<8 | 255), 13 => u64::from(imm<<16 | 65535),
        14 if op == 0 => u64::from(imm),
        14 => (0..8).fold(0,|v,i| v | if imm & (1<<i) != 0 { 255_u64<<(i*8) } else { 0 }),
        _ => u64::from(imm),
    }
}
fn float_immediate(imm: u32) -> f64 {
    let sign = if imm&128 != 0 { -1.0 } else { 1.0 };
    let exponent = if imm&64 != 0 { -3 } else { 1 } + ((imm>>4)&3) as i32;
    sign * (1.0 + f64::from(imm&15)/16.0) * 2_f64.powi(exponent)
}

// Braces in Arm's templates delimit optional syntax; register-list braces
// arrive as operand values and are never interpreted here.
struct OptionalGroups { entries:[(usize,bool); {{.OptionalGroups}}], len:usize }
impl OptionalGroups {
    fn new()->Self{Self{entries:[(0,false); {{.OptionalGroups}}],len:0}}
    fn is_empty(&self)->bool{self.len==0}
    fn last_mut(&mut self)->Option<&mut (usize,bool)>{self.len.checked_sub(1).map(|i|&mut self.entries[i])}
}
fn append_literal(text: &mut String, groups: &mut OptionalGroups, literal: &str) {
    for ch in literal.chars() {
        match ch {
            '{' => {groups.entries[groups.len]=(text.len(),false);groups.len+=1;},
            '}' => if groups.len!=0 {groups.len-=1;let(start,empty)=groups.entries[groups.len];if empty{text.truncate(start)}},
            _ => text.push(ch),
        }
    }
}

impl Decoded {
    fn value(&self, p: &Part) -> u32 {
        if matches!(p.transform,Transform::Successor) {return self.f("Rt")+1}
        if !p.bits.is_empty() { return extract(self.raw(),p.bits) }
        match p.symbol {
            "<Rd>" => (self.f("D")<<3) | self.f("Rd"),
            "<Rn>" => self.f("Rn"), "<Rm>" => self.f("Rm"), "<Rt>" => self.f("Rt"),
            "<Rdn>" => self.f("Rdn"), "<Rdm>" => self.f("Rdm"),
            "<Ra>" => self.f("Ra"), "<Rs>" => self.f("Rs"),
            "<Rt2>" => self.field("Rt2").unwrap_or_else(||self.f("Rt")+1),
            "<RdLo>" => self.f("RdLo"), "<RdHi>" => self.f("RdHi"),
            "<Dd>" | "<Ddm>" | "<Qd>" => self.f("D")<<4 | self.f("Vd"),
            "<Dn>" | "<Qn>" => self.f("N")<<4 | self.f("Vn"),
            "<Dm>" | "<Qm>" | "<Dm[x]>" => self.f("M")<<4 | self.f("Vm"),
            "<Sd>" | "<Sdm>" => self.f("Vd")<<1 | self.f("D"),
            "<Sm1>" => (self.f("Vm")<<1 | self.f("M"))+1,
            "<Sn>" => self.f("Vn")<<1 | self.f("N"), "<Sm>" => self.f("Vm")<<1 | self.f("M"),
            "<const>" => self.field("imm12").unwrap_or_else(||self.f("i")<<11 | self.f("imm3")<<8 | self.f("imm8")),
            "<imm>" | "<amount>" => self.field("imm12").or_else(||self.field("imm8")).or_else(||self.field("imm5")).or_else(||self.field("imm6")).or_else(||self.field("imm2")).or_else(||self.field("sat_imm")).unwrap_or_else(||self.f("imm3")<<2 | self.f("imm2")),
            "<size>" => 8<<self.f("size"), "<shift>" | "<type>" => self.field("stype").unwrap_or_else(||self.f("op")),
            "<lsb>" => self.field("lsb").unwrap_or_else(||self.f("imm3")<<2 | self.f("imm2")),
            "<width>" => self.field("widthm1").unwrap_or_else(||self.f("msb")),
            "<option>" => self.f("option"), "<align>" => self.f("align"),
            "<index>" => self.f("index_align")>>(self.f("size")+1),
            _ => self.f(p.symbol.trim_matches(['<','>'])),
        }
    }
    fn scalar_register(&self, p: &Part) -> Option<Register> {
        let class=match p.symbol {
            "SP"=>return Some(Register::Gpr(13)),
            "<Rd>"|"<Rn>"|"<Rm>"|"<Rt>"|"<Rt2>"|"<Rdn>"|"<Rdm>"|"<Ra>"|"<Rs>"|"<RdLo>"|"<RdHi>"=>0,
            "<Dd>"|"<Dn>"|"<Dm>"|"<Ddm>"|"<Dd[x]>"|"<Dn[x]>"|"<Dm[x]>"=>1,
            "<Qd>"|"<Qn>"|"<Qm>"=>2,
            "<Sd>"|"<Sn>"|"<Sm>"|"<Sdm>"|"<Sm1>"=>3,
            _=>return None,
        };
        if (p.symbol=="<Dm[x]>" || p.symbol=="<Dm>" && self.form().parts.iter().any(|p|p.symbol=="<index>")) && self.field("size").is_some() {return Some(Register::D((self.f("Vm")&if self.f("size")==1 {7}else{15}) as u8))}
        let n=self.value(p) as u8 & 31;
        Some(match class {0=>Register::Gpr(n),1=>Register::D(n),2=>Register::Q(n/2),_=>Register::S(n)})
    }
    fn element_size(&self) -> u32 {
        if self.mnemonic().starts_with("VSHLL") && self.field("size").is_some() {8<<self.f("size")}
        else if self.mnemonic().starts_with("VLD4") && self.encoding_id().contains("_a_") {8<<self.f("size").min(2)}
        else if self.field("B").is_some() { if self.f("B")!=0 {8} else if self.f("E")!=0 {16} else {32} }
        else if self.field("opc1").is_some() { if self.f("opc1")&2!=0 {8} else if self.f("opc2")&1!=0 {16} else {32} }
        else if self.field("imm4").is_some() {8<<self.f("imm4").trailing_zeros().min(2)}
        else {8<<self.f("size").min(3)}
    }
    fn lane_index(&self) -> u32 {
        if self.field("opc1").is_some() { match self.element_size() {8=>(self.f("opc1")&1)<<2|self.f("opc2"),16=>(self.f("opc1")&1)<<1|self.f("opc2")>>1,_=>self.f("opc1")&1} }
        else if self.field("index_align").is_some() {self.f("index_align")>>(self.f("size")+1)}
        else if self.field("imm4").is_some() {self.f("imm4")>>(self.f("imm4").trailing_zeros().min(2)+1)}
        else if self.field("size")==Some(1) {self.f("M")<<1|self.f("Vm")>>3}
        else {self.f("M")}
    }
    fn register_mask(&self,p:&Part)->Option<u32> {
        if !p.symbol.contains("registers"){return None}
        let mut mask=self.field("register_list").or_else(||self.field("registers"))?;
        if p.symbol=="<registers_with_pc>"{mask|=1<<15}
        if self.mode==Mode::Thumb {
            if self.length==2 && self.raw()&0xf600==0xb400{mask|=self.f("M")<<14|self.f("P")<<15}
            else if self.length==4{mask|=self.raw()&0xc000}
        }
        Some(mask&0xffff)
    }
    fn shift_amount(&self)->Option<u32> {
        self.field("imm5").or_else(||self.field("imm3").zip(self.field("imm2")).map(|(hi,lo)|hi<<2|lo))
    }
    fn writeback(&self)->bool {
        if self.encoding_id()=="LDM_T1"{self.f("register_list")&(1<<self.f("Rn"))==0}else{self.f("W")!=0}
    }
    fn alignment_bits(&self)->Option<u32> {
        if let Some(align)=self.field("align"){return if align==0{None}else{Some(32<<align)}}
        let n=self.mnemonic().as_bytes().get(3).filter(|b|b.is_ascii_digit()).map_or(1,|b|u32::from(*b-b'0'));
        let size=self.element_size();
        if let Some(index)=self.field("index_align") {
            let raw=index&if size==32{3}else{1};
            return if raw==0{None}else{Some(if n==4&&size==32{raw*64}else{n*size})}
        }
        if self.field("a")==Some(1){return Some(if n==4&&self.f("size")>=2{64<<(self.f("size")&1)}else{n*size})}
        None
    }
    fn register_sequence(&self,p:&Part)->Option<(Register,u32,u32)> {
        let sym=p.symbol;
        if !matches!(sym,"<list>"|"<dreglist>"|"<sreglist>"){return None}
        let mnemonic=self.mnemonic();
        let table=mnemonic.starts_with("VTBL")||mnemonic.starts_with("VTBX");
        let count=if sym=="<sreglist>"{self.f("imm8")}else if sym=="<dreglist>"{self.f("imm8")/2}
            else if table{self.f("len")+1}
            else if mnemonic.starts_with("VLD1")||mnemonic.starts_with("VST1"){
                if self.field("itype").is_some(){match self.f("itype"){7=>1,10=>2,6=>3,2=>4,_=>1}}
                else if self.encoding_id().contains("_a_"){self.f("T")+1}else{1}
            }else if (mnemonic.starts_with("VLD2")||mnemonic.starts_with("VST2")) && self.field("itype")==Some(3){4}
            else{mnemonic.as_bytes().get(3).filter(|b|b.is_ascii_digit()).map_or(1,|b|u32::from(*b-b'0'))};
        let stride=if sym=="<list>" && self.encoding_id().contains("_a_") && !mnemonic.starts_with("VLD1"){self.f("T")+1}
            else if sym=="<list>" && ((self.field("itype").is_some() && self.f("itype")&1!=0 && self.f("itype")!=3 && !mnemonic.starts_with("VLD1") && !mnemonic.starts_with("VST1")) || (self.field("index_align").is_some() && self.f("size")!=0 && self.f("index_align")&(1<<self.f("size"))!=0)){2}else{1};
        let first=if sym=="<sreglist>"{Register::S((self.f("Vd")<<1|self.f("D")) as u8)}
            else{Register::D((if table{self.f("N")<<4|self.f("Vn")}else{self.f("D")<<4|self.f("Vd")}) as u8)};
        Some((first,count,stride))
    }
    fn register_iter(&self, p: &Part) -> Option<impl Iterator<Item=Register>> {
        let sym = p.symbol;
        let (mut mask,start,count,stride,class) = if let Some(mask)=self.register_mask(p) {
            (mask&0xffff,0,(mask&0xffff).count_ones(),0,0)
        } else if sym == "<single_register_list>" { (0,self.f("Rt"),1,1,3) }
        else if let Some((first,count,stride))=self.register_sequence(p) {
            match first{Register::S(n)=>(0,u32::from(n),count,stride,1),Register::D(n)=>(0,u32::from(n),count,stride,2),_=>return None}
        } else {return None};
        // Preserve the exact size hint so details can allocate each list once.
        Some((0..count).map(move|index| {
            if class==0 {
                let n=mask.trailing_zeros();mask&=mask-1;return Register::Gpr(n as u8)
            }
            let n=(start+index*stride) as u8;
            match class {1=>Register::S(n),2=>Register::D(n),_=>Register::Gpr(n)}
        }))
    }

    fn registers(&self,p:&Part)->Option<Vec<Register>> {self.register_iter(p).map(Iterator::collect)}
    fn text_value(&self,p:&Part,address:u64)->Result<String,FormatError> {
        let mut output=String::new();self.text_value_into(p,address,&mut output)?;Ok(output)
    }
    fn text_value_into(&self, p: &Part, address: u64, output:&mut String) -> Result<(), FormatError> {
        let error = || FormatError { encoding: self.encoding_id(), symbol: p.symbol };
        macro_rules! emit {($($arg:tt)*)=>{ {let _=write!(output,$($arg)*);return Ok(())} }}
        macro_rules! dec {($value:expr)=>{ {let _=number_text::unsigned(output,($value) as u64);return Ok(())} }}
        macro_rules! hex {($value:expr)=>{ {let _=number_text::hex(output,($value) as u64);return Ok(())} }}
        macro_rules! push {($text:expr)=>{ {output.push_str($text);return Ok(())} }}
        if p.symbol=="<Rt>" && self.mnemonic().starts_with("VMRS") && self.value(p)==15 && self.f("reg")==1 {push!("apsr_nzcv")}
        if p.symbol=="<Rt>" && self.mnemonic().starts_with("MRC") && self.value(p)==15 {push!("apsr_nzcv")}
        if let Some(r)=self.scalar_register(p) {
            if !r.valid() || p.symbol.starts_with("<Q") && self.value(p)&1!=0 {return Err(error())}
            r.write_name(output);if p.symbol.contains("[x]"){output.push('[');let _=number_text::unsigned(output,u64::from(self.lane_index()));output.push(']');}return Ok(())
        }
        if let Some(rs)=self.register_iter(p) {
            output.push('{');let mut first=true;
            for r in rs {
                if !r.valid(){return Err(error())}
                if !first{output.push_str(", ")}first=false;r.write_name(output);
                if p.symbol=="<list>" && self.field("index_align").is_some(){output.push('[');let _=number_text::unsigned(output,u64::from(self.lane_index()));output.push(']');}
                else if p.symbol=="<list>" && self.encoding_id().contains("_a_"){output.push_str("[]")}
            }
            if first{return Err(error())}output.push('}');return Ok(())
        }
        if p.symbol=="<size>" && self.field("imm4").is_some() {dec!(self.element_size())}
        if p.symbol=="<size>" && p.values.is_empty() && self.field("imm6").is_some() {dec!(1u32<< (31-self.f("imm6").max(1).leading_zeros()))}
        if p.symbol=="<index>" && self.field("size").is_some() {dec!(self.lane_index())}
        if p.symbol=="<type>" && self.mnemonic().starts_with("VQSHLU") {push!("s")}
        if p.symbol=="<spec_reg>" && self.mnemonic().starts_with("MSR") {
            let mask=self.f("mask");output.push_str(if self.f("R")==0 {"cpsr_"}else{"spsr_"});
            for (bit,name) in [(1,"c"),(2,"x"),(4,"s"),(8,"f")] {if mask&bit!=0{output.push_str(name)}}return Ok(())
        }
        if let Some(row)=p.values.iter().find(|row|row.checks.iter().all(|c|extract(self.raw(),c.bits)&c.mask==c.value)) {
            if matches!(row.text,"reserved"|"unallocated"|"undefined"|"unpredictable") {if p.symbol=="<option>"{output.push('#');dec!(self.value(p))}return Err(error())}
            if row.text=="[absent]"{return Ok(())}
            let start=output.len();
            if row.text=="[present]" {output.push_str(p.symbol);output[start..].make_ascii_lowercase();}
            else {
                // Both replacements shorten the borrowed table spelling.
                for (i,piece) in row.text.split("cpsr|apsr").enumerate() {
                    if i!=0{output.push_str("cpsr")}
                    for (j,part) in piece.split("<type>").enumerate() {if j!=0{output.push_str(if self.f("U")==0{"s"}else{"u"})}output.push_str(part)}
                }
            }
            return Ok(())
        }
        let mut value=self.value(p);
        match p.symbol {
            "<q>"=>push!(if self.mode==Mode::Thumb&&self.length==4&&self.form().wide{".w"}else{""}),
            "+"=>return Ok(()),
            "<c>"=>push!(condition_name(self.condition())),
            "<cond>"=>push!(condition_name(self.f("firstcond") as u8)),
            "+/-"=>push!(if self.f("U")!=0{""}else{"-"}),
            "!"=>push!(if self.writeback(){"!"}else{""}),
            "IA"=>push!("ia"),".32"|".64"=>push!(if p.prefix.ends_with('.') {&p.symbol[1..]}else{p.symbol}),
            "<label>"=>{
                if let Some(target)=self.branch_target(address){output.push('#');hex!(target)}
                let imm=if p.bits.is_empty(){self.field("imm12").unwrap_or(self.f("i")<<11|self.f("imm3")<<8|self.f("imm8"))}else{value};
                if self.mnemonic().starts_with("ADR") {
                    let imm=if self.mode==Mode::Arm{(imm&255).rotate_right(((imm>>8)&15)*2)}else if self.length==2{imm*4}else{imm};
                    let add=!matches!(self.encoding_id(),"ADR_A2"|"ADR_T2");
                    let pc=(address as u32).wrapping_add(if self.mode==Mode::Arm{8}else{4})&!3;
                    output.push('#');hex!(if add{pc.wrapping_add(imm)}else{pc.wrapping_sub(imm)})
                }
                let offset=if self.mode==Mode::Thumb&&self.length==2{imm*4}else{imm*p.scale};
                output.push_str("[pc, #");if self.field("U").unwrap_or(1)==0{output.push('-')}let _=number_text::unsigned(output,u64::from(offset));output.push(']');return Ok(())
            }
            "<shift>" if self.shift_amount().is_some()=>{
                let kind=self.f("stype");let n=self.shift_amount().unwrap_or(0);
                match (kind,n){(0,0)=>return Ok(()),(3,0)=>push!("rrx"),_=>{output.push_str(["lsl","lsr","asr","ror"][kind as usize]);output.push_str(" #");dec!(if n==0{32}else{n})}}
            }
            "<shift>"|"<type>" if self.field("stype").is_some()||!self.mnemonic().starts_with('V')=>push!(["lsl","lsr","asr","ror"][(value&3) as usize]),
            "<iflags>"=>{if self.f("A")!=0{output.push('a')}if self.f("I")!=0{output.push('i')}if self.f("F")!=0{output.push('f')}return Ok(())},
            "<endian_specifier>"=>push!(if self.f("E")==0{"le"}else{"be"}),
            "<spec_reg>"=>push!(if self.f("R")==0{"apsr"}else{"spsr"}),
            "<option>" if ["DMB","DSB","ISB"].iter().any(|name|self.mnemonic().starts_with(name))=>push!(match value{15=>"sy",14=>"st",11=>"ish",10=>"ishst",7=>"nsh",6=>"nshst",3=>"osh",2=>"oshst",_=>{output.push('#');dec!(value)}}),
            "<option>"=>dec!(value),
            "<coproc>"=>{output.push('p');dec!(value)},"<CRn>"|"<CRm>"=>{output.push('c');dec!(value)},
            "<size>" if self.field("B").is_some()||self.field("opc1").is_some()=>dec!(self.element_size()),
            "<type>" if self.mnemonic().starts_with('V')=>push!(if self.mnemonic().starts_with("VSHLL")&&self.field("size").is_some(){"i"}else if self.f("U")==0||self.mnemonic().starts_with("VQSHLU")||self.mnemonic().starts_with("VQSHRUN")||self.mnemonic().starts_with("VQRSHRUN"){"s"}else{"u"}),
            "<dt>" if self.field("opc1").is_some()=>{if self.element_size()==32{push!("32")}output.push(if self.f("U")==0{'s'}else{'u'});dec!(self.element_size())}
            "<align>"=>{if let Some(bits)=self.alignment_bits(){dec!(bits)}return Ok(())}
            "<size>" if p.bits.is_empty()=>{value=if self.mnemonic().starts_with("VSHLL"){8<<self.f("size")}else if self.field("imm4").is_some(){8<<self.f("imm4").trailing_zeros().min(2)}else if self.field("B").is_some(){if self.f("B")!=0{8}else if self.f("E")!=0{16}else{32}}else if self.field("opc1").is_some(){if self.f("opc1")&2!=0{8}else if self.f("opc2")&1!=0{16}else{32}}else if self.encoding_id().contains("Double")||self.field("sz")==Some(1){64}else{32}}
            "<dt>" if p.bits.is_empty()=>return Ok(()),
            "<amode>"=>push!(match(self.f("P"),self.f("U")){(0,1)=>"ia",(1,1)=>"ib",(0,0)=>"da",_=>"db"}),
            "<x>"|"<y>"|"<z>"=>push!("t"),_=>(),
        }
        match p.transform {
            Transform::FloatImmediate=>emit!("{:.8}",float_immediate(self.f("imm4H")<<4|self.f("imm4L"))),
            Transform::SimdImmediate=>{if self.f("cmode")==15&&self.f("op")==0{emit!("{:.8}",float_immediate(self.f("i")<<7|self.f("imm3")<<4|self.f("imm4")))}hex!(simd_immediate(self.f("cmode"),self.f("op"),self.f("i")<<7|self.f("imm3")<<4|self.f("imm4")))}
            _=>(),
        }
        value=self.analysis_integer(p,value).ok_or_else(error)?;
        if matches!(p.symbol,"<dt>"|"<dt1>"|"<dt2>"|"<banked_reg>"){return Err(error())}
        dec!(value)
    }
    fn render(&self,address:u64)->Result<(String,Details),FormatError> {
        let mut text=String::with_capacity(64);let details=self.project::<true>(address,true,&mut text)?;Ok((text,details))
    }
    fn validate_part(&self,p:&Part)->Result<(),FormatError>{
        let error=||FormatError{encoding:self.encoding_id(),symbol:p.symbol};
        if let Some(r)=self.scalar_register(p){return if !r.valid()||p.symbol.starts_with("<Q")&&self.value(p)&1!=0{Err(error())}else{Ok(())}}
        if let Some(rs)=self.registers(p){return if rs.is_empty()||rs.iter().any(|r|!r.valid()){Err(error())}else{Ok(())}}
        if let Some(row)=p.values.iter().find(|row|row.checks.iter().all(|c|extract(self.raw(),c.bits)&c.mask==c.value)) {
            return if matches!(row.text,"reserved"|"unallocated"|"undefined"|"unpredictable")&&p.symbol!="<option>"{Err(error())}else{Ok(())}
        }
        if p.symbol=="<dt>" && self.field("opc1").is_some(){return Ok(())}
        if matches!(p.symbol,"<dt1>"|"<dt2>"|"<banked_reg>")||p.symbol=="<dt>"&&!p.bits.is_empty(){return Err(error())}
        Ok(())
    }
    fn project<const DETAILS:bool>(&self, address: u64, render_text:bool, text:&mut String) -> Result<Details, FormatError> {
        let form = self.form();
        let mut groups=OptionalGroups::new();
        let mut operands: Vec<Operand> = Vec::new();
        let mut roles=Vec::new();
        let mut memory: Option<Memory> = None;
        let mut details = Details { operands: Vec::new(), condition: if DETAILS {self.condition()} else {14}, update_flags: DETAILS && self.update_flags(), reads: Vec::new(), writes: Vec::new(), writeback: DETAILS && self.writeback() };
        let mut shift_kind = 0;
        for (index,p) in form.parts.iter().enumerate() {
            let prefix = p.prefix;
            // A post-index operand follows the closing bracket and is not
            // part of the address used for the memory access.
            if DETAILS && prefix.contains(']') {
                if let Some(m)=memory.take() {
                    operands.push(Operand{kind:OperandKind::Memory(m),access:Access::Read,shift:Shift::None,lane:None});roles.push("memory");
                    details.writeback |= prefix.contains(',');
                }
            }
            if DETAILS && prefix.contains('[') && (p.symbol=="<Rn>" || prefix.contains("SP") || prefix.contains("PC")) {
                memory = Some(Memory {base: Register::Gpr(if prefix.contains("PC") || prefix.contains("pc") {15} else {13}), index: None, displacement:0, subtract:self.field("U")==Some(0),shift:Shift::None});
            }
            let duplicate=prefix.ends_with('{') && form.parts.get(index+1).is_some_and(|next| next.symbol==p.symbol && next.prefix.contains('}') && next.prefix.chars().all(|c|c.is_ascii_whitespace()||matches!(c,','|'}')));
            let scalar=if DETAILS {analysis::value(self,p,address)} else {analysis::Value::Unknown};
            if render_text {
                append_literal(text,&mut groups,prefix);
                let start=text.len();
                if !duplicate{self.text_value_into(p,address,text)?;}
                if !groups.is_empty() && &text[start..]=="0" && self.field("U")!=Some(0) && (p.symbol.starts_with("<imm") || p.symbol=="<amount>"){text.truncate(start);}
                if text[..start].ends_with('#') && text[start..].starts_with('#'){text.remove(start);}
                if text.len()==start{if let Some(group)=groups.last_mut(){group.1=true}}
            }else if !duplicate{self.validate_part(p)?;}
            if duplicate || !DETAILS {continue}
            if memory.is_none() {
                for literal in prefix.split(|c:char| !c.is_ascii_alphabetic()).filter_map(|word|match word {"SP"=>Some(Register::Gpr(13)),"LR"=>Some(Register::Gpr(14)),"PC"=>Some(Register::Gpr(15)),_=>None}) {
                    operands.push(Operand{kind:OperandKind::Register(literal),access:Access::Read,shift:Shift::None,lane:None});
                    roles.push("literal");
                }
            }
            let before=operands.len();
            if let Some(r) = self.scalar_register(p) {
                if let Some(m) = &mut memory {
                    if p.symbol=="<Rn>" {m.base=r} else if p.symbol=="<Rm>" {m.index=Some(r)}
                } else {
                    if p.symbol=="<Rs>" && form.parts.iter().any(|p|p.symbol=="<shift>") {
                        if let Some(last)=operands.last_mut() {last.shift=match shift_kind {0=>Shift::LslReg(r),1=>Shift::LsrReg(r),2=>Shift::AsrReg(r),_=>Shift::RorReg(r)}}
                    }
                    let kind=if p.symbol=="<Rt>" && self.mnemonic().starts_with("VMRS") && r==Register::Gpr(15) && self.f("reg")==1 {OperandKind::SystemRegister(Register::Apsr)}else{OperandKind::Register(r)};
                    operands.push(Operand {kind, access:Access::Read, shift:Shift::None,lane:if p.symbol.contains("[x]") {Some(self.lane_index())}else{None}});
                }
            } else if let Some(rs) = self.registers(p) {
                for r in rs { operands.push(Operand {kind:OperandKind::Register(r),access:Access::Read,shift:Shift::None,lane:if self.field("index_align").is_some() && p.symbol=="<list>" {Some(self.f("index_align")>>(self.f("size")+1))}else{None}}); }
            } else if p.symbol=="<shift>" || p.symbol=="<type>" && self.field("stype").is_some() {
                shift_kind = self.field("stype").unwrap_or(self.value(p));
                if p.symbol=="<shift>" && self.shift_amount().is_some() {
                    let n=self.shift_amount().unwrap_or(0);let shift=match (shift_kind,n) {(0,0)=>Shift::None,(0,n)=>Shift::Lsl(n),(1,n)=>Shift::Lsr(if n==0 {32}else{n}),(2,n)=>Shift::Asr(if n==0 {32}else{n}),(3,0)=>Shift::Rrx,(_,n)=>Shift::Ror(n)};
                    if let Some(m)=&mut memory {m.shift=shift}else if let Some(last)=operands.last_mut() {last.shift=shift}
                }
            } else if p.symbol=="<amount>" || p.symbol=="<imm>" && (self.encoding_id().contains("_r_") || self.encoding_id().contains("_rr_")) && self.field("stype").is_some() {
                let n=if let analysis::Value::Integer(n)=scalar{n as u32}else{0};
                // Extend forms (SXTB/UXTH/SXTAB...) encode a rotation, not a shift.
                let shift=if self.field("rotate").is_some() {if n==0 {Shift::None} else {Shift::Ror(n)}} else {match shift_kind {0=>Shift::Lsl(n),1=>Shift::Lsr(n),2=>Shift::Asr(n),_ if n==0=>Shift::Rrx,_=>Shift::Ror(n)}};
                if let Some(m)=&mut memory {m.shift=shift} else if let Some(last)=operands.last_mut() {last.shift=shift}
            } else if p.symbol=="<index>" {
                if let Some(last)=operands.last_mut() {last.lane=Some(self.lane_index())}
            } else if p.symbol=="<label>" {
                if let Some(target)=self.branch_target(address){operands.push(Operand{kind:OperandKind::Immediate(i64::from(target)),access:Access::Read,shift:Shift::None,lane:None})}
                else if self.mnemonic().starts_with("ADR"){if let analysis::Value::Target(target)=scalar{operands.push(Operand{kind:OperandKind::Immediate(i64::from(target)),access:Access::Read,shift:Shift::None,lane:None})}}
                else {let raw=self.value(p);let displacement=if self.mode==Mode::Thumb && self.length==2{raw*4}else{raw*p.scale};operands.push(Operand{kind:OperandKind::Memory(Memory{base:Register::Gpr(15),index:None,displacement:displacement as i32,subtract:self.field("U")==Some(0),shift:Shift::None}),access:Access::Read,shift:Shift::None,lane:None})}
            } else if p.symbol.starts_with("<imm") || matches!(p.symbol,"<const>"|"<width>"|"<lsb>"|"<fbits>") {
                match scalar {
                    analysis::Value::Integer(n)=>if let Some(m)=&mut memory{m.displacement=n as i32}else{operands.push(Operand{kind:OperandKind::Immediate(n),access:Access::Read,shift:Shift::None,lane:None})},
                    analysis::Value::Float(n)=>operands.push(Operand{kind:OperandKind::FloatingPoint(n),access:Access::Read,shift:Shift::None,lane:None}),_=>{}
                }
            } else if p.symbol=="<spec_reg>" {
                let register=if self.mnemonic().starts_with("MSR"){Some(if self.f("R")==0{Register::Cpsr}else{Register::Spsr})}
                    else if let analysis::Value::Symbol(s)=scalar{match s.split('_').next().unwrap_or(""){s if s.eq_ignore_ascii_case("cpsr")=>Some(Register::Cpsr),s if s.eq_ignore_ascii_case("apsr")=>Some(Register::Apsr),s if s.eq_ignore_ascii_case("spsr")=>Some(Register::Spsr),s if s.eq_ignore_ascii_case("fpscr")=>Some(Register::Fpscr),_=>None}}
                    else {Some(if self.f("R")==0{Register::Apsr}else{Register::Spsr})};
                operands.push(Operand{kind:register.map_or(OperandKind::Other,OperandKind::SystemRegister),access:Access::Read,shift:Shift::None,lane:None})
            }
            roles.extend(std::iter::repeat_n(p.symbol,operands.len()-before));
            if p.symbol=="!" && self.writeback() {details.writeback=true}
        }
        if render_text{append_literal(text,&mut groups,form.suffix);}
        if let Some(m)=memory.take() {operands.push(Operand{kind:OperandKind::Memory(m),access:Access::Read,shift:Shift::None,lane:None});roles.push("memory")}
        if render_text {
        // No-symbol instructions retain their literal syntax.
        if text.trim().is_empty() {text.clear();text.push_str(self.mnemonic())}
        *text=normalize_text(std::mem::take(text));
        if self.encoding_id()=="MOV_i_A2" || self.encoding_id()=="MOV_i_T3" {if let Some(index)=text.find("mov"){text.insert(index+3,'w')}}
        if matches!(self.encoding_id(),"ADD_i_T4"|"ADD_SP_i_T4"|"SUB_i_T4"|"SUB_SP_i_T3") {text.insert(3,'w')}
        if self.encoding_id().starts_with("IT_") {
            let mask=self.f("mask"); let first=self.f("firstcond");
            text.clear();text.push_str("it");
            for bit in ((mask.trailing_zeros()+1)..4).rev() {text.push(if (mask>>bit)&1==first&1 {'t'}else{'e'})}
            text.push(' ');text.push_str(condition_name(first as u8));
        }
        }
        if !DETAILS {return Ok(details);}
        let name=SemanticName(self.mnemonic());
        details.writeback |= form.suffix.contains('!') || form.parts.iter().any(|p|p.prefix.contains('!'));
        let store=name.starts_with("str")||name.starts_with("stl")||name.starts_with("stm")||name.starts_with("push")||name.starts_with("vpush")||name.starts_with("vst")||name.starts_with("stc")||name.starts_with("fstm");
        let load_multiple=name.starts_with("ldm")||name.starts_with("pop")||name.starts_with("vld")||name.starts_with("vpop");
        let stack=name.starts_with("push")||name.starts_with("pop")||name.starts_with("vpush")||name.starts_with("vpop");
        if stack {details.writeback=true}
        if (stack||load_multiple||name.starts_with("stm")||name.starts_with("vstm")) && !operands.iter().any(|op|matches!(op.kind,OperandKind::Memory(_))) {
            let base=if stack {Register::Gpr(13)}else{Register::Gpr(self.f("Rn") as u8)};
            operands.push(Operand{kind:OperandKind::Memory(Memory{base,index:None,displacement:0,subtract:false,shift:Shift::None}),access:Access::Read,shift:Shift::None,lane:None});roles.push("memory");
        }
        let compare=name.starts_with("cmp")||name.starts_with("cmn")||name.starts_with("tst")||name.starts_with("teq")||self.encoding_id().starts_with("B_")||self.encoding_id().starts_with("BL_")||name.is("bx")||name.starts_with("blx")||name.starts_with("cb")||name.starts_with("vcm")||name.starts_with("mcr");
        for (i,op) in operands.iter_mut().enumerate() {
            let role=roles[i];
            op.access=match op.kind {
                OperandKind::Memory(_) if name.starts_with("swp")=>Access::ReadWrite,
                OperandKind::Memory(_) if store=>Access::Write,
                OperandKind::Memory(_)=>Access::Read,
                OperandKind::Register(_) if role=="<Rn>" && (load_multiple||store)=>if details.writeback {Access::ReadWrite}else{Access::Read},
                OperandKind::Register(_) if load_multiple && role!="<Rm>"=>Access::Write,
                OperandKind::Register(_) if role=="<Rd>" && (name.starts_with("strex")||name.starts_with("stlex"))=>Access::Write,
                OperandKind::Register(_) if ["vtrn","vzip","vuzp","vswp"].iter().any(|prefix|name.starts_with(prefix))=>Access::ReadWrite,
                OperandKind::Register(_) if !store&&!compare && (i==0 || matches!(role,"<Rt2>"|"<RdLo>"|"<RdHi>"|"<Sm1>"))=>if op.lane.is_some() || matches!(role,"<Rdn>"|"<Rdm>"|"<Ddm>"|"<Sdm>") || form.parts.iter().filter(|p|p.symbol==role).count()>1 || ["vmla","vmls","vaba","vfma","vfms","vqdmla","vqdmls","vqrdmla","vqrdmls","vsdot","vudot","vusdot","vsmmla","vummla","vusmmla","vpadal","umlal","smlal","umaal","bfi"].iter().any(|prefix|name.starts_with(prefix)) || ["vbit","vbif","vbsl"].iter().any(|s|name.is(s)) {Access::ReadWrite}else{Access::Write},
                OperandKind::SystemRegister(_) if name.starts_with("msr")||name.starts_with("vmsr")||name.starts_with("vmrs")&&i==0=>Access::Write,
                _=>Access::Read
            };
            if let OperandKind::Register(r)|OperandKind::SystemRegister(r)=op.kind {
                if op.access.is_readable()&&!details.reads.contains(&r) {details.reads.push(r)}
                if op.access.is_writable()&&!details.writes.contains(&r) {details.writes.push(r)}
            }
            if let OperandKind::Memory(m)=op.kind {details.reads.push(m.base);if let Some(r)=m.index {details.reads.push(r)};if details.writeback {details.writes.push(m.base)}}
        }
        if self.update_flags() {details.writes.push(Register::Apsr)}
        if name.starts_with("v") && !name.starts_with("vmrs") && !name.starts_with("vmsr") {details.reads.push(Register::Fpscr);details.writes.push(Register::Fpscr)}
        if name.starts_with("bl") {details.writes.push(Register::Gpr(14))}
        details.operands=operands;
        Ok(details)
    }
}


// Architectural spellings are ASCII. Retain the owned allocation while
// lowercasing, collapsing whitespace and closing punctuation in one pass.
fn normalize_text(mut text:String)->String {
    if !text.is_ascii() {
        let mut index=0;
        while index<text.len() {
            let ch=text[index..].chars().next().unwrap();let width=ch.len_utf8();
            if ch.is_whitespace() && !ch.is_ascii(){text.replace_range(index..index+width," ");index+=1;}else{index+=width;}
        }
    }
    let mut bytes=text.into_bytes();let mut written=0;let mut space=false;
    for read in 0..bytes.len() {
        let byte=bytes[read];
        if byte.is_ascii_whitespace() || byte==0x0b {space=true;continue;}
        if space && written!=0 && !matches!(byte,b']'|b',') {bytes[written]=b' ';written+=1;}
        space=false;bytes[written]=byte.to_ascii_lowercase();written+=1;
    }
    bytes.truncate(written);
    String::from_utf8(bytes).expect("ASCII normalization preserves UTF-8")
}

struct SemanticName(&'static str);
impl SemanticName {
    fn starts_with(&self,prefix:&str)->bool{self.0.get(..prefix.len()).is_some_and(|s|s.eq_ignore_ascii_case(prefix))}
    fn is(&self,name:&str)->bool{self.0.split(['{','<','.',' ']).next().is_some_and(|s|s.eq_ignore_ascii_case(name))}
}

/// Encode exact fields and serialize using instruction-state-aware byte order.
pub fn encode(encoding_id: &str, fields: &[(&str,u64)], endian: Endian) -> Result<Vec<u8>, encoders::EncodeError> {
    let word=encoders::encode_with_fields(encoding_id,fields)?;
    let form=&FORMS[FORMS.binary_search_by_key(&encoding_id,|f|f.id).map_err(|_|encoders::EncodeError::UnknownEncoding(encoding_id.into()))?];
    let half=|v:u16|match endian {Endian::Little=>v.to_le_bytes(),Endian::Big=>v.to_be_bytes()};
    Ok(if form.width==16 {half(word as u16).to_vec()} else if form.thumb {[half((word>>16) as u16),half(word as u16)].concat()} else {match endian {Endian::Little=>word.to_le_bytes(),Endian::Big=>word.to_be_bytes()}.to_vec()})
}

#[cfg(test)]
mod form_index_tests {
    use super::*;
    #[test]
    fn text_only_matches_combined_presentation_in_all_instruction_banks() {
        let check = |d:Decoded| {
            assert_eq!(d.format(0x1234), d.presentation(0x1234).map(|pair| pair.0), "{}", d.encoding_id());
        };
        for i in 0..a32::catalog_entry_count() {
            let entry=a32::catalog_entry(i).unwrap();
            for word in [entry.value,entry.value|!entry.mask] {
                if let Ok(d)=a32::decode(word) {check(Decoded{encoding:Encoding::Arm(d),mode:Mode::Arm,length:4});}
            }
        }
        for i in 0..t16::catalog_entry_count() {
            let entry=t16::catalog_entry(i).unwrap();
            for word in [entry.value,(entry.value|!entry.mask)&0xffff] {
                if let Ok(d)=t16::decode(word) {check(Decoded{encoding:Encoding::Thumb16(d),mode:Mode::Thumb,length:2});}
            }
        }
        for i in 0..t32::catalog_entry_count() {
            let entry=t32::catalog_entry(i).unwrap();
            for word in [entry.value,entry.value|!entry.mask] {
                if let Ok(d)=t32::decode(word) {check(Decoded{encoding:Encoding::Thumb32(d),mode:Mode::Thumb,length:4});}
            }
        }
    }
    #[test]
    fn in_place_normalization_preserves_text_rules() {
        let tokens=["a","B"," ","\t","\n","\x0b","[","]",",","#","İ","é","\u{a0}"];
        let mut state=0x815d_42e1_u32;
        for _ in 0..2048 {
            let mut input=String::new();
            for _ in 0..16 {
                state=state.wrapping_mul(1664525).wrapping_add(1013904223);
                input.push_str(tokens[(state as usize)%tokens.len()]);
            }
            let expected=input.to_ascii_lowercase().split_whitespace().collect::<Vec<_>>().join(" ").replace(" ]","]").replace(" ,",",");
            assert_eq!(normalize_text(input),expected);
        }
    }
    #[test]
    fn decoder_ordinals_reopen_the_same_print_forms() {
        assert_eq!(A32_FORM_INDICES.len(), a32::catalog_entry_count());
        for (i, &index) in A32_FORM_INDICES.iter().enumerate() {
            assert_eq!(FORMS[index as usize].id, a32::catalog_entry(i).unwrap().encoding_id);
        }
        assert_eq!(T16_FORM_INDICES.len(), t16::catalog_entry_count());
        for (i, &index) in T16_FORM_INDICES.iter().enumerate() {
            assert_eq!(FORMS[index as usize].id, t16::catalog_entry(i).unwrap().encoding_id);
        }
        assert_eq!(T32_FORM_INDICES.len(), t32::catalog_entry_count());
        for (i, &index) in T32_FORM_INDICES.iter().enumerate() {
            assert_eq!(FORMS[index as usize].id, t32::catalog_entry(i).unwrap().encoding_id);
        }
    }
}

