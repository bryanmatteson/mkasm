#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn architectural_halfword_order_and_signed_targets() {
        for (b,mode,target) in [(&[0x02,0,0,0xeb][..],Mode::Arm,0x1010),(&[0,0xf0,0,0xf8][..],Mode::Thumb,0x1004),(&[0xff,0xf7,0xfc,0xff][..],Mode::Thumb,0xffc)] {
            let d=decode(b,mode,Endian::Little).unwrap();assert_eq!(d.branch_target(0x1000),Some(target));
            let all_fields:Vec<(&str,u64)>=match &d.encoding {Encoding::Arm(v)=>v.fields.iter().collect(),Encoding::Thumb16(v)=>v.fields.iter().collect(),Encoding::Thumb32(v)=>v.fields.iter().collect()};
            let fields:Vec<_>=all_fields.into_iter().filter(|(name,value)| encoders::encode_with_fields(d.encoding_id(),&[(*name,*value)]).is_ok()).collect();
            assert_eq!(encode(d.encoding_id(),&fields,Endian::Little).unwrap(),b);
            let big=encode(d.encoding_id(),&fields,Endian::Big).unwrap();let be=decode(&big,mode,Endian::Big).unwrap();assert_eq!(be.raw(),d.raw());
        }
        assert_eq!(decode(&[0,0xf0],Mode::Thumb,Endian::Little).unwrap_err(),DecodeError::Truncated);
        assert_eq!(decode(&[0,0xbf],Mode::Thumb,Endian::Little).unwrap().format(0).unwrap(),"nop");
    }
    #[test]
