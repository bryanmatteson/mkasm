#[cfg(test)]
mod format_reuse_tests {
    use super::*;
    use std::alloc::{GlobalAlloc,Layout,System};
    use std::cell::Cell;
    struct CountingAllocator;
    thread_local!{static CALLS:Cell<Option<usize>>=const{Cell::new(None)};}
    fn count_allocation(){let _=CALLS.try_with(|count|{if let Some(n)=count.get(){count.set(Some(n+1))}});}
    unsafe impl GlobalAlloc for CountingAllocator {
        unsafe fn alloc(&self,l:Layout)->*mut u8{count_allocation();unsafe{System.alloc(l)}}
        unsafe fn alloc_zeroed(&self,l:Layout)->*mut u8{count_allocation();unsafe{System.alloc_zeroed(l)}}
        unsafe fn dealloc(&self,p:*mut u8,l:Layout){unsafe{System.dealloc(p,l)}}
        unsafe fn realloc(&self,p:*mut u8,l:Layout,n:usize)->*mut u8{count_allocation();unsafe{System.realloc(p,l,n)}}
    }
    #[global_allocator]static ALLOC:CountingAllocator=CountingAllocator;
    fn without_allocations(f:impl FnOnce()) {
        CALLS.with(|c|c.set(Some(0)));f();
        let calls=CALLS.with(|c|c.replace(None).unwrap());
        assert_eq!(calls,0,"reusable formatting allocated");
    }

    #[test]
    fn reusable_formatting_covers_all_banks_and_error_paths() {
        let mut checked=0;
        let mut check=|decoded:Decoded| {
            let expected=decoded.presentation(0x1234).map(|pair|pair.0);
            let mut output=String::with_capacity(4096);output.push_str("stale output");
            let mut result=Ok(());
            without_allocations(||{result=decoded.format_into(0x1234,&mut output);});
            assert_eq!(result,expected.as_ref().map(|_|()).map_err(Clone::clone),"{}",decoded.encoding_id());
            assert_eq!(output,expected.as_deref().unwrap_or(""));
            let mut empty=String::new();assert_eq!(decoded.format_into(0x1234,&mut empty),result);assert_eq!(empty,output);
            checked+=1;
        };
        for form in FORMS {
            for pattern in [0,u32::MAX,0x55555555,0xaaaaaaaa] {
                let word=(form.value|(!form.mask&pattern))&if form.width==16{0xffff}else{u32::MAX};
                if !form.thumb {if let Ok(d)=a32::decode(word){check(Decoded{encoding:Encoding::Arm(d),mode:Mode::Arm,length:4});}}
                else if form.width==16 {if let Ok(d)=t16::decode(word){check(Decoded{encoding:Encoding::Thumb16(d),mode:Mode::Thumb,length:2});}}
                else if let Ok(d)=t32::decode(word){check(Decoded{encoding:Encoding::Thumb32(d),mode:Mode::Thumb,length:4});}
            }
        }
        assert!(checked>0 || FORMS.is_empty());
    }
    #[test]
    fn unicode_normalization_reuses_capacity() {
        let mut text=" \u{a0} A \u{2003} é  ] , ".to_string();
        without_allocations(||{text=normalize_text(std::mem::take(&mut text));});
        assert_eq!(text,"a é],");
    }
}

