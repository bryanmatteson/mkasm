            assert!(details.reads.contains(&Register::Gpr(13)));
            assert!(details.writes.contains(&Register::Gpr(13)));
            assert!(details.operands.iter().any(|op|matches!(op.kind,OperandKind::Memory(m) if m.base==Register::Gpr(13))&&op.access==access));
            assert_eq!(details.writes.contains(&Register::D(8)),access==Access::Read);
            assert_eq!(details.reads.contains(&Register::D(8)),access==Access::Write);
        }
        for (word,fpscr_access) in [(0xeef10a10_u32,Access::Read),(0xeee10a10,Access::Write)] {
            let d=decode(&word.to_le_bytes(),Mode::Arm,Endian::Little).unwrap();
            let details=d.details(0).unwrap();
            assert!(details.operands.iter().any(|op|op.kind==OperandKind::SystemRegister(Register::Fpscr)&&op.access==fpscr_access));
            assert_eq!(details.writes.contains(&Register::Gpr(0)),fpscr_access==Access::Read);
            assert_eq!(details.reads.contains(&Register::Gpr(0)),fpscr_access==Access::Write);
        }
        let d=decode(&0xeef1fa10_u32.to_le_bytes(),Mode::Arm,Endian::Little).unwrap();
        assert_eq!(d.format(0).unwrap(),"vmrs apsr_nzcv, fpscr");
        let details=d.details(0).unwrap();
        assert!(details.writes.contains(&Register::Apsr));
        assert!(!details.writes.contains(&Register::Gpr(15)));
        let d=decode(&0xf3b20081_u32.to_le_bytes(),Mode::Arm,Endian::Little).unwrap();
        let details=d.details(0).unwrap();
        for r in [Register::D(0),Register::D(1)] {assert!(details.reads.contains(&r)&&details.writes.contains(&r));}
    }
    #[test]
    fn post_index_updates_are_separate_from_access_addresses() {
        for (word,offset) in [(0xe4910004_u32,0),(0xe5b10004,4)] {
            let d=decode(&word.to_le_bytes(),Mode::Arm,Endian::Little).unwrap();
            let details=d.details(0).unwrap();
            assert!(details.operands.iter().any(|op|matches!(op.kind,OperandKind::Memory(m) if m.base==Register::Gpr(1)&&m.displacement==offset)));
            assert!(details.writes.contains(&Register::Gpr(1)));
        }
        let d=decode(&0xf4200701_u32.to_le_bytes(),Mode::Arm,Endian::Little).unwrap();
        let details=d.details(0).unwrap();
        assert!(details.operands.iter().any(|op|matches!(op.kind,OperandKind::Memory(m) if m.base==Register::Gpr(0)&&m.index.is_none())));
        assert!(details.reads.contains(&Register::Gpr(1)));
        assert!(details.writes.contains(&Register::Gpr(0)));
    }
    #[test]
    fn adr_subtraction_and_extend_rotations_follow_encoding_fields() {
        for (word,target) in [(0xe28f0004_u32,0x100c),(0xe24f0004,0x1004)] {
            let d=decode(&word.to_le_bytes(),Mode::Arm,Endian::Little).unwrap();
            assert_eq!(d.format(0x1000).unwrap(),format!("adr r0, #0x{target:x}"));
        }
        for (first,target) in [(0xf20f_u16,0x1008),(0xf2af,0x1000)] {
            let mut bytes=first.to_le_bytes().to_vec();bytes.extend(0x0004_u16.to_le_bytes());
            let d=decode(&bytes,Mode::Thumb,Endian::Little).unwrap();
            assert_eq!(d.format(0x1000).unwrap(),format!("adr r0, #0x{target:x}"));
        }
        for rotation in 0..4_u32 {
            let expected=if rotation==0 {Shift::None} else {Shift::Ror(rotation*8)};
            let arm=(0xe6ef0071_u32|(rotation<<10)).to_le_bytes();
            let second=(0xf081_u16|((rotation as u16)<<4)).to_le_bytes();
            let thumb=[0x5f,0xfa,second[0],second[1]];
            for (bytes,mode) in [(&arm[..],Mode::Arm),(&thumb[..],Mode::Thumb)] {
                let d=decode(bytes,mode,Endian::Little).unwrap();
                assert!(d.details(0).unwrap().operands.iter().any(|op|op.kind==OperandKind::Register(Register::Gpr(1))&&op.shift==expected),"{} rotation {rotation}",d.encoding_id());
            }
        }
    }
