        for (word,expected) in [
            (0xe3000000,"movw r0, #0"),
            (0xe14000d0,"ldrd r0, r1, [r0]"),
            (0xe6ef0070,"uxtb r0, r0 "),
            (0xeeb00b00,"vmov.f64 d0, #2.00000000"),
            (0xf2800110,"vorr.i32 d0, #0x0"),
            (0xf2000110,"vand d0, d0, d0"),
            (0xf3e3795a,"vqrshrn.u64 d23, q5, #29"),
            (0xf3e36a1b,"vshll.u32 q11, d11, #3"),
            (0xf4a0000f,"vld1.8 {d0[0]}, [r0]"),
            (0xf4622aef,"vld1.64 {d18, d19}, [r2:128]"),
        ] {
            let d=decode(&u32::to_le_bytes(word),Mode::Arm,Endian::Little).unwrap();
            assert_eq!(d.format(0x1000).unwrap().trim(),expected.trim(),"{}",d.encoding_id());
        }
        let d=decode(&[0,0x30],Mode::Thumb,Endian::Little).unwrap();
