//! A32 and Thumb codec generated by mkasm from Arm's AArch32 XML.
#![allow(dead_code)]

mod a32;
mod t16;
mod t32;
mod encoders;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Mode { Arm, Thumb }
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Endian { Little, Big }
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum DecodeError { Truncated, UnknownEncoding(u32) }
impl std::fmt::Display for DecodeError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { write!(f, "{self:?}") }
}
impl std::error::Error for DecodeError {}

#[derive(Debug, Clone)]
enum Encoding { Arm(a32::Decoded), Thumb16(t16::Decoded), Thumb32(t32::Decoded) }
#[derive(Debug, Clone)]
pub struct Decoded { encoding: Encoding, pub mode: Mode, pub length: usize }

pub fn decode(bytes: &[u8], mode: Mode, endian: Endian) -> Result<Decoded, DecodeError> {
    let halfword = |offset: usize| -> Result<u16, DecodeError> {
        let b: [u8;2] = bytes.get(offset..offset+2).ok_or(DecodeError::Truncated)?.try_into().unwrap();
        Ok(match endian { Endian::Little => u16::from_le_bytes(b), Endian::Big => u16::from_be_bytes(b) })
    };
    let (encoding, length) = match mode {
        Mode::Arm => {
            let b: [u8;4] = bytes.get(..4).ok_or(DecodeError::Truncated)?.try_into().unwrap();
            let word = match endian { Endian::Little => u32::from_le_bytes(b), Endian::Big => u32::from_be_bytes(b) };
            (Encoding::Arm(a32::decode(word).map_err(|_| DecodeError::UnknownEncoding(word))?),4)
        }
        Mode::Thumb => {
            let first = halfword(0)?;
            if first >> 11 >= 0b11101 {
                let word = (u32::from(first)<<16) | u32::from(halfword(2)?);
                (Encoding::Thumb32(t32::decode(word).map_err(|_| DecodeError::UnknownEncoding(word))?),4)
            } else {
                let word = u32::from(first);
                (Encoding::Thumb16(t16::decode(word).map_err(|_| DecodeError::UnknownEncoding(word))?),2)
            }
        }
    };
    Ok(Decoded { encoding, mode, length })
}

impl Decoded {
    pub fn field(&self, name: &str) -> Option<u32> {
        match &self.encoding { Encoding::Arm(d) => d.field(name), Encoding::Thumb16(d) => d.field(name), Encoding::Thumb32(d) => d.field(name) }.map(|v| v as u32)
    }
    fn f(&self, name: &str) -> u32 { self.field(name).unwrap_or(0) }
    pub fn encoding_id(&self) -> &'static str {
        match &self.encoding { Encoding::Arm(d) => d.encoding_id, Encoding::Thumb16(d) => d.encoding_id, Encoding::Thumb32(d) => d.encoding_id }
    }
    pub fn mnemonic(&self) -> &'static str {
        match &self.encoding { Encoding::Arm(d) => d.asm_mnemonic, Encoding::Thumb16(d) => d.asm_mnemonic, Encoding::Thumb32(d) => d.asm_mnemonic }
    }
    pub fn class(&self) -> &'static str {
        match &self.encoding { Encoding::Arm(d) => d.class, Encoding::Thumb16(d) => d.class, Encoding::Thumb32(d) => d.class }
    }
    pub fn alias_of(&self) -> &'static str {
        match &self.encoding { Encoding::Arm(d) => d.alias_of, Encoding::Thumb16(d) => d.alias_of, Encoding::Thumb32(d) => d.alias_of }
    }
    pub fn alternatives(&self) -> usize {
        match &self.encoding { Encoding::Arm(d) => d.ambiguous.len(), Encoding::Thumb16(d) => d.ambiguous.len(), Encoding::Thumb32(d) => d.ambiguous.len() }
    }
    pub fn raw(&self) -> u32 {
        match &self.encoding { Encoding::Arm(d) => d.raw, Encoding::Thumb16(d) => d.raw, Encoding::Thumb32(d) => d.raw }
    }
    fn form(&self) -> &'static Form {
        let index = FORMS.binary_search_by_key(&self.encoding_id(), |f| f.id).expect("decoder encoding has a print form");
        &FORMS[index]
    }
    pub fn condition(&self) -> u8 { self.field("cond").filter(|&c| c!=15).unwrap_or(14) as u8 }
    pub fn update_flags(&self) -> bool {
        (self.f("S") != 0 && !self.encoding_id().starts_with("B_") && !self.encoding_id().starts_with("BL_")) || matches!(self.mnemonic().trim_end_matches('{'), "CMP"|"CMN"|"TST"|"TEQ") ||
            (self.mode == Mode::Thumb && self.length == 2 && self.form().parts.first().is_some_and(|p| p.prefix.split(['{','<',' ']).next().is_some_and(|s| s.ends_with('S') && s != "CPS")))
    }
    pub fn branch_target(&self, address: u64) -> Option<u32> {
        let id = self.encoding_id();
        let pc = (address as u32).wrapping_add(if self.mode == Mode::Arm { 8 } else { 4 });
        let sign = |value: u32, width: u32| ((value << (32-width)) as i32) >> (32-width);
        let (offset, align) = if self.mode == Mode::Arm && (id.starts_with("B_") || id.starts_with("BL_")) {
            let v = (self.f("imm24")<<2) | if self.mnemonic().starts_with("BLX") {self.f("H")<<1} else {0};
            (sign(v,26), false)
        } else if id.starts_with("CB") {
            (((self.f("i")<<5 | self.f("imm5"))<<1) as i32, false)
        } else if self.mode == Mode::Thumb && id.starts_with("B_T1") { (sign(self.f("imm8")<<1,9),false)
        } else if self.mode == Mode::Thumb && id.starts_with("B_T2") { (sign(self.f("imm11")<<1,12),false)
        } else if self.mode == Mode::Thumb && id.starts_with("B_T3") {
            (sign(self.f("S")<<20 | self.f("J2")<<19 | self.f("J1")<<18 | self.f("imm6")<<12 | self.f("imm11")<<1,21),false)
        } else if self.mode == Mode::Thumb && (id.starts_with("B_T4") || id.starts_with("BL_")) {
            let s = self.f("S");
            let i1 = !(self.f("J1") ^ s) & 1; let i2 = !(self.f("J2") ^ s) & 1;
            let low = if self.field("imm10L").is_some() { self.f("imm10L")<<2 } else { self.f("imm11")<<1 };
            (sign(s<<24 | i1<<23 | i2<<22 | self.field("imm10H").unwrap_or(self.f("imm10"))<<12 | low,25), self.mnemonic().starts_with("BLX"))
        } else { return None };
        Some((if align { pc & !3 } else { pc }).wrapping_add_signed(offset))
    }
    pub fn format(&self, address: u64) -> Result<String, FormatError> { Ok(self.render(address)?.0) }
    pub fn details(&self, address: u64) -> Result<Details, FormatError> { Ok(self.render(address)?.1) }
    pub fn presentation(&self, address: u64) -> Result<(String, Details), FormatError> { self.render(address) }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Register { Gpr(u8), D(u8), Q(u8), S(u8), Cpsr, Spsr, Fpscr, Apsr, ItState }
impl Register {
    fn valid(self) -> bool {match self {Self::Gpr(n)=>n<16,Self::D(n)|Self::S(n)=>n<32,Self::Q(n)=>n<16,_=>true}}
    pub fn name(self) -> String {
        match self { Self::Gpr(13) => "sp".into(), Self::Gpr(14) => "lr".into(), Self::Gpr(15) => "pc".into(), Self::Gpr(n) => format!("r{n}"), Self::D(n) => format!("d{n}"), Self::Q(n) => format!("q{n}"), Self::S(n) => format!("s{n}"), Self::Cpsr => "cpsr".into(), Self::Spsr => "spsr".into(), Self::Fpscr => "fpscr".into(), Self::Apsr => "apsr".into(), Self::ItState => "itstate".into() }
    }
}
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Access { Read, Write, ReadWrite }
impl Access {
    pub fn is_readable(self) -> bool { self != Self::Write }
    pub fn is_writable(self) -> bool { self != Self::Read }
}
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Shift { None, Lsl(u32), Lsr(u32), Asr(u32), Ror(u32), Rrx, LslReg(Register), LsrReg(Register), AsrReg(Register), RorReg(Register) }
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Memory { pub base: Register, pub index: Option<Register>, pub displacement: i32, pub subtract: bool, pub shift: Shift }
#[derive(Debug, Clone, Copy, PartialEq)]
pub enum OperandKind { Register(Register), Immediate(i64), Memory(Memory), FloatingPoint(f64), SystemRegister(Register), Other }
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Operand { pub kind: OperandKind, pub access: Access, pub shift: Shift, pub lane: Option<u32> }
#[derive(Debug, Clone)]
pub struct Details { pub operands: Vec<Operand>, pub condition: u8, pub update_flags: bool, pub reads: Vec<Register>, pub writes: Vec<Register>, pub writeback: bool }
impl Details {
    pub fn operands(&self) -> impl Iterator<Item=Operand> + '_ { self.operands.iter().copied() }
}
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct FormatError { pub encoding: &'static str, pub symbol: &'static str }
impl std::fmt::Display for FormatError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { write!(f,"cannot format {} operand {}",self.encoding,self.symbol) }
}
impl std::error::Error for FormatError {}

#[derive(Clone, Copy)]
struct Bits { lo: u8, width: u8 }
struct Check { bits: &'static [Bits], mask: u32, value: u32 }
struct Value { checks: &'static [Check], text: &'static str }
enum Transform { Plain, ArmImmediate, ThumbImmediate, PlusOne, BitfieldWidth, ShiftAmount, RightShift, NarrowShift, LeftShift, FractionBits, Successor, FloatImmediate, SimdImmediate }
struct Part { prefix: &'static str, symbol: &'static str, bits: &'static [Bits], values: &'static [Value], scale: u32, transform: Transform }
struct Form { id: &'static str, parts: &'static [Part], suffix: &'static str, width: usize, thumb: bool, mask: u32, value: u32 }
#[derive(Debug, Clone, Copy)]
pub struct EncodingInfo { pub id: &'static str, pub mode: Mode, pub length: usize, pub mask: u32, pub value: u32 }
pub fn encoding_count() -> usize { FORMS.len() }
pub fn encoding_info(index: usize) -> Option<EncodingInfo> {
    FORMS.get(index).map(|f| EncodingInfo { id:f.id, mode:if f.thumb {Mode::Thumb}else{Mode::Arm},length:f.width/8,mask:f.mask,value:f.value })
}
static FORMS: &[Form] = &[
{{.Forms}}
];

fn extract(word: u32, parts: &[Bits]) -> u32 {
    let mut out = 0_u32;
    for p in parts { out = out.checked_shl(u32::from(p.width)).unwrap_or(0) | ((word >> p.lo) & (u32::MAX >> (32-p.width))); }
    out
}
fn condition_name(condition: u8) -> &'static str { ["eq","ne","hs","lo","mi","pl","vs","vc","hi","ls","ge","lt","gt","le","","nv"][usize::from(condition & 15)] }
fn thumb_immediate(value: u32) -> u32 {
    if value>>10 == 0 {
        let b = value & 255;
        match (value>>8)&3 { 0 => b, 1 => b<<16 | b, 2 => b<<24 | b<<8, _ => b*0x01010101 }
    } else { ((value&127)|128).rotate_right((value>>7)&31) }
}
fn simd_immediate(cmode: u32, op: u32, imm: u32) -> u64 {
    match cmode {
        0..=7 => u64::from(imm << (8*(cmode>>1))),
        8..=11 => u64::from(imm << (8*((cmode>>1)&1))),
        12 => u64::from(imm<<8 | 255), 13 => u64::from(imm<<16 | 65535),
        14 if op == 0 => u64::from(imm),
        14 => (0..8).fold(0,|v,i| v | if imm & (1<<i) != 0 { 255_u64<<(i*8) } else { 0 }),
        _ => u64::from(imm),
    }
}
fn float_immediate(imm: u32) -> f64 {
    let sign = if imm&128 != 0 { -1.0 } else { 1.0 };
    let exponent = if imm&64 != 0 { -3 } else { 1 } + ((imm>>4)&3) as i32;
    sign * (1.0 + f64::from(imm&15)/16.0) * 2_f64.powi(exponent)
}

// Braces in Arm's templates delimit optional syntax; register-list braces
// arrive as operand values and are never interpreted here.
fn append_literal(text: &mut String, groups: &mut Vec<(usize,bool)>, literal: &str) {
    for ch in literal.chars() {
        match ch {
            '{' => groups.push((text.len(),false)),
            '}' => if let Some((start,empty))=groups.pop() {if empty {text.truncate(start)}},
            _ => text.push(ch),
        }
    }
}

impl Decoded {
    fn value(&self, p: &Part) -> u32 {
        if matches!(p.transform,Transform::Successor) {return self.f("Rt")+1}
        if !p.bits.is_empty() { return extract(self.raw(),p.bits) }
        match p.symbol {
            "<Rd>" => (self.f("D")<<3) | self.f("Rd"),
            "<Rn>" => self.f("Rn"), "<Rm>" => self.f("Rm"), "<Rt>" => self.f("Rt"),
            "<Rdn>" => self.f("Rdn"), "<Rdm>" => self.f("Rdm"),
            "<Ra>" => self.f("Ra"), "<Rs>" => self.f("Rs"),
            "<Rt2>" => self.field("Rt2").unwrap_or(self.f("Rt")+1),
            "<RdLo>" => self.f("RdLo"), "<RdHi>" => self.f("RdHi"),
            "<Dd>" | "<Ddm>" | "<Qd>" => self.f("D")<<4 | self.f("Vd"),
            "<Dn>" | "<Qn>" => self.f("N")<<4 | self.f("Vn"),
            "<Dm>" | "<Qm>" | "<Dm[x]>" => self.f("M")<<4 | self.f("Vm"),
            "<Sd>" | "<Sdm>" => self.f("Vd")<<1 | self.f("D"),
            "<Sm1>" => (self.f("Vm")<<1 | self.f("M"))+1,
            "<Sn>" => self.f("Vn")<<1 | self.f("N"), "<Sm>" => self.f("Vm")<<1 | self.f("M"),
            "<const>" => self.field("imm12").unwrap_or(self.f("i")<<11 | self.f("imm3")<<8 | self.f("imm8")),
            "<imm>" | "<amount>" => self.field("imm12").or(self.field("imm8")).or(self.field("imm5")).or(self.field("imm6")).or(self.field("imm2")).or(self.field("sat_imm")).unwrap_or(self.f("imm3")<<2 | self.f("imm2")),
            "<size>" => 8<<self.f("size"), "<shift>" | "<type>" => self.field("stype").unwrap_or(self.f("op")),
            "<lsb>" => self.field("lsb").unwrap_or(self.f("imm3")<<2 | self.f("imm2")),
            "<width>" => self.field("widthm1").unwrap_or(self.f("msb")),
            "<option>" => self.f("option"), "<align>" => self.f("align"),
            "<index>" => self.f("index_align")>>(self.f("size")+1),
            _ => self.f(p.symbol.trim_matches(['<','>'])),
        }
    }
    fn scalar_register(&self, p: &Part) -> Option<Register> {
        let n = self.value(p) as u8 & 31;
        if (p.symbol=="<Dm[x]>" || p.symbol=="<Dm>" && self.form().parts.iter().any(|p|p.symbol=="<index>")) && self.field("size").is_some() {return Some(Register::D((self.f("Vm")&if self.f("size")==1 {7}else{15}) as u8))}
        Some(match p.symbol {
            "SP" => Register::Gpr(13),
            "<Rd>"|"<Rn>"|"<Rm>"|"<Rt>"|"<Rt2>"|"<Rdn>"|"<Rdm>"|"<Ra>"|"<Rs>"|"<RdLo>"|"<RdHi>" => Register::Gpr(n),
            "<Dd>"|"<Dn>"|"<Dm>"|"<Ddm>"|"<Dd[x]>"|"<Dn[x]>"|"<Dm[x]>" => Register::D(n),
            "<Qd>"|"<Qn>"|"<Qm>" => Register::Q(n/2),
            "<Sd>"|"<Sn>"|"<Sm>"|"<Sdm>"|"<Sm1>" => Register::S(n),
            _ => return None,
        })
    }
    fn element_size(&self) -> u32 {
        if self.field("B").is_some() { if self.f("B")!=0 {8} else if self.f("E")!=0 {16} else {32} }
        else if self.field("opc1").is_some() { if self.f("opc1")&2!=0 {8} else if self.f("opc2")&1!=0 {16} else {32} }
        else if self.field("imm4").is_some() {8<<self.f("imm4").trailing_zeros().min(2)}
        else {8<<self.f("size").min(3)}
    }
    fn lane_index(&self) -> u32 {
        if self.field("opc1").is_some() { match self.element_size() {8=>(self.f("opc1")&1)<<2|self.f("opc2"),16=>(self.f("opc1")&1)<<1|self.f("opc2")>>1,_=>self.f("opc1")&1} }
        else if self.field("index_align").is_some() {self.f("index_align")>>(self.f("size")+1)}
        else if self.field("imm4").is_some() {self.f("imm4")>>(self.f("imm4").trailing_zeros().min(2)+1)}
        else if self.field("size")==Some(1) {self.f("M")<<1|self.f("Vm")>>3}
        else {self.f("M")}
    }
    fn registers(&self, p: &Part) -> Option<Vec<Register>> {
        let sym = p.symbol;
        if sym.contains("registers") || sym == "<registers>" {
            let mut mask = self.field("register_list").or(self.field("registers")).unwrap_or(0);
            if self.length == 2 && self.raw() & 0xf600 == 0xb400 { mask |= self.f("M")<<14 | self.f("P")<<15; }
            return Some((0..16).filter(|n| mask&(1<<n) != 0).map(Register::Gpr).collect())
        }
        if sym == "<single_register_list>" { return Some(vec![Register::Gpr(self.f("Rt") as u8)]) }
        if sym == "<list>" || sym == "<dreglist>" || sym == "<sreglist>" {
            let d = self.f("D")<<4 | self.f("Vd");
            let mnemonic = self.mnemonic();
            let count = if sym == "<sreglist>" || sym == "<dreglist>" { if sym == "<sreglist>" { self.f("imm8") } else { self.f("imm8")/2 } }
                else if mnemonic.starts_with("VLD1") || mnemonic.starts_with("VST1") {
                    if self.field("itype").is_some() { match self.f("itype") { 7 => 1, 10 => 2, 6 => 3, 2 => 4, _ => 1 } } else if self.encoding_id().contains("_a_") {self.f("T")+1} else { 1 }
                } else { mnemonic.as_bytes().get(3).filter(|b| b.is_ascii_digit()).map_or(1,|b| u32::from(*b-b'0')) * if self.encoding_id().contains("_a_") && (mnemonic.starts_with("VLD2")||mnemonic.starts_with("VST2")) {self.f("T")+1}else{1} };
            let stride = if sym == "<list>" && ((self.field("itype").is_some() && self.f("itype")&1 != 0 && !mnemonic.starts_with("VLD1") && !mnemonic.starts_with("VST1")) || (self.field("index_align").is_some() && self.f("index_align")&(1<<self.f("size")) != 0)) { 2 } else { 1 };
            let start = if sym == "<sreglist>" { self.f("Vd")<<1 | self.f("D") } else { d };
            return Some((0..count).map(|i| if sym == "<sreglist>" { Register::S((start+i) as u8) } else { Register::D((start+i*stride) as u8) }).collect())
        }
        None
    }
    fn text_value(&self, p: &Part, address: u64) -> Result<String, FormatError> {
        let error = || FormatError { encoding: self.encoding_id(), symbol: p.symbol };
        if p.symbol=="<Rt>" && self.mnemonic().starts_with("VMRS") && self.value(p)==15 && self.f("reg")==1 {return Ok("apsr_nzcv".into())}
        if let Some(r) = self.scalar_register(p) { if !r.valid() || p.symbol.starts_with("<Q") && self.value(p)&1!=0 {return Err(error())} return Ok(if p.symbol.contains("[x]") {format!("{}[{}]",r.name(),self.lane_index())} else {r.name()}) }
        if let Some(rs) = self.registers(p) { if rs.is_empty() || rs.iter().any(|r|!r.valid()) {return Err(error())} return Ok(format!("{}{}{}", "{", rs.iter().map(|r| if p.symbol=="<list>" && self.field("index_align").is_some() {format!("{}[{}]",r.name(),self.lane_index())}else if p.symbol=="<list>" && self.encoding_id().contains("_a_") {format!("{}[]",r.name())}else{r.name()}).collect::<Vec<_>>().join(", "), "}")) }
        if p.symbol=="<size>" && self.field("imm4").is_some() {return Ok(self.element_size().to_string())}
        if p.symbol=="<size>" && p.values.is_empty() && self.field("imm6").is_some() {return Ok((1<< (31-self.f("imm6").max(1).leading_zeros())).to_string())}
        if p.symbol=="<index>" && self.field("size").is_some() {return Ok(self.lane_index().to_string())}
        if p.symbol=="<type>" && self.mnemonic().starts_with("VQSHLU") {return Ok("s".into())}
        if p.symbol=="<spec_reg>" && self.mnemonic().starts_with("MSR") {
            let mask=self.f("mask");
            return Ok(format!("{}_{}",if self.f("R")==0 {"cpsr"}else{"spsr"},[(1,"c"),(2,"x"),(4,"s"),(8,"f")].into_iter().filter(|(bit,_)|mask&bit!=0).map(|(_,name)|name).collect::<String>()))
        }
        if let Some(row) = p.values.iter().find(|row| row.checks.iter().all(|c| extract(self.raw(),c.bits)&c.mask == c.value)) {
            if matches!(row.text,"reserved"|"unallocated"|"undefined"|"unpredictable") { if p.symbol=="<option>" {return Ok(format!("#{}",self.value(p)))};return Err(error()) }
            if row.text == "[absent]" { return Ok(String::new()) }
            if row.text == "[present]" {return Ok(p.symbol.to_ascii_lowercase())}
            return Ok(row.text.replace("cpsr|apsr","cpsr").replace("<type>",if self.f("U")==0 {"s"}else{"u"}))
        }
        let mut value = self.value(p);
        match p.symbol {
            "<q>" => return Ok(String::new()),
            "<c>" => return Ok(condition_name(self.condition()).into()),
            "<cond>" => return Ok(condition_name(self.f("firstcond") as u8).into()),
            "+/-" => return Ok(if self.f("U") != 0 { "" } else { "-" }.into()),
            "+" => return Ok(String::new()), "!" => return Ok(if self.f("W") != 0 { "!" } else { "" }.into()),
            "IA" => return Ok("ia".into()), ".32" | ".64" => return Ok(if p.prefix.ends_with('.') {p.symbol[1..].into()}else{p.symbol.into()}),
            "<label>" => {
                if let Some(target) = self.branch_target(address) { return Ok(format!("#0x{target:x}")) }
                // ADR and literal loads share the architectural PC base, but
                // ADR's offset is expanded while a load's offset is unsigned.
                let imm = if p.bits.is_empty() { self.field("imm12").unwrap_or(self.f("i")<<11|self.f("imm3")<<8|self.f("imm8")) } else { value };
                if self.mnemonic().starts_with("ADR") {
                    let imm = if self.mode == Mode::Arm { (imm&255).rotate_right(((imm>>8)&15)*2) } else if self.length == 2 { imm*4 } else { imm };
                    // Encodings A2 and T2 subtract the offset from the aligned PC.
                    let add = !matches!(self.encoding_id(), "ADR_A2" | "ADR_T2");
                    let pc = (address as u32).wrapping_add(if self.mode == Mode::Arm {8} else {4})&!3;
                    return Ok(format!("#0x{:x}",if add {pc.wrapping_add(imm)} else {pc.wrapping_sub(imm)}))
                }
                let offset = if self.mode == Mode::Thumb && self.length == 2 { imm*4 } else {imm*p.scale};
                return Ok(format!("[pc, #{}{}]",if self.field("U").unwrap_or(1)==0 {"-"} else {""},offset))
            }
            "<shift>" if self.field("imm5").is_some() => {
                let kind=self.f("stype");let n=self.f("imm5");
                return Ok(match (kind,n) {(0,0)=>String::new(),(3,0)=>"rrx".into(),_=>format!("{} #{}",["lsl","lsr","asr","ror"][kind as usize],if n==0 {32}else{n})})
            }
            "<shift>" | "<type>" if self.field("stype").is_some() || !self.mnemonic().starts_with('V') => return Ok(["lsl","lsr","asr","ror"][(value&3) as usize].into()),
            "<iflags>" => return Ok(format!("{}{}{}",if self.f("A")!=0 {"a"}else{""},if self.f("I")!=0 {"i"}else{""},if self.f("F")!=0 {"f"}else{""})),
            "<endian_specifier>" => return Ok(if self.f("E")==0 {"le"} else {"be"}.into()),
            "<spec_reg>" => return Ok(if self.f("R")==0 {"apsr"} else {"spsr"}.into()),
            "<option>" => return Ok(match value {15=>"sy",14=>"st",11=>"ish",10=>"ishst",7=>"nsh",6=>"nshst",3=>"osh",2=>"oshst",_=>return Ok(format!("#{value}"))}.into()),
            "<coproc>" => return Ok(format!("p{value}")), "<CRn>"|"<CRm>" => return Ok(format!("c{value}")),
            "<size>" if self.field("B").is_some() || self.field("opc1").is_some() => return Ok(self.element_size().to_string()),
            "<type>" if self.mnemonic().starts_with('V') => return Ok(if self.mnemonic().starts_with("VSHLL") && self.field("size").is_some() {"i"}else if self.f("U")==0 || self.mnemonic().starts_with("VQSHLU") || self.mnemonic().starts_with("VQSHRUN") || self.mnemonic().starts_with("VQRSHRUN") {"s"}else{"u"}.into()),
            "<dt>" if self.field("opc1").is_some() => return Ok(if self.element_size()==32 {"32".into()} else {format!("{}{}",if self.f("U")==0 {"s"}else{"u"},self.element_size())}),
            "<align>" if self.field("align").is_some() => return Ok(if value==0 {String::new()} else {(32_u32<<value).to_string()}),
            "<align>" if self.field("index_align").is_some() => return Ok(if self.f("index_align") & ((1<<self.f("size"))-1) == 0 {String::new()} else {(8<<self.f("size")).to_string()}),
            "<align>" if self.field("a").is_some() => return Ok(if self.f("a")==0 {String::new()}else{(8<<self.f("size")).to_string()}),
            "<size>" if p.bits.is_empty() => { value = if self.mnemonic().starts_with("VSHLL") {8<<self.f("size")} else if self.field("imm4").is_some() { 8<<self.f("imm4").trailing_zeros().min(2) } else if self.field("B").is_some() { if self.f("B")!=0 {8} else if self.f("E")!=0 {16} else {32} } else if self.field("opc1").is_some() { if self.f("opc1")&2!=0 {8} else if self.f("opc2")&1!=0 {16} else {32} } else if self.encoding_id().contains("Double") || self.field("sz")==Some(1) {64} else {32} },
            "<dt>" if p.bits.is_empty() => return Ok(String::new()),
            "<amode>" => return Ok(match (self.f("P"),self.f("U")) {(0,1)=>"ia",(1,1)=>"ib",(0,0)=>"da",_=>"db"}.into()),
            "<x>"|"<y>"|"<z>" => return Ok("t".into()),
            _ => (),
        }
        value = match p.transform {
            Transform::ArmImmediate => (value&255).rotate_right(((value>>8)&15)*2),
            Transform::ThumbImmediate => thumb_immediate(value), Transform::PlusOne => value+1,
            Transform::Successor => value+1,
            Transform::BitfieldWidth => value.saturating_sub(self.field("lsb").unwrap_or(self.f("imm3")<<2|self.f("imm2")))+1,
            Transform::ShiftAmount => if value==0 && (self.field("stype").unwrap_or(self.f("op"))==1 || self.field("stype").unwrap_or(self.f("op"))==2 || self.mnemonic().starts_with("LSR") || self.mnemonic().starts_with("ASR") || self.encoding_id().ends_with("_ASR") || self.mnemonic().starts_with("PKHTB")) {32} else {value},
            Transform::RightShift => (1_u32 << (31-value.max(1).leading_zeros())).saturating_mul(2).saturating_sub(value),
            Transform::NarrowShift => (8_u32<<((31-self.f("imm6").max(1).leading_zeros()).saturating_sub(3))).saturating_mul(2).saturating_sub(value),
            Transform::LeftShift => if self.mnemonic().starts_with("VSHLL") && self.field("size").is_some() {8<<self.f("size")} else {value.saturating_sub(1<<(31-value.max(1).leading_zeros()))},
            Transform::FractionBits => if self.field("sx").is_some() { (if self.f("sx")==0 {16_u32}else{32}).saturating_sub(self.f("imm4")<<1|self.f("i")) } else {64-value},
            Transform::FloatImmediate => return Ok(format!("{:.8}",float_immediate(self.f("imm4H")<<4|self.f("imm4L")))),
            Transform::SimdImmediate => return Ok(if self.f("cmode")==15 && self.f("op")==0 {format!("{:.8}",float_immediate(self.f("i")<<7|self.f("imm3")<<4|self.f("imm4")))}else{format!("0x{:x}",simd_immediate(self.f("cmode"),self.f("op"),self.f("i")<<7|self.f("imm3")<<4|self.f("imm4")))}),
            Transform::Plain => value,
        };
        value = value.wrapping_mul(p.scale);
        if p.symbol == "<dt>" || p.symbol == "<dt1>" || p.symbol == "<dt2>" || p.symbol == "<banked_reg>" { return Err(error()) }
        Ok(value.to_string())
    }
    fn render(&self, address: u64) -> Result<(String,Details), FormatError> {
        let form = self.form();
        let mut text = String::new();
        let mut groups=Vec::new();
        let mut operands: Vec<Operand> = Vec::new();
        let mut roles=Vec::new();
        let mut memory: Option<Memory> = None;
        let mut details = Details { operands: Vec::new(), condition: self.condition(), update_flags: self.update_flags(), reads: Vec::new(), writes: Vec::new(), writeback: self.f("W")!=0 };
        let mut shift_kind = 0;
        for (index,p) in form.parts.iter().enumerate() {
            let prefix = p.prefix;
            // A post-index operand follows the closing bracket and is not
            // part of the address used for the memory access.
            if prefix.contains(']') {
                if let Some(m)=memory.take() {
                    operands.push(Operand{kind:OperandKind::Memory(m),access:Access::Read,shift:Shift::None,lane:None});roles.push("memory");
                    details.writeback |= prefix.contains(',');
                }
            }
            if prefix.contains('[') && (p.symbol=="<Rn>" || prefix.contains("SP") || prefix.contains("PC")) {
                memory = Some(Memory {base: Register::Gpr(if prefix.to_ascii_lowercase().contains("pc") {15} else {13}), index: None, displacement:0, subtract:self.field("U")==Some(0),shift:Shift::None});
            }
            append_literal(&mut text,&mut groups,prefix);
            let duplicate=prefix.ends_with('{') && form.parts.get(index+1).is_some_and(|next| next.symbol==p.symbol && next.prefix.contains('}'));
            let mut value = if duplicate {String::new()}else{self.text_value(p,address)?};
            if !groups.is_empty() && value=="0" && (p.symbol.starts_with("<imm") || p.symbol=="<amount>") {value.clear();}
            if text.ends_with('#') && value.starts_with('#') {value.remove(0);}
            if value.is_empty() {if let Some(group)=groups.last_mut() {group.1=true}}
            text.push_str(&value);
            if duplicate {continue}
            if memory.is_none() {
                for literal in prefix.split(|c:char| !c.is_ascii_alphabetic()).filter_map(|word|match word {"SP"=>Some(Register::Gpr(13)),"LR"=>Some(Register::Gpr(14)),"PC"=>Some(Register::Gpr(15)),_=>None}) {
                    operands.push(Operand{kind:OperandKind::Register(literal),access:Access::Read,shift:Shift::None,lane:None});
                    roles.push("literal");
                }
            }
            let before=operands.len();
            if let Some(r) = self.scalar_register(p) {
                if let Some(m) = &mut memory {
                    if p.symbol=="<Rn>" {m.base=r} else if p.symbol=="<Rm>" {m.index=Some(r)}
                } else {
                    if p.symbol=="<Rs>" && form.parts.iter().any(|p|p.symbol=="<shift>") {
                        if let Some(last)=operands.last_mut() {last.shift=match shift_kind {0=>Shift::LslReg(r),1=>Shift::LsrReg(r),2=>Shift::AsrReg(r),_=>Shift::RorReg(r)}}
                    }
                    let kind=if p.symbol=="<Rt>" && self.mnemonic().starts_with("VMRS") && r==Register::Gpr(15) && self.f("reg")==1 {OperandKind::SystemRegister(Register::Apsr)}else{OperandKind::Register(r)};
                    operands.push(Operand {kind, access:Access::Read, shift:Shift::None,lane:if p.symbol.contains("[x]") {Some(self.lane_index())}else{None}});
                }
            } else if let Some(rs) = self.registers(p) {
                for r in rs { operands.push(Operand {kind:OperandKind::Register(r),access:Access::Read,shift:Shift::None,lane:if self.field("index_align").is_some() && p.symbol=="<list>" {Some(self.f("index_align")>>(self.f("size")+1))}else{None}}); }
            } else if p.symbol=="<shift>" || p.symbol=="<type>" && self.field("stype").is_some() {
                shift_kind = self.field("stype").unwrap_or(self.value(p));
                if p.symbol=="<shift>" && self.field("imm5").is_some() {
                    let n=self.f("imm5");let shift=match (shift_kind,n) {(0,0)=>Shift::None,(0,n)=>Shift::Lsl(n),(1,n)=>Shift::Lsr(if n==0 {32}else{n}),(2,n)=>Shift::Asr(if n==0 {32}else{n}),(3,0)=>Shift::Rrx,(_,n)=>Shift::Ror(n)};
                    if let Some(m)=&mut memory {m.shift=shift}else if let Some(last)=operands.last_mut() {last.shift=shift}
                }
            } else if p.symbol=="<amount>" || p.symbol=="<imm>" && (self.encoding_id().contains("_r_") || self.encoding_id().contains("_rr_")) && self.field("stype").is_some() {
                let n=value.parse::<u32>().unwrap_or(0);
                // Extend forms (SXTB/UXTH/SXTAB...) encode a rotation, not a shift.
                let shift=if self.field("rotate").is_some() {if n==0 {Shift::None} else {Shift::Ror(n)}} else {match shift_kind {0=>Shift::Lsl(n),1=>Shift::Lsr(n),2=>Shift::Asr(n),_ if n==0=>Shift::Rrx,_=>Shift::Ror(n)}};
                if let Some(m)=&mut memory {m.shift=shift} else if let Some(last)=operands.last_mut() {last.shift=shift}
            } else if p.symbol=="<index>" {
                if let Some(last)=operands.last_mut() {last.lane=Some(self.lane_index())}
            } else if p.symbol=="<label>" {
                if let Some(target)=self.branch_target(address) {operands.push(Operand{kind:OperandKind::Immediate(i64::from(target)),access:Access::Read,shift:Shift::None,lane:None})}
                else if value.starts_with("[pc") {let displacement=value.split_once('#').and_then(|(_,v)|v.trim_end_matches(']').parse::<i32>().ok()).unwrap_or(0).unsigned_abs() as i32;operands.push(Operand{kind:OperandKind::Memory(Memory{base:Register::Gpr(15),index:None,displacement,subtract:self.field("U")==Some(0),shift:Shift::None}),access:Access::Read,shift:Shift::None,lane:None})}
                else if let Some(hex)=value.strip_prefix("#0x") { if let Ok(n)=u32::from_str_radix(hex,16) {operands.push(Operand{kind:OperandKind::Immediate(i64::from(n)),access:Access::Read,shift:Shift::None,lane:None})} }
            } else if p.symbol.starts_with("<imm") || matches!(p.symbol,"<const>"|"<width>"|"<lsb>"|"<fbits>") {
                if let Ok(n)=value.strip_prefix("0x").map(|v| u64::from_str_radix(v,16).map(|n|n as i64)).unwrap_or_else(||value.parse::<i64>()) {
                    if let Some(m)=&mut memory {m.displacement=n as i32} else {operands.push(Operand{kind:OperandKind::Immediate(n),access:Access::Read,shift:Shift::None,lane:None})}
                } else if let Ok(n)=value.parse::<f64>() {operands.push(Operand{kind:OperandKind::FloatingPoint(n),access:Access::Read,shift:Shift::None,lane:None})}
            } else if p.symbol=="<spec_reg>" {
                let kind=match value.split('_').next().unwrap_or("") {"cpsr"=>OperandKind::SystemRegister(Register::Cpsr),"apsr"=>OperandKind::SystemRegister(Register::Apsr),"spsr"=>OperandKind::SystemRegister(Register::Spsr),"fpscr"=>OperandKind::SystemRegister(Register::Fpscr),_=>OperandKind::Other};
                operands.push(Operand{kind,access:Access::Read,shift:Shift::None,lane:None})
            }
            roles.extend(std::iter::repeat_n(p.symbol,operands.len()-before));
            if value.contains('!') {details.writeback=true}
        }
        append_literal(&mut text,&mut groups,form.suffix);
        if let Some(m)=memory.take() {operands.push(Operand{kind:OperandKind::Memory(m),access:Access::Read,shift:Shift::None,lane:None});roles.push("memory")}
        // No-symbol instructions retain their literal syntax.
        if text.trim().is_empty() {text=self.mnemonic().to_ascii_lowercase()}
        text=text.to_ascii_lowercase().split_whitespace().collect::<Vec<_>>().join(" ");
        text=text.replace(" ]","]").replace(" ,",",");
        if self.encoding_id()=="MOV_i_A2" || self.encoding_id()=="MOV_i_T3" {text=text.replacen("mov","movw",1)}
        if matches!(self.encoding_id(),"ADD_i_T4"|"ADD_SP_i_T4"|"SUB_i_T4"|"SUB_SP_i_T3") {text.insert(3,'w')}
        if self.encoding_id().starts_with("IT_") {
            let mask=self.f("mask"); let first=self.f("firstcond");
            let mut mnemonic="it".to_string();
            for bit in ((mask.trailing_zeros()+1)..4).rev() {mnemonic.push(if (mask>>bit)&1==first&1 {'t'}else{'e'})}
            text=format!("{mnemonic} {}",condition_name(first as u8));
        }
        let name=text.split_whitespace().next().unwrap_or("");
        details.writeback |= text.contains('!');
        let store=name.starts_with("str")||name.starts_with("stl")||name.starts_with("stm")||name.starts_with("push")||name.starts_with("vpush")||name.starts_with("vst")||name.starts_with("stc")||name.starts_with("fstm");
        let load_multiple=name.starts_with("ldm")||name.starts_with("pop")||name.starts_with("vld")||name.starts_with("vpop");
        let stack=name.starts_with("push")||name.starts_with("pop")||name.starts_with("vpush")||name.starts_with("vpop");
        if stack {details.writeback=true}
        if (stack||load_multiple||name.starts_with("stm")||name.starts_with("vstm")) && !operands.iter().any(|op|matches!(op.kind,OperandKind::Memory(_))) {
            let base=if stack {Register::Gpr(13)}else{Register::Gpr(self.f("Rn") as u8)};
            operands.push(Operand{kind:OperandKind::Memory(Memory{base,index:None,displacement:0,subtract:false,shift:Shift::None}),access:Access::Read,shift:Shift::None,lane:None});roles.push("memory");
        }
        let compare=name.starts_with("cmp")||name.starts_with("cmn")||name.starts_with("tst")||name.starts_with("teq")||self.encoding_id().starts_with("B_")||self.encoding_id().starts_with("BL_")||name=="bx"||name.starts_with("blx")||name.starts_with("cb")||name.starts_with("vcm")||name.starts_with("mcr");
        for (i,op) in operands.iter_mut().enumerate() {
            let role=roles[i];
            op.access=match op.kind {
                OperandKind::Memory(_) if name.starts_with("swp")=>Access::ReadWrite,
                OperandKind::Memory(_) if store=>Access::Write,
                OperandKind::Memory(_)=>Access::Read,
                OperandKind::Register(_) if role=="<Rn>" && (load_multiple||store)=>if details.writeback {Access::ReadWrite}else{Access::Read},
                OperandKind::Register(_) if load_multiple && role!="<Rm>"=>Access::Write,
                OperandKind::Register(_) if role=="<Rd>" && (name.starts_with("strex")||name.starts_with("stlex"))=>Access::Write,
                OperandKind::Register(_) if ["vtrn","vzip","vuzp","vswp"].iter().any(|prefix|name.starts_with(prefix))=>Access::ReadWrite,
                OperandKind::Register(_) if !store&&!compare && (i==0 || matches!(role,"<Rt2>"|"<RdLo>"|"<RdHi>"|"<Sm1>"))=>if op.lane.is_some() || matches!(role,"<Rdn>"|"<Rdm>"|"<Ddm>"|"<Sdm>") || form.parts.iter().filter(|p|p.symbol==role).count()>1 || ["vmla","vmls","vaba","vfma","vfms","vqdmla","vqdmls","vqrdmla","vqrdmls","vsdot","vudot","vusdot","vsmmla","vummla","vusmmla","vpadal","umlal","smlal","umaal","bfi"].iter().any(|prefix|name.starts_with(prefix)) || matches!(name,"vbit"|"vbif"|"vbsl") {Access::ReadWrite}else{Access::Write},
                OperandKind::SystemRegister(_) if name.starts_with("msr")||name.starts_with("vmsr")||name.starts_with("vmrs")&&i==0=>Access::Write,
                _=>Access::Read
            };
            if let OperandKind::Register(r)|OperandKind::SystemRegister(r)=op.kind {
                if op.access.is_readable()&&!details.reads.contains(&r) {details.reads.push(r)}
                if op.access.is_writable()&&!details.writes.contains(&r) {details.writes.push(r)}
            }
            if let OperandKind::Memory(m)=op.kind {details.reads.push(m.base);if let Some(r)=m.index {details.reads.push(r)};if details.writeback {details.writes.push(m.base)}}
        }
        if self.update_flags() {details.writes.push(Register::Apsr)}
        if name.starts_with('v') && !name.starts_with("vmrs") && !name.starts_with("vmsr") {details.reads.push(Register::Fpscr);details.writes.push(Register::Fpscr)}
        if name.starts_with("bl") {details.writes.push(Register::Gpr(14))}
        details.operands=operands;
        Ok((text,details))
    }
}

/// Encode exact fields and serialize using instruction-state-aware byte order.
pub fn encode(encoding_id: &str, fields: &[(&str,u64)], endian: Endian) -> Result<Vec<u8>, encoders::EncodeError> {
    let word=encoders::encode_with_fields(encoding_id,fields)?;
    let form=&FORMS[FORMS.binary_search_by_key(&encoding_id,|f|f.id).map_err(|_|encoders::EncodeError::UnknownEncoding(encoding_id.into()))?];
    let half=|v:u16|match endian {Endian::Little=>v.to_le_bytes(),Endian::Big=>v.to_be_bytes()};
    Ok(if form.width==16 {half(word as u16).to_vec()} else if form.thumb {[half((word>>16) as u16),half(word as u16)].concat()} else {match endian {Endian::Little=>word.to_le_bytes(),Endian::Big=>word.to_be_bytes()}.to_vec()})
}

