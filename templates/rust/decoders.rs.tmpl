fn extract_field(word: u32, field: &FieldDef) -> u64 {
    let width = u32::from(field.end - field.start + 1);
    u64::from((word >> field.start) & low_mask(width))
}

fn low_mask(width: u32) -> u32 {
    if width >= 32 {
        u32::MAX
    } else {
        (1u32 << width) - 1
    }
}

fn eval_bitdiff(node: &BitDiff, word: u32) -> bool {
    match node {
        BitDiff::Always => true,
        BitDiff::And(children) => children.iter().all(|child| eval_bitdiff(child, word)),
        BitDiff::Not(child) => !eval_bitdiff(child, word),
        BitDiff::Atom { start, end, op, bits, alts } => {
            let width = u32::from(end - start + 1);
            let field = (word >> start) & low_mask(width);
            match op {
                BitDiffOp::Eq => matches_pattern(field, *bits),
                BitDiffOp::Ne => !matches_pattern(field, *bits),
                BitDiffOp::In => alts.iter().any(|pattern| matches_pattern(field, *pattern)),
            }
        }
    }
}

fn matches_pattern(field: u32, pattern: BitPattern) -> bool {
    field & pattern.mask == pattern.value
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn clrex_when_present() {
        // Architectural CLREX CRm=0xF; skip if encoding not in this generate set.
        if !TABLE.iter().any(|entry| entry.encoding_id == "CLREX_BN_barriers") {
            return;
        }
        let decoded = decode(0xD5033F5F).expect("decode CLREX");
        assert_eq!(decoded.encoding_id, "CLREX_BN_barriers");
        assert_eq!(decoded.field("CRm"), Some(0xF));
    }

    #[test]
    fn decision_tree_agrees_with_flat_matcher_on_fixed_words() {
        for entry in TABLE {
            let word = entry.value;
            let Ok(flat) = decode_table(word) else {
                continue;
            };
            let Ok(tree) = decode_tree(word) else {
                continue;
            };
            assert_eq!(tree.encoding_id, flat.encoding_id, "word 0x{word:08X}");
            assert_eq!(tree.ambiguous.len(), flat.ambiguous.len(), "word 0x{word:08X}");
            for peer in flat.ambiguous.iter() {
                assert!(tree.ambiguous.contains(peer), "word 0x{word:08X}: missing {peer}");
            }
        }
    }
}
