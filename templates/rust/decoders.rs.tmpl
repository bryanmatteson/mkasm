fn entry_matches(index: u16, word: u32) -> bool {
    let Some(entry) = TABLE.get(index as usize) else {
        return false;
    };
    entry.mask != 0
        && word & entry.mask == entry.value
        && entry.bitdiff.is_none_or(|constraint| eval_bitdiff(constraint, word))
}

fn better_entry(a: u16, b: u16) -> bool {
    let ea = &TABLE[a as usize];
    let eb = &TABLE[b as usize];
    let ba = ea.mask.count_ones();
    let bb = eb.mask.count_ones();
    if ba != bb {
        return ba > bb;
    }
    let aa = !ea.alias_of.is_empty();
    let ab = !eb.alias_of.is_empty();
    if aa != ab {
        return !aa && ab;
    }
    ea.encoding_id < eb.encoding_id
}

fn decoded_from(index: u16, word: u32, source: CandidateSource) -> Decoded {
    let entry = &TABLE[index as usize];
    Decoded {
        mnemonic: entry.mnemonic,
        asm_mnemonic: entry.asm_mnemonic,
        encoding_id: entry.encoding_id,
        class: entry.class,
        raw: word,
        alias_of: entry.alias_of,
        fields: Fields { raw: word, defs: entry.fields },
        ambiguous: Ambiguous { word, best: index, source },
    }
}

fn extract_field(word: u32, field: &FieldDef) -> u64 {
    let width = u32::from(field.end - field.start + 1);
    u64::from((word >> field.start) & low_mask(width))
}

fn low_mask(width: u32) -> u32 {
    if width >= 32 {
        u32::MAX
    } else {
        (1u32 << width) - 1
    }
}

fn eval_bitdiff(node: &BitDiff, word: u32) -> bool {
    match node {
        BitDiff::Always => true,
        BitDiff::And(children) => children.iter().all(|child| eval_bitdiff(child, word)),
        BitDiff::Not(child) => !eval_bitdiff(child, word),
        BitDiff::Atom { start, end, op, bits, alts } => {
            let width = u32::from(end - start + 1);
            let field = (word >> start) & low_mask(width);
            match op {
                BitDiffOp::Eq => matches_pattern(field, *bits),
                BitDiffOp::Ne => !matches_pattern(field, *bits),
                BitDiffOp::In => alts.iter().any(|pattern| matches_pattern(field, *pattern)),
            }
        }
    }
}

fn matches_pattern(field: u32, pattern: BitPattern) -> bool {
    field & pattern.mask == pattern.value
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn catalog_view_reopens_the_decoder_table_in_order() {
        assert_eq!(catalog_entry_count(), TABLE.len());
        assert!(catalog_entry(TABLE.len()).is_none());
        for (index, expected) in TABLE.iter().enumerate() {
            let entry = catalog_entry(index).expect("catalog index");
            assert_eq!(entry.ordinal, index as u32);
            assert_eq!(entry.mask, expected.mask);
            assert_eq!(entry.value, expected.value);
            assert_eq!(entry.mnemonic, expected.mnemonic);
            assert_eq!(entry.asm_mnemonic, expected.asm_mnemonic);
            assert_eq!(entry.encoding_id, expected.encoding_id);
            assert_eq!(entry.class, expected.class);
            assert_eq!(entry.alias_of, expected.alias_of);
        }
    }

    #[test]
    fn clrex_when_present() {
        // Architectural CLREX CRm=0xF; skip if encoding not in this generate set.
        if !TABLE.iter().any(|entry| entry.encoding_id == "CLREX_BN_barriers") {
            return;
        }
        let decoded = decode(0xD5033F5F).expect("decode CLREX");
        assert_eq!(decoded.encoding_id, "CLREX_BN_barriers");
        assert_eq!(decoded.field("CRm"), Some(0xF));
    }

    #[test]
    fn decision_tree_agrees_with_flat_matcher_on_fixed_words() {
        for entry in TABLE {
            let word = entry.value;
            let Ok(flat) = decode_table(word) else {
                continue;
            };
            let Ok(tree) = decode_tree(word) else {
                continue;
            };
            assert_eq!(tree.encoding_id, flat.encoding_id, "word 0x{word:08X}");
            assert_eq!(tree.ambiguous.len(), flat.ambiguous.len(), "word 0x{word:08X}");
            for peer in flat.ambiguous.iter() {
                assert!(tree.ambiguous.contains(peer), "word 0x{word:08X}: missing {peer}");
            }
        }
    }
}

#[cfg(test)]
mod field_lookup_tests {
    use super::*;
    #[test]
    fn rejection_keys_preserve_colliding_names_and_layout() {
        assert_eq!(field_key("field499"),field_key("field1210"));
        static DEFS:&[FieldDef]=&[
            FieldDef{name:"field499",key:field_key("field499"),start:0,end:3},
            FieldDef{name:"field1210",key:field_key("field1210"),start:4,end:7},
        ];
        let fields=Fields{raw:0xa5,defs:DEFS};
        assert_eq!(fields.get("field499"),Some(5));
        assert_eq!(fields.get("field1210"),Some(10));
        assert_eq!(fields.get("missing"),None);
        assert!(std::mem::size_of::<FieldDef>()<=std::mem::size_of::<(&str,u8,u8)>());
    }
}

#[cfg(test)]
mod priority_tests {
    use super::*;
    fn reference(word:u32,source:CandidateSource)->Option<u16> {
        let mut best=None;
        for pos in 0..source.len(){let candidate=source.get(pos).unwrap();
            if entry_matches(candidate,word)&&best.is_none_or(|current|better_entry(candidate,current)){best=Some(candidate);}
        }best
    }
    fn check(word:u32){
        let expected=reference(word,CandidateSource::All);
        assert_eq!(decode_table(word).ok().map(|d|d.ambiguous.best),expected,"{word:08x}");
        if let Ok(d)=decode_tree(word){
            assert_eq!(Some(d.ambiguous.best),reference(word,d.ambiguous.source),"{word:08x}");
            // Preserve the original view order, including overlapping forms.
            let mut actual=d.ambiguous.iter();
            for pos in 0..d.ambiguous.source.len(){let i=d.ambiguous.source.get(pos).unwrap();
                if i!=d.ambiguous.best&&entry_matches(i,word){assert_eq!(actual.next(),Some(TABLE[i as usize].encoding_id));}
            }assert_eq!(actual.next(),None);
        }
    }
    #[test]
    fn preferred_selection_preserves_flat_ranking_and_ambiguity_order(){
        for entry in TABLE {for pattern in [0,u32::MAX,0x55555555,0xaaaaaaaa]{check(entry.value|(!entry.mask&pattern));}}
        let mut random=0x51f7825cu32;for _ in 0..4096{random=random.wrapping_mul(1664525).wrapping_add(1013904223);check(random);}
    }
