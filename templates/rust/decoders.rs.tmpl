/// Decode a 32-bit instruction word through the generated decision tree.
///
/// Valid encodings normally resolve in O(tree depth). The flat matcher remains
/// as a correctness-preserving fallback for tree misses and provisional input.
/// Decoding and field access allocate no heap memory.
pub fn decode(word: u32) -> Result<Decoded, DecodeError> {
    decode_tree(word).or_else(|_| decode_table(word))
}

fn decode_tree(word: u32) -> Result<Decoded, DecodeError> {
    let mut node_index = ROOT.ok_or(DecodeError::NoMatch(word))? as usize;
    loop {
        let node = NODES.get(node_index).ok_or(DecodeError::NoMatch(word))?;
        if node.candidate_len != 0 {
            let start = node.candidate_start as usize;
            let end = start + node.candidate_len as usize;
            let candidates = CANDIDATES.get(start..end).ok_or(DecodeError::NoMatch(word))?;
            return resolve(word, CandidateSource::Leaf(candidates));
        }

        let start = node.edge_start as usize;
        let end = start + node.edge_len as usize;
        let edges = EDGES.get(start..end).ok_or(DecodeError::NoMatch(word))?;
        let key = word & node.mask;
        let edge = edges
            .binary_search_by_key(&key, |edge| edge.value)
            .ok()
            .and_then(|index| edges.get(index))
            .ok_or(DecodeError::NoMatch(word))?;
        node_index = edge.node as usize;
    }
}

fn decode_table(word: u32) -> Result<Decoded, DecodeError> {
    resolve(word, CandidateSource::All)
}

fn resolve(word: u32, source: CandidateSource) -> Result<Decoded, DecodeError> {
    let mut best: Option<u16> = None;
    for pos in 0..source.len() {
        let candidate = source.get(pos).expect("candidate position is in range");
        if !entry_matches(candidate, word) {
            continue;
        }
        if best.is_none_or(|current| better_entry(candidate, current)) {
            best = Some(candidate);
        }
    }
    let best = best.ok_or(DecodeError::NoMatch(word))?;
    Ok(decoded_from(best, word, source))
}

fn entry_matches(index: u16, word: u32) -> bool {
    let Some(entry) = TABLE.get(index as usize) else {
        return false;
    };
    entry.mask != 0
        && word & entry.mask == entry.value
        && entry.bitdiff.is_none_or(|constraint| eval_bitdiff(constraint, word))
}

fn better_entry(a: u16, b: u16) -> bool {
    let ea = &TABLE[a as usize];
    let eb = &TABLE[b as usize];
    let ba = ea.mask.count_ones();
    let bb = eb.mask.count_ones();
    if ba != bb {
        return ba > bb;
    }
    let aa = !ea.alias_of.is_empty();
    let ab = !eb.alias_of.is_empty();
    if aa != ab {
        return !aa && ab;
    }
    ea.encoding_id < eb.encoding_id
}

fn decoded_from(index: u16, word: u32, source: CandidateSource) -> Decoded {
    let entry = &TABLE[index as usize];
    Decoded {
