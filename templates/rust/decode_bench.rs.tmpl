use std::alloc::{GlobalAlloc, Layout, System};
use std::hint::black_box;
use std::sync::atomic::{AtomicUsize, Ordering};
use std::time::Instant;

struct CountingAllocator;
static ALLOCATIONS: AtomicUsize = AtomicUsize::new(0);

unsafe impl GlobalAlloc for CountingAllocator {
    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
        ALLOCATIONS.fetch_add(1, Ordering::Relaxed);
        unsafe { System.alloc(layout) }
    }

    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
        unsafe { System.dealloc(ptr, layout) }
    }

    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, size: usize) -> *mut u8 {
        ALLOCATIONS.fetch_add(1, Ordering::Relaxed);
        unsafe { System.realloc(ptr, layout, size) }
    }
}

#[global_allocator]
static ALLOCATOR: CountingAllocator = CountingAllocator;

const WORDS: &[u32] = &[
    0xD503_201F, // nop
    0xD65F_03C0, // ret
    0x1400_0000, // b .
    0x9400_0000, // bl .
    0x9100_0400, // add x0, x0, #1
    0xF940_0420, // ldr x0, [x1, #8]
    0xB900_0020, // str w0, [x1]
    0x1000_0000, // adr x0, .
    0x9000_0000, // adrp x0, .
    0x5400_0000, // b.eq .
    0xB400_0000, // cbz x0, .
    0xD61F_0200, // br x16
    0xD63F_0200, // blr x16
];

fn main() {
    let iterations = std::env::args()
        .nth(1)
        .and_then(|value| value.parse().ok())
        .unwrap_or(1_000_000usize);
    for &word in WORDS {
        black_box({{.CrateName}}::decode(word).expect("benchmark word decodes"));
    }

    ALLOCATIONS.store(0, Ordering::Relaxed);
    let start = Instant::now();
    let mut checksum = 0usize;
    for index in 0..iterations {
        let word = WORDS[index % WORDS.len()];
        let decoded = black_box({{.CrateName}}::decode(black_box(word)).expect("decode"));
        checksum ^= decoded.encoding_id.len();
        checksum ^= decoded.field("Rd").unwrap_or(0) as usize;
    }
    let elapsed = start.elapsed();
    println!(
        "iterations={iterations} elapsed_ns={} ns_per_decode={:.2} allocations={} checksum={checksum}",
        elapsed.as_nanos(),
        elapsed.as_nanos() as f64 / iterations as f64,
        ALLOCATIONS.load(Ordering::Relaxed),
    );
}
