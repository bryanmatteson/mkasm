#[cfg(test)]
mod format_reuse_tests {
    use super::*;
    use std::alloc::{GlobalAlloc,Layout,System};
    use std::cell::Cell;
    struct CountingAllocator;
    thread_local!{static CALLS:Cell<Option<usize>>=const{Cell::new(None)};}
    fn count_allocation(){let _=CALLS.try_with(|count|{if let Some(n)=count.get(){count.set(Some(n+1))}});}
    unsafe impl GlobalAlloc for CountingAllocator {
        unsafe fn alloc(&self,l:Layout)->*mut u8{count_allocation();unsafe{System.alloc(l)}}
        unsafe fn alloc_zeroed(&self,l:Layout)->*mut u8{count_allocation();unsafe{System.alloc_zeroed(l)}}
        unsafe fn dealloc(&self,p:*mut u8,l:Layout){unsafe{System.dealloc(p,l)}}
        unsafe fn realloc(&self,p:*mut u8,l:Layout,n:usize)->*mut u8{count_allocation();unsafe{System.realloc(p,l,n)}}
    }
    #[global_allocator]static ALLOC:CountingAllocator=CountingAllocator;
    fn without_allocations(f:impl FnOnce()) {
        CALLS.with(|c|c.set(Some(0)));f();
        let calls=CALLS.with(|c|c.replace(None).unwrap());
        assert_eq!(calls,0,"reusable formatting allocated");
    }

    #[test]
    fn reusable_formatting_covers_all_forms_and_error_paths() {
        let mut output=String::with_capacity(4096);
        let mut checked=0;
        for form in FORMS {
            for pattern in [0,u32::MAX,0x55555555,0xaaaaaaaa] {
                let word=form.value|(!form.mask&pattern);
                let expected=format(word,0x1234);
                output.clear();output.push_str("stale output");
                let mut result=Ok(());
                without_allocations(||{result=format_into(word,0x1234,&mut output);});
                assert_eq!(result,expected.as_ref().map(|_|()).map_err(|e|*e),"{word:08x}");
                assert_eq!(output,expected.as_deref().unwrap_or(""),"{word:08x}");
                if let Ok(decoded)=crate::decode(word) {
                    without_allocations(||{result=decoded.format_into(0x1234,&mut output);});
                    assert_eq!(result,expected.as_ref().map(|_|()).map_err(|e|*e));
                }
                let mut empty=String::new();
                assert_eq!(format_into(word,0x1234,&mut empty),result);
                assert_eq!(empty,output);
                checked+=1;
            }
        }
        assert_eq!(checked,FORMS.len()*4);
    }
    #[test]
    fn unknown_owned_formatting_keeps_its_allocation_free_error_path() {
        for word in [0,u32::MAX,0x02000000] {
            if analysis::selected_form(word).is_none() {
                let mut result=Ok(String::new());
                without_allocations(||{result=format(word,0);});
                assert_eq!(result,Err(FormatError::Unknown(word)));
            }
        }
    }
    #[test]
    fn unicode_normalization_and_symbols_reuse_the_buffer() {
        for input in [" \u{a0} A \u{2003} é ","İ \t (a|b)  ","a\x0bb"] {
            let expected=input.split_whitespace().collect::<Vec<_>>().join(" ");
            let mut output=input.to_string();
            without_allocations(||{output=collapse_space(std::mem::take(&mut output));});
            assert_eq!(output,expected);
        }
        for (input,expected) in [(" (A|B) ","a"),("LSL|LSR","lsr"),("A|B","a"),(" é ","é")] {
            let mut output=String::with_capacity(64);
            without_allocations(||write_canonical_symbol(input,&mut output));
            assert_eq!(output,expected);
        }
    }
}

#[cfg(test)]
mod group_cache_tests {
    use super::*;
    // Preserve the uncached traversal as an independent oracle for nested,
    // required and defaulted groups throughout the imported instruction set.
    fn reference(form:&Form,word:u32,out:&mut String)->Option<()> {
        let mut skipped=[false;32];
        for part in form.parts {if part.group!=0&&(part.group as usize)<32 {
            skipped[part.group as usize]=group_omitted(form,part.group,word);
        }}
        for part in form.parts {
            if part.group!=0&&(skipped[part.group as usize]||ancestor_skipped(form,part.group,&skipped)){continue;}
            if let Some(op)=part.operand.as_ref(){render_operand_into(op,word,out)?;}else{out.push_str(part.literal);}
        }
        *out=canonical_alternatives(collapse_space(std::mem::take(out)));
        out.truncate(out.trim_end().len());Some(())
    }
    #[test]
    fn cached_groups_preserve_every_form() {
        let mut expected=String::new();let mut actual=String::new();
        for form in FORMS {for pattern in [0,u32::MAX,0x55555555,0xaaaaaaaa] {
            let word=form.value|(!form.mask&pattern);expected.clear();actual.clear();
            let want=reference(form,word,&mut expected);let got=render_form_into(form,word,&mut actual);
            assert_eq!(got,want,"{} {word:08x}",form.encoding_id);
            assert_eq!(actual,expected,"{} {word:08x}",form.encoding_id);
        }}
    }
}
