//! A64 text assembler and instruction templates, generated by mkasm.
//!
//! This module is the inverse of the formatter: it reads the formatter's own
//! `FORMS` table (every encoding's ARM assembly template, operand bit
//! placement and alias predicate) instead of a second copy of that data, so
//! the text it accepts cannot drift from the text the formatter prints.
//!
//! * [`assemble`] turns one line of assembly into every encoding of it,
//!   preferred encoding first.
//! * [`Template`] is the same text with operands left open. `$name` leaves one
//!   operand open (`${name}` when an identifier character follows),
//!   `$name:class` restricts it to one [`OperandClass`], `_` matches any single
//!   operand without binding it, and a name used twice must bind equal values.
//!   A template denotes the set of words, over every canonical or alias form
//!   whose syntax the text fits, that the form produces for some assignment of
//!   its holes. [`Template::matches`] tests membership and binds the holes;
//!   [`Template::encode`] enumerates the set for given hole values.
//!
//! PC-relative operands are byte displacements from the instruction, spelled
//! `.+N`, `.-N` or `.` (as the formatter prints them). A bare number is an
//! absolute target: [`assemble_at`] converts it with the instruction's
//! address, and [`assemble`] and [`Template::parse`] use address 0.
//!
//! Operand classes:
//!
//! | class | value |
//! |---|---|
{{.ClassDocs}}
use super::*;
use std::fmt;
use std::sync::OnceLock;

// ---------------------------------------------------------------------------
// Operand classes and values
// ---------------------------------------------------------------------------

/// The class of an operand value. A value plus its class has exactly one
/// spelling: [`OperandClass::format_value`].
#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd, Hash)]
pub enum OperandClass {
{{.ClassVariants}}}

impl OperandClass {
    /// Every class, in declaration order.
    pub const ALL: &'static [OperandClass] = &[{{.ClassAll}}];

    /// Every class name, in [`OperandClass::ALL`] order.
    pub fn names() -> &'static [&'static str] { &[{{.ClassNameList}}] }

    /// Whether values of this class are register numbers.
    pub fn is_register(self) -> bool { register_bank(self).is_some() }

    /// Whether a value of this class is a plain integer the user reads as a
    /// number: an immediate, an amount or index, or a PC-relative
    /// displacement. Registers, named sets (condition, arrangement, extend,
    /// shift, system register, ...) and floating-point bit patterns are not.
    pub fn is_integer(self) -> bool { matches!(self, {{.ClassInteger}}) }

    /// The class's own value range, in the model `matches` yields: the register
    /// numbers, the widest numeric field any form gives an immediate or a label
    /// (`exact` false: it is a bound over forms), the symbol indices of a named
    /// set, `fpimm`'s 64-bit patterns and `imm_hex`'s 64-bit values (bounds).
    /// `exact` here means every value in range has a spelling.
    pub fn domain(self) -> Domain {
        use OperandClass as C;
        if let Some((_, max)) = register_bank(self) { return Domain::new(0, max, 1, true); }
        match self {
            C::Imm => class_domains()[0],
            C::Label => class_domains()[1],
            C::ImmHex => WIDE,
            C::FpImm => Domain::new(0, (1i128 << 64) - 1, 1, false),
            C::SysReg => Domain::new(0, (1 << 16) - 1, 1, true),
            C::CReg => Domain::new(0, 15, 1, true),
            C::Cond => Domain::new(0, 15, 1, true),
            C::TileMask => Domain::new(0, 255, 1, true),
            _ => Domain::new(0, self.symbols().len() as i128 - 1, 1, true),
        }
    }

    /// One line saying what the class is and how its value is numbered.
    pub fn summary(self) -> &'static str {
        match self {
{{.ClassSummary}}        }
    }

    /// The stable lower-case name used by `$hole:class`.
    pub fn name(self) -> &'static str {
        match self {
{{.ClassNames}}        }
    }

    /// The class named `name` (case-insensitive).
    pub fn from_name(name: &str) -> Option<Self> {
        Self::ALL.iter().copied().find(|class| class.name().eq_ignore_ascii_case(name))
    }

    /// The vocabulary of a symbolic class, indexed by value. Empty for
    /// numeric and register classes.
    pub fn symbols(self) -> &'static [&'static str] {
        match self {
{{.SymbolTables}}            _ => &[],
        }
    }

    /// Parse one operand of this class, in the syntax the formatter prints
    /// (case-insensitive, `#` optional). Labels are displacements.
    pub fn parse_value(self, text: &str) -> Option<i128> {
        let input = lex(text).ok()?;
        if !input.holes.is_empty() || input.has_wild { return None; }
        let b = &input.b;
        let (value, end) = parse_class_value(self, b, skip_hash(b, 0).0)?;
        (end == b.len()).then_some(value)
    }

    /// Spell a value of this class as the formatter does. `None` when the
    /// value is outside the class.
    pub fn format_value(self, value: i128) -> Option<String> {
        use OperandClass as C;
        if let Some((_, max)) = register_bank(self) {
            if value < 0 || value > max { return None; }
            return register_name(self.name(), value as u64);
        }
        match self {
            C::Imm => Some(value.to_string()),
            C::ImmHex => Some(if value < 0 { format!("-0x{:x}", -value) } else { format!("0x{value:x}") }),
            C::Label => Some(if value < 0 { format!(".-{}", -value) } else { format!(".+{value}") }),
            C::FpImm => {
                if !(0..=u64::MAX as i128).contains(&value) { return None; }
                Some(format!("{}", f64::from_bits(value as u64)))
            }
            C::SysReg => {
                if !(0..1 << 16).contains(&value) { return None; }
                let v = value as u32;
                Some(format!("s{}_{}_c{}_c{}_{}", v >> 14 & 3, v >> 11 & 7, v >> 7 & 15, v >> 3 & 15, v & 7))
            }
            C::CReg => (0..16).contains(&value).then(|| format!("c{value}")),
            C::TileMask => {
                if !(0..256).contains(&value) { return None; }
                let mut out = String::new();
                for index in 0..8 {
                    if value & (1 << index) != 0 {
                        if !out.is_empty() { out.push_str(", "); }
                        out.push_str(&format!("za{index}.d"));
                    }
                }
                Some(out)
            }
            _ => {
                let symbols = self.symbols();
                usize::try_from(value).ok().and_then(|index| symbols.get(index)).map(|s| s.to_string())
            }
        }
    }
}

/// How an operand value relates to where its instruction sits.
#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd, Hash)]
pub enum Position {
    /// The value does not depend on the instruction's address.
    Fixed,
    /// The target is the address of the instruction's first byte plus the value.
    InstructionRelative,
    /// The target is the instruction's address with the low `shift` bits
    /// cleared, plus the value (A64 `ADRP`: `shift` is 12).
    PageRelative { shift: u8 },
}

impl Position {
    /// Whether the value is an offset from the instruction's address.
    pub fn is_position_dependent(self) -> bool { self != Position::Fixed }

    /// The address a value of this position denotes for an instruction at
    /// `address`; `None` for [`Position::Fixed`] and when the result leaves
    /// the 64-bit address space.
    pub fn target(self, address: u64, value: i128) -> Option<u64> { target(self, address, value) }

    /// The value that makes an instruction at `address` reach `target`.
    pub fn value_for_target(self, address: u64, target: u64) -> Option<i128> { value_for_target(self, address, target) }
}

/// The address `value` denotes under `position` for an instruction at
/// `address`: `address + value` (instruction-relative) or
/// `(address & !(2^shift - 1)) + value` (page-relative). `None` for
/// [`Position::Fixed`], for a shift of 64 or more, and when the result is
/// outside `0..=u64::MAX`.
pub fn target(position: Position, address: u64, value: i128) -> Option<u64> {
    let base = match position {
        Position::Fixed => return None,
        Position::InstructionRelative => i128::from(address),
        Position::PageRelative { shift } => i128::from(address & !page_mask(shift)?),
    };
    u64::try_from(base.checked_add(value)?).ok()
}

/// The value that makes an instruction at `address` reach `target`: the
/// inverse of [`target`]. `None` for [`Position::Fixed`] and for a page-relative
/// target that is not aligned to the page (a page-relative operand reaches only
/// page starts). Whether the form can encode the value (range, a branch
/// target's 4-byte alignment) is the encoder's decision.
pub fn value_for_target(position: Position, address: u64, target: u64) -> Option<i128> {
    match position {
        Position::Fixed => None,
        Position::InstructionRelative => Some(i128::from(target) - i128::from(address)),
        Position::PageRelative { shift } => {
            let mask = page_mask(shift)?;
            (target & mask == 0).then(|| i128::from(target) - i128::from(address & !mask))
        }
    }
}

fn page_mask(shift: u8) -> Option<u64> { (shift < 64).then(|| (1u64 << shift) - 1) }

// ---------------------------------------------------------------------------
// Value domains
// ---------------------------------------------------------------------------

/// The values an operand can hold, in the model `matches` yields and `encode`
/// takes: `min + k * step` for `k >= 0`, up to `max`. `exact` means every
/// value described encodes (with the template's other operands as written or
/// as in the instruction the hole came from); `false` means only that a value
/// outside the domain cannot encode (a necessary bound).
#[derive(Clone, Copy, Debug, Eq, PartialEq, Hash)]
pub struct Domain {
    pub min: i128,
    pub max: i128,
    pub step: i128,
    pub exact: bool,
}

impl Domain {
    /// A domain of `min..=max` by `step`; `max` is lowered to the last
    /// reachable value and a single value gets step 1.
    pub fn new(min: i128, max: i128, step: i128, exact: bool) -> Domain {
        let step = step.max(1);
        let max = if max > min { min + (max - min) / step * step } else { min };
        Domain { min, max, step: if max == min { 1 } else { step }, exact }
    }

    /// Whether `value` is one of the domain's values.
    pub fn contains(&self, value: i128) -> bool {
        (self.min..=self.max).contains(&value) && (value - self.min) % self.step == 0
    }

    /// Whether every value of `other` is a value of `self`.
    pub fn covers(&self, other: &Domain) -> bool {
        if other.min == other.max { return self.contains(other.min); }
        self.min <= other.min && other.max <= self.max && other.step % self.step == 0 && (other.min - self.min) % self.step == 0
    }
}

/// A [`Domain`] for one class of a hole.
#[derive(Clone, Copy, Debug, Eq, PartialEq, Hash)]
pub struct ClassDomain {
    pub class: OperandClass,
    pub domain: Domain,
}

fn gcd(a: i128, b: i128) -> i128 { if b == 0 { a.abs() } else { gcd(b, a % b) } }

/// Add `domain` to the entries for `class`: dropped when an entry already
/// covers it, replacing entries it covers, and joined with an entry of the same
/// step and exactness that it overlaps or touches.
fn add_domain(list: &mut Vec<ClassDomain>, class: OperandClass, mut domain: Domain) {
    loop {
        let mut changed = false;
        let mut index = 0;
        while index < list.len() {
            let entry = list[index];
            if entry.class != class { index += 1; continue; }
            let old = entry.domain;
            if old.covers(&domain) && (old.exact || !domain.exact) { return; }
            if domain.covers(&old) && (domain.exact || !old.exact) { list.remove(index); changed = true; continue; }
            if old.exact == domain.exact && old.step == domain.step && old.min != old.max && domain.min != domain.max
                && (old.min - domain.min) % old.step == 0
                && domain.min <= old.max + old.step && old.min <= domain.max + old.step {
                list.remove(index);
                domain = Domain::new(old.min.min(domain.min), old.max.max(domain.max), old.step, old.exact);
                changed = true;
                continue;
            }
            index += 1;
        }
        if !changed { break; }
    }
    list.push(ClassDomain { class, domain });
}

/// The 64-bit patterns: a hexadecimal immediate may be spelled negative.
const WIDE: Domain = Domain { min: -(1i128 << 63), max: (1i128 << 64) - 1, step: 1, exact: false };

fn class_domains() -> &'static [Domain] {
    static DOMAINS: OnceLock<Vec<Domain>> = OnceLock::new();
    DOMAINS.get_or_init(|| {
        // The widest numeric field any form gives an immediate or a label.
        let (mut imm, mut label): (Option<Domain>, Option<Domain>) = (None, None);
        let widen = |slot: &mut Option<Domain>, found: Domain| {
            *slot = Some(match *slot {
                None => found,
                Some(old) => Domain::new(old.min.min(found.min), old.max.max(found.max), gcd(old.step, found.step), false),
            });
        };
        for form in FORMS {
            for part in form.parts {
                let Some(op) = &part.operand else { continue };
                let Some(class) = base_class(op) else { continue };
                if !matches!(op.kind, Kind::Num) || op.has_num_constant { continue; }
                let Some((min, max, step)) = num_range(op) else { continue };
                let found = Domain::new(min, max, step, false);
                match class { OperandClass::Imm => widen(&mut imm, found), OperandClass::Label => widen(&mut label, found), _ => {} }
            }
        }
        vec![imm.unwrap_or(WIDE), label.unwrap_or(WIDE)]
    })
}

/// The range an unconstrained numeric field holds: (min, max, step).
fn num_range(op: &OperandDef) -> Option<(i128, i128, i128)> {
    let width = u32::from(total_width(op));
    if width == 0 || width > 62 || op.scale == 0 { return None; }
    let (low, high) = if op.negate != 0 { (0i128, (1i128 << width) - 1) }
        else if op.signed { (-(1i128 << (width - 1)), (1i128 << (width - 1)) - 1) }
        else { (0, (1i128 << width) - 1) };
    let value = |raw: i128| {
        let mut value = if op.negate != 0 { i128::from(op.negate) - raw } else { raw + i128::from(op.bias) };
        if op.raw_mul != 0 { value *= i128::from(op.raw_mul); }
        value * i128::from(op.scale)
    };
    let (a, b) = (value(low), value(high));
    let (mut min, mut max) = (a.min(b), a.max(b));
    let step = (i128::from(op.raw_mul.max(1)) * i128::from(op.scale)).abs().max(1);
    if op.has_range {
        if min < i128::from(op.lo) { min += (i128::from(op.lo) - min + step - 1) / step * step; }
        max = max.min(i128::from(op.hi));
    }
    (min <= max).then_some((min, max, step))
}

/// The bits of `form` that decide whether a word is in the form's set beyond
/// its fixed opcode: equalities, inequalities, one-hot masks, forbidden and
/// disjunctive masks, and the alias guards.
fn constraint_bits(form: &Form) -> u32 {
    let range = |start: u8, end: u8| low_mask(end - start + 1) << start;
    let part = |part: &BitPart| if part.is_lit { 0 } else { low_mask(part.width) << part.start as u8 };
    let mut bits = 0u32;
    for eq in form.equalities { bits |= range(eq.left_start, eq.left_end) | range(eq.right_start, eq.right_end); }
    for neq in form.inequalities { bits |= range(neq.left_start, neq.left_end) | range(neq.right_start, neq.right_end); }
    for mask in form.one_hot { bits |= mask; }
    for item in form.forbidden.iter().chain(form.any_of) { bits |= item.mask; }
    if let Some(guard) = form.move_wide_guard { bits |= part(&guard.imm16) | part(&guard.hw); }
    if let Some(guard) = form.logical_guard { bits |= part(&guard.sf) | part(&guard.n) | part(&guard.imms) | part(&guard.immr); }
    if let Some(guard) = form.bitfield_guard { bits |= part(&guard.imms) | part(&guard.immr); }
    if let Some(guard) = form.sve_mask { bits |= part(&guard); }
    bits
}

const ENUMERATE_BITS: u32 = 12;

/// The domains of operand `op` of `form` for values of `want` (any class when
/// `None`), given the bits the text fixes (`known`). Numeric fields come from
/// their arithmetic; everything else by decoding every setting of its free bits.
fn op_domains(form: &Form, info: &OpInfo, want: Option<OperandClass>, known: (u32, u32)) -> Vec<Domain> {
    let def = info.op;
    let bits = op_bits(def);
    let (known_mask, known_value) = known;
    let constrained = bits & (known_mask & !form.mask) != 0 || bits & constraint_bits(form) != 0 || def.when_mask & bits != 0
        || def.parts.iter().chain(def.cols).any(|part| part.is_lit);
    let kind_exact = matches!(def.kind, Kind::Reg | Kind::Num | Kind::Table | Kind::Literal | Kind::Derived | Kind::Formula | Kind::ElementIndex | Kind::TileMask | Kind::BitfieldWidth);
    let exact = kind_exact && !constrained;
    if matches!(def.kind, Kind::Num) && !def.has_num_constant {
        return match num_range(def) {
            Some((min, max, step)) => vec![Domain::new(min, max, step, exact)],
            None => Vec::new(),
        };
    }
    let unknown = bits & !known_mask;
    // Too wide to enumerate (bitmask, move-wide and floating-point immediates,
    // system registers): the class's own range, as a bound.
    if unknown.count_ones() > ENUMERATE_BITS {
        let class = want.unwrap_or_else(|| info.static_class());
        let mut bound = class.domain();
        bound.exact = false;
        return vec![bound];
    }
    let mut values: Vec<i128> = Vec::new();
    let mut subset = 0u32;
    loop {
        let word = known_value & known_mask | subset;
        if let Some(dec) = info.decode(word) {
            if want.is_none_or(|class| dec.class == class) { values.push(dec.value); }
        }
        if subset == unknown { break; }
        subset = subset.wrapping_sub(unknown) & unknown;
    }
    values.sort_unstable();
    values.dedup();
    let (Some(&min), Some(&max)) = (values.first(), values.last()) else { return Vec::new() };
    let step = values.windows(2).fold(0, |step, pair| gcd(step, pair[1] - pair[0])).max(1);
    let full = values.len() as i128 == (max - min) / step + 1;
    vec![Domain::new(min, max, step, exact && full)]
}

/// One operand value: a class and a number in that class's value model
/// (register number, integer, displacement, symbol index, ...), plus how the
/// value relates to the instruction's position. A label is a byte offset from
/// the instruction ([`Position::InstructionRelative`]) except `ADRP`'s, which
/// is a page offset ([`Position::PageRelative`]); every other value is
/// [`Position::Fixed`]. Encoding ignores `position`.
#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd, Hash)]
pub struct OperandValue {
    pub class: OperandClass,
    pub value: i128,
    pub position: Position,
}

impl OperandValue {
    /// A value with its class's usual position: a label is instruction-relative,
    /// everything else fixed. Use [`OperandValue::with_position`] for `ADRP`'s.
    pub const fn new(class: OperandClass, value: i128) -> Self {
        let position = match class { OperandClass::Label => Position::InstructionRelative, _ => Position::Fixed };
        Self { class, value, position }
    }
    /// The same value with another position.
    pub const fn with_position(self, position: Position) -> Self { Self { position, ..self } }
    /// Parse `text` as a value of `class` ([`OperandClass::parse_value`]).
    pub fn parse(class: OperandClass, text: &str) -> Option<Self> {
        class.parse_value(text).map(|value| Self::new(class, value))
    }
}

impl fmt::Display for OperandValue {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self.class.format_value(self.value) {
            Some(text) => f.write_str(&text),
            None => write!(f, "<{} {}>", self.class.name(), self.value),
        }
    }
}

const PLACEHOLDER: OperandValue = OperandValue::new(OperandClass::Imm, 0);

/// The position of a value of `class` decoded from `op`: a label is a byte
/// offset from the instruction, or from its page when the operand is scaled by
/// 4096 (`ADRP`).
fn position_of(op: &OperandDef, class: OperandClass) -> Position {
    match class {
        OperandClass::Label if op.scale == 4096 => Position::PageRelative { shift: 12 },
        OperandClass::Label => Position::InstructionRelative,
        _ => Position::Fixed,
    }
}

/// The register bank prefix and largest register number of a register class.
fn register_bank(class: OperandClass) -> Option<(&'static str, i128)> {
    use OperandClass as C;
    Some(match class {
        C::Gpr32 | C::Gpr32Sp => ("w", 31), C::Gpr64 | C::Gpr64Sp => ("x", 31),
        C::SimdB => ("b", 31), C::SimdH => ("h", 31), C::SimdS => ("s", 31), C::SimdD => ("d", 31),
        C::SimdQ => ("q", 31), C::SimdVec => ("v", 31), C::SveZ => ("z", 31),
        C::SveP => ("p", 15), C::SvePn => ("pn", 15), C::SmeTile => ("za", 15),
        _ => return None,
    })
}

/// The class a one-letter register bank names, as printed before a separately
/// encoded register number (`D<d>`, `V<m>`, `<R><m>`).
fn bank_letter_class(letter: u8, sp: bool) -> Option<OperandClass> {
    use OperandClass as C;
    Some(match letter {
        b'w' if sp => C::Gpr32Sp, b'x' if sp => C::Gpr64Sp,
        b'w' => C::Gpr32, b'x' => C::Gpr64, b'b' => C::SimdB, b'h' => C::SimdH, b's' => C::SimdS,
        b'd' => C::SimdD, b'q' => C::SimdQ, b'v' => C::SimdVec, b'z' => C::SveZ, b'p' => C::SveP,
        _ => return None,
    })
}

/// The value class of an operand definition (for a value table: the class of
/// its symbolic rows).
fn base_class(op: &OperandDef) -> Option<OperandClass> {
    match (op.kind, op.class, op.num_prefix) {
{{.BaseClassArms}}        _ => None,
    }
}

