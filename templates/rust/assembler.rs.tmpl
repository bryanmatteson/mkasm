/// Why no form accepted the operands.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum Mismatch {
    /// The operand text is not a value this operand accepts.
    InvalidOperand,
    /// The operand looks like a register but names none of this operand's bank.
    InvalidRegister,
    /// The text ended where the form needs another operand or separator.
    MissingOperand,
    /// The form is complete but text remains.
    ExtraText,
    /// Every operand parses but no word satisfies them together.
    Incompatible,
    /// A `$hole:class` restriction excludes this operand.
    HoleClass,
}

/// An assembler or template error. Variant names match the x86-64 crate's.
#[derive(Clone, Debug, Eq, PartialEq)]
pub enum AssembleError {
    /// Malformed input at byte `offset`.
    Syntax { offset: usize, message: &'static str },
    /// No form has this mnemonic; `nearest` lists the closest known ones.
    UnknownMnemonic { mnemonic: String, nearest: Vec<&'static str> },
    /// `$name:class` names no [`OperandClass`].
    UnknownClass { offset: usize, name: String },
    /// The text has too few (`missing`) or too many operands for every form
    /// of the mnemonic; `form` is the one the text followed furthest.
    OperandCount { mnemonic: String, form: &'static str, offset: usize, missing: bool },
    /// Forms with this mnemonic exist but none accepts the operands. `form` is
    /// the one whose syntax the text followed furthest, `operand` the operand
    /// that stopped it, `offset` the byte offset in the input.
    NoMatchingForm { mnemonic: String, form: &'static str, operand: Option<&'static str>, offset: usize, reason: Mismatch },
    /// The operand is well formed but no candidate form can encode its value.
    OperandOutOfRange { form: &'static str, operand: &'static str, text: String, offset: usize },
    /// `encode` was not given a value for this hole (`_` can never be encoded).
    UnboundHole { name: String },
    /// The value's class is not one the hole accepts.
    HoleClassMismatch { name: String, expected: Vec<OperandClass>, found: OperandClass },
    /// `encode` was given a different number of values than the template has holes.
    ValueCount { expected: usize, found: usize },
    /// The value is outside its class (a register number above 31, an unknown symbol index).
    InvalidValue { name: String, value: OperandValue },
    /// Never produced on A64: every PC-relative operand is a displacement, so
    /// no operand needs the instruction address. Present for parity with x86.
    RelativeNeedsAddress { operand: &'static str },
}

impl fmt::Display for AssembleError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Syntax { offset, message } => write!(f, "syntax error at byte {offset}: {message}"),
            Self::UnknownMnemonic { mnemonic, nearest } => {
                write!(f, "unknown mnemonic `{mnemonic}`")?;
                if !nearest.is_empty() { write!(f, " (nearest: {})", nearest.join(", "))?; }
                Ok(())
            }
            Self::UnknownClass { offset, name } => write!(f, "unknown operand class `{name}` at byte {offset}"),
            Self::OperandCount { mnemonic, form, offset, missing } => write!(f, "{mnemonic}: {} at byte {offset} (closest form {form})",
                if *missing { "missing operand" } else { "too many operands" }),
            Self::NoMatchingForm { mnemonic, form, operand, offset, reason } => {
                write!(f, "{mnemonic}: no form accepts these operands: closest is {form}")?;
                if let Some(operand) = operand { write!(f, ", operand {operand}")?; }
                write!(f, " at byte {offset} ({reason:?})")
            }
            Self::OperandOutOfRange { form, operand, text, offset } =>
                write!(f, "operand {operand} value `{text}` at byte {offset} is out of range for {form}"),
            Self::UnboundHole { name } => write!(f, "hole `{name}` has no value"),
            Self::HoleClassMismatch { name, expected, found } => {
                let names: Vec<&str> = expected.iter().map(|class| class.name()).collect();
                write!(f, "hole `{name}` takes {}, not {}", names.join("|"), found.name())
            }
            Self::ValueCount { expected, found } => write!(f, "template has {expected} holes, {found} values given"),
            Self::InvalidValue { name, value } => write!(f, "hole `{name}`: {} value {} is outside its class", value.class.name(), value.value),
            Self::RelativeNeedsAddress { operand } => write!(f, "operand {operand} needs the instruction address"),
        }
    }
}

impl std::error::Error for AssembleError {}

/// One open operand of a [`Template`].
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct Hole {
    name: String,
    restriction: Option<OperandClass>,
    classes: Vec<OperandClass>,
    position: Option<Position>,
    domains: Vec<ClassDomain>,
}

impl Hole {
    /// The hole's name, without `$`.
    pub fn name(&self) -> &str { &self.name }
    /// Every class the hole can bind across the candidate forms.
    pub fn classes(&self) -> &[OperandClass] { &self.classes }
    /// The `:class` restriction written in the template, if any.
    pub fn restriction(&self) -> Option<OperandClass> { self.restriction }
    /// Whether the hole can bind a value of `class`.
    pub fn accepts(&self, class: OperandClass) -> bool { self.classes.contains(&class) }
    /// How the values this hole binds relate to the instruction's position,
    /// known from the text alone; `None` when the candidate forms disagree.
    /// Every value a match binds carries the same [`OperandValue::position`].
    pub fn position(&self) -> Option<Position> { self.position }
    /// The values the hole can hold, per accepted class: the union over the
    /// candidate forms the text fits, computed when the template is parsed.
    /// One class has several entries when its forms differ in a way one
    /// progression cannot express. Every value `matches` binds lies in one,
    /// and an `exact` entry's values all encode; a value in no entry of its
    /// class is refused by `encode`.
    pub fn domains(&self) -> &[ClassDomain] { &self.domains }
}

/// One instruction's text with zero or more open operands, resolved to the
/// candidate forms (canonical or alias) whose syntax it fits.
#[derive(Clone)]
pub struct Template {
    text: String,
    holes: Vec<Hole>,
    restrict: Vec<Option<OperandClass>>,
    cands: Vec<Cand>,
    wildcard: bool,
    filters: Vec<(u32, u32)>,
}

/// Assemble one instruction: every encoding, preferred first.
pub fn assemble(text: &str) -> Result<Vec<u32>, AssembleError> { Template::parse(text)?.encode(&[]) }

/// Assemble one instruction at `address`; bare-number label operands are
/// absolute targets.
pub fn assemble_at(text: &str, address: u64) -> Result<Vec<u32>, AssembleError> {
    Template::parse_at(text, address)?.encode(&[])
}

impl fmt::Debug for Template {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_struct("Template").field("holes", &self.holes).field("encodings", &self.encodings()).finish()
    }
}

impl Template {
    /// Compile `text` (address 0 for absolute label targets).
    pub fn parse(text: &str) -> Result<Template, AssembleError> { Self::parse_at(text, 0) }

    /// Compile `text`; bare-number label operands are absolute targets
    /// relative to `address`.
    pub fn parse_at(text: &str, address: u64) -> Result<Template, AssembleError> {
        let input = lex(text)?;
        let forms = candidate_forms(&input)?;
        let mut cands = Vec::new();
        let mut fail = Failure::default();
        let mut range: Option<AssembleError> = None;
        for index in forms {
            let form = &FORMS[index];
            let info = form_info(index);
            let mut matcher = Matcher { form, input: &input, info, address, out: Vec::new(), fail: Failure::default() };
            matcher.walk(vec![(&info.ast[..], 0)], 0, &mut Interp::default());
            let interps = std::mem::take(&mut matcher.out);
            fail.merge(&matcher.fail, form);
            for interp in interps {
                match build_cand(form, info, interp, &input) {
                    Ok(Some(cand)) => {
                        if !cands.iter().any(|old: &Cand| old.same(&cand)) { cands.push(cand); }
                    }
                    Ok(None) => {}
                    Err(error) => { if range.is_none() { range = Some(error); } }
                }
            }
        }
        if cands.is_empty() {
            if let Some(error) = range { return Err(error); }
            let mnemonic = input.mnemonic();
            let form = fail.form.map_or("", |form| form.encoding_id);
            let offset = input.offset(fail.pos);
            return Err(match fail.reason {
                Mismatch::MissingOperand | Mismatch::ExtraText =>
                    AssembleError::OperandCount { mnemonic, form, offset, missing: fail.reason == Mismatch::MissingOperand },
                reason => AssembleError::NoMatchingForm { mnemonic, form, operand: fail.operand, offset, reason },
            });
        }
        for (order, cand) in cands.iter_mut().enumerate() { cand.order = order; }
        let mut holes: Vec<Hole> = input.holes.iter()
            .map(|spec| Hole { name: spec.name.clone(), restriction: spec.class, classes: Vec::new(), position: None, domains: Vec::new() }).collect();
        let mut seen: Vec<Option<Position>> = vec![None; holes.len()];
        let mut mixed = vec![false; holes.len()];
        for cand in &cands {
            for check in &cand.checks {
                let mut add = |hole: u8, class: OperandClass, position: Position| {
                    let list = &mut holes[hole as usize].classes;
                    if !list.contains(&class) { list.push(class); }
                    match seen[hole as usize] {
                        None => seen[hole as usize] = Some(position),
                        Some(old) => mixed[hole as usize] |= old != position,
                    }
                };
                match *check {
                    Check::Hole { op, hole, class } => match class {
                        Some(class) => add(hole, class, position_of(cand.info.op(op).op, class)),
                        None => for class in cand.info.op(op).classes() { add(hole, class, position_of(cand.info.op(op).op, class)) },
                    },
                    Check::FusedHole { table, hole, .. } => {
                        for class in cand.info.op(table).fused.iter().flatten() { add(hole, *class, Position::Fixed) }
                    }
                    _ => {}
                }
            }
        }
        let restrict: Vec<Option<OperandClass>> = input.holes.iter().map(|spec| spec.class).collect();
        for (hole, only) in holes.iter_mut().zip(&restrict) {
            if let Some(only) = only { hole.classes.retain(|class| class == only); }
            hole.classes.sort();
        }
        for (index, hole) in holes.iter_mut().enumerate() {
            hole.position = if mixed[index] { None } else { seen[index] };
        }
        let per_cand: Vec<Vec<(u32, u32)>> = cands.iter().map(cand_filters).collect();
        for (index, hole) in holes.iter_mut().enumerate() {
            hole.domains = hole_domains(&cands, &per_cand, index, input.holes.len() > 1);
            let classes = &hole.classes;
            hole.domains.retain(|entry| classes.contains(&entry.class));
        }
        let filters = word_filters(&per_cand);
        Ok(Template { text: text.to_string(), holes, restrict, cands, wildcard: input.has_wild, filters })
    }

    /// The open operands: distinct names in first-appearance order.
    pub fn holes(&self) -> &[Hole] { &self.holes }

    /// The domains of hole `index` ([`Hole::domains`]); empty when out of range.
    pub fn hole_domains(&self, index: usize) -> &[ClassDomain] { self.holes.get(index).map_or(&[], |hole| &hole.domains) }

    /// How hole `index` relates to the instruction's position
    /// ([`Hole::position`]); `None` when out of range or the forms disagree.
    pub fn hole_position(&self, index: usize) -> Option<Position> { self.holes.get(index)?.position }

    /// The text this template was compiled from.
    pub fn text(&self) -> &str { &self.text }

    /// A necessary condition for [`Template::matches`], computed once when the
    /// template is parsed: `(mask, value)` pairs such that every word the
    /// template matches satisfies `word & mask == value` for at least one pair.
    /// It holds the fixed opcode bits of every form the text can denote plus
    /// the operand fields the text itself fixes (`mov x0, $s` fixes Rd), with
    /// duplicates and refinements merged. Testing it allocates nothing.
    pub fn word_filters(&self) -> &[(u32, u32)] { &self.filters }

    /// Whether `word` passes [`Template::word_filters`]: a necessary condition
    /// for [`Template::matches`] that decodes nothing and allocates nothing.
    pub fn could_match(&self, word: u32) -> bool { self.filters.iter().any(|&(mask, value)| word & mask == value) }

    /// The encoding ids of the candidate forms, in table order.
    pub fn encodings(&self) -> Vec<&'static str> {
        let mut out: Vec<&'static str> = Vec::new();
        for cand in &self.cands { if !out.contains(&cand.form.encoding_id) { out.push(cand.form.encoding_id); } }
        out
    }

    /// Whether `word` is in the template's set. Clears `values`; on a match,
    /// pushes one value per hole, in [`Template::holes`] order. Does not format
    /// or allocate beyond growing `values`.
    pub fn matches(&self, word: u32, values: &mut Vec<OperandValue>) -> bool {
        values.clear();
        let base = 0;
        let count = self.holes.len();
        'cand: for cand in &self.cands {
            if !form_matches(cand.form, word) { continue; }
            values.truncate(base);
            values.resize(base + count, PLACEHOLDER);
            let mut bound = 0u64;
            for check in &cand.checks {
                let value = match *check {
                    Check::When { mask, value } => { if word & mask != value { continue 'cand; } continue; }
                    Check::Raw { op, want } => { if raw_value(cand.info.op(op).op, word) != want { continue 'cand; } continue; }
                    Check::AnySp { a, b } => { if word & a != a && word & b != b { continue 'cand; } continue; }
                    Check::Want { op, val } => match cand.info.op(op).decode(word) {
                        Some(dec) if val.accepts(dec) => continue,
                        _ => continue 'cand,
                    },
                    Check::Decodes { op } => { if cand.info.op(op).decode(word).is_none() { continue 'cand; } continue; }
                    Check::Hole { op, hole, class } => match cand.info.op(op).decode(word) {
                        Some(dec) => (hole, OperandValue::new(class.unwrap_or(dec.class), dec.value).with_position(dec.position)),
                        None => continue 'cand,
                    },
                    Check::FusedHole { table, num, hole } => {
                        let table_info = cand.info.op(table);
                        let Some(row) = first_row(table_info.op, word) else { continue 'cand };
                        let Some(class) = table_info.fused[row] else { continue 'cand };
                        let Some(dec) = cand.info.op(num).decode(word) else { continue 'cand };
                        (hole, OperandValue::new(class, dec.value))
                    }
                };
                let (hole, value) = value;
                if let Some(only) = self.restrict[hole as usize] { if only != value.class { continue 'cand; } }
                let slot = &mut values[base + hole as usize];
                if bound & (1 << hole) != 0 {
                    if *slot != value { continue 'cand; }
                } else {
                    *slot = value;
                    bound |= 1 << hole;
                }
            }
            debug_assert!(self.could_match(word),
                "word_filters rejects a word the template matches: {:?} 0x{word:08x}", self.text);
            return true;
        }
        values.truncate(base);
        false
    }

    /// Every word in the set for these hole values (one per hole, in
    /// [`Template::holes`] order): preferred encoding first, no duplicates.
    pub fn encode(&self, values: &[OperandValue]) -> Result<Vec<u32>, AssembleError> {
        if self.wildcard { return Err(AssembleError::UnboundHole { name: "_".into() }); }
        if values.len() < self.holes.len() {
            return Err(AssembleError::UnboundHole { name: self.holes[values.len()].name.clone() });
        }
        if values.len() > self.holes.len() {
            return Err(AssembleError::ValueCount { expected: self.holes.len(), found: values.len() });
        }
        for (hole, value) in self.holes.iter().zip(values) {
            if value.class.format_value(value.value).is_none() {
                return Err(AssembleError::InvalidValue { name: hole.name.clone(), value: *value });
            }
            if !hole.classes.contains(&value.class) {
                return Err(AssembleError::HoleClassMismatch {
                    name: hole.name.clone(), expected: hole.classes.clone(), found: value.class,
                });
            }
        }
        let mut found: Vec<(u8, u8, usize, usize, u32)> = Vec::new();
        let mut range: Option<AssembleError> = None;
        for cand in &self.cands {
            let Some(targets) = cand.targets(values) else { continue };
            let mut words = Vec::new();
            solve(cand, &targets, &mut words);
            if words.is_empty() {
                if range.is_none() { range = cand.out_of_range(&targets); }
                continue;
            }
            for (order, word) in words.into_iter().enumerate() {
                let (preferred, groups) = cand.rank(word);
                found.push((preferred, groups, cand.order, order, word));
            }
        }
        found.sort();
        let mut out: Vec<u32> = Vec::with_capacity(found.len());
        for (.., word) in found { if !out.contains(&word) { out.push(word); } }
        if out.is_empty() {
            if let Some(error) = range { return Err(error); }
            let cand = &self.cands[0];
            let mnemonic = lex(&self.text).map(|input| input.mnemonic()).unwrap_or_default();
            return Err(AssembleError::NoMatchingForm {
                mnemonic, form: cand.form.encoding_id, operand: None, offset: 0, reason: Mismatch::Incompatible,
            });
        }
        Ok(out)
    }
}

// ---------------------------------------------------------------------------
// Input
// ---------------------------------------------------------------------------

/// A hole marker byte is `1 + hole index`; `WILD` marks `_`.
const MAX_HOLES: usize = 29;
const WILD: u8 = 0x1e;

fn is_hole(byte: u8) -> bool { (1..=MAX_HOLES as u8).contains(&byte) }
fn is_word(byte: u8) -> bool { byte.is_ascii_alphanumeric() || byte == b'_' || (1..=WILD).contains(&byte) }

#[derive(Clone, Debug)]
struct HoleSpec { name: String, class: Option<OperandClass> }

/// Normalized input: lower case, whitespace kept only (as one space) between
/// two word characters, holes replaced by marker bytes. `#` is kept: it is
/// optional before any operand, and marks a label written as a displacement.
struct Input {
    text: String,
    b: Vec<u8>,
    offsets: Vec<usize>,
    holes: Vec<HoleSpec>,
    has_wild: bool,
    len: usize,
}

impl Input {
    fn offset(&self, pos: usize) -> usize { self.offsets.get(pos).copied().unwrap_or(self.len) }
    fn mnemonic(&self) -> String { self.b.iter().take_while(|c| c.is_ascii_alphanumeric()).map(|c| *c as char).collect() }
    /// The original text of normalized positions `start..end`.
    fn source(&self, start: usize, end: usize) -> String {
        let (from, to) = (self.offset(start), self.offset(end).max(self.offset(start)));
        self.text.get(from..to).unwrap_or("").trim().to_string()
    }
}

fn ident(byte: u8) -> bool { byte.is_ascii_alphanumeric() || byte == b'_' }

fn lex(text: &str) -> Result<Input, AssembleError> {
    let src = text.as_bytes();
    let mut input = Input { text: text.to_string(), b: Vec::with_capacity(src.len()), offsets: Vec::new(), holes: Vec::new(), has_wild: false, len: src.len() };
    let mut space = false;
    let mut i = 0;
    let push = |input: &mut Input, byte: u8, at: usize, space: &mut bool| {
        if *space && input.b.last().is_some_and(|last| is_word(*last)) && is_word(byte) {
            input.b.push(b' ');
            input.offsets.push(at);
        }
        *space = false;
        input.b.push(byte);
        input.offsets.push(at);
    };
    while i < src.len() {
        let c = src[i];
        if !c.is_ascii() || c < 0x20 && !c.is_ascii_whitespace() {
            return Err(AssembleError::Syntax { offset: i, message: "unexpected character" });
        }
        if c.is_ascii_whitespace() { space = true; i += 1; continue; }
        if c == b'/' && src.get(i + 1) == Some(&b'/') || c == b';' { break; }
        if c == b'$' {
            let start = i;
            i += 1;
            let braced = src.get(i) == Some(&b'{');
            if braced { i += 1; }
            let name_start = i;
            while i < src.len() && ident(src[i]) { i += 1; }
            if i == name_start {
                return Err(AssembleError::Syntax { offset: start, message: "`$` must be followed by a hole name" });
            }
            let name = &text[name_start..i];
            let mut class = None;
            if src.get(i) == Some(&b':') {
                let class_start = i + 1;
                let mut end = class_start;
                while end < src.len() && ident(src[end]) { end += 1; }
                // `:` followed by a name restricts the hole; `:` before a digit is
                // ARM's range syntax (`<offs1>:<offs2>`).
                match OperandClass::from_name(&text[class_start..end]) {
                    Some(found) => { class = Some(found); i = end; }
                    None if braced || src.get(class_start).is_some_and(u8::is_ascii_alphabetic) =>
                        return Err(AssembleError::UnknownClass { offset: class_start, name: text[class_start..end].to_string() }),
                    None => {}
                }
            }
            if braced {
                if src.get(i) != Some(&b'}') {
                    return Err(AssembleError::Syntax { offset: i, message: "expected `}` after hole name" });
                }
                i += 1;
            }
            let index = match input.holes.iter().position(|spec| spec.name == name) {
                Some(index) => {
                    let spec = &mut input.holes[index];
                    match (spec.class, class) {
                        (Some(a), Some(b)) if a != b =>
                            return Err(AssembleError::Syntax { offset: start, message: "hole restricted to two classes" }),
                        (None, Some(_)) => spec.class = class,
                        _ => {}
                    }
                    index
                }
                None => {
                    if input.holes.len() == MAX_HOLES {
                        return Err(AssembleError::Syntax { offset: start, message: "too many holes" });
                    }
                    input.holes.push(HoleSpec { name: name.to_string(), class });
                    input.holes.len() - 1
                }
            };
            push(&mut input, 1 + index as u8, start, &mut space);
            continue;
        }
        if c == b'_' && !(i > 0 && ident(src[i - 1])) && !src.get(i + 1).is_some_and(|next| ident(*next)) {
            input.has_wild = true;
            push(&mut input, WILD, i, &mut space);
            i += 1;
            continue;
        }
        push(&mut input, c.to_ascii_lowercase(), i, &mut space);
        i += 1;
    }
    input.offsets.push(src.len());
    if input.b.is_empty() { return Err(AssembleError::Syntax { offset: 0, message: "empty instruction" }); }
    Ok(input)
}

/// Normalize template text the way `lex` normalizes input; a space means
/// "optional whitespace".
fn norm(text: &str) -> Vec<u8> {
    let mut out = Vec::with_capacity(text.len());
    for c in text.bytes() {
        if c == b'#' { continue; }
        if c.is_ascii_whitespace() {
            if out.last() != Some(&b' ') { out.push(b' '); }
            continue;
        }
        out.push(c.to_ascii_lowercase());
    }
    out
}

/// Match normalized template text at `pos`. Template text never contains
/// `#`; the input may put one before any token.
fn match_text(b: &[u8], mut pos: usize, text: &[u8]) -> Option<usize> {
    for &c in text {
        if c == b' ' {
            if b.get(pos) == Some(&b' ') { pos += 1; }
            continue;
        }
        while b.get(pos) == Some(&b'#') { pos += 1; }
        if b.get(pos) != Some(&c) { return None; }
        pos += 1;
    }
    Some(pos)
}

/// Skip the optional `#` before an operand; reports whether there was one.
fn skip_hash(b: &[u8], pos: usize) -> (usize, bool) {
    let mut at = pos;
    while b.get(at) == Some(&b'#') { at += 1; }
    (at, at != pos)
}

// ---------------------------------------------------------------------------
// Numbers and tokens
// ---------------------------------------------------------------------------

fn parse_uint(b: &[u8], pos: usize) -> Option<(i128, usize)> {
    let (radix, start) = if b.get(pos) == Some(&b'0') && b.get(pos + 1) == Some(&b'x') { (16, pos + 2) } else { (10, pos) };
    let mut end = start;
    let mut value: i128 = 0;
    while let Some(digit) = b.get(end).and_then(|c| (*c as char).to_digit(radix)) {
        value = value.checked_mul(radix as i128)?.checked_add(digit as i128)?;
        if value > u64::MAX as i128 * 2 { return None; }
        end += 1;
    }
    (end > start).then_some((value, end))
}

fn parse_int(b: &[u8], pos: usize) -> Option<(i128, usize)> {
    match b.get(pos) {
        Some(b'-') => parse_uint(b, pos + 1).map(|(value, end)| (-value, end)),
        Some(b'+') => parse_uint(b, pos + 1),
        _ => parse_uint(b, pos),
    }
}

fn parse_decimal(b: &[u8], pos: usize) -> Option<(i128, usize)> {
    let mut end = pos;
    let mut value: i128 = 0;
    while let Some(c) = b.get(end).filter(|c| c.is_ascii_digit()) {
        value = value.checked_mul(10)?.checked_add((c - b'0') as i128)?;
        end += 1;
    }
    (end > pos && value < 1 << 32).then_some((value, end))
}

fn parse_float(b: &[u8], pos: usize) -> Option<(f64, usize)> {
    let mut end = pos;
    if matches!(b.get(end), Some(b'-' | b'+')) { end += 1; }
    let digits = |end: &mut usize| { let start = *end; while b.get(*end).is_some_and(u8::is_ascii_digit) { *end += 1; } *end > start };
    if !digits(&mut end) { return None; }
    if b.get(end) == Some(&b'.') && b.get(end + 1).is_some_and(u8::is_ascii_digit) { end += 1; digits(&mut end); }
    if b.get(end) == Some(&b'e') {
        let mut exp = end + 1;
        if matches!(b.get(exp), Some(b'-' | b'+')) { exp += 1; }
        if digits(&mut exp) { end = exp; }
    }
    let text = std::str::from_utf8(&b[pos..end]).ok()?;
    text.parse::<f64>().ok().map(|value| (value, end))
}

/// Parse one complete architectural register spelling in the given operand bank.
/// Aliases and bounds are shared with the assembler; trailing text rejects.
pub fn parse_register(class: OperandClass, name: &str) -> Option<u8> {
    let (index, end) = parse_reg(class, name.as_bytes(), 0)?;
    (end == name.len()).then(|| u8::try_from(index).ok()).flatten()
}

fn parse_reg(class: OperandClass, b: &[u8], pos: usize) -> Option<(i128, usize)> {
    use OperandClass as C;
    let specials: &[(&[u8], i128)] = match class {
        C::Gpr32 => &[(b"wzr", 31)], C::Gpr32Sp => &[(b"wsp", 31)],
        C::Gpr64 => &[(b"xzr", 31), (b"fp", 29), (b"lr", 30)],
        C::Gpr64Sp => &[(b"sp", 31), (b"fp", 29), (b"lr", 30)],
        _ => &[],
    };
    for (name, value) in specials {
        if b[pos..].starts_with(name) && !b.get(pos + name.len()).is_some_and(|c| c.is_ascii_alphanumeric()) {
            return Some((*value, pos + name.len()));
        }
    }
    let (prefix, max) = register_bank(class)?;
    if !b[pos..].starts_with(prefix.as_bytes()) { return None; }
    let (number, end) = parse_decimal(b, pos + prefix.len())?;
    let max = if matches!(class, C::Gpr32 | C::Gpr32Sp | C::Gpr64 | C::Gpr64Sp) { 30 } else { max };
    (number <= max).then_some((number, end))
}

fn parse_label(b: &[u8], pos: usize, address: u64, page: bool) -> Option<(i128, usize)> {
    if b.get(pos) == Some(&b'.') {
        return match b.get(pos + 1) {
            Some(b'+') => parse_uint(b, pos + 2),
            Some(b'-') => parse_uint(b, pos + 2).map(|(value, end)| (-value, end)),
            _ => Some((0, pos + 1)),
        };
    }
    let (target, end) = parse_int(b, pos)?;
    let here = address as i128;
    Some((if page { (target & !0xfff) - (here & !0xfff) } else { target - here }, end))
}

fn parse_sysreg(b: &[u8], pos: usize) -> Option<(i128, usize)> {
    let mut at = pos;
    let mut fields = [0i128; 5];
    for (index, (prefix, max)) in [(&b"s"[..], 3), (b"_", 7), (b"_c", 15), (b"_c", 15), (b"_", 7)].iter().enumerate() {
        at = match_text(b, at, prefix)?;
        let (value, end) = parse_decimal(b, at)?;
        if value > *max { return None; }
        fields[index] = value;
        at = end;
    }
    if fields[0] < 2 { return None; }
    Some((fields[0] << 14 | fields[1] << 11 | fields[2] << 7 | fields[3] << 3 | fields[4], at))
}

/// A ZERO tile list: `za0.d, za3.d`, wider tiles (`za1.s` is ZA1.D and
/// ZA5.D), or `za` for all of ZA.
fn parse_tile_mask(b: &[u8], pos: usize) -> Option<(i128, usize)> {
    let mut at = pos;
    let mut mask = 0i128;
    loop {
        at = match_text(b, at, b"za")?;
        let Some((tile, end)) = parse_decimal(b, at) else {
            mask = 0xff;
            if b.get(at) == Some(&b',') { return None; }
            return Some((mask, at));
        };
        let after = match_text(b, end, b".")?;
        let (step, count) = match b.get(after) { Some(b'b') => (1, 8), Some(b'h') => (2, 4), Some(b's') => (4, 2), Some(b'd') => (8, 1), _ => return None };
        if tile >= step { return None; }
        for index in 0..count { mask |= 1 << (tile + index * step); }
        at = after + 1;
        if b.get(at) != Some(&b',') { return Some((mask, at)); }
        at += 1;
    }
}

/// The numeric value of a table row printed as a number (`#0`, `3`, `#0.5`).
fn numeric_symbol(canonical: &str, float: bool) -> Option<(OperandClass, i128)> {
    let text = canonical.trim().trim_start_matches('#').trim();
    let body = text.trim_start_matches(['-', '+']);
    let digits = |s: &str, hex: bool| !s.is_empty() && s.bytes().all(|c| c.is_ascii_digit() || hex && matches!(c, b'a'..=b'f'));
    let numeric = if let Some(rest) = body.strip_prefix("0x") { digits(rest, true) }
        else if let Some((whole, frac)) = body.split_once('.') { digits(whole, false) && digits(frac, false) }
        else { digits(body, false) };
    if !numeric { return None; }
    let bytes = text.as_bytes();
    if float || body.contains('.') {
        let (value, end) = parse_float(bytes, 0)?;
        return (end == bytes.len()).then_some((OperandClass::FpImm, value.to_bits() as i128));
    }
    let (value, end) = parse_int(bytes, 0)?;
    (end == bytes.len()).then_some((OperandClass::Imm, value))
}

fn symbol_index(class: OperandClass, symbol: &str) -> Option<i128> {
    let symbols = class.symbols();
    if class == OperandClass::Cond { return symbols.iter().position(|s| *s == symbol).map(|i| i as i128); }
    symbols.binary_search(&symbol).ok().map(|i| i as i128)
}

/// Parse one value of `class` in isolation (for `OperandClass::parse_value`).
fn parse_class_value(class: OperandClass, b: &[u8], pos: usize) -> Option<(i128, usize)> {
    use OperandClass as C;
    if register_bank(class).is_some() { return parse_reg(class, b, pos); }
    match class {
        C::Imm | C::ImmHex => parse_int(b, pos),
        C::Label => parse_label(b, pos, 0, false),
        C::FpImm => parse_float(b, pos).map(|(value, end)| (value.to_bits() as i128, end)),
        C::SysReg => parse_sysreg(b, pos),
        C::CReg => { let at = match_text(b, pos, b"c")?; parse_decimal(b, at).filter(|(v, _)| *v < 16) }
        C::TileMask => if pos == b.len() { Some((0, pos)) } else { parse_tile_mask(b, pos) },
        _ => {
            let mut best: Option<(i128, usize)> = None;
            for (index, symbol) in class.symbols().iter().enumerate() {
                if let Some(end) = match_text(b, pos, &norm(symbol)) {
                    if best.is_none_or(|(_, old)| end > old) { best = Some((index as i128, end)); }
                }
            }
            if class == C::Cond {
                for (alias, code) in [("hs", 2), ("lo", 3)] {
                    if let Some(end) = match_text(b, pos, alias.as_bytes()) { if best.is_none_or(|(_, old)| end > old) { best = Some((code, end)); } }
                }
            }
            best
        }
    }
}

// ---------------------------------------------------------------------------
// Operand values decoded from words (the value-level mirror of render_*)
// ---------------------------------------------------------------------------

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
struct Val { class: OperandClass, value: i128 }

#[derive(Clone, Copy, Debug)]
struct Dec { class: OperandClass, value: i128, width: u8, position: Position }

impl Val {
    fn accepts(self, dec: Dec) -> bool {
        if self.class != dec.class { return false; }
        if self.value == dec.value { return true; }
        // A negative hexadecimal immediate names its two's complement in the
        // operand's width (`mov w0, #-1` is 0xffffffff).
        self.class == OperandClass::ImmHex && self.value < 0 && (1..128).contains(&dec.width) &&
            self.value >= -(1i128 << dec.width) && self.value + (1i128 << dec.width) == dec.value
    }
}

#[derive(Clone, Copy, Debug, PartialEq)]
enum RowVal { Val(OperandClass, i128), Raw, Bad }

/// One operand definition with the per-row values its table decodes to.
struct OpInfo {
    op: &'static OperandDef,
    class: OperandClass,
    rows: Vec<RowVal>,
    /// For a bank-letter table printed before a register number: the
    /// register class each row selects.
    fused: Vec<Option<OperandClass>>,
    spellings: Vec<Vec<Vec<u8>>>,
    literal: i128,
    regnum: bool,
}

fn regnum_op(op: &OperandDef) -> bool { matches!(op.kind, Kind::Num) && op.class.is_empty() }

impl OpInfo {
    fn new(op: &'static OperandDef) -> OpInfo {
        let class = base_class(op).unwrap_or(OperandClass::Enum);
        let mut info = OpInfo { op, class, rows: Vec::new(), fused: Vec::new(), spellings: Vec::new(), literal: 0, regnum: regnum_op(op) };
        if matches!(op.kind, Kind::Literal) {
            info.literal = symbol_index(class, &op.literal.to_ascii_lowercase()).unwrap_or(-1);
        }
        if matches!(op.kind, Kind::Table) {
            for row in op.rows {
                let (value, spellings) = row_value(op, class, row.symbol);
                info.rows.push(value);
                info.spellings.push(spellings);
            }
        }
        info
    }

    fn static_class(&self) -> OperandClass {
        match self.op.kind {
            Kind::FpImm => OperandClass::FpImm,
            Kind::SysReg => OperandClass::SysReg,
            Kind::Formula | Kind::BitfieldWidth | Kind::ElementIndex => OperandClass::Imm,
            Kind::LogicalImm | Kind::ByteMaskImm | Kind::MoveWideImm => OperandClass::ImmHex,
            Kind::TileMask => OperandClass::TileMask,
            _ => self.class,
        }
    }

    /// The classes this operand can decode to.
    fn classes(&self) -> Vec<OperandClass> {
        if !matches!(self.op.kind, Kind::Table) { return vec![self.static_class()]; }
        let mut out = Vec::new();
        for row in &self.rows {
            let class = match row { RowVal::Val(class, _) => *class, RowVal::Raw => OperandClass::Imm, RowVal::Bad => continue };
            if !out.contains(&class) { out.push(class); }
        }
        out
    }

    fn can_be(&self, class: OperandClass) -> bool { self.classes().contains(&class) }

    fn decode(&self, word: u32) -> Option<Dec> {
        let op = self.op;
        let (class, value, width) = match op.kind {
            Kind::Reg => (self.class, dec_reg(op, word)?, 0),
            Kind::Num => (self.class, dec_num(op, word)?, 0),
            Kind::FpImm => (OperandClass::FpImm, dec_fp_imm(op, word)?, 0),
            Kind::SysReg => (OperandClass::SysReg, dec_sysreg(op, word)?, 0),
            Kind::Table => match self.rows[first_row(op, word)?] {
                RowVal::Val(class, value) => (class, value, 0),
                RowVal::Raw => (OperandClass::Imm, raw_value(op, word) as i128, 0),
                RowVal::Bad => return None,
            },
            Kind::Derived => (self.class, dec_derived(op, word), 0),
            Kind::Formula => (OperandClass::Imm, dec_formula(op, word)?, 0),
            Kind::LogicalImm => { let (value, width) = dec_logical_imm(op, word)?; (OperandClass::ImmHex, value, width) }
            Kind::BitfieldWidth => (OperandClass::Imm, dec_bitfield_width(op, word)?, 0),
            Kind::ByteMaskImm => (OperandClass::ImmHex, dec_byte_mask(op, word)?, 64),
            Kind::MoveWideImm => { let (value, width) = dec_move_wide(op, word)?; (OperandClass::ImmHex, value, width) }
            Kind::Literal => { if op.literal.is_empty() || self.literal < 0 { return None; } (self.class, self.literal, 0) }
            Kind::ElementIndex => (OperandClass::Imm, dec_element_index(op, word)?, 0),
            Kind::TileMask => (OperandClass::TileMask, dec_tile_mask(op, word)?, 0),
        };
        Some(Dec { class, value, width, position: position_of(op, class) })
    }

    /// Every value the text at `pos` spells for this operand.
    fn parse(&self, b: &[u8], pos: usize, address: u64, hashed: bool) -> Vec<(Val, usize)> {
        let op = self.op;
        let one = |class: OperandClass, found: Option<(i128, usize)>| -> Vec<(Val, usize)> {
            found.map(|(value, end)| vec![(Val { class, value }, end)]).unwrap_or_default()
        };
        if pos > b.len() { return Vec::new(); }
        match op.kind {
            Kind::Reg => one(self.class, parse_reg(self.class, b, pos)),
            Kind::Derived if register_bank(self.class).is_some() => one(self.class, parse_reg(self.class, b, pos)),
            Kind::Derived => one(self.class, parse_int(b, pos)),
            Kind::Num => {
                if self.class == OperandClass::Label {
                    // `#N` is a displacement (LLVM's spelling); a bare number
                    // is an absolute target.
                    if hashed { return one(self.class, parse_int(b, pos)); }
                    return one(self.class, parse_label(b, pos, address, op.scale == 4096));
                }
                if self.class == OperandClass::CReg {
                    let Some(at) = match_text(b, pos, b"c") else { return Vec::new() };
                    return one(self.class, parse_decimal(b, at));
                }
                if op.symbol.contains("|SP") {
                    if let Some(end) = match_text(b, pos, b"sp") { return one(self.class, Some((31, end))); }
                }
                if self.regnum { return one(self.class, parse_decimal(b, pos).filter(|(v, _)| *v <= 31)); }
                one(self.class, parse_int(b, pos))
            }
            Kind::FpImm => one(OperandClass::FpImm, parse_float(b, pos).map(|(v, end)| (v.to_bits() as i128, end))),
            Kind::SysReg => one(OperandClass::SysReg, parse_sysreg(b, pos)),
            Kind::Formula | Kind::BitfieldWidth | Kind::ElementIndex => one(OperandClass::Imm, parse_int(b, pos)),
            Kind::LogicalImm | Kind::ByteMaskImm | Kind::MoveWideImm => one(OperandClass::ImmHex, parse_int(b, pos)),
            Kind::TileMask => one(OperandClass::TileMask, parse_tile_mask(b, pos)),
            Kind::Literal => {
                match match_text(b, pos, &norm(op.literal)) {
                    Some(end) if !op.literal.is_empty() => vec![(Val { class: self.class, value: self.literal }, end)],
                    _ => Vec::new(),
                }
            }
            Kind::Table => {
                let mut out: Vec<(Val, usize)> = Vec::new();
                let mut add = |val: Val, end: usize| { if !out.contains(&(val, end)) { out.push((val, end)); } };
                let int = parse_int(b, pos);
                let float = parse_float(b, pos);
                for (row, value) in self.rows.iter().enumerate() {
                    match *value {
                        RowVal::Raw => if let Some((n, end)) = int { add(Val { class: OperandClass::Imm, value: n }, end) },
                        RowVal::Val(OperandClass::Imm, n) if self.spellings[row].is_empty() =>
                            if let Some((m, end)) = int { if m == n { add(Val { class: OperandClass::Imm, value: n }, end) } },
                        RowVal::Val(OperandClass::FpImm, bits) if self.spellings[row].is_empty() =>
                            if let Some((f, end)) = float { if f.to_bits() as i128 == bits { add(Val { class: OperandClass::FpImm, value: bits }, end) } },
                        RowVal::Val(class, n) => for spelling in &self.spellings[row] {
                            if let Some(end) = match_text(b, pos, spelling) { add(Val { class, value: n }, end) }
                        },
                        RowVal::Bad => {}
                    }
                }
                out
            }
        }
    }
}

/// The value of one table row and the spellings that select it.
fn row_value(op: &'static OperandDef, class: OperandClass, symbol: &str) -> (RowVal, Vec<Vec<u8>>) {
    if numeric_placeholder(symbol) { return (RowVal::Raw, Vec::new()); }
    let lower = symbol.trim().to_ascii_lowercase();
    let (canonical, spellings) = match lower.as_str() {
        "[absent]" => (String::new(), vec![Vec::new()]),
        "[present]" => (op.symbol.to_ascii_lowercase(), vec![norm(op.symbol)]),
        _ => {
            let canonical = canonical_symbol(symbol);
            if let Some((class, value)) = numeric_symbol(&canonical, op.class == "fpimm8") {
                return (RowVal::Val(class, value), Vec::new());
            }
            let stripped: String = lower.chars().filter(|c| *c != '(' && *c != ')').collect();
            let mut spellings: Vec<Vec<u8>> = stripped.split('|').map(|alt| norm(alt.trim())).collect();
            if class == OperandClass::Cond {
                match canonical.as_str() { "cs" => spellings.push(b"hs".to_vec()), "cc" => spellings.push(b"lo".to_vec()), _ => {} }
            }
            (canonical, spellings)
        }
    };
    match symbol_index(class, &canonical) {
        Some(value) => (RowVal::Val(class, value), spellings),
        None => (RowVal::Bad, spellings),
    }
}

fn first_row(op: &OperandDef, word: u32) -> Option<usize> {
    op.rows.iter().position(|row| row_matches(row, op.cols, word, op.xor))
}

pub(super) fn dec_reg(op: &OperandDef, word: u32) -> Option<i128> {
    let raw = raw_value(op, word) as i64;
    let mut value = raw + op.bias;
    if !op.ranges.is_empty() {
        let mut encoded_lo = 0;
        let mut found = false;
        for range in op.ranges {
            let count = range.hi - range.lo + 1;
            if raw >= encoded_lo && raw < encoded_lo + count { value = raw + range.bias; found = true; break; }
            encoded_lo += count;
        }
        if !found { return None; }
    }
    if op.negate != 0 { value = op.negate - raw; }
    value *= op.scale;
    if value < 0 || op.has_reg_range && (value < op.reg_lo || value > op.reg_hi) ||
        op.reg_multiple > 1 && value % op.reg_multiple != 0 { return None; }
    Some(value as i128)
}

pub(super) fn dec_num(op: &OperandDef, word: u32) -> Option<i128> {
    let raw = raw_value(op, word);
    let mut value = if op.has_num_constant { op.num_constant }
        else if op.negate != 0 { op.negate - raw as i64 }
        else if op.signed { sign_extend(raw, total_width(op)) + op.bias }
        else { raw as i64 + op.bias };
    if op.raw_mul != 0 { value *= op.raw_mul; }
    value *= op.scale;
    if op.has_range && (value < op.lo || value > op.hi) { return None; }
    Some(value as i128)
}

pub(super) fn dec_fp_imm(op: &OperandDef, word: u32) -> Option<i128> {
    let raw = raw_value(op, word);
    if raw > 0xff { return None; }
    let sign = if raw & 0x80 != 0 { -1.0 } else { 1.0 };
    let n = (16 + (raw & 0x0f)) as f64;
    let exp = ((raw >> 4) & 7) as i32;
    let power = if exp >= 4 { exp - 7 } else { exp + 1 };
    Some((sign * n / 16.0 * 2f64.powi(power)).to_bits() as i128)
}

pub(super) fn dec_sysreg(op: &OperandDef, word: u32) -> Option<i128> {
    if op.parts.len() != 5 || op.parts[0].width != 1 || op.parts[1].width != 3 ||
        op.parts[2].width != 4 || op.parts[3].width != 4 || op.parts[4].width != 3 { return None; }
    let v = |i: usize| part_value(word, op.parts[i]) as i128;
    Some((2 + v(0)) << 14 | v(1) << 11 | v(2) << 7 | v(3) << 3 | v(4))
}

pub(super) fn dec_derived(op: &OperandDef, word: u32) -> i128 {
    let mut value = if op.parts.is_empty() { op.add } else { raw_value(op, word) as i64 * op.mul + op.add };
    if op.modulo > 0 { value = ((value % op.modulo) + op.modulo) % op.modulo; }
    value as i128
}

pub(super) fn dec_formula(op: &OperandDef, word: u32) -> Option<i128> {
    for (index, row) in op.rows.iter().enumerate() {
        if index >= op.formulas.len() || !row_matches(row, op.cols, word, 0) { continue; }
        let formula = op.formulas[index];
        let mut raw = 0u64; let mut size_raw = 0u64;
        for (part_index, part) in formula.parts.iter().enumerate() {
            let value = literal_or_field(word, *part);
            raw = raw << part.width | value;
            if part_index < formula.size_parts as usize { size_raw = size_raw << part.width | value; }
        }
        let raw_mul = if formula.raw_mul == 0 { 1 } else { formula.raw_mul };
        let mut value = raw as i64 * raw_mul + formula.add;
        if formula.negate != 0 { value = formula.negate - raw as i64; }
        if formula.esize_mul != 0 {
            if size_raw == 0 { return None; }
            let highest = 63 - size_raw.leading_zeros() as i64;
            value += formula.esize_mul * (formula.esize_base << highest);
        }
        return (value >= 0).then_some(value as i128);
    }
    None
}

pub(super) fn dec_logical_imm(op: &OperandDef, word: u32) -> Option<(i128, u8)> {
    let (n, immr, imms, sf, packed) = match op.parts {
        [part] if part.width == 13 => { let raw = part_value(word, *part); (raw >> 12, raw >> 6 & 0x3f, raw & 0x3f, 1, true) }
        [n, r, s, sf] => (part_value(word, *n), part_value(word, *r), part_value(word, *s), part_value(word, *sf), false),
        _ => return None,
    };
    let data_size = if sf != 0 { 64 } else { 32 };
    let length = 31u32.checked_sub((n << 6 | (!imms & 0x3f)).leading_zeros())?;
    if length < 1 { return None; }
    let levels = (1u32 << length) - 1; let s = imms & levels; let r = immr & levels;
    if s == levels { return None; }
    let element_size = 1u32 << length;
    if element_size > data_size { return None; }
    let ones = (1u64 << (s + 1)) - 1;
    let element_mask = if element_size == 64 { u64::MAX } else { (1u64 << element_size) - 1 };
    let mut element = rotate_element(ones, r % element_size, element_size) & element_mask;
    if op.logical_invert { element = !element & element_mask; }
    if packed { return Some((element as i128, element_size as u8)); }
    let mut value = 0u64; let mut shift = 0;
    while shift < data_size { value |= element << shift; shift += element_size; }
    Some((value as i128, data_size as u8))
}

pub(super) fn dec_bitfield_width(op: &OperandDef, word: u32) -> Option<i128> {
    if op.parts.len() != 2 { return None; }
    let imms = part_value(word, op.parts[0]); let immr = part_value(word, op.parts[1]);
    if op.data_size > 0 && imms as i64 >= op.data_size { return None; }
    if op.add == 1 { (imms < immr).then(|| imms as i128 + 1) }
    else { (imms >= immr).then(|| (imms - immr) as i128 + 1) }
}

pub(super) fn dec_byte_mask(op: &OperandDef, word: u32) -> Option<i128> {
    if op.parts.len() != 8 { return None; }
    let mut value = 0u64;
    for part in op.parts { value = value << 8 | if part_value(word, *part) != 0 { 0xff } else { 0 }; }
    Some(value as i128)
}

pub(super) fn dec_move_wide(op: &OperandDef, word: u32) -> Option<(i128, u8)> {
    if op.parts.len() != 3 { return None; }
    let imm16 = part_value(word, op.parts[0]) as u64;
    let shift = part_value(word, op.parts[1]) * 16;
    let data_size = if part_value(word, op.parts[2]) != 0 { 64 } else { 32 };
    if shift >= data_size { return None; }
    let mut value = imm16 << shift;
    if op.move_wide_invert { value = !value; if data_size == 32 { value &= 0xffff_ffff; } }
    Some((value as i128, data_size as u8))
}

pub(super) fn dec_element_index(op: &OperandDef, word: u32) -> Option<i128> {
    if op.index_size_parts == 0 || op.index_size_parts as usize >= op.parts.len() { return None; }
    let size_start = op.parts.len() - op.index_size_parts as usize;
    let mut raw = 0u64; let mut size = 0u64;
    for (index, part) in op.parts.iter().enumerate() {
        let value = part_value(word, *part) as u64; raw = raw << part.width | value;
        if index >= size_start { size = size << part.width | value; }
    }
    if size == 0 { return None; }
    Some((raw >> (size.trailing_zeros() + 1)) as i128)
}

pub(super) fn dec_tile_mask(op: &OperandDef, word: u32) -> Option<i128> {
    if op.parts.len() != 1 || op.parts[0].width != 8 { return None; }
    Some(part_value(word, op.parts[0]) as i128)
}

// ---------------------------------------------------------------------------
// Form syntax trees
// ---------------------------------------------------------------------------

#[derive(Clone)]
enum Node {
    /// Normalized text to match, and the template's own spelling to print.
    Lit(Vec<u8>, String),
    Op(u16),
    /// A bank letter printed as literal text before a register number
    /// (`D<d>`, `V<m>`): one register operand.
    FusedLit { op: u16, letter: u8, class: OperandClass },
    /// A bank-letter table followed by a register number (`<R><m>`).
    FusedTable { table: u16, num: u16 },
    Group(u8, Vec<Node>),
    Alt(Vec<Vec<Node>>),
}

struct FormInfo { ast: Vec<Node>, ops: Vec<Option<OpInfo>> }

impl FormInfo {
    fn op(&self, part: u16) -> &OpInfo { self.ops[part as usize].as_ref().expect("operand part") }
}

fn form_info(index: usize) -> &'static FormInfo {
    static CACHE: OnceLock<Vec<OnceLock<FormInfo>>> = OnceLock::new();
    let cache = CACHE.get_or_init(|| (0..FORMS.len()).map(|_| OnceLock::new()).collect());
    cache[index].get_or_init(|| build_form_info(&FORMS[index]))
}

fn build_form_info(form: &'static Form) -> FormInfo {
    let mut ops: Vec<Option<OpInfo>> = form.parts.iter().map(|part| part.operand.as_ref().map(OpInfo::new)).collect();
    struct Frame { group: u8, paren: bool, alts: Vec<Vec<Node>>, lit: Vec<u8>, display: String }
    fn flush(frame: &mut Frame) {
        if !frame.lit.is_empty() || !frame.display.is_empty() {
            let lit = std::mem::take(&mut frame.lit);
            let display = std::mem::take(&mut frame.display);
            frame.alts.last_mut().unwrap().push(Node::Lit(lit, display));
        }
    }
    fn close(stack: &mut Vec<Frame>) {
        let mut frame = stack.pop().unwrap();
        flush(&mut frame);
        let body = if frame.alts.len() == 1 { frame.alts.pop().unwrap() } else { vec![Node::Alt(frame.alts)] };
        let parent = stack.last_mut().unwrap().alts.last_mut().unwrap();
        if frame.paren { parent.extend(body); } else { parent.push(Node::Group(frame.group, body)); }
    }
    let group_of = |stack: &[Frame]| stack.last().map_or(0, |frame| frame.group);
    let contains = |outer: u8, inner: u8| outer == 0 || contains_group(form, outer, inner);
    let mut stack = vec![Frame { group: 0, paren: false, alts: vec![Vec::new()], lit: Vec::new(), display: String::new() }];
    for (index, part) in form.parts.iter().enumerate() {
        while stack.len() > 1 && !contains(group_of(&stack), part.group) { close(&mut stack); }
        let mut path = Vec::new();
        let mut group = part.group;
        while group != 0 && group != group_of(&stack) { path.push(group); group = parent_group(form, group); }
        for group in path.into_iter().rev() {
            flush(stack.last_mut().unwrap());
            stack.push(Frame { group, paren: false, alts: vec![Vec::new()], lit: Vec::new(), display: String::new() });
        }
        if part.operand.is_some() {
            let frame = stack.last_mut().unwrap();
            flush(frame);
            frame.alts.last_mut().unwrap().push(Node::Op(index as u16));
            continue;
        }
        for c in part.literal.bytes() {
            match c {
                b'(' => {
                    flush(stack.last_mut().unwrap());
                    let group = group_of(&stack);
                    stack.push(Frame { group, paren: true, alts: vec![Vec::new()], lit: Vec::new(), display: String::new() });
                }
                b'|' => { let frame = stack.last_mut().unwrap(); flush(frame); frame.alts.push(Vec::new()); }
                b')' => {
                    while stack.len() > 1 && !stack.last().unwrap().paren { close(&mut stack); }
                    if stack.len() > 1 { close(&mut stack); }
                }
                b'#' => stack.last_mut().unwrap().display.push('#'),
                c if c.is_ascii_whitespace() => {
                    let frame = stack.last_mut().unwrap();
                    if frame.lit.last() != Some(&b' ') { frame.lit.push(b' '); }
                    if !frame.display.ends_with(' ') { frame.display.push(' '); }
                }
                c => { let frame = stack.last_mut().unwrap(); frame.lit.push(c.to_ascii_lowercase()); frame.display.push(c as char); }
            }
        }
    }
    while stack.len() > 1 { close(&mut stack); }
    let mut root = stack.pop().unwrap();
    flush(&mut root);
    let mut ast = if root.alts.len() == 1 { root.alts.pop().unwrap() } else { vec![Node::Alt(root.alts)] };
    fuse(&mut ast, &mut ops);
    lists(&mut ast, &mut ops);
    FormInfo { ast, ops }
}

/// Register lists accept both separators ARM and LLVM use: a two-register
/// list as `{ z0.h-z1.h }` or `{ z0.h, z1.h }`, a consecutive list of three
/// or four written out as `{ z0.b, z1.b, z2.b }` or as the range
/// `{ z0.b-z2.b }`, whichever of the two the ARM template uses.
fn lists(seq: &mut Vec<Node>, ops: &mut Vec<Option<OpInfo>>) {
    for node in seq.iter_mut() {
        match node {
            Node::Group(_, body) => lists(body, ops),
            Node::Alt(alts) => for alt in alts.iter_mut() { lists(alt, ops) },
            _ => {}
        }
    }
    // `.b, ` or `-` between list registers: (suffix, separator).
    fn separator(text: &[u8]) -> Option<(Vec<u8>, u8)> {
        let mut at = 0;
        if text.first() == Some(&b'.') { at = 1; while text.get(at).is_some_and(u8::is_ascii_alphanumeric) { at += 1; } }
        let suffix = text[..at].to_vec();
        let rest: Vec<u8> = text[at..].iter().copied().filter(|c| *c != b' ').collect();
        match rest.as_slice() { [c @ (b',' | b'-')] => Some((suffix, *c)), _ => None }
    }
    let lit = |text: Vec<u8>| { let display = String::from_utf8_lossy(&text).into_owned(); Node::Lit(text, display) };
    let mut index = 0;
    while index < seq.len() {
        let opens = matches!(&seq[index], Node::Lit(text, _) if text.trim_ascii_end().ends_with(b"{"));
        index += 1;
        if !opens { continue; }
        // Elements: a register slot, optionally followed by `.` and an
        // arrangement operand; separators between them.
        let mut elements: Vec<(usize, usize)> = Vec::new();
        let mut seps: Vec<(usize, (Vec<u8>, u8))> = Vec::new();
        let mut at = index;
        let closed = loop {
            let is_slot = matches!(seq.get(at), Some(Node::Op(part)) if ops[*part as usize].as_ref()
                .is_some_and(|info| register_bank(info.class).is_some() && matches!(info.op.kind, Kind::Reg | Kind::Derived)));
            if !is_slot { break false; }
            let start = at;
            at += 1;
            if matches!(seq.get(at), Some(Node::Lit(text, _)) if text == b".") &&
                matches!(seq.get(at + 1), Some(Node::Op(part)) if ops[*part as usize].as_ref().is_some_and(|info| matches!(info.op.kind, Kind::Table))) {
                at += 2;
            }
            elements.push((start, at));
            match seq.get(at) {
                Some(Node::Lit(text, _)) => match separator(text) {
                    Some(sep) => { seps.push((at, sep)); at += 1; }
                    None => break text.contains(&b'}'),
                },
                _ => break false,
            }
        };
        let op_of = |seq: &Vec<Node>, element: (usize, usize)| match seq[element.0] { Node::Op(part) => part, _ => unreachable!() };
        let derived = |seq: &Vec<Node>, element: (usize, usize), ops: &Vec<Option<OpInfo>>| {
            matches!(ops[op_of(seq, element) as usize].as_ref().unwrap().op.kind, Kind::Derived)
        };
        if !closed || elements.len() < 2 || !elements[1..].iter().all(|e| derived(seq, *e, ops)) { continue; }
        let (first, last) = (elements[0], elements[elements.len() - 1]);
        if elements.len() == 2 {
            let (position, (suffix, sep)) = seps[0].clone();
            let mut other = suffix.clone();
            other.extend_from_slice(if sep == b',' { b"-" } else { b", " });
            let original = seq[position].clone();
            seq[position] = Node::Alt(vec![vec![original], vec![lit(other)]]);
            if sep != b'-' { continue; }
            // `{ <Zn1>-<Zn4> }` also as four registers written out.
            let head = ops[op_of(seq, first) as usize].as_ref().unwrap().op;
            let tail = ops[op_of(seq, last) as usize].as_ref().unwrap().op;
            let consecutive = matches!(head.kind, Kind::Reg) && head.bias == 0 && head.negate == 0 && head.ranges.is_empty() &&
                tail.mul == head.scale.max(1) && (2..=3).contains(&tail.add) && tail.parts.len() == head.parts.len();
            if !consecutive { continue; }
            let mut comma = suffix;
            comma.extend_from_slice(b", ");
            let mut spelled: Vec<Node> = seq[first.0..first.1].to_vec();
            for add in 1..=tail.add {
                spelled.push(lit(comma.clone()));
                let def: &'static OperandDef = Box::leak(Box::new(OperandDef { add, ..*tail }));
                let mut info = OpInfo::new(def);
                info.class = ops[op_of(seq, last) as usize].as_ref().unwrap().class;
                ops.push(Some(info));
                spelled.push(Node::Op((ops.len() - 1) as u16));
                spelled.extend(seq[last.0 + 1..last.1].iter().cloned());
            }
            let body: Vec<Node> = seq.drain(first.0..last.1).collect();
            seq.insert(first.0, Node::Alt(vec![body, spelled]));
        } else if seps.iter().all(|(_, (_, sep))| *sep == b',') {
            let mut dash = seps[0].1 .0.clone();
            dash.push(b'-');
            let mut range: Vec<Node> = seq[first.0..first.1].to_vec();
            range.push(lit(dash));
            range.extend(seq[last.0..last.1].iter().cloned());
            let body: Vec<Node> = seq.drain(first.0..last.1).collect();
            seq.insert(first.0, Node::Alt(vec![body, range]));
        }
    }
}

/// Join a register bank letter with the register number printed after it, so
/// one hole covers what ARM writes as one register operand.
fn fuse(seq: &mut Vec<Node>, ops: &mut [Option<OpInfo>]) {
    for node in seq.iter_mut() {
        match node {
            Node::Group(_, body) => fuse(body, ops),
            Node::Alt(alts) => for alt in alts.iter_mut() { fuse(alt, ops) },
            _ => {}
        }
    }
    let mut index = 0;
    while index + 1 < seq.len() {
        let next_op = match seq[index + 1] { Node::Op(part) => Some(part), _ => None };
        let Some(part) = next_op else { index += 1; continue };
        let info = ops[part as usize].as_ref().unwrap();
        let numberish = info.regnum || matches!(info.op.kind, Kind::Formula) && info.op.class == "simdvec";
        if !numberish { index += 1; continue; }
        let sp = info.op.symbol.contains("|SP");
        match &mut seq[index] {
            Node::Lit(text, display) if !text.is_empty() => {
                let n = text.len();
                let letter = text[n - 1];
                let standalone = n == 1 || !text[n - 2].is_ascii_alphanumeric();
                if let (true, Some(class)) = (standalone, bank_letter_class(letter, sp)) {
                    text.pop();
                    display.pop();
                    let empty = text.is_empty() && display.trim().is_empty();
                    seq[index + 1] = Node::FusedLit { op: part, letter, class };
                    if empty { seq.remove(index); continue; }
                }
            }
            Node::Op(table) => {
                let table = *table;
                let table_info = ops[table as usize].as_ref().unwrap();
                if matches!(table_info.op.kind, Kind::Table) {
                    let classes: Vec<Option<OperandClass>> = table_info.op.rows.iter().map(|row| {
                        let symbol = canonical_symbol(row.symbol);
                        if symbol.len() == 1 { bank_letter_class(symbol.as_bytes()[0], sp) } else { None }
                    }).collect();
                    if !classes.is_empty() && classes.iter().all(Option::is_some) {
                        ops[table as usize].as_mut().unwrap().fused = classes;
                        seq[index] = Node::FusedTable { table, num: part };
                        seq.remove(index + 1);
                    }
                }
            }
            _ => {}
        }
        index += 1;
    }
}

// ---------------------------------------------------------------------------
// Matching text against a form
// ---------------------------------------------------------------------------

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
enum Check {
    When { mask: u32, value: u32 },
    Raw { op: u16, want: u64 },
    AnySp { a: u32, b: u32 },
    Want { op: u16, val: Val },
    Decodes { op: u16 },
    Hole { op: u16, hole: u8, class: Option<OperandClass> },
    FusedHole { table: u16, num: u16, hole: u8 },
}

#[derive(Clone, Default)]
struct Interp { checks: Vec<(Check, usize, usize)>, present: u32, omitted: u32 }

#[derive(Clone, Copy)]
struct Failure { recorded: bool, pos: usize, form: Option<&'static Form>, operand: Option<&'static str>, reason: Mismatch }

impl Default for Failure {
    fn default() -> Self { Failure { recorded: false, pos: 0, form: None, operand: None, reason: Mismatch::InvalidOperand } }
}

impl Failure {
    fn better(&self, pos: usize, operand: Option<&'static str>) -> bool {
        !self.recorded || pos > self.pos || pos == self.pos && self.operand.is_none() && operand.is_some()
    }
    fn note(&mut self, pos: usize, operand: Option<&'static str>, reason: Mismatch) {
        if self.better(pos, operand) { *self = Failure { recorded: true, pos, form: None, operand, reason }; }
    }
    fn merge(&mut self, other: &Failure, form: &'static Form) {
        if other.recorded && self.better(other.pos, other.operand) { *self = Failure { form: Some(form), ..*other }; }
    }
}

struct Matcher<'a> {
    form: &'static Form,
    input: &'a Input,
    info: &'static FormInfo,
    address: u64,
    out: Vec<Interp>,
    fail: Failure,
}

type Cont = Vec<(&'static [Node], usize)>;

impl Matcher<'_> {
    fn walk(&mut self, mut stack: Cont, pos: usize, it: &mut Interp) {
        let info: &'static FormInfo = self.info;
        let input: &Input = self.input;
        let node = loop {
            let Some(top) = stack.last_mut() else {
                if pos == input.b.len() { self.out.push(it.clone()); }
                else { self.fail.note(pos, None, Mismatch::ExtraText); }
                return;
            };
            if top.1 < top.0.len() { let node = &top.0[top.1]; top.1 += 1; break node; }
            stack.pop();
        };
        let b = &input.b;
        match node {
            Node::Lit(text, _) => match match_text(b, pos, text) {
                Some(end) => self.walk(stack, end, it),
                None => self.fail.note(pos, None, if pos >= b.len() { Mismatch::MissingOperand } else { Mismatch::InvalidOperand }),
            },
            Node::Group(group, body) => {
                let bit = 1u32 << (*group & 31);
                let mut inner = stack.clone();
                inner.push((&body[..], 0));
                it.present |= bit;
                self.walk(inner, pos, it);
                it.present &= !bit;
                it.omitted |= bit;
                self.walk(stack, pos, it);
                it.omitted &= !bit;
            }
            Node::Alt(alts) => for alt in alts {
                let mut inner = stack.clone();
                inner.push((&alt[..], 0));
                self.walk(inner, pos, it);
            },
            Node::Op(part) => {
                let options = self.op_options(*part, pos);
                self.branch(stack, it, options, pos);
            }
            Node::FusedLit { op, letter, class } => {
                let (pos, hashed) = skip_hash(b, pos);
                let mut options = Vec::new();
                if let Some(hole) = self.hole_at(pos) {
                    if self.hole_allows(hole, |candidate| candidate == *class) {
                        options.push((vec![Check::Hole { op: *op, hole, class: Some(*class) }], pos + 1));
                    } else { self.fail.note(pos, Some(info.op(*op).op.symbol), Mismatch::HoleClass); }
                } else if b.get(pos) == Some(letter) {
                    let info = info.op(*op);
                    for (val, end) in info.parse(b, pos + 1, self.address, hashed) {
                        options.push((vec![Check::Want { op: *op, val }], end));
                    }
                    if options.is_empty() { self.fail.note(pos + 1, Some(info.op.symbol), Mismatch::InvalidRegister); }
                } else {
                    let reason = if pos >= b.len() { Mismatch::MissingOperand } else { Mismatch::InvalidRegister };
                    self.fail.note(pos, Some(info.op(*op).op.symbol), reason);
                }
                self.branch(stack, it, options, pos);
            }
            Node::FusedTable { table, num } => {
                let (pos, _) = skip_hash(b, pos);
                let table_info = info.op(*table);
                let num_info = info.op(*num);
                let mut options = Vec::new();
                if let Some(hole) = self.hole_at(pos) {
                    if self.hole_allows(hole, |candidate| table_info.fused.contains(&Some(candidate))) {
                        options.push((vec![Check::FusedHole { table: *table, num: *num, hole }], pos + 1));
                    } else { self.fail.note(pos, Some(num_info.op.symbol), Mismatch::HoleClass); }
                } else {
                    // Zero-register and stack-pointer names select the bank row
                    // and register number 31 together.
                    for (row, class) in table_info.fused.iter().enumerate() {
                        let Some(class) = class else { continue };
                        let RowVal::Val(row_class, row_value) = table_info.rows[row] else { continue };
                        let names: &[&[u8]] = match class {
                            OperandClass::Gpr32 => &[b"wzr"], OperandClass::Gpr64 => &[b"xzr"],
                            OperandClass::Gpr32Sp => &[b"wsp"], OperandClass::Gpr64Sp => &[b"sp"],
                            _ => &[],
                        };
                        for name in names {
                            if b[pos..].starts_with(name) {
                                let checks = vec![
                                    Check::Want { op: *table, val: Val { class: row_class, value: row_value } },
                                    Check::Want { op: *num, val: Val { class: OperandClass::Imm, value: 31 } },
                                ];
                                if !options.contains(&(checks.clone(), pos + name.len())) { options.push((checks, pos + name.len())); }
                            }
                        }
                    }
                    for (table_val, mid) in table_info.parse(b, pos, self.address, false) {
                        for (num_val, end) in num_info.parse(b, mid, self.address, false) {
                            options.push((vec![Check::Want { op: *table, val: table_val }, Check::Want { op: *num, val: num_val }], end));
                        }
                    }
                    if options.is_empty() {
                        let reason = if pos >= b.len() { Mismatch::MissingOperand } else { Mismatch::InvalidRegister };
                        self.fail.note(pos, Some(num_info.op.symbol), reason);
                    }
                }
                self.branch(stack, it, options, pos);
            }
        }
    }

    fn branch(&mut self, stack: Cont, it: &mut Interp, options: Vec<(Vec<Check>, usize)>, pos: usize) {
        for (checks, end) in options {
            let start = it.checks.len();
            for check in checks { it.checks.push((check, pos, end)); }
            self.walk(stack.clone(), end, it);
            it.checks.truncate(start);
        }
    }

    fn hole_at(&self, pos: usize) -> Option<u8> {
        self.input.b.get(pos).copied().filter(|byte| is_hole(*byte)).map(|byte| byte - 1)
    }

    fn hole_allows(&self, hole: u8, accepts: impl Fn(OperandClass) -> bool) -> bool {
        self.input.holes[hole as usize].class.is_none_or(accepts)
    }

    fn op_options(&mut self, part: u16, pos: usize) -> Vec<(Vec<Check>, usize)> {
        let form_info: &'static FormInfo = self.info;
        let input: &Input = self.input;
        let info = form_info.op(part);
        let b = &input.b;
        let (pos, hashed) = skip_hash(b, pos);
        if let Some(hole) = self.hole_at(pos) {
            if self.hole_allows(hole, |class| info.can_be(class)) {
                return vec![(vec![Check::Hole { op: part, hole, class: None }], pos + 1)];
            }
            self.fail.note(pos, Some(info.op.symbol), Mismatch::HoleClass);
            return Vec::new();
        }
        if b.get(pos) == Some(&WILD) { return vec![(vec![Check::Decodes { op: part }], pos + 1)]; }
        // ARM permits LSL for the extended-register UXTW/UXTX only when Rd or
        // Rn is the stack pointer.
        let sp_only = info.op.symbol == "<extend>" && self.form.encoding_id.contains("addsub_ext") &&
            match_text(b, pos, b"lsl").is_some();
        let options: Vec<(Vec<Check>, usize)> = info.parse(b, pos, self.address, hashed).into_iter()
            .map(|(val, end)| {
                let mut checks = vec![Check::Want { op: part, val }];
                if sp_only { checks.extend(sp_check(self.form)); }
                (checks, end)
            }).collect();
        if options.is_empty() {
            let register = matches!(info.op.kind, Kind::Reg) || register_bank(info.class).is_some() || info.regnum;
            let reason = if pos >= b.len() { Mismatch::MissingOperand }
                else if register && b[pos].is_ascii_alphabetic() || info.regnum { Mismatch::InvalidRegister }
                else { Mismatch::InvalidOperand };
            self.fail.note(pos, Some(info.op.symbol), reason);
        }
        options
    }
}

// ---------------------------------------------------------------------------
// Candidates
// ---------------------------------------------------------------------------

#[derive(Clone)]
struct Cand {
    form: &'static Form,
    info: &'static FormInfo,
    checks: Vec<Check>,
    /// Normalized input span of each check (0..0 for implied checks).
    spans: Vec<(usize, usize)>,
    present: u32,
    omitted: u32,
    order: usize,
}

impl Cand {
    fn same(&self, other: &Cand) -> bool {
        std::ptr::eq(self.form, other.form) && self.checks == other.checks
    }
}

/// LLVM folds an optional `LSL #k` into the immediate it prints
/// (`add z0.h, z0.h, #512` is `#2, LSL #8`). When the shift group is omitted
/// and the immediate does not fit unshifted, select the shifted row instead.
fn fold_shifted_immediate(form: &'static Form, info: &FormInfo, checks: &mut [Check]) {
    let known_mask = form.mask | form.constraint_mask;
    let known_value = form.value & form.mask | form.constraint_value & form.constraint_mask;
    for shift_index in 0..checks.len() {
        let Check::Raw { op: shift, .. } = checks[shift_index] else { continue };
        let shift_info = info.op(shift);
        if !matches!(shift_info.op.kind, Kind::Table) { continue; }
        let rows: Vec<Option<u32>> = shift_info.op.rows.iter().map(|row| {
            let symbol = canonical_symbol(row.symbol);
            symbol.strip_prefix("lsl #").and_then(|amount| amount.parse().ok())
        }).collect();
        if rows.iter().any(Option::is_none) { continue; }
        let Some(imm_index) = checks.iter().position(|check| matches!(*check,
            Check::Want { op, val } if op + 1 < shift && val.class == OperandClass::Imm &&
                matches!(info.op(op).op.kind, Kind::Num) &&
                form.parts[op as usize + 1..shift as usize].iter().all(|part| part.operand.is_none()))) else { continue };
        let Check::Want { op: imm, val } = checks[imm_index] else { continue };
        let fits = |val: Val| options_for(info, &Target::Val(imm, val), known_mask, known_value).is_ok_and(|o| !o.is_empty());
        if fits(val) { continue; }
        for (row, amount) in rows.iter().enumerate() {
            let amount = amount.unwrap_or(0);
            let RowVal::Val(class, value) = shift_info.rows[row] else { continue };
            let unit = 1i128 << amount;
            if amount == 0 || val.value % unit != 0 { continue; }
            let scaled = Val { class: val.class, value: val.value / unit };
            if !fits(scaled) { continue; }
            checks[imm_index] = Check::Want { op: imm, val: scaled };
            checks[shift_index] = Check::Want { op: shift, val: Val { class, value } };
            break;
        }
    }
}

/// Rd or Rn is the stack pointer (for the extended-register LSL spelling).
fn sp_check(form: &Form) -> Option<Check> {
    let sp: Vec<u32> = form.parts.iter().filter_map(|part| part.operand.as_ref())
        .filter(|op| matches!(op.kind, Kind::Reg) && matches!(op.class, "gpr64sp" | "gpr32sp"))
        .map(|op| parts_mask(op.parts)).collect();
    Some(Check::AnySp { a: *sp.first()?, b: *sp.last()? })
}

/// The encoded value an omitted operand must hold (mirrors group_omitted).
fn omitted_raw(op: &OperandDef) -> u64 {
    if op.has_default && op.default >= 0 {
        let scale = op.scale.max(1);
        let mut semantic = op.default / scale;
        if op.negate != 0 { semantic = op.negate - semantic; } else { semantic -= op.bias; }
        if semantic >= 0 { return semantic as u64; }
    }
    0
}

fn parts_mask(parts: &[BitPart]) -> u32 {
    parts.iter().filter(|part| !part.is_lit).fold(0, |mask, part| mask | low_mask(part.width) << part.start as u8)
}

fn build_cand(form: &'static Form, info: &'static FormInfo, interp: Interp, input: &Input) -> Result<Option<Cand>, AssembleError> {
    let mut checks: Vec<Check> = Vec::new();
    let mut spans: Vec<(usize, usize)> = Vec::new();
    let add = |check: Check, span: (usize, usize), checks: &mut Vec<Check>, spans: &mut Vec<(usize, usize)>| {
        if !checks.contains(&check) { checks.push(check); spans.push(span); }
    };
    let ext_form = form.encoding_id.contains("addsub_ext");
    let mut omitted_any = false;
    for group in 1..32u8 {
        if interp.omitted & (1 << group) == 0 { continue; }
        if form.required.contains(&group) { return Ok(None); }
        let ext = ext_form && form.parts.iter().any(|part| contains_group(form, group, part.group) &&
            part.operand.as_ref().is_some_and(|op| op.symbol == "<extend>"));
        omitted_any |= ext;
        for (index, part) in form.parts.iter().enumerate() {
            let Some(op) = &part.operand else { continue };
            if !contains_group(form, group, part.group) { continue; }
            let index = index as u16;
            if ext {
                // ARM: LSL may be omitted from the extended-register form when
                // Rd or Rn is the stack pointer; omission means LSL #0.
                let op_info = info.op(index);
                let val = if matches!(op.kind, Kind::Table) {
                    let row = op.rows.iter().position(|row| row.symbol.to_ascii_lowercase().starts_with("lsl|"));
                    let Some(RowVal::Val(class, value)) = row.map(|row| op_info.rows[row]) else { return Ok(None) };
                    Val { class, value }
                } else {
                    Val { class: op_info.static_class(), value: 0 }
                };
                add(Check::Want { op: index, val }, (0, 0), &mut checks, &mut spans);
            } else {
                add(Check::Raw { op: index, want: omitted_raw(op) }, (0, 0), &mut checks, &mut spans);
            }
        }
    }
    if omitted_any {
        let Some(check) = sp_check(form) else { return Ok(None) };
        add(check, (0, 0), &mut checks, &mut spans);
    }
    for (check, start, end) in &interp.checks {
        let ops: &[u16] = match check {
            Check::Want { op, .. } | Check::Hole { op, .. } | Check::Decodes { op } => std::slice::from_ref(op),
            Check::FusedHole { table, num, .. } => &[*table, *num],
            _ => &[],
        };
        for op in ops {
            let def = info.op(*op).op;
            if def.when_mask != 0 { add(Check::When { mask: def.when_mask, value: def.when_value }, (0, 0), &mut checks, &mut spans); }
        }
        let _ = (start, end);
    }
    for (check, start, end) in &interp.checks { add(*check, (*start, *end), &mut checks, &mut spans); }
    fold_shifted_immediate(form, info, &mut checks);
    // A fixed operand no word of this form can hold makes the whole
    // interpretation empty: report it as out of range.
    let known_mask = form.mask | form.constraint_mask;
    let known_value = form.value & form.mask | form.constraint_value & form.constraint_mask;
    for (check, (start, end)) in checks.iter().zip(&spans) {
        let Check::Want { op, val } = *check else { continue };
        if start == end { continue; }
        if let Ok(options) = options_for(info, &Target::Val(op, val), known_mask, known_value) {
            if options.is_empty() {
                return Err(AssembleError::OperandOutOfRange {
                    form: form.encoding_id, operand: info.op(op).op.symbol,
                    text: input.source(*start, *end), offset: input.offset(*start),
                });
            }
        }
    }
    Ok(Some(Cand { form, info, checks, spans, present: interp.present, omitted: interp.omitted, order: 0 }))
}

// ---------------------------------------------------------------------------
// Encoding: the inverse of decoding, verified by decoding
// ---------------------------------------------------------------------------

#[derive(Clone, Copy, Debug)]
enum Target { Val(u16, Val), Raw(u16, u64), Bits(u32, u32), AnySp(u32, u32) }

impl Cand {
    /// The encoding targets for these hole values, or None when a value's
    /// class cannot fill this candidate.
    fn targets(&self, values: &[OperandValue]) -> Option<Vec<Target>> {
        let mut out = Vec::with_capacity(self.checks.len());
        for check in &self.checks {
            match *check {
                Check::When { mask, value } => out.push(Target::Bits(mask, value)),
                Check::Raw { op, want } => out.push(Target::Raw(op, want)),
                Check::AnySp { a, b } => out.push(Target::AnySp(a, b)),
                Check::Want { op, val } => out.push(Target::Val(op, val)),
                Check::Decodes { .. } => return None,
                Check::Hole { op, hole, class } => {
                    let value = values[hole as usize];
                    match class {
                        Some(class) if class != value.class => return None,
                        Some(_) => out.push(Target::Val(op, Val { class: self.info.op(op).static_class(), value: value.value })),
                        None => {
                            if !self.info.op(op).can_be(value.class) { return None; }
                            out.push(Target::Val(op, Val { class: value.class, value: value.value }));
                        }
                    }
                }
                Check::FusedHole { table, num, hole } => {
                    let value = values[hole as usize];
                    let table_info = self.info.op(table);
                    let row = table_info.fused.iter().position(|class| *class == Some(value.class))?;
                    let RowVal::Val(class, symbol) = table_info.rows[row] else { return None };
                    out.push(Target::Val(table, Val { class, value: symbol }));
                    out.push(Target::Val(num, Val { class: OperandClass::Imm, value: value.value }));
                }
            }
        }
        // Bits first, then operands that pin bits directly, then searches.
        out.sort_by_key(|target| match target {
            Target::Bits(..) => 0,
            Target::Raw(..) => 1,
            Target::Val(op, _) => 2 + priority(self.info.op(*op).op),
            Target::AnySp(..) => 20,
        });
        Some(out)
    }

    fn out_of_range(&self, targets: &[Target]) -> Option<AssembleError> {
        for target in targets {
            let Target::Val(op, _) = target else { continue };
            if let Ok(options) = options_for(self.info, target, self.form.mask | self.form.constraint_mask, self.form.value | self.form.constraint_value) {
                if options.is_empty() {
                    let def = self.info.op(*op).op;
                    return Some(AssembleError::OperandOutOfRange { form: self.form.encoding_id, operand: def.symbol, text: String::new(), offset: 0 });
                }
            }
        }
        None
    }

    /// (0 when the formatter prints `word` with this form, 0 when it omits
    /// exactly the optional groups this text omitted).
    fn rank(&self, word: u32) -> (u8, u8) {
        let preferred = u8::from(!best_form(word).is_some_and(|best| std::ptr::eq(best, self.form)));
        let mut skipped = [false; 32];
        for part in self.form.parts {
            let group = part.group as usize;
            if group != 0 && group < skipped.len() { skipped[group] = group_omitted(self.form, part.group, word); }
        }
        let mut groups = 0u8;
        for group in 1..32u8 {
            let bit = 1u32 << group;
            let printed = !skipped[group as usize] && !ancestor_skipped(self.form, group, &skipped);
            if self.present & bit != 0 && !printed || self.omitted & bit != 0 && printed { groups = 1; }
        }
        (preferred, groups)
    }
}

fn priority(op: &OperandDef) -> usize {
    match op.kind {
        Kind::Table => 0, Kind::Reg | Kind::Num | Kind::SysReg | Kind::Literal => 1,
        Kind::MoveWideImm => 2, Kind::Derived => 3,
        Kind::FpImm | Kind::ByteMaskImm | Kind::TileMask | Kind::ElementIndex | Kind::Formula => 4,
        Kind::BitfieldWidth => 5, Kind::LogicalImm => 6,
    }
}

fn form_buckets() -> &'static [Vec<u16>] {
    static BUCKETS: OnceLock<Vec<Vec<u16>>> = OnceLock::new();
    BUCKETS.get_or_init(|| {
        let mut buckets = vec![Vec::new(); 256];
        for (index, form) in FORMS.iter().enumerate() {
            if form.mask == 0 { continue; }
            let (mask, value) = (form.mask >> 24, form.value >> 24);
            for top in 0..256u32 { if top & mask == value { buckets[top as usize].push(index as u16); } }
        }
        buckets
    })
}

fn best_form(word: u32) -> Option<&'static Form> {
    let mut best: Option<&'static Form> = None;
    for &index in &form_buckets()[(word >> 24) as usize] {
        let form = &FORMS[index as usize];
        if !form_matches(form, word) { continue; }
        if best.is_none_or(|old| better_form(form, old)) { best = Some(form); }
    }
    best
}

/// Bits an operand's value depends on.
fn op_bits(op: &OperandDef) -> u32 {
    let mut mask = parts_mask(op.parts) | parts_mask(op.cols);
    for formula in op.formulas { mask |= parts_mask(formula.parts); }
    mask
}

/// Place `raw` (most-significant part first) into `parts`.
fn place(parts: &[BitPart], mut raw: u64) -> Option<(u32, u32)> {
    let (mut mask, mut value) = (0u32, 0u32);
    for part in parts.iter().rev() {
        let width = part.width as u32;
        let chunk = if width >= 64 { raw } else { raw & ((1u64 << width) - 1) };
        raw = if width >= 64 { 0 } else { raw >> width };
        if part.is_lit {
            if chunk != literal_or_field(0, *part) { return None; }
            continue;
        }
        let field = low_mask(part.width) << part.start as u8;
        mask |= field;
        value |= (chunk as u32) << part.start as u8 & field;
    }
    (raw == 0).then_some((mask, value))
}

fn value_parts(op: &OperandDef) -> &'static [BitPart] { if op.parts.is_empty() { op.cols } else { op.parts } }

const MAX_SEARCH_BITS: u32 = 16;
const MAX_FREE_BITS: u32 = 16;

/// The (mask, value) assignments that give `target`, consistent with the
/// known bits. Over-generation is harmless (every word is verified by
/// decoding); `Err` means the operand is too wide to search.
fn options_for(info: &FormInfo, target: &Target, known_mask: u32, known_value: u32) -> Result<Vec<(u32, u32)>, ()> {
    let consistent = |(mask, value): &(u32, u32)| (value ^ known_value) & mask & known_mask == 0;
    let mut out: Vec<(u32, u32)> = Vec::new();
    match *target {
        Target::Bits(mask, value) => out.push((mask, value)),
        Target::AnySp(..) => out.push((0, 0)),
        Target::Raw(op, want) => out.extend(place(value_parts(info.op(op).op), want)),
        Target::Val(op, val) => {
            let op_info = info.op(op);
            let def = op_info.op;
            match def.kind {
                Kind::Table => {
                    for (row, value) in op_info.rows.iter().enumerate() {
                        let matches = match *value {
                            RowVal::Val(class, n) => class == val.class && n == val.value,
                            RowVal::Raw => val.class == OperandClass::Imm,
                            RowVal::Bad => false,
                        };
                        if !matches { continue; }
                        if *value == RowVal::Raw {
                            if let Ok(raw) = u64::try_from(val.value) { out.extend(place(def.cols, raw)); }
                            continue;
                        }
                        out.push(row_pattern(def, &def.rows[row]));
                    }
                }
                Kind::Reg => {
                    for raw in reg_raws(def, val.value) { out.extend(place(value_parts(def), raw)); }
                }
                Kind::Num => {
                    if def.has_num_constant {
                        if val.value == def.num_constant as i128 { out.push((0, 0)); }
                    } else if let Some(raw) = num_raw(def, val.value) {
                        out.extend(place(value_parts(def), raw));
                    }
                }
                Kind::SysReg => {
                    let v = val.value;
                    if (0..1 << 16).contains(&v) && v >> 14 >= 2 && def.parts.len() == 5 {
                        out.extend(place(def.parts, ((v - (2 << 14)) as u64) & 0x7fff));
                    }
                }
                Kind::Literal => if op_info.literal == val.value && val.class == op_info.class { out.push((0, 0)) },
                Kind::Derived if def.parts.is_empty() => if dec_derived(def, 0) == val.value { out.push((0, 0)) },
                Kind::MoveWideImm if def.parts.len() == 3 => {
                    for sf in 0..2u64 {
                        let size = if sf != 0 { 64 } else { 32 };
                        let mut target = val.value;
                        if target < 0 { target += 1i128 << size; }
                        if target < 0 || target >= 1i128 << size { continue; }
                        let full = if size == 64 { u64::MAX } else { 0xffff_ffff };
                        let base = if def.move_wide_invert { !(target as u64) & full } else { target as u64 };
                        for hw in 0..(size / 16) {
                            let shift = hw * 16;
                            if base & !(0xffffu64 << shift) != 0 { continue; }
                            let parts = [(def.parts[0], base >> shift), (def.parts[1], hw as u64), (def.parts[2], sf)];
                            let mut mask = 0; let mut value = 0; let mut ok = true;
                            for (part, raw) in parts {
                                match place(std::slice::from_ref(&part), raw) { Some((m, v)) => { mask |= m; value |= v; } None => ok = false }
                            }
                            if ok { out.push((mask, value)); }
                        }
                    }
                }
                _ => return search(op_info, val, known_mask, known_value),
            }
        }
    }
    out.retain(consistent);
    out.dedup();
    Ok(out)
}

/// Search the unknown bits an operand reads for the ones that decode to `val`.
fn search(info: &OpInfo, val: Val, known_mask: u32, known_value: u32) -> Result<Vec<(u32, u32)>, ()> {
    let bits = op_bits(info.op);
    let unknown = bits & !known_mask;
    if unknown.count_ones() > MAX_SEARCH_BITS { return Err(()); }
    let mut out = Vec::new();
    let mut subset = 0u32;
    loop {
        let word = known_value & known_mask | subset;
        if info.decode(word).is_some_and(|dec| val.accepts(dec)) { out.push((bits, word & bits)); }
        if subset == unknown { break; }
        subset = subset.wrapping_sub(unknown) & unknown;
    }
    Ok(out)
}

fn row_pattern(op: &OperandDef, row: &Row) -> (u32, u32) {
    let total: u32 = op.cols.iter().map(|part| part.width as u32).sum();
    let (mut mask, mut value) = (0u32, 0u32);
    let mut consumed = 0u32;
    for (pattern, col) in row.bits.iter().zip(op.cols) {
        for (index, expected) in pattern.bytes().enumerate() {
            if !matches!(expected, b'0' | b'1') { continue; }
            let selector_bit = total - consumed - index as u32 - 1;
            let flip = (op.xor >> selector_bit & 1) as u32;
            let bit = col.start as u32 + col.width as u32 - 1 - index as u32;
            mask |= 1 << bit;
            value |= ((expected - b'0') as u32 ^ flip) << bit;
        }
        consumed += col.width as u32;
    }
    (mask, value)
}

fn reg_raws(op: &OperandDef, value: i128) -> Vec<u64> {
    let value = value as i64;
    if value < 0 || op.has_reg_range && (value < op.reg_lo || value > op.reg_hi) ||
        op.reg_multiple > 1 && value % op.reg_multiple != 0 { return Vec::new(); }
    let scale = op.scale.max(1);
    if value % scale != 0 { return Vec::new(); }
    let n = value / scale;
    let mut out = Vec::new();
    if op.negate != 0 { out.push(op.negate - n); }
    else if !op.ranges.is_empty() {
        let mut encoded_lo = 0;
        for range in op.ranges {
            let count = range.hi - range.lo + 1;
            let raw = n - range.bias;
            if raw >= encoded_lo && raw < encoded_lo + count { out.push(raw); }
            encoded_lo += count;
        }
    } else { out.push(n - op.bias); }
    out.into_iter().filter(|raw| *raw >= 0).map(|raw| raw as u64).collect()
}

fn num_raw(op: &OperandDef, value: i128) -> Option<u64> {
    if op.has_range && (value < op.lo as i128 || value > op.hi as i128) { return None; }
    let scale = op.scale.max(1) as i128;
    if value % scale != 0 { return None; }
    let mut t = value / scale;
    if op.raw_mul != 0 {
        let mul = op.raw_mul as i128;
        if t % mul != 0 { return None; }
        t /= mul;
    }
    let width = total_width(op) as u32;
    if width == 0 || width > 63 { return None; }
    let raw = if op.negate != 0 { op.negate as i128 - t } else { t - op.bias as i128 };
    if op.signed && op.negate == 0 {
        let half = 1i128 << (width - 1);
        if raw < -half || raw >= half { return None; }
        Some((raw & ((1i128 << width) - 1)) as u64)
    } else {
        (0..1i128 << width).contains(&raw).then_some(raw as u64)
    }
}

fn solve(cand: &Cand, targets: &[Target], out: &mut Vec<u32>) {
    let form = cand.form;
    search_targets(cand, targets, 0, form.mask, form.value & form.mask, out);
}

fn search_targets(cand: &Cand, targets: &[Target], index: usize, mask: u32, value: u32, out: &mut Vec<u32>) {
    if index == targets.len() { return leaf(cand, targets, mask, value, out); }
    let options = match options_for(cand.info, &targets[index], mask, value) {
        Ok(options) => options,
        Err(()) => vec![(0, 0)],
    };
    for (option_mask, option_value) in options {
        search_targets(cand, targets, index + 1, mask | option_mask, value & !option_mask | option_value, out);
    }
}

/// Extend a partially known word (`mask`, `value`) through the form's field
/// equalities: a fully known side fixes the other. `None` when two known sides
/// disagree.
fn propagate_equalities(form: &Form, mut mask: u32, mut value: u32) -> Option<(u32, u32)> {
    for _ in 0..4 {
        let mut changed = false;
        for eq in form.equalities {
            let width = eq.left_end - eq.left_start + 1;
            let left = low_mask(width) << eq.left_start;
            let right = low_mask(width) << eq.right_start;
            if mask & left == left && mask & right != right {
                let field_value = (field(value, eq.left_start, eq.left_end) + eq.add) & low_mask(width);
                let placed = field_value << eq.right_start;
                if (placed ^ value) & mask & right != 0 { return None; }
                value = value & !right | placed; mask |= right; changed = true;
            } else if mask & right == right && mask & left != left {
                let field_value = field(value, eq.right_start, eq.right_end).wrapping_sub(eq.add) & low_mask(width);
                let placed = field_value << eq.left_start;
                if (placed ^ value) & mask & left != 0 { return None; }
                value = value & !left | placed; mask |= left; changed = true;
            }
        }
        if !changed { break; }
    }
    Some((mask, value))
}

fn leaf(cand: &Cand, targets: &[Target], mut mask: u32, mut value: u32, out: &mut Vec<u32>) {
    let form = cand.form;
    if (value ^ form.constraint_value) & mask & form.constraint_mask != 0 { return; }
    value = value & !form.constraint_mask | form.constraint_value & form.constraint_mask;
    mask |= form.constraint_mask;
    let Some((m, v)) = propagate_equalities(form, mask, value) else { return };
    mask = m;
    value = v;
    let free = !mask;
    if free.count_ones() > MAX_FREE_BITS { return; }
    let mut subset = 0u32;
    loop {
        let word = value & mask | subset;
        if form_matches(form, word) && verify(cand, targets, word) && !out.contains(&word) { out.push(word); }
        if subset == free { break; }
        subset = subset.wrapping_sub(free) & free;
    }
}

// ---------------------------------------------------------------------------
// Match prefilter
// ---------------------------------------------------------------------------

/// The most `(mask, value)` assignments one candidate may carry while its
/// fixed operands are folded in. A check that would exceed it is skipped, which
/// only loosens the filter.
const FILTER_PAIR_LIMIT: usize = 256;

/// Words one candidate can match: the form's opcode bits, then every operand
/// the text fixes (a `Check` without a hole), solved by the same routine the
/// encoder uses, then field equalities. A superset of what `matches` accepts.
fn cand_filters(cand: &Cand) -> Vec<(u32, u32)> {
    let form = cand.form;
    let mask = form.mask | form.constraint_mask;
    let value = form.value & form.mask | form.constraint_value & form.constraint_mask;
    let mut pairs = vec![(mask, value)];
    for check in &cand.checks {
        let target = match *check {
            Check::When { mask, value } => Target::Bits(mask, value),
            Check::Raw { op, want } => Target::Raw(op, want),
            Check::Want { op, val } => Target::Val(op, val),
            _ => continue,
        };
        let mut next: Vec<(u32, u32)> = Vec::new();
        for &(mask, value) in &pairs {
            match options_for(cand.info, &target, mask, value) {
                Ok(options) => {
                    for (option_mask, option_value) in options {
                        next.push((mask | option_mask, value & !option_mask | option_value));
                    }
                }
                Err(()) => next.push((mask, value)),
            }
            if next.len() > FILTER_PAIR_LIMIT { break; }
        }
        if next.len() <= FILTER_PAIR_LIMIT { pairs = next; }
    }
    pairs.into_iter().filter_map(|(mask, value)| propagate_equalities(form, mask, value)).collect()
}

/// The domains of hole `hole` over every candidate form. A candidate takes the
/// value in the position the text puts the hole; when the template has other
/// holes and the candidates differ, a value is only a bound (`exact` false), as
/// whether it encodes then depends on how the other holes are bound.
fn hole_domains(cands: &[Cand], per_cand: &[Vec<(u32, u32)>], hole: usize, others: bool) -> Vec<ClassDomain> {
    let mut lists: Vec<Vec<ClassDomain>> = Vec::new();
    for (cand, known) in cands.iter().zip(per_cand) {
        let mut local: Vec<ClassDomain> = Vec::new();
        let mut uses = 0;
        // An operand-dependent check (the stack pointer may only stand in
        // for Rd or Rn) makes a value valid only beside certain others.
        let tied = cand.checks.iter().any(|check| matches!(check, Check::AnySp { .. }));
        for check in &cand.checks {
            match *check {
                Check::Hole { op, hole: slot, class } if slot as usize == hole => {
                    uses += 1;
                    let info = cand.info.op(op);
                    let classes = match class { Some(class) => vec![class], None => info.classes() };
                    for class in classes {
                        // A table selects rows by class; any other operand decodes to its own.
                        let want = if matches!(info.op.kind, Kind::Table) { Some(class) } else { None };
                        for &pair in known { for domain in op_domains(cand.form, info, want, pair) { add_domain(&mut local, class, domain); } }
                    }
                }
                Check::FusedHole { table, num, hole: slot } if slot as usize == hole => {
                    uses += 1;
                    for class in cand.info.op(table).fused.iter().flatten() {
                        for &pair in known {
                            for mut domain in op_domains(cand.form, cand.info.op(num), None, pair) { domain.exact = false; add_domain(&mut local, *class, domain); }
                        }
                    }
                }
                _ => {}
            }
        }
        if uses > 1 || tied { for entry in &mut local { entry.domain.exact = false; } }
        local.sort_by_key(|entry| (entry.class, entry.domain.min, entry.domain.max, entry.domain.step));
        if !lists.contains(&local) { lists.push(local); }
    }
    let mut merged: Vec<ClassDomain> = Vec::new();
    let differ = lists.len() > 1;
    for list in lists {
        for mut entry in list {
            if others && differ { entry.domain.exact = false; }
            add_domain(&mut merged, entry.class, entry.domain);
        }
    }
    merged
}

/// The merged filter of every candidate: duplicates and refinements dropped,
/// pairs differing in one bit joined.
fn word_filters(per_cand: &[Vec<(u32, u32)>]) -> Vec<(u32, u32)> {
    let mut pairs: Vec<(u32, u32)> = per_cand.iter().flatten().map(|&(mask, value)| (mask, value & mask)).collect();
    loop {
        pairs.sort_unstable();
        pairs.dedup();
        let before = pairs.len();
        // A pair that constrains more than another pair already covers it.
        let keep: Vec<bool> = (0..pairs.len()).map(|i| {
            let (mask, value) = pairs[i];
            !pairs.iter().enumerate().any(|(j, &(other_mask, other_value))| {
                j != i && other_mask & !mask == 0 && (value ^ other_value) & other_mask == 0
            })
        }).collect();
        let mut index = 0;
        pairs.retain(|_| { index += 1; keep[index - 1] });
        // Two pairs with the same mask whose values differ in one bit join.
        'join: for i in 0..pairs.len() {
            for j in i + 1..pairs.len() {
                let (mask, value) = pairs[i];
                let diff = value ^ pairs[j].1;
                if mask == pairs[j].0 && diff.count_ones() == 1 {
                    pairs[i] = (mask & !diff, value & !diff);
                    pairs.remove(j);
                    break 'join;
                }
            }
        }
        if pairs.len() == before { break; }
    }
    pairs
}

fn verify(cand: &Cand, targets: &[Target], word: u32) -> bool {
    targets.iter().all(|target| match *target {
        Target::Bits(mask, value) => word & mask == value,
        Target::Raw(op, want) => raw_value(cand.info.op(op).op, word) == want,
        Target::AnySp(a, b) => word & a == a || word & b == b,
        Target::Val(op, val) => cand.info.op(op).decode(word).is_some_and(|dec| val.accepts(dec)),
    })
}

// ---------------------------------------------------------------------------
// Describing a decoded word as text plus operand spans
// ---------------------------------------------------------------------------

/// One operand of a [`Described`] instruction.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct OperandSpan {
    /// Byte range in [`Described::text`] that a hole may replace.
    pub start: usize,
    pub end: usize,
    pub class: OperandClass,
    pub value: i128,
    /// How the value relates to the instruction's address: a PC-relative
    /// target (branch, compare-and-branch, test-and-branch, ADR, ADRP, literal
    /// load) is an offset, so the same bytes at another address reach another
    /// target.
    pub position: Position,
}

impl OperandSpan {
    /// Whether the value is an offset from the instruction's address.
    pub fn position_dependent(&self) -> bool { self.position.is_position_dependent() }
}

/// A decoded instruction as template text plus the span of every operand.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct Described {
    /// The formatter's spelling with labels as `.+N`/`.-N`; parses as a
    /// [`Template`] that matches the word.
    pub text: String,
    pub operands: Vec<OperandSpan>,
}

/// Describe `word` with the form the formatter prints it with. Replacing any
/// one span with `$h` gives a template that matches `word` and binds `h` to
/// that span's class and value.
pub fn describe(word: u32) -> Option<Described> {
    let mut forms: Vec<usize> = Vec::new();
    if let Some(best) = best_form(word) { forms.push(form_position(best)); }
    for &index in &form_buckets()[(word >> 24) as usize] {
        let index = index as usize;
        if !forms.contains(&index) && form_matches(&FORMS[index], word) { forms.push(index); }
    }
    forms.into_iter().find_map(|index| describe_with(index, word))
}

fn form_position(form: &'static Form) -> usize {
    (form as *const Form as usize - FORMS.as_ptr() as usize) / std::mem::size_of::<Form>()
}

fn describe_with(index: usize, word: u32) -> Option<Described> {
    let rendered = render_tree(index, word, false)?;
    let mut operands = Vec::with_capacity(rendered.slots.len());
    for slot in &rendered.slots {
        let value = slot.value?;
        operands.push(OperandSpan {
            start: slot.start, end: slot.end, class: value.class, value: value.value,
            position: value.position,
        });
    }
    Some(Described { text: rendered.text, operands })
}

/// A form rendered through the assembler's syntax tree.
pub(crate) struct Rendered { pub(crate) text: String, pub(crate) slots: Vec<Slot> }

/// One operand slot of a rendered form: its span, printed text and the value
/// a hole there binds.
pub(crate) struct Slot { pub(crate) start: usize, pub(crate) end: usize, pub(crate) text: String, pub(crate) value: Option<OperandValue> }

/// Render form `index` for `word` the way the formatter does (its group
/// omission and alternative choice), or with every optional group present.
pub(crate) fn render_tree(index: usize, word: u32, explicit_groups: bool) -> Option<Rendered> {
    let form = &FORMS[index];
    if !form_matches(form, word) { return None; }
    let info = form_info(index);
    let mut skipped = [false; 32];
    if !explicit_groups {
        for part in form.parts {
            let group = part.group as usize;
            if group != 0 && group < skipped.len() { skipped[group] = group_omitted(form, part.group, word); }
        }
    }
    let mut out = Rendered { text: String::new(), slots: Vec::new() };
    render_nodes(&info.ast, info, word, &skipped, &mut out)?;
    let trimmed = out.text.trim_end().len();
    out.text.truncate(trimmed);
    Some(out)
}

fn push_text(out: &mut String, text: &str) {
    for c in text.chars() {
        if c.is_whitespace() {
            if !out.is_empty() && !out.ends_with(' ') { out.push(' '); }
        } else {
            out.push(c);
        }
    }
}

fn render_nodes(nodes: &[Node], info: &FormInfo, word: u32, skipped: &[bool; 32], out: &mut Rendered) -> Option<()> {
    for node in nodes {
        let start = out.text.len();
        let (text, value) = match node {
            Node::Lit(_, display) => { push_text(&mut out.text, display); continue; }
            Node::Group(group, body) => {
                if !skipped[*group as usize] { render_nodes(body, info, word, skipped, out)?; }
                continue;
            }
            Node::Alt(alts) => {
                let mut chosen: Option<Rendered> = None;
                for alt in alts {
                    let mut trial = Rendered { text: out.text.clone(), slots: Vec::new() };
                    render_nodes(alt, info, word, skipped, &mut trial)?;
                    if chosen.is_none() && trial.text.len() > out.text.len() && !trial.text[out.text.len()..].trim().is_empty() {
                        chosen = Some(trial);
                    }
                }
                if let Some(trial) = chosen { out.text = trial.text; out.slots.extend(trial.slots); }
                continue;
            }
            Node::Op(part) => {
                let op_info = info.op(*part);
                let text = render_operand(op_info.op, word)?;
                let value = op_info.decode(word).map(|dec| OperandValue::new(dec.class, dec.value).with_position(dec.position));
                (text, value)
            }
            Node::FusedLit { op, letter, class } => {
                let op_info = info.op(*op);
                let text = format!("{}{}", letter.to_ascii_uppercase() as char, render_operand(op_info.op, word)?);
                (text, op_info.decode(word).map(|dec| OperandValue::new(*class, dec.value)))
            }
            Node::FusedTable { table, num } => {
                let (table_info, num_info) = (info.op(*table), info.op(*num));
                let text = format!("{}{}", render_operand(table_info.op, word)?, render_operand(num_info.op, word)?);
                let class = first_row(table_info.op, word).and_then(|row| table_info.fused[row]);
                let value = num_info.decode(word).and_then(|dec| class.map(|class| OperandValue::new(class, dec.value)));
                (text, value)
            }
        };
        if text.is_empty() { continue; }
        out.text.push_str(&text);
        out.slots.push(Slot { start, end: out.text.len(), text, value });
    }
    Some(())
}

// ---------------------------------------------------------------------------
// Mnemonic index
// ---------------------------------------------------------------------------

/// Forms by the leading word of their mnemonic. `exact` forms need the input
/// word to equal the key; the others continue the mnemonic with an operand
/// (`ADDHN{2}`, `B.<cond>`) and match any input word the key prefixes.
struct Index { keys: Vec<(String, u16, bool)>, names: Vec<String> }

fn index() -> &'static Index {
    static INDEX: OnceLock<Index> = OnceLock::new();
    INDEX.get_or_init(|| {
        let mut keys: Vec<(String, u16, bool)> = Vec::new();
        for (position, form) in FORMS.iter().enumerate() {
            let Some(first) = form.parts.first().filter(|part| part.operand.is_none()) else { continue };
            let key: String = first.literal.chars().take_while(char::is_ascii_alphanumeric).map(|c| c.to_ascii_lowercase()).collect();
            // Only a mnemonic whose literal ends at the key (`ADDHN` + `{2}`)
            // continues into an operand; `B.<cond>` must still match `b` whole.
            let exact = key.len() != first.literal.len() || form.parts.len() == 1;
            if !key.is_empty() { keys.push((key, position as u16, exact)); }
        }
        keys.sort();
        let mut names: Vec<String> = keys.iter().map(|(key, ..)| key.clone()).collect();
        names.dedup();
        Index { keys, names }
    })
}

fn candidate_forms(input: &Input) -> Result<Vec<usize>, AssembleError> {
    let index = index();
    let word: Vec<u8> = input.b.iter().copied().take_while(u8::is_ascii_alphanumeric).collect();
    let mut forms = Vec::new();
    for len in 1..=word.len() {
        let key = std::str::from_utf8(&word[..len]).unwrap_or("");
        let start = index.keys.partition_point(|(k, ..)| k.as_str() < key);
        for (k, form, exact) in &index.keys[start..] {
            if k != key { break; }
            if *exact && len != word.len() { continue; }
            forms.push(*form as usize);
        }
    }
    forms.sort_unstable();
    forms.dedup();
    if forms.is_empty() {
        let mnemonic = String::from_utf8_lossy(&word).into_owned();
        let mut scored: Vec<(usize, &'static str)> = index.names.iter()
            .map(|name| (edit_distance(&mnemonic, name), name.as_str())).collect();
        scored.sort();
        let limit = (mnemonic.len() / 2).max(2);
        let nearest = scored.into_iter().filter(|(distance, _)| *distance <= limit).take(5).map(|(_, name)| name).collect();
        return Err(AssembleError::UnknownMnemonic { mnemonic, nearest });
    }
    Ok(forms)
}

fn edit_distance(a: &str, b: &str) -> usize {
    let b = b.as_bytes();
    let mut row: Vec<usize> = (0..=b.len()).collect();
    for (i, ca) in a.bytes().enumerate() {
        let mut previous = row[0];
        row[0] = i + 1;
        for (j, cb) in b.iter().enumerate() {
            let substitute = previous + usize::from(ca != *cb);
            previous = row[j + 1];
            row[j + 1] = substitute.min(row[j] + 1).min(previous + 1);
        }
    }
    row[b.len()]
}

