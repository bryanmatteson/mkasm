//! A64 encoded references and transactional block relocation.
use super::*;
use crate::decoders::decode;
use assembler::Position;
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum AddressReferenceKind {
    Branch,
    Data,
    Literal,
    Absolute,
}
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct EncodedBits {
    pub instruction_bit: u8,
    pub value_bit: u8,
    pub width: u8,
}
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct AddressReference {
    /// Index in the owning formatter form, stable independently of printed spans.
    pub operand_index: usize,
    pub kind: AddressReferenceKind,
    pub bits: Vec<EncodedBits>,
    pub signed: bool,
    pub scale: i128,
    pub bias: i128,
    pub position: Position,
    pub min: i128,
    pub max: i128,
    pub target: u64,
}
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum RelocateError {
    Unknown,
    Unsupported,
    OutOfRange,
    Truncated,
    BufferTooSmall,
    AddressOverflow,
    MidInstructionTarget,
    PositionDiscovery,
    Unaligned,
}
fn selected_form(word: u32) -> Option<&'static Form> {
    analysis::selected_form(word)
}

fn is_branch(word: u32) -> bool {
    word & 0x7c00_0000 == 0x1400_0000
        || word & 0xff00_0000 == 0x5400_0000
        || word & 0x7e00_0000 == 0x3400_0000
        || word & 0x7e00_0000 == 0x3600_0000
}
fn is_call(word: u32) -> bool {
    word & 0xfc00_0000 == 0x9400_0000
}
/// References use Arm's generated operand placements, including split immediates
/// and literal zero bits; numeric field positions never come from rendered text.
pub fn address_references(word: u32, address: u64) -> Result<Vec<AddressReference>, RelocateError> {
    decode(word).map_err(|_| RelocateError::Unknown)?;
    let form = selected_form(word).ok_or(RelocateError::Unsupported)?;
    let mut refs = Vec::new();
    for (index, part) in form.parts.iter().enumerate() {
        let Some(op) = &part.operand else { continue };
        if op.class != "label" {
            continue;
        }
        if !matches!(op.kind, Kind::Num) {
            return Err(RelocateError::Unsupported);
        }
        let value = assembler::dec_num(op, word).ok_or(RelocateError::Unsupported)?;
        let position = if op.scale == 4096 {
            Position::PageRelative { shift: 12 }
        } else {
            Position::InstructionRelative
        };
        let target = position
            .target(address, value)
            .ok_or(RelocateError::AddressOverflow)?;
        let width = total_width(op);
        if width == 0 || width > 63 {
            return Err(RelocateError::Unsupported);
        }
        let (min, max) = if op.signed {
            (-(1i128 << (width - 1)), (1i128 << (width - 1)) - 1)
        } else {
            (0, (1i128 << width) - 1)
        };
        let scale = op.scale as i128
            * if op.raw_mul == 0 {
                1
            } else {
                op.raw_mul as i128
            };
        let mut bit = width;
        let mut bits = Vec::new();
        for p in op.parts {
            bit -= p.width;
            if !p.is_lit {
                bits.push(EncodedBits {
                    instruction_bit: p.start as u8,
                    value_bit: bit,
                    width: p.width,
                });
            }
        }
        let mnemonic = form.parts.first().map(|p| p.literal.trim()).unwrap_or("");
        let kind = if is_branch(word) {
            AddressReferenceKind::Branch
        } else if mnemonic.starts_with("ldr")
            || mnemonic.starts_with("LDR")
            || mnemonic.starts_with("prfm")
            || mnemonic.starts_with("PRFM")
        {
            AddressReferenceKind::Literal
        } else {
            AddressReferenceKind::Data
        };
        refs.push(AddressReference {
            operand_index: index,
            kind,
            bits,
            signed: op.signed,
            scale,
            bias: op.bias as i128,
            position,
            min,
            max,
            target,
        });
    }
    Ok(refs)
}
/// Rewrite one reference and retain all unrelated bits. The returned word is
/// decoded and checked against the owning form before it can reach the caller.
pub fn rewrite_reference(
    word: u32,
    address: u64,
    operand_index: usize,
    target: u64,
) -> Result<u32, RelocateError> {
    let refs = address_references(word, address)?;
    let r = refs
        .iter()
        .find(|r| r.operand_index == operand_index)
        .ok_or(RelocateError::Unsupported)?;
    let form = selected_form(word).ok_or(RelocateError::Unsupported)?;
    let op = form.parts[operand_index]
        .operand
        .as_ref()
        .ok_or(RelocateError::Unsupported)?;
    let value = r
        .position
        .value_for_target(address, target)
        .ok_or(RelocateError::OutOfRange)?;
    if op.has_num_constant || r.scale == 0 || value % r.scale != 0 {
        return Err(RelocateError::OutOfRange);
    }
    let scaled = value / r.scale;
    let raw = if op.negate != 0 {
        op.negate as i128 - scaled
    } else {
        scaled - op.bias as i128
    };
    if raw < r.min || raw > r.max {
        return Err(RelocateError::OutOfRange);
    }
    let raw = raw as u64;
    let mut next = word;
    let mut shift = total_width(op);
    for p in op.parts {
        shift -= p.width;
        let v = (raw >> shift) & u64::from(low_mask(p.width));
        if p.is_lit {
            if v != literal_or_field(word, *p) {
                return Err(RelocateError::OutOfRange);
            }
        } else {
            let mask = low_mask(p.width) << (p.start as u8);
            next = (next & !mask) | ((v as u32) << (p.start as u8));
        }
    }
    if !form_matches(form, next)
        || assembler::dec_num(op, next) != Some(value)
        || decode(next).is_err()
    {
        return Err(RelocateError::OutOfRange);
    }
    Ok(next)
}
pub fn relocate(word: u32, old_ip: u64, new_ip: u64) -> Result<u32, RelocateError> {
    checked_address(old_ip, 4)?;
    checked_address(new_ip, 4)?;
    if old_ip % 4 != 0 || new_ip % 4 != 0 {
        return Err(RelocateError::Unaligned);
    }
    let refs = address_references(word, old_ip)?;
    if is_call(word) && refs.iter().any(|r| old_ip.checked_add(4) == Some(r.target)) {
        return Err(RelocateError::PositionDiscovery);
    }
    let mut next = word;
    for r in refs {
        next = rewrite_reference(next, new_ip, r.operand_index, r.target)?;
    }
    Ok(next)
}
pub fn relocate_into(
    word: u32,
    old_ip: u64,
    new_ip: u64,
    output: &mut [u8],
) -> Result<usize, RelocateError> {
    let next = relocate(word, old_ip, new_ip)?;
    if output.len() < 4 {
        return Err(RelocateError::BufferTooSmall);
    }
    output[..4].copy_from_slice(&next.to_le_bytes());
    Ok(4)
}
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct RelocatedBlock {
    pub bytes: Vec<u8>,
    pub offsets: Vec<(usize, usize)>,
    pub original_len: usize,
}
fn checked_address(ip: u64, offset: usize) -> Result<u64, RelocateError> {
    ip.checked_add(u64::try_from(offset).map_err(|_| RelocateError::AddressOverflow)?)
        .ok_or(RelocateError::AddressOverflow)
}
fn can_widen(word: u32) -> bool {
    (word & 0xff00_0010 == 0x5400_0000 && word & 15 < 14)
        || word & 0x7e00_0000 == 0x3400_0000
        || word & 0x7e00_0000 == 0x3600_0000
}
fn branch_word(from: u64, target: u64) -> Result<u32, RelocateError> {
    let delta = target as i128 - from as i128;
    if delta % 4 != 0 || !(-(1i128 << 27)..(1i128 << 27)).contains(&delta) {
        return Err(RelocateError::OutOfRange);
    }
    let word = 0x1400_0000 | ((delta / 4) as u32 & 0x03ff_ffff);
    decode(word).map_err(|_| RelocateError::Unsupported)?;
    Ok(word)
}
/// A64 block relocation widens conditional, compare, and test branches to an
/// inverted skip plus B. Internal branch destinations are remapped at a stable
/// fixed point; ADR/ADRP/literal data destinations retain the original address.
/// Veneers needing scratch registers and ADRP+ADD pair rewriting are explicit
/// range errors. Input and output bytes use little endian instruction order.
pub fn relocate_block(
    original: &[u8],
    old_ip: u64,
    new_ip: u64,
) -> Result<RelocatedBlock, RelocateError> {
    if old_ip % 4 != 0 || new_ip % 4 != 0 {
        return Err(RelocateError::Unaligned);
    }
    if original.len() % 4 != 0 {
        return Err(RelocateError::Truncated);
    }
    let old_end = checked_address(old_ip, original.len())?;
    let words: Vec<u32> = original
        .chunks_exact(4)
        .map(|b| u32::from_le_bytes(b.try_into().unwrap()))
        .collect();
    let refs: Vec<Vec<AddressReference>> = words
        .iter()
        .enumerate()
        .map(|(i, &w)| address_references(w, checked_address(old_ip, i * 4)?))
        .collect::<Result<_, _>>()?;
    for (i, rs) in refs.iter().enumerate() {
        for r in rs {
            if is_call(words[i]) && old_ip.checked_add((i * 4 + 4) as u64) == Some(r.target) {
                return Err(RelocateError::PositionDiscovery);
            }
            if r.kind == AddressReferenceKind::Branch
                && r.target >= old_ip
                && r.target < old_end
                && (r.target - old_ip) % 4 != 0
            {
                return Err(RelocateError::MidInstructionTarget);
            }
        }
    }
    let mut wide = vec![false; words.len()];
    loop {
        let mut offsets = vec![0usize];
        for &w in &wide {
            let n = offsets
                .last()
                .unwrap()
                .checked_add(if w { 8 } else { 4 })
                .ok_or(RelocateError::AddressOverflow)?;
            offsets.push(n);
        }
        checked_address(new_ip, *offsets.last().unwrap())?;
        let remap = |r: &AddressReference| -> Result<u64, RelocateError> {
            if r.kind == AddressReferenceKind::Branch && r.target >= old_ip && r.target < old_end {
                checked_address(new_ip, offsets[((r.target - old_ip) / 4) as usize])
            } else {
                Ok(r.target)
            }
        };
        let mut changed = false;
        for i in 0..words.len() {
            if wide[i] {
                continue;
            }
            let to = checked_address(new_ip, offsets[i])?;
            for r in &refs[i] {
                let target = remap(r)?;
                if let Err(error) = rewrite_reference(words[i], to, r.operand_index, target) {
                    if error == RelocateError::OutOfRange
                        && r.kind == AddressReferenceKind::Branch
                        && can_widen(words[i])
                    {
                        wide[i] = true;
                        changed = true;
                    } else {
                        return Err(error);
                    }
                }
            }
        }
        if changed {
            continue;
        }
        let mut bytes = Vec::with_capacity(*offsets.last().unwrap());
        for i in 0..words.len() {
            let to = checked_address(new_ip, offsets[i])?;
            if wide[i] {
                let r = refs[i]
                    .iter()
                    .find(|r| r.kind == AddressReferenceKind::Branch)
                    .ok_or(RelocateError::Unsupported)?;
                let inverse = if words[i] & 0xff00_0010 == 0x5400_0000 {
                    words[i] ^ 1
                } else {
                    words[i] ^ (1 << 24)
                };
                let skip =
                    rewrite_reference(inverse, to, r.operand_index, checked_address(to, 8)?)?;
                bytes.extend_from_slice(&skip.to_le_bytes());
                bytes.extend_from_slice(
                    &branch_word(checked_address(to, 4)?, remap(r)?)?.to_le_bytes(),
                );
            } else {
                let mut word = words[i];
                for r in &refs[i] {
                    word = rewrite_reference(word, to, r.operand_index, remap(r)?)?;
                }
                bytes.extend_from_slice(&word.to_le_bytes());
            }
        }
        return Ok(RelocatedBlock {
            bytes,
            offsets: (0..words.len()).map(|i| (i * 4, offsets[i])).collect(),
            original_len: original.len(),
        });
    }
}
pub fn relocate_block_into(
    original: &[u8],
    old_ip: u64,
    new_ip: u64,
    output: &mut [u8],
) -> Result<usize, RelocateError> {
    let b = relocate_block(original, old_ip, new_ip)?;
    if output.len() < b.bytes.len() {
        return Err(RelocateError::BufferTooSmall);
    }
    output[..b.bytes.len()].copy_from_slice(&b.bytes);
    Ok(b.bytes.len())
}
