// Every word this prints was checked against LLVM's assembler for the same
// source line, so it doubles as a readable smoke test of the typed surface.

use {{.CrateName}}::*;

fn main() {
    let mut asm = Assembler::new();

    // Operands are typed: passing a W register where an X register belongs is a
    // compile error, not a runtime surprise.
    asm.mov(X0, X1); //  AA0103E0  mov x0, x1
    asm.add(X0, X1, 8); //  91002020  add x0, x1, #8
    asm.movz(W0, 1); //  52800020  movz w0, #1

    // One method name covers every addressing mode; the Mem operand picks the
    // encoding.
    asm.ldr(X2, Mem::offset(X1, 16)); //  F9400822  ldr x2, [x1, #16]
    asm.ldr(X3, Mem::post(X1, 8)); //  F8408423  ldr x3, [x1], #8
    asm.str(X4, Mem::pre(X5, 32)); //  F8020CA4  str x4, [x5, #32]!

    // Branch targets take a byte offset directly.
    asm.bl(0x30); //  9400000C  bl .+0x30
    asm.b_cond(Cond::Eq, 0x10); //  54000080  b.eq .+0x10

    asm.nop(); //  D503201F
    asm.ret(); //  D65F03C0  ret (Rn defaults to X30)

    for w in asm.words() {
        println!("{w:08X}");
    }

    // Labels are resolved by finish().
    let mut asm = Assembler::new();
    let top = asm.label();
    asm.bind(top);
    asm.nop();
    asm.b(top);
    let code = asm.finish().expect("encoding failed");
    println!("loop: {:08X?}", code);

    // Out-of-range operands are reported, not silently truncated.
    let mut asm = Assembler::new();
    asm.add(X0, X1, 1 << 20);
    match asm.error() {
        Some(e) => println!("rejected: {e}"),
        None => println!("unexpectedly accepted an out-of-range immediate"),
