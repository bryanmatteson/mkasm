fn reg(out:&mut EffectSummary,n:u32,width:u16,read:bool,write:bool,conditional:bool,sp:bool,address:bool) {
    if n==31&&!sp{return;}
    out.registers.push(RegisterEffect{register:RegisterSlice{bank:if n==31{"sp"}else{"gpr"},number:Some(n as u16),name:"",offset:0,width:Some(width)},read,write,conditional,implicit:false,address,write_behavior:if write{if width==32{WriteBehavior::ZeroUpper}else{WriteBehavior::Replace}}else{WriteBehavior::Unknown}});
}
fn nzcv(out:&mut EffectSummary,write:bool,condition:Option<u32>) {
