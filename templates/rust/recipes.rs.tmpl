//! Audited A64 scalar, fixed-width SIMD and bounded SVE families.
//! Typed FP operations delegate architectural numeric execution to the consumer.
//! This is not a pseudocode interpreter.
use crate::semantics::*;
use BinaryOp as B;
use UnaryOp as U;
fn c(w: u8, v: u64) -> Expr {
    Expr::constant(w, v)
}
fn bin(op: B, a: Expr, b: Expr) -> Expr {
    Expr::binary(op, a, b)
}
fn inv(a: Expr) -> Expr {
    Expr::unary(U::Not, a)
}
fn flag(i: u16) -> Expr {
    Expr::register(register("a64.nzcv", i, 1, 1))
}
fn read(n: u32, w: u8, sp: bool) -> Expr {
    if n == 31 && !sp {
        c(w, 0)
    } else {
        Expr::register(register(
            if n == 31 { "a64.sp" } else { "a64.gpr" },
            if n == 31 { 0 } else { n as u16 },
            w,
            64,
        ))
    }
}
fn write(r: &mut Recipe, n: u32, w: u8, sp: bool, v: Expr) {
    if n != 31 || sp {
        r.write(
            register(
                if n == 31 { "a64.sp" } else { "a64.gpr" },
                if n == 31 { 0 } else { n as u16 },
                w,
                64,
            ),
            WritePolicy::ZeroUpper,
            v,
        )
    }
}
fn setflag(r: &mut Recipe, i: u16, v: Expr) {
    r.write(register("a64.nzcv", i, 1, 1), WritePolicy::ZeroUpper, v)
}
fn nz(r: &mut Recipe, v: Expr) {
    setflag(r, 0, Expr::extract(v.clone(), v.ty.width - 1, 1));
    setflag(r, 1, bin(B::Eq, v.clone(), c(v.ty.width, 0)))
}
fn arithmetic(
    r: &mut Recipe,
    a: Expr,
    b: Expr,
    sub: bool,
    carry: Option<Expr>,
    flags: bool,
) -> Expr {
    let w = a.ty.width;
    let a = r.bind(a);
    let b = r.bind(b);
    let ci = carry.unwrap_or_else(|| c(1, 0));
    let ci = r.bind(ci);
    let v = r.bind(bin(
        if sub { B::Sub } else { B::Add },
        bin(if sub { B::Sub } else { B::Add }, a.clone(), b.clone()),
        Expr::cast(ci.clone(), w, false),
    ));
    if flags {
        nz(r, v.clone());
        setflag(
            r,
            2,
            if sub {
                inv(Expr::sub_borrow(a.clone(), b.clone(), ci))
            } else {
                Expr::add_carry(a.clone(), b.clone(), ci)
            },
        );
        setflag(r, 3, Expr::overflow(sub, a, b, v.clone()))
    }
    v
}
fn condition(code: u32) -> Expr {
    let n = flag(0);
    let z = flag(1);
    let carry = flag(2);
    let v = flag(3);
    let eq = bin(B::Eq, n.clone(), v);
    let base = match code >> 1 {
        0 => z,
        1 => carry,
        2 => n,
        3 => flag(3),
        4 => bin(B::And, carry, inv(z)),
        5 => eq,
        6 => bin(B::And, eq, inv(z)),
        _ => c(1, 1),
    };
    if code & 1 != 0 && code != 15 {
        inv(base)
    } else {
        base
    }
}
fn sign(v: u64, b: u32) -> u64 {
    (((v << (64 - b)) as i64) >> (64 - b)) as u64
}
fn shifted(v: Expr, kind: u32, n: u32) -> Expr {
    let w = v.ty.width;
    bin(
        match kind {
            0 => B::Shl,
            1 => B::Lsr,
            2 => B::Asr,
            _ => B::Ror,
        },
        v,
        c(w, n as u64),
    )
}
fn bitmask(w: u8, n: u32, imms: u32, immr: u32) -> Option<u64> {
    let x = (n << 6) | (!imms & 63);
    if x == 0 {
        return None;
    }
    let len = 31 - x.leading_zeros();
    if len < 1 {
        return None;
    }
    let size = 1u32 << len;
    if size > w as u32 {
        return None;
    }
    let s = imms & (size - 1);
    if s == size - 1 {
        return None;
    }
    let ones = mask((s + 1) as u8);
    let r = immr & (size - 1);
    let element = if r == 0 {
        ones
    } else {
        ((ones >> r) | (ones << (size - r))) & mask(size as u8)
    };
    let mut out = 0;
    for i in (0..w as u32).step_by(size as usize) {
        out |= element << i
    }
    Some(out)
}
fn reverse_bytes(r: &mut Recipe, value: Expr, group: u8) -> Expr {
    let w = value.ty.width;
    let value = r.bind(value);
    let mut out = c(w, 0);
    for part in 0..w / (group * 8) {
        let offset = part * group * 8;
        let bytes = Expr::extract(value.clone(), offset, group * 8);
        let reversed = Expr::unary(U::ReverseBytes, bytes);
        out = bin(
            B::Or,
            out,
            shifted(Expr::cast(reversed, w, false), 0, offset as u32),
        );
    }
    out
}
fn vector_chunk(n: u32, chunk: u16) -> Expr {
    Expr::register(register("a64.vector64", n as u16 * 32 + chunk, 64, 64))
}
fn write_vector_chunk(r: &mut Recipe, n: u32, chunk: u16, value: Expr) {
    let value = r.bind(value);
    r.write(
        register("a64.vector64", n as u16 * 32 + chunk, 64, 64),
        WritePolicy::ZeroUpper,
        value,
    );
}
fn fp_control(r: &mut Recipe) -> Expr {
    r.bind(Expr::register(register("a64.fpcr", 0, 32, 32)))
}
fn fp_status(r: &mut Recipe) -> Expr {
    r.bind(Expr::register(register("a64.fpsr", 0, 32, 32)))
}
fn fp_input(r: &mut Recipe, n: u32, width: u8) -> Expr {
    r.bind(Expr::extract(vector_chunk(n, 0), 0, width))
}
// Each source and each projection is captured before architectural writes.
// The FP engine owns rounding, NaN/flush rules, sticky status and exceptions.
fn fp_step(
    r: &mut Recipe,
    operation: FloatOperation,
    width: u8,
    inputs: Vec<Expr>,
    control: Expr,
    status: Expr,
) -> (Expr, Expr, Expr) {
    let expression = FloatExpression {
        operation,
        environment: FloatEnvironment::A64,
        width,
        inputs,
        control: Box::new(control),
        status: Box::new(status),
        projection: FloatProjection::Value,
    };
    let value = r.bind(Expr::float(expression.clone()));
    let next = r.bind(Expr::float(FloatExpression {
        projection: FloatProjection::Status,
        ..expression.clone()
    }));
    let trapped = r.bind(Expr::float(FloatExpression {
        projection: FloatProjection::Trapped,
        ..expression
    }));
    (value, next, trapped)
}
fn fp_finish(r: &mut Recipe, status: Expr, trapped: Expr) {
    r.write(
        register("a64.fpsr", 0, 32, 32),
        WritePolicy::ZeroUpper,
        status,
    );
    r.effects.push(Effect::Trap {
        kind: TrapKind::FloatingPoint,
        condition: trapped,
    });
}
// Scalar binary arithmetic merges from Vn; one-source arithmetic merges from
// Vd. FPCR's canonical NEP bit includes the consumer's AFP/profile admission.
fn fp_scalar_write(r: &mut Recipe, rd: u32, width: u8, value: Expr, merge: Option<(Expr, u32)>) {
    let (low, high) = if let Some((control, source)) = merge {
        let merging = Expr::extract(control, 2, 1);
        // A 64-bit result overwrites the entire low chunk. Do not make its
        // definedness depend on an unavailable incoming chunk through AND 0.
        let low = if width == 64 { c(64, 0) } else {
            Expr::select(
                merging.clone(),
                bin(B::And, vector_chunk(source, 0), c(64, !mask(width))),
                c(64, 0),
            )
        };
        let high = Expr::select(merging, vector_chunk(source, 1), c(64, 0));
        (low, high)
    } else {
        (c(64, 0), c(64, 0))
    };
    let low = r.bind(bin(B::Or, low, Expr::cast(value, 64, false)));
    let high = r.bind(high);
    write_vector_chunk(r, rd, 0, low);
    write_vector_chunk(r, rd, 1, high);
}
fn fp_width(word: u32) -> Option<u8> {
    match (word >> 22) & 3 {
        0 => Some(32),
        1 => Some(64),
        3 => Some(16),
        _ => None,
    }
}
fn fp_immediate(width: u8, imm: u32) -> u64 {
    let e = if width == 16 {
        5
    } else if width == 32 {
        8
    } else {
        11
    };
    let f = width - e - 1;
    let b = (imm >> 6) & 1;
    let exponent = ((b ^ 1) << (e - 1))
        | (if b != 0 { ((1 << (e - 3)) - 1) << 2 } else { 0 })
        | ((imm >> 4) & 3);
    (((imm >> 7) as u64) << (width - 1))
        | ((exponent as u64) << f)
        | (((imm & 15) as u64) << (f - 4))
}
fn fp_chain(
    r: &mut Recipe,
    operation: FloatOperation,
    width: u8,
    inputs: Vec<Expr>,
    control: &Expr,
    status: &mut Expr,
    trapped: &mut Expr,
) -> Expr {
    let (value, next, exception) =
        fp_step(r, operation, width, inputs, control.clone(), status.clone());
    *status = r.bind(Expr::select(trapped.clone(), status.clone(), next));
    *trapped = r.bind(bin(B::Or, trapped.clone(), exception));
    value
}
fn fp_lane(r: &mut Recipe, n: u32, lane: u8, width: u8) -> Expr {
    let bit = lane as u16 * width as u16;
    r.bind(Expr::extract(
        vector_chunk(n, bit / 64),
        (bit % 64) as u8,
        width,
    ))
}
fn fp_pack(r: &mut Recipe, rd: u32, width: u8, values: Vec<Expr>) {
    let mut chunks = [c(64, 0), c(64, 0)];
    for (lane, value) in values.into_iter().enumerate() {
        let bit = lane * width as usize;
        chunks[bit / 64] = bin(
            B::Or,
            chunks[bit / 64].clone(),
            shifted(Expr::cast(value, 64, false), 0, (bit % 64) as u32),
        );
    }
    for (chunk, value) in chunks.into_iter().enumerate() {
        write_vector_chunk(r, rd, chunk as u16, value);
    }
}
fn fp_reduce(
    r: &mut Recipe,
    operation: FloatOperation,
    width: u8,
    values: &[Expr],
    control: &Expr,
    status: &mut Expr,
    trapped: &mut Expr,
) -> Expr {
    if values.len() == 1 {
        return values[0].clone();
    }
    // Arm FPReduce evaluates the high subtree before the low subtree, but
    // passes (low,high) to the final primitive. Preserve NaN and trap order.
    let half = values.len() / 2;
    let hi = fp_reduce(
        r,
        operation,
        width,
        &values[half..],
        control,
        status,
        trapped,
    );
    let lo = fp_reduce(
        r,
        operation,
        width,
        &values[..half],
        control,
        status,
        trapped,
    );
    fp_chain(r, operation, width, vec![lo, hi], control, status, trapped)
}
fn fp_vector_extra(word: u32, address: u64) -> Option<Recipe> {
    let mut r = Recipe::new(address.wrapping_add(4), 64);
    let unsupported = || {
        Recipe::unsupported(
            "A64 SIMD FP constrained selector has no exact recipe",
            address.wrapping_add(4),
            64,
        )
    };
    let rd = word & 31;
    let rn = (word >> 5) & 31;
    let rm = (word >> 16) & 31;
    let scalar = word & (1 << 28) != 0;
    let normalized = word & !(1 << 28);
    let base = normalized & !(1 << 29);
    let h = base & 0xbffffc00;
    let s = base & 0xbfbffc00;
    let conversions = [
        (0x0e79d800, 0x0e21d800, 0),
        (0x0e79a800, 0x0e21a800, 1),
        (0x0e79c800, 0x0e21c800, 2),
        (0x0ef9a800, 0x0ea1a800, 3),
        (0x0e79b800, 0x0e21b800, 4),
        (0x0ef9b800, 0x0ea1b800, 5),
    ];
    let conversion = conversions
        .iter()
        .find(|(half, wide, _)| h == *half || s == *wide);
    let fixed = matches!(base & 0xbf80fc00, 0x0f00e400 | 0x0f00fc00);
    let round_h = normalized & 0xbffffc00;
    let round_s = normalized & 0xbfbffc00;
    let rounds = [
        (0x0e798800, 0x0e218800, FloatRounding::NearestEven, false),
        (
            0x0ef98800,
            0x0ea18800,
            FloatRounding::PositiveInfinity,
            false,
        ),
        (
            0x0e799800,
            0x0e219800,
            FloatRounding::NegativeInfinity,
            false,
        ),
        (0x0ef99800, 0x0ea19800, FloatRounding::Zero, false),
        (0x2e798800, 0x2e218800, FloatRounding::NearestAway, false),
        (0x2e799800, 0x2e219800, FloatRounding::Environment, true),
        (0x2ef99800, 0x2ea19800, FloatRounding::Environment, false),
    ];
    let round = rounds
        .iter()
        .find(|(half, wide, _, _)| round_h == *half || round_s == *wide);
    if conversion.is_some() || fixed || round.is_some() {
        if scalar && (word & (1 << 30) == 0 || round.is_some()) {
            return Some(unsupported());
        }
        let (width, operation) = if fixed {
            let imm = ((word >> 16) & 127) as u8;
            if imm < 16 {
                return Some(unsupported());
            }
            let width = if imm >= 64 {
                64
            } else if imm >= 32 {
                32
            } else {
                16
            };
            let signed = word & (1 << 29) == 0;
            let fractional_bits = 2 * width - imm;
            let operation = if word & 0x1800 == 0 {
                FloatOperation::FromInteger {
                    source_width: width,
                    signed,
                    fractional_bits,
                }
            } else {
                FloatOperation::ToInteger {
                    source_width: width,
                    signed,
                    fractional_bits,
                    rounding: FloatRounding::Zero,
                }
            };
            (width, operation)
        } else if let Some((half, _, kind)) = conversion {
            let width = if h == *half {
                16
            } else {
                32 << ((word >> 22) & 1)
            };
            let signed = word & (1 << 29) == 0;
            let operation = if *kind == 0 {
                FloatOperation::FromInteger {
                    source_width: width,
                    signed,
                    fractional_bits: 0,
                }
            } else {
                FloatOperation::ToInteger {
                    source_width: width,
                    signed,
                    fractional_bits: 0,
                    rounding: match kind {
                        1 => FloatRounding::NearestEven,
                        2 => FloatRounding::NearestAway,
                        3 => FloatRounding::PositiveInfinity,
                        4 => FloatRounding::NegativeInfinity,
                        _ => FloatRounding::Zero,
                    },
                }
            };
            (width, operation)
        } else {
            let (half, _, rounding, exact) = round.unwrap();
            (
                if round_h == *half {
                    16
                } else {
                    32 << ((word >> 22) & 1)
                },
                FloatOperation::RoundToIntegral {
                    rounding: *rounding,
                    exact: *exact,
                },
            )
        };
        let bits = if word & (1 << 30) != 0 { 128 } else { 64 };
        if !scalar && width == 64 && bits == 64 {
            return Some(unsupported());
        }
        let lanes = if scalar { 1 } else { bits / width };
        let control = fp_control(&mut r);
        let mut status = fp_status(&mut r);
        let mut trapped = c(1, 0);
        let mut values = vec![];
        for lane in 0..lanes {
            let input = fp_lane(&mut r, rn, lane, width);
            values.push(fp_chain(
                &mut r,
                operation,
                width,
                vec![input],
                &control,
                &mut status,
                &mut trapped,
            ));
        }
        fp_finish(&mut r, status, trapped);
        if scalar {
            fp_scalar_write(&mut r, rd, width, values.remove(0), Some((control, rd)));
        } else {
            fp_pack(&mut r, rd, width, values);
        }
        return Some(r);
    }
    // Widening reads the selected source half; narrowing inserts the selected
    // destination half. FCVTXN's round-to-odd is a native conversion mode.
    let precision = word & 0xbfbffc00;
    let odd_scalar = word & 0xfffffc00 == 0x7e616800;
    let odd_vector = word & 0xbffffc00 == 0x2e616800;
    if !scalar && matches!(precision, 0x0e217800 | 0x0e216800) || odd_scalar || odd_vector {
        let widening = precision == 0x0e217800 && !odd_scalar && !odd_vector;
        let odd = odd_scalar || odd_vector;
        let narrow = if odd { 32 } else { 16 << ((word >> 22) & 1) };
        let width = if widening { 2 * narrow } else { narrow };
        let source_width = if widening { narrow } else { 2 * narrow };
        let lanes = if odd_scalar { 1 } else { 64 / narrow };
        let part = ((word >> 30) & 1) as u16;
        let control = fp_control(&mut r);
        let mut status = fp_status(&mut r);
        let mut trapped = c(1, 0);
        let mut values = vec![];
        for lane in 0..lanes {
            let source_lane = if widening {
                lane + part as u8 * (64 / source_width)
            } else {
                lane
            };
            let input = fp_lane(&mut r, rn, source_lane, source_width);
            values.push(fp_chain(
                &mut r,
                FloatOperation::Convert {
                    source_width,
                    round_to_odd: odd,
                },
                width,
                vec![input],
                &control,
                &mut status,
                &mut trapped,
            ));
        }
        fp_finish(&mut r, status, trapped);
        if odd_scalar {
            fp_scalar_write(&mut r, rd, width, values.remove(0), Some((control, rd)));
        } else if widening {
            fp_pack(&mut r, rd, width, values);
        } else {
            let mut value = c(64, 0);
            for (lane, x) in values.into_iter().enumerate() {
                value = bin(
                    B::Or,
                    value,
                    shifted(Expr::cast(x, 64, false), 0, lane as u32 * width as u32),
                );
            }
            write_vector_chunk(&mut r, rd, part, value);
            if part == 0 {
                write_vector_chunk(&mut r, rd, 1, c(64, 0));
            }
        }
        return Some(r);
    }
    let compare_h = normalized & 0xbfe0fc00;
    let compare_s = normalized & 0xbfa0fc00;
    // kind: EQ, GE, GT, absolute GE, absolute GT.
    let compares = [
        (0x0e402400, 0x0e20e400, 0),
        (0x2e402400, 0x2e20e400, 1),
        (0x2ec02400, 0x2ea0e400, 2),
        (0x2e402c00, 0x2e20ec00, 3),
        (0x2ec02c00, 0x2ea0ec00, 4),
    ];
    let compare = compares
        .iter()
        .find(|(half, wide, _)| compare_h == *half || compare_s == *wide);
    let zero_h = normalized & 0xbffffc00;
    let zero_s = normalized & 0xbfbffc00;
    // EQ, GE, GT, LE and LT against zero. These never merge upper bits.
    let zeros = [
        (0x0ef8d800, 0x0ea0d800, 0),
        (0x2ef8c800, 0x2ea0c800, 1),
        (0x0ef8c800, 0x0ea0c800, 2),
        (0x2ef8d800, 0x2ea0d800, 5),
        (0x0ef8e800, 0x0ea0e800, 6),
    ];
    let zero = zeros
        .iter()
        .find(|(half, wide, _)| zero_h == *half || zero_s == *wide);
    if compare.is_some() || zero.is_some() {
        if scalar && word & (1 << 30) == 0 {
            return Some(unsupported());
        }
        let (half, _, kind) = compare.or(zero).unwrap();
        let width =
            if (compare.is_some() && compare_h == *half) || (zero.is_some() && zero_h == *half) {
                16
            } else {
                32 << ((word >> 22) & 1)
            };
        let bits = if word & (1 << 30) != 0 { 128 } else { 64 };
        if !scalar && width == 64 && bits == 64 {
            return Some(unsupported());
        }
        let control = fp_control(&mut r);
        let mut status = fp_status(&mut r);
        let mut trapped = c(1, 0);
        let mut values = vec![];
        for lane in 0..if scalar { 1 } else { bits / width } {
            let mut a = fp_lane(&mut r, rn, lane, width);
            let mut b = if zero.is_some() {
                c(width, 0)
            } else {
                fp_lane(&mut r, rm, lane, width)
            };
            if *kind == 3 || *kind == 4 {
                a = r.bind(bin(B::And, a, c(width, mask(width - 1))));
                b = r.bind(bin(B::And, b, c(width, mask(width - 1))));
            }
            if *kind >= 5 {
                std::mem::swap(&mut a, &mut b);
            }
            let flags = fp_chain(
                &mut r,
                FloatOperation::Compare {
                    source_width: width,
                    signal_all_nans: *kind != 0,
                },
                4,
                vec![a, b],
                &control,
                &mut status,
                &mut trapped,
            );
            let eq = Expr::extract(flags.clone(), 2, 1);
            let ge = bin(
                B::And,
                Expr::extract(flags.clone(), 1, 1),
                inv(Expr::extract(flags, 0, 1)),
            );
            let test = if *kind == 0 {
                eq
            } else if matches!(*kind, 1 | 3 | 5) {
                ge
            } else {
                bin(B::And, ge, inv(eq))
            };
            values.push(r.bind(Expr::select(test, c(width, mask(width)), c(width, 0))));
        }
        fp_finish(&mut r, status, trapped);
        if scalar {
            fp_scalar_write(
                &mut r,
                rd,
                width,
                values.remove(0),
                if zero.is_some() {
                    None
                } else {
                    Some((control, rm))
                },
            );
        } else {
            fp_pack(&mut r, rd, width, values);
        }
        return Some(r);
    }
    let indexed_h = normalized & 0xbfc0f400;
    let indexed_s = normalized & 0xbf80f400;
    let indexed = [
        (0x0f009000, 0x0f809000, 0),
        (0x0f001000, 0x0f801000, 1),
        (0x0f005000, 0x0f805000, 2),
    ];
    if let Some((half, _, kind)) = indexed
        .iter()
        .find(|(half, wide, _)| indexed_h == *half || indexed_s == *wide)
    {
        if scalar && word & (1 << 30) == 0 {
            return Some(unsupported());
        }
        let width = if indexed_h == *half {
            16
        } else {
            32 << ((word >> 22) & 1)
        };
        let high = ((word >> 11) & 1) as u8;
        let low = ((word >> 21) & 1) as u8;
        if width == 64 && low != 0 {
            return Some(unsupported());
        }
        let index = if width == 16 {
            high * 4 + low * 2 + ((word >> 20) & 1) as u8
        } else if width == 32 {
            high * 2 + low
        } else {
            high
        };
        let source = if width == 16 { rm & 15 } else { rm };
        let bits = if word & (1 << 30) != 0 { 128 } else { 64 };
        if !scalar && width == 64 && bits == 64 {
            return Some(unsupported());
        }
        let control = fp_control(&mut r);
        let mut status = fp_status(&mut r);
        let mut trapped = c(1, 0);
        let mut values = vec![];
        let indexed = fp_lane(&mut r, source, index, width);
        let operation = if *kind == 0 {
            FloatOperation::Multiply
        } else {
            FloatOperation::FusedMultiplyAdd {
                negate_product: *kind == 2,
                negate_addend: false,
            }
        };
        for lane in 0..if scalar { 1 } else { bits / width } {
            let a = fp_lane(&mut r, rn, lane, width);
            let inputs = if *kind == 0 {
                vec![a, indexed.clone()]
            } else {
                let addend = fp_lane(&mut r, rd, lane, width);
                vec![addend, a, indexed.clone()]
            };
            values.push(fp_chain(
                &mut r,
                operation,
                width,
                inputs,
                &control,
                &mut status,
                &mut trapped,
            ));
        }
        fp_finish(&mut r, status, trapped);
        if scalar {
            fp_scalar_write(
                &mut r,
                rd,
                width,
                values.remove(0),
                Some((control, if *kind == 0 { rn } else { rd })),
            );
        } else {
            fp_pack(&mut r, rd, width, values);
        }
        return Some(r);
    }
    let pair_h = word & 0xfffffc00;
    let pair_s = word & 0xffbffc00;
    let scalar_pairs = [
        (0x5e30d800, 0x7e30d800, 0),
        (0x5e30f800, 0x7e30f800, 1),
        (0x5eb0f800, 0x7eb0f800, 2),
        (0x5e30c800, 0x7e30c800, 3),
        (0x5eb0c800, 0x7eb0c800, 4),
    ];
    if let Some((half, _, kind)) = scalar_pairs
        .iter()
        .find(|(half, wide, _)| pair_h == *half || pair_s == *wide)
    {
        let width = if pair_h == *half {
            16
        } else {
            32 << ((word >> 22) & 1)
        };
        let operation = if *kind == 0 {
            FloatOperation::Add
        } else {
            FloatOperation::MinMax {
                minimum: matches!(*kind, 2 | 4),
                numeric: *kind >= 3,
            }
        };
        let control = fp_control(&mut r);
        let mut status = fp_status(&mut r);
        let mut trapped = c(1, 0);
        let a = fp_lane(&mut r, rn, 0, width);
        let b = fp_lane(&mut r, rn, 1, width);
        let value = fp_chain(
            &mut r,
            operation,
            width,
            vec![a, b],
            &control,
            &mut status,
            &mut trapped,
        );
        fp_finish(&mut r, status, trapped);
        fp_scalar_write(&mut r, rd, width, value, None);
        return Some(r);
    }
    let pair_h = word & 0xbfe0fc00;
    let pair_s = word & 0xbfa0fc00;
    let vector_pairs = [
        (0x2e401400, 0x2e20d400, 0),
        (0x2e403400, 0x2e20f400, 1),
        (0x2ec03400, 0x2ea0f400, 2),
        (0x2e400400, 0x2e20c400, 3),
        (0x2ec00400, 0x2ea0c400, 4),
    ];
    if let Some((half, _, kind)) = vector_pairs
        .iter()
        .find(|(half, wide, _)| pair_h == *half || pair_s == *wide)
    {
        let width = if pair_h == *half {
            16
        } else {
            32 << ((word >> 22) & 1)
        };
        let bits = if word & (1 << 30) != 0 { 128 } else { 64 };
        if width == 64 && bits == 64 {
            return Some(unsupported());
        }
        let operation = if *kind == 0 {
            FloatOperation::Add
        } else {
            FloatOperation::MinMax {
                minimum: matches!(*kind, 2 | 4),
                numeric: *kind >= 3,
            }
        };
        let control = fp_control(&mut r);
        let mut status = fp_status(&mut r);
        let mut trapped = c(1, 0);
        let mut values = vec![];
        for source in [rn, rm] {
            for pair in 0..bits / width / 2 {
                let a = fp_lane(&mut r, source, pair * 2, width);
                let b = fp_lane(&mut r, source, pair * 2 + 1, width);
                values.push(fp_chain(
                    &mut r,
                    operation,
                    width,
                    vec![a, b],
                    &control,
                    &mut status,
                    &mut trapped,
                ));
            }
        }
        fp_finish(&mut r, status, trapped);
        fp_pack(&mut r, rd, width, values);
        return Some(r);
    }
    let reduce_h = word & 0xbffffc00;
    let reduce_s = word & 0xfffffc00;
    let reductions = [
        (0x0e30f800, 0x6e30f800, 1),
        (0x0eb0f800, 0x6eb0f800, 2),
        (0x0e30c800, 0x6e30c800, 3),
        (0x0eb0c800, 0x6eb0c800, 4),
    ];
    if let Some((half, _, kind)) = reductions
        .iter()
        .find(|(half, wide, _)| reduce_h == *half || reduce_s == *wide)
    {
        let width = if reduce_h == *half { 16 } else { 32 };
        let bits = if word & (1 << 30) != 0 { 128 } else { 64 };
        let operation = FloatOperation::MinMax {
            minimum: matches!(*kind, 2 | 4),
            numeric: *kind >= 3,
        };
        let control = fp_control(&mut r);
        let mut status = fp_status(&mut r);
        let mut trapped = c(1, 0);
        let mut inputs = vec![];
        for lane in 0..bits / width {
            inputs.push(fp_lane(&mut r, rn, lane, width));
        }
        let result = fp_reduce(
            &mut r,
            operation,
            width,
            &inputs,
            &control,
            &mut status,
            &mut trapped,
        );
        fp_finish(&mut r, status, trapped);
        fp_scalar_write(&mut r, rd, width, result, None);
        return Some(r);
    }
    None
}
fn fp_load_span(r: &mut Recipe, address: Expr, width: u16, endian: Endian) -> Vec<Expr> {
    if width <= 64 {
        vec![r.bind(Expr::load(Memory {kind: Default::default(), privilege: Default::default(),
            address: Box::new(address),
            width: width as u8,
            endian,
        }))]
    } else {
        r.load_wide(WideMemory {kind: Default::default(), privilege: Default::default(),
            address: Box::new(address),
            width,
            endian,
        })
    }
}
fn fp_store_span(r: &mut Recipe, address: Expr, width: u16, chunks: Vec<Expr>, endian: Endian) {
    if width <= 64 {
        r.effects.push(Effect::Store {
            memory: Memory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address),
                width: width as u8,
                endian,
            },
            value: chunks[0].clone(),
        });
    } else {
        r.store_wide(
            WideMemory {kind: Default::default(), privilege: Default::default(),
                address: Box::new(address),
                width,
                endian,
            },
            chunks,
        );
    }
}
fn fp_memory_single(
    r: &mut Recipe,
    rt: u32,
    width: u16,
    address: Expr,
    load: bool,
    endian: Endian,
) {
    if load {
        let chunks = fp_load_span(r, address, width, endian);
        let low = r.bind(Expr::cast(chunks[0].clone(), 64, false));
        let high = if width == 128 {
            r.bind(chunks[1].clone())
        } else {
            c(64, 0)
        };
        write_vector_chunk(r, rt, 0, low);
        write_vector_chunk(r, rt, 1, high);
    } else {
        let mut chunks = vec![r.bind(Expr::extract(vector_chunk(rt, 0), 0, width.min(64) as u8))];
        if width == 128 {
            chunks.push(r.bind(vector_chunk(rt, 1)));
        }
        fp_store_span(r, address, width, chunks, endian);
    }
}
fn fp_memory(word: u32, address: u64, endian: Endian) -> Option<Recipe> {
    let mut r = Recipe::new(address.wrapping_add(4), 64);
    let unsupported = || {
        Recipe::unsupported(
            "A64 SIMD memory reserved or constrained selector",
            address.wrapping_add(4),
            64,
        )
    };
    let rt = word & 31;
    let rn = (word >> 5) & 31;
    if word & 0x3e000000 == 0x2c000000 {
        let opc = word >> 30;
        let load = word & (1 << 22) != 0;
        let mode = (word >> 23) & 3;
        let rt2 = (word >> 10) & 31;
        if opc == 3 || load && rt == rt2 {
            return Some(unsupported());
        }
        let width = 32u16 << opc;
        let offset = sign(((word >> 15) & 127) as u64, 7).wrapping_mul(u64::from(width / 8));
        let base = read(rn, 64, true);
        let next = bin(B::Add, base.clone(), c(64, offset));
        let first = if mode == 1 { base } else { next.clone() };
        if load {
            let chunks = fp_load_span(&mut r, first, 2 * width, endian);
            for (i, dest) in [rt, rt2].into_iter().enumerate() {
                let i = if endian == Endian::Little { i } else { 1 - i };
                let low = if width == 32 {
                    Expr::cast(
                        Expr::extract(chunks[0].clone(), i as u8 * 32, 32),
                        64,
                        false,
                    )
                } else {
                    chunks[i * width as usize / 64].clone()
                };
                let high = if width == 128 {
                    chunks[i * 2 + 1].clone()
                } else {
                    c(64, 0)
                };
                write_vector_chunk(&mut r, dest, 0, low);
                write_vector_chunk(&mut r, dest, 1, high);
            }
        } else {
            let sources = if endian == Endian::Little {
                [rt, rt2]
            } else {
                [rt2, rt]
            };
            let chunks = if width == 32 {
                let a = Expr::cast(Expr::extract(vector_chunk(sources[0], 0), 0, 32), 64, false);
                let b = shifted(
                    Expr::cast(Expr::extract(vector_chunk(sources[1], 0), 0, 32), 64, false),
                    0,
                    32,
                );
                vec![r.bind(bin(B::Or, a, b))]
            } else {
                let mut chunks = vec![];
                for source in sources {
                    for chunk in 0..width / 64 {
                        chunks.push(r.bind(vector_chunk(source, chunk)));
                    }
                }
                chunks
            };
            fp_store_span(&mut r, first, 2 * width, chunks, endian);
        }
        // Base GPR/SP and data vector registers are different banks. Equal
        // register numbers do not create a writeback overlap constraint.
        if mode == 1 || mode == 3 {
            let value = r.bind(next);
            write(&mut r, rn, 64, true, value);
        }
        return Some(r);
    }
    if word & 0x3f000000 == 0x1c000000 {
        let opc = word >> 30;
        if opc == 3 {
            return Some(unsupported());
        }
        let width = 32u16 << opc;
        let target = address.wrapping_add(sign((((word >> 5) & 0x7ffff) << 2) as u64, 21));
        fp_memory_single(&mut r, rt, width, c(64, target), true, endian);
        return Some(r);
    }
    let unsigned = word & 0x3f000000 == 0x3d000000;
    let unscaled = word & 0x3f200000 == 0x3c000000;
    let indexed = word & 0x3f200c00 == 0x3c200800;
    if unsigned || unscaled || indexed {
        let size = word >> 30;
        let opc = (word >> 22) & 3;
        if opc >= 2 && size != 0 {
            return Some(unsupported());
        }
        let scale = if opc >= 2 { 4 } else { size };
        let width = 8u16 << scale;
        let load = opc & 1 != 0;
        let base = read(rn, 64, true);
        let (effective, writeback) = if unsigned {
            (
                bin(B::Add, base, c(64, u64::from((word >> 10) & 4095) << scale)),
                None,
            )
        } else if unscaled {
            let mode = (word >> 10) & 3;
            if mode == 2 {
                return Some(unsupported());
            }
            let next = bin(
                B::Add,
                base.clone(),
                c(64, sign(((word >> 12) & 511) as u64, 9)),
            );
            (
                if mode == 1 { base } else { next.clone() },
                if mode == 1 || mode == 3 {
                    Some(next)
                } else {
                    None
                },
            )
        } else {
            let option = (word >> 13) & 7;
            if ![2, 3, 6, 7].contains(&option) {
                return Some(unsupported());
            }
            let index = Expr::cast(
                read(
                    (word >> 16) & 31,
                    if option & 1 == 0 { 32 } else { 64 },
                    false,
                ),
                64,
                option & 4 != 0,
            );
            let index = if word & (1 << 12) != 0 {
                shifted(index, 0, scale)
            } else {
                index
            };
            (bin(B::Add, base, index), None)
        };
        fp_memory_single(&mut r, rt, width, effective, load, endian);
        if let Some(next) = writeback {
            let value = r.bind(next);
            write(&mut r, rn, 64, true, value);
        }
        return Some(r);
    }
    None
}
fn fp_classic_context(r: &mut Recipe, control: &Expr, extra: u64) {
    // These typed primitives currently implement the classic architectural
    // domain. Enhanced AH/FIZ/AHP/RPRES and EBF dot behavior is never guessed.
    let allowed = bin(
        B::Eq,
        bin(B::And, control.clone(), c(32, 0x04000003 | extra)),
        c(32, 0),
    );
    r.bind(Expr::require_context(
        allowed,
        "A64 FP primitive requires classic AH/FIZ/AHP and standard BF16 context",
    ));
}
fn fp_special(word: u32, address: u64) -> Option<Recipe> {
    let mut r = Recipe::new(address.wrapping_add(4), 64);
    let unsupported = || {
        Recipe::unsupported(
            "A64 special FP constrained selector",
            address.wrapping_add(4),
            64,
        )
    };
    let rd = word & 31;
    let rn = (word >> 5) & 31;
    let rm = (word >> 16) & 31;
    let scalar = word & (1 << 28) != 0;
    let normalized = word & !(1 << 28);
    let h = normalized & 0xbffffc00;
    let s = normalized & 0xbfbffc00;
    let unary = [
        (0x0ef9d800, 0x0ea1d800, FloatOperation::ReciprocalEstimate),
        (
            0x2ef9d800,
            0x2ea1d800,
            FloatOperation::ReciprocalSquareRootEstimate,
        ),
        (0x0ef9f800, 0x0ea1f800, FloatOperation::ReciprocalExponent),
    ];
    let unary = unary
        .iter()
        .find(|(half, wide, _)| h == *half || s == *wide);
    let bh = normalized & 0xbfe0fc00;
    let bs = normalized & 0xbfa0fc00;
    let binary = [
        (0x0e403c00, 0x0e20fc00, FloatOperation::ReciprocalStep),
        (
            0x0ec03c00,
            0x0ea0fc00,
            FloatOperation::ReciprocalSquareRootStep,
        ),
        (0x0e401c00, 0x0e20dc00, FloatOperation::MultiplyExtended),
    ];
    let binary = binary
        .iter()
        .find(|(half, wide, _)| bh == *half || bs == *wide);
    let ih = normalized & 0xbfc0f400;
    let is = normalized & 0xbf80f400;
    let indexed = ih == 0x2f009000 || is == 0x2f809000;
    if unary.is_some() || binary.is_some() || indexed {
        if scalar && word & (1 << 30) == 0 {
            return Some(unsupported());
        }
        let (width, operation) = if let Some((half, _, op)) = unary {
            (
                if h == *half {
                    16
                } else {
                    32 << ((word >> 22) & 1)
                },
                *op,
            )
        } else if let Some((half, _, op)) = binary {
            (
                if bh == *half {
                    16
                } else {
                    32 << ((word >> 22) & 1)
                },
                *op,
            )
        } else {
            (
                if ih == 0x2f009000 {
                    16
                } else {
                    32 << ((word >> 22) & 1)
                },
                FloatOperation::MultiplyExtended,
            )
        };
        if operation == FloatOperation::ReciprocalExponent && !scalar {
            return Some(unsupported());
        }
        let bits = if word & (1 << 30) != 0 { 128 } else { 64 };
        if !scalar && width == 64 && bits == 64 {
            return Some(unsupported());
        }
        let control = fp_control(&mut r);
        fp_classic_context(&mut r, &control, 0);
        let mut status = fp_status(&mut r);
        let mut trapped = c(1, 0);
        let mut values = vec![];
        let element = if indexed {
            let high = ((word >> 11) & 1) as u8;
            let low = ((word >> 21) & 1) as u8;
            if width == 64 && low != 0 {
                return Some(unsupported());
            }
            let index = if width == 16 {
                high * 4 + low * 2 + ((word >> 20) & 1) as u8
            } else if width == 32 {
                high * 2 + low
            } else {
                high
            };
            Some(fp_lane(
                &mut r,
                if width == 16 { rm & 15 } else { rm },
                index,
                width,
            ))
        } else {
            None
        };
        for lane in 0..if scalar { 1 } else { bits / width } {
            let a = fp_lane(&mut r, rn, lane, width);
            let inputs = if unary.is_some() {
                vec![a]
            } else {
                let b = if let Some(element) = &element {
                    element.clone()
                } else {
                    fp_lane(&mut r, rm, lane, width)
                };
                vec![a, b]
            };
            values.push(fp_chain(
                &mut r,
                operation,
                width,
                inputs,
                &control,
                &mut status,
                &mut trapped,
            ));
        }
        fp_finish(&mut r, status, trapped);
        if scalar {
            fp_scalar_write(
                &mut r,
                rd,
                width,
                values.remove(0),
                Some((control, if unary.is_some() { rd } else { rn })),
            );
        } else {
            fp_pack(&mut r, rd, width, values);
        }
        return Some(r);
    }
    let bf_scalar = word & 0xfffffc00 == 0x1e634000;
    let bf_narrow = word & 0xbffffc00 == 0x0ea16800;
    if bf_scalar || bf_narrow {
        let control = fp_control(&mut r);
        fp_classic_context(&mut r, &control, 0);
        let mut status = fp_status(&mut r);
        let mut trapped = c(1, 0);
        let mut values = vec![];
        for lane in 0..if bf_scalar { 1 } else { 4 } {
            let input = fp_lane(&mut r, rn, lane, 32);
            values.push(fp_chain(
                &mut r,
                FloatOperation::ToBFloat16,
                16,
                vec![input],
                &control,
                &mut status,
                &mut trapped,
            ));
        }
        fp_finish(&mut r, status, trapped);
        if bf_scalar {
            fp_scalar_write(&mut r, rd, 16, values.remove(0), Some((control, rd)));
        } else {
            let mut value = c(64, 0);
            for (lane, x) in values.into_iter().enumerate() {
                value = bin(
                    B::Or,
                    value,
                    shifted(Expr::cast(x, 64, false), 0, lane as u32 * 16),
                );
            }
            let part = ((word >> 30) & 1) as u16;
            write_vector_chunk(&mut r, rd, part, value);
            if part == 0 {
                write_vector_chunk(&mut r, rd, 1, c(64, 0));
            }
        }
        return Some(r);
    }
    let dot = word & 0xbfe0fc00 == 0x2e40fc00;
    let indexed_dot = word & 0xbfc0f400 == 0x0f40f000;
    if dot || indexed_dot {
        let control = fp_control(&mut r);
        fp_classic_context(&mut r, &control, 1 << 13);
        let mut status = fp_status(&mut r);
        let mut trapped = c(1, 0);
        let mut values = vec![];
        let lanes = if word & (1 << 30) != 0 { 4 } else { 2 };
        let index = (((word >> 11) & 1) * 2 + ((word >> 21) & 1)) as u8;
        let indexed_pair = if indexed_dot {
            Some((
                fp_lane(&mut r, rm, index * 2, 16),
                fp_lane(&mut r, rm, index * 2 + 1, 16),
            ))
        } else {
            None
        };
        for lane in 0..lanes {
            let acc = fp_lane(&mut r, rd, lane, 32);
            let a0 = fp_lane(&mut r, rn, lane * 2, 16);
            let a1 = fp_lane(&mut r, rn, lane * 2 + 1, 16);
            let (b0, b1) = if let Some(pair) = &indexed_pair {
                pair.clone()
            } else {
                (
                    fp_lane(&mut r, rm, lane * 2, 16),
                    fp_lane(&mut r, rm, lane * 2 + 1, 16),
                )
            };
            values.push(fp_chain(
                &mut r,
                FloatOperation::BFloatDotAdd,
                32,
                vec![acc, a0, a1, b0, b1],
                &control,
                &mut status,
                &mut trapped,
            ));
        }
        fp_finish(&mut r, status, trapped);
        fp_pack(&mut r, rd, 32, values);
        return Some(r);
    }
    None
}
fn memory(
    r: &mut Recipe,
    endian: Endian,
    word: u32,
    w: u8,
    size: u8,
    opc: u32,
    address: Expr,
    rn: u32,
    writeback: Option<Expr>,
) -> bool {
    let rt = word & 31;
    let bits = 8u8 << size;
    if opc > 1 && (size == 3 || (opc == 3 && size == 2)) {
        return false;
    }
    if writeback.is_some() && rn != 31 && rn == rt {
        return false;
    }
    let address = r.bind(address);
    let m = Memory {kind: Default::default(), privilege: Default::default(),
        address: Box::new(address),
        width: bits,
        endian,
    };
    if opc == 0 {
        let v = r.bind(read(rt, bits, false));
        r.effects.push(Effect::Store {
            memory: m,
            value: v,
        })
    } else {
        let value = r.bind(Expr::load(m));
        let dest = if opc == 2 {
            64
        } else if opc == 3 {
            32
        } else {
            w
        };
        write(r, rt, dest, false, Expr::cast(value, dest, opc >= 2))
    }
    if let Some(next) = writeback {
        let next = r.bind(next);
        write(r, rn, 64, true, next)
    }
    true
}
/// Extract a recipe from a decoded A64 instruction. Unsupported families never
/// expose a guessed transition. The raw-word entry point is useful to adapters
/// which have independently established instruction validity.
pub fn for_word(word: u32, address: u64) -> Recipe {
    for_word_with_endian(word, address, Endian::Little)
}
/// Extract a recipe with explicit data endianness. Pair accesses retain their
/// original width and map whole elements to registers in address order.
pub fn for_word_with_endian(word: u32, address: u64, endian: Endian) -> Recipe {
    for_word_with_context(
        word,
        address,
        RecipeContext {
            vector_length: 128,
            streaming_vector_length: None,
            endian,
        },
    )
}
/// Explicit CurrentVL, independently configured SVL, and data byte order. Invalid contexts produce an
/// Unsupported recipe without architectural effects.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct RecipeContext {
    pub vector_length: u16,
    /// None selects the same length as CurrentVL. SME uses SVL even outside streaming mode.
    pub streaming_vector_length: Option<u16>,
    pub endian: Endian,
}
impl Default for RecipeContext {
    fn default() -> Self {
        Self {
            vector_length: 128,
            streaming_vector_length: None,
            endian: Endian::Little,
        }
    }
}
impl RecipeContext {
    pub fn streaming_vector_length(self) -> u16 {
        self.streaming_vector_length.unwrap_or(self.vector_length)
    }
    pub fn valid(self) -> bool {
        let valid = |length: u16| matches!(length, 128 | 256 | 512 | 1024 | 2048);
        valid(self.vector_length) && valid(self.streaming_vector_length())
    }
}
pub fn for_word_with_vector_length(word: u32, address: u64, vector_length: u16) -> Recipe {
    for_word_with_context(
        word,
        address,
        RecipeContext {
            vector_length,
            streaming_vector_length: None,
            endian: Endian::Little,
        },
    )
}
pub fn for_word_with_context(word: u32, address: u64, context: RecipeContext) -> Recipe {
    if !context.valid() {
        return Recipe::unsupported(
            "A64 VL and SVL must be 128, 256, 512, 1024 or 2048",
            address.wrapping_add(4),
            64,
        );
    }
    if let Some(recipe) = arm64_sve_lookup::sme(word, address, context.streaming_vector_length()) {
