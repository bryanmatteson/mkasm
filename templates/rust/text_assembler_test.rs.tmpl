//! Generated by mkasm: `Template::matches` must not allocate (it runs at
//! every instruction boundary of large code regions).

use std::alloc::{GlobalAlloc, Layout, System};
use std::sync::atomic::{AtomicUsize, Ordering};

use {{.CrateName}}::{assemble, OperandValue, Template};

struct CountingAllocator;
static ALLOCATIONS: AtomicUsize = AtomicUsize::new(0);

unsafe impl GlobalAlloc for CountingAllocator {
    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
        ALLOCATIONS.fetch_add(1, Ordering::Relaxed);
        unsafe { System.alloc(layout) }
    }

    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
        unsafe { System.dealloc(ptr, layout) }
    }

    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, size: usize) -> *mut u8 {
        ALLOCATIONS.fetch_add(1, Ordering::Relaxed);
        unsafe { System.realloc(ptr, layout, size) }
    }
}

#[global_allocator]
static ALLOCATOR: CountingAllocator = CountingAllocator;

#[test]
fn matching_does_not_allocate() {
    let templates: Vec<Template> = [
        "bl $target", "stp x29, x30, [sp, #$frame]!", "add $d, $n, $m", "ldr $t, [$base, #$off]",
        "b.$c $label", "mov $d, $m", "ld1 { $v.16b }, [$n]", "_ x0, x1",
    ].iter().filter_map(|text| Template::parse(text).ok()).collect();
    assert!(templates.len() >= 7);
    let mut words: Vec<u32> = ["bl .+8", "stp x29, x30, [sp, #-16]!", "add x0, x1, x2", "ldr x0, [x1, #8]",
        "b.ne .-4", "mov x0, x1", "ld1 { v1.16b }, [x2]", "nop"]
        .iter().map(|text| assemble(text).unwrap()[0]).collect();
    words.extend((0..4096u32).map(|i| i.wrapping_mul(0x9E37_79B9)));
    let mut values: Vec<OperandValue> = Vec::with_capacity(16);
    let mut hits = 0;
    for template in &templates { for &word in &words { values.clear(); hits += usize::from(template.matches(word, &mut values)); } }
    let before = ALLOCATIONS.load(Ordering::Relaxed);
    for template in &templates { for &word in &words { values.clear(); hits += usize::from(template.matches(word, &mut values)); } }
    let after = ALLOCATIONS.load(Ordering::Relaxed);
    assert!(hits >= 14, "{hits}");
    assert_eq!(after - before, 0, "Template::matches allocated");
}
