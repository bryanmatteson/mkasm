/// A pending branch that needs a label address patched in.
#[derive(Copy, Clone, Debug)]
struct Fixup {
    /// Index into `words` of the instruction to patch.
    at: usize,
    label: u32,
    /// Bit position and width of the offset field.
    start: u32,
    width: u32,
    /// Offset scale; branch offsets are in units of 4 bytes.
    scale: i64,
}

/// Builds a sequence of A64 instructions.
///
/// Instruction methods take operands directly:
///
/// ```ignore
/// let mut asm = Assembler::new();
/// asm.mov(X0, X1);
/// asm.add(X0, X1, 8);
/// asm.bl(0x30);
/// let code = asm.finish().unwrap();
/// ```
#[derive(Default)]
pub struct Assembler {
    words: Vec<u32>,
    labels: Vec<Option<usize>>,
    fixups: Vec<Fixup>,
    errors: Vec<AsmError>,
}

impl Assembler {
    pub fn new() -> Self {
        Self::default()
    }

    /// Number of instructions emitted so far.
    pub fn len(&self) -> usize {
        self.words.len()
    }

    pub fn is_empty(&self) -> bool {
        self.words.is_empty()
    }

    /// The raw instruction words. Branch fixups are not yet applied.
    pub fn words(&self) -> &[u32] {
        &self.words
    }

    /// Creates an unbound label.
    pub fn label(&mut self) -> LabelId {
        self.labels.push(None);
        LabelId((self.labels.len() - 1) as u32)
    }

    /// Binds a label to the current position.
    pub fn bind(&mut self, l: LabelId) {
        let at = self.words.len();
        if let Some(slot) = self.labels.get_mut(l.0 as usize) {
            *slot = Some(at);
        }
    }

    /// Emits one instruction word verbatim.
    pub fn emit(&mut self, word: u32) {
        self.words.push(word);
    }

    /// The first error encountered, if any. Errors are recorded rather than
    /// panicking so a long sequence reports the real first failure.
    pub fn error(&self) -> Option<&AsmError> {
        self.errors.first()
    }

    /// Resolves branch fixups and returns the encoded instructions.
    pub fn finish(mut self) -> Result<Vec<u32>, AsmError> {
        if let Some(e) = self.errors.first() {
            return Err(e.clone());
        }
        for fx in std::mem::take(&mut self.fixups) {
            let target = match self.labels.get(fx.label as usize).and_then(|x| *x) {
                Some(t) => t,
                None => return Err(AsmError::UnboundLabel(fx.label)),
            };
            // Branch offsets are measured from the branch instruction itself.
            let delta = (target as i64 - fx.at as i64) * 4;
            let scaled = delta / fx.scale;
            let mask = mask_of(fx.width);
            self.words[fx.at] &= !(mask << fx.start);
            self.words[fx.at] |= ((scaled as u32) & mask) << fx.start;
        }
        Ok(self.words)
    }

    /// Encoded bytes, little-endian.
    pub fn finish_bytes(self) -> Result<Vec<u8>, AsmError> {
        let words = self.finish()?;
        let mut out = Vec::with_capacity(words.len() * 4);
        for w in words {
            out.extend_from_slice(&w.to_le_bytes());
        }
        Ok(out)
    }

    // --- helpers used by generated instruction methods ---

    #[doc(hidden)]
    pub fn record(&mut self, e: AsmError) {
        self.errors.push(e);
    }

    /// Places an unsigned operand into a field, recording a range error rather
    /// than truncating silently.
    #[doc(hidden)]
    pub fn field_u(
        &mut self,
        w: u32,
        v: i64,
        start: u32,
        width: u32,
        scale: i64,
        lo: i64,
        hi: i64,
        insn: &'static str,
        operand: &'static str,
    ) -> u32 {
        if scale > 1 && v % scale != 0 {
            self.record(AsmError::Alignment { insn, operand, value: v, scale });
            return w;
        }
        if v < lo || v > hi {
            self.record(AsmError::Range { insn, operand, value: v, lo, hi });
            return w;
        }
        let scaled = v / scale;
        let mask = mask_of(width);
        w | ((scaled as u32) & mask) << start
    }

    /// Places an operand whose value spans several fields, or that the encoding
    /// holds as an offset from the bottom of a register range.
    ///
    /// `parts` lists the fields as `(start, width, literal)`, **most significant
    /// first**: ARM's prose gives that order, and it is not always the order the
    /// `encodedin` attribute lists. The value's high bits go to the first part.
    ///
    /// A part with a negative start is a run of constant bits the value must
    /// contain rather than bits to write. The base register of a strided
    /// multi-vector group is written "T:'00':Zt", so only registers whose
    /// number has zeros in those positions can be named there.
    #[doc(hidden)]
    #[allow(clippy::too_many_arguments)]
    pub fn field_bits(
        &mut self,
        mut w: u32,
        v: i64,
        parts: &[(i32, u32, u32)],
        scale: i64,
        bias: i64,
        negate: i64,
        lo: i64,
        hi: i64,
        insn: &'static str,
        operand: &'static str,
    ) -> u32 {
        if scale > 1 && v % scale != 0 {
            self.record(AsmError::Alignment { insn, operand, value: v, scale });
            return w;
        }
        if v < lo || v > hi {
            self.record(AsmError::Range { insn, operand, value: v, lo, hi });
            return w;
        }
        let total: u32 = parts.iter().map(|&(_, width, _)| width).sum();
        // A field that counts down from a constant: a right shift of 1 in a
        // 128-based field is held as 127.
        let value = if negate != 0 { negate - v } else { (v - bias) / scale };
        let all = if total >= 64 { u64::MAX } else { (1u64 << total) - 1 };
        let bits = (value as u64) & all;
        let mut shift = total;
        for &(start, width, lit) in parts {
            shift -= width;
            let m = mask_of(width);
            let chunk = ((bits >> shift) as u32) & m;
            if start < 0 {
                if chunk != lit {
                    self.record(AsmError::Range { insn, operand, value: v, lo, hi });
                    return w;
                }
                continue;
            }
            w &= !(m << start);
            w |= chunk << start;
        }
        w
    }

    /// Records a branch target, either as an immediate offset or a fixup.
    #[doc(hidden)]
    pub fn field_label(
        &mut self,
        w: u32,
        l: Label,
        start: u32,
        width: u32,
        scale: i64,
        insn: &'static str,
    ) -> u32 {
        match l {
            Label::Offset(off) => {
                if scale > 1 && off % scale != 0 {
                    self.record(AsmError::Alignment {
                        insn,
                        operand: "label",
                        value: off,
                        scale,
                    });
                    return w;
                }
                let scaled = off / scale;
                let bound = 1i64 << (width - 1);
                if scaled < -bound || scaled >= bound {
                    self.record(AsmError::Range {
                        insn,
                        operand: "label",
                        value: off,
                        lo: -bound * scale,
                        hi: (bound - 1) * scale,
                    });
                    return w;
                }
                w | ((scaled as u32) & mask_of(width)) << start
            }
            Label::Id(id) => {
                self.fixups.push(Fixup {
                    at: self.words.len(),
                    label: id,
                    start,
                    width,
                    scale,
                });
                w
            }
        }
    }
}

#[inline]
fn mask_of(width: u32) -> u32 {
    if width >= 32 {
        u32::MAX
    } else {
        (1u32 << width) - 1
    }
}
