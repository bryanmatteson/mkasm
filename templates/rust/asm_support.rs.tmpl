/// An AArch64 8-bit floating-point immediate encoding.
///
/// Use `try_from_f64` for a semantic constant, or `from_bits` when the compact
/// architectural encoding is already known.
#[derive(Copy, Clone, PartialEq, Eq, Debug)]
pub struct FpImm8(u8);

impl FpImm8 {
    pub const fn from_bits(bits: u8) -> Self {
        Self(bits)
    }

    pub const fn raw(self) -> u32 {
        self.0 as u32
    }

    pub fn value(self) -> f64 {
        let bits = self.0;
        let sign = if bits & 0x80 != 0 { -1.0 } else { 1.0 };
        let n = 16.0 + (bits & 0x0f) as f64;
        let exp = ((bits >> 4) & 7) as i32;
        let r = if exp < 4 { exp + 1 } else { exp - 7 };
        let mut scale = 1.0;
        if r >= 0 {
            for _ in 0..r {
                scale *= 2.0;
            }
        } else {
            for _ in 0..-r {
                scale /= 2.0;
            }
        }
        sign * (n / 16.0) * scale
    }

    pub fn try_from_f64(value: f64) -> Option<Self> {
        for bits in 0u16..=255 {
            let candidate = Self(bits as u8);
            if candidate.value() == value {
                return Some(candidate);
            }
        }
        None
    }
}

