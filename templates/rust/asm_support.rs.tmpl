// --- errors ------------------------------------------------------------------

/// Why an operand could not be encoded.
#[derive(Clone, PartialEq, Eq, Debug)]
pub enum AsmError {
    /// The value is outside the range the field can hold.
    Range { insn: &'static str, operand: &'static str, value: i64, lo: i64, hi: i64 },
    /// The value is not a multiple of the field's scale.
    Alignment { insn: &'static str, operand: &'static str, value: i64, scale: i64 },
    /// The instruction has no encoding for this addressing mode.
    AddrMode { insn: &'static str, mode: AddrMode },
    /// The instruction has no encoding for this element arrangement.
    Arrangement { insn: &'static str, arr: crate::insns::Arrangement },
    /// Two operands were given different arrangements.
    ArrangementMismatch { insn: &'static str },
    /// This instruction has no encoding for the spelling given. Enumerated
    /// operand types are shared between instructions, so a type can name more
    /// spellings than any one encoding accepts.
    Operand { insn: &'static str, operand: &'static str },
    /// A label was referenced but never bound.
    UnboundLabel(u32),
}

impl fmt::Display for AsmError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            AsmError::Range { insn, operand, value, lo, hi } => write!(
                f,
                "{insn}: {operand} = {value} is outside the encodable range {lo}..={hi}"
            ),
            AsmError::Alignment { insn, operand, value, scale } => write!(
                f,
                "{insn}: {operand} = {value} must be a multiple of {scale}"
            ),
            AsmError::AddrMode { insn, mode } => {
                write!(f, "{insn}: no encoding for addressing mode {mode:?}")
            }
            AsmError::Arrangement { insn, arr } => {
                write!(f, "{insn}: no encoding for arrangement .{arr}")
            }
            AsmError::ArrangementMismatch { insn } => {
                write!(f, "{insn}: all vector operands must share one arrangement")
            }
            AsmError::Operand { insn, operand } => {
                write!(f, "{insn}: no encoding for the value given for {operand}")
            }
            AsmError::UnboundLabel(id) => write!(f, "label {id} was never bound"),
        }
    }
}

impl std::error::Error for AsmError {}

