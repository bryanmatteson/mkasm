//! Generated by mkasm: text-assembler round trips over every printable form.

use super::*;


/// Deterministic sample words per form ({{.SampleForms}} forms, {{.SampleWords}} words).
/// A form with no sample has no legal word the reference model prints.
static SAMPLES: &[(&str, &[u32])] = &[
{{.Samples}}];

/// Round-trip checks that are documented gaps: (encoding id, check, reason).
/// The sweep fails on any failure not listed here and on any listed gap that
/// no longer fails, so this list only shrinks.
static KNOWN_GAPS: &[(&str, &str, &str)] = &[
    ("IC_SYS_CR_systeminstrs", "format",
     "formatter defect: format() selects a form that cannot print IC IALLUIS (0xD508711F); the IC form's own text assembles"),
];

fn form_index(id: &str) -> Option<usize> { FORMS.binary_search_by(|form| form.encoding_id.cmp(id)).ok() }

fn squash(text: &str) -> String {
    let text: String = text.chars().filter(|c| !c.is_whitespace() && *c != '#').flat_map(char::to_lowercase).collect();
    // The formatter prints register 31 of a bank-letter-plus-number operand
    // (`<R><m>`) as W31/X31; ARM spells it WZR/XZR.
    match text.as_str() { "w31" => "wzr".into(), "x31" => "xzr".into(), _ => text }
}

fn with_hole(text: &str, start: usize, end: usize) -> String {
    let next_ident = text[end..].chars().next().is_some_and(|c| c.is_ascii_alphanumeric() || c == '_');
    format!("{}{}{}", &text[..start], if next_ident { "${h}" } else { "$h" }, &text[end..])
}

/// The prefilter's contract: a word the template matches passes it.
fn accepts(template: &Template, word: u32) -> bool {
    let any = template.word_filters().iter().any(|&(mask, value)| word & mask == value);
    assert_eq!(any, template.could_match(word));
    any
}

fn with_wild(text: &str, start: usize, end: usize) -> String {
    let next_ident = text[end..].chars().next().is_some_and(|c| c.is_ascii_alphanumeric() || c == '_');
    format!("{}{}{}", &text[..start], if next_ident { "_ " } else { "_" }, &text[end..])
}

#[test]
fn every_form_round_trips_through_text() {
    let mut failures: Vec<(String, &'static str, String)> = Vec::new();
    let mut skipped: Vec<&str> = Vec::new();
    let mut covered = 0usize;
    let mut hole_checks = 0usize;
    for (id, words) in SAMPLES {
        let Some(index) = form_index(id) else { failures.push((id.to_string(), "form", "absent from FORMS".into())); continue };
        if words.is_empty() { skipped.push(id); continue; }
        let form = &FORMS[index];
        let before = failures.len();
        let mut fail = |check: &'static str, detail: String| failures.push((id.to_string(), check, detail));
        for &word in *words {
            let text = match format(word, 0) {
                Ok(text) => text,
                Err(_) => {
                    fail("format", format!("0x{word:08x} does not format"));
                    match render_form(form, word) { Some(text) => text, None => continue }
                }
            };
            match assemble(&text) {
                Ok(found) if found.contains(&word) => {}
                other => fail("assemble", format!("{text:?} (0x{word:08x}) -> {other:?}")),
            }
            match Template::parse(&text) {
                Ok(template) => {
                    let mut values = Vec::new();
                    if !template.matches(word, &mut values) || !values.is_empty() {
                        fail("match", format!("{text:?} does not match 0x{word:08x}"));
                    }
                    if !accepts(&template, word) {
                        fail("filter", format!("{text:?}: word_filters {:x?} reject 0x{word:08x}", template.word_filters()));
                    }
                }
                Err(error) => fail("match", format!("{text:?}: {error}")),
            }
            if let Some(own) = render_form(form, word) {
                if own != text {
                    match assemble(&own) {
                        Ok(found) if found.contains(&word) => {}
                        other => fail("form-spelling", format!("{own:?} (0x{word:08x}) -> {other:?}")),
                    }
                }
            }
            if let Some(explicit) = render_tree(index, word, true) {
                match assemble(&explicit.text) {
                    Ok(found) if found.contains(&word) => {}
                    other => fail("explicit-groups", format!("{:?} (0x{word:08x}) -> {other:?}", explicit.text)),
                }
            }
            let Some(tree) = render_tree(index, word, false) else { fail("tree", format!("0x{word:08x} does not render")); continue };
            for slot in &tree.slots {
                let (start, end, operand) = (&slot.start, &slot.end, &slot.text);
                hole_checks += 1;
                let variant = with_hole(&tree.text, *start, *end);
                let template = match Template::parse(&variant) {
                    Ok(template) => template,
                    Err(error) => { fail("hole-parse", format!("{variant:?}: {error}")); continue }
                };
                let mut values = Vec::new();
                if let Ok(wild) = Template::parse(&with_wild(&tree.text, *start, *end)) {
                    if wild.matches(word, &mut values) && !accepts(&wild, word) {
                        fail("filter", format!("{:?}: word_filters {:x?} reject 0x{word:08x}", wild.text(), wild.word_filters()));
                    }
                }
                if template.holes().len() != 1 || !template.matches(word, &mut values) {
                    fail("hole-match", format!("{variant:?} does not match 0x{word:08x}"));
                    continue;
                }
                if !accepts(&template, word) {
                    fail("filter", format!("{variant:?}: word_filters {:x?} reject 0x{word:08x}", template.word_filters()));
                }
                let value = values[0];
                let spelled = value.class.format_value(value.value).unwrap_or_default();
                let same = squash(&spelled) == squash(operand) ||
                    value.class.parse_value(operand).is_some_and(|parsed| parsed == value.value);
                if !same { fail("hole-value", format!("{variant:?}: bound {value:?} spelled {spelled:?}, operand {operand:?}")); }
                match template.encode(&[value]) {
                    Ok(found) if found.contains(&word) => {}
                    other => fail("hole-encode", format!("{variant:?} with {value:?} (0x{word:08x}) -> {other:?}")),
                }
            }
        }
        if failures.len() == before { covered += 1; }
    }
    failures.sort();
    failures.dedup_by(|a, b| a.0 == b.0 && a.1 == b.1);
    let mut report = String::new();
    let failed_forms: std::collections::BTreeSet<&str> = failures.iter().map(|f| f.0.as_str()).collect();
    report.push_str(&format!("text assembler: forms={} sampled={} covered={} failed={} skipped={} hole-checks={}\n",
        FORMS.len(), SAMPLES.len() - skipped.len(), covered, failed_forms.len(), skipped.len(), hole_checks));
    for id in &skipped { report.push_str(&format!("  SKIPPED {id}: no legal printable sample word\n")); }
    let mut unexpected = Vec::new();
    for (id, check, detail) in &failures {
        let known = KNOWN_GAPS.iter().any(|(gap, gap_check, _)| gap == id && gap_check == check);
        report.push_str(&format!("  {} {id} [{check}] {detail}\n", if known { "KNOWN" } else { "FAIL" }));
        if !known { unexpected.push(id.clone()); }
    }
    for (gap, check, reason) in KNOWN_GAPS {
        if !failures.iter().any(|(id, c, _)| id == gap && c == check) {
            report.push_str(&format!("  FIXED {gap} [{check}] {reason}\n"));
            unexpected.push(gap.to_string());
        }
    }
    eprintln!("{report}");
    if let Ok(path) = std::env::var("MKASM_TEXT_ASM_REPORT") { let _ = std::fs::write(path, &report); }
    assert!(unexpected.is_empty(), "{} unexpected text-assembler results; see report above", unexpected.len());
}

#[test]
fn class_names_and_symbols_are_consistent() {
    for class in OperandClass::ALL {
        assert_eq!(OperandClass::from_name(class.name()), Some(*class));
        assert!(!class.summary().is_empty() && !class.summary().contains('\n'), "{} summary", class.name());
        assert!(!(class.is_integer() && (class.is_register() || !class.symbols().is_empty())), "{}", class.name());
        let integer = matches!(class, OperandClass::Imm | OperandClass::ImmHex | OperandClass::Label);
        assert_eq!(class.is_integer(), integer, "{}", class.name());
        let symbols = class.symbols();
        if *class != OperandClass::Cond {
            assert!(symbols.windows(2).all(|pair| pair[0] < pair[1]), "{} symbols unsorted", class.name());
        }
        for (index, symbol) in symbols.iter().enumerate() {
            if symbol.is_empty() { continue; }
            assert_eq!(class.parse_value(symbol), Some(index as i128), "{} {symbol}", class.name());
        }
    }
    for (index, form) in FORMS.iter().enumerate() {
        let info = form_info(index);
        for (part, op) in form.parts.iter().zip(&info.ops) {
            let (Some(def), Some(op)) = (part.operand.as_ref(), op) else { continue };
            assert!(base_class(def).is_some(), "{} {}: no class", form.encoding_id, def.symbol);
            for (row, value) in def.rows.iter().zip(&op.rows) {
                if matches!(def.kind, Kind::Table) {
                    assert!(*value != RowVal::Bad, "{} {}: row {:?} has no value", form.encoding_id, def.symbol, row.symbol);
                }
            }
        }
    }
}

fn err(text: &str) -> AssembleError { assemble(text).expect_err(text) }

#[test]
fn errors_name_the_problem() {
    match err("frobnicate x0, x1") {
        AssembleError::UnknownMnemonic { mnemonic, nearest } => { assert_eq!(mnemonic, "frobnicate"); let _ = nearest; }
        other => panic!("{other:?}"),
    }
    match err("bogus x0") {
        AssembleError::UnknownMnemonic { mnemonic, .. } => assert_eq!(mnemonic, "bogus"),
        other => panic!("{other:?}"),
    }
    assert_eq!(one("addhn2 v0.16b, v1.8h, v2.8h"), 0x4E224020);
    match err("addd x0, x1, x2") {
        AssembleError::UnknownMnemonic { nearest, .. } => assert!(nearest.contains(&"add"), "{nearest:?}"),
        other => panic!("{other:?}"),
    }
    match err("add x0, x1") {
        AssembleError::OperandCount { missing: true, form, mnemonic, .. } => { assert!(form.starts_with("ADD"), "{form}"); assert_eq!(mnemonic, "add"); }
        other => panic!("{other:?}"),
    }
    match err("ret x0, x1") {
        AssembleError::OperandCount { missing: false, offset, .. } => assert_eq!(offset, 6),
        other => panic!("{other:?}"),
    }
    match err("add x0, x1, #5000") {
        AssembleError::OperandOutOfRange { operand, text, offset, .. } => { assert_eq!(operand, "<imm>"); assert_eq!(text, "#5000"); assert_eq!(offset, 12); }
        other => panic!("{other:?}"),
    }
    match err("ldr x0, [x1, #4097]") {
        AssembleError::OperandOutOfRange { .. } | AssembleError::NoMatchingForm { .. } => {}
        other => panic!("{other:?}"),
    }
    match err("add x0, x1, xq") {
        AssembleError::NoMatchingForm { reason: Mismatch::InvalidRegister, .. } => {}
        other => panic!("{other:?}"),
    }
    match err("ldr x0, [x32]") {
        AssembleError::NoMatchingForm { reason: Mismatch::InvalidRegister, offset, .. } => assert_eq!(offset, 9),
        other => panic!("{other:?}"),
    }
    assert!(matches!(err("add x0, x1, $"), AssembleError::Syntax { offset: 12, .. }));
    assert!(matches!(Template::parse("add $d, $n, #1").unwrap().encode(&[]), Err(AssembleError::UnboundHole { .. })));
    let template = Template::parse("add x0, x1, #$imm").unwrap();
    assert!(matches!(template.encode(&[OperandValue::new(OperandClass::Cond, 1)]), Err(AssembleError::HoleClassMismatch { .. })));
    // `#` is optional, so `#$imm` also fits the register forms.
    assert_eq!(template.encode(&[OperandValue::new(OperandClass::Gpr64, 2)]).unwrap()[0], one("add x0, x1, x2"));
    assert!(matches!(template.encode(&[OperandValue::new(OperandClass::Imm, 4096 * 4096)]), Err(AssembleError::OperandOutOfRange { .. })));
    assert!(matches!(Template::parse("add x0, x1, $m:cond"), Err(AssembleError::NoMatchingForm { reason: Mismatch::HoleClass, .. })));
    assert!(matches!(Template::parse("add x0, x1, $m:bogus"), Err(AssembleError::UnknownClass { offset: 15, .. })));
    assert!(matches!(Template::parse("add x0, x1, $m").unwrap().encode(&[OperandValue::new(OperandClass::Gpr64, 40)]), Err(AssembleError::InvalidValue { .. })));
    assert!(matches!(Template::parse("nop").unwrap().encode(&[OperandValue::new(OperandClass::Imm, 0)]), Err(AssembleError::ValueCount { .. })));
}

fn one(text: &str) -> u32 {
    let words = assemble(text).unwrap_or_else(|error| panic!("{text}: {error}"));
    words[0]
}

#[test]
fn templates_bind_and_emit() {
    // Spellings.
    assert_eq!(one("MOV x0, x1"), 0xAA0103E0);
    assert_eq!(one("orr x0, xzr, x1"), 0xAA0103E0);
    assert_eq!(one("  add   X0 ,x1, X2 , LSL # 0x3"), 0x8B020C20);
    assert_eq!(one("ldr x0, [x1]"), one("ldr x0, [x1, #0]"));
    assert_eq!(one("ret"), 0xD65F03C0);
    assert_eq!(one("ret x30"), 0xD65F03C0);
    assert_eq!(one("b.ne .+8"), 0x54000041);
    assert_eq!(one("b.ne 8"), 0x54000041);
    assert_eq!(assemble_at("b.ne 0x1008", 0x1000).unwrap()[0], 0x54000041);
    assert_eq!(assemble_at("bl 0x0ff8", 0x1000).unwrap()[0], one("bl .-8"));
    // `#N` is a displacement (LLVM prints labels that way), a bare number absolute.
    assert_eq!(assemble_at("b #8", 0x1000).unwrap()[0], one("b .+8"));
    assert_eq!(assemble_at("b 8", 0x1000).unwrap()[0], one("b .-4088"));
    assert_eq!(one("mov w0, #-1"), 0x12800000);
    assert_eq!(one("add x0, sp, x1"), 0x8B2163E0);
    // MOV (to/from SP) applies when either register is SP.
    assert_eq!(one("mov x29, sp"), 0x910003FD);
    assert_eq!(one("mov sp, x29"), 0x910003BF);
    assert_eq!(format(0x910003FD, 0).unwrap(), "MOV x29, sp");

    // `bl $target`: a label hole binds the displacement.
    let bl = Template::parse("bl $target").unwrap();
    assert_eq!(bl.holes().len(), 1);
    assert_eq!(bl.holes()[0].name(), "target");
    assert_eq!(bl.holes()[0].classes(), &[OperandClass::Label]);
    let mut values = Vec::new();
    assert!(bl.matches(0x94000002, &mut values));
    assert_eq!(values, [OperandValue::new(OperandClass::Label, 8)]);
    assert_eq!(bl.encode(&values).unwrap(), [0x94000002]);
    values.clear();
    assert!(!bl.matches(0x14000002, &mut values));
    assert!(values.is_empty());

    // A hole inside brackets.
    let stp = Template::parse("stp x29, x30, [sp, #$frame]!").unwrap();
    values.clear();
    assert!(stp.matches(0xA9BF7BFD, &mut values));
    assert_eq!(values, [OperandValue::new(OperandClass::Imm, -16)]);
    assert_eq!(stp.encode(&[OperandValue::new(OperandClass::Imm, -32)]).unwrap(), [one("stp x29, x30, [sp, #-32]!")]);
    let two = Template::parse("stp x29, x30, [$base, #$off]!").unwrap();
    assert_eq!(two.holes().len(), 2);
    values.clear();
    assert!(two.matches(0xA9BF7BFD, &mut values));
    assert_eq!(values, [OperandValue::new(OperandClass::Gpr64Sp, 31), OperandValue::new(OperandClass::Imm, -16)]);

    // Alias and canonical spellings denote the same words.
    for text in ["orr $d, xzr, $m", "mov $d, $m"] {
        let template = Template::parse(text).unwrap();
        values.clear();
        assert!(template.matches(0xAA0103E0, &mut values), "{text}");
        assert_eq!(values, [OperandValue::new(OperandClass::Gpr64, 0), OperandValue::new(OperandClass::Gpr64, 1)], "{text}");
    }

    // A hole fitting several widths reports every class.
    let add = Template::parse("add $d, $n, $m").unwrap();
    assert!(add.holes()[0].classes().contains(&OperandClass::Gpr32));
    assert!(add.holes()[0].classes().contains(&OperandClass::Gpr64));
    values.clear();
    assert!(add.matches(0x0B020020, &mut values));
    assert_eq!(values[0], OperandValue::new(OperandClass::Gpr32, 0));

    // The condition suffix of B.<cond> is a hole too.
    let bcond = Template::parse("b.$c $target").unwrap();
    values.clear();
    assert!(bcond.matches(0x54000041, &mut values));
    assert_eq!(values, [OperandValue::new(OperandClass::Cond, 1), OperandValue::new(OperandClass::Label, 8)]);
    assert_eq!(OperandClass::Cond.format_value(1).as_deref(), Some("ne"));

    // Repeated names bind equal values; `_` binds nothing.
    let same = Template::parse("add $r, $r, #1").unwrap();
    values.clear();
    assert!(same.matches(one("add x3, x3, #1"), &mut values));
    assert!(!same.matches(one("add x3, x4, #1"), &mut values));
    let wild = Template::parse("add _, _, #$i").unwrap();
    values.clear();
    assert!(wild.matches(one("add x3, x4, #7"), &mut values));
    assert_eq!(values, [OperandValue::new(OperandClass::Imm, 7)]);

    // Class restriction.
    let only64 = Template::parse("add $d:gpr64, $n, $m").unwrap();
    assert_eq!(only64.holes()[0].classes(), &[OperandClass::Gpr64]);
    values.clear();
    assert!(!only64.matches(0x0B020020, &mut values));
}

/// Pseudo-random legal words of every form: whatever the formatter prints
/// must assemble back to the word, and the printed text as a template must
/// match it.
#[test]
fn random_words_round_trip() {
    let mut state = 0x9e37_79b9_7f4a_7c15u64;
    let mut next = move || { state ^= state << 13; state ^= state >> 7; state ^= state << 17; state as u32 };
    let (mut tried, mut failures) = (0usize, Vec::new());
    for form in FORMS {
        let mut kept = 0;
        for _ in 0..64 {
            if kept == 8 { break; }
            let word = next() & !form.mask | form.value;
            if !form_matches(form, word) { continue; }
            let Ok(text) = format(word, 0) else { continue };
            kept += 1;
            tried += 1;
            let ok = assemble(&text).is_ok_and(|found| found.contains(&word)) &&
                Template::parse(&text).is_ok_and(|template| template.matches(word, &mut Vec::new()) && accepts(&template, word));
            if !ok { failures.push(format!("{} 0x{word:08x} {text:?} -> {:?}", form.encoding_id, assemble(&text))); }
        }
    }
    failures.sort();
    failures.dedup();
    eprintln!("random round trips: {tried} words, {} failures", failures.len());
    for failure in &failures { eprintln!("  FAIL {failure}"); }
    assert!(failures.is_empty());
}

/// `describe` over the per-form samples: the text matches the word, and each
/// span replaced by a hole (bare and class-restricted) binds that span's value.
#[test]
fn describe_spans_bind_their_values() {
    let (mut words, mut spans, mut labels, mut same_as_format) = (0usize, 0usize, 0usize, 0usize);
    let mut failures = Vec::new();
    for (id, samples) in SAMPLES {
        for &word in *samples {
            let Some(described) = describe(word) else { failures.push(format!("{id} 0x{word:08x}: no description")); continue };
            words += 1;
            if format(word, 0).is_ok_and(|text| squash(&text) == squash(&described.text)) { same_as_format += 1; }
            match Template::parse(&described.text) {
                Ok(template) if template.matches(word, &mut Vec::new()) && accepts(&template, word) => {}
                other => { failures.push(format!("{id} 0x{word:08x} {:?}: {:?}", described.text, other.err())); continue }
            }
            for span in &described.operands {
                spans += 1;
                labels += usize::from(span.position_dependent());
                let want = OperandValue::new(span.class, span.value).with_position(span.position);
                for hole in ["$h".to_string(), format!("$h:{}", span.class.name())] {
                    let next_ident = described.text[span.end..].starts_with(|c: char| c.is_ascii_alphanumeric() || c == '_');
                    let hole = if next_ident { String::from("$") + "{" + &hole[1..] + "}" } else { hole };
                    let text = format!("{}{}{}", &described.text[..span.start], hole, &described.text[span.end..]);
                    let mut values = Vec::new();
                    if let Ok(wild) = Template::parse(&with_wild(&described.text, span.start, span.end)) {
                        if wild.matches(word, &mut values) && !accepts(&wild, word) {
                            failures.push(format!("{id} 0x{word:08x} {:?}: word_filters reject the word", wild.text()));
                        }
                    }
                    match Template::parse(&text) {
                        Ok(template) if template.matches(word, &mut values) && values == [want] && accepts(&template, word) => {}
                        Ok(_) => failures.push(format!("{id} 0x{word:08x} {text:?}: bound {values:?}, span {want:?}")),
                        Err(error) => failures.push(format!("{id} 0x{word:08x} {text:?}: {error}")),
                    }
                }
            }
        }
    }
    eprintln!("describe: {words} words, {spans} spans ({labels} position-dependent), text equals format() for {same_as_format}, {} failures", failures.len());
    for failure in failures.iter().take(80) { eprintln!("  FAIL {failure}"); }
    assert!(failures.is_empty());
}

/// Words in the union of `(mask, value)` pairs over a space of `free` bits.
fn covered(pairs: &[(u32, u32)], free: u32) -> u64 {
    if pairs.is_empty() { return 0; }
    if pairs.iter().any(|&(mask, _)| mask == 0) { return 1 << free; }
    let used = pairs.iter().fold(0u32, |all, &(mask, _)| all | mask);
    let bit = used & used.wrapping_neg();
    let half = |on: bool| -> Vec<(u32, u32)> {
        pairs.iter().filter(|&&(mask, value)| mask & bit == 0 || (value & bit != 0) == on)
            .map(|&(mask, value)| (mask & !bit, value & !bit)).collect()
    };
    covered(&half(false), free - 1) + covered(&half(true), free - 1)
}

/// The prefilter is tight where the tables allow: opcode bits of every form the
/// text can denote, and the operands the text fixes.
#[test]
fn word_filters_are_tight() {
    let count = |text: &str| {
        let template = Template::parse(text).unwrap_or_else(|error| panic!("{text}: {error}"));
        let words = covered(template.word_filters(), 32);
        eprintln!("selectivity {text:?}: {} pairs, {words} words = {:.6}% of 2^32", template.word_filters().len(), words as f64 * 100.0 / (1u64 << 32) as f64);
        words
    };
    assert_eq!(count("bl $t"), 1 << 26);
    let bl = Template::parse("bl $t").unwrap();
    assert!(bl.could_match(0x94000002) && !bl.could_match(0x14000002));
    count("ret");
    count("mov $d, $s");
    count("stp x29, x30, [sp, $o]!");
    // A fixed register narrows a filter; the open form is wider.
    assert!(count("mov x0, $s") < count("mov $d, $s"));
    assert!(count("add x0, x1, #1") < count("add $d, $n, $i"));

    // Contract on random words, plain and drawn from inside the filter.
    let mut state = 0x2545_f491_4f6c_dd1du64;
    let mut next = move || { state ^= state << 13; state ^= state >> 7; state ^= state << 17; state as u32 };
    for text in ["bl $t", "ret", "mov $d, $s", "mov x0, $s", "stp x29, x30, [sp, $o]!", "add $d, $n, $i", "ldr $t, [$n, $o]", "b.$c $t", "orr $d, xzr, $m"] {
        let template = Template::parse(text).unwrap();
        let (mut inside, mut matched) = (0usize, 0usize);
        for round in 0..40_000 {
            let mut word = next();
            if round % 2 == 1 {
                let (mask, value) = template.word_filters()[round / 2 % template.word_filters().len()];
                word = word & !mask | value;
                inside += 1;
            }
            if template.matches(word, &mut Vec::new()) {
                matched += 1;
                assert!(accepts(&template, word), "{text}: 0x{word:08x}");
            }
        }
        eprintln!("{text:?}: {matched} of 40000 random words match ({inside} drawn inside the filter)");
    }
}

/// Position model: every value a hole binds carries the operand's position, the
/// text fixes it per hole, `target` agrees with the assembler's own reading of an
/// absolute target at two addresses, and moving an instruction keeps its target.
#[test]
fn positions_follow_the_operand() {
    let (mut fixed, mut relative, mut paged, mut moved, mut refused) = (0usize, 0usize, 0usize, 0usize, 0usize);
    let mut failures: Vec<String> = Vec::new();
    for (id, samples) in SAMPLES {
        for &word in *samples {
            let Some(described) = describe(word) else { continue };
            for span in &described.operands {
                let hole = with_hole(&described.text, span.start, span.end);
                let Ok(template) = Template::parse(&hole) else { continue };
                let mut values = Vec::new();
                if !template.matches(word, &mut values) || values.len() != 1 { continue; }
                let value = values[0];
                if value.value != span.value { continue; }
                if (span.class == OperandClass::Label) != span.position_dependent() {
                    failures.push(format!("{id} 0x{word:08x}: span {span:?} position disagrees with its class"));
                }
                if value.position != span.position || template.hole_position(0) != Some(span.position) {
                    failures.push(format!("{id} 0x{word:08x} {hole:?}: value {:?}, hole {:?}, span {:?}", value.position, template.hole_position(0), span.position));
                    continue;
                }
                if !span.position_dependent() { fixed += 1; continue; }
                match span.position { Position::PageRelative { .. } => paged += 1, _ => relative += 1 }
                for address in [0x100_0000_1230u64, 0x7fff_f000_1230] {
                    let Some(goal) = target(span.position, address, value.value) else {
                        failures.push(format!("{id} 0x{word:08x}: no target at 0x{address:x}"));
                        continue;
                    };
                    if value_for_target(span.position, address, goal) != Some(value.value) {
                        failures.push(format!("{id} 0x{word:08x}: value_for_target does not invert target at 0x{address:x}"));
                    }
                    // The assembler's own absolute-target reading must land on the same word.
                    let absolute = format!("{}0x{goal:x}{}", &described.text[..span.start], &described.text[span.end..]);
                    match assemble_at(&absolute, address) {
                        Ok(found) if found.contains(&word) => {}
                        other => failures.push(format!("{id} 0x{word:08x}: {absolute:?} at 0x{address:x} -> {other:?}")),
                    }
                    // Move the instruction: the same target from 0x40 further on.
                    let there = address + 0x40;
                    let Some(shifted) = value_for_target(span.position, there, goal) else { continue };
                    match template.encode(&[OperandValue { value: shifted, ..value }]) {
                        Ok(words) => {
                            moved += 1;
                            let mut back = Vec::new();
                            for new in words.iter().take(1) {
                                if !template.matches(*new, &mut back) || target(span.position, there, back[0].value) != Some(goal) {
                                    failures.push(format!("{id} 0x{word:08x}: relocated word 0x{new:08x} reaches {:?}, not 0x{goal:x}", back.first()));
                                }
                            }
                        }
                        Err(AssembleError::OperandOutOfRange { .. } | AssembleError::NoMatchingForm { .. } | AssembleError::InvalidValue { .. }) => refused += 1,
                        Err(other) => failures.push(format!("{id} 0x{word:08x}: relocation encode {other:?}")),
                    }
                    // A value the form cannot hold is refused, never wrapped.
                    for far in [shifted + (1i128 << 40), shifted - (1i128 << 40)] {
                        if let Ok(words) = template.encode(&[OperandValue { value: far, ..value }]) {
                            for new in words {
                                let mut back = Vec::new();
                                if !template.matches(new, &mut back) || back[0].value != far {
                                    failures.push(format!("{id} 0x{word:08x}: {far} wrapped to {:?} in 0x{new:08x}", back.first()));
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    eprintln!("positions: {fixed} fixed holes, {relative} instruction-relative, {paged} page-relative; {moved} relocated, {refused} refused as out of range; {} failures", failures.len());
    for failure in failures.iter().take(60) { eprintln!("  FAIL {failure}"); }
    assert!(failures.is_empty());
    assert!(relative > 0 && paged > 0 && moved > 0);
}

#[test]
fn position_helpers_are_inverse_and_checked() {
    use Position::*;
    assert_eq!(target(InstructionRelative, 0x1000, 8), Some(0x1008));
    assert_eq!(target(InstructionRelative, 0x1000, -0x1001), None);
    assert_eq!(target(InstructionRelative, u64::MAX, 1), None);
    assert_eq!(target(PageRelative { shift: 12 }, 0x1234, 0x2000), Some(0x3000));
    assert_eq!(target(Fixed, 0x1000, 8), None);
    assert_eq!(target(PageRelative { shift: 64 }, 0, 0), None);
    assert_eq!(value_for_target(InstructionRelative, 0x1000, 0xff8), Some(-8));
    assert_eq!(value_for_target(PageRelative { shift: 12 }, 0x1234, 0x3000), Some(0x2000));
    assert_eq!(value_for_target(PageRelative { shift: 12 }, 0x1234, 0x3004), None);
    assert_eq!(value_for_target(Fixed, 0, 0), None);
    assert!(Position::InstructionRelative.is_position_dependent() && !Position::Fixed.is_position_dependent());
    // adrp reaches pages: a page-relative value is a multiple of 4096.
    let adrp = Template::parse("adrp x0, $t").unwrap();
    assert_eq!(adrp.hole_position(0), Some(PageRelative { shift: 12 }));
    let mut values = Vec::new();
    assert!(adrp.matches(0x90000040, &mut values));
    assert_eq!(values, [OperandValue::new(OperandClass::Label, 32768).with_position(PageRelative { shift: 12 })]);
    assert_eq!(Template::parse("bl $t").unwrap().hole_position(0), Some(InstructionRelative));
    assert_eq!(Template::parse("add x0, x1, $i").unwrap().hole_position(0), Some(Fixed));
    assert_eq!(Template::parse("add x0, x1, $i").unwrap().hole_position(1), None);
}

/// Every form with a label operand, by position: the table of position-dependent
/// A64 operands. Instruction-relative labels are byte offsets (the instruction
/// field times its scale); only the page-scaled one is page-relative.
#[test]
fn label_forms_by_position() {
    let mut by_position: std::collections::BTreeMap<String, Vec<&str>> = std::collections::BTreeMap::new();
    for (index, form) in FORMS.iter().enumerate() {
        let info = form_info(index);
        for op in info.ops.iter().flatten() {
            if op.class != OperandClass::Label { continue; }
            let position = position_of(op.op, OperandClass::Label);
            by_position.entry(format!("{position:?}")).or_default().push(form.encoding_id);
        }
    }
    for (position, ids) in &mut by_position {
        ids.sort();
        ids.dedup();
        eprintln!("label forms {position}: {} forms: {}", ids.len(), ids.join(" "));
    }
    assert!(by_position.contains_key("InstructionRelative") && by_position.contains_key("PageRelative { shift: 12 }"));
}

fn word_encodes_as(template: &Template, class: OperandClass, value: i128) -> Option<Vec<u32>> {
    template.encode(&[OperandValue::new(class, value).with_position(template.holes()[0].position().unwrap_or(Position::Fixed))]).ok().filter(|words| !words.is_empty())
}

/// Domains: every matched value lies in one of its hole's domains; every exact
/// domain's ends and next value encode and match back; values just outside, or
/// off the step, are refused unless another domain of the class holds them.
#[test]
fn hole_domains_agree_with_encoding() {
    let mut failures: Vec<String> = Vec::new();
    let mut by_count: std::collections::BTreeMap<usize, usize> = std::collections::BTreeMap::new();
    let mut multi: std::collections::BTreeMap<&str, usize> = std::collections::BTreeMap::new();
    let mut tally: std::collections::BTreeMap<&str, (usize, usize)> = std::collections::BTreeMap::new();
    let (mut holes, mut checked) = (0usize, 0usize);
    let mut seen_hole: std::collections::BTreeSet<String> = std::collections::BTreeSet::new();
    for (id, samples) in SAMPLES {
        for &word in *samples {
            let Some(described) = describe(word) else { continue };
            for span in &described.operands {
                let text = with_hole(&described.text, span.start, span.end);
                let Ok(template) = Template::parse(&text) else { continue };
                let mut values = Vec::new();
                if template.holes().len() != 1 || !template.matches(word, &mut values) { continue; }
                let value = values[0];
                holes += 1;
                let domains = template.hole_domains(0);
                let of_class: Vec<&ClassDomain> = domains.iter().filter(|entry| entry.class == value.class).collect();
                if of_class.is_empty() {
                    failures.push(format!("{id} 0x{word:08x} {text:?}: no domain for class {}", value.class.name()));
                    continue;
                }
                if !of_class.iter().any(|entry| entry.domain.contains(value.value)) {
                    failures.push(format!("{id} 0x{word:08x} {text:?}: {value:?} outside {of_class:?}"));
                }
                // The distribution is over distinct (text, class) holes.
                let fresh = seen_hole.insert(format!("{text}|{}", value.class.name()));
                if fresh {
                    *by_count.entry(of_class.len()).or_default() += 1;
                    if of_class.len() > 1 { *multi.entry(value.class.name()).or_default() += 1; }
                    let entry = tally.entry(value.class.name()).or_default();
                    if of_class.iter().all(|entry| entry.domain.exact) { entry.0 += 1; } else { entry.1 += 1; }
                }
                // Encoding agrees with every exact domain (one hole per (form, class) keeps this quick).
                if !fresh { continue; }
                for entry in domains.iter().filter(|entry| entry.domain.exact) {
                    let (class, d) = (entry.class, entry.domain);
                    let held = |v: i128| domains.iter().any(|other| other.class == class && other.domain.contains(v));
                    let mut present = vec![d.min, d.max];
                    if d.min != d.max { present.push(d.min + d.step); }
                    for v in present {
                        checked += 1;
                        match word_encodes_as(&template, class, v) {
                            Some(words) => {
                                let mut back = Vec::new();
                                // The word may also read as another class (a prefetch operation by name, `[x1], x31` as an immediate).
                                if !words.iter().any(|word| template.matches(*word, &mut back) && (back[0].class != class || back[0].value == v)) {
                                    failures.push(format!("{id} {text:?}: {class:?} {v} encodes but does not match back ({words:08x?})"));
                                }
                            }
                            None => failures.push(format!("{id} {text:?}: {class:?} {v} inside {d:?} was refused")),
                        }
                    }
                    let mut absent = vec![d.min - d.step, d.max + d.step];
                    if d.step > 1 { absent.push(d.min + 1); }
                    for v in absent {
                        if held(v) { continue; }
                        checked += 1;
                        if let Some(words) = word_encodes_as(&template, class, v) {
                            failures.push(format!("{id} {text:?}: {class:?} {v} outside {d:?} encoded as {words:08x?}"));
                        }
                    }
                }
            }
        }
    }
    eprintln!("domains: {holes} holes, {} distinct, {checked} encode checks; {} failures", seen_hole.len(), failures.len());
    eprintln!("domains per (hole, class): {by_count:?}; classes with several: {multi:?}");
    for (class, (exact, inexact)) in &tally { eprintln!("  {class}: {exact} exact, {inexact} inexact"); }
    for failure in failures.iter().take(if std::env::var_os("MKASM_DOMAIN_REPORT").is_some() { usize::MAX } else { 80 }) { eprintln!("  FAIL {failure}"); }
    assert!(failures.is_empty());
}

#[test]
fn domains_follow_the_form() {
    let domains = |text: &str| Template::parse(text).unwrap().hole_domains(0).to_vec();
    let imm = |text: &str| domains(text).into_iter().filter(|entry| entry.class == OperandClass::Imm).map(|entry| entry.domain).collect::<Vec<_>>();
    let label = |text: &str| domains(text).into_iter().filter(|entry| entry.class == OperandClass::Label).map(|entry| entry.domain).collect::<Vec<_>>();
    eprintln!("add x0, x1, $i: {:?}", domains("add x0, x1, $i"));
    eprintln!("add x0, x1, #$i: {:?}", imm("add x0, x1, #$i"));
    assert_eq!(label("bl $t"), [Domain::new(-(1 << 27), (1 << 27) - 4, 4, true)]);
    assert_eq!(label("adrp x0, $t"), [Domain::new(-(1 << 32), (1 << 32) - 4096, 4096, true)]);
    assert_eq!(label("adr x0, $t"), [Domain::new(-(1 << 20), (1 << 20) - 1, 1, true)]);
    assert_eq!(label("b.eq $t"), [Domain::new(-(1 << 20), (1 << 20) - 4, 4, true)]);
    assert_eq!(imm("ldr x0, [x1, #$o]"), [Domain::new(0, 4095 * 8, 8, true)]);
    // LDUR is a different mnemonic; the shifted ADD progression needs `lsl #12` in the text.
    assert_eq!(imm("ldur x0, [x1, #$o]"), [Domain::new(-256, 255, 1, true)]);
    assert_eq!(imm("add x0, x1, #$i, lsl #12"), [Domain::new(0, 4095, 1, true)]);
    assert_eq!(OperandClass::Gpr64.domain(), Domain::new(0, 31, 1, true));
    assert_eq!(OperandClass::Cond.domain(), Domain::new(0, 15, 1, true));
    assert!(!OperandClass::ImmHex.domain().exact && !OperandClass::FpImm.domain().exact);
    assert!(OperandClass::Imm.domain().contains(4095) && OperandClass::Label.domain().contains(-4));
    assert_eq!(Domain::new(0, 10, 4, true).max, 8);
    assert!(Domain::new(0, 8, 4, true).covers(&Domain::new(4, 4, 1, true)));
}

#[test]
fn complete_register_names_share_assembler_bounds_and_aliases() {
    use OperandClass as C;
    assert_eq!(parse_register(C::Gpr64, "x30"), Some(30));
    assert_eq!(parse_register(C::Gpr64, "lr"), Some(30));
    assert_eq!(parse_register(C::Gpr64, "xzr"), Some(31));
    assert_eq!(parse_register(C::Gpr64Sp, "sp"), Some(31));
    for text in ["x31", "sp", "x1, x2", "x0junk", ""] {
        assert_eq!(parse_register(C::Gpr64, text), None, "{text}");
    }
    assert_eq!(parse_register(C::Imm, "12"), None);
}
